@page
@model ProjectManagement.Areas.DocumentRepository.Pages.Admin.OfficeCategories.IndexModel
@{
    ViewData["Title"] = "Offices";
    ViewData["UseFullWidth"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/docrepo-ui.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}

<div class="library library--narrow">
    <header class="library-head">
        <div class="library-head__text">
            <a class="library-back" asp-page="/Documents/Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to the library</a>
            <h1>Offices</h1>
            <p>The offices a document can be filed under. Lower numbers come first in lists. A deactivated office is no longer offered for new documents; documents already filed under it keep it.</p>
        </div>
    </header>

    <div class="library-columns library-columns--admin">
        <!-- SECTION: Add -->
        <section class="library-panel">
            <h2>Add an office</h2>
            <form method="post" asp-page-handler="Create" class="library-fieldset">
                <div asp-validation-summary="ModelOnly" class="alert alert-warning library-summary-errors" role="alert"></div>
                <div class="library-field">
                    <label asp-for="Input.Name">Name <span class="library-required" aria-hidden="true">*</span></label>
                    <input asp-for="Input.Name" class="form-control" placeholder="For example: CPDS North" />
                    <span class="library-field__error" asp-validation-for="Input.Name"></span>
                </div>
                <div class="library-field">
                    <label asp-for="Input.SortOrder">Position in lists</label>
                    <input asp-for="Input.SortOrder" class="form-control" type="number" />
                    <span class="library-field__error" asp-validation-for="Input.SortOrder"></span>
                </div>
                <div><button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add</button></div>
            </form>
        </section>

        <!-- SECTION: Existing -->
        <section class="library-tablecard">
            @if (!Model.Categories.Any())
            {
                <div class="library-empty">
                    <i class="bi bi-tags" aria-hidden="true"></i>
                    <h2>No offices yet</h2>
                    <p>Add the first one; uploads need at least one.</p>
                </div>
            }
            else
            {
                <div class="library-tablescroll">
                    <table class="library-table">
                        <thead>
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col">Position</th>
                                <th scope="col">Documents</th>
                                <th scope="col"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model.Categories)
                            {
                                var count = Model.DocumentCounts.TryGetValue(category.Id, out var value) ? value : 0;
                                <tr>
                                    <td>
                                        <label class="visually-hidden" for="name-@category.Id">Name</label>
                                        <input class="form-control" id="name-@category.Id" type="text" name="name" value="@category.Name" maxlength="120" required form="edit-@category.Id" />
                                        @if (!category.IsActive)
                                        {
                                            <span class="library-pill library-pill--muted mt-1">Deactivated</span>
                                        }
                                    </td>
                                    <td data-label="Position">
                                        <label class="visually-hidden" for="sort-@category.Id">Position</label>
                                        <input class="form-control library-table__narrow" id="sort-@category.Id" type="number" name="sortOrder" value="@category.SortOrder" form="edit-@category.Id" />
                                    </td>
                                    <td data-label="Documents" class="library-table__num">
                                        <a href="@Url.Page("/Documents/Index", new { officeCategoryId = category.Id })">@count.ToString("N0")</a>
                                    </td>
                                    <td class="library-table__actions">
                                        <button type="submit" class="btn btn-sm btn-outline-primary" form="edit-@category.Id">Save</button>
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" form="toggle-@category.Id"
                                                data-confirm="@(category.IsActive && count > 0 ? $"{count} documents use “{category.Name}”. They keep it, but it will no longer be offered for new documents. Deactivate it?" : null)">
                                            @(category.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @foreach (var category in Model.Categories)
                {
                    <form method="post" asp-page-handler="Update" id="edit-@category.Id"><input type="hidden" name="id" value="@category.Id" /></form>
                    <form method="post" asp-page-handler="Toggle" id="toggle-@category.Id"><input type="hidden" name="id" value="@category.Id" /></form>
                }
            }
        </section>
    </div>
</div>
