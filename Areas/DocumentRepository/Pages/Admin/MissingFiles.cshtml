@page
@model ProjectManagement.Areas.DocumentRepository.Pages.Admin.MissingFilesModel
@using ProjectManagement.Areas.DocumentRepository.Models
@{
    ViewData["Title"] = "Missing files";
    ViewData["UseFullWidth"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/docrepo-ui.css" asp-append-version="true" />
}

@* Shown inside Administration, like the Repository trash (docs/ux/admin-review-4-fixes.md, PR 6). *@
<partial name="~/Areas/Admin/Pages/Shared/_AdminPageHeader.cshtml" model="Model.Header" />

<div class="library docrepo-admin-page">
    @if (!User.IsInRole(ProjectManagement.Configuration.RoleNames.Admin))
    {
        @* Administrators go back through the admin sidebar; others reach this page from the library. *@
        <a class="library-back" asp-page="/Documents/Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to the library</a>
    }

    <section class="library-summary library-summary--compact" aria-label="Storage check">
        <div class="library-stat">
            <span class="library-stat__label">Checked</span>
            <span class="library-stat__figure"><strong>@Model.TotalCount.ToString("N0")</strong><span>documents</span></span>
            <span class="library-stat__sub">@(Model.Capped ? $"The newest {Model.CheckLimit:N0} only" : "All of them"), @(Model.IncludeDeleted ? "including the trash" : "not counting the trash")</span>
        </div>
        <div class="library-stat">
            <span class="library-stat__label">Missing</span>
            <span class="library-stat__figure"><strong class="@(Model.MissingCount > 0 ? "is-danger" : null)">@Model.MissingCount.ToString("N0")</strong><span>files</span></span>
            <span class="library-stat__sub">@(Model.MissingCount == 0 ? "Every file is in place" : "Listed below")</span>
        </div>
    </section>

    <form method="get" class="library-toolbar">
        <label class="library-toggle">
            <input type="checkbox" name="includeDeleted" value="true" checked="@Model.IncludeDeleted" data-auto-submit />
            <span>Include the trash</span>
        </label>
        <noscript><button class="btn btn-sm btn-primary" type="submit">Apply</button></noscript>
        <span class="library-toolbar__count">Checked at @Model.CheckedAtIst</span>
        <a class="btn btn-sm btn-outline-secondary" asp-route-includeDeleted="@Model.IncludeDeleted" asp-route-refresh="true">Check again</a>
        <span class="library-toolbar__spacer"></span>
        @if (Model.TotalPages > 1)
        {
            <span class="library-toolbar__count">Page @Model.PageNumber of @Model.TotalPages</span>
            <a class="btn btn-sm btn-outline-secondary @(Model.HasPreviousPage ? null : "disabled")" asp-route-page="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize" asp-route-includeDeleted="@Model.IncludeDeleted">Previous</a>
            <a class="btn btn-sm btn-outline-secondary @(Model.HasNextPage ? null : "disabled")" asp-route-page="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize" asp-route-includeDeleted="@Model.IncludeDeleted">Next</a>
        }
    </form>

    @if (Model.Items.Count == 0)
    {
        <div class="library-empty">
            <i class="bi bi-check2-circle" aria-hidden="true"></i>
            <h2>No missing files</h2>
            <p>Every document's PDF is where the library expects it.</p>
        </div>
    }
    else
    {
        <div class="library-tablecard">
            <div class="library-tablescroll">
                <table class="library-table">
                    <thead>
                        <tr>
                            <th scope="col">Document</th>
                            <th scope="col">Added</th>
                            <th scope="col">Expected at</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <span class="library-table__title">@item.Subject</span>
                                    <span class="library-table__meta">@item.Category · @item.Office · @DocRepoFormat.Date(item.DocumentDate)</span>
                                </td>
                                <td data-label="Added" class="library-table__num">@DocRepoFormat.Date(item.CreatedAtUtc)</td>
                                <td data-label="Expected at"><span class="library-facts__file">@item.StoragePath</span></td>
                                <td class="library-table__actions">
                                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Documents/Manage" asp-route-id="@item.Id">Manage</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
