@model ProjectManagement.Areas.DocumentRepository.Pages.Admin.DocRepoListPageModel
@using ProjectManagement.Areas.DocumentRepository.Pages.Admin
@* Repository document types and offices on the shared list page, inside Administration
   (docs/ux/admin-review-3-fixes.md, PR 12). Add and Edit open a dialog; Delete follows the
   shared rule (only when no document, in the library or the trash, uses the value). *@
@{
    var noun = Model.Noun;
}

<partial name="~/Areas/Admin/Pages/Shared/_AdminPageHeader.cshtml" model="Model.Header" />
<partial name="~/Areas/Admin/Pages/Shared/_AdminFlashMessages.cshtml" />
<partial name="~/Pages/Shared/_ListOrderNotice.cshtml" model="Model.OrderNotice" />
<partial name="~/Areas/Admin/Pages/Shared/_AdminReferenceList.cshtml" model="Model.ListModel" />

<div class="modal fade" id="@DocRepoListPageModel.AddDialogId" tabindex="-1" aria-labelledby="@(DocRepoListPageModel.AddDialogId)Label" aria-hidden="true" data-reopen="@(Model.ReopenAddDialog ? "true" : "false")">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="@(DocRepoListPageModel.AddDialogId)Label">Add @noun</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="admin-validation-summary" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Input.Name" class="form-label"></label>
                        <input asp-for="Input.Name" class="form-control" autocomplete="off" placeholder="@(noun == "type" ? "For example: Minutes" : "For example: Plans branch")" />
                        <span asp-validation-for="Input.Name" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="Input.SortOrder" class="form-label"></label>
                        <input asp-for="Input.SortOrder" class="form-control" type="number" min="-999" max="9999" aria-describedby="add-sort-order-help" />
                        <div class="form-text" id="add-sort-order-help">Leave blank to add it at the end.</div>
                        <span asp-validation-for="Input.SortOrder" class="text-danger small"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add @noun</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="@DocRepoListPageModel.EditDialogId" tabindex="-1" aria-labelledby="@(DocRepoListPageModel.EditDialogId)Label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Update" data-reference-edit-form>
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="@(DocRepoListPageModel.EditDialogId)Label">Edit @noun</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" data-reference-field="id" />
                    <input type="hidden" name="rowVersion" data-reference-field="rowVersion" />
                    <div class="mb-3">
                        <label class="form-label" for="edit-name">Name</label>
                        <input class="form-control" id="edit-name" type="text" name="name" maxlength="120" required autocomplete="off" data-reference-field="value" />
                    </div>
                    <div>
                        <label class="form-label" for="edit-sort-order">Order in lists</label>
                        <input class="form-control" id="edit-sort-order" type="number" name="sortOrder" min="-999" max="9999" required data-reference-field="sortOrder" />
                        <div class="form-text">Lower numbers come first; equal numbers are listed A to Z.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
