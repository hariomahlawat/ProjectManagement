@page "{id:guid}"
@model ProjectManagement.Areas.DocumentRepository.Pages.Documents.ManageModel
@{
    ViewData["Title"] = "Manage document";
    ViewData["UseFullWidth"] = true;
    var document = Model.Document;
}

@section Styles {
    <link rel="stylesheet" href="~/css/docrepo-ui.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<div class="library library--form library--narrow">
    @if (document is null)
    {
        <div class="library-empty">
            <i class="bi bi-file-earmark-x" aria-hidden="true"></i>
            <h2>Document not found</h2>
            <p>It may have been deleted for good.</p>
            <a class="btn btn-outline-primary btn-sm" asp-page="./Index">Back to the library</a>
        </div>
    }
    else
    {
        <header class="library-head">
            <div class="library-head__text">
                <a class="library-back" asp-page="./Reader" asp-route-id="@document.Id"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to the document</a>
                <span class="library-eyebrow">Manage document</span>
                <h1>@document.Subject</h1>
                <p>@document.DocumentCategory?.Name · @document.OfficeCategory?.Name · @DocRepoFormat.Date(document.DocumentDate)</p>
            </div>
        </header>

        @if (document.IsDeleted)
        {
            <div class="library-banner is-danger" role="status">
                <i class="bi bi-trash3" aria-hidden="true"></i>
                <div>
                    <strong>In the trash</strong>
                    <span>Deleted @(document.DeletedAtUtc.HasValue ? DocRepoFormat.DateTime(document.DeletedAtUtc.Value) : null) by @Model.NameOf(document.DeletedByUserId)@(string.IsNullOrWhiteSpace(document.DeleteReason) ? null : $": “{document.DeleteReason}”"). An administrator can restore it from the Trash.</span>
                </div>
            </div>
        }

        <div class="library-actions">
            <!-- SECTION: Visibility -->
            <section class="library-action">
                <h2>Who can see it</h2>
                @if (document.IsActive)
                {
                    <p><span class="library-pill library-pill--success">Active</span> Everyone signed in can find and open it.</p>
                    <form method="post" asp-page-handler="Deactivate" asp-route-id="@document.Id">
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <button type="submit" class="btn btn-outline-secondary" disabled="@document.IsDeleted"><i class="bi bi-eye-slash" aria-hidden="true"></i> Deactivate</button>
                    </form>
                    <p class="library-action__note">Deactivated documents stay in the library but only the people who manage it can see them. You can activate it again at any time.</p>
                }
                else
                {
                    <p><span class="library-pill library-pill--muted">Deactivated</span> Only the people who manage the library can see it.</p>
                    <form method="post" asp-page-handler="Activate" asp-route-id="@document.Id">
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <button type="submit" class="btn btn-outline-primary" disabled="@document.IsDeleted"><i class="bi bi-eye" aria-hidden="true"></i> Activate again</button>
                    </form>
                }
            </section>

            <!-- SECTION: Searchable text -->
            <section class="library-action">
                <h2>Searchable text</h2>
                @switch (document.OcrStatus)
                {
                    case DocOcrStatus.Succeeded:
                        <p><span class="library-pill library-pill--success">Ready</span> The text inside the PDF can be searched.</p>
                        break;
                    case DocOcrStatus.Pending:
                        <p><span class="library-pill library-pill--muted">Being read</span> The text is in the reading queue and becomes searchable within a few minutes.</p>
                        break;
                    case DocOcrStatus.Failed:
                        <p><span class="library-pill library-pill--danger">Not readable</span> @DocRepoFormat.ExplainOcrFailure(document.OcrFailureReason)</p>
                        @if (!string.IsNullOrWhiteSpace(document.OcrFailureReason))
                        {
                            <p class="library-action__note"><span class="library-facts__file">@document.OcrFailureReason</span></p>
                        }
                        <form method="post" asp-page-handler="RetryOcr" asp-route-id="@document.Id">
                            <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Read text again</button>
                        </form>
                        break;
                    default:
                        <p><span class="library-pill library-pill--muted">Not read</span> The text has not been read yet.</p>
                        break;
                }
            </section>

            <!-- SECTION: Deletion -->
            <section class="library-action library-action--danger">
                <h2>Request deletion</h2>
                @if (Model.PendingRequests.Any())
                {
                    <p>A deletion request is waiting for an approver in the Decision Centre.</p>
                    <ul class="library-requests">
                        @foreach (var request in Model.PendingRequests)
                        {
                            <li>
                                <strong>@Model.NameOf(request.RequestedByUserId)</strong>
                                <span>@DocRepoFormat.DateTime(request.RequestedAtUtc.UtcDateTime)</span>
                                <q>@(string.IsNullOrWhiteSpace(request.Reason) ? "No reason given" : request.Reason)</q>
                            </li>
                        }
                    </ul>
                }
                else if (!document.IsDeleted)
                {
                    <p>An approver decides in the Decision Centre. Until then the document stays in the library.</p>
                    <form method="post" asp-page-handler="RequestDelete" asp-route-id="@document.Id" class="library-field">
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <label asp-for="Reason">Why should it be deleted? <span class="library-required" aria-hidden="true">*</span></label>
                        <textarea asp-for="Reason" class="form-control" rows="3" maxlength="512" required
                                  placeholder="For example: uploaded twice, wrong office, superseded by a newer circular"></textarea>
                        <span class="library-field__error" asp-validation-for="Reason"></span>
                        <div><button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash3" aria-hidden="true"></i> Send request</button></div>
                    </form>
                }
            </section>
        </div>
    }
</div>
