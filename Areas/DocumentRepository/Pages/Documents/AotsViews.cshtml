@page "{id:guid}"
@model ProjectManagement.Areas.DocumentRepository.Pages.Documents.AotsViewsModel
@{
    ViewData["Title"] = "Who has read it";
    ViewData["UseFullWidth"] = true;
    string Name(ProjectManagement.Areas.DocumentRepository.Pages.Documents.AotsViewsModel.AotsViewerVm person)
        => string.IsNullOrWhiteSpace(person.Rank) ? person.FullName : $"{person.Rank} {person.FullName}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/docrepo-ui.css" asp-append-version="true" />
}

<div class="library library--narrow">
    <header class="library-head">
        <div class="library-head__text">
            <a class="library-back" href="@Model.ReturnUrl"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to the document</a>
            <span class="library-eyebrow">All officers to see</span>
            <h1>@Model.DocumentTitle</h1>
            <p>Who has opened this document so far. A person counts once, from the first time they open it.</p>
        </div>
    </header>

    @if (!Model.IsAots)
    {
        <div class="library-banner" role="status">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <div><strong>Not marked for all officers</strong><span>Read receipts are kept only for AOTS documents. Edit the document's details to mark it.</span></div>
        </div>
    }
    else
    {
        <section class="library-progress" aria-label="Reading progress">
            <p><strong>@Model.Viewers.Count of @(Model.Viewers.Count + Model.NotYetRead.Count)</strong> people have read it (@Model.ReadPercent%).</p>
            <span class="library-stat__meter" aria-hidden="true"><span style="--fill: @Model.ReadPercent%"></span></span>
        </section>

        <div class="library-columns">
            <section class="library-panel">
                <h2>Read <span>@Model.Viewers.Count</span></h2>
                @if (Model.Viewers.Count == 0)
                {
                    <p class="library-panel__empty">Nobody has opened it yet.</p>
                }
                else
                {
                    <ol class="library-people">
                        @foreach (var viewer in Model.Viewers)
                        {
                            <li>
                                <span class="library-people__name">@Name(viewer)</span>
                                <span class="library-people__meta">@viewer.UserName · @DocRepoFormat.DateTime(viewer.FirstViewedAtUtc)</span>
                            </li>
                        }
                    </ol>
                }
            </section>
            <section class="library-panel">
                <h2>Not read yet <span>@Model.NotYetRead.Count</span></h2>
                @if (Model.NotYetRead.Count == 0)
                {
                    <p class="library-panel__empty">Everyone has read it.</p>
                }
                else
                {
                    <ul class="library-people">
                        @foreach (var person in Model.NotYetRead)
                        {
                            <li>
                                <span class="library-people__name">@Name(person)</span>
                                <span class="library-people__meta">@person.UserName</span>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    }
</div>
