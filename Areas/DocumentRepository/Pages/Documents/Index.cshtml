@page
@model ProjectManagement.Areas.DocumentRepository.Pages.Documents.IndexModel
@{
    ViewData["Title"] = "Document Repository";
    ViewData["UseFullWidth"] = true;
    if (Model.IsPartial)
    {
        Layout = null;
    }

    var summary = Model.Summary;
}

@if (Model.IsPartial)
{
    <partial name="_ResultsRegion" model="Model" />
    return;
}

@section Styles {
    <link rel="stylesheet" href="~/css/docrepo-ui.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/docrepo-ui.js" asp-append-version="true"></script>
}

<div class="library" data-library
     data-results-url="@Url.Page("./Index")"
     data-preview-url="@Url.Page("./Index", "Preview")"
     data-favourite-url="@Url.Page("./Index", "ToggleFavourite")"
     data-manage-url="@Url.Page("./Manage")">

    <form id="libraryToken" method="post" class="d-none">@Html.AntiForgeryToken()</form>

    <!-- SECTION: Header -->
    <header class="library-head">
        <div class="library-head__text">
            <span class="library-eyebrow">Office library</span>
            <h1>Document Repository</h1>
            <p>Letters, policies, minutes and other papers, searchable by their details and by the text inside each PDF.</p>
        </div>
        <div class="library-head__actions">
            @if (Model.HasAdminLinks)
            {
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-gear" aria-hidden="true"></i> Manage
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        @if (Model.CanApproveDeletes)
                        {
                            <li><a class="dropdown-item" asp-page="/Admin/DeleteRequests/Index"><i class="bi bi-check2-square me-2" aria-hidden="true"></i>Deletion requests</a></li>
                            <li><a class="dropdown-item" asp-page="/Admin/OCRFailures/OcrFailures"><i class="bi bi-file-earmark-break me-2" aria-hidden="true"></i>Unreadable PDFs</a></li>
                            <li><a class="dropdown-item" asp-page="/Admin/MissingFiles"><i class="bi bi-file-earmark-x me-2" aria-hidden="true"></i>Missing files</a></li>
                        }
                        @if (Model.CanPurge)
                        {
                            <li><a class="dropdown-item" asp-page="/Admin/Trash/Index"><i class="bi bi-trash3 me-2" aria-hidden="true"></i>Trash</a></li>
                        }
                        @if (Model.CanManageCategories)
                        {
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-page="/Admin/OfficeCategories/Index"><i class="bi bi-building me-2" aria-hidden="true"></i>Offices</a></li>
                            <li><a class="dropdown-item" asp-page="/Admin/DocumentCategories/Index"><i class="bi bi-tags me-2" aria-hidden="true"></i>Document types</a></li>
                        }
                    </ul>
                </div>
            }
            @if (Model.CanUpload)
            {
                <a class="btn btn-primary" asp-page="./Upload"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> Upload PDF</a>
            }
        </div>
    </header>

    <!-- SECTION: Summary strip (whole repository) -->
    <section class="library-summary" aria-label="Repository at a glance">
        <a class="library-stat" href="@Model.ScopeUrl(null)">
            <span class="library-stat__label">Documents</span>
            <span class="library-stat__figure"><strong>@summary.Documents.ToString("N0")</strong><span>in the library</span></span>
            <span class="library-stat__sub">@(summary.AddedThisMonth == 0 ? "None added this month" : $"{summary.AddedThisMonth:N0} added this month")</span>
        </a>
        <a class="library-stat library-stat--aots" href="@Model.ScopeUrl("aots")">
            <span class="library-stat__label">All officers to see</span>
            <span class="library-stat__figure"><strong>@summary.AotsUnread.ToString("N0")</strong><span>unread by you</span></span>
            <span class="library-stat__sub">@DocRepoFormat.Count(summary.Aots, "AOTS document") in all</span>
        </a>
        <a class="library-stat" href="@Model.ScopeUrl("favourites")">
            <span class="library-stat__label">Favourites</span>
            <span class="library-stat__figure"><strong>@summary.Favourites.ToString("N0")</strong><span>starred</span></span>
            <span class="library-stat__sub">Star a document to keep it one click away</span>
        </a>
        @if (Model.CanApproveDeletes && summary.TextFailed > 0)
        {
            <a class="library-stat" asp-page="/Admin/OCRFailures/OcrFailures">
                <span class="library-stat__label">Searchable text</span>
                <span class="library-stat__figure"><strong>@summary.TextReadyPercent%</strong><span>of documents</span></span>
                <span class="library-stat__meter" aria-hidden="true"><span style="--fill: @summary.TextReadyPercent%"></span></span>
                <span class="library-stat__sub">@summary.TextPending being read · <span class="is-danger">@summary.TextFailed not readable</span></span>
            </a>
        }
        else
        {
            <div class="library-stat">
                <span class="library-stat__label">Searchable text</span>
                <span class="library-stat__figure"><strong>@summary.TextReadyPercent%</strong><span>of documents</span></span>
                <span class="library-stat__meter" aria-hidden="true"><span style="--fill: @summary.TextReadyPercent%"></span></span>
                <span class="library-stat__sub">@(summary.TextPending == 0 ? "Every PDF's text is searchable" : $"{summary.TextPending} being read now")</span>
            </div>
        }
    </section>

    <!-- SECTION: Scope tabs -->
    <nav class="library-tabs" aria-label="Show">
        <a href="@Model.ScopeUrl(null)" class="@(Model.IsDefaultScope ? "is-active" : null)" aria-current="@(Model.IsDefaultScope ? "page" : null)" data-library-scope="">All documents</a>
        <a href="@Model.ScopeUrl("favourites")" class="@(Model.IsFavouritesScope ? "is-active" : null)" aria-current="@(Model.IsFavouritesScope ? "page" : null)" data-library-scope="favourites">
            Favourites <span class="library-tabs__count">@summary.Favourites</span>
        </a>
        <a href="@Model.ScopeUrl("aots")" class="@(Model.IsAotsScope ? "is-active" : null)" aria-current="@(Model.IsAotsScope ? "page" : null)" data-library-scope="aots">
            AOTS
            @if (summary.AotsUnread > 0)
            {
                <span class="library-tabs__badge" title="Unread by you">@summary.AotsUnread new</span>
            }
        </a>
    </nav>

    <!-- SECTION: Search (outside the refreshed region so typing keeps focus) -->
    <div class="library-searchrow">
        <form method="get" class="library-search" role="search" data-library-search>
            <i class="bi bi-search" aria-hidden="true"></i>
            <label class="visually-hidden" for="librarySearch">Search the library</label>
            <input id="librarySearch" type="search" name="q" value="@Model.Q" autocomplete="off"
                   placeholder="Search titles, senders, tags and the text inside PDFs" />
            <input type="hidden" name="scope" value="@Model.ScopeValue" />
            <input type="hidden" name="view" value="@(Model.IsListView ? null : "cards")" />
            <button class="library-search__submit" type="submit">Search</button>
        </form>
        <div class="library-viewswitch" role="group" aria-label="Layout">
            <a href="@Model.UrlWith("view", null, keepPage: true)" class="@(Model.IsListView ? "is-on" : null)" aria-pressed="@(Model.IsListView ? "true" : "false")" data-library-view="list" title="List">
                <i class="bi bi-list-ul" aria-hidden="true"></i><span>List</span>
            </a>
            <a href="@Model.UrlWith("view", "cards", keepPage: true)" class="@(!Model.IsListView ? "is-on" : null)" aria-pressed="@(!Model.IsListView ? "true" : "false")" data-library-view="cards" title="Cards">
                <i class="bi bi-grid" aria-hidden="true"></i><span>Cards</span>
            </a>
        </div>
    </div>

    <!-- SECTION: Results with the reading pane beside them on wide screens -->
    <div class="library-body">
        <div class="library-results" id="libraryResults" aria-live="polite" aria-busy="false">
            <partial name="_ResultsRegion" model="Model" />
        </div>
        <aside class="library-pane" id="libraryPane" aria-label="Document preview" hidden></aside>
    </div>

    <!-- SECTION: Dialogs (filled by docrepo-ui.js) -->
    <div class="modal fade" id="libraryConfirm" tabindex="-1" aria-labelledby="libraryConfirmTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content library-dialog" method="post" data-library-dialog>
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title h5" id="libraryConfirmTitle" data-dialog-title>Deactivate document</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="library-dialog__subject" data-dialog-subject></p>
                    <p class="library-dialog__body" data-dialog-body></p>
                    <div class="library-dialog__reason" data-dialog-reason hidden>
                        <label class="form-label" for="libraryReason">Why should it be deleted?</label>
                        <textarea class="form-control" id="libraryReason" name="Reason" rows="3" maxlength="512"
                                  placeholder="For example: uploaded twice, wrong office, superseded by a newer circular"></textarea>
                        <div class="form-text">The approver sees this reason in the Decision Centre.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" data-dialog-confirm>Deactivate</button>
                </div>
            </form>
        </div>
    </div>
</div>
