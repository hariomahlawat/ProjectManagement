@page "{id:guid}"
@model ProjectManagement.Areas.DocumentRepository.Pages.Documents.ReaderModel
@{
    ViewData["Title"] = Model.DocumentTitle;
    ViewData["UseFullWidth"] = true;
    var textState = DocRepoFormat.TextState(Model.OcrStatus);
}

@section Styles {
    <link rel="stylesheet" href="~/css/docrepo-ui.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/docrepo-ui.js" asp-append-version="true"></script>
    <script src="~/js/docrepo-reader.js" asp-append-version="true"></script>
}

<div class="library library--reader" data-library
     data-favourite-url="@Model.ToggleFavouriteUrl">
    <form id="libraryToken" method="post" class="d-none">@Html.AntiForgeryToken()</form>

    <!-- SECTION: Title bar -->
    <header class="reader-bar">
        <a class="library-back" href="@Model.ReturnUrl"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to the library</a>
        <div class="reader-bar__row">
            <div class="reader-bar__title">
                <span class="library-eyebrow">@Model.DocumentCategoryName · @Model.OfficeName · @DocRepoFormat.Date(Model.DocumentDate)</span>
                <h1>@Model.DocumentTitle</h1>
                @if (Model.IsAots || !Model.IsActive)
                {
                    <p class="library-card__flags">
                        @if (Model.IsAots)
                        {
                            <span class="library-pill library-pill--aots"><i class="bi bi-broadcast" aria-hidden="true"></i>All officers to see</span>
                        }
                        @if (!Model.IsActive)
                        {
                            <span class="library-pill library-pill--muted" title="Hidden from everyone except the people who manage the library">Deactivated</span>
                        }
                    </p>
                }
            </div>
            <div class="reader-bar__actions">
                <button type="button" class="library-iconbtn library-star @(Model.IsFavourite ? "is-on" : null)" data-library-star data-doc-id="@Model.DocumentId"
                        aria-pressed="@(Model.IsFavourite ? "true" : "false")" aria-label="Favourite" title="Favourite">
                    <i class="bi @(Model.IsFavourite ? "bi-star-fill" : "bi-star")" aria-hidden="true"></i>
                </button>
                @if (!Model.IsFileMissing)
                {
                    <a class="btn btn-outline-secondary" href="@Model.ViewUrl" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open in new tab</a>
                    <a class="btn btn-primary" href="@Model.DownloadUrl"><i class="bi bi-download" aria-hidden="true"></i> Download</a>
                }
                @if (Model.CanEdit)
                {
                    <a class="btn btn-outline-secondary" asp-page="./Edit" asp-route-id="@Model.DocumentId"><i class="bi bi-pencil-square" aria-hidden="true"></i> Edit details</a>
                }
                @if (Model.CanManage)
                {
                    <div class="dropdown library-menu">
                        <button class="library-iconbtn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More actions">
                            <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (Model.OcrStatus == DocOcrStatus.Failed)
                            {
                                <li><a class="dropdown-item" href="@Model.ManageUrl" data-library-action="retry-ocr" data-doc-id="@Model.DocumentId" data-doc-subject="@Model.DocumentTitle"><i class="bi bi-arrow-repeat me-2" aria-hidden="true"></i>Read text again</a></li>
                            }
                            @if (Model.IsActive)
                            {
                                <li><a class="dropdown-item" href="@Model.ManageUrl" data-library-action="deactivate" data-doc-id="@Model.DocumentId" data-doc-subject="@Model.DocumentTitle" data-return-url="@Model.ReturnUrl"><i class="bi bi-eye-slash me-2" aria-hidden="true"></i>Deactivate</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item" href="@Model.ManageUrl" data-library-action="activate" data-doc-id="@Model.DocumentId" data-doc-subject="@Model.DocumentTitle"><i class="bi bi-eye me-2" aria-hidden="true"></i>Activate again</a></li>
                            }
                            <li><a class="dropdown-item library-menu__danger" href="@Model.ManageUrl" data-library-action="request-delete" data-doc-id="@Model.DocumentId" data-doc-subject="@Model.DocumentTitle"><i class="bi bi-trash3 me-2" aria-hidden="true"></i>Request deletion…</a></li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </header>

    <div class="reader-layout">
        <!-- SECTION: Viewer -->
        <div class="reader-stage">
            @if (Model.IsFileMissing)
            {
                <div class="library-empty reader-stage__missing">
                    <i class="bi bi-file-earmark-x" aria-hidden="true"></i>
                    <h2>The PDF file is missing</h2>
                    <p>The document's details are here, but its file is not in storage. Tell the library administrator; the Missing files page lists every affected document.</p>
                </div>
            }
            else
            {
                <div class="reader-viewer" data-reader-viewer>
                    <div class="reader-loading" data-reader-loading>
                        <div class="spinner-border" role="status" aria-label="Loading the document"></div>
                        <p>Opening the PDF…</p>
                        <p class="reader-loading__slow" data-reader-slow hidden>
                            This browser is taking a while to show the PDF.
                            <a href="@Model.ViewUrl" target="_blank" rel="noopener">Open it in a new tab</a> or <a href="@Model.DownloadUrl">download it</a>.
                        </p>
                    </div>
                    <iframe src="@Model.ViewUrl" title="@Model.DocumentTitle" data-reader-frame></iframe>
                </div>
            }
        </div>

        <!-- SECTION: Details -->
        <aside class="reader-details" aria-label="Document details">
            <section>
                <h2>About this document</h2>
                <dl class="library-facts">
                    <div><dt>Document date</dt><dd>@DocRepoFormat.Date(Model.DocumentDate)</dd></div>
                    <div><dt>Received from</dt><dd>@(string.IsNullOrWhiteSpace(Model.ReceivedFrom) ? "Not recorded" : Model.ReceivedFrom)</dd></div>
                    <div><dt>Office</dt><dd>@Model.OfficeName</dd></div>
                    <div><dt>Type</dt><dd>@Model.DocumentCategoryName</dd></div>
                    <div>
                        <dt>Tags</dt>
                        <dd>
                            @if (Model.Tags.Length > 0)
                            {
                                <ul class="library-tags">
                                    @foreach (var tag in Model.Tags)
                                    {
                                        <li><a href="@Url.Page("./Index", new { tag = tag.ToLowerInvariant() })">@tag</a></li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span class="reader-details__none">None</span>
                            }
                        </dd>
                    </div>
                </dl>
            </section>

            @if (Model.IsAots)
            {
                <section>
                    <h2>All officers to see</h2>
                    <p class="reader-details__note">
                        @(Model.IsAotsSeen ? "You have read this document." : "Opening this document marks it as read for you.")
                    </p>
                    @if (Model.CanViewAotsViews)
                    {
                        <a class="reader-details__link" href="@Model.AotsViewsUrl"><i class="bi bi-people" aria-hidden="true"></i> Read by @DocRepoFormat.Count(Model.AotsViewsCount, "officer")</a>
                    }
                </section>
            }

            <section>
                <h2>File</h2>
                <dl class="library-facts">
                    <div><dt>File name</dt><dd><span class="library-facts__file">@Model.OriginalFileName</span></dd></div>
                    <div><dt>Size</dt><dd>@DocRepoFormat.FileSize(Model.FileSizeBytes)</dd></div>
                    <div><dt>Searchable text</dt><dd>@(textState ?? "Ready")@if (Model.OcrStatus == DocOcrStatus.Failed && Model.CanManage && !string.IsNullOrWhiteSpace(Model.OcrFailureReason)) { <span class="reader-details__reason">@DocRepoFormat.ExplainOcrFailure(Model.OcrFailureReason)</span> }</dd></div>
                    <div><dt>Added</dt><dd>@(Model.CreatedAtUtc.HasValue ? DocRepoFormat.DateTime(Model.CreatedAtUtc.Value) : "Unknown")@(string.IsNullOrWhiteSpace(Model.CreatedByDisplay) ? null : $" by {Model.CreatedByDisplay}")</dd></div>
                    @if (Model.UpdatedAtUtc.HasValue)
                    {
                        <div><dt>Last changed</dt><dd>@DocRepoFormat.DateTime(Model.UpdatedAtUtc.Value)</dd></div>
                    }
                </dl>
            </section>
        </aside>
    </div>

    <partial name="_LibraryDialog" />
</div>
