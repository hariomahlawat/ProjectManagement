@page
@model ProjectManagement.Areas.ProjectOfficeReports.Pages.Ipr.IndexModel
@using System.Text.Json
@using System.Linq
@using ProjectManagement.Infrastructure.Data
@using ProjectManagement.Application.Ipr
@using Microsoft.AspNetCore.Routing
@functions {
    private static string CountLabel(int count, string singular, string plural)
        => $"{count} {(count == 1 ? singular : plural)}";

    private static bool IsProtectedStatus(string status)
        => status.Contains("granted", StringComparison.OrdinalIgnoreCase)
            || status.Contains("registered", StringComparison.OrdinalIgnoreCase)
            || status.Contains("protected", StringComparison.OrdinalIgnoreCase);

    private static bool IsClosedStatus(string status)
        => status.Contains("rejected", StringComparison.OrdinalIgnoreCase)
            || status.Contains("withdrawn", StringComparison.OrdinalIgnoreCase);

    private static string StatusBadgeClass(string status)
        => IsProtectedStatus(status)
            ? "ipr-status-badge--granted"
            : IsClosedStatus(status) ? "ipr-status-badge--closed" : "ipr-status-badge--filed";

    private static string FormatAge(int days)
    {
        if (days <= 0)
        {
            return "<1d";
        }

        if (days < 30)
        {
            return $"{days}d";
        }

        if (days < 365)
        {
            return $"{Math.Max(1, days / 30)}m";
        }

        var years = days / 365;
        var remainingMonths = (days % 365) / 30;
        return remainingMonths == 0
            ? $"{years}y"
            : $"{years}y {remainingMonths}m";
    }
}
@{
    ViewData["Title"] = "IPR Register";
    ViewData["UseFullWidth"] = true;

    var isCreateMode = string.Equals(Model.Mode, "create", StringComparison.OrdinalIgnoreCase);
    var isEditMode = string.Equals(Model.Mode, "edit", StringComparison.OrdinalIgnoreCase);
    var isRegister = Model.Tab == "records";
    var exportRouteValues = Model.GetRouteValuesForLinks(includeModeAndId: false);
    var recordsJson = JsonSerializer.Serialize(Model.Records);
    var patentBreakdown = Model.TypeBreakdown.FirstOrDefault(item => item.Type == IprType.Patent);
    var copyrightBreakdown = Model.TypeBreakdown.FirstOrDefault(item => item.Type == IprType.Copyright);
    var patentFiled = patentBreakdown?.Filed ?? 0;
    var copyrightFiled = copyrightBreakdown?.Filed ?? 0;
    var patentProtected = patentBreakdown?.Protected ?? 0;
    var copyrightProtected = copyrightBreakdown?.Protected ?? 0;
    var closedCount = Model.Kpis.Rejected + Model.Kpis.Withdrawn;
    var registerTotal = Model.Kpis.Total + closedCount;
    double Share(int part, int whole) => whole == 0 ? 0 : Math.Round(part * 100d / whole, 1);
    var filterButtonAriaLabel = Model.StructuredFilterCount > 0
        ? $"Open IPR filters, {Model.StructuredFilterCount} active"
        : "Open IPR filters";
    var registerUrl = Url.Page("./Index", new { tab = "records" });
    var summaryCards = new[]
    {
        new { Scope = "counted", Statuses = Array.Empty<string>(), Label = "Filed", Value = Model.Kpis.Total, Unit = "filings",
              Sub = $"{patentFiled} {(patentFiled == 1 ? "patent" : "patents")} · {copyrightFiled} {(copyrightFiled == 1 ? "copyright" : "copyrights")}",
              BarA = Share(patentFiled, Model.Kpis.Total), BarAClass = "is-patent", BarB = Share(copyrightFiled, Model.Kpis.Total), BarBClass = "is-copyright" },
        new { Scope = "Granted", Statuses = new[] { "Granted" }, Label = "Granted", Value = Model.Kpis.Granted, Unit = $"{Model.GrantRatePercent}% of filed",
              Sub = $"{patentProtected} {(patentProtected == 1 ? "patent" : "patents")} granted · {copyrightProtected} {(copyrightProtected == 1 ? "copyright" : "copyrights")} registered",
              BarA = Share(Model.Kpis.Granted, Model.Kpis.Total), BarAClass = "is-granted", BarB = 0d, BarBClass = string.Empty },
        new { Scope = "Filed", Statuses = new[] { "Filed" }, Label = "Pending", Value = Model.Kpis.Filed, Unit = "awaiting outcome",
              Sub = $"{Model.OverdueAttentionCount} pending for more than 3 years",
              BarA = Share(Model.Kpis.Filed - Model.OverdueAttentionCount, Model.Kpis.Total), BarAClass = "is-pending", BarB = Share(Model.OverdueAttentionCount, Model.Kpis.Total), BarBClass = "is-overdue" },
        new { Scope = "closed", Statuses = new[] { "Rejected", "Withdrawn" }, Label = "Closed", Value = closedCount, Unit = "history",
              Sub = $"{Model.Kpis.Rejected} rejected · {Model.Kpis.Withdrawn} withdrawn · not counted as filed",
              BarA = Share(closedCount, registerTotal), BarAClass = "is-closed", BarB = 0d, BarBClass = string.Empty }
    };
    var registerState = JsonSerializer.Serialize(new
    {
        query = Model.Query ?? string.Empty,
        types = Model.Types.Select(type => type.ToString()).ToArray(),
        statuses = Model.Statuses.Select(status => status.ToString()).ToArray(),
        year = Model.Year?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty,
        dateBasis = Model.DateBasis.ToString(),
        linkage = Model.Linkage.ToString(),
        evidence = Model.Evidence.ToString(),
        pendingAge = Model.PendingAge.ToString(),
        projectId = Model.ProjectId?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty,
        group = Model.Group ?? string.Empty,
        selectedRecordId = Model.SelectedRecordId?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty
    });
    // Pending-age bands, defined once in IprQueryFilter: name -> [min days, max days or null].
    var pendingAgeBands = JsonSerializer.Serialize(
        Enum.GetValues<IprPendingAge>()
            .Where(band => band != IprPendingAge.Any)
            .ToDictionary(
                band => band.ToString(),
                band =>
                {
                    var range = IprQueryFilter.PendingAgeRange(band);
                    return new { min = range.MinDays, max = range.MaxDays, label = ProjectManagement.Areas.ProjectOfficeReports.Pages.Ipr.IndexModel.GetPendingAgeLabel(band) };
                }));
    var filedYears = Model.Records
        .Where(record => record.FiledYear.HasValue)
        .Select(record => record.FiledYear!.Value)
        .Distinct()
        .OrderByDescending(year => year)
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/site-ipr.css" asp-append-version="true" />
}

<div class="ipr-register-page" data-ipr-density-root>
    <header class="ipr-workspace-header">
        <div>
            <span class="ipr-workspace-header__eyebrow">Project office reports</span>
            <h1>IPR Register</h1>
            <p>Patents and copyrights filed for SDD projects. Filed counts include granted records.</p>
        </div>
        <div class="ipr-workspace-header__actions">
            <button type="button"
                    class="btn btn-outline-secondary ipr-guidance-trigger"
                    data-bs-toggle="modal"
                    data-bs-target="#iprGuidanceModal">
                <i class="bi bi-info-circle" aria-hidden="true"></i> Patent or copyright?
            </button>
            @if (!isRegister)
            {
                <button type="button"
                        class="btn btn-outline-primary ipr-header-filter-button @(Model.HasStructuredFilters ? "is-active" : string.Empty)"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#iprFilterOffcanvas"
                        aria-controls="iprFilterOffcanvas"
                        aria-label="@filterButtonAriaLabel">
                    <i class="bi bi-funnel" aria-hidden="true"></i>
                    <span>Filters</span>
                    @if (Model.StructuredFilterCount > 0)
                    {
                        <span class="ipr-header-filter-button__count">@Model.StructuredFilterCount</span>
                    }
                </button>
            }
            <a asp-page="./Index" asp-page-handler="Export" asp-all-route-data="exportRouteValues" class="btn btn-outline-secondary" data-ipr-export>
                <i class="bi bi-download" aria-hidden="true"></i> Export
            </a>
            @if (Model.CanEdit)
            {
                <a asp-page="./Index"
                   asp-all-route-data="@Model.GetRouteValuesForLinks(new { mode = "create" }, includeModeAndId: false)"
                   class="btn btn-primary">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Add IPR record
                </a>
            }
        </div>
    </header>

    <section class="ipr-summary" aria-label="IPR register summary">
        @foreach (var card in summaryCards)
        {
            var cardHref = card.Statuses.Length == 0
                ? registerUrl
                : registerUrl + string.Concat(card.Statuses.Select(status => "&statuses=" + status));
            <a href="@cardHref" class="ipr-summary-card ipr-summary-card--@card.Scope.ToLowerInvariant()" data-ipr-scope="@card.Scope">
                <span class="ipr-summary-card__label">@card.Label</span>
                <span class="ipr-summary-card__figure"><strong>@card.Value</strong><span>@card.Unit</span></span>
                <span class="ipr-summary-card__bar" aria-hidden="true">
                    <span class="@card.BarAClass" style="width:@(card.BarA.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
                    @if (card.BarB > 0)
                    {
                        <span class="@card.BarBClass" style="width:@(card.BarB.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
                    }
                </span>
                <span class="ipr-summary-card__sub">@card.Sub</span>
            </a>
        }
    </section>

    <nav class="ipr-views" aria-label="IPR views">
        <a href="@registerUrl" class="@(isRegister ? "is-active" : string.Empty)" aria-current="@(isRegister ? "page" : null)">Register</a>
        <a href="@Url.Page("./Index", new { tab = "followup" })" class="@(Model.Tab == "followup" ? "is-active" : string.Empty)" aria-current="@(Model.Tab == "followup" ? "page" : null)">
            Action list
            @if (Model.AttentionRecordCount > 0)
            {
                <span class="ipr-views__badge">@Model.AttentionRecordCount</span>
            }
        </a>
        <a href="@Url.Page("./Index", new { tab = "analytics" })" class="@(Model.Tab == "analytics" ? "is-active" : string.Empty)" aria-current="@(Model.Tab == "analytics" ? "page" : null)">Insights</a>
    </nav>

    @if (!isRegister)
    {
        <partial name="_ActiveFilterChips" model="Model" />
    }

    @if (isRegister)
    {
        <section class="ipr-register"
                 aria-label="IPR records"
                 data-ipr-register
                 data-ipr-state="@registerState"
                 data-ipr-age-bands="@pendingAgeBands"
                 data-ipr-can-edit="@(Model.CanEdit ? "true" : "false")"
                 data-ipr-project-base-url="@Url.Page("/Projects/Overview", new { area = "" })"
                 data-ipr-download-url="@Url.Page("./Download")">
            <div class="ipr-filterbar">
                <label class="ipr-filterbar__search">
                    <span class="visually-hidden">Search IPR records</span>
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" value="@Model.Query" placeholder="Search title, filing number or project" data-ipr-filter-query autocomplete="off" />
                </label>
                <div class="ipr-seg" role="group" aria-label="Category">
                    <button type="button" class="ipr-seg__item" data-ipr-filter-type="all" aria-pressed="false">All</button>
                    <button type="button" class="ipr-seg__item" data-ipr-filter-type="Patent" aria-pressed="false">Patents <span data-ipr-count></span></button>
                    <button type="button" class="ipr-seg__item" data-ipr-filter-type="Copyright" aria-pressed="false">Copyrights <span data-ipr-count></span></button>
                </div>
                <div class="ipr-seg" role="group" aria-label="Status">
                    <button type="button" class="ipr-seg__item" data-ipr-filter-status="counted" aria-pressed="false">Filed <span data-ipr-count></span></button>
                    <button type="button" class="ipr-seg__item" data-ipr-filter-status="Filed" aria-pressed="false">Pending <span data-ipr-count></span></button>
                    <button type="button" class="ipr-seg__item" data-ipr-filter-status="Granted" aria-pressed="false">Granted <span data-ipr-count></span></button>
                    <button type="button" class="ipr-seg__item" data-ipr-filter-status="closed" aria-pressed="false">Closed <span data-ipr-count></span></button>
                </div>
            </div>
            <div class="ipr-filterbar ipr-filterbar--secondary">
                <button type="button" class="ipr-chip" data-ipr-filter-flag="missing" aria-pressed="false">Missing evidence <span data-ipr-count></span></button>
                <button type="button" class="ipr-chip" data-ipr-filter-flag="unassigned" aria-pressed="false">Not linked to a project <span data-ipr-count></span></button>
                <label class="ipr-filterbar__select">
                    <span data-ipr-year-label>Filed in</span>
                    <select class="form-select form-select-sm" data-ipr-filter-year>
                        <option value="">Any year</option>
                        @foreach (var year in filedYears)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </label>
                <label class="ipr-filterbar__select">
                    <span>Group by</span>
                    <select class="form-select form-select-sm" data-ipr-group>
                        <option value="">Nothing</option>
                        <option value="project">Project</option>
                        <option value="status">Status</option>
                        <option value="year">Filing year</option>
                    </select>
                </label>
                <span class="ipr-chip is-on d-none" data-ipr-age-chip>
                    <span data-ipr-age-chip-label></span>
                    <button type="button" class="ipr-chip__remove" data-ipr-age-chip-clear aria-label="Remove pending-age filter"><i class="bi bi-x" aria-hidden="true"></i></button>
                </span>
                <span class="ipr-chip is-on d-none" data-ipr-project-chip>
                    <span data-ipr-project-chip-label></span>
                    <button type="button" class="ipr-chip__remove" data-ipr-project-chip-clear aria-label="Remove project filter"><i class="bi bi-x" aria-hidden="true"></i></button>
                </span>
                <span class="ipr-filterbar__spacer"></span>
                <span class="ipr-filterbar__count" data-ipr-result-count aria-live="polite">@Model.TotalCount records</span>
                <button type="button" class="btn btn-link btn-sm d-none" data-ipr-clear>Clear filters</button>
                <div class="ipr-density-toggle" role="group" aria-label="Row height">
                    <button type="button" class="btn is-active" data-ipr-density="compact" aria-pressed="true" title="Compact rows">
                        <i class="bi bi-list" aria-hidden="true"></i><span class="visually-hidden">Compact</span>
                    </button>
                    <button type="button" class="btn" data-ipr-density="comfortable" aria-pressed="false" title="Comfortable rows">
                        <i class="bi bi-list-ul" aria-hidden="true"></i><span class="visually-hidden">Comfortable</span>
                    </button>
                </div>
            </div>

            <div class="ipr-table-card">
                <div class="ipr-table-scroll">
                    <table class="ipr-table" aria-label="IPR records">
                        <thead>
                            <tr>
                                <th scope="col">IPR record</th>
                                <th scope="col">Project</th>
                                <th scope="col">Category</th>
                                <th scope="col">Status</th>
                                <th scope="col">Filed</th>
                                <th scope="col">Granted</th>
                                <th scope="col">Evidence</th>
                            </tr>
                        </thead>
                        <tbody data-ipr-rows>
                            @foreach (var row in Model.Records)
                            {
                                // One field per line: the browser matches each field on its own, as IprQueryFilter does.
                                var searchText = string.Join("\n", row.Title, row.ApplicationNumber, row.ProjectId.HasValue ? row.ProjectName : string.Empty);
                                <tr data-ipr-row
                                    data-id="@row.Id"
                                    data-type="@row.TypeKey"
                                    data-status="@row.StatusKey"
                                    data-counted="@(row.IsCounted ? "true" : "false")"
                                    data-closed="@(row.IsClosed ? "true" : "false")"
                                    data-files="@row.AttachmentCount"
                                    data-project-id="@row.ProjectId"
                                    data-project="@(row.ProjectId.HasValue ? row.ProjectName : string.Empty)"
                                    data-filed-year="@row.FiledYear"
                                    data-granted-year="@row.GrantedYear"
                                    data-pending-days="@row.PendingDays"
                                    data-search="@searchText"
                                    class="@(row.Id == Model.SelectedRecordId ? "is-selected" : string.Empty)">
                                    <td>
                                        <button type="button" class="ipr-table__title" data-ipr-open="@row.Id">@row.Title</button>
                                        <span class="ipr-table__meta">@row.ApplicationNumber</span>
                                    </td>
                                    <td>
                                        @if (row.ProjectId.HasValue)
                                        {
                                            <span class="ipr-table__project">@row.ProjectName</span>
                                        }
                                        else
                                        {
                                            <span class="ipr-table__project is-unlinked">Not linked</span>
                                        }
                                    </td>
                                    <td class="ipr-nowrap"><span class="ipr-type-dot ipr-type-dot--@row.TypeKey.ToLowerInvariant()"></span>@row.IprType</td>
                                    <td>
                                        <span class="ipr-status-badge @StatusBadgeClass(row.Status)">@row.Status</span>
                                        @if (!string.IsNullOrEmpty(row.PendingAge))
                                        {
                                            <span class="ipr-table__age" title="Pending since filing">@row.PendingAge</span>
                                        }
                                    </td>
                                    <td class="ipr-nowrap">@(row.FiledOn?.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "—")</td>
                                    <td class="ipr-nowrap">@(row.GrantedOn?.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "—")</td>
                                    <td class="ipr-nowrap">
                                        @if (row.AttachmentCount > 0)
                                        {
                                            <span class="ipr-table__evidence"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>@row.AttachmentCount PDF</span>
                                        }
                                        else
                                        {
                                            <span class="ipr-table__evidence is-missing">Missing</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="ipr-register-empty @(Model.TotalCount > 0 ? "d-none" : string.Empty)" data-ipr-empty>
                    <h3 data-ipr-empty-title>@(Model.TotalCount > 0 ? "No records match" : "No IPR records yet")</h3>
                    <p data-ipr-empty-hint>@(Model.TotalCount > 0 ? "Try another search or remove a filter." : "Add the first patent or copyright filing.")</p>
                    <button type="button" class="btn btn-outline-secondary btn-sm @(Model.TotalCount > 0 ? string.Empty : "d-none")" data-ipr-clear>Clear filters</button>
                </div>
            </div>

            <div class="ipr-record-scrim" data-ipr-panel-scrim hidden></div>
            <aside class="ipr-record-panel" id="iprRecordPanel" data-ipr-panel hidden role="dialog" aria-modal="true" aria-labelledby="iprRecordPanelTitle" tabindex="-1">
                <header class="ipr-record-panel__header">
                    <div>
                        <span class="ipr-record-panel__eyebrow"><span class="ipr-type-dot" data-ipr-panel-dot></span><span data-ipr-panel-eyebrow></span></span>
                        <h2 id="iprRecordPanelTitle" data-ipr-panel-title></h2>
                        <span class="ipr-status-badge" data-ipr-panel-status></span>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm ipr-record-panel__close" data-ipr-panel-close aria-label="Close record"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                </header>
                @if (Model.CanEdit)
                {
                    <div class="ipr-record-panel__actions">
                        <a class="btn btn-primary btn-sm" data-ipr-panel-edit href="#"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</a>
                        <a class="btn btn-outline-secondary btn-sm d-none" data-ipr-panel-grant href="#">Record grant</a>
                        <a class="btn btn-outline-secondary btn-sm" data-ipr-panel-evidence href="#"><i class="bi bi-upload" aria-hidden="true"></i> Add evidence</a>
                    </div>
                }
                <dl class="ipr-record-panel__facts">
                    <div><dt>Filing number</dt><dd data-ipr-panel-number></dd></div>
                    <div><dt>Category</dt><dd data-ipr-panel-type></dd></div>
                    <div><dt>Filed on</dt><dd data-ipr-panel-filed></dd></div>
                    <div><dt data-ipr-panel-granted-label>Granted on</dt><dd data-ipr-panel-granted></dd></div>
                    <div><dt>Filed by</dt><dd data-ipr-panel-by></dd></div>
                    <div><dt>Project</dt><dd data-ipr-panel-project></dd></div>
                </dl>
                <section class="ipr-record-panel__section">
                    <h3>Progress</h3>
                    <ol class="ipr-record-progress">
                        <li class="is-done"><strong>Filed</strong><span data-ipr-panel-progress-filed></span></li>
                        <li data-ipr-panel-progress-outcome><strong data-ipr-panel-outcome-title></strong><span data-ipr-panel-outcome-text></span></li>
                    </ol>
                </section>
                <section class="ipr-record-panel__section">
                    <h3>Evidence</h3>
                    <div class="ipr-record-panel__files" data-ipr-panel-files></div>
                </section>
                <section class="ipr-record-panel__section">
                    <h3>Notes</h3>
                    <p class="ipr-record-panel__notes" data-ipr-panel-notes></p>
                </section>
            </aside>
            <script type="application/json" id="iprRecordData">@Html.Raw(recordsJson)</script>
        </section>
    }
    else if (Model.Tab == "followup")
    {
        var issueFilters = new[]
        {
            (Key: (string?)null, Label: "All issues", Count: Model.FollowUpTotalCount),
            (Key: (string?)"overdue", Label: "Long pending", Count: Model.AttentionIssueCounts.GetValueOrDefault("overdue")),
            (Key: (string?)"data", Label: "Details to correct", Count: Model.AttentionIssueCounts.GetValueOrDefault("data")),
            (Key: (string?)"linkage", Label: "Not linked", Count: Model.AttentionIssueCounts.GetValueOrDefault("linkage")),
            (Key: (string?)"evidence", Label: "Missing evidence", Count: Model.AttentionIssueCounts.GetValueOrDefault("evidence"))
        };
        <section class="ipr-actions" aria-labelledby="iprActionsHeading">
            <header class="ipr-actions__header">
                <div>
                    <h2 id="iprActionsHeading">Action list</h2>
                    <p>Each filing appears once, under its most urgent issue. Fix it from here; other issues on the same filing show as tags.</p>
                </div>
                <span class="ipr-actions__total">@(Model.FollowUpTotalCount == 1 ? "1 filing needs action" : $"{Model.FollowUpTotalCount} filings need action")</span>
            </header>

            <nav class="ipr-seg ipr-actions__filters" aria-label="Show issues">
                @foreach (var filter in issueFilters)
                {
                    var isActive = string.Equals(Model.AttentionIssue, filter.Key, StringComparison.Ordinal);
                    <a class="ipr-seg__item @(isActive ? "is-on" : string.Empty)"
                       aria-current="@(isActive ? "true" : null)"
                       asp-page="./Index"
                       asp-all-route-data="@Model.GetRouteValuesForLinks(new { tab = "followup", attentionIssue = filter.Key }, includePage: false, includeModeAndId: false)">
                        @filter.Label <span data-ipr-count>@filter.Count</span>
                    </a>
                }
            </nav>

            @if (Model.AttentionGroups.Count == 0)
            {
                <div class="ipr-actions__empty">
                    <i class="bi bi-check2-circle" aria-hidden="true"></i>
                    <h3>Nothing needs action</h3>
                    <p>Every filing in this view is linked to a project, has evidence on file and consistent dates, and none has been pending for more than 3 years.</p>
                </div>
            }
            else
            {
                <div class="ipr-actions__groups">
                    @foreach (var group in Model.AttentionGroups)
                    {
                        var actionLabel = group.Key switch
                        {
                            "overdue" => "Record outcome",
                            "data" => "Fix details",
                            "linkage" => "Assign project",
                            _ => "Upload PDF"
                        };
                        var actionFragment = group.Key switch
                        {
                            "linkage" => "Input_ProjectSearch",
                            "evidence" => "iprEvidenceHeading",
                            "overdue" => "iprStatusDatesHeading",
                            _ => null
                        };
                        <article class="ipr-actions-group ipr-actions-group--@group.Tone" aria-labelledby="iprActions-@group.Key">
                            <header>
                                <div>
                                    <h3 id="iprActions-@group.Key">@group.Title <span class="ipr-actions-group__count">@group.Items.Count</span></h3>
                                    <p>@group.Description</p>
                                </div>
                            </header>
                            <ul class="ipr-actions-list">
                                @foreach (var item in group.Items)
                                {
                                    var openRoutes = Model.GetRouteValuesForLinks(new { tab = "records", selectedRecordId = item.Id, attentionIssue = (string?)null }, includePage: false, includeModeAndId: false);
                                    var fixRoutes = Model.GetRouteValuesForLinks(new { tab = "followup", mode = "edit", id = item.Id }, includePage: false, includeModeAndId: false);
                                    <li class="ipr-actions-item">
                                        <div class="ipr-actions-item__main">
                                            <a class="ipr-actions-item__title" asp-page="./Index" asp-all-route-data="openRoutes">@item.Title</a>
                                            <span class="ipr-actions-item__meta">@item.Type · @item.ProjectName</span>
                                            <span class="ipr-actions-item__tags">
                                                @for (var index = 0; index < item.Reasons.Count; index++)
                                                {
                                                    <span class="ipr-issue @(index == 0 ? "is-primary" : string.Empty)">@item.Reasons[index]</span>
                                                }
                                            </span>
                                        </div>
                                        <div class="ipr-actions-item__fact">
                                            @if (item.WaitingDays.HasValue)
                                            {
                                                <strong>@FormatAge(item.WaitingDays.Value)</strong>
                                                <span>since filing on @(item.FiledOn?.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "an unknown date")</span>
                                            }
                                            else if (item.FiledOn.HasValue)
                                            {
                                                <strong>@item.FiledOn.Value.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</strong>
                                                <span>filed</span>
                                            }
                                        </div>
                                        <div class="ipr-actions-item__action">
                                            @if (Model.CanEdit)
                                            {
                                                <a class="btn btn-sm btn-outline-primary" asp-page="./Index" asp-all-route-data="fixRoutes" asp-fragment="@actionFragment">@actionLabel</a>
                                            }
                                            else
                                            {
                                                <a class="btn btn-sm btn-outline-secondary" asp-page="./Index" asp-all-route-data="openRoutes">Open</a>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                        </article>
                    }
                </div>
            }
        </section>
    }
    else
    {
        // Insights: every bar and figure opens the register filtered to those filings, within
        // the current scope (the Filters drawer), using the register's own URL parameters.
        IDictionary<string, string?> RegisterLink(object overrides)
        {
            var values = new RouteValueDictionary(overrides)
            {
                ["tab"] = "records",
                ["attentionIssue"] = null
            };
            return Model.GetRouteValuesForLinks(values, includePage: false, includeModeAndId: false);
        }

        var summary = Model.AnalyticsSummary;
        var withEvidence = Math.Max(0, summary.Total - summary.MissingAttachments);
        var evidencePercent = summary.Total == 0 ? 100 : (int)Math.Round(withEvidence * 100d / summary.Total, MidpointRounding.AwayFromZero);
        var cohortMax = Math.Max(1, Model.FilingCohorts.Select(row => row.Filed).DefaultIfEmpty(0).Max());
        var eventMax = Math.Max(1, Model.YearlyStats.Select(row => Math.Max(row.Filed, row.Granted)).DefaultIfEmpty(0).Max());
        var ageMax = Math.Max(1, Model.AwaitingAgeBands.Select(band => band.Count).DefaultIfEmpty(0).Max());
        string BarHeight(int value, int max) => $"height:{Math.Round(value * 150d / max, 1).ToString(System.Globalization.CultureInfo.InvariantCulture)}px";
        <section class="ipr-insights" aria-labelledby="iprInsightsHeading">
            <header class="ipr-actions__header">
                <div>
                    <h2 id="iprInsightsHeading">Insights</h2>
                    <p>How the portfolio is moving. Select any bar or figure to open those filings in the register.</p>
                </div>
                <span class="ipr-actions__total">
                    @(Model.HasStructuredFilters ? "Scope: " + string.Join(" · ", Model.ActiveFilterChips.Where(chip => chip.Key != "query").Select(chip => chip.Label)) : "Whole register")
                    @if (Model.HasStructuredFilters)
                    {
                        <a asp-page="./Index" asp-all-route-data="@Model.BuildClearFiltersRoute(includeQuery: false)">Clear scope</a>
                    }
                </span>
            </header>

            <div class="ipr-insights__kpis">
                <a class="ipr-insights-kpi" asp-page="./Index" asp-all-route-data="@RegisterLink(new { statuses = new[] { "Granted" } })">
                    <span>Grant rate</span>
                    <strong>@summary.GrantRatePercent%</strong>
                    <small>@summary.TypeRows.Sum(row => row.Protected) of @summary.Total filings granted</small>
                </a>
                <div class="ipr-insights-kpi">
                    <span>Median time to grant</span>
                    <strong>@(summary.MedianGrantDays.HasValue ? FormatAge(summary.MedianGrantDays.Value) : "—")</strong>
                    <small>filing to grant or registration</small>
                </div>
                <a class="ipr-insights-kpi" asp-page="./Index" asp-all-route-data="@RegisterLink(new { statuses = new[] { "Filed" } })">
                    <span>Median pending age</span>
                    <strong>@(summary.MedianAwaitingDays.HasValue ? FormatAge(summary.MedianAwaitingDays.Value) : "—")</strong>
                    <small>@summary.TypeRows.Sum(row => row.Pending) filings awaiting an outcome</small>
                </a>
                <a class="ipr-insights-kpi" asp-page="./Index" asp-all-route-data="@RegisterLink(new { evidence = "Missing" })">
                    <span>Evidence coverage</span>
                    <strong>@evidencePercent%</strong>
                    <small>@summary.MissingAttachments without a PDF · show them</small>
                </a>
            </div>

            <div class="ipr-insights__grid">
                <article class="ipr-insights-card">
                    <h3>Outcome by filing year</h3>
                    <p>Of the filings made each year, how many are granted so far.</p>
                    @if (Model.FilingCohorts.Count == 0)
                    {
                        <p class="ipr-insights-card__empty">No filings in this scope.</p>
                    }
                    else
                    {
                        <div class="ipr-bars" role="list">
                            @foreach (var cohort in Model.FilingCohorts)
                            {
                                <a class="ipr-bars__item" role="listitem"
                                   asp-page="./Index"
                                   asp-all-route-data="@RegisterLink(new { year = cohort.Year, dateBasis = (string?)null })"
                                   aria-label="@($"{cohort.Year}: {cohort.Filed} filed, {cohort.Granted} granted. Show these filings")">
                                    <span class="ipr-bars__value">@cohort.GrantRatePercent%</span>
                                    <span class="ipr-bars__stack">
                                        <span class="is-pending" style="@BarHeight(cohort.Pending, cohortMax)"></span>
                                        <span class="is-granted" style="@BarHeight(cohort.Granted, cohortMax)"></span>
                                    </span>
                                    <span class="ipr-bars__label">@cohort.Year</span>
                                    <span class="ipr-bars__sub">@cohort.Filed filed</span>
                                </a>
                            }
                        </div>
                        <div class="ipr-insights-legend"><span><i class="is-granted"></i>Granted</span><span><i class="is-pending"></i>Still pending</span></div>
                    }
                </article>

                <article class="ipr-insights-card">
                    <h3>Filings and grants by year</h3>
                    <p>Filings counted in the filing year; grants and registrations in the year they came through.</p>
                    @if (Model.YearlyStats.Count == 0)
                    {
                        <p class="ipr-insights-card__empty">No filings in this scope.</p>
                    }
                    else
                    {
                        <div class="ipr-bars" role="list">
                            @foreach (var row in Model.YearlyStats)
                            {
                                <div class="ipr-bars__item ipr-bars__item--pair" role="listitem">
                                    <span class="ipr-bars__pair">
                                        <a class="is-filed" style="@BarHeight(row.Filed, eventMax)"
                                           asp-page="./Index" asp-all-route-data="@RegisterLink(new { year = row.Year, dateBasis = (string?)null })"
                                           title="@($"{row.Filed} filed in {row.Year}")"
                                           aria-label="@($"{row.Filed} filed in {row.Year}. Show them")"></a>
                                        <a class="is-granted" style="@BarHeight(row.Granted, eventMax)"
                                           asp-page="./Index" asp-all-route-data="@RegisterLink(new { year = row.Year, dateBasis = "Protected" })"
                                           title="@($"{row.Granted} granted in {row.Year}")"
                                           aria-label="@($"{row.Granted} granted in {row.Year}. Show them")"></a>
                                    </span>
                                    <span class="ipr-bars__label">@row.Year</span>
                                    <span class="ipr-bars__sub">@row.Filed / @row.Granted</span>
                                </div>
                            }
                        </div>
                        <div class="ipr-insights-legend"><span><i class="is-filed"></i>Filed</span><span><i class="is-granted"></i>Granted</span></div>
                    }
                </article>

                <article class="ipr-insights-card">
                    <h3>Pending by age</h3>
                    <p>How long pending filings have waited since filing.</p>
                    <div class="ipr-hbars">
                        @foreach (var band in Model.AwaitingAgeBands)
                        {
                            <a class="ipr-hbars__item" asp-page="./Index" asp-all-route-data="@RegisterLink(new { pendingAge = band.Band.ToString() })">
                                <span>@band.Label</span>
                                <span class="ipr-hbars__track"><span class="ipr-hbars__fill ipr-hbars__fill--@band.Tone" style="width:@(Math.Round(band.Count * 100d / ageMax, 1).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
                                <strong>@band.Count</strong>
                            </a>
                        }
                    </div>
                </article>

                <article class="ipr-insights-card">
                    <h3>Patents and copyrights</h3>
                    <p>Filed includes granted records.</p>
                    <table class="ipr-insights-table">
                        <thead><tr><th scope="col">Category</th><th scope="col">Filed</th><th scope="col">Granted</th><th scope="col">Pending</th><th scope="col">Rate</th></tr></thead>
                        <tbody>
                            @foreach (var row in summary.TypeRows)
                            {
                                var typeKey = row.Type.ToString();
                                <tr>
                                    <th scope="row"><span class="ipr-type-dot ipr-type-dot--@typeKey.ToLowerInvariant()"></span>@(row.Type == IprType.Copyright ? "Copyrights" : "Patents")</th>
                                    <td><a asp-page="./Index" asp-all-route-data="@RegisterLink(new { types = new[] { typeKey } })">@row.Filed</a></td>
                                    <td><a asp-page="./Index" asp-all-route-data="@RegisterLink(new { types = new[] { typeKey }, statuses = new[] { "Granted" } })">@row.Protected</a></td>
                                    <td><a asp-page="./Index" asp-all-route-data="@RegisterLink(new { types = new[] { typeKey }, statuses = new[] { "Filed" } })">@row.Pending</a></td>
                                    <td>@(row.Filed == 0 ? "—" : $"{Math.Round(row.Protected * 100d / row.Filed):0}%")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </article>
            </div>
        </section>
    }

    @if (Model.CanEdit && (isCreateMode || isEditMode))
    {
        // The editor opens where the record panel opens. Closing an edit returns to the record.
        var editorCloseRoutes = isEditMode && Model.Input.Id.HasValue
            ? Model.GetRouteValuesForLinks(new { selectedRecordId = Model.Input.Id }, includeModeAndId: false)
            : Model.GetRouteValuesForLinks(includeModeAndId: false);
        var editorCloseUrl = Url.Page("./Index", editorCloseRoutes.ToDictionary(pair => pair.Key, pair => (object?)pair.Value));
        <a class="ipr-record-scrim" href="@editorCloseUrl" aria-label="Close editor" tabindex="-1" data-ipr-editor-close></a>
        <aside class="ipr-record-panel ipr-record-panel--editor ipr-record-drawer"
               id="iprRecordEditor"
               data-ipr-editor
               data-ipr-close-url="@editorCloseUrl"
               data-ipr-has-form="true"
               role="dialog"
               aria-modal="true"
               aria-labelledby="iprRecordEditorTitle"
               tabindex="-1">
            <header class="ipr-record-panel__header">
                <div>
                    <span class="ipr-record-panel__eyebrow">@(isCreateMode ? "New record" : $"Editing · {Model.Input.FilingNumber}")</span>
                    <h2 id="iprRecordEditorTitle">@(isCreateMode ? "Add IPR record" : (string.IsNullOrWhiteSpace(Model.Input.Title) ? "Edit IPR record" : Model.Input.Title))</h2>
                </div>
                <a class="btn btn-outline-secondary btn-sm ipr-record-panel__close" href="@editorCloseUrl" aria-label="Close editor" data-ipr-editor-close><i class="bi bi-x-lg" aria-hidden="true"></i></a>
            </header>
            <partial name="_RecordFormPartial" model="Model" />
        </aside>
    }

    @if (!isRegister)
    {
        <partial name="_IprFilterDrawer" model="Model" />
    }
    <partial name="_IprGuidanceModal" />
</div>

@section Scripts {
    <partial name="~/Pages/Shared/_ValidationScriptsPartial.cshtml" />
    <script src="~/js/project-office-reports/ipr/index.js" defer asp-append-version="true"></script>
    <script src="~/js/project-office-reports/ipr/register-view.js" defer asp-append-version="true"></script>
}
