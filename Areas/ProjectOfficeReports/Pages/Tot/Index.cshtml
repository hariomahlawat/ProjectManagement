@page
@model ProjectManagement.Areas.ProjectOfficeReports.Pages.Tot.IndexModel

@using System.Globalization
@using ProjectManagement.Utilities.PartialDates
@using ProjectManagement.Models

@section Styles
{
    <link rel="stylesheet" href="~/css/tot.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/project-tot-drawer.css" asp-append-version="true" />
    
}

@{
    ViewData["Title"] = "Transfer of Technology";

    string StatusLabel(ProjectTotStatus status) => ProjectManagement.Services.Projects.ProjectTotPresentation.StatusLabel(status);

    string RequestStateLabel(ProjectTotRequestDecisionState state) => state switch
    {
        ProjectTotRequestDecisionState.Pending => "Pending approval",
        ProjectTotRequestDecisionState.Approved => "Approved",
        ProjectTotRequestDecisionState.Rejected => "Rejected",
        _ => state.ToString()
    };

    string TotStatusChipClass(ProjectTotStatus status) => status switch
    {
        ProjectTotStatus.NotRequired => "chip-status-not-required",
        ProjectTotStatus.NotStarted => "chip-status-not-started",
        ProjectTotStatus.InProgress => "chip-status-in-progress",
        ProjectTotStatus.Completed => "chip-status-completed",
        ProjectTotStatus.NotKnown => "chip-status-not-required",
        _ => "chip-status-not-started"
    };

    string RequestStateChipClass(ProjectTotRequestDecisionState state) => state switch
    {
        ProjectTotRequestDecisionState.Pending => "chip-decision-pending",
        ProjectTotRequestDecisionState.Approved => "chip-decision-approved",
        ProjectTotRequestDecisionState.Rejected => "chip-decision-rejected",
        _ => "chip-decision-pending"
    };


    var summary = Model.Summary;

    var totalCount = Model.Projects.Count;
    var resultCountText = totalCount == 0
        ? "No projects"
        : totalCount == 1
            ? "Showing 1 project"
            : $"Showing {totalCount} projects";

    var filterBits = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.SearchTerm)) filterBits.Add($"Search: “{Model.SearchTerm}”");
    if (Model.TotStatusFilter is { } f) filterBits.Add($"Status: {StatusLabel(f)}");
    if (Model.RequestStateFilter is { } rs) filterBits.Add($"Request: {RequestStateLabel(rs)}");
    if (Model.OnlyPending) filterBits.Add("Pending only");
    if (Model.RequiresTotOnly) filterBits.Add("Requires ToT");
    if (Model.MetCompletedOnly) filterBits.Add("MET completed");
    if (Model.CompletedFrom.HasValue || Model.CompletedTo.HasValue)
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        filterBits.Add((Model.CompletedFrom, Model.CompletedTo) switch
        {
            ({ } cf, { } ct) => $"Completed {cf.ToString("dd MMM", inv)} – {ct.ToString("dd MMM yyyy", inv)}",
            ({ } cf, null) => $"Completed from {cf.ToString("dd MMM yyyy", inv)}",
            (null, { } ct) => $"Completed to {ct.ToString("dd MMM yyyy", inv)}",
            _ => string.Empty
        });
    }
    var completedFromValue = Model.CompletedFrom?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    var completedToValue = Model.CompletedTo?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    var filterSummary = filterBits.Any() ? string.Join(" · ", filterBits) : null;
    string FormatDay(DateOnly? value) => ProjectManagement.Services.Projects.ProjectTotPresentation.FormatDay(value) ?? "—";
}

<div class="tot-shell">
    <nav aria-label="Breadcrumb" class="mb-2">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item">
                <a asp-area="" asp-page="/Dashboard/Index">Dashboard</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                Transfer of Technology
            </li>
        </ol>
    </nav>

    <!-- top toolbar -->
    <div class="tot-toolbar">
        <div class="tot-toolbar-title">
            <h1 class="mb-1">Transfer of Technology</h1>
            <p class="tot-overview__lede mb-0">@Model.Narrative</p>
        </div>
        <div class="tot-toolbar-actions">
            @if (Model.Projects.Any())
            {
                <button type="button"
                        class="btn btn-outline-primary d-flex align-items-center gap-2"
                        data-bs-toggle="modal" data-bs-target="#tot-export-modal">
                    <i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i>
                    <span>Export</span>
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-outline-primary d-flex align-items-center gap-2"
                        disabled>
                    <i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i>
                    <span>Export</span>
                </button>
            }

        </div>
    </div>

    <!-- alerts -->
    @if (TempData["ToastError"] is string err && !string.IsNullOrWhiteSpace(err))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @err
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Toast"] is string ok && !string.IsNullOrWhiteSpace(ok))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @ok
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @{
        var position = Model.Position;
        string Share(int count) => position.NeedTot == 0
            ? "0"
            : (count * 100m / position.NeedTot).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    }
    <section class="tot-overview" aria-labelledby="tot-position-heading">
        <h2 class="visually-hidden" id="tot-position-heading">Position</h2>
        <div class="tot-summary__metrics row g-3">
            <div class="col-6 col-lg">
                <a class="tot-summary__metric-card tot-overview__card" asp-page="./Index" asp-route-RequiresTotOnly="true">
                    <span class="tot-summary__metric-label d-block">Need ToT</span>
                    <span class="tot-summary__metric-value d-block">@position.NeedTot</span>
                    <span class="tot-overview__card-note">completed projects</span>
                </a>
            </div>
            <div class="col-6 col-lg">
                <a class="tot-summary__metric-card tot-summary__metric-card--completed tot-overview__card" asp-page="./Index" asp-route-TotStatusFilter="Completed">
                    <span class="tot-summary__metric-label d-block">ToT completed</span>
                    <span class="tot-summary__metric-value d-block">@position.Completed</span>
                    <span class="tot-overview__card-note">@(position.CompletedPercent is { } pct ? $"{pct}% of {position.NeedTot}" : "—")</span>
                </a>
            </div>
            <div class="col-6 col-lg">
                <a class="tot-summary__metric-card tot-summary__metric-card--inprogress tot-overview__card" asp-page="./Index" asp-route-TotStatusFilter="InProgress">
                    <span class="tot-summary__metric-label d-block">In progress</span>
                    <span class="tot-summary__metric-value d-block">@position.InProgress</span>
                </a>
            </div>
            <div class="col-6 col-lg">
                <a class="tot-summary__metric-card tot-summary__metric-card--notstarted tot-overview__card" asp-page="./Index" asp-route-TotStatusFilter="NotStarted">
                    <span class="tot-summary__metric-label d-block">Not started</span>
                    <span class="tot-summary__metric-value d-block">@position.NotStarted</span>
                    @if (position.LongWaiting > 0)
                    {
                        <span class="tot-overview__card-note">@position.LongWaiting over five years</span>
                    }
                </a>
            </div>
            @if (position.NotKnown > 0)
            {
                <div class="col-6 col-lg">
                    <a class="tot-summary__metric-card tot-overview__card" asp-page="./Index" asp-route-TotStatusFilter="NotKnown">
                        <span class="tot-summary__metric-label d-block">Not known</span>
                        <span class="tot-summary__metric-value d-block">@position.NotKnown</span>
                    </a>
                </div>
            }
        </div>

        @if (position.NeedTot > 0)
        {
            <div class="tot-overview__bar" role="img"
                 aria-label="@($"{position.Completed} completed, {position.InProgress} in progress, {position.NotStarted} not started, {position.NotKnown} not known")">
                <span class="tot-overview__bar-part tot-overview__bar-part--completed" style="width: @Share(position.Completed)%"></span>
                <span class="tot-overview__bar-part tot-overview__bar-part--inprogress" style="width: @Share(position.InProgress)%"></span>
                <span class="tot-overview__bar-part tot-overview__bar-part--notstarted" style="width: @Share(position.NotStarted)%"></span>
                <span class="tot-overview__bar-part tot-overview__bar-part--notknown" style="width: @Share(position.NotKnown)%"></span>
            </div>
        }
        @if (position.NotRequired > 0)
        {
            <p class="tot-overview__note">
                @position.NotRequired @(position.NotRequired == 1 ? "project does" : "projects do") not require ToT and @(position.NotRequired == 1 ? "is" : "are") not counted.
                <a asp-page="./Index" asp-route-TotStatusFilter="NotRequired">Show @(position.NotRequired == 1 ? "it" : "them")</a>
            </p>
        }

        <div class="tot-summary__chart card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h2 class="tot-summary__chart-title mb-1">ToT completed per year</h2>
                        <p class="tot-summary__chart-caption mb-0">How many projects completed ToT in each year.</p>
                    </div>
                    <button type="button"
                            id="tot-chart-download"
                            class="btn btn-light btn-sm tot-summary__chart-btn"
                            title="Download chart"
                            aria-label="Download chart as PNG">
                        <i class="bi bi-download" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="tot-summary__chart-host" id="tot-yearly-chart-host">
                    <canvas id="tot-yearly-chart" aria-label="ToT completed per year" role="img"></canvas>
                </div>
                <p class="tot-summary__chart-message text-muted mb-0" id="tot-yearly-chart-message" role="status" hidden></p>
            </div>
        </div>
    </section>

    <h2 class="tot-register__heading" id="tot-register-heading">Register</h2>

    <!-- context bar -->
    <div class="tot-context-bar" aria-label="Current ToT view summary">
        <div class="tot-context-left">
            <span class="tot-pill"><strong>@resultCountText</strong></span>
            @if (filterSummary is not null)
            {
                <span class="tot-pill tot-pill-muted">@filterSummary</span>
            }
        </div>
        @if (summary.PendingApprovals > 0)
        {
            <a class="tot-pill" asp-page="./Index" asp-route-OnlyPending="true">
                Waiting for approval: <strong>@summary.PendingApprovals</strong>
            </a>
        }
    </div>

    <!-- main workspace -->
    <div class="tot-workspace-grid tot-workspace-grid--single">
        <!-- left: list -->
        <div class="tot-list-panel" aria-label="Register">
                <form method="get" class="tot-searchbar" role="search">
                    <input type="hidden" name="TotStatusFilter" value="@Model.TotStatusFilter" />
                    <input type="hidden" name="RequestStateFilter" value="@Model.RequestStateFilter" />
                    <input type="hidden" name="OnlyPending" value="@Model.OnlyPending" />
                    <input type="hidden" name="RequiresTotOnly" value="@Model.RequiresTotOnly" />
                    <input type="hidden" name="MetCompletedOnly" value="@Model.MetCompletedOnly" />
                    <input type="hidden" name="CompletedFrom" value="@completedFromValue" />
                    <input type="hidden" name="CompletedTo" value="@completedToValue" />
                    <input type="hidden" name="SelectedProjectId" value="@Model.SelectedProjectId" />

                    <div class="input-group input-group-sm pm-util-maxw-320">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search" aria-hidden="true"></i>
                        </span>
                        <input name="SearchTerm"
                               value="@Model.SearchTerm"
                               class="form-control border-start-0"
                               type="search"
                               placeholder="Search projects, units…" />
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary">Search</button>
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            data-bs-toggle="modal"
                            data-bs-target="#tot-filter-modal">
                        Filters
                    </button>
                </form>

            @if (!Model.Projects.Any())
            {
                <div class="p-4 text-center text-muted">No projects match the current search and filters.</div>
            }
            else
            {
                <div class="tot-list-body">
                    <div class="tot-list-head">
                        <div>Project</div>
                        <div>ToT status</div>
                        <div>Started</div>
                        <div>Completed</div>
                        <div>MET</div>
                        <div>Request</div>
                    </div>

                    @foreach (var row in Model.Projects)
                    {
                        var isSelected = Model.SelectedProjectId.HasValue && Model.SelectedProjectId.Value == row.ProjectId;
                        <a class="tot-row @(isSelected ? "is-selected" : "")"
                           data-tot-open-project-id="@row.ProjectId"
                           data-tot-project-name="@row.ProjectName"
                           asp-page="./Index"
                           asp-route-TotStatusFilter="@Model.TotStatusFilter"
                           asp-route-RequestStateFilter="@Model.RequestStateFilter"
                           asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-OnlyPending="@Model.OnlyPending"
                           asp-route-RequiresTotOnly="@Model.RequiresTotOnly"
                           asp-route-MetCompletedOnly="@Model.MetCompletedOnly"
                           asp-route-CompletedFrom="@completedFromValue"
                           asp-route-CompletedTo="@completedToValue"
                           asp-route-SelectedProjectId="@row.ProjectId">
                            <div>
                                <div class="tot-row-title">@row.ProjectName</div>
                                @if (!string.IsNullOrWhiteSpace(row.SponsoringUnit))
                                {
                                    <div class="tot-row-sub">@row.SponsoringUnit</div>
                                }
                            </div>
                            <div>
                                <span class="chip-sm @TotStatusChipClass(row.TotStatus ?? ProjectTotStatus.NotStarted)">
                                    @StatusLabel(row.TotStatus ?? ProjectTotStatus.NotStarted)
                                </span>
                            </div>
                            <div>
                                @(PartialDateDisplay.Format(row.TotStartedOn, row.TotStartDatePrecision) ?? "—")
                            </div>
                            <div>
                                @(PartialDateDisplay.Format(row.TotCompletedOn, row.TotCompletionDatePrecision) ?? "—")
                            </div>
                            <div>
                                @FormatDay(row.TotMetCompletedOn)
                            </div>
                            <div>
                                @if (row.RequestState is { } rstate)
                                {
                                    <span class="chip-sm @RequestStateChipClass(rstate)">
                                        @RequestStateLabel(rstate)
                                    </span>
                                    @* extra visibility for approvers *@
                                    @if (Model.CanApprove && rstate == ProjectTotRequestDecisionState.Pending)
                                    {
                                        <span class="tot-row-sub d-block">Needs your decision</span>
                                    }
                                }
                            </div>
                        </a>
                    }
                </div>
            }
        </div>

    </div>
</div>

<!-- filter modal -->
<partial name="_TotFiltersModal" model="Model" />

<!-- export modal -->
<div class="modal fade" id="tot-export-modal" tabindex="-1" aria-labelledby="tot-export-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Export">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="tot-export-modal-label">Export ToT data</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-3">The current filters will be sent along, so export matches what you see.</p>
                    <input type="hidden" asp-for="SelectedProjectId" />
                    <input type="hidden" asp-for="TotStatusFilter" />
                    <input type="hidden" asp-for="RequestStateFilter" />
                    <input type="hidden" asp-for="SearchTerm" />
                    <input type="hidden" asp-for="OnlyPending" />
                    <input type="hidden" asp-for="RequiresTotOnly" />
                    <input type="hidden" asp-for="MetCompletedOnly" />
                    @* The export reads its own window (Export.*), prefilled from the page's in OnGet. *@
                    <input type="hidden" name="CompletedFrom" value="@completedFromValue" />
                    <input type="hidden" name="CompletedTo" value="@completedToValue" />
                    <input type="hidden" name="Export.CompletedFrom" value="@completedFromValue" />
                    <input type="hidden" name="Export.CompletedTo" value="@completedToValue" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i>
                        <span>Export workbook</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- the shared ToT drawer: rows open it in place -->
<div class="offcanvas offcanvas-end project-tot-offcanvas"
     tabindex="-1"
     id="offcanvasTot"
     aria-labelledby="offcanvasTotLabel"
     data-bs-backdrop="static"
     data-bs-keyboard="false"
     data-project-id="@Model.TotDrawerView.ProjectId"
     data-tot-endpoint="@Model.TotDrawerView.Endpoint"
     data-tot-open-on-load="@(Model.SelectedProjectId.HasValue ? "true" : "false")">
    <div class="offcanvas-header">
        <div>
            <h2 id="offcanvasTotLabel" class="h5 mb-0">Transfer of Technology</h2>
            <p class="text-muted small mb-0 mt-1" data-tot-project-name>@Model.Projects.FirstOrDefault(p => p.ProjectId == Model.SelectedProjectId)?.ProjectName</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0">
        <partial name="~/Pages/Projects/_ProjectTotDrawer.cshtml" model="Model.TotDrawerView" />
    </div>
</div>

@section Scripts
{
    <script type="module" src="~/js/pages/project-office-reports/tot.js" asp-append-version="true"></script>
    <script src="~/js/projects/overview-tot.js" asp-append-version="true"></script>
    <script src="~/lib/chart.js/chart.umd.js"></script>
    <script type="module" src="~/js/pages/project-office-reports/tot-chart.js" asp-append-version="true"></script>
}
