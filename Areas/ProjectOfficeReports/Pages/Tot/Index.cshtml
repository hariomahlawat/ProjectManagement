@page
@model ProjectManagement.Areas.ProjectOfficeReports.Pages.Tot.IndexModel
@using ProjectManagement.Areas.ProjectOfficeReports.Application

@using System.Globalization
@using ProjectManagement.Utilities.PartialDates
@using ProjectManagement.Models

@section Styles
{
    <link rel="stylesheet" href="~/css/tot.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/project-tot-drawer.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Transfer of Technology";

    var completedFromValue = Model.CompletedFrom?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    var completedToValue = Model.CompletedTo?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
}

<div class="tot-shell">
    <nav aria-label="Breadcrumb" class="mb-2">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item">
                <a asp-area="" asp-page="/Dashboard/Index">Dashboard</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                Transfer of Technology
            </li>
        </ol>
    </nav>

    <!-- top toolbar -->
    <div class="tot-toolbar">
        <div class="tot-toolbar-title">
            <h1 class="mb-1">Transfer of Technology</h1>
            <p class="tot-overview__lede mb-0">@Model.Narrative</p>
        </div>
        <div class="tot-toolbar-actions">
            @* Disabled when nothing matches; the live search turns it back on (tot-register.js). *@
            <button type="button"
                    class="btn btn-outline-primary d-flex align-items-center gap-2"
                    data-bs-toggle="modal" data-bs-target="#tot-export-modal" data-tot-export-button
                    disabled="@(Model.Projects.Any() ? null : "disabled")">
                <i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i>
                <span>Export</span>
            </button>

        </div>
    </div>

    <!-- alerts -->
    @if (TempData["ToastError"] is string err && !string.IsNullOrWhiteSpace(err))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @err
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Toast"] is string ok && !string.IsNullOrWhiteSpace(ok))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @ok
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @{
        var position = Model.Position;
        string Share(int count) => position.NeedTot == 0
            ? "0"
            : (count * 100m / position.NeedTot).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    }
    <section class="tot-overview" aria-labelledby="tot-position-heading">
        <h2 class="visually-hidden" id="tot-position-heading">Position</h2>
        <div class="tot-summary__metrics row g-3">
            <div class="col-6 col-lg">
                <a class="tot-summary__metric-card tot-overview__card" asp-page="./Index" asp-route-RequiresTotOnly="true">
                    <span class="tot-summary__metric-label d-block">Need ToT</span>
                    <span class="tot-summary__metric-value d-block">@position.NeedTot</span>
                    <span class="tot-overview__card-note">completed projects</span>
                </a>
            </div>
            <div class="col-6 col-lg">
                <a class="tot-summary__metric-card tot-summary__metric-card--completed tot-overview__card" asp-page="./Index" asp-route-TotStatusFilter="Completed">
                    <span class="tot-summary__metric-label d-block">ToT completed</span>
                    <span class="tot-summary__metric-value d-block">@position.Completed</span>
                    <span class="tot-overview__card-note">@(position.CompletedPercent is { } pct ? $"{pct}% of {position.NeedTot}" : "—")</span>
                </a>
            </div>
            <div class="col-6 col-lg">
                <a class="tot-summary__metric-card tot-summary__metric-card--inprogress tot-overview__card" asp-page="./Index" asp-route-TotStatusFilter="InProgress">
                    <span class="tot-summary__metric-label d-block">In progress</span>
                    <span class="tot-summary__metric-value d-block">@position.InProgress</span>
                </a>
            </div>
            <div class="col-6 col-lg">
                <a class="tot-summary__metric-card tot-summary__metric-card--notstarted tot-overview__card" asp-page="./Index" asp-route-TotStatusFilter="NotStarted">
                    <span class="tot-summary__metric-label d-block">Not started</span>
                    <span class="tot-summary__metric-value d-block">@position.NotStarted</span>
                    @if (position.LongWaiting > 0)
                    {
                        <span class="tot-overview__card-note">@position.LongWaiting over five years</span>
                    }
                </a>
            </div>
            @if (position.NotKnown > 0)
            {
                <div class="col-6 col-lg">
                    <a class="tot-summary__metric-card tot-overview__card" asp-page="./Index" asp-route-TotStatusFilter="NotKnown">
                        <span class="tot-summary__metric-label d-block">Not known</span>
                        <span class="tot-summary__metric-value d-block">@position.NotKnown</span>
                    </a>
                </div>
            }
        </div>

        @if (position.NeedTot > 0)
        {
            <div class="tot-overview__bar" role="img"
                 aria-label="@($"{position.Completed} completed, {position.InProgress} in progress, {position.NotStarted} not started, {position.NotKnown} not known")">
                <span class="tot-overview__bar-part tot-overview__bar-part--completed" style="width: @Share(position.Completed)%"></span>
                <span class="tot-overview__bar-part tot-overview__bar-part--inprogress" style="width: @Share(position.InProgress)%"></span>
                <span class="tot-overview__bar-part tot-overview__bar-part--notstarted" style="width: @Share(position.NotStarted)%"></span>
                <span class="tot-overview__bar-part tot-overview__bar-part--notknown" style="width: @Share(position.NotKnown)%"></span>
            </div>
        }
        @if (position.NotRequired > 0)
        {
            <p class="tot-overview__note">
                @position.NotRequired @(position.NotRequired == 1 ? "project does" : "projects do") not require ToT and @(position.NotRequired == 1 ? "is" : "are") not counted.
                <a asp-page="./Index" asp-route-TotStatusFilter="NotRequired">Show @(position.NotRequired == 1 ? "it" : "them")</a>
            </p>
        }

        @{
            var role = Model.RoleView;
            var istLabel = (DateTime? utc) => ProjectManagement.Services.Projects.ProjectTotPresentation.FormatMoment(utc);
        }
        <div class="tot-attention" aria-labelledby="tot-attention-heading">
            <h2 class="tot-register__heading" id="tot-attention-heading">
                @(role switch
                {
                    ProjectManagement.Areas.ProjectOfficeReports.Pages.Tot.IndexModel.TotRoleView.Approver => "Needs attention",
                    ProjectManagement.Areas.ProjectOfficeReports.Pages.Tot.IndexModel.TotRoleView.Maintainer => "To keep the register right",
                    _ => "At a glance"
                })
            </h2>
            <div class="tot-attention__grid">
                @if (role == ProjectManagement.Areas.ProjectOfficeReports.Pages.Tot.IndexModel.TotRoleView.Approver)
                {
                    <section class="tot-attention__card tot-attention__card--decide" aria-labelledby="tot-attention-decide">
                        <div class="tot-attention__head">
                            <h3 id="tot-attention-decide">Waiting for your decision</h3>
                            <span class="tot-attention__count">@Model.WaitingForDecision.Count</span>
                        </div>
                        @if (Model.WaitingForDecision.Count == 0)
                        {
                            <p class="tot-attention__empty">Nothing is waiting for you.</p>
                        }
                        else
                        {
                            <ul class="tot-attention__list">
                                @foreach (var item in Model.WaitingForDecision)
                                {
                                    <li>
                                        <a class="tot-attention__item" asp-page="./Index" asp-route-SelectedProjectId="@item.ProjectId"
                                           data-tot-open-project-id="@item.ProjectId" data-tot-project-name="@item.ProjectName">
                                            <span class="tot-attention__name">@item.ProjectName</span>
                                            <span class="tot-attention__change">@ProjectTotOverview.ChangeSummary(item.Pending!)</span>
                                            <span class="tot-attention__meta">@item.Pending!.SubmittedBy · @istLabel(item.Pending!.SubmittedOnUtc)</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                }
                @if (role == ProjectManagement.Areas.ProjectOfficeReports.Pages.Tot.IndexModel.TotRoleView.Viewer)
                {
                    <section class="tot-attention__card" aria-labelledby="tot-attention-recent">
                        <div class="tot-attention__head">
                            <h3 id="tot-attention-recent">Recently completed</h3>
                        </div>
                        @if (Model.RecentlyCompleted.Count == 0)
                        {
                            <p class="tot-attention__empty">No ToT completions recorded yet.</p>
                        }
                        else
                        {
                            <ul class="tot-attention__list">
                                @foreach (var item in Model.RecentlyCompleted)
                                {
                                    <li>
                                        <a class="tot-attention__item tot-attention__item--row" asp-page="./Index" asp-route-SelectedProjectId="@item.ProjectId"
                                           data-tot-open-project-id="@item.ProjectId" data-tot-project-name="@item.ProjectName">
                                            <span class="tot-attention__name">@item.ProjectName</span>
                                            <span class="tot-attention__meta">@item.Completed</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                }

                <section class="tot-attention__card tot-attention__card--waiting" aria-labelledby="tot-attention-long">
                    <div class="tot-attention__head">
                        <h3 id="tot-attention-long">Not started, over five years</h3>
                        <span class="tot-attention__count">@Model.LongWaitingCount</span>
                    </div>
                    @if (role == ProjectManagement.Areas.ProjectOfficeReports.Pages.Tot.IndexModel.TotRoleView.Maintainer)
                    {
                        <p class="tot-attention__hint">Record a start, or propose Not required or Not known. Each goes to the HoD.</p>
                    }
                    else if (role == ProjectManagement.Areas.ProjectOfficeReports.Pages.Tot.IndexModel.TotRoleView.Approver)
                    {
                        <p class="tot-attention__hint">Still expected, Not required, or Not known? Project Office proposes; you approve, or update it yourself.</p>
                    }
                    @if (Model.LongWaitingCount == 0)
                    {
                        <p class="tot-attention__empty">None. Every project completed over five years ago has a ToT position.</p>
                    }
                    else
                    {
                        <ul class="tot-attention__list">
                            @foreach (var item in Model.LongWaitingProjects)
                            {
                                <li>
                                    <a class="tot-attention__item tot-attention__item--row" asp-page="./Index" asp-route-SelectedProjectId="@item.ProjectId"
                                       data-tot-open-project-id="@item.ProjectId" data-tot-project-name="@item.ProjectName">
                                        <span class="tot-attention__name">@item.ProjectName</span>
                                        <span class="tot-attention__meta">completed @item.ProjectCompletedYear</span>
                                    </a>
                                </li>
                            }
                        </ul>
                        @if (Model.LongWaitingCount > Model.LongWaitingProjects.Count)
                        {
                            <a class="tot-attention__more" asp-page="./Index" asp-route-LongWaiting="true">See all @Model.LongWaitingCount</a>
                        }
                    }
                </section>

                @if (role == ProjectManagement.Areas.ProjectOfficeReports.Pages.Tot.IndexModel.TotRoleView.Maintainer)
                {
                    <section class="tot-attention__card tot-attention__card--decide" aria-labelledby="tot-attention-sent">
                        <div class="tot-attention__head">
                            <h3 id="tot-attention-sent">Waiting for the HoD</h3>
                            <span class="tot-attention__count">@Model.WaitingForDecision.Count</span>
                        </div>
                        @if (Model.WaitingForDecision.Count == 0)
                        {
                            <p class="tot-attention__empty">No update is waiting for approval.</p>
                        }
                        else
                        {
                            <ul class="tot-attention__list">
                                @foreach (var item in Model.WaitingForDecision)
                                {
                                    <li>
                                        <a class="tot-attention__item" asp-page="./Index" asp-route-SelectedProjectId="@item.ProjectId"
                                           data-tot-open-project-id="@item.ProjectId" data-tot-project-name="@item.ProjectName">
                                            <span class="tot-attention__name">@item.ProjectName</span>
                                            <span class="tot-attention__change">Proposed: @ProjectTotOverview.ChangeSummary(item.Pending!)</span>
                                            <span class="tot-attention__meta">@item.Pending!.SubmittedBy · since @istLabel(item.Pending!.SubmittedOnUtc)</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                            <p class="tot-attention__hint mb-0">Sent by mistake? The HoD can reject it with a reason.</p>
                        }
                    </section>
                }
            </div>
        </div>

        <div class="tot-summary__chart card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h2 class="tot-summary__chart-title mb-1">ToT completed per year</h2>
                        <p class="tot-summary__chart-caption mb-0">How many projects completed ToT in each year.</p>
                    </div>
                    <button type="button"
                            id="tot-chart-download"
                            class="btn btn-light btn-sm tot-summary__chart-btn"
                            title="Download chart"
                            aria-label="Download chart as PNG">
                        <i class="bi bi-download" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="tot-summary__chart-host" id="tot-yearly-chart-host">
                    <canvas id="tot-yearly-chart" aria-label="ToT completed per year" role="img"></canvas>
                </div>
                <p class="tot-summary__chart-message text-muted mb-0" id="tot-yearly-chart-message" role="status" hidden></p>
            </div>
        </div>
    </section>

    <section class="tot-register-section" aria-labelledby="tot-register-heading">
        <div class="tot-register__bar">
            <h2 class="tot-register__heading mb-0" id="tot-register-heading">Register</h2>
            <form method="get" class="tot-register__search" role="search" data-tot-search>
                @* Only the filters in use, so no empty value is ever sent for a yes/no filter. *@
                @foreach (var (name, value) in Model.RegisterRouteWith((nameof(Model.SearchTerm), null)))
                {
                    <input type="hidden" name="@name" value="@value" />
                }
                <label class="visually-hidden" for="tot-register-search">Search projects or units</label>
                <input id="tot-register-search"
                       name="SearchTerm"
                       value="@Model.SearchTerm"
                       class="form-control"
                       type="search"
                       autocomplete="off"
                       placeholder="Search projects or units"
                       data-tot-live-search />
                <button type="submit" class="btn btn-outline-secondary">Search</button>
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-toggle="modal"
                        data-bs-target="#tot-filter-modal">
                    More filters
                </button>
            </form>
        </div>
        <partial name="_TotRegister" model="Model" />
    </section>
</div>

<!-- filter modal -->
<partial name="_TotFiltersModal" model="Model" />

<!-- export modal -->
<div class="modal fade" id="tot-export-modal" tabindex="-1" aria-labelledby="tot-export-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Export" data-tot-carries-search>
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="tot-export-modal-label">Export ToT data</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-3">The current filters will be sent along, so export matches what you see.</p>
                    <input type="hidden" asp-for="SelectedProjectId" />
                    <input type="hidden" asp-for="TotStatusFilter" />
                    <input type="hidden" asp-for="RequestStateFilter" />
                    <input type="hidden" asp-for="SearchTerm" />
                    <input type="hidden" asp-for="OnlyPending" />
                    <input type="hidden" asp-for="RequiresTotOnly" />
                    <input type="hidden" asp-for="MetCompletedOnly" />
                    <input type="hidden" asp-for="LongWaiting" />
                    @* The export reads its own window (Export.*), prefilled from the page's in OnGet. *@
                    <input type="hidden" name="CompletedFrom" value="@completedFromValue" />
                    <input type="hidden" name="CompletedTo" value="@completedToValue" />
                    <input type="hidden" name="Export.CompletedFrom" value="@completedFromValue" />
                    <input type="hidden" name="Export.CompletedTo" value="@completedToValue" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i>
                        <span>Export workbook</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- the shared ToT drawer: rows open it in place -->
<div class="offcanvas offcanvas-end project-tot-offcanvas"
     tabindex="-1"
     id="offcanvasTot"
     aria-labelledby="offcanvasTotLabel"
     data-bs-backdrop="static"
     data-bs-keyboard="false"
     data-project-id="@Model.TotDrawerView.ProjectId"
     data-tot-endpoint="@Model.TotDrawerView.Endpoint"
     data-tot-open-on-load="@(Model.SelectedProjectId.HasValue ? "true" : "false")">
    <div class="offcanvas-header">
        <div>
            <h2 id="offcanvasTotLabel" class="h5 mb-0">Transfer of Technology</h2>
            <p class="text-muted small mb-0 mt-1" data-tot-project-name>@Model.Projects.FirstOrDefault(p => p.ProjectId == Model.SelectedProjectId)?.ProjectName</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0">
        <partial name="~/Pages/Projects/_ProjectTotDrawer.cshtml" model="Model.TotDrawerView" />
    </div>
</div>

@section Scripts
{
    <script type="module" src="~/js/pages/project-office-reports/tot.js" asp-append-version="true"></script>
    <script src="~/js/projects/overview-tot.js" asp-append-version="true"></script>
    <script src="~/js/pages/project-office-reports/tot-register.js" asp-append-version="true"></script>
    <script src="~/lib/chart.js/chart.umd.js"></script>
    <script type="module" src="~/js/pages/project-office-reports/tot-chart.js" asp-append-version="true"></script>
}
