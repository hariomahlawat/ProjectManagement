@page
@using System.Globalization
@using ProjectManagement.Areas.ProjectOfficeReports.Pages.Training
@using ProjectManagement.Areas.ProjectOfficeReports.Application
@using TrainingIndex = ProjectManagement.Areas.ProjectOfficeReports.Pages.Training.IndexModel
@model ProjectManagement.Areas.ProjectOfficeReports.Pages.Training.IndexModel
@{
    ViewData["Title"] = "Training tracker";
    ViewData["UseFullWidth"] = false;
    var showExportModal = ViewData["ShowTrainingExportModal"] as bool? ?? false;
    var selectedExportProjectName = Model.Export.ProjectId.HasValue
        ? Model.ProjectOptions.FirstOrDefault(option => option.Value == Model.Export.ProjectId.Value.ToString(CultureInfo.InvariantCulture))?.Text ?? string.Empty
        : string.Empty;

    var inv = CultureInfo.InvariantCulture;
    string N(int value) => value.ToString("N0", CultureInfo.CurrentCulture);
    string Plural(int count, string one, string many) => count == 1 ? one : many;

    var fromValue = Model.Filter.From?.ToString("yyyy-MM-dd", inv) ?? string.Empty;
    var toValue = Model.Filter.To?.ToString("yyyy-MM-dd", inv) ?? string.Empty;

    // Filters beyond search and type stay folded until one of them is set. A technical
    // category chosen from the cards does not unfold them: the card and its chip show it.
    var hasMoreFilters = Model.Filter.Category.HasValue
        || Model.Filter.From.HasValue
        || Model.Filter.To.HasValue;
    var moreFilterCount = (Model.Filter.ProjectTechnicalCategoryId.HasValue ? 1 : 0)
        + (Model.Filter.Category.HasValue ? 1 : 0)
        + (Model.Filter.From.HasValue || Model.Filter.To.HasValue ? 1 : 0);

    // Simulator / Drone headline figures by type name (see docs/ux/training.md)
    var sim = Model.Kpis.ByType.FirstOrDefault(x => x.TypeName.Equals("Simulator", StringComparison.OrdinalIgnoreCase));
    var drone = Model.Kpis.ByType.FirstOrDefault(x => x.TypeName.Equals("Drone", StringComparison.OrdinalIgnoreCase));
    var columnCount = Model.CanManageTrainingTracker ? 5 : 4;
    const string splitPartial = "~/Areas/ProjectOfficeReports/Pages/Training/_StrengthSplit.cshtml";
    var scope = Model.HasFilters
        ? $"{N(Model.TotalItems)} {Plural(Model.TotalItems, "training", "trainings")} match your filters"
        : $"All {N(Model.TotalItems)} {Plural(Model.TotalItems, "training", "trainings")} on record";
}

<div class="training-register">
    @* SECTION: Page header — one row: title and scope, then the actions *@
    <header class="training-register__head">
        <div class="training-register__title">
            <h1>Training tracker</h1>
            @if (Model.IsFeatureEnabled)
            {
                <p>@scope</p>
            }
        </div>
        <div class="training-register__actions">
            @if (Model.CanApproveTrainingTracker)
            {
                <a asp-page="./Approvals" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <span>Approvals</span>
                    @await Component.InvokeAsync("TrainingApprovalsBadge")
                </a>
            }
            @if (Model.IsFeatureEnabled)
            {
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        data-bs-toggle="modal"
                        data-bs-target="#trainingExportModal">
                    <i class="bi bi-download" aria-hidden="true"></i>
                    <span>Export</span>
                </button>
            }
            @if (Model.CanManageTrainingTracker)
            {
                <a asp-page="./Manage" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    <span>New training</span>
                </a>
            }
        </div>
    </header>

@if (!Model.IsFeatureEnabled)
{
    <div class="alert alert-warning" role="alert">
        The training tracker is currently disabled. Please check back after the feature is enabled.
    </div>
}
else
{
    @* SECTION: Headline figures (follow the filters) *@
    <section class="training-register__figures" aria-label="Headline figures">
        <div class="row g-3">
            <div class="col-6 col-lg-3">
                <div class="card kpi-card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="kpi-label">Trainings</div>
                        <div class="kpi-value">@N(Model.Kpis.TotalTrainings)</div>
                        <ul class="training-split__legend">
                            <li><span class="training-type-dot training-type--simulator"></span><strong>@N(sim?.Trainings ?? 0)</strong> Simulator</li>
                            <li><span class="training-type-dot training-type--drone"></span><strong>@N(drone?.Trainings ?? 0)</strong> Drone</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card kpi-card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="kpi-label">Trainees</div>
                        <div class="kpi-value">@N(Model.Kpis.TotalTrainees)</div>
                        <partial name="@splitPartial" model="new ProjectManagement.Areas.ProjectOfficeReports.Pages.Training.IndexModel.StrengthBreakdown(Model.TotalOfficers, Model.TotalJcos, Model.TotalOrs)" />
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card kpi-card training-type--simulator shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="kpi-label"><span class="training-type-dot"></span>Simulator trainees</div>
                        <div class="kpi-value">@N(sim?.Trainees ?? 0)</div>
                        <partial name="@splitPartial" model="Model.SimulatorStrength" />
                        <div class="kpi-meta">@N(sim?.Trainings ?? 0) @Plural(sim?.Trainings ?? 0, "training", "trainings")</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card kpi-card training-type--drone shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="kpi-label"><span class="training-type-dot"></span>Drone trainees</div>
                        <div class="kpi-value">@N(drone?.Trainees ?? 0)</div>
                        <partial name="@splitPartial" model="Model.DroneStrength" />
                        <div class="kpi-meta">@N(drone?.Trainings ?? 0) @Plural(drone?.Trainings ?? 0, "training", "trainings")</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* SECTION: Technical categories and the yearly trend (follow the filters) *@
    @if (Model.TechnicalCategoryCards.Count > 0 || Model.TrainingYearChart.Count > 0)
    {
        <section class="training-insights" aria-label="Technical categories and trend">
            @if (Model.TechnicalCategoryCards.Count > 0)
            {
                var selectedCategoryId = Model.Filter.ProjectTechnicalCategoryId;
                <div class="training-insights__categories">
                    <div class="training-section-title">
                        <h2>By technical category</h2>
                        <p>Choose a category to see its projects and filter the register.</p>
                    </div>
                    <div class="training-category-grid">
                        @foreach (var cat in Model.TechnicalCategoryCards)
                        {
                            var isSelected = selectedCategoryId == cat.TechnicalCategoryId;
                            var categoryRouteValues = Model.RouteWith(overrides: new Dictionary<string, string?>
                            {
                                ["ProjectTechnicalCategoryId"] = isSelected ? null : cat.TechnicalCategoryId.ToString(inv),
                                ["ProjectId"] = null
                            });
                            <a asp-page="./Index"
                               asp-all-route-data="categoryRouteValues"
                               class="training-category-card@(isSelected ? " is-selected" : string.Empty)"
                               aria-current="@(isSelected ? "true" : null)"
                               title="@(isSelected ? $"Showing {cat.TechnicalCategoryName}. Choose again to show all categories." : $"Show {cat.TechnicalCategoryName}")">
                                <span class="training-category-card__name">@cat.TechnicalCategoryName</span>
                                <span class="training-category-card__figures">
                                    <strong>@N(cat.Trainees)</strong>
                                    <span>@Plural(cat.Trainees, "trainee", "trainees") · @N(cat.Trainings) @Plural(cat.Trainings, "training", "trainings")</span>
                                </span>
                                <partial name="@splitPartial"
                                         model="new ProjectManagement.Areas.ProjectOfficeReports.Pages.Training.IndexModel.StrengthBreakdown(cat.Officers, cat.Jcos, cat.Ors)"
                                         view-data='new ViewDataDictionary(ViewData) { ["Compact"] = true }' />
                            </a>
                        }
                    </div>
                </div>
            }

            @if (Model.TrainingYearChart.Count > 0)
            {
                <div class="training-insights__trend">
                    <div class="card training-chart-card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h2 class="h6 mb-1" id="training-year-trend-title">Trainees by training year</h2>
                                    <p class="text-muted small mb-0">Simulator and Drone, April to March</p>
                                </div>
                                <button type="button"
                                        class="btn btn-light btn-sm"
                                        data-action="download-png"
                                        data-target="training-year-trend-canvas"
                                        aria-label="Download chart as PNG"
                                        title="Download chart as PNG">
                                    <i class="bi bi-download" aria-hidden="true"></i>
                                </button>
                            </div>

                            <div class="training-chart-frame"
                                 data-training-year='@System.Text.Json.JsonSerializer.Serialize(
                                                          Model.TrainingYearChart,
                                                          new System.Text.Json.JsonSerializerOptions
                                                          {
                                                              PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
                                                          })'>
                                <canvas id="training-year-trend-canvas" role="img" aria-labelledby="training-year-trend-title"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </section>
    }

    @* SECTION: Projects in the chosen technical category — full width, full names *@
    @if (Model.Filter.ProjectTechnicalCategoryId.HasValue)
    {
        const int projectPreviewCount = 10;
        var previewProjects = Model.ProjectBreakdown.Take(projectPreviewCount).ToList();
        var moreProjects = Model.ProjectBreakdown.Skip(projectPreviewCount).ToList();
        var selectedIsHidden = moreProjects.Any(project => project.ProjectId == Model.Filter.ProjectId);

        async Task ProjectItem(ProjectManagement.Areas.ProjectOfficeReports.Application.Training.Dtos.TechnicalCategoryProjectBreakdownDto project)
        {
            var isProject = Model.Filter.ProjectId == project.ProjectId;
            var projectRouteValues = Model.RouteWith(overrides: new Dictionary<string, string?>
            {
                ["ProjectId"] = isProject ? null : project.ProjectId.ToString(inv)
            });
            <li class="@(isProject ? "is-selected" : null)">
                <a asp-page="./Index" asp-all-route-data="projectRouteValues" class="training-category-projects__filter" aria-current="@(isProject ? "true" : null)" title="@(isProject ? "Showing this project's trainings. Choose again to show the whole category." : "Show this project's trainings")">
                    <span class="training-category-projects__name">@project.ProjectName</span>
                    <span class="training-category-projects__count">@N(project.TrainingSessions) @Plural(project.TrainingSessions, "session", "sessions")</span>
                </a>
                <a asp-area="" asp-page="/Projects/Overview" asp-route-id="@project.ProjectId" class="training-category-projects__open" aria-label="Open project @project.ProjectName" title="Open project">
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                </a>
            </li>
        }

        <section class="training-category-projects" aria-labelledby="training-category-projects-heading">
            <div class="training-category-projects__head">
                <h2 id="training-category-projects-heading">Projects in @(Model.SelectedTechnicalCategoryLabel ?? "this category")</h2>
                <p>@N(Model.ProjectBreakdown.Count) @Plural(Model.ProjectBreakdown.Count, "project", "projects"), most sessions first. Choose one to filter the register. A session linked to more than one project counts under each.</p>
            </div>
            @if (Model.ProjectBreakdown.Count == 0)
            {
                <p class="training-category-projects__empty">No projects found for the current filters.</p>
            }
            else
            {
                <ul class="training-category-projects__list">
                    @foreach (var project in previewProjects)
                    {
                        await ProjectItem(project);
                    }
                </ul>
                @if (moreProjects.Count > 0)
                {
                    <details class="training-category-projects__more" open="@selectedIsHidden">
                        <summary>
                            <span class="training-category-projects__show">Show all @N(Model.ProjectBreakdown.Count) projects</span>
                            <span class="training-category-projects__hide">Show fewer</span>
                        </summary>
                        <ul class="training-category-projects__list">
                            @foreach (var project in moreProjects)
                            {
                                await ProjectItem(project);
                            }
                        </ul>
                    </details>
                }
            }
        </section>
    }

    @* SECTION: Register, with its filter bar *@
    <section class="training-register__list" aria-labelledby="training-register-heading">
        <div class="training-toolbar">
            <h2 id="training-register-heading" class="training-toolbar__count">
                @if (Model.TotalItems == 0)
                {
                    <span>No trainings</span>
                }
                else
                {
                    <span>@N(Model.TotalItems) @Plural(Model.TotalItems, "training", "trainings")</span>
                    <span class="training-toolbar__meta">@N(Model.Kpis.TotalTrainees) @Plural(Model.Kpis.TotalTrainees, "trainee", "trainees")@(Model.TotalPages > 1 ? $" · showing {N(Model.ShowingFrom)}–{N(Model.ShowingTo)}" : string.Empty)</span>
                }
            </h2>
        </div>

        <form method="get" class="training-filter" role="search" aria-label="Filter trainings">
            @if (Model.Filter.DateBasis == TrainingDateBasis.Reference)
            {
                <input type="hidden" name="DateBasis" value="Reference" />
            }
            <div class="training-filter__bar">
                <div class="training-filter__search">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input name="Search" value="@Model.Filter.Search" class="form-control form-control-sm" placeholder="Search projects, units, trainees or notes" aria-label="Search projects, units, trainees (name or army number) or notes" title="Matches linked project names, units and trainees (name or army number) on the roster, notes and the training type" autocomplete="off" maxlength="200" />
                </div>
                <select name="TypeId" class="form-select form-select-sm training-filter__type" asp-items="Model.TrainingTypes" aria-label="Training type" data-training-autosubmit></select>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary training-filter__more-toggle"
                        data-bs-toggle="collapse"
                        data-bs-target="#training-filter-more"
                        aria-expanded="@(hasMoreFilters ? "true" : "false")"
                        aria-controls="training-filter-more">
                    <i class="bi bi-sliders" aria-hidden="true"></i>
                    <span>More filters</span>
                    @if (moreFilterCount > 0)
                    {
                        <span class="training-filter__badge">@moreFilterCount</span>
                    }
                </button>
                <button type="submit" class="btn btn-sm btn-primary training-filter__apply">Search</button>
                @if (Model.TotalItems > 0)
                {
                    <div class="training-filter__view">
                        <label for="training-sort">Sort</label>
                        <select id="training-sort" name="Sort" class="form-select form-select-sm" data-training-autosubmit>
                            @foreach (var option in TrainingIndex.SortOptions)
                            {
                                <option value="@option.Value" selected="@(option.Value == Model.SortKey)">@option.Label</option>
                            }
                        </select>
                        <label for="training-page-size">Rows</label>
                        <select id="training-page-size" name="PageSize" class="form-select form-select-sm" data-training-autosubmit>
                            @foreach (var size in TrainingIndex.AllowedPageSizes)
                            {
                                <option value="@size" selected="@(size == Model.PageSize)">@size</option>
                            }
                        </select>
                    </div>
                }
            </div>
            <div id="training-filter-more" class="training-filter__more collapse@(hasMoreFilters ? " show" : string.Empty)">
                <div class="training-filter__more-grid">
                    <div class="training-filter__field">
                        <label for="training-filter-tech">Technical category</label>
                        <select id="training-filter-tech" name="ProjectTechnicalCategoryId" class="form-select form-select-sm" asp-items="Model.ProjectTechnicalCategoryOptions"></select>
                    </div>
                    <div class="training-filter__field">
                        <label for="training-filter-category">Attended by</label>
                        <select id="training-filter-category" name="Category" class="form-select form-select-sm">
                            @foreach (var option in Model.CategoryOptions)
                            {
                                <option value="@option.Value" selected="@(option.Value == (Model.Filter.Category?.ToString() ?? string.Empty))">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="training-filter__field">
                        <label for="training-filter-from">From</label>
                        <input id="training-filter-from" name="From" type="date" value="@fromValue" class="form-control form-control-sm" />
                    </div>
                    <div class="training-filter__field">
                        <label for="training-filter-to">To</label>
                        <input id="training-filter-to" name="To" type="date" value="@toValue" class="form-control form-control-sm" />
                    </div>
                </div>
            </div>
            @if (Model.Filter.ProjectId.HasValue)
            {
                <input type="hidden" name="ProjectId" value="@Model.Filter.ProjectId" />
            }
        </form>

        @if (Model.HasFilters)
        {
            <div class="training-chips" aria-label="Active filters">
                @if (Model.SelectedTypeLabel is { } typeLabel)
                {
                    <a class="training-chip" asp-page="./Index" asp-all-route-data='Model.RouteWith(removeKey: "TypeId")' aria-label="Remove filter: type @typeLabel">
                        <span>Type: @typeLabel</span><i class="bi bi-x" aria-hidden="true"></i>
                    </a>
                }
                @if (Model.SelectedTechnicalCategoryLabel is { } techLabel)
                {
                    <a class="training-chip" asp-page="./Index" asp-all-route-data='Model.RouteWith(removeKey: "ProjectTechnicalCategoryId")' aria-label="Remove filter: technical category @techLabel">
                        <span>Category: @techLabel</span><i class="bi bi-x" aria-hidden="true"></i>
                    </a>
                }
                @if (Model.Filter.ProjectId.HasValue)
                {
                    var projectLabel = Model.SelectedProjectName ?? "Selected project";
                    <a class="training-chip" asp-page="./Index" asp-all-route-data='Model.RouteWith(removeKey: "ProjectId")' aria-label="Remove filter: project @projectLabel">
                        <span>Project: @projectLabel</span><i class="bi bi-x" aria-hidden="true"></i>
                    </a>
                }
                @if (Model.SelectedCategoryLabel is { } categoryLabel)
                {
                    <a class="training-chip" asp-page="./Index" asp-all-route-data='Model.RouteWith(removeKey: "Category")' aria-label="Remove filter: attended by @categoryLabel">
                        <span>Attended by @categoryLabel</span><i class="bi bi-x" aria-hidden="true"></i>
                    </a>
                }
                @if (Model.Filter.ByReferenceDate)
                {
                    <a class="training-chip" asp-page="./Index" asp-all-route-data='Model.RouteWith(removeKey: "DateBasis")' aria-label="Remove filter: by reference date" title="Counting each training on its start date, else end date, else the first of its month, as the Command desk does">
                        <span>By reference date</span><i class="bi bi-x" aria-hidden="true"></i>
                    </a>
                }
                @if (Model.Filter.From is { } fromDate)
                {
                    <a class="training-chip" asp-page="./Index" asp-all-route-data='Model.RouteWith(removeKey: "From")' aria-label="Remove filter: from @fromDate.ToString("dd MMM yyyy", inv)">
                        <span>From @fromDate.ToString("dd MMM yyyy", inv)</span><i class="bi bi-x" aria-hidden="true"></i>
                    </a>
                }
                @if (Model.Filter.To is { } toDate)
                {
                    <a class="training-chip" asp-page="./Index" asp-all-route-data='Model.RouteWith(removeKey: "To")' aria-label="Remove filter: to @toDate.ToString("dd MMM yyyy", inv)">
                        <span>To @toDate.ToString("dd MMM yyyy", inv)</span><i class="bi bi-x" aria-hidden="true"></i>
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Filter.Search))
                {
                    <a class="training-chip" asp-page="./Index" asp-all-route-data='Model.RouteWith(removeKey: "Search")' aria-label="Remove search @Model.Filter.Search">
                        <span>&ldquo;@Model.Filter.Search.Trim()&rdquo;</span><i class="bi bi-x" aria-hidden="true"></i>
                    </a>
                }
                <a class="training-chips__clear" asp-page="./Index">Clear all</a>
            </div>
        }

        @if (!Model.HasResults)
        {
            <div class="training-empty-state">
                <i class="bi @(Model.HasFilters ? "bi-search" : "bi-mortarboard") training-empty-state__icon" aria-hidden="true"></i>
                @if (Model.HasFilters)
                {
                    <h3>No trainings match these filters</h3>
                    <p>Try a wider date range, another training type or a shorter search.</p>
                    <a asp-page="./Index" class="btn btn-outline-secondary">Clear filters</a>
                }
                else
                {
                    <h3>No trainings recorded yet</h3>
                    <p>Each training you record appears here with its attendees and linked projects.</p>
                    @if (Model.CanManageTrainingTracker)
                    {
                        <a asp-page="./Manage" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Record the first training</a>
                    }
                }
            </div>
        }
        else
        {
            <div class="training-table-card">
                <table class="training-register-table">
                    <thead>
                        <tr>
                            <th scope="col" class="training-register-table__date">Date</th>
                            <th scope="col">Projects and units</th>
                            <th scope="col" class="training-register-table__type">Type</th>
                            <th scope="col" class="training-register-table__strength"><abbr title="Total, then Officers · JCOs · ORs">Trainees (O · JCO · OR)</abbr></th>
                            @if (Model.CanManageTrainingTracker)
                            {
                                <th scope="col" class="training-register-table__actions"><span class="visually-hidden">Actions</span></th>
                            }
                        </tr>
                    </thead>
                    @foreach (var group in Model.Trainings.GroupBy(t => Model.GroupByMonth && t.EffectiveDate is { } d ? (d.Year, d.Month) : (0, 0)))
                    {
                        <tbody>
                            @if (Model.GroupByMonth)
                            {
                                var monthLabel = group.Key.Item1 == 0
                                    ? "Date not set"
                                    : new DateOnly(group.Key.Item1, group.Key.Item2, 1).ToString("MMMM yyyy", inv);
                                var totals = Model.MonthTotals.TryGetValue((group.Key.Item1, group.Key.Item2), out var found)
                                    ? found
                                    : (Trainings: group.Count(), Trainees: group.Sum(t => t.Total));
                                <tr class="training-register-table__month">
                                    <th scope="rowgroup" colspan="@columnCount">
                                        <span>@monthLabel</span>
                                        <span class="training-register-table__month-meta">@N(totals.Trainings) @Plural(totals.Trainings, "training", "trainings") · @N(totals.Trainees) @Plural(totals.Trainees, "trainee", "trainees")</span>
                                    </th>
                                </tr>
                            }
                            @foreach (var training in group)
                            {
                                var viewUrl = Url.Page("./View", new { id = training.Id });
                                var projectCount = training.ProjectNames.Count;
                                var projectTitle = projectCount == 0 ? "No project linked" : string.Join(", ", training.ProjectNames);
                                var linkLabel = $"Open {training.TrainingTypeName} training, {training.Period}: {projectTitle}";
                                <tr class="training-row" data-row-href="@viewUrl">
                                    <td class="training-register-table__date">
                                        <div class="training-date" title="@training.Period">
                                            <span class="training-date__lead">@training.DateLead</span>
                                            <span class="training-date__month">@training.DateMonth</span>
                                            @if (!string.IsNullOrWhiteSpace(training.DateNote))
                                            {
                                                <span class="training-date__note">@training.DateNote</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="training-register-table__entry">
                                        <a class="training-entry__name@(projectCount == 0 ? " is-empty" : string.Empty)" href="@viewUrl" title="@projectTitle" aria-label="@linkLabel">@(projectCount == 0 ? "No project linked" : training.ProjectNames[0])</a>
                                        @if (projectCount > 1)
                                        {
                                            <span class="training-entry__more">+@(projectCount - 1) more</span>
                                        }
                                        @if (training.Units.Count > 0)
                                        {
                                            <p class="training-entry__units" title="@string.Join(", ", training.Units)"><i class="bi bi-people" aria-hidden="true"></i> @training.UnitDisplay</p>
                                        }
                                    </td>
                                    <td class="training-register-table__type">
                                        <span class="training-type-tag training-type--@TrainingTypeAppearance.Modifier(training.TrainingTypeName)">@training.TrainingTypeName</span>
                                        @if (training.Source == ProjectManagement.Areas.ProjectOfficeReports.Domain.TrainingCounterSource.Legacy)
                                        {
                                            <span class="training-source-tag training-source-tag--legacy" title="Historical totals, no roster">Legacy</span>
                                        }
                                    </td>
                                    <td class="training-register-table__strength">
                                        <strong>@N(training.Total)</strong>
                                        <span class="training-row-split" aria-label="@N(training.Officers) Officers, @N(training.Jcos) JCOs, @N(training.Ors) ORs">
                                            <span title="Officers"><span class="training-rank-dot training-rank-dot--o"></span>@N(training.Officers) <abbr title="Officers">O</abbr></span>
                                            <span title="JCOs"><span class="training-rank-dot training-rank-dot--j"></span>@N(training.Jcos) <abbr title="JCOs">JCO</abbr></span>
                                            <span title="ORs"><span class="training-rank-dot training-rank-dot--r"></span>@N(training.Ors) <abbr title="ORs">OR</abbr></span>
                                        </span>
                                    </td>
                                    @if (Model.CanManageTrainingTracker)
                                    {
                                        <td class="training-register-table__actions">
                                            <a asp-page="./Manage" asp-route-id="@training.Id" class="btn btn-sm btn-outline-secondary training-row__manage" aria-label="Manage @training.TrainingTypeName training, @training.Period">
                                                <i class="bi bi-pencil" aria-hidden="true"></i>
                                                <span>Manage</span>
                                            </a>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    }
                </table>
            </div>

            @* SECTION: Pagination *@
            @if (Model.TotalPages > 1)
            {
                var first = Math.Max(1, Model.PageNumber - 2);
                var last = Math.Min(Model.TotalPages, first + 4);
                first = Math.Max(1, last - 4);
                <nav class="training-pagination" aria-label="Training pages">
                    @if (Model.PageNumber > 1)
                    {
                        <a class="training-pagination__step" asp-page="./Index" asp-all-route-data="Model.RouteWith(pageNumber: Model.PageNumber - 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Previous</a>
                    }
                    else
                    {
                        <span class="training-pagination__step is-disabled" aria-hidden="true"><i class="bi bi-chevron-left"></i> Previous</span>
                    }
                    <ol class="training-pagination__pages">
                        @for (var number = first; number <= last; number++)
                        {
                            <li>
                                @if (number == Model.PageNumber)
                                {
                                    <span class="training-pagination__page is-current" aria-current="page">@number</span>
                                }
                                else
                                {
                                    <a class="training-pagination__page" asp-page="./Index" asp-all-route-data="Model.RouteWith(pageNumber: number)" aria-label="Page @number">@number</a>
                                }
                            </li>
                        }
                    </ol>
                    <span class="training-pagination__status">Page @Model.PageNumber of @Model.TotalPages</span>
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a class="training-pagination__step" asp-page="./Index" asp-all-route-data="Model.RouteWith(pageNumber: Model.PageNumber + 1)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    }
                    else
                    {
                        <span class="training-pagination__step is-disabled" aria-hidden="true">Next <i class="bi bi-chevron-right"></i></span>
                    }
                </nav>
            }
        }
    </section>

    <!-- ============================================================
         EXPORT MODAL
         ============================================================ -->
    <div class="modal fade"
         id="trainingExportModal"
         tabindex="-1"
         aria-labelledby="trainingExportModalLabel"
         aria-hidden="true"
         data-bs-focus="true"
         data-training-export-auto-show="@(showExportModal.ToString().ToLowerInvariant())">
        <div class="modal-dialog modal-dialog-scrollable modal-xl modal-fullscreen-sm-down">
            <div class="modal-content training-export-modal">
                <form method="post"
                      asp-page-handler="Export"
                      class="w-100 training-export-form"
                      data-training-export-timeout-ms="@Model.ExportTimeoutMilliseconds">
                    <div class="modal-header">
                        <div>
                            <h2 class="modal-title h5 mb-1" id="trainingExportModalLabel">Export trainings</h2>
                            <p class="small text-muted mb-0">Create a filtered analytical workbook with summary and detailed sheets.</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="alert alert-danger d-none mb-3"
                             role="alert"
                             aria-live="assertive"
                             tabindex="-1"
                             data-training-export-errors></div>

                        <div class="row g-3">
                            <div class="col-lg-6">
                                <label asp-for="Export.TypeId" class="form-label small text-uppercase text-secondary fw-semibold"></label>
                                <select asp-for="Export.TypeId" asp-items="Model.TrainingTypes" class="form-select"></select>
                                <span asp-validation-for="Export.TypeId" class="text-danger small"></span>
                            </div>
                            <div class="col-lg-6">
                                <label asp-for="Export.ProjectId" class="form-label small text-uppercase text-secondary fw-semibold"></label>
                                <div class="training-export-project-picker" data-training-export-project-picker>
                                    <div class="training-export-project-picker__control">
                                        <i class="bi bi-search" aria-hidden="true"></i>
                                        <input id="Export_ProjectSearch"
                                               type="search"
                                               class="form-control training-export-project-picker__search"
                                               value="@selectedExportProjectName"
                                               placeholder="All projects"
                                               autocomplete="off"
                                               spellcheck="false"
                                               role="combobox"
                                               aria-autocomplete="list"
                                               aria-expanded="false"
                                               aria-controls="Export_ProjectSuggestions"
                                               data-training-export-project-search />
                                        <button type="button"
                                                class="btn training-export-project-picker__clear @(string.IsNullOrWhiteSpace(selectedExportProjectName) ? "d-none" : string.Empty)"
                                                aria-label="Clear project"
                                                title="Clear project"
                                                data-training-export-project-clear>
                                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                    <input asp-for="Export.ProjectId" type="hidden" data-training-export-project-id />
                                    <div id="Export_ProjectSuggestions"
                                         class="training-export-project-picker__panel d-none"
                                         role="listbox"
                                         aria-label="Projects"
                                         data-training-export-project-options>
                                        <button type="button"
                                                class="training-export-project-picker__option"
                                                role="option"
                                                data-training-export-project-option
                                                data-project-id=""
                                                data-project-label="All projects"
                                                data-project-search="all projects">
                                            <span>All projects</span>
                                            <small>Export the complete filtered portfolio</small>
                                        </button>
                                        @foreach (var projectOption in Model.ProjectOptions.Where(option => !string.IsNullOrWhiteSpace(option.Value)))
                                        {
                                            <button type="button"
                                                    class="training-export-project-picker__option"
                                                    role="option"
                                                    data-training-export-project-option
                                                    data-project-id="@projectOption.Value"
                                                    data-project-label="@projectOption.Text"
                                                    data-project-search="@projectOption.Text">
                                                <span>@projectOption.Text</span>
                                            </button>
                                        }
                                        <div class="training-export-project-picker__empty d-none" data-training-export-project-empty>
                                            No matching project found.
                                        </div>
                                    </div>
                                    <div class="visually-hidden" role="status" aria-live="polite" data-training-export-project-status></div>
                                </div>
                                <span asp-validation-for="Export.ProjectId" class="text-danger small"></span>
                            </div>
                            <div class="col-lg-6">
                                <label asp-for="Export.ProjectTechnicalCategoryId" class="form-label small text-uppercase text-secondary fw-semibold"></label>
                                <select asp-for="Export.ProjectTechnicalCategoryId" asp-items="Model.ProjectTechnicalCategoryOptions" class="form-select"></select>
                                <span asp-validation-for="Export.ProjectTechnicalCategoryId" class="text-danger small"></span>
                            </div>
                            <div class="col-lg-6">
                                <label asp-for="Export.Category" class="form-label small text-uppercase text-secondary fw-semibold"></label>
                                <select asp-for="Export.Category" asp-items="Model.CategoryOptions" class="form-select" data-training-export-category></select>
                                <div class="form-text">Includes training events attended by this category. Event totals remain complete.</div>
                                <span asp-validation-for="Export.Category" class="text-danger small"></span>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="Export.From" class="form-label small text-uppercase text-secondary fw-semibold"></label>
                                <input asp-for="Export.From" class="form-control" />
                                <span asp-validation-for="Export.From" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Export.To" class="form-label small text-uppercase text-secondary fw-semibold"></label>
                                <input asp-for="Export.To" class="form-control" />
                                <span asp-validation-for="Export.To" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Export.Search" class="form-label small text-uppercase text-secondary fw-semibold"></label>
                                <input asp-for="Export.Search" class="form-control" placeholder="Projects, units, trainees or notes" />
                                <span asp-validation-for="Export.Search" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <div class="border rounded-3 p-3 bg-light-subtle">
                                    <div class="row g-3 align-items-start">
                                        <div class="col-md-5">
                                            <div class="form-check">
                                                <input asp-for="Export.IncludeRoster"
                                                       class="form-check-input"
                                                       data-training-export-include-roster />
                                                <label asp-for="Export.IncludeRoster" class="form-check-label fw-semibold"></label>
                                            </div>
                                            <div class="form-text ms-4">Adds Army number, rank, name, unit and trainee category.</div>
                                        </div>
                                        <div class="col-md-7">
                                            <label asp-for="Export.RosterScope" class="form-label small text-uppercase text-secondary fw-semibold"></label>
                                            <select asp-for="Export.RosterScope"
                                                    class="form-select"
                                                    data-training-export-roster-scope>
                                                <option value="@((int)ProjectManagement.Areas.ProjectOfficeReports.Application.TrainingRosterScope.AllTraineesInMatchingEvents)">
                                                    All trainees in matching events
                                                </option>
                                                <option value="@((int)ProjectManagement.Areas.ProjectOfficeReports.Application.TrainingRosterScope.SelectedTraineeCategoryOnly)">
                                                    Selected trainee category only
                                                </option>
                                            </select>
                                            <div class="form-text" data-training-export-roster-scope-help>
                                                Select a trainee category above to limit roster rows.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer gap-2 justify-content-between flex-wrap">
                        <p class="text-muted small mb-0">Default values match the current tracker view. You may refine them before exporting.</p>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary btn-sm" data-training-busy-label="Preparing…">
                                <i class="bi bi-download" aria-hidden="true"></i>
                                <span>Export</span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

}
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/components/pm-table.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/project-office-reports/training/manage.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/project-office-reports/training/register.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.js"></script>
    <script type="module" src="~/js/project-office-reports/training/index.js" asp-append-version="true"></script>
}
