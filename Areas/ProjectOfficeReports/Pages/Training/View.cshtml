@page
@using System.Globalization
@using ProjectManagement.Areas.ProjectOfficeReports.Pages.Training
@model ProjectManagement.Areas.ProjectOfficeReports.Pages.Training.ViewModel
@{
    var training = Model.Training;
    ViewData["Title"] = $"{Model.Title} · Training tracker";
    ViewData["UseFullWidth"] = false;

    string N(int value) => value.ToString("N0", CultureInfo.CurrentCulture);
    string Plural(int count, string one, string many) => count == 1 ? one : many;

    var units = Model.Units;
    var typeModifier = TrainingTypeAppearance.Modifier(training.TrainingTypeName);
    const string splitPartial = "~/Areas/ProjectOfficeReports/Pages/Training/_StrengthSplit.cshtml";
}

<div class="training-record">
    <nav aria-label="Breadcrumb" class="training-record__crumbs">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-page="./Index">Training tracker</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    @* SECTION: Header — what it trained on, when, and how many *@
    <header class="training-record__head">
        <div class="training-record__identity">
            <div class="training-record__tags">
                <span class="training-type-tag training-type--@typeModifier">@training.TrainingTypeName</span>
                @if (training.IsLegacy)
                {
                    <span class="training-source-tag training-source-tag--legacy" title="Historical totals, no roster">Legacy totals</span>
                }
            </div>
            <h1>@Model.Title</h1>
            <ul class="training-record__meta">
                <li><i class="bi bi-calendar3" aria-hidden="true"></i> @Model.PeriodText@(Model.DurationText is { } length && training.DurationDays > 1 ? $" · {length}" : string.Empty)</li>
                <li><i class="bi bi-people" aria-hidden="true"></i> @N(training.TotalTrainees) @Plural(training.TotalTrainees, "trainee", "trainees")</li>
                @if (units.Count > 0)
                {
                    <li title="@string.Join(", ", units)"><i class="bi bi-shield" aria-hidden="true"></i> @(units.Count <= 2 ? string.Join(", ", units) : $"{units[0]}, {units[1]} and {units.Count - 2} more")</li>
                }
            </ul>
        </div>
        @if (Model.CanManageTrainingTracker)
        {
            <div class="training-record__actions">
                <a asp-page="./Manage" asp-route-id="@training.Id" class="btn btn-primary">
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                    <span>Edit training</span>
                </a>
            </div>
        }
    </header>

    @if (!Model.IsFeatureEnabled)
    {
        <div class="alert alert-warning mb-0" role="alert">
            The training tracker is currently disabled. Details may be out of date.
        </div>
    }

    <div class="training-record__layout">
        <div class="training-record__main">
            @* SECTION: Who attended *@
            <section class="training-panel" aria-labelledby="training-attended-heading">
                <div class="training-panel__head">
                    <h2 id="training-attended-heading" class="training-panel__title">Who attended</h2>
                    @if (training.Roster.Count > 0)
                    {
                        <span class="training-panel__note">@N(training.Roster.Count) on the roster</span>
                    }
                </div>
                <div class="training-record__strength">
                    <strong>@N(training.TotalTrainees)</strong>
                    <span>@Plural(training.TotalTrainees, "trainee", "trainees")</span>
                </div>
                <partial name="@splitPartial" model="new ProjectManagement.Areas.ProjectOfficeReports.Pages.Training.IndexModel.StrengthBreakdown(training.StrengthOfficers, training.StrengthJcos, training.StrengthOrs)" />

                @if (training.Roster.Count == 0)
                {
                    <p class="training-panel__empty">
                        @(training.IsLegacy
                            ? "This training was recorded as totals only, from a historical register, so there is no roster."
                            : "No one is on the roster yet.")
                    </p>
                }
                else
                {
                    <table class="training-roster-table">
                        <thead>
                            <tr>
                                <th scope="col">Rank and name</th>
                                <th scope="col">Army number</th>
                                <th scope="col">Unit</th>
                                <th scope="col">Category</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in training.Roster)
                            {
                                var rankKey = row.CategoryLabel switch { "Officer" => "o", "JCO" => "j", _ => "r" };
                                <tr>
                                    <td class="training-roster-table__who"><span class="training-roster-table__rank">@row.Rank</span> @row.Name</td>
                                    <td class="training-roster-table__number">@(string.IsNullOrWhiteSpace(row.ArmyNumber) ? "—" : row.ArmyNumber)</td>
                                    <td class="training-roster-table__unit">@row.UnitName</td>
                                    <td class="training-roster-table__category"><span class="training-rank-dot training-rank-dot--@rankKey"></span>@row.CategoryLabel</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>

            @* SECTION: Projects *@
            <section class="training-panel" aria-labelledby="training-projects-heading">
                <h2 id="training-projects-heading" class="training-panel__title">
                    Projects
                    @if (training.Projects.Count > 1)
                    {
                        <span class="training-panel__count">@training.Projects.Count</span>
                    }
                </h2>
                @if (training.Projects.Count == 0)
                {
                    <p class="training-panel__empty">No project is linked to this training.</p>
                }
                else
                {
                    <ul class="training-record__projects">
                        @foreach (var project in training.Projects)
                        {
                            <li>
                                <a asp-area="" asp-page="/Projects/Overview" asp-route-id="@project.ProjectId">@project.Name</a>
                            </li>
                        }
                    </ul>
                }
            </section>

            @* SECTION: Notes *@
            <section class="training-panel" aria-labelledby="training-notes-heading">
                <h2 id="training-notes-heading" class="training-panel__title">Notes</h2>
                @if (string.IsNullOrWhiteSpace(training.Notes))
                {
                    <p class="training-panel__empty">No notes recorded.</p>
                }
                else
                {
                    <p class="training-record__notes">@training.Notes</p>
                }
            </section>
        </div>

        <aside class="training-record__aside">
            @* SECTION: The training, at a glance *@
            <section class="training-panel" aria-labelledby="training-facts-heading">
                <h2 id="training-facts-heading" class="training-panel__title">The training</h2>
                <dl class="training-facts">
                    <div>
                        <dt>Type</dt>
                        <dd>@training.TrainingTypeName</dd>
                    </div>
                    <div>
                        <dt>Dates</dt>
                        <dd>@Model.PeriodText</dd>
                    </div>
                    @if (Model.DurationText is { } duration)
                    {
                        <div>
                            <dt>Length</dt>
                            <dd>@duration</dd>
                        </div>
                    }
                    <div>
                        <dt>Trainees</dt>
                        <dd>
                            @N(training.TotalTrainees)
                            <span>@N(training.StrengthOfficers) Officers · @N(training.StrengthJcos) JCOs · @N(training.StrengthOrs) ORs</span>
                        </dd>
                    </div>
                    <div>
                        <dt>Recorded as</dt>
                        <dd>
                            @(training.IsLegacy ? "Totals only" : "Roster")
                            <span>@(training.IsLegacy ? "From a historical register" : "Counts come from the people listed")</span>
                        </dd>
                    </div>
                </dl>
            </section>

            @* SECTION: Record history *@
            <section class="training-panel" aria-labelledby="training-history-heading">
                <h2 id="training-history-heading" class="training-panel__title">Record</h2>
                <ul class="training-history">
                    <li>
                        <span class="training-history__what">Recorded by @training.CreatedByDisplayName</span>
                        <span class="training-history__when">@ProjectManagement.Areas.ProjectOfficeReports.Pages.Training.ViewModel.Stamp(training.CreatedAt)</span>
                    </li>
                    @if (training.LastModifiedAt is { } modifiedAt && modifiedAt - training.CreatedAt > TimeSpan.FromMinutes(2))
                    {
                        <li>
                            <span class="training-history__what">Last edited@(string.IsNullOrWhiteSpace(training.LastModifiedByDisplayName) ? string.Empty : $" by {training.LastModifiedByDisplayName}")</span>
                            <span class="training-history__when">@ProjectManagement.Areas.ProjectOfficeReports.Pages.Training.ViewModel.Stamp(modifiedAt)</span>
                        </li>
                    }
                    else
                    {
                        <li class="training-history__quiet">Not edited since it was recorded.</li>
                    }
                </ul>
            </section>
        </aside>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/project-office-reports/training/manage.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/project-office-reports/training/record.css" asp-append-version="true" />
}
