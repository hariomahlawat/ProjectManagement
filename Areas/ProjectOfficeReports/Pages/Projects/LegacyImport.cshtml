@page
@model ProjectManagement.Areas.ProjectOfficeReports.Pages.Projects.LegacyImportModel
@inject ProjectManagement.Services.Admin.IAdminTimeService Time
@using ProjectManagement.Services.Admin
@using ProjectManagement.Services.Admin.Maintenance
@{
    ViewData["Title"] = "Legacy project import";
}

<partial name="~/Areas/Admin/Pages/Shared/_AdminFlashMessages.cshtml" />
<partial name="~/Areas/Admin/Pages/Shared/_AdminPageHeader.cshtml" model="Model.Header" />

@if (ViewData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="admin-flash admin-flash--@(Model.Preview?.CanCommit == true ? "success" : "warning")" role="status"><span class="admin-flash__icon"><i class="bi bi-clipboard-check"></i></span><div class="admin-flash__copy"><strong>File checked</strong><span>@statusMessage</span></div></div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="admin-flash admin-flash--danger" role="alert"><span class="admin-flash__icon"><i class="bi bi-exclamation-octagon"></i></span><div class="admin-flash__copy"><strong>The file could not be checked</strong><div asp-validation-summary="All"></div></div></div>
}

<section class="admin-panel admin-import-stage" aria-labelledby="import-validation-title">
    <header class="admin-panel__header"><div><div class="admin-panel__eyebrow">Step 1 of 2</div><h2 id="import-validation-title">Check the file</h2></div><span class="admin-status-pill admin-status-pill--neutral">Nothing is saved yet</span></header>
    <form method="post" enctype="multipart/form-data" asp-page-handler="Preview" class="admin-import-form">
        <div class="admin-form-section__grid admin-form-section__grid--three">
            <div class="admin-form-field"><label asp-for="ProjectCategoryId">Project category</label><select asp-for="ProjectCategoryId" asp-items="Model.ProjectCategories" class="form-select"><option value="">Select category</option></select><span asp-validation-for="ProjectCategoryId"></span></div>
            <div class="admin-form-field"><label asp-for="TechnicalCategoryId">Technical category</label><select asp-for="TechnicalCategoryId" asp-items="Model.TechnicalCategories" class="form-select"><option value="">Select category</option></select><span asp-validation-for="TechnicalCategoryId"></span></div>
            <div class="admin-form-field"><label asp-for="Upload">Excel file</label><input asp-for="Upload" type="file" class="form-control" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" /><span asp-validation-for="Upload"></span><small>Up to 10 MB. Use the current template and keep its Nomenclature column heading.</small></div>
        </div>
        <div class="admin-import-form__footer"><div class="admin-inline-notice"><i class="bi bi-shield-check"></i><span>Checking the file shows what would be imported. No project is added or changed until you import.</span></div><button type="submit" class="btn btn-primary"><i class="bi bi-clipboard-check"></i> Check file</button></div>
    </form>
</section>

@if (Model.Preview is not null)
{
    <section class="admin-monitoring-metrics admin-monitoring-metrics--four" aria-label="What the check found">
        <article class="admin-monitoring-metric admin-monitoring-metric--neutral"><span class="admin-monitoring-metric__copy"><strong>@Model.Preview.RowsReceived</strong><span>Rows in the file</span><small>@Model.Preview.FileName</small></span></article>
        <article class="admin-monitoring-metric admin-monitoring-metric--success"><span class="admin-monitoring-metric__copy"><strong>@Model.Preview.ValidRows</strong><span>Ready</span><small>No problems</small></span></article>
        <article class="admin-monitoring-metric admin-monitoring-metric--warning"><span class="admin-monitoring-metric__copy"><strong>@Model.Preview.WarningRows</strong><span>Warnings</span><small>Read before importing</small></span></article>
        <article class="admin-monitoring-metric admin-monitoring-metric--danger"><span class="admin-monitoring-metric__copy"><strong>@Model.Preview.RejectedRows</strong><span>Problems</span><small>Fix these in the file first</small></span></article>
    </section>

    <section class="admin-panel admin-import-stage" aria-labelledby="import-preview-title">
        <header class="admin-panel__header"><div><div class="admin-panel__eyebrow">Step 2 of 2</div><h2 id="import-preview-title">Check what will be imported</h2></div><div class="admin-panel__meta">Import before @Time.FormatIst(Model.Preview.ExpiresUtc), or check the file again</div></header>
        @if (Model.Preview.DuplicateCategoryImport)
        {
            <div class="admin-destructive-warning admin-destructive-warning--compact"><i class="bi bi-ban"></i><div><strong>These categories have already been imported</strong><p>PRISM imports each category pair only once, so the same projects are not added twice. Pick different categories, or look at the projects already imported.</p></div></div>
        }
        <div class="admin-import-file-facts"><span><small>File</small><strong>@Model.Preview.FileName</strong></span><details class="admin-technical-details"><summary>Technical details</summary><span><small>File fingerprint (SHA-256)</small><code>@Model.Preview.FileHashSha256[..16]…</code></span><span><small>Check reference</small><code>@Model.Preview.Token.ToString("N")[..12]</code></span></details></div>
        <div class="admin-table-wrap"><table class="admin-data-table admin-import-preview-table"><thead><tr><th>Row</th><th>Nomenclature</th><th>Arm / service</th><th>Year</th><th>Cost (lakhs)</th><th>Check result</th></tr></thead><tbody>
        @foreach (var row in Model.Preview.Rows)
        {
            <tr><td>@row.RowNumber</td><td><div class="admin-table-primary">@(row.Nomenclature ?? "—")</div></td><td>@(row.ArmService ?? "—")</td><td>@(row.YearOfDevelopment ?? "—")</td><td>@(row.CostLakhs ?? "—")</td><td><span class="admin-status-pill admin-status-pill--@Model.StatusTone(row.Status)">@row.Status</span><div class="admin-table-secondary mt-1">@row.Message</div></td></tr>
        }
        </tbody></table></div>
        @if (Model.Preview.Rows.Count < Model.Preview.RowsReceived)
        {
            <footer class="admin-panel__footer">Only the first @Model.Preview.Rows.Count rows are shown here. All @Model.Preview.RowsReceived rows are checked again when you import.</footer>
        }

        <div class="admin-import-commit-bar">
            <form method="post" asp-page-handler="Cancel"><input type="hidden" asp-for="ProjectCategoryId" /><input type="hidden" asp-for="TechnicalCategoryId" /><input type="hidden" name="PreviewToken" value="@Model.Preview.Token" /><button type="submit" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i> Start again</button></form>
            <form method="post" asp-page-handler="Commit" class="admin-import-commit-form"><input type="hidden" asp-for="ProjectCategoryId" /><input type="hidden" asp-for="TechnicalCategoryId" /><input type="hidden" name="PreviewToken" value="@Model.Preview.Token" /><label class="form-check"><input asp-for="ConfirmCommit" class="form-check-input" /><span class="form-check-label">I have checked the categories and the counts above.</span></label><button type="submit" class="btn btn-primary" disabled="@(!Model.Preview.CanCommit)"><i class="bi bi-database-check"></i> Import @Model.Preview.RowsReceived project@(Model.Preview.RowsReceived == 1 ? string.Empty : "s")</button></form>
        </div>
    </section>
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
