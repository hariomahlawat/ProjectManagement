@page
@using System.Globalization
@using ProjectManagement.Models.Arpp
@using ProjectManagement.Utilities
@model ProjectManagement.Areas.ProjectOfficeReports.Pages.ARPP.ManageModel
@{
    ViewData["Title"] = $"Edit {Model.Issue.Name}";
    ViewData["PageShell"] = "workspace";
    var lookupUrl = Url.Content("~/api/arpp/projects");
    var issueTypeLabel = Model.Issue.Kind == ArppIssueKind.Original
        ? "Original ARPP"
        : $"Addendum No. {Model.Issue.IssueSequence}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/project-office-reports/arpp.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/project-office-reports/arpp-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/prism-confirm-dialog.css" asp-append-version="true" />
}

<div class="arpp-workspace-v2"
     data-arpp-workspace
     data-arpp-project-lookup-url="@lookupUrl"
     data-arpp-has-server-errors="@(!ViewData.ModelState.IsValid ? "true" : "false")">
    <form method="post" class="arpp-workspace-v2__form" data-arpp-form>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Input.IssueRowVersion" />

        <header class="arpp-workspace-v2__header">
            <div class="arpp-workspace-v2__document">
                <span class="arpp-workspace-v2__product">ARPP / PPP working copy</span>
                <div class="arpp-workspace-v2__title-line">
                    <h1 title="@Model.Issue.Name">@Model.Issue.Name</h1>
                    <span class="arpp-workspace-v2__document-type">@issueTypeLabel</span>
                </div>
                <p>
                    FY @FinancialYearHelper.Format(Model.Issue.FinancialYearStart)
                    <span aria-hidden="true">·</span>
                    Issued @Model.Issue.IssueDate.ToString("dd MMM yyyy")
                    <span aria-hidden="true">·</span>
                    <span data-arpp-row-count>@Model.Input.Entries.Count</span>
                    <span data-arpp-row-count-label>@(Model.Input.Entries.Count == 1 ? "row" : "rows")</span>
                </p>
            </div>
            <div class="arpp-workspace-v2__header-status">
                <span class="arpp-workspace-v2__save-state" data-arpp-save-state aria-live="polite">No unsaved changes</span>
                <button type="submit" class="btn btn-primary" data-arpp-save-button title="Save working copy (Ctrl+S)">
                    <span class="bi bi-check2" aria-hidden="true"></span>
                    <span data-arpp-save-button-label>Save working copy</span>
                </button>
                <a asp-area="ProjectOfficeReports"
                   asp-page="/ARPP/Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary arpp-workspace-v2__exit"
                   data-arpp-discard-return>
                    <span class="bi bi-x-lg" aria-hidden="true"></span>
                    <span>Exit</span>
                </a>
            </div>
        </header>

        <div class="arpp-workspace-v2__notices">
            <partial name="~/Areas/ProjectOfficeReports/Pages/Shared/_StatusMessage.cshtml" />
            @if (TempData["ArppWarningMessage"] is string warningMessage)
            {
                <div class="alert alert-warning arpp-alert" role="alert">
                    <span class="bi bi-exclamation-triangle" aria-hidden="true"></span>
                    <span>@warningMessage</span>
                </div>
            }
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        </div>

        <div class="arpp-workspace-v2__toolbar" data-arpp-commandbar>
            <button type="button"
                    class="btn btn-outline-secondary arpp-workspace-v2__navigator-toggle"
                    data-arpp-navigator-toggle
                    aria-controls="arppWorkspaceNavigator"
                    aria-expanded="false">
                <span class="bi bi-layout-sidebar" aria-hidden="true"></span>
                Navigator
            </button>

            <div class="arpp-workspace-v2__search" role="search">
                <label class="visually-hidden" for="arpp-workspace-jump">Find a row or project</label>
                <span class="bi bi-search" aria-hidden="true"></span>
                <input id="arpp-workspace-jump"
                       type="search"
                       class="form-control"
                       autocomplete="off"
                       placeholder="Find row, project, PPP or serial"
                       data-arpp-jump-input
                       data-arpp-ui-only />
                <button type="button" class="btn btn-outline-secondary" data-arpp-jump-next title="Find next match" aria-label="Find next matching row">
                    <span class="bi bi-arrow-return-right" aria-hidden="true"></span>
                </button>
                <span class="arpp-workspace-v2__search-status" data-arpp-jump-status aria-live="polite"></span>
            </div>

            <button type="button"
                    class="btn btn-outline-danger d-none"
                    data-arpp-validation-toggle
                    aria-expanded="false"
                    aria-controls="arppWorkspaceIssues">
                <span class="bi bi-exclamation-circle" aria-hidden="true"></span>
                Issues
                <span class="badge text-bg-danger" data-arpp-validation-count>0</span>
            </button>

            <button type="button" class="btn btn-primary" data-arpp-add-row title="Add row (Alt+A)">
                <span class="bi bi-plus-lg" aria-hidden="true"></span>
                Add row
            </button>

            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="bi bi-tools" aria-hidden="true"></span>
                    Tools
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#arppPasteModal"><span class="bi bi-clipboard" aria-hidden="true"></span> Paste rows from Excel</button></li>
                    <li><button type="button" class="dropdown-item" data-arpp-apply-common><span class="bi bi-arrow-down-square" aria-hidden="true"></span> Fill common fields</button></li>
                    <li><button type="button" class="dropdown-item" data-arpp-details-toggle><span class="bi bi-file-earmark-text" aria-hidden="true"></span> Edit document details</button></li>
                    @if (Model.CanManageReferenceData)
                    {
                        <li><hr class="dropdown-divider" /></li>
                        <li><a asp-area="Admin" asp-page="/MasterData/ArppReferences/Index" class="dropdown-item"><span class="bi bi-list-check" aria-hidden="true"></span> Manage controlled lists</a></li>
                    }
                    <li><hr class="dropdown-divider" /></li>
                    <li><a asp-area="ProjectOfficeReports" asp-page="/ARPP/Details" asp-route-id="@Model.Id" class="dropdown-item" data-arpp-discard-return><span class="bi bi-arrow-left" aria-hidden="true"></span> Discard and return</a></li>
                </ul>
            </div>
        </div>

        <div class="arpp-workspace-v2__body">
            <aside class="arpp-workspace-v2__navigator" id="arppWorkspaceNavigator" data-arpp-navigator aria-label="Row navigator">
                <div class="arpp-workspace-v2__navigator-header">
                    <div>
                        <span>Row navigator</span>
                        <strong data-arpp-visible-row-status>All rows</strong>
                    </div>
                    <button type="button" class="btn btn-sm btn-light" data-arpp-navigator-close aria-label="Close row navigator">
                        <span class="bi bi-x-lg" aria-hidden="true"></span>
                    </button>
                </div>

                <nav class="arpp-workspace-v2__filters" aria-label="Filter rows">
                    <button type="button" class="is-active" data-arpp-row-filter="all" aria-pressed="true">
                        <span><span class="bi bi-list-ul" aria-hidden="true"></span> All rows</span>
                        <strong data-arpp-filter-count="all">@Model.Input.Entries.Count</strong>
                    </button>
                    <button type="button" data-arpp-row-filter="issues" aria-pressed="false">
                        <span><span class="bi bi-exclamation-circle" aria-hidden="true"></span> Needs attention</span>
                        <strong data-arpp-filter-count="issues">0</strong>
                    </button>
                    <button type="button" data-arpp-row-filter="unlinked" aria-pressed="false">
                        <span><span class="bi bi-link-45deg" aria-hidden="true"></span> Unlinked</span>
                        <strong data-arpp-filter-count="unlinked">0</strong>
                    </button>
                    <button type="button" data-arpp-row-filter="delisted" aria-pressed="false">
                        <span><span class="bi bi-archive" aria-hidden="true"></span> Delisted</span>
                        <strong data-arpp-filter-count="delisted">0</strong>
                    </button>
                </nav>

                <section class="arpp-workspace-v2__issues d-none"
                         id="arppWorkspaceIssues"
                         data-arpp-validation-navigator
                         aria-label="Validation issues"
                         aria-live="polite">
                    <div class="arpp-workspace-v2__issues-header">
                        <div>
                            <strong data-arpp-validation-heading>Review issues</strong>
                            <span data-arpp-validation-copy></span>
                        </div>
                        <button type="button" class="btn btn-sm btn-light" data-arpp-validation-close aria-label="Close issues">
                            <span class="bi bi-x-lg" aria-hidden="true"></span>
                        </button>
                    </div>
                    <div class="arpp-workspace-v2__issue-list" data-arpp-validation-items></div>
                    <div class="arpp-workspace-v2__issue-actions">
                        <button type="button" class="btn btn-link btn-sm d-none" data-arpp-validation-more>View all</button>
                        <button type="button" class="btn btn-outline-danger btn-sm" data-arpp-validation-first>Go to first issue</button>
                    </div>
                </section>

                <details class="arpp-workspace-v2__guidance" data-arpp-entry-guidance>
                    <summary><span class="bi bi-lightning-charge" aria-hidden="true"></span> Entry guidance</summary>
                    <div>
                        <p>Record the wording exactly as issued. Project linking is optional and does not alter the issued reference.</p>
                        <p>For values outside controlled lists, use <em>Not listed — enter as issued</em>. Mapping can be completed before verification.</p>
                    </div>
                </details>
            </aside>
            <button type="button" class="arpp-workspace-v2__navigator-backdrop" data-arpp-navigator-backdrop aria-label="Close row navigator" tabindex="-1"></button>

            <main class="arpp-workspace-v2__grid-shell" aria-label="Issued row editor">
                <div class="arpp-workspace-v2__empty @(Model.Input.Entries.Count == 0 ? string.Empty : "d-none")" data-arpp-empty-rows>
                    <span class="bi bi-table" aria-hidden="true"></span>
                    <h2>No issued rows entered</h2>
                    <p>Add the first row manually or paste rows copied from Excel.</p>
                    <div>
                        <button type="button" class="btn btn-primary" data-arpp-add-first-row>Add first row</button>
                        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#arppPasteModal">Paste rows</button>
                    </div>
                </div>

                <div class="arpp-workspace-v2__table-viewport @(Model.Input.Entries.Count == 0 ? "d-none" : string.Empty)" data-arpp-table-viewport>
                    <div class="arpp-workspace-v2__top-scrollbar d-none" data-arpp-table-scrollbar role="region" aria-label="Horizontal table scrollbar" tabindex="0">
                        <div data-arpp-table-scrollbar-spacer></div>
                    </div>
                    <div class="arpp-workspace-v2__table-wrap" data-arpp-table-wrap>
                        <table class="table arpp-entry-table arpp-workspace-v2__table align-middle" data-arpp-entry-table>
                            <thead>
                                <tr>
                                    <th class="arpp-col-order">#</th>
                                    <th class="arpp-col-issued">Issued identity</th>
                                    <th class="arpp-col-project">PRISM project <span class="arpp-optional">optional</span></th>
                                    <th class="arpp-col-category">Category</th>
                                    <th class="arpp-col-cost text-end">IPA cost (₹)</th>
                                    <th class="arpp-col-cfa">CFA</th>
                                    <th class="arpp-col-fund">Fund</th>
                                    <th class="arpp-col-dfpds">DFPDS</th>
                                    <th class="arpp-col-actions">Actions</th>
                                </tr>
                            </thead>
                    <tbody data-arpp-entry-body>
                        @for (var index = 0; index < Model.Input.Entries.Count; index++)
                        {
                            <tr data-arpp-entry-row>
                                <td class="arpp-row-order" data-arpp-row-number>@(index + 1)</td>
                                <td class="arpp-issued-cell">
                                    <input type="hidden" asp-for="Input.Entries[index].Id" />
                                    <input type="hidden" asp-for="Input.Entries[index].RowVersion" />
                                    <div class="arpp-issued-identity">
                                        <div class="arpp-issued-identity__identifiers">
                                            <div>
                                                <label asp-for="Input.Entries[index].SerialNumber" class="visually-hidden">Serial number</label>
                                                <input asp-for="Input.Entries[index].SerialNumber" class="form-control form-control-sm" maxlength="64" placeholder="Serial No." data-arpp-issued-identifier data-arpp-identifier-kind="serial" />
                                                <span asp-validation-for="Input.Entries[index].SerialNumber" class="text-danger small"></span>
                                            </div>
                                            <div>
                                                <label asp-for="Input.Entries[index].PppNumber" class="visually-hidden">PPP number</label>
                                                <input asp-for="Input.Entries[index].PppNumber" class="form-control form-control-sm" maxlength="160" placeholder="PPP No. as issued" data-arpp-issued-identifier data-arpp-identifier-kind="ppp" />
                                                <span asp-validation-for="Input.Entries[index].PppNumber" class="text-danger small"></span>
                                            </div>
                                        </div>
                                        <label asp-for="Input.Entries[index].ProjectReference" class="visually-hidden">Project reference as issued</label>
                                        <textarea asp-for="Input.Entries[index].ProjectReference" class="form-control form-control-sm arpp-reference-input" rows="1" maxlength="300" placeholder="Project reference as issued" data-arpp-project-reference></textarea>
                                        <div class="arpp-field-hint d-none" data-arpp-reference-prefill-hint>Prefilled from PRISM — verify against the issued document.</div>
                                        <div class="arpp-row-warning d-none" data-arpp-row-warning></div>
                                        <span asp-validation-for="Input.Entries[index].ProjectReference" class="text-danger small"></span>
                                    </div>
                                </td>
                                <td>
                                    <div class="arpp-project-picker" data-arpp-project-picker>
                                        <input type="hidden" asp-for="Input.Entries[index].ProjectId" data-arpp-project-id />
                                        <div class="arpp-project-picker__control">
                                            <span class="bi bi-search" aria-hidden="true"></span>
                                            <input asp-for="Input.Entries[index].LinkedProjectName"
                                                   class="form-control form-control-sm"
                                                   autocomplete="off"
                                                   placeholder="Search PRISM projects"
                                                   data-arpp-project-search />
                                            <button type="button" class="btn btn-sm arpp-project-picker__clear @(Model.Input.Entries[index].ProjectId.HasValue ? string.Empty : "d-none")" data-arpp-project-clear aria-label="Clear linked project"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
                                        </div>
                                        <input type="hidden" asp-for="Input.Entries[index].LinkedProjectMeta" data-arpp-project-meta-input />
                                        <div class="arpp-project-picker__meta" data-arpp-project-meta>@Model.Input.Entries[index].LinkedProjectMeta</div>
                                    </div>
                                    <span asp-validation-for="Input.Entries[index].ProjectId" class="text-danger small"></span>
                                </td>
                                <td>
                                    <select asp-for="Input.Entries[index].Category" class="form-select form-select-sm" data-arpp-category>
                                        <option value="">Select</option>
                                        @foreach (var category in Model.Categories)
                                        {
                                            <option value="@((int)category)">@ArppDisplayNames.For(category)</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Input.Entries[index].Category" class="text-danger small"></span>
                                </td>
                                <td>
                                    <input asp-for="Input.Entries[index].IpaCost"
                                           type="text"
                                           class="form-control form-control-sm text-end arpp-money-input"
                                           inputmode="decimal"
                                           autocomplete="off"
                                           data-arpp-money />
                                    <div class="arpp-money-helper" data-arpp-money-helper></div>
                                    <span asp-validation-for="Input.Entries[index].IpaCost" class="text-danger small"></span>
                                </td>
                                <td>
                                    @{
                                        var cfaCustom = !Model.Input.Entries[index].CfaOptionId.HasValue && !string.IsNullOrWhiteSpace(Model.Input.Entries[index].Cfa);
                                        var cfaMaster = Model.ReferenceData.CfaOptions.FirstOrDefault(option => option.Id == Model.Input.Entries[index].CfaOptionId);
                                        var cfaSnapshotDiffers = cfaMaster is not null && !string.Equals(cfaMaster.Value, Model.Input.Entries[index].Cfa, StringComparison.Ordinal);
                                    }
                                    <select name="Input.Entries[@index].CfaOptionId" id="Input_Entries_@(index)__CfaOptionId" class="form-select form-select-sm" data-arpp-reference-select data-reference-kind="cfa">
                                        <option value="">Select CFA</option>
                                        @foreach (var option in Model.ReferenceData.CfaOptions)
                                        {
                                            var isSelected = Model.Input.Entries[index].CfaOptionId == option.Id;
                                            var snapshot = isSelected ? Model.Input.Entries[index].Cfa : option.Value;
                                            <option value="@option.Id" data-snapshot="@snapshot" data-active="@(option.IsActive ? "true" : "false")" selected="@(isSelected ? "selected" : null)" disabled="@(!option.IsActive && !isSelected ? "disabled" : null)">@option.Value@(option.IsActive ? string.Empty : " (inactive)")</option>
                                        }
                                        <option value="-1" selected="@(cfaCustom ? "selected" : null)">Not listed — enter as issued</option>
                                    </select>
                                    @if (cfaSnapshotDiffers)
                                    {
                                        <small class="arpp-historical-snapshot">Recorded wording: @Model.Input.Entries[index].Cfa</small>
                                    }
                                    <input asp-for="Input.Entries[index].Cfa" type="@(cfaCustom ? "text" : "hidden")" class="form-control form-control-sm mt-1" maxlength="200" data-arpp-reference-snapshot data-reference-kind="cfa" placeholder="Enter CFA exactly as issued" />
                                    <div class="arpp-reference-pending @(cfaCustom ? string.Empty : "d-none")" data-arpp-reference-pending>Admin mapping required before verification.</div>
                                    <span asp-validation-for="Input.Entries[index].CfaOptionId" class="text-danger small"></span>
                                    <span asp-validation-for="Input.Entries[index].Cfa" class="text-danger small"></span>
                                </td>
                                <td>
                                    @{
                                        var fundCustom = !Model.Input.Entries[index].FundOptionId.HasValue && !string.IsNullOrWhiteSpace(Model.Input.Entries[index].Fund);
                                        var fundMaster = Model.ReferenceData.FundOptions.FirstOrDefault(option => option.Id == Model.Input.Entries[index].FundOptionId);
                                        var fundSnapshotDiffers = fundMaster is not null && !string.Equals(fundMaster.Value, Model.Input.Entries[index].Fund, StringComparison.Ordinal);
                                    }
                                    <select name="Input.Entries[@index].FundOptionId" id="Input_Entries_@(index)__FundOptionId" class="form-select form-select-sm" data-arpp-reference-select data-reference-kind="fund">
                                        <option value="">Select Fund</option>
                                        @foreach (var option in Model.ReferenceData.FundOptions)
                                        {
                                            var isSelected = Model.Input.Entries[index].FundOptionId == option.Id;
                                            var snapshot = isSelected ? Model.Input.Entries[index].Fund : option.Value;
                                            <option value="@option.Id" data-snapshot="@snapshot" data-active="@(option.IsActive ? "true" : "false")" selected="@(isSelected ? "selected" : null)" disabled="@(!option.IsActive && !isSelected ? "disabled" : null)">@option.Value@(option.IsActive ? string.Empty : " (inactive)")</option>
                                        }
                                        <option value="-1" selected="@(fundCustom ? "selected" : null)">Not listed — enter as issued</option>
                                    </select>
                                    @if (fundSnapshotDiffers)
                                    {
                                        <small class="arpp-historical-snapshot">Recorded wording: @Model.Input.Entries[index].Fund</small>
                                    }
                                    <input asp-for="Input.Entries[index].Fund" type="@(fundCustom ? "text" : "hidden")" class="form-control form-control-sm mt-1" maxlength="120" data-arpp-reference-snapshot data-reference-kind="fund" placeholder="Enter Fund exactly as issued" />
                                    <div class="arpp-reference-pending @(fundCustom ? string.Empty : "d-none")" data-arpp-reference-pending>Admin mapping required before verification.</div>
                                    <span asp-validation-for="Input.Entries[index].FundOptionId" class="text-danger small"></span>
                                    <span asp-validation-for="Input.Entries[index].Fund" class="text-danger small"></span>
                                </td>
                                <td>
                                    @{
                                        var dfpdsCustom = !Model.Input.Entries[index].DfpdsScheduleId.HasValue && !string.IsNullOrWhiteSpace(Model.Input.Entries[index].DfpdsSchedule);
                                        var dfpdsMaster = Model.ReferenceData.DfpdsSchedules.FirstOrDefault(option => option.Id == Model.Input.Entries[index].DfpdsScheduleId);
                                        var dfpdsSnapshotDiffers = dfpdsMaster is not null && !string.Equals(dfpdsMaster.Value, Model.Input.Entries[index].DfpdsSchedule, StringComparison.Ordinal);
                                    }
                                    <select name="Input.Entries[@index].DfpdsScheduleId" id="Input_Entries_@(index)__DfpdsScheduleId" class="form-select form-select-sm" data-arpp-reference-select data-reference-kind="dfpds">
                                        <option value="">Select schedule</option>
                                        @foreach (var option in Model.ReferenceData.DfpdsSchedules)
                                        {
                                            var isSelected = Model.Input.Entries[index].DfpdsScheduleId == option.Id;
                                            var snapshot = isSelected ? Model.Input.Entries[index].DfpdsSchedule : option.Value;
                                            <option value="@option.Id" data-snapshot="@snapshot" data-active="@(option.IsActive ? "true" : "false")" selected="@(isSelected ? "selected" : null)" disabled="@(!option.IsActive && !isSelected ? "disabled" : null)">@option.DisplayText@(option.IsActive ? string.Empty : " (inactive)")</option>
                                        }
                                        <option value="-1" selected="@(dfpdsCustom ? "selected" : null)">Not listed — enter as issued</option>
                                    </select>
                                    @if (dfpdsSnapshotDiffers)
                                    {
                                        <small class="arpp-historical-snapshot">Recorded wording: @Model.Input.Entries[index].DfpdsSchedule</small>
                                    }
                                    <input asp-for="Input.Entries[index].DfpdsSchedule" type="@(dfpdsCustom ? "text" : "hidden")" class="form-control form-control-sm mt-1" maxlength="120" data-arpp-reference-snapshot data-reference-kind="dfpds" placeholder="Enter schedule exactly as issued" />
                                    <div class="arpp-reference-pending @(dfpdsCustom ? string.Empty : "d-none")" data-arpp-reference-pending>Admin mapping required before verification.</div>
                                    <span asp-validation-for="Input.Entries[index].DfpdsScheduleId" class="text-danger small"></span>
                                    <span asp-validation-for="Input.Entries[index].DfpdsSchedule" class="text-danger small"></span>
                                </td>
                                <td class="arpp-actions-cell">
                                    <div class="arpp-row-actions">
                                        <button type="button" class="btn btn-light btn-sm" data-arpp-copy-previous title="Copy CFA, Fund and DFPDS from previous row" aria-label="Copy common fields from previous row"><span class="bi bi-copy" aria-hidden="true"></span></button>
                                        <button type="button" class="btn btn-light btn-sm text-danger" data-arpp-remove-row title="Remove row" aria-label="Remove row"><span class="bi bi-trash" aria-hidden="true"></span></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                        </table>
                    </div>
                </div>
            </main>
        </div>

        <aside class="arpp-workspace-v2__drawer" data-arpp-details-drawer aria-hidden="true" aria-labelledby="arppDocumentDetailsTitle">
            <div class="arpp-workspace-v2__drawer-header">
                <div>
                    <span>Working copy</span>
                    <h2 id="arppDocumentDetailsTitle">Document details</h2>
                </div>
                <button type="button" class="btn btn-sm btn-light" data-arpp-details-close aria-label="Close document details">
                    <span class="bi bi-x-lg" aria-hidden="true"></span>
                </button>
            </div>
            <div class="arpp-workspace-v2__drawer-body">
                <p class="arpp-workspace-v2__drawer-intro">Enter the identity exactly as shown on the issued HQ document.</p>
                <div>
                    <label asp-for="Input.FinancialYearStart" class="form-label">Financial year</label>
                    <select asp-for="Input.FinancialYearStart" class="form-select" data-arpp-financial-year>
                        @foreach (var year in Model.FinancialYearOptions)
                        {
                            <option value="@year">@FinancialYearHelper.Format(year)</option>
                        }
                    </select>
                    <span asp-validation-for="Input.FinancialYearStart" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Input.Kind" class="form-label">Issue type</label>
                    <select asp-for="Input.Kind" class="form-select" data-arpp-issue-kind>
                        <option value="@((int)ArppIssueKind.Original)">Original ARPP</option>
                        <option value="@((int)ArppIssueKind.Addendum)">Addendum</option>
                    </select>
                    <span asp-validation-for="Input.Kind" class="text-danger small"></span>
                </div>
                <div class="@(Model.Input.Kind == ArppIssueKind.Original ? "d-none" : string.Empty)" data-arpp-addendum-number-field>
                    <label asp-for="Input.IssueSequence" class="form-label">Addendum number</label>
                    <input asp-for="Input.IssueSequence" class="form-control" type="number" min="0" data-arpp-issue-sequence />
                    <div class="form-text" data-arpp-sequence-help>Original ARPP uses internal sequence 0.</div>
                    <span asp-validation-for="Input.IssueSequence" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Input.IssueDate" class="form-label">Issue date</label>
                    <input asp-for="Input.IssueDate" class="form-control" type="date" />
                    <span asp-validation-for="Input.IssueDate" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Input.Name" class="form-label">Document name / letter description</label>
                    <textarea asp-for="Input.Name" class="form-control" rows="3" maxlength="300"></textarea>
                    <span asp-validation-for="Input.Name" class="text-danger small"></span>
                </div>
            </div>
            <div class="arpp-workspace-v2__drawer-footer">
                <button type="button" class="btn btn-primary" data-arpp-details-close>Done</button>
            </div>
        </aside>
        <button type="button" class="arpp-workspace-v2__drawer-backdrop" data-arpp-details-backdrop aria-label="Close document details" tabindex="-1"></button>

            <template data-arpp-row-template>
                <tr data-arpp-entry-row>
                    <td class="arpp-row-order" data-arpp-row-number>__ROW__</td>
                    <td class="arpp-issued-cell">
                        <input type="hidden" name="Input.Entries[__INDEX__].Id" id="Input_Entries___INDEX____Id" />
                        <input type="hidden" name="Input.Entries[__INDEX__].RowVersion" id="Input_Entries___INDEX____RowVersion" />
                        <div class="arpp-issued-identity">
                            <div class="arpp-issued-identity__identifiers">
                                <div>
                                    <label for="Input_Entries___INDEX____SerialNumber" class="visually-hidden">Serial number</label>
                                    <input name="Input.Entries[__INDEX__].SerialNumber" id="Input_Entries___INDEX____SerialNumber" class="form-control form-control-sm" maxlength="64" placeholder="Serial No." data-val="true" data-val-length="The serial number cannot exceed 64 characters." data-val-length-max="64" data-arpp-issued-identifier data-arpp-identifier-kind="serial" />
                                    <span class="text-danger small field-validation-valid" data-valmsg-for="Input.Entries[__INDEX__].SerialNumber" data-valmsg-replace="true"></span>
                                </div>
                                <div>
                                    <label for="Input_Entries___INDEX____PppNumber" class="visually-hidden">PPP number</label>
                                    <input name="Input.Entries[__INDEX__].PppNumber" id="Input_Entries___INDEX____PppNumber" class="form-control form-control-sm" maxlength="160" placeholder="PPP No. as issued" data-val="true" data-val-length="The PPP number cannot exceed 160 characters." data-val-length-max="160" data-arpp-issued-identifier data-arpp-identifier-kind="ppp" />
                                    <span class="text-danger small field-validation-valid" data-valmsg-for="Input.Entries[__INDEX__].PppNumber" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <label for="Input_Entries___INDEX____ProjectReference" class="visually-hidden">Project reference as issued</label>
                            <textarea name="Input.Entries[__INDEX__].ProjectReference" id="Input_Entries___INDEX____ProjectReference" class="form-control form-control-sm arpp-reference-input" rows="1" maxlength="300" placeholder="Project reference as issued" required data-val="true" data-val-required="Enter the project reference." data-val-length="The project reference cannot exceed 300 characters." data-val-length-max="300" data-arpp-project-reference></textarea>
                            <div class="arpp-field-hint d-none" data-arpp-reference-prefill-hint>Prefilled from PRISM — verify against the issued document.</div>
                            <div class="arpp-row-warning d-none" data-arpp-row-warning></div>
                            <span class="text-danger small field-validation-valid" data-valmsg-for="Input.Entries[__INDEX__].ProjectReference" data-valmsg-replace="true"></span>
                        </div>
                    </td>
                    <td>
                        <div class="arpp-project-picker" data-arpp-project-picker>
                            <input type="hidden" name="Input.Entries[__INDEX__].ProjectId" id="Input_Entries___INDEX____ProjectId" data-arpp-project-id />
                            <div class="arpp-project-picker__control">
                                <span class="bi bi-search" aria-hidden="true"></span>
                                <input name="Input.Entries[__INDEX__].LinkedProjectName" id="Input_Entries___INDEX____LinkedProjectName" class="form-control form-control-sm" autocomplete="off" placeholder="Search PRISM projects" data-arpp-project-search />
                                <button type="button" class="btn btn-sm arpp-project-picker__clear d-none" data-arpp-project-clear aria-label="Clear linked project"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
                            </div>
                            <input type="hidden" name="Input.Entries[__INDEX__].LinkedProjectMeta" id="Input_Entries___INDEX____LinkedProjectMeta" data-arpp-project-meta-input />
                            <div class="arpp-project-picker__meta" data-arpp-project-meta></div>
                        </div>
                        <span class="text-danger small field-validation-valid" data-valmsg-for="Input.Entries[__INDEX__].ProjectId" data-valmsg-replace="true"></span>
                    </td>
                    <td>
                        <select name="Input.Entries[__INDEX__].Category" id="Input_Entries___INDEX____Category" class="form-select form-select-sm" required data-val="true" data-val-required="Select an ARPP category." data-arpp-category>
                            <option value="">Select</option><option value="1">New</option><option value="2">CL</option><option value="3">CF</option><option value="4">Delisted</option>
                        </select>
                        <span class="text-danger small field-validation-valid" data-valmsg-for="Input.Entries[__INDEX__].Category" data-valmsg-replace="true"></span>
                    </td>
                    <td>
                        <input name="Input.Entries[__INDEX__].IpaCost" id="Input_Entries___INDEX____IpaCost" type="text" class="form-control form-control-sm text-end arpp-money-input" inputmode="decimal" autocomplete="off" required data-val="true" data-val-required="Enter the IPA cost." data-val-range="IPA cost cannot be negative." data-val-range-min="0" data-val-range-max="9999999999999999" data-arpp-money />
                        <div class="arpp-money-helper" data-arpp-money-helper></div>
                        <span class="text-danger small field-validation-valid" data-valmsg-for="Input.Entries[__INDEX__].IpaCost" data-valmsg-replace="true"></span>
                    </td>
                    <td>
                        <select name="Input.Entries[__INDEX__].CfaOptionId" id="Input_Entries___INDEX____CfaOptionId" class="form-select form-select-sm" data-arpp-reference-select data-reference-kind="cfa">
                            <option value="">Select CFA</option>
                            @foreach (var option in Model.ReferenceData.CfaOptions)
                            {
                                <option value="@option.Id" data-snapshot="@option.Value" data-active="@(option.IsActive ? "true" : "false")" disabled="@(!option.IsActive ? "disabled" : null)">@option.Value@(option.IsActive ? string.Empty : " (inactive)")</option>
                            }
                            <option value="-1">Not listed — enter as issued</option>
                        </select>
                        <input type="hidden" name="Input.Entries[__INDEX__].Cfa" id="Input_Entries___INDEX____Cfa" class="form-control form-control-sm mt-1" maxlength="200" required data-val="true" data-val-required="Enter the CFA." data-arpp-reference-snapshot data-reference-kind="cfa" placeholder="Enter CFA exactly as issued" />
                        <div class="arpp-reference-pending d-none" data-arpp-reference-pending>Admin mapping required before verification.</div>
                        <span class="text-danger small field-validation-valid" data-valmsg-for="Input.Entries[__INDEX__].CfaOptionId" data-valmsg-replace="true"></span>
                        <span class="text-danger small field-validation-valid" data-valmsg-for="Input.Entries[__INDEX__].Cfa" data-valmsg-replace="true"></span>
                    </td>
                    <td>
                        <select name="Input.Entries[__INDEX__].FundOptionId" id="Input_Entries___INDEX____FundOptionId" class="form-select form-select-sm" data-arpp-reference-select data-reference-kind="fund">
                            <option value="">Select Fund</option>
                            @foreach (var option in Model.ReferenceData.FundOptions)
                            {
                                <option value="@option.Id" data-snapshot="@option.Value" data-active="@(option.IsActive ? "true" : "false")" disabled="@(!option.IsActive ? "disabled" : null)">@option.Value@(option.IsActive ? string.Empty : " (inactive)")</option>
                            }
                            <option value="-1">Not listed — enter as issued</option>
                        </select>
                        <input type="hidden" name="Input.Entries[__INDEX__].Fund" id="Input_Entries___INDEX____Fund" class="form-control form-control-sm mt-1" maxlength="120" required data-val="true" data-val-required="Enter the Fund." data-arpp-reference-snapshot data-reference-kind="fund" placeholder="Enter Fund exactly as issued" />
                        <div class="arpp-reference-pending d-none" data-arpp-reference-pending>Admin mapping required before verification.</div>
                        <span class="text-danger small field-validation-valid" data-valmsg-for="Input.Entries[__INDEX__].FundOptionId" data-valmsg-replace="true"></span>
                        <span class="text-danger small field-validation-valid" data-valmsg-for="Input.Entries[__INDEX__].Fund" data-valmsg-replace="true"></span>
                    </td>
                    <td>
                        <select name="Input.Entries[__INDEX__].DfpdsScheduleId" id="Input_Entries___INDEX____DfpdsScheduleId" class="form-select form-select-sm" data-arpp-reference-select data-reference-kind="dfpds">
                            <option value="">Select DFPDS schedule</option>
                            @foreach (var option in Model.ReferenceData.DfpdsSchedules)
                            {
                                <option value="@option.Id" data-snapshot="@option.Value" data-active="@(option.IsActive ? "true" : "false")" disabled="@(!option.IsActive ? "disabled" : null)">@option.DisplayText@(option.IsActive ? string.Empty : " (inactive)")</option>
                            }
                            <option value="-1">Not listed — enter as issued</option>
                        </select>
                        <input type="hidden" name="Input.Entries[__INDEX__].DfpdsSchedule" id="Input_Entries___INDEX____DfpdsSchedule" class="form-control form-control-sm mt-1" maxlength="120" required data-val="true" data-val-required="Enter the DFPDS schedule." data-arpp-reference-snapshot data-reference-kind="dfpds" placeholder="Enter DFPDS schedule exactly as issued" />
                        <div class="arpp-reference-pending d-none" data-arpp-reference-pending>Admin mapping required before verification.</div>
                        <span class="text-danger small field-validation-valid" data-valmsg-for="Input.Entries[__INDEX__].DfpdsScheduleId" data-valmsg-replace="true"></span>
                        <span class="text-danger small field-validation-valid" data-valmsg-for="Input.Entries[__INDEX__].DfpdsSchedule" data-valmsg-replace="true"></span>
                    </td>
                    <td class="arpp-actions-cell"><div class="arpp-row-actions"><button type="button" class="btn btn-light btn-sm" data-arpp-copy-previous title="Copy CFA, Fund and DFPDS from previous row" aria-label="Copy common fields from previous row"><span class="bi bi-copy" aria-hidden="true"></span></button><button type="button" class="btn btn-light btn-sm text-danger" data-arpp-remove-row title="Remove row" aria-label="Remove row"><span class="bi bi-trash" aria-hidden="true"></span></button></div></td>
                </tr>
            </template>
    </form>
</div>

<div class="modal fade" id="arppPasteModal" tabindex="-1" aria-labelledby="arppPasteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title fs-5" id="arppPasteModalLabel">Paste rows from Excel</h2>
                    <p class="mb-0 small text-body-secondary">Paste eight tab-separated columns: Serial, PPP No., Project reference, Category, IPA cost, CFA, Fund and DFPDS. For Delisted rows, leave Serial and PPP No. blank.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div data-arpp-paste-entry>
                    <label for="arpp-paste-text" class="form-label">Excel rows</label>
                    <textarea id="arpp-paste-text" class="form-control font-monospace" rows="10" data-arpp-paste-text placeholder="1&#9;ARPP/IR&amp;D/N/2026-27/15&#9;Project name&#9;New&#9;12500000&#9;Comdt SDD&#9;IR&amp;D&#9;9.3"></textarea>
                    <div class="form-text">A header row is accepted. Comma-formatted and ₹-prefixed costs are recognised.</div>
                </div>
                <div class="alert alert-danger d-none mt-3 mb-0" role="alert" data-arpp-paste-error></div>
                <div class="d-none" data-arpp-paste-preview>
                    <div class="d-flex align-items-center justify-content-between gap-3 mb-2">
                        <div>
                            <h3 class="fs-6 mb-1">Review before insertion</h3>
                            <p class="small text-body-secondary mb-0">Resolve highlighted rows. Project suggestions require explicit confirmation.</p>
                        </div>
                        <button type="button" class="btn btn-link btn-sm" data-arpp-paste-back>Back to paste</button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm arpp-paste-preview-table">
                            <thead><tr><th>Row</th><th>Serial</th><th>PPP No.</th><th>Project reference</th><th>Category</th><th>IPA cost</th><th>Suggested project</th><th>Review</th></tr></thead>
                            <tbody data-arpp-paste-preview-body></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" data-arpp-preview-paste>Preview rows</button>
                <button type="button" class="btn btn-primary d-none" data-arpp-apply-paste>Insert reviewed rows</button>
            </div>
        </div>
    </div>
</div>

<partial name="~/Pages/Shared/_PrismConfirmDialog.cshtml" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/components/prism-confirm-dialog.js" asp-append-version="true" defer></script>
    <script src="~/js/pages/project-office-reports/arpp/arpp-project-picker.js" asp-append-version="true" defer></script>
    <script src="~/js/pages/project-office-reports/arpp/arpp-manage.js" asp-append-version="true" defer></script>
}