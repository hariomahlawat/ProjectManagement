@page
@using ProjectManagement.Helpers
@using ProjectManagement.Models.Arpp
@using ProjectManagement.Utilities
@model ProjectManagement.Areas.ProjectOfficeReports.Pages.ARPP.DetailsModel
@{
    ViewData["Title"] = Model.Issue.Name;
    ViewData["PageShell"] = "wide";
    var issueTypeLabel = Model.Issue.Kind == ArppIssueKind.Original
        ? "Original ARPP"
        : $"Addendum No. {Model.Issue.IssueSequence}";
    var isCorrection = !Model.Issue.IsVerified && Model.Issue.HasPublishedSnapshot;
    var valueStateLabel = Model.Issue.IsVerified ? "Published" : "Working";
    var statusLabel = Model.Issue.IsVerified
        ? "Verified and published"
        : isCorrection
            ? "Unlocked for correction"
            : "Verification pending";
    var statusBadgeClass = Model.Issue.IsVerified
        ? "arpp-badge--verified"
        : isCorrection
            ? "arpp-badge--correction"
            : "arpp-badge--unverified";
}

@section Styles {
    <link rel="stylesheet" href="~/css/project-office-reports/arpp.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/prism-confirm-dialog.css" asp-append-version="true" />
}

<div class="container-fluid px-3 px-lg-4 py-2 arpp-page"
     data-arpp-details
     data-arpp-reopen-unlock-modal="@(Model.ReopenUnlockModal ? "true" : "false")">
    <header class="arpp-header arpp-header--compact">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="arpp-eyebrow">ARPP / PPP · @FinancialYearHelper.Format(Model.Issue.FinancialYearStart)</div>
                <span class="arpp-badge @statusBadgeClass">
                    <span class="bi @(Model.Issue.IsVerified ? "bi-lock-fill" : isCorrection ? "bi-pencil-square" : "bi-hourglass-split")" aria-hidden="true"></span>
                    @statusLabel
                </span>
            </div>
            <h1>@Model.Issue.Name</h1>
            <p>@issueTypeLabel · Issued @Model.Issue.IssueDate.ToString("dd MMM yyyy")</p>
        </div>
        <div class="d-flex flex-wrap justify-content-end gap-2">
            @if (Model.Issue.Attachment is not null)
            {
                <a asp-area="ProjectOfficeReports" asp-page="/ARPP/Details" asp-page-handler="Attachment" asp-route-id="@Model.Issue.Id" class="btn btn-outline-secondary btn-sm">
                    <span class="bi bi-file-earmark-pdf" aria-hidden="true"></span> Issued PDF
                </a>
            }
            <a asp-area="ProjectOfficeReports" asp-page="/ARPP/Details" asp-page-handler="Excel" asp-route-id="@Model.Issue.Id" class="btn btn-outline-success btn-sm">
                <span class="bi bi-file-earmark-excel" aria-hidden="true"></span> Excel
            </a>
            <a asp-area="ProjectOfficeReports" asp-page="/ARPP/Print" asp-route-id="@Model.Issue.Id" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">
                <span class="bi bi-printer" aria-hidden="true"></span> Print / PDF
            </a>
            @if (Model.CanManage && !Model.Issue.IsVerified)
            {
                <a asp-area="ProjectOfficeReports" asp-page="/ARPP/Manage" asp-route-id="@Model.Issue.Id" class="btn btn-primary btn-sm">
                    <span class="bi bi-pencil-square" aria-hidden="true"></span> Edit issued rows
                </a>
            }
            <a asp-area="ProjectOfficeReports" asp-page="/ARPP/Index" class="btn btn-outline-secondary btn-sm">
                <span class="bi bi-arrow-left" aria-hidden="true"></span> Back to register
            </a>
        </div>
    </header>

    <partial name="~/Areas/ProjectOfficeReports/Pages/Shared/_StatusMessage.cshtml" />
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger arpp-alert" role="alert"><span class="bi bi-exclamation-octagon" aria-hidden="true"></span><span>@errorMessage</span></div>
    }
    @if (TempData["ArppWarningMessage"] is string warningMessage)
    {
        <div class="alert alert-warning arpp-alert" role="alert"><span class="bi bi-exclamation-triangle" aria-hidden="true"></span><span>@warningMessage</span></div>
    }

    <section class="arpp-document-state @(Model.Issue.IsVerified ? "arpp-document-state--published" : isCorrection ? "arpp-document-state--correction" : "arpp-document-state--pending")"
             aria-label="Document state">
        <div class="arpp-document-state__identity">
            <span class="bi @(Model.Issue.IsVerified ? "bi-shield-lock-fill" : isCorrection ? "bi-pencil-square" : "bi-shield-exclamation")" aria-hidden="true"></span>
            <div>
                <div class="arpp-document-state__titleline">
                    <strong>@statusLabel</strong>
                    @if (Model.Issue.HasPublishedSnapshot && Model.Issue.PublishedRevisionNumber.HasValue)
                    {
                        <span class="arpp-document-state__revision">Revision @Model.Issue.PublishedRevisionNumber</span>
                    }
                </div>
                @if (Model.Issue.IsVerified)
                {
                    <p>Issued rows, document identity and the HQ PDF are protected from modification.</p>
                    <dl class="arpp-verification-meta arpp-verification-meta--inline">
                        @if (!string.IsNullOrWhiteSpace(Model.Issue.VerifiedByDisplayName) || !string.IsNullOrWhiteSpace(Model.Issue.VerifiedByUserId))
                        {
                            <div><dt>Verified by</dt><dd>@(Model.Issue.VerifiedByDisplayName ?? Model.Issue.VerifiedByUserId)</dd></div>
                        }
                        @if (Model.Issue.VerifiedAtUtc.HasValue)
                        {
                            <div><dt>Verified on</dt><dd>@Model.FormatIst(Model.Issue.VerifiedAtUtc.Value)</dd></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Issue.VerificationNote))
                        {
                            <div><dt>Note</dt><dd>@Model.Issue.VerificationNote</dd></div>
                        }
                    </dl>
                }
                else
                {
                    @if (isCorrection)
                    {
                        <p>
                            Published revision @Model.Issue.PublishedRevisionNumber remains visible to PRISM users
                            @if (Model.Issue.PublishedAtUtc.HasValue)
                            {
                                <text>from @Model.FormatIst(Model.Issue.PublishedAtUtc.Value)</text>
                            }
                            until this working copy is verified again.
                        </p>
                    }
                    else
                    {
                        <p>Check the structured rows against the issued HQ PDF before publishing this record for the first time.</p>
                    }
                    <ul class="arpp-readiness-strip" aria-label="Verification readiness">
                        <li class="@(Model.Issue.Entries.Count > 0 ? "is-ready" : "is-pending")">
                            <span class="bi @(Model.Issue.Entries.Count > 0 ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></span>
                            Rows recorded
                        </li>
                        <li class="@(Model.Issue.Attachment is not null ? "is-ready" : "is-pending")">
                            <span class="bi @(Model.Issue.Attachment is not null ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></span>
                            HQ PDF attached
                        </li>
                        <li class="@(Model.ReferenceDataReady ? "is-ready" : "is-pending")">
                            <span class="bi @(Model.ReferenceDataReady ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></span>
                            Reference values mapped
                        </li>
                    </ul>
                }
            </div>
        </div>
        <div class="arpp-document-state__action">
            @if (Model.Issue.IsVerified && Model.CanUnlock)
            {
                <button type="button"
                        class="btn btn-outline-warning btn-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#arppUnlockModal"
                        data-arpp-unlock-trigger>
                    <span class="bi bi-unlock" aria-hidden="true"></span> Unlock for correction
                </button>
            }
            else if (!Model.Issue.IsVerified && Model.CanVerify)
            {
                @if (Model.IsVerificationReady)
                {
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#arppVerifyModal">
                        <span class="bi bi-shield-check" aria-hidden="true"></span> Verify and publish
                    </button>
                }
                else
                {
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            disabled
                            aria-disabled="true"
                            title="Enter at least one row, attach the issued HQ PDF and resolve all CFA, Fund and DFPDS values before verification.">
                        <span class="bi bi-shield-check" aria-hidden="true"></span> Verify and publish
                    </button>
                }
            }
        </div>
    </section>

    <section class="arpp-kpis arpp-kpis--details" aria-label="Issue summary">
        <article class="arpp-kpi arpp-kpi--rows">
            <span>Rows</span>
            <strong>@Model.Issue.Entries.Count</strong>
            <small class="arpp-kpi__category-line">
                New @Model.Issue.CategorySummary[ArppCategory.New].Count ·
                CL @Model.Issue.CategorySummary[ArppCategory.CommittedLiability].Count ·
                CF @Model.Issue.CategorySummary[ArppCategory.CarryForward].Count ·
                Delisted @Model.Issue.CategorySummary[ArppCategory.Delisted].Count
            </small>
        </article>
        <article class="arpp-kpi arpp-kpi--approved">
            <span>@valueStateLabel approved value</span>
            <strong>@IndianCurrencyFormatter.FormatCompact(Model.ApprovedRowValue)</strong>
            <small>New, CL and CF</small>
        </article>
        <article class="arpp-kpi arpp-kpi--delisted">
            <span>@valueStateLabel delisted value</span>
            <strong>@IndianCurrencyFormatter.FormatCompact(Model.DelistedRowValue)</strong>
            <small>Recorded separately</small>
        </article>
        <article class="arpp-kpi">
            <span>Project linkage</span>
            <strong>@Model.Issue.LinkedCount linked</strong>
            <small>@Model.Issue.UnlinkedCount pending</small>
        </article>
    </section>

    @if (Model.Issue.UnlinkedCount > 0 && Model.CanManage)
    {
        <div class="arpp-reconcile-callout">
            <div><span class="bi bi-link-45deg" aria-hidden="true"></span><span><strong>@Model.Issue.UnlinkedCount @(Model.Issue.UnlinkedCount == 1 ? "row is" : "rows are") unlinked.</strong> Linking can continue after verification because it does not change the issued document.</span></div>
            <a asp-area="ProjectOfficeReports" asp-page="/ARPP/Reconcile" asp-route-fy="@Model.Issue.FinancialYearStart" class="btn btn-outline-primary btn-sm">Open reconciliation</a>
        </div>
    }

    @if (Model.Issue.Entries.Count == 0)
    {
        <section class="arpp-empty">
            <span class="bi bi-list-check" aria-hidden="true"></span>
            <h2>No issued rows entered</h2>
            <p>The document identity exists, but its structured rows have not yet been entered.</p>
            @if (Model.CanManage && !Model.Issue.IsVerified)
            {
                <a asp-area="ProjectOfficeReports" asp-page="/ARPP/Manage" asp-route-id="@Model.Issue.Id" class="btn btn-primary">Enter rows</a>
            }
        </section>
    }
    else
    {
        <section class="arpp-panel arpp-panel--entries arpp-details-rows">
            <div class="arpp-panel__heading">
                <div><h2>Issued rows</h2><p>Displayed in the order recorded from the HQ document.</p></div>
                @if (Model.CanManage && !Model.Issue.IsVerified)
                {
                    <a asp-area="ProjectOfficeReports" asp-page="/ARPP/Manage" asp-route-id="@Model.Issue.Id" class="btn btn-outline-primary btn-sm"><span class="bi bi-pencil-square" aria-hidden="true"></span> Edit rows</a>
                }
            </div>
            <div class="arpp-table-wrap arpp-table-wrap--details">
                <table class="table arpp-details-table align-middle">
                    <thead><tr><th>#</th><th>Serial</th><th>PPP No.</th><th>Project reference</th><th>Category</th><th class="text-end">IPA cost (₹)</th><th>CFA</th><th>Fund</th><th>DFPDS</th></tr></thead>
                    <tbody>
                        @foreach (var entry in Model.Issue.Entries)
                        {
                            <tr class="@(entry.Category == ArppCategory.Delisted ? "arpp-row--delisted" : string.Empty)">
                                <td class="text-body-secondary">@entry.SortOrder</td>
                                <td><span class="arpp-serial">@(entry.Category == ArppCategory.Delisted ? "—" : entry.SerialNumber)</span></td>
                                <td><span class="arpp-ppp">@(entry.Category == ArppCategory.Delisted ? "—" : entry.PppNumber)</span></td>
                                <td>
                                    <div class="arpp-project-reference">@entry.ProjectReference</div>
                                    @if (entry.ProjectId.HasValue)
                                    {
                                        <div class="arpp-linked-project">
                                            <span class="bi bi-link-45deg" aria-hidden="true"></span>
                                            <a asp-area="" asp-page="/Projects/Overview" asp-route-id="@entry.ProjectId" target="_blank" rel="noopener">@entry.ProjectName</a>
                                            @if (!string.IsNullOrWhiteSpace(entry.ProjectCaseFileNumber))
                                            {
                                                <span>@entry.ProjectCaseFileNumber</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(entry.ProjectStatus))
                                            {
                                                <span>PRISM status: @entry.ProjectStatus</span>
                                            }
                                            <a asp-area="ProjectOfficeReports" asp-page="/ARPP/ProjectHistory" asp-route-projectId="@entry.ProjectId" class="arpp-history-link">History</a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="arpp-unlinked"><span class="bi bi-exclamation-circle" aria-hidden="true"></span> PRISM linkage pending</div>
                                    }
                                </td>
                                <td><span class="arpp-badge arpp-badge--@(entry.Category.ToString().ToLowerInvariant())">@ArppDisplayNames.For(entry.Category)</span></td>
                                <td class="text-end text-nowrap fw-semibold" title="@IndianCurrencyFormatter.FormatRupees(entry.IpaCost)">@IndianCurrencyFormatter.FormatCompact(entry.IpaCost)</td>
                                <td>@entry.Cfa</td><td>@entry.Fund</td><td>@entry.DfpdsSchedule</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <section class="arpp-panel arpp-evidence-panel" aria-labelledby="arpp-issued-document-heading">
        <div class="arpp-panel__heading arpp-panel__heading--compact">
            <div><h2 id="arpp-issued-document-heading">Issued HQ PDF</h2><p>Evidentiary source for the structured record.</p></div>
            <span class="arpp-document-status @(Model.Issue.Attachment is null ? "arpp-document-status--pending" : string.Empty)">
                <span class="bi @(Model.Issue.Attachment is null ? "bi-exclamation-circle" : "bi-shield-check")" aria-hidden="true"></span>
                @(Model.Issue.Attachment is null ? "Pending" : "Attached")
            </span>
        </div>
        <div class="arpp-evidence-panel__body">
            @if (Model.Issue.Attachment is not null)
            {
                var attachment = Model.Issue.Attachment;
                <div class="arpp-document-file arpp-document-file--compact">
                    <div class="arpp-document-file__icon" aria-hidden="true"><span class="bi bi-file-earmark-pdf"></span></div>
                    <div class="arpp-document-file__identity">
                        <strong>@attachment.OriginalFileName</strong>
                        <span>@FileSizeFormatter.FormatFileSize(attachment.SizeBytes) · Uploaded @Model.FormatIst(attachment.UploadedAtUtc) · SHA-256 @(attachment.Sha256[..Math.Min(12, attachment.Sha256.Length)])…</span>
                    </div>
                    <div class="arpp-document-file__actions">
                        <a asp-area="ProjectOfficeReports" asp-page="/ARPP/Details" asp-page-handler="Attachment" asp-route-id="@Model.Issue.Id" class="btn btn-outline-primary btn-sm"><span class="bi bi-download" aria-hidden="true"></span> Download</a>
                    </div>
                </div>

                @if (Model.CanManage && !Model.Issue.IsVerified)
                {
                    <details class="arpp-document-management" data-arpp-document-management open="@(!ViewData.ModelState.IsValid ? "open" : null)">
                        <summary><span class="bi bi-gear" aria-hidden="true"></span> Manage issued PDF <span class="bi bi-chevron-down" aria-hidden="true"></span></summary>
                        <div class="arpp-document-management__body">
                            <form method="post" enctype="multipart/form-data" asp-area="ProjectOfficeReports" asp-page="/ARPP/Details" asp-page-handler="UploadPdf" asp-route-id="@Model.Issue.Id" class="arpp-document-upload arpp-document-upload--compact">
                                <div class="arpp-document-upload__field">
                                    <label asp-for="UploadFile" class="form-label">Replace issued PDF</label>
                                    <input asp-for="UploadFile" type="file" class="form-control form-control-sm" accept="application/pdf,.pdf" data-arpp-pdf-input />
                                    <span asp-validation-for="UploadFile" class="text-danger small"></span>
                                    <div class="form-text">PDF only · Maximum @Model.MaxAttachmentSizeLabel.</div>
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm" data-arpp-upload-button><span class="bi bi-cloud-arrow-up" aria-hidden="true"></span> Replace PDF</button>
                            </form>
                            <form method="post" asp-area="ProjectOfficeReports" asp-page="/ARPP/Details" asp-page-handler="DeletePdf" asp-route-id="@Model.Issue.Id" asp-route-attachmentId="@attachment.Id" data-arpp-delete-pdf-form class="arpp-document-remove">
                                <button type="submit" class="btn btn-outline-danger btn-sm"><span class="bi bi-trash3" aria-hidden="true"></span> Remove PDF</button>
                            </form>
                        </div>
                    </details>
                }
            }
            else
            {
                <div class="arpp-document-empty"><span class="bi bi-file-earmark-arrow-up" aria-hidden="true"></span><div><strong>No HQ PDF attached</strong><p>Attach the issued source document before verification.</p></div></div>
                @if (Model.CanManage && !Model.Issue.IsVerified)
                {
                    <form method="post" enctype="multipart/form-data" asp-area="ProjectOfficeReports" asp-page="/ARPP/Details" asp-page-handler="UploadPdf" asp-route-id="@Model.Issue.Id" class="arpp-document-upload">
                        <div class="arpp-document-upload__field">
                            <label asp-for="UploadFile" class="form-label">Attach issued PDF</label>
                            <input asp-for="UploadFile" type="file" class="form-control form-control-sm" accept="application/pdf,.pdf" data-arpp-pdf-input />
                            <span asp-validation-for="UploadFile" class="text-danger small"></span>
                            <div class="form-text">PDF only · Maximum @Model.MaxAttachmentSizeLabel.</div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm" data-arpp-upload-button><span class="bi bi-cloud-arrow-up" aria-hidden="true"></span> Attach PDF</button>
                    </form>
                }
            }
        </div>
    </section>

    <footer class="arpp-record-footer"><span>Created @Model.FormatIst(Model.Issue.CreatedAtUtc)</span><span>Last updated @Model.FormatIst(Model.Issue.UpdatedAtUtc)</span></footer>
</div>

@if (!Model.Issue.IsVerified && Model.CanVerify)
{
    <div class="modal fade" id="arppVerifyModal" tabindex="-1" aria-labelledby="arppVerifyModalLabel" aria-hidden="true" data-arpp-modal>
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="Verify" asp-route-id="@Model.Issue.Id">
                    <input type="hidden" name="issueRowVersion" value="@Model.Issue.RowVersion" />
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="arppVerifyModalLabel">Verify and publish issue</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p>Confirm that the structured rows have been checked against the attached HQ PDF. This working copy will become the published position and will be locked.</p>
                        <label asp-for="VerificationNote" class="form-label">Verification note <span class="text-body-secondary">optional</span></label>
                        <textarea asp-for="VerificationNote" class="form-control" rows="3" maxlength="500"></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary"><span class="bi bi-shield-check" aria-hidden="true"></span> Verify and publish</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (Model.Issue.IsVerified && Model.CanUnlock)
{
    <div class="modal fade" id="arppUnlockModal" tabindex="-1" aria-labelledby="arppUnlockModalLabel" aria-hidden="true" data-arpp-modal data-arpp-unlock-modal>
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="Unlock" asp-route-id="@Model.Issue.Id" data-arpp-unlock-form>
                    <input type="hidden" name="issueRowVersion" value="@Model.Issue.RowVersion" />
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="arppUnlockModalLabel">Unlock for correction</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning">Unlocking permits changes to an authoritative HQ record. The reason is mandatory and audited.</div>
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                        <label asp-for="UnlockInput.Reason" class="form-label">Reason for unlocking</label>
                        <textarea asp-for="UnlockInput.Reason"
                                  class="form-control"
                                  rows="4"
                                  minlength="10"
                                  maxlength="500"
                                  required
                                  aria-describedby="unlockReasonHelp"
                                  data-arpp-unlock-reason></textarea>
                        <div class="arpp-unlock-reason-meta" id="unlockReasonHelp">
                            <span>Describe the correction required. Example: Add newly received project row under Serial No. 48.</span>
                            <strong data-arpp-unlock-counter>0/10 minimum</strong>
                        </div>
                        <span asp-validation-for="UnlockInput.Reason" class="text-danger small" data-arpp-unlock-validation></span>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning" data-arpp-unlock-submit disabled aria-disabled="true">
                            <span class="bi bi-unlock" aria-hidden="true"></span> <span data-arpp-unlock-submit-label>Unlock record</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<partial name="~/Pages/Shared/_PrismConfirmDialog.cshtml" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/components/prism-confirm-dialog.js" asp-append-version="true" defer></script>
    <script src="~/js/pages/project-office-reports/arpp/arpp-details.js" asp-append-version="true" defer></script>
}
