@page
@using ProjectManagement.Helpers
@using ProjectManagement.Models.Arpp
@using ProjectManagement.Utilities
@model ProjectManagement.Areas.ProjectOfficeReports.Pages.ARPP.DetailsModel
@{
    ViewData["Title"] = Model.Issue.Name;
    ViewData["PageShell"] = "wide";
    ViewData["ArppSection"] = "administration";
    ViewData["CanManageArpp"] = Model.CanManage;

    var issueTypeLabel = Model.Issue.Kind == ArppIssueKind.Original
        ? "Original ARPP"
        : $"Addendum No. {Model.Issue.IssueSequence}";
    var isCorrection = !Model.Issue.IsVerified && Model.Issue.HasPublishedSnapshot;
    var valueStateLabel = Model.Issue.IsVerified ? "Published" : "Working";
    var statusLabel = Model.Issue.IsVerified
        ? "Verified and published"
        : isCorrection
            ? "Unlocked for correction"
            : Model.IsVerificationReady
                ? "Ready for verification"
                : "Working copy";
    var statusClass = Model.Issue.IsVerified ? "is-published" : isCorrection ? "is-correction" : "is-pending";
}

@section Styles {
    <link rel="stylesheet" href="~/css/project-office-reports/arpp.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/project-office-reports/arpp-redesign.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/prism-confirm-dialog.css" asp-append-version="true" />
}

<div class="container-fluid px-3 px-lg-4 py-2 arpp-record-v2"
     data-arpp-details
     data-arpp-reopen-unlock-modal="@(Model.ReopenUnlockModal ? "true" : "false")">
    <partial name="_ModuleNav" />

    <header class="arpp-record-v2__header">
        <div>
            <span class="arpp-v2-page-header__eyebrow">@issueTypeLabel · FY @FinancialYearHelper.Format(Model.Issue.FinancialYearStart)</span>
            <h1>@Model.Issue.Name</h1>
            <p>Issued @Model.Issue.IssueDate.ToString("dd MMM yyyy") · @Model.Issue.Entries.Count @(Model.Issue.Entries.Count == 1 ? "row" : "rows")</p>
        </div>
        <div class="arpp-record-v2__header-actions">
            @if (Model.CanManage && !Model.Issue.IsVerified)
            {
                <a asp-area="ProjectOfficeReports" asp-page="/ARPP/Manage" asp-route-id="@Model.Issue.Id" class="btn btn-primary btn-sm">
                    <span class="bi bi-pencil-square" aria-hidden="true"></span> Edit working copy
                </a>
            }
            <a asp-area="ProjectOfficeReports" asp-page="/ARPP/Details" asp-page-handler="Excel" asp-route-id="@Model.Issue.Id" class="btn btn-outline-success btn-sm">
                <span class="bi bi-file-earmark-excel" aria-hidden="true"></span> Excel
            </a>
            <a asp-area="ProjectOfficeReports" asp-page="/ARPP/Print" asp-route-id="@Model.Issue.Id" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">
                <span class="bi bi-printer" aria-hidden="true"></span> Print / PDF
            </a>
            <a asp-area="ProjectOfficeReports" asp-page="/ARPP/Index" class="btn btn-outline-secondary btn-sm">
                <span class="bi bi-arrow-left" aria-hidden="true"></span> Register
            </a>
        </div>
    </header>

    <partial name="~/Areas/ProjectOfficeReports/Pages/Shared/_StatusMessage.cshtml" />
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger arpp-alert" role="alert"><span class="bi bi-exclamation-octagon" aria-hidden="true"></span><span>@errorMessage</span></div>
    }
    @if (TempData["ArppWarningMessage"] is string warningMessage)
    {
        <div class="alert alert-warning arpp-alert" role="alert"><span class="bi bi-exclamation-triangle" aria-hidden="true"></span><span>@warningMessage</span></div>
    }

    <section class="arpp-record-v2__state @statusClass" aria-label="Document state">
        <div class="arpp-record-v2__state-copy">
            <span class="bi @(Model.Issue.IsVerified ? "bi-shield-check" : isCorrection ? "bi-pencil-square" : "bi-clock-history")" aria-hidden="true"></span>
            <div>
                <strong>@statusLabel</strong>
                @if (Model.Issue.IsVerified)
                {
                    <p>This verified record is the published document position and is protected from editing.</p>
                }
                else if (isCorrection)
                {
                    <p>Published revision @Model.Issue.PublishedRevisionNumber remains visible to PRISM users until this working copy is verified again.</p>
                }
                else
                {
                    <p>Complete the issued rows, attach the HQ PDF and map controlled values before publication.</p>
                }
                @if (!Model.Issue.IsVerified)
                {
                    <ul class="arpp-record-v2__readiness" aria-label="Verification readiness">
                        <li class="@(Model.Issue.Entries.Count > 0 ? "is-ready" : "is-pending")"><span class="bi @(Model.Issue.Entries.Count > 0 ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></span> Rows recorded</li>
                        <li class="@(Model.Issue.Attachment is not null ? "is-ready" : "is-pending")"><span class="bi @(Model.Issue.Attachment is not null ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></span> HQ PDF attached</li>
                        <li class="@(Model.ReferenceDataReady ? "is-ready" : "is-pending")"><span class="bi @(Model.ReferenceDataReady ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></span> Reference values mapped</li>
                    </ul>
                }
            </div>
        </div>
        <div>
            @if (Model.Issue.IsVerified && Model.CanUnlock)
            {
                <button type="button" class="btn btn-outline-warning btn-sm" data-bs-toggle="modal" data-bs-target="#arppUnlockModal" data-arpp-unlock-trigger>
                    <span class="bi bi-unlock" aria-hidden="true"></span> Unlock for correction
                </button>
            }
            else if (!Model.Issue.IsVerified && Model.CanVerify)
            {
                @if (Model.IsVerificationReady)
                {
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#arppVerifyModal">
                        <span class="bi bi-shield-check" aria-hidden="true"></span> Verify and publish
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-primary btn-sm" disabled aria-disabled="true" title="Complete all verification prerequisites first.">
                        <span class="bi bi-shield-check" aria-hidden="true"></span> Verify and publish
                    </button>
                }
            }
        </div>
    </section>

    <nav class="nav arpp-record-v2__tabs" role="tablist" aria-label="Record sections">
        <button class="nav-link active" id="arpp-overview-tab" data-bs-toggle="tab" data-bs-target="#arpp-overview" type="button" role="tab" aria-controls="arpp-overview" aria-selected="true"><span class="bi bi-grid" aria-hidden="true"></span> Overview</button>
        <button class="nav-link" id="arpp-rows-tab" data-bs-toggle="tab" data-bs-target="#arpp-rows" type="button" role="tab" aria-controls="arpp-rows" aria-selected="false"><span class="bi bi-table" aria-hidden="true"></span> Issued rows <span class="badge text-bg-light">@Model.Issue.Entries.Count</span></button>
        <button class="nav-link" id="arpp-document-tab" data-bs-toggle="tab" data-bs-target="#arpp-document" type="button" role="tab" aria-controls="arpp-document" aria-selected="false"><span class="bi bi-file-earmark-pdf" aria-hidden="true"></span> HQ document</button>
        <button class="nav-link" id="arpp-audit-tab" data-bs-toggle="tab" data-bs-target="#arpp-audit" type="button" role="tab" aria-controls="arpp-audit" aria-selected="false"><span class="bi bi-clock-history" aria-hidden="true"></span> Audit</button>
    </nav>

    <div class="tab-content">
        <section class="tab-pane fade show active arpp-record-v2__panel" id="arpp-overview" role="tabpanel" aria-labelledby="arpp-overview-tab" tabindex="0">
            <div class="arpp-record-v2__panel-header"><div><h2>Document overview</h2><p>Working values, publication readiness and linkage at a glance.</p></div></div>
            <div class="arpp-record-v2__panel-body">
                <div class="arpp-record-v2__overview-grid">
                    <article class="arpp-record-v2__metric"><span>Rows</span><strong>@Model.Issue.Entries.Count</strong><small>New @Model.Issue.CategorySummary[ArppCategory.New].Count · CL @Model.Issue.CategorySummary[ArppCategory.CommittedLiability].Count · CF @Model.Issue.CategorySummary[ArppCategory.CarryForward].Count · Delisted @Model.Issue.CategorySummary[ArppCategory.Delisted].Count</small></article>
                    <article class="arpp-record-v2__metric arpp-record-v2__metric--approved"><span>@valueStateLabel approved value</span><strong>@IndianCurrencyFormatter.FormatCompact(Model.ApprovedRowValue)</strong><small>New, CL and CF</small></article>
                    <article class="arpp-record-v2__metric arpp-record-v2__metric--delisted"><span>@valueStateLabel delisted value</span><strong>@IndianCurrencyFormatter.FormatCompact(Model.DelistedRowValue)</strong><small>Recorded separately</small></article>
                    <article class="arpp-record-v2__metric"><span>Project linkage</span><strong>@Model.Issue.LinkedCount / @Model.Issue.Entries.Count</strong><small>@Model.Issue.UnlinkedCount pending</small></article>
                </div>

                <section class="arpp-record-v2__overview-section">
                    <h3>Document identity</h3>
                    <dl>
                        <div><dt>Financial year</dt><dd>@FinancialYearHelper.Format(Model.Issue.FinancialYearStart)</dd></div>
                        <div><dt>Issue type</dt><dd>@issueTypeLabel</dd></div>
                        <div><dt>Issue date</dt><dd>@Model.Issue.IssueDate.ToString("dd MMM yyyy")</dd></div>
                    </dl>
                </section>

                @if (Model.Issue.UnlinkedCount > 0 && Model.CanManage)
                {
                    <section class="arpp-record-v2__overview-section">
                        <h3>Reconciliation</h3>
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <p class="mb-0 small text-body-secondary"><strong>@Model.Issue.UnlinkedCount @(Model.Issue.UnlinkedCount == 1 ? "row is" : "rows are") not linked</strong> to a PRISM project. Linking may continue after publication.</p>
                            <a asp-area="ProjectOfficeReports" asp-page="/ARPP/Reconcile" asp-route-fy="@Model.Issue.FinancialYearStart" class="btn btn-outline-primary btn-sm">Open reconciliation</a>
                        </div>
                    </section>
                }
            </div>
        </section>

        <section class="tab-pane fade arpp-record-v2__panel" id="arpp-rows" role="tabpanel" aria-labelledby="arpp-rows-tab" tabindex="0">
            <div class="arpp-record-v2__panel-header"><div><h2>Issued rows</h2><p>Wording and order are preserved from the HQ document.</p></div></div>
            @if (Model.Issue.Entries.Count == 0)
            {
                <div class="arpp-record-v2__panel-body text-center py-5">
                    <span class="bi bi-table fs-2 text-primary" aria-hidden="true"></span>
                    <h3 class="fs-6 mt-2">No issued rows entered</h3>
                    <p class="small text-body-secondary">Open the working copy to enter or paste rows.</p>
                </div>
            }
            else
            {
                <div class="arpp-v2-table-wrap">
                    <table class="table arpp-v2-table align-middle">
                        <colgroup><col style="width:3%" /><col style="width:6%" /><col style="width:10%" /><col style="width:39%" /><col style="width:8%" /><col style="width:10%" /><col style="width:10%" /><col style="width:7%" /><col style="width:7%" /></colgroup>
                        <thead><tr><th>#</th><th>Serial</th><th>PPP No.</th><th>Project reference</th><th>Category</th><th class="text-end">IPA cost (₹)</th><th>CFA</th><th>Fund</th><th>DFPDS</th></tr></thead>
                        <tbody>
                            @foreach (var entry in Model.Issue.Entries)
                            {
                                var issuedName = entry.ProjectReference?.Trim() ?? string.Empty;
                                var linkedName = entry.ProjectName?.Trim() ?? string.Empty;
                                var sameProjectName = entry.ProjectId.HasValue && !string.IsNullOrWhiteSpace(linkedName) && string.Equals(issuedName, linkedName, StringComparison.OrdinalIgnoreCase);
                                <tr class="@(entry.Category == ArppCategory.Delisted ? "arpp-row--delisted" : string.Empty)">
                                    <td data-label="#" class="text-body-secondary">@entry.SortOrder</td>
                                    <td data-label="Serial"><span class="arpp-serial">@(entry.Category == ArppCategory.Delisted ? "—" : entry.SerialNumber)</span></td>
                                    <td data-label="PPP No."><span class="arpp-ppp">@(entry.Category == ArppCategory.Delisted ? "—" : entry.PppNumber)</span></td>
                                    <td data-label="Project" class="arpp-v2-project-cell">
                                        @if (sameProjectName)
                                        {
                                            <div class="arpp-v2-project-cell__title"><a asp-area="" asp-page="/Projects/Overview" asp-route-id="@entry.ProjectId" target="_blank" rel="noopener">@issuedName<span class="bi bi-box-arrow-up-right arpp-v2-external-link" aria-hidden="true"></span></a></div>
                                        }
                                        else if (entry.ProjectId.HasValue)
                                        {
                                            <div class="arpp-v2-project-cell__issued"><strong>Issued</strong> @issuedName</div>
                                            <div class="arpp-v2-project-cell__linked"><strong>Linked</strong> <a asp-area="" asp-page="/Projects/Overview" asp-route-id="@entry.ProjectId" target="_blank" rel="noopener">@linkedName<span class="bi bi-box-arrow-up-right arpp-v2-external-link" aria-hidden="true"></span></a></div>
                                        }
                                        else
                                        {
                                            <div class="arpp-v2-project-cell__title">@issuedName</div>
                                        }
                                        <div class="arpp-v2-project-cell__meta">
                                            @if (!string.IsNullOrWhiteSpace(entry.ProjectStatus)) { <span>@entry.ProjectStatus</span> }
                                            @if (entry.ProjectId.HasValue) { <a asp-area="ProjectOfficeReports" asp-page="/ARPP/ProjectHistory" asp-route-projectId="@entry.ProjectId">History</a> }
                                            else { <span class="text-warning-emphasis"><span class="bi bi-exclamation-circle" aria-hidden="true"></span> Linkage pending</span> }
                                        </div>
                                    </td>
                                    <td data-label="Category"><span class="arpp-badge arpp-badge--@(entry.Category.ToString().ToLowerInvariant())">@ArppDisplayNames.For(entry.Category)</span></td>
                                    <td data-label="IPA cost" class="text-end text-nowrap fw-semibold" title="@IndianCurrencyFormatter.FormatRupees(entry.IpaCost)">@IndianCurrencyFormatter.FormatCompact(entry.IpaCost)</td>
                                    <td data-label="CFA">@entry.Cfa</td>
                                    <td data-label="Fund">@entry.Fund</td>
                                    <td data-label="DFPDS">@entry.DfpdsSchedule</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="tab-pane fade arpp-record-v2__panel" id="arpp-document" role="tabpanel" aria-labelledby="arpp-document-tab" tabindex="0">
            <div class="arpp-record-v2__panel-header"><div><h2>Issued HQ document</h2><p>Evidentiary source for the structured record.</p></div></div>
            <div class="arpp-record-v2__panel-body">
                @if (Model.Issue.Attachment is not null)
                {
                    var attachment = Model.Issue.Attachment;
                    <div class="arpp-v2-file">
                        <div class="arpp-v2-file__icon" aria-hidden="true"><span class="bi bi-file-earmark-pdf"></span></div>
                        <div class="arpp-v2-file__identity"><strong>@attachment.OriginalFileName</strong><span>@FileSizeFormatter.FormatFileSize(attachment.SizeBytes) · Uploaded @Model.FormatIst(attachment.UploadedAtUtc) · SHA-256 @(attachment.Sha256[..Math.Min(12, attachment.Sha256.Length)])…</span></div>
                        <div class="d-flex gap-2"><a asp-area="ProjectOfficeReports" asp-page="/ARPP/Details" asp-page-handler="Attachment" asp-route-id="@Model.Issue.Id" target="_blank" class="btn btn-outline-primary btn-sm"><span class="bi bi-box-arrow-up-right" aria-hidden="true"></span> Open</a><a asp-area="ProjectOfficeReports" asp-page="/ARPP/Details" asp-page-handler="Attachment" asp-route-id="@Model.Issue.Id" class="btn btn-outline-secondary btn-sm"><span class="bi bi-download" aria-hidden="true"></span> Download</a></div>
                    </div>
                    @if (Model.CanManage && !Model.Issue.IsVerified)
                    {
                        <details class="arpp-document-management mt-3" data-arpp-document-management open="@(!ViewData.ModelState.IsValid ? "open" : null)">
                            <summary><span class="bi bi-gear" aria-hidden="true"></span> Manage document <span class="bi bi-chevron-down" aria-hidden="true"></span></summary>
                            <div class="arpp-document-management__body">
                                <form method="post" enctype="multipart/form-data" asp-area="ProjectOfficeReports" asp-page="/ARPP/Details" asp-page-handler="UploadPdf" asp-route-id="@Model.Issue.Id" class="arpp-document-upload arpp-document-upload--compact">
                                    <div class="arpp-document-upload__field"><label asp-for="UploadFile" class="form-label">Replace issued PDF</label><input asp-for="UploadFile" type="file" class="form-control form-control-sm" accept="application/pdf,.pdf" data-arpp-pdf-input /><span asp-validation-for="UploadFile" class="text-danger small"></span><div class="form-text">PDF only · Maximum @Model.MaxAttachmentSizeLabel.</div></div>
                                    <button type="submit" class="btn btn-primary btn-sm" data-arpp-upload-button><span class="bi bi-cloud-arrow-up" aria-hidden="true"></span> Replace PDF</button>
                                </form>
                                <form method="post" asp-area="ProjectOfficeReports" asp-page="/ARPP/Details" asp-page-handler="DeletePdf" asp-route-id="@Model.Issue.Id" asp-route-attachmentId="@attachment.Id" data-arpp-delete-pdf-form><button type="submit" class="btn btn-outline-danger btn-sm"><span class="bi bi-trash3" aria-hidden="true"></span> Remove PDF</button></form>
                            </div>
                        </details>
                    }
                }
                else
                {
                    <div class="text-center py-4"><span class="bi bi-file-earmark-arrow-up fs-2 text-warning" aria-hidden="true"></span><h3 class="fs-6 mt-2">No HQ PDF attached</h3><p class="small text-body-secondary">Attach the issued source document before verification.</p></div>
                    @if (Model.CanManage && !Model.Issue.IsVerified)
                    {
                        <form method="post" enctype="multipart/form-data" asp-area="ProjectOfficeReports" asp-page="/ARPP/Details" asp-page-handler="UploadPdf" asp-route-id="@Model.Issue.Id" class="arpp-document-upload">
                            <div class="arpp-document-upload__field"><label asp-for="UploadFile" class="form-label">Attach issued PDF</label><input asp-for="UploadFile" type="file" class="form-control form-control-sm" accept="application/pdf,.pdf" data-arpp-pdf-input /><span asp-validation-for="UploadFile" class="text-danger small"></span><div class="form-text">PDF only · Maximum @Model.MaxAttachmentSizeLabel.</div></div>
                            <button type="submit" class="btn btn-primary btn-sm" data-arpp-upload-button><span class="bi bi-cloud-arrow-up" aria-hidden="true"></span> Attach PDF</button>
                        </form>
                    }
                }
            </div>
        </section>

        <section class="tab-pane fade arpp-record-v2__panel" id="arpp-audit" role="tabpanel" aria-labelledby="arpp-audit-tab" tabindex="0">
            <div class="arpp-record-v2__panel-header"><div><h2>Audit and publication</h2><p>Record provenance and current publication information.</p></div></div>
            <div class="arpp-record-v2__panel-body arpp-v2-audit">
                <section class="arpp-v2-audit__group"><h3>Record history</h3><dl><div><dt>Created</dt><dd>@Model.FormatIst(Model.Issue.CreatedAtUtc)</dd></div><div><dt>Last updated</dt><dd>@Model.FormatIst(Model.Issue.UpdatedAtUtc)</dd></div><div><dt>Current state</dt><dd>@statusLabel</dd></div></dl></section>
                <section class="arpp-v2-audit__group"><h3>Publication</h3><dl><div><dt>Revision</dt><dd>@(Model.Issue.PublishedRevisionNumber.HasValue ? $"Revision {Model.Issue.PublishedRevisionNumber}" : "Not published")</dd></div>@if (Model.Issue.VerifiedAtUtc.HasValue) { <div><dt>Verified on</dt><dd>@Model.FormatIst(Model.Issue.VerifiedAtUtc.Value)</dd></div> }@if (!string.IsNullOrWhiteSpace(Model.Issue.VerifiedByDisplayName) || !string.IsNullOrWhiteSpace(Model.Issue.VerifiedByUserId)) { <div><dt>Verified by</dt><dd>@(Model.Issue.VerifiedByDisplayName ?? Model.Issue.VerifiedByUserId)</dd></div> }@if (!string.IsNullOrWhiteSpace(Model.Issue.VerificationNote)) { <div><dt>Verification note</dt><dd>@Model.Issue.VerificationNote</dd></div> }</dl></section>
            </div>
        </section>
    </div>
</div>

@if (!Model.Issue.IsVerified && Model.CanVerify)
{
    <div class="modal fade" id="arppVerifyModal" tabindex="-1" aria-labelledby="arppVerifyModalLabel" aria-hidden="true" data-arpp-modal>
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="Verify" asp-route-id="@Model.Issue.Id">
                    <input type="hidden" name="issueRowVersion" value="@Model.Issue.RowVersion" />
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="arppVerifyModalLabel">Verify and publish issue</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p>Confirm that the structured rows have been checked against the attached HQ PDF. This working copy will become the published position and will be locked.</p>
                        <label asp-for="VerificationNote" class="form-label">Verification note <span class="text-body-secondary">optional</span></label>
                        <textarea asp-for="VerificationNote" class="form-control" rows="3" maxlength="500"></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary"><span class="bi bi-shield-check" aria-hidden="true"></span> Verify and publish</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (Model.Issue.IsVerified && Model.CanUnlock)
{
    <div class="modal fade" id="arppUnlockModal" tabindex="-1" aria-labelledby="arppUnlockModalLabel" aria-hidden="true" data-arpp-modal data-arpp-unlock-modal>
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="Unlock" asp-route-id="@Model.Issue.Id" data-arpp-unlock-form>
                    <input type="hidden" name="issueRowVersion" value="@Model.Issue.RowVersion" />
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="arppUnlockModalLabel">Unlock for correction</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning">Unlocking permits changes to an authoritative HQ record. The reason is mandatory and audited.</div>
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                        <label asp-for="UnlockInput.Reason" class="form-label">Reason for unlocking</label>
                        <textarea asp-for="UnlockInput.Reason"
                                  class="form-control"
                                  rows="4"
                                  minlength="10"
                                  maxlength="500"
                                  required
                                  aria-describedby="unlockReasonHelp"
                                  data-arpp-unlock-reason></textarea>
                        <div class="arpp-unlock-reason-meta" id="unlockReasonHelp">
                            <span>Describe the correction required. Example: Add newly received project row under Serial No. 48.</span>
                            <strong data-arpp-unlock-counter>0/10 minimum</strong>
                        </div>
                        <span asp-validation-for="UnlockInput.Reason" class="text-danger small" data-arpp-unlock-validation></span>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning" data-arpp-unlock-submit disabled aria-disabled="true">
                            <span class="bi bi-unlock" aria-hidden="true"></span> <span data-arpp-unlock-submit-label>Unlock record</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<partial name="~/Pages/Shared/_PrismConfirmDialog.cshtml" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/components/prism-confirm-dialog.js" asp-append-version="true" defer></script>
    <script src="~/js/pages/project-office-reports/arpp/arpp-details.js" asp-append-version="true" defer></script>
}
