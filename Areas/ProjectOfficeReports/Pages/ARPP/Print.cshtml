@page
@using ProjectManagement.Helpers
@using ProjectManagement.Infrastructure
@using ProjectManagement.Models.Arpp
@using ProjectManagement.Utilities
@model ProjectManagement.Areas.ProjectOfficeReports.Pages.ARPP.PrintModel
@{
    Layout = null;
    var financialYear = FinancialYearHelper.Format(Model.Issue.FinancialYearStart);
    var issueTypeLabel = Model.Issue.Kind == ArppIssueKind.Original
        ? "Original ARPP"
        : $"Addendum No. {Model.Issue.IssueSequence}";
    var approvedRowValue =
        Model.Issue.CategorySummary[ArppCategory.New].TotalIpaCost +
        Model.Issue.CategorySummary[ArppCategory.CommittedLiability].TotalIpaCost +
        Model.Issue.CategorySummary[ArppCategory.CarryForward].TotalIpaCost;
    var delistedRowValue = Model.Issue.CategorySummary[ArppCategory.Delisted].TotalIpaCost;
    var referenceDataReady = Model.Issue.Entries.All(entry => !entry.HasUnresolvedReferenceData);
    var setupIncomplete = Model.Issue.Entries.Count == 0 || Model.Issue.Attachment is null;

    string FormatPrintCurrency(decimal amount)
    {
        const decimal crore = 10_000_000m;
        const decimal lakh = 100_000m;

        if (Math.Abs(amount) >= crore)
        {
            return $"₹{amount / crore:N2} Cr";
        }

        if (Math.Abs(amount) >= lakh)
        {
            return $"₹{amount / lakh:N2} Lakh";
        }

        return $"₹{amount:N0}";
    }

    string CategoryShortLabel(ArppCategory category) => category switch
    {
        ArppCategory.New => "New",
        ArppCategory.CommittedLiability => "CL",
        ArppCategory.CarryForward => "CF",
        ArppCategory.Delisted => "Delisted",
        _ => ArppDisplayNames.For(category)
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Issue.Name · @financialYear</title>
    <link rel="stylesheet" href="~/css/project-office-reports/arpp-print.css" asp-append-version="true" />
</head>
<body>
    <div class="arpp-print-toolbar" role="toolbar" aria-label="Print controls">
        <button type="button" onclick="window.print()">Print / Save PDF</button>
        <button type="button" onclick="window.close()">Close</button>
    </div>

    <main class="arpp-print-document">
        <header class="arpp-print-header">
            <div class="arpp-print-marking">PRISM ERP · Simulator Development Division</div>
            <h1>@Model.Issue.Name</h1>
            <p>
                ARPP / PPP · Financial Year @financialYear · @issueTypeLabel
                · Issued @Model.Issue.IssueDate.ToString("dd MMM yyyy")
            </p>
        </header>

        <section class="arpp-print-summary" aria-label="Issue summary">
            <div class="arpp-print-summary__metric">
                <span>Rows</span>
                <strong>@Model.Issue.Entries.Count</strong>
                <small>Issued document rows</small>
            </div>
            <div class="arpp-print-summary__metric arpp-print-summary__metric--approved">
                <span>Approved row value</span>
                <strong>@FormatPrintCurrency(approvedRowValue)</strong>
                <small>New, CL and CF</small>
            </div>
            <div class="arpp-print-summary__metric arpp-print-summary__metric--delisted">
                <span>Delisted row value</span>
                <strong>@FormatPrintCurrency(delistedRowValue)</strong>
                <small>Recorded separately</small>
            </div>
            <div class="arpp-print-summary__metric">
                <span>Project linkage</span>
                <strong>@Model.Issue.LinkedCount / @Model.Issue.Entries.Count</strong>
                <small>@Model.Issue.UnlinkedCount pending</small>
            </div>

            <div class="arpp-print-summary__categories" aria-label="Category breakdown">
                @foreach (var category in Enum.GetValues<ArppCategory>())
                {
                    var summary = Model.Issue.CategorySummary[category];
                    <div>
                        <span>@CategoryShortLabel(category)</span>
                        <strong>@summary.Count</strong>
                        <small>@FormatPrintCurrency(summary.TotalIpaCost)</small>
                    </div>
                }
            </div>
        </section>

        <section class="arpp-print-source" aria-label="Record and source status">
            @if (Model.Issue.IsVerified)
            {
                <div class="arpp-print-source__line">
                    <strong>Record status:</strong>
                    <span>Verified and published</span>
                    @if (Model.Issue.VerifiedAtUtc.HasValue)
                    {
                        <span> · @IstClock.ToIst(Model.Issue.VerifiedAtUtc.Value).ToString("dd MMM yyyy, hh:mm tt") IST</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Issue.VerifiedByDisplayName))
                    {
                        <span> · By @Model.Issue.VerifiedByDisplayName</span>
                    }
                </div>
            }
            else if (Model.Issue.HasPublishedSnapshot)
            {
                <div class="arpp-print-source__line">
                    <strong>Working-copy status:</strong>
                    <span>Unlocked for correction</span>
                </div>
                <div class="arpp-print-source__line">
                    <strong>Published position:</strong>
                    <span>Revision @(Model.Issue.PublishedRevisionNumber?.ToString() ?? "1") remains active</span>
                    @if (Model.Issue.PublishedAtUtc.HasValue)
                    {
                        <span> · Published @IstClock.ToIst(Model.Issue.PublishedAtUtc.Value).ToString("dd MMM yyyy, hh:mm tt") IST</span>
                    }
                </div>
            }
            else
            {
                <div class="arpp-print-source__line">
                    <strong>Working-copy status:</strong>
                    <span>@(setupIncomplete ? "Setup incomplete" : !referenceDataReady ? "Reference review required" : "Ready for verification")</span>
                </div>
            }

            <div class="arpp-print-source__line">
                <strong>Issued source PDF:</strong>
                @if (Model.Issue.Attachment is null)
                {
                    <span>Not attached in PRISM</span>
                }
                else
                {
                    <span>
                        @Model.Issue.Attachment.OriginalFileName · @FileSizeFormatter.FormatFileSize(Model.Issue.Attachment.SizeBytes)
                        · SHA-256 @(Model.Issue.Attachment.Sha256[..Math.Min(12, Model.Issue.Attachment.Sha256.Length)])…
                    </span>
                }
            </div>
        </section>

        <table class="arpp-print-table">
            <colgroup>
                <col class="arpp-print-col--number" />
                <col class="arpp-print-col--serial" />
                <col class="arpp-print-col--ppp" />
                <col class="arpp-print-col--project" />
                <col class="arpp-print-col--category" />
                <col class="arpp-print-col--cost" />
                <col class="arpp-print-col--cfa" />
                <col class="arpp-print-col--fund" />
                <col class="arpp-print-col--dfpds" />
            </colgroup>
            <thead>
                <tr>
                    <th class="number">#</th>
                    <th>Serial</th>
                    <th>PPP No.</th>
                    <th>Project reference</th>
                    <th>Category</th>
                    <th class="money">IPA cost (₹)</th>
                    <th>CFA</th>
                    <th>Fund</th>
                    <th>DFPDS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Issue.Entries.OrderBy(entry => entry.SortOrder).ThenBy(entry => entry.Id))
                {
                    var issuedName = entry.ProjectReference?.Trim() ?? string.Empty;
                    var linkedName = entry.ProjectName?.Trim() ?? string.Empty;
                    var sameProjectName = entry.ProjectId.HasValue &&
                        !string.IsNullOrWhiteSpace(linkedName) &&
                        string.Equals(issuedName, linkedName, StringComparison.OrdinalIgnoreCase);

                    <tr class="@(entry.Category == ArppCategory.Delisted ? "delisted" : string.Empty)">
                        <td class="number">@entry.SortOrder</td>
                        <td>@(entry.Category == ArppCategory.Delisted ? "—" : entry.SerialNumber)</td>
                        <td>@(entry.Category == ArppCategory.Delisted ? "—" : entry.PppNumber)</td>
                        <td class="arpp-print-project">
                            <strong>@issuedName</strong>
                            @if (entry.ProjectId.HasValue && !sameProjectName)
                            {
                                <small><b>Linked:</b> @linkedName</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(entry.ProjectCaseFileNumber))
                            {
                                <small>@entry.ProjectCaseFileNumber</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(entry.ProjectStatus))
                            {
                                <small>PRISM status: @entry.ProjectStatus</small>
                            }
                            else if (!entry.ProjectId.HasValue)
                            {
                                <small class="muted">PRISM linkage pending</small>
                            }
                        </td>
                        <td>@CategoryShortLabel(entry.Category)</td>
                        <td class="money">@FormatPrintCurrency(entry.IpaCost).TrimStart('₹')</td>
                        <td>@entry.Cfa</td>
                        <td>@entry.Fund</td>
                        <td>@entry.DfpdsSchedule</td>
                    </tr>
                }
            </tbody>
        </table>

        <footer class="arpp-print-footer">
            <span>Generated from PRISM on @Model.GeneratedAtIst.ToString("dd MMM yyyy, HH:mm") IST</span>
            <span>Structured representation of the issued HQ document</span>
        </footer>
    </main>
</body>
</html>
