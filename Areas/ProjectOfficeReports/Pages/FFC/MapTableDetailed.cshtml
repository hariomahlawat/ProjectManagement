@page
@using System.Globalization
@using ProjectManagement.Areas.ProjectOfficeReports.Pages.FFC
@model ProjectManagement.Areas.ProjectOfficeReports.Pages.FFC.MapTableDetailedModel
@{
    ViewData["Title"] = FfcViewHeader.PageTitle(FfcView.DetailedTable);
    ViewData["UseFullWidth"] = true;
    var summary = Model.Summary;
    static string Share(int part, int total) => total == 0
        ? "0%"
        : (part * 100d / total).ToString("0.###", CultureInfo.InvariantCulture) + "%";
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/project-office-reports/ffc-views.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/project-office-reports/ffc-detailed-table.css"
          asp-append-version="true" />
}

@section PrintStyles
{
    <link rel="stylesheet"
          href="~/css/project-office-reports/ffc-detailed-table.print.css"
          asp-append-version="true"
          media="print" />
}

<div class="ffc-detailed-page"
     data-open-word-export-modal="@Model.ShowWordExportModal.ToString().ToLowerInvariant()">
    @{
        var header = new FfcViewHeader(
            FfcView.DetailedTable,
            "Project-wise position with current progress and the overall status of each country-year.",
            Model.Year,
            Model.CountryId)
        {
            Actions = @<text>
                <div class="dropdown">
                    <button class="btn btn-primary btn-sm dropdown-toggle ffc-export-menu__trigger"
                            type="button"
                            id="ffcExportMenu"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <i class="bi bi-download" aria-hidden="true"></i>
                        <span>Export</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="ffcExportMenu">
                        <li>
                            <button class="dropdown-item d-flex align-items-start gap-2"
                                    type="button"
                                    data-bs-toggle="modal"
                                    data-bs-target="#ffcWordExportModal">
                                <i class="bi bi-file-earmark-word mt-1" aria-hidden="true"></i>
                                <span>
                                    <span class="d-block fw-semibold">Export to Word</span>
                                    <span class="d-block small text-muted">Editable, formatted report</span>
                                </span>
                            </button>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <a asp-page="./MapTableDetailed"
                               asp-page-handler="ExportExcel"
                               asp-route-countryId="@Model.CountryId"
                               asp-route-countryIso3="@Model.CountryIso3"
                               asp-route-year="@Model.Year"
                               class="dropdown-item d-flex align-items-start gap-2">
                                <i class="bi bi-file-earmark-excel mt-1" aria-hidden="true"></i>
                                <span>
                                    <span class="d-block fw-semibold">Export to Excel</span>
                                    <span class="d-block small text-muted">Filterable project register</span>
                                </span>
                            </a>
                        </li>
                    </ul>
                </div>
            </text>
        };
    }
    <partial name="~/Areas/ProjectOfficeReports/Pages/FFC/Partials/_FfcViewHeader.cshtml" model="header" />

    <section class="ffc-detailed-print-heading" aria-hidden="true">
        <h1>FFC Projects Update</h1>
        <p>@Model.ExportScopeLabel · Position as at @Model.GeneratedAtIstDisplay</p>
    </section>

    <form method="get" class="ffc-detailed-filters" data-hide-in-print aria-label="Filter the detailed table">
        <div class="ffc-detailed-filters__field">
            <label for="ffcDetailedYear" class="form-label">Year</label>
            <select id="ffcDetailedYear" name="year" class="form-select form-select-sm">
                <option value="">All years</option>
                @foreach (var year in Model.YearOptions)
                {
                    <option value="@year" selected="@(Model.Year == year)">@year</option>
                }
            </select>
        </div>
        <div class="ffc-detailed-filters__field ffc-detailed-filters__field--country">
            <label for="ffcDetailedCountry" class="form-label">Country</label>
            <select id="ffcDetailedCountry" name="countryId" class="form-select form-select-sm">
                <option value="">All countries</option>
                @foreach (var country in Model.CountryOptions)
                {
                    <option value="@country.Id" selected="@(Model.CountryId == country.Id)">@country.Name · @country.IsoCode</option>
                }
            </select>
        </div>
        <div class="ffc-detailed-filters__actions">
            <button type="submit" class="btn btn-primary btn-sm">Apply</button>
            @if (Model.HasFilters)
            {
                <a asp-page="./MapTableDetailed" class="btn btn-link btn-sm">Clear filters</a>
            }
        </div>
    </form>

    <section class="ffc-detailed-summary" aria-label="Totals for the projects shown" data-hide-in-print>
        <dl class="ffc-detailed-summary__metrics">
            <div><dt>Countries</dt><dd>@summary.CountryCount</dd></div>
            <div><dt>Records</dt><dd>@summary.RecordCount</dd></div>
            <div><dt>Projects</dt><dd>@summary.ProjectCount</dd></div>
            <div><dt>Total quantity</dt><dd>@summary.TotalQuantity.ToString("N0")</dd></div>
            <div>
                <dt>Cost (₹ lakh)</dt>
                <dd>@summary.AvailableCostInLakh.ToString("N2")</dd>
                <span class="ffc-detailed-summary__note">@summary.CostCoverageLabel</span>
            </div>
        </dl>
        <div class="ffc-detailed-summary__status">
            <div class="ffc-detailed-summary__bar"
                 role="img"
                 aria-label="Quantity status: @summary.InstalledQuantity installed, @summary.DeliveredNotInstalledQuantity delivered awaiting installation, @summary.PlannedQuantity planned">
                <span class="ffc-detailed-summary__segment is-installed" style="width: @Share(summary.InstalledQuantity, summary.TotalQuantity)"></span>
                <span class="ffc-detailed-summary__segment is-delivered" style="width: @Share(summary.DeliveredNotInstalledQuantity, summary.TotalQuantity)"></span>
            </div>
            <ul class="ffc-detailed-summary__legend">
                <li><span class="ffc-detailed-summary__dot is-installed" aria-hidden="true"></span>Installed <strong>@summary.InstalledQuantity</strong></li>
                <li><span class="ffc-detailed-summary__dot is-delivered" aria-hidden="true"></span>Delivered, awaiting installation <strong>@summary.DeliveredNotInstalledQuantity</strong></li>
                <li><span class="ffc-detailed-summary__dot is-planned" aria-hidden="true"></span>Planned <strong>@summary.PlannedQuantity</strong></li>
            </ul>
        </div>
    </section>

    <div class="pm-card pm-card--content ffc-detailed-card">
        <div class="pm-card__body">
            <partial name="_DetailedTablePartial" model="Model.Groups" />
        </div>
    </div>
</div>

<form method="post" id="ffc-inline-edit-token" class="d-none">
    @Html.AntiForgeryToken()
</form>

<div class="modal fade"
     id="ffcWordExportModal"
     tabindex="-1"
     aria-labelledby="ffcWordExportModalLabel"
     aria-hidden="true"
     data-hide-in-print>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post"
                  asp-page="./MapTableDetailed"
                  asp-page-handler="ExportWord"
                  data-ffc-word-export-form>
                <input type="hidden" name="countryId" value="@Model.CountryId" />
                <input type="hidden" name="countryIso3" value="@Model.CountryIso3" />
                <input type="hidden" name="year" value="@Model.Year" />

                <div class="modal-header">
                    <div>
                        <h2 class="modal-title fs-5" id="ffcWordExportModalLabel">Export FFC Projects Update</h2>
                        <p class="small text-muted mb-0">Scope: @Model.ExportScopeLabel</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="WordExport.HandlingMarking" class="form-label fw-semibold"></label>
                        <input asp-for="WordExport.HandlingMarking"
                               class="form-control"
                               maxlength="80"
                               autocomplete="off"
                               placeholder="Optional, for example: OFFICIAL" />
                        <span asp-validation-for="WordExport.HandlingMarking" class="text-danger small"></span>
                        <div class="form-text">
                            The marking, when entered, is repeated in the Word document header and footer.
                        </div>
                    </div>

                    <div class="ffc-export-note" role="note">
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        <span>PRISM does not assign a classification automatically. Enter a marking only when authorised and applicable.</span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" data-ffc-word-export-submit>
                        <i class="bi bi-file-earmark-word" aria-hidden="true"></i>
                        Generate Word file
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pages/project-office-reports/ffc/ffc-map-table-detailed.js" asp-append-version="true"></script>
    <script src="~/js/pages/project-office-reports/ffc/ffc-map-table-detailed-inline-edit.js" asp-append-version="true"></script>
}
