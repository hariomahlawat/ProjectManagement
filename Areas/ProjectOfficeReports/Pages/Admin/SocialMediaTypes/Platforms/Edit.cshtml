@page "{id:guid}"
@model ProjectManagement.Areas.ProjectOfficeReports.Pages.Admin.SocialMediaTypes.Platforms.EditModel
@using ProjectManagement.Areas.Admin.Models
@using ProjectManagement.Services.Admin.MasterData.ReferenceLists
@* Inside Administration, on the shared list form (docs/ux/admin-review-4-fixes.md, PR 5). *@
@{
    ViewData["Title"] = "Edit social media platform";
    Func<object?, Microsoft.AspNetCore.Html.IHtmlContent> fields =
        @<text>
            <input type="hidden" asp-for="RowVersion" />
            <div class="admin-field">
                <label asp-for="Input.Name">Name</label>
                <input asp-for="Input.Name" class="form-control" maxlength="128" autocomplete="off" />
                <small class="admin-field__hint">@AdminListFormWords.RenameHint(ReferenceListKeys.SocialMediaPlatforms)</small>
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="admin-field">
                <label asp-for="Input.Description">Description</label>
                <textarea asp-for="Input.Description" class="form-control" rows="3" maxlength="512"></textarea>
                <small class="admin-field__hint">@AdminListFormWords.DescriptionHint</small>
                <span asp-validation-for="Input.Description" class="text-danger"></span>
            </div>
            <label class="admin-switch-row"><input asp-for="Input.IsActive" type="checkbox" class="form-check-input" /><span><strong>Active</strong><small>@AdminListFormWords.ActiveHint</small></span></label>
        </text>;
    var form = AdminListFormModel.For(ReferenceListCatalog.SocialMediaPlatforms, isEdit: true, "bi-share", Url.Page("Index"), fields);
}
<partial name="~/Areas/Admin/Pages/Shared/_AdminListForm.cshtml" model="form" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
