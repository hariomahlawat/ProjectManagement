@page
@model ProjectManagement.Areas.ProjectOfficeReports.Pages.Admin.SocialMediaTypes.Platforms.NewModel
@using ProjectManagement.Areas.Admin.Models
@using ProjectManagement.Services.Admin.MasterData.ReferenceLists
@* Inside Administration, on the shared list form (docs/ux/admin-review-4-fixes.md, PR 5). *@
@{
    ViewData["Title"] = "Add social media platform";
    Func<object?, Microsoft.AspNetCore.Html.IHtmlContent> fields =
        @<text>
            <div class="admin-field">
                <label asp-for="Input.Name">Name</label>
                <input asp-for="Input.Name" class="form-control" maxlength="128" autocomplete="off" autofocus placeholder="For example: Instagram" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="admin-field">
                <label asp-for="Input.Description">Description</label>
                <textarea asp-for="Input.Description" class="form-control" rows="3" maxlength="512"></textarea>
                <small class="admin-field__hint">@AdminListFormWords.DescriptionHint</small>
                <span asp-validation-for="Input.Description" class="text-danger"></span>
            </div>
        </text>;
    var form = AdminListFormModel.For(ReferenceListCatalog.SocialMediaPlatforms, isEdit: false, "bi-share", Url.Page("Index"), fields);
}
<partial name="~/Areas/Admin/Pages/Shared/_AdminListForm.cshtml" model="form" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
