@page
@model ProjectManagement.Areas.ProjectOfficeReports.Pages.Visits.NewModel
@{
    ViewData["Title"] = "Record a visit · Visits to SDD";
    ViewData["VisitTypeOptions"] = Model.VisitTypeOptions;
}

<div class="visit-editor-page">
    <nav aria-label="Breadcrumb" class="visit-record__crumbs">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-page="Index">Visits to SDD</a></li>
            <li class="breadcrumb-item active" aria-current="page">Record a visit</li>
        </ol>
    </nav>

    <header class="visit-editor-page__head">
        <h1>Record a visit</h1>
        <p>A dignitary, course or delegation hosted by SDD. Photos can be added now or later.</p>
    </header>

    <form method="post" enctype="multipart/form-data" class="visit-editor" data-visits-disable-on-submit>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger visit-editor__summary" role="alert"></div>

        <section class="visit-editor__section" aria-labelledby="visit-editor-details">
            <h2 id="visit-editor-details" class="visit-editor__heading">The visit</h2>
            <partial name="_VisitFields" for="Input" />
        </section>

        <section class="visit-editor__section" aria-labelledby="visit-editor-photos">
            <h2 id="visit-editor-photos" class="visit-editor__heading">Photos <span class="visit-editor__optional">optional</span></h2>
            <partial name="_PhotoPicker" model="Model.PhotoPicker" />
        </section>

        <footer class="visit-editor__footer">
            <a asp-page="Index" class="btn btn-link visit-editor__cancel">Cancel</a>
            <div class="visit-editor__submit">
                <button type="submit" name="SaveMode" value="save-add-another" class="btn btn-outline-primary" data-visits-busy-label="Saving…">Record and add another</button>
                <button type="submit" name="SaveMode" value="save" class="btn btn-primary" data-visits-busy-label="Saving…">
                    <i class="bi bi-check2" aria-hidden="true"></i> Record visit
                </button>
            </div>
        </footer>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/project-office-reports/visits-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/project-office-reports/visits-editor.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/pages/project-office-reports/visits.js" asp-append-version="true"></script>
}
