@page
@model ProjectManagement.Areas.ProjectOfficeReports.Pages.Visits.IndexModel
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.WebUtilities
@{
    ViewData["Title"] = "Visits to SDD";

    var inv = CultureInfo.InvariantCulture;
    var summary = Model.Summary;
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var fromValue = Model.FromDate?.ToString("yyyy-MM-dd", inv) ?? string.Empty;
    var toValue = Model.ToDate?.ToString("yyyy-MM-dd", inv) ?? string.Empty;
    string Plural(int count, string one, string many) => count == 1 ? one : many;
    string N(int value) => value.ToString("N0", inv);
}

<div class="visit-register">
    @* SECTION: Page header *@
    <header class="visit-register__head">
        <div class="visit-register__title">
            <h1>Visits to SDD</h1>
            <p>Dignitaries, courses and delegations hosted by the Simulator Development Division.</p>
        </div>
        <div class="visit-register__actions">
            @if (Model.CanManageTypes)
            {
                <a asp-page="/VisitTypes/Index" class="btn btn-outline-secondary">
                    <i class="bi bi-tags" aria-hidden="true"></i>
                    <span>Visit types</span>
                </a>
            }
            @if (Model.TotalItems > 0)
            {
                <div class="dropdown">
                    <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-download" aria-hidden="true"></i>
                        <span>Export</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end visit-register__export">
                        <form method="post">
                            <input type="hidden" name="VisitTypeId" value="@Model.VisitTypeId" />
                            <input type="hidden" name="From" value="@fromValue" />
                            <input type="hidden" name="To" value="@toValue" />
                            <input type="hidden" name="Q" value="@Model.Q" />
                            <input type="hidden" name="Sort" value="@Model.Sort" />
                            <p class="visit-register__export-scope">
                                @(Model.HasFilters ? $"The {N(Model.TotalItems)} {Plural(Model.TotalItems, "visit", "visits")} matching your filters" : $"All {N(Model.TotalItems)} visits on record")
                            </p>
                            <button type="submit" class="dropdown-item" asp-page-handler="Export">
                                <i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i> Excel workbook
                            </button>
                            <button type="submit" class="dropdown-item" asp-page-handler="ExportPdf">
                                <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF report with photos
                            </button>
                        </form>
                    </div>
                </div>
            }
            @if (Model.CanManage)
            {
                <a asp-page="New" class="btn btn-primary">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    <span>Record visit</span>
                </a>
            }
        </div>
    </header>

    @* SECTION: Headline figures (whole register, independent of the filters) *@
    <section class="visit-register__summary" aria-label="Visits hosted">
        <div class="visit-stat">
            <span class="visit-stat__label">Last 12 months</span>
            <span class="visit-stat__value">@N(summary.VisitsLastYear) <small>@Plural(summary.VisitsLastYear, "visit", "visits")</small></span>
            <span class="visit-stat__meta">@N(summary.PeopleLastYear) @Plural(summary.PeopleLastYear, "visitor", "visitors") hosted</span>
        </div>
        <div class="visit-stat">
            <span class="visit-stat__label">Last 30 days</span>
            <span class="visit-stat__value">@N(summary.VisitsLast30) <small>@Plural(summary.VisitsLast30, "visit", "visits")</small></span>
            <span class="visit-stat__meta">@N(summary.PeopleLast30) @Plural(summary.PeopleLast30, "visitor", "visitors") hosted</span>
        </div>
        <div class="visit-stat">
            <span class="visit-stat__label">Most recent visit</span>
            <span class="visit-stat__value visit-stat__value--date">@(summary.LatestVisit?.ToString("dd MMM yyyy", inv) ?? "None yet")</span>
            <span class="visit-stat__meta">@(summary.LatestVisit is { } latest ? latest.ToString("dddd", inv) : "No visits recorded")</span>
        </div>
        <div class="visit-stat">
            <span class="visit-stat__label">On record</span>
            <span class="visit-stat__value">@N(summary.TotalVisits) <small>@Plural(summary.TotalVisits, "visit", "visits")</small></span>
            <span class="visit-stat__meta">Since records began</span>
        </div>
    </section>

    @* SECTION: Filters *@
    <section class="visit-register__filters" aria-label="Filter visits">
        <form method="get" class="visit-filter" role="search">
            <div class="visit-filter__field visit-filter__field--search">
                <label for="visit-filter-q">Search</label>
                <div class="visit-filter__search">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input id="visit-filter-q" name="Q" value="@Model.Q" class="form-control" placeholder="Visitor, remarks or type" autocomplete="off" />
                </div>
            </div>
            <div class="visit-filter__field">
                <label for="visit-filter-type">Visit type</label>
                <select id="visit-filter-type" name="VisitTypeId" class="form-select" asp-items="Model.VisitTypeOptions"></select>
            </div>
            <div class="visit-filter__field">
                <label for="visit-filter-from">From</label>
                <input id="visit-filter-from" name="From" type="date" value="@fromValue" class="form-control" />
            </div>
            <div class="visit-filter__field">
                <label for="visit-filter-to">To</label>
                <input id="visit-filter-to" name="To" type="date" value="@toValue" class="form-control" />
            </div>
            @if (Model.SortKey != "newest")
            {
                <input type="hidden" name="Sort" value="@Model.SortKey" />
            }
            @if (Model.PageSize != 25)
            {
                <input type="hidden" name="PageSize" value="@Model.PageSize" />
            }
            <div class="visit-filter__actions">
                <button type="submit" class="btn btn-primary">Apply</button>
            </div>
        </form>

        @if (Model.HasFilters)
        {
            <div class="visit-chips" aria-label="Active filters">
                @if (Model.SelectedTypeLabel is { } typeLabel)
                {
                    <a class="visit-chip" asp-page="Index" asp-all-route-data="Model.RouteWith(removeKey: nameof(Model.VisitTypeId))" aria-label="Remove filter: type @typeLabel">
                        <span>Type: @typeLabel</span><i class="bi bi-x" aria-hidden="true"></i>
                    </a>
                }
                @if (Model.FromDate is { } fromDate)
                {
                    <a class="visit-chip" asp-page="Index" asp-all-route-data="Model.RouteWith(removeKey: nameof(Model.From))" aria-label="Remove filter: from @fromDate.ToString("dd MMM yyyy", inv)">
                        <span>From @fromDate.ToString("dd MMM yyyy", inv)</span><i class="bi bi-x" aria-hidden="true"></i>
                    </a>
                }
                @if (Model.ToDate is { } toDate)
                {
                    <a class="visit-chip" asp-page="Index" asp-all-route-data="Model.RouteWith(removeKey: nameof(Model.To))" aria-label="Remove filter: to @toDate.ToString("dd MMM yyyy", inv)">
                        <span>To @toDate.ToString("dd MMM yyyy", inv)</span><i class="bi bi-x" aria-hidden="true"></i>
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Q))
                {
                    <a class="visit-chip" asp-page="Index" asp-all-route-data="Model.RouteWith(removeKey: nameof(Model.Q))" aria-label="Remove search @Model.Q">
                        <span>&ldquo;@Model.Q.Trim()&rdquo;</span><i class="bi bi-x" aria-hidden="true"></i>
                    </a>
                }
                <a class="visit-chips__clear" asp-page="Index">Clear all</a>
            </div>
        }
    </section>

    @* SECTION: Register *@
    <section class="visit-register__list" aria-labelledby="visit-register-heading">
        <div class="visit-toolbar">
            <h2 id="visit-register-heading" class="visit-toolbar__count">
                @if (Model.TotalItems == 0)
                {
                    <span>No visits</span>
                }
                else
                {
                    <span>@N(Model.TotalItems) @Plural(Model.TotalItems, "visit", "visits")</span>
                    <span class="visit-toolbar__meta">@N(Model.TotalPeople) @Plural(Model.TotalPeople, "visitor", "visitors")@(Model.TotalPages > 1 ? $" · showing {N(Model.ShowingFrom)}–{N(Model.ShowingTo)}" : string.Empty)</span>
                }
            </h2>
            @if (Model.TotalItems > 0)
            {
                <form method="get" class="visit-toolbar__controls">
                    @foreach (var pair in Model.RouteWith().Where(p => p.Key is not "Sort" and not "PageSize" and not "PageNumber"))
                    {
                        <input type="hidden" name="@pair.Key" value="@pair.Value" />
                    }
                    <label for="visit-sort">Sort</label>
                    <select id="visit-sort" name="Sort" class="form-select form-select-sm" data-visit-page-size-submit>
                        @foreach (var option in IndexModel.SortOptions)
                        {
                            <option value="@option.Value" selected="@(option.Value == Model.SortKey)">@option.Label</option>
                        }
                    </select>
                    <label for="visit-page-size">Rows</label>
                    <select id="visit-page-size" name="PageSize" class="form-select form-select-sm" data-visit-page-size-submit>
                        @foreach (var size in IndexModel.AllowedPageSizes)
                        {
                            <option value="@size" selected="@(size == Model.PageSize)">@size</option>
                        }
                    </select>
                    <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">Apply</button></noscript>
                </form>
            }
        </div>

        @if (Model.TotalItems == 0)
        {
            <div class="visit-empty-state">
                <i class="bi @(Model.HasFilters ? "bi-search" : "bi-building") visit-empty-state__icon" aria-hidden="true"></i>
                @if (Model.HasFilters)
                {
                    <h3>No visits match these filters</h3>
                    <p>Try a wider date range, another visit type or a shorter search.</p>
                    <a asp-page="Index" class="btn btn-outline-secondary">Clear filters</a>
                }
                else
                {
                    <h3>No visits recorded yet</h3>
                    <p>Each visit to SDD you record appears here with its photos and remarks.</p>
                    @if (Model.CanManage)
                    {
                        <a asp-page="New" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Record the first visit</a>
                    }
                }
            </div>
        }
        else
        {
            <div class="visit-table-card">
                <table class="visit-table">
                    <thead>
                        <tr>
                            <th scope="col" class="visit-table__date">Date</th>
                            <th scope="col">Visit</th>
                            <th scope="col" class="visit-table__type">Type</th>
                            <th scope="col" class="visit-table__strength">Visitors</th>
                            @if (Model.CanManage)
                            {
                                <th scope="col" class="visit-table__actions"><span class="visually-hidden">Actions</span></th>
                            }
                        </tr>
                    </thead>
                    @foreach (var group in Model.Items.GroupBy(v => Model.GroupByMonth ? (v.DateOfVisit.Year, v.DateOfVisit.Month) : (0, 0)))
                    {
                        <tbody>
                            @if (Model.GroupByMonth)
                            {
                                var month = new DateOnly(group.Key.Item1, group.Key.Item2, 1);
                                var totals = Model.MonthTotals.TryGetValue((group.Key.Item1, group.Key.Item2), out var found) ? found : (Visits: group.Count(), People: group.Sum(v => v.Strength));
                                <tr class="visit-table__month">
                                    <th scope="rowgroup" colspan="@(Model.CanManage ? 5 : 4)">
                                        <span>@month.ToString("MMMM yyyy", inv)</span>
                                        <span class="visit-table__month-meta">@totals.Visits @Plural(totals.Visits, "visit", "visits") · @N(totals.People) @Plural(totals.People, "visitor", "visitors")</span>
                                    </th>
                                </tr>
                            }
                            @foreach (var item in group)
                            {
                                var detailsUrl = Url.Page("Details", new { id = item.Id });
                                var thumb = item.ThumbnailPhotoId is { } photoId
                                    ? Url.Page("ViewPhoto", new { id = item.Id, photoId, size = "xs" })
                                    : null;
                                if (thumb is not null && !string.IsNullOrWhiteSpace(item.ThumbnailVersion))
                                {
                                    thumb = QueryHelpers.AddQueryString(thumb, "v", item.ThumbnailVersion);
                                }
                                <tr class="visit-row" data-row-href="@detailsUrl">
                                    <td class="visit-table__date">
                                        <div class="visit-date" aria-label="@item.DateOfVisit.ToString("dddd, dd MMMM yyyy", inv)">
                                            <span class="visit-date__day">@item.DateOfVisit.ToString("dd", inv)</span>
                                            <span class="visit-date__month">@item.DateOfVisit.ToString("MMM yyyy", inv)</span>
                                            <span class="visit-date__weekday">@item.DateOfVisit.ToString("ddd", inv)</span>
                                        </div>
                                    </td>
                                    <td class="visit-table__visit">
                                        <div class="visit-entry">
                                            <div class="visit-entry__thumb@(thumb is null ? " visit-entry__thumb--none" : string.Empty)">
                                                @if (thumb is not null)
                                                {
                                                    <img src="@thumb" alt="" loading="lazy" decoding="async" />
                                                    <span class="visit-entry__photo-count" aria-label="@item.PhotoCount @Plural(item.PhotoCount, "photo", "photos")"><i class="bi bi-images" aria-hidden="true"></i> @item.PhotoCount</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-image" aria-hidden="true"></i>
                                                    <span class="visually-hidden">No photos</span>
                                                }
                                            </div>
                                            <div class="visit-entry__text">
                                                <a class="visit-entry__name" href="@detailsUrl">@item.VisitorName</a>
                                                @if (!string.IsNullOrWhiteSpace(item.RemarksPreview))
                                                {
                                                    <p class="visit-entry__remarks">@item.RemarksPreview</p>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="visit-table__type">
                                        <span class="visit-type-tag visit-type-tag--@Model.ColourSlotFor(item.VisitTypeId)">@item.VisitTypeName</span>
                                        @if (!item.VisitTypeIsActive)
                                        {
                                            <span class="visit-type-tag__note">Type no longer in use</span>
                                        }
                                    </td>
                                    <td class="visit-table__strength">
                                        <strong>@N(item.Strength)</strong>
                                        <span>@Plural(item.Strength, "visitor", "visitors")</span>
                                    </td>
                                    @if (Model.CanManage)
                                    {
                                        <td class="visit-table__actions">
                                            <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary visit-row__edit" aria-label="Edit visit: @item.VisitorName">
                                                <i class="bi bi-pencil" aria-hidden="true"></i>
                                                <span class="visit-row__edit-label">Edit</span>
                                            </a>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    }
                </table>
            </div>

            @* SECTION: Pagination *@
            @if (Model.TotalPages > 1)
            {
                var first = Math.Max(1, Model.PageNumber - 2);
                var last = Math.Min(Model.TotalPages, first + 4);
                first = Math.Max(1, last - 4);
                <nav class="visit-pagination" aria-label="Visits pages">
                    @if (Model.PageNumber > 1)
                    {
                        <a class="visit-pagination__step" asp-page="Index" asp-all-route-data="Model.RouteWith(pageNumber: Model.PageNumber - 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Previous</a>
                    }
                    else
                    {
                        <span class="visit-pagination__step is-disabled" aria-hidden="true"><i class="bi bi-chevron-left"></i> Previous</span>
                    }
                    <ol class="visit-pagination__pages">
                        @for (var number = first; number <= last; number++)
                        {
                            <li>
                                @if (number == Model.PageNumber)
                                {
                                    <span class="visit-pagination__page is-current" aria-current="page">@number</span>
                                }
                                else
                                {
                                    <a class="visit-pagination__page" asp-page="Index" asp-all-route-data="Model.RouteWith(pageNumber: number)" aria-label="Page @number">@number</a>
                                }
                            </li>
                        }
                    </ol>
                    <span class="visit-pagination__status">Page @Model.PageNumber of @Model.TotalPages</span>
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a class="visit-pagination__step" asp-page="Index" asp-all-route-data="Model.RouteWith(pageNumber: Model.PageNumber + 1)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                    }
                    else
                    {
                        <span class="visit-pagination__step is-disabled" aria-hidden="true">Next <i class="bi bi-chevron-right"></i></span>
                    }
                </nav>
            }
        }
    </section>

    @* SECTION: Trends *@
    @if (Model.TotalItems > 0)
    {
        <section class="visit-register__trends" aria-labelledby="visit-trends-heading">
            <div class="visit-section-title">
                <h2 id="visit-trends-heading">Trends</h2>
                <p>@(Model.HasFilters ? $"For the {N(Model.TotalItems)} {Plural(Model.TotalItems, "visit", "visits")} matching your filters." : "For every visit on record.")</p>
            </div>
            <div class="visit-trends">
                <figure class="visit-chart">
                    <figcaption class="visit-chart__head">
                        <div>
                            <h3 id="visits-monthly-title">Visits and visitors by month</h3>
                            <p>The last 12 months. Bars count visits; the line counts visitors.</p>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-chart-download="visits-monthly" aria-label="Download the monthly chart as an image">
                            <i class="bi bi-download" aria-hidden="true"></i>
                        </button>
                    </figcaption>
                    <div id="visits-monthly-chart" class="visit-chart__canvas" data-monthly='@JsonSerializer.Serialize(Model.MonthlyTrend, jsonOptions)'>
                        <canvas id="visits-monthly-canvas" role="img" aria-labelledby="visits-monthly-title"></canvas>
                    </div>
                </figure>
                <figure class="visit-chart">
                    <figcaption class="visit-chart__head">
                        <div>
                            <h3 id="visits-type-title">Visits by type</h3>
                            <p>Share of visits in each category.</p>
                        </div>
                        <div class="visit-chart__tools">
                            <select id="visits-type-range" class="form-select form-select-sm" aria-label="Period for visits by type">
                                <option value="lastYear" selected>Last 12 months</option>
                                <option value="all">All time</option>
                            </select>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-chart-download="visits-type" aria-label="Download the visits by type chart as an image">
                                <i class="bi bi-download" aria-hidden="true"></i>
                            </button>
                        </div>
                    </figcaption>
                    <div id="visits-type-chart" class="visit-chart__canvas" data-types='@JsonSerializer.Serialize(Model.TypeMix, jsonOptions)'>
                        <canvas id="visits-type-canvas" role="img" aria-labelledby="visits-type-title"></canvas>
                        <p class="visit-chart__empty" data-visits-type-empty hidden>No visits in this period.</p>
                    </div>
                </figure>
            </div>
        </section>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/project-office-reports/visits-register.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.js"></script>
    <script type="module" src="~/js/pages/project-office-reports/visits.js" asp-append-version="true"></script>
}
