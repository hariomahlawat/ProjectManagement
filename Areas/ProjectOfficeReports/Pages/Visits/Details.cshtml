@page "{id:guid}"
@model ProjectManagement.Areas.ProjectOfficeReports.Pages.Visits.DetailsModel
@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
@{
    var inv = CultureInfo.InvariantCulture;
    var visit = Model.Visit?.Visit;
    ViewData["Title"] = visit is null ? "Visit not found" : $"{visit.VisitorName} · Visits to SDD";
    var photoCount = Model.PhotoGallery?.Photos.Count ?? 0;
    string Plural(int count, string one, string many) => count == 1 ? one : many;
    string Stamp(DateTimeOffset value) => value.ToString("dd MMM yyyy, HH:mm", inv) + " IST";

    string? coverUrl = null;
    if (Model.CoverPhoto is { } cover && visit is not null)
    {
        coverUrl = Url.Page("./ViewPhoto", new { id = visit.Id, photoId = cover.Id, size = "xl" });
        if (coverUrl is not null && !string.IsNullOrWhiteSpace(cover.VersionStamp))
        {
            coverUrl = QueryHelpers.AddQueryString(coverUrl, "v", cover.VersionStamp);
        }
    }
}

<div class="visit-record">
    <nav aria-label="Breadcrumb" class="visit-record__crumbs">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-page="Index">Visits to SDD</a></li>
            <li class="breadcrumb-item active" aria-current="page">@(visit?.VisitorName ?? "Visit not found")</li>
        </ol>
    </nav>

    @if (visit is null)
    {
        <div class="visit-record__missing">
            <i class="bi bi-journal-x" aria-hidden="true"></i>
            <h1>Visit not found</h1>
            <p>It may have been deleted, or the link is incomplete.</p>
            <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Visits to SDD</a>
        </div>
    }
    else
    {
        @* SECTION: Header *@
        <header class="visit-record__head">
            <div class="visit-record__identity">
                <span class="visit-type-tag visit-type-tag--@Model.TypeColourSlot">@Model.Visit!.VisitType.Name</span>
                <h1>@visit.VisitorName</h1>
                <ul class="visit-record__meta">
                    <li><i class="bi bi-calendar3" aria-hidden="true"></i> @visit.DateOfVisit.ToString("dddd, d MMMM yyyy", inv)</li>
                    <li><i class="bi bi-people" aria-hidden="true"></i> @visit.Strength.ToString("N0", inv) @Plural(visit.Strength, "visitor", "visitors")</li>
                    <li><i class="bi bi-images" aria-hidden="true"></i> @(photoCount == 0 ? "No photos" : $"{photoCount} {Plural(photoCount, "photo", "photos")}")</li>
                </ul>
            </div>
            @if (Model.CanManage)
            {
                <div class="visit-record__actions">
                    <a asp-page="Edit" asp-route-id="@visit.Id" class="btn btn-primary">
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                        <span>Edit visit</span>
                    </a>
                    <form method="post" asp-page-handler="Delete" data-visits-disable-on-submit data-page-handled data-confirm="Delete this visit to SDD? The record and all its photos will be removed. This cannot be undone.">
                        <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                        <button type="submit" class="btn btn-outline-danger" data-visits-busy-label="Deleting…">
                            <i class="bi bi-trash" aria-hidden="true"></i>
                            <span>Delete</span>
                        </button>
                    </form>
                </div>
            }
        </header>

        <div class="visit-record__layout">
            <div class="visit-record__main">
                @* SECTION: Cover photo *@
                @if (coverUrl is not null)
                {
                    <figure class="visit-cover">
                        <button type="button" class="visit-cover__open" data-visit-cover data-media-viewer-open="@VisitMediaViewerItems.Group" data-media-viewer-key="@VisitMediaViewerItems.KeyFor(Model.CoverPhoto!.Id)" aria-label="Open the photos, starting with the cover photo">
                            <img src="@coverUrl" alt="@(string.IsNullOrWhiteSpace(Model.CoverPhoto!.Caption) ? $"Cover photo of the visit by {visit.VisitorName}" : Model.CoverPhoto.Caption)" decoding="async" />
                        </button>
                        <figcaption class="visit-cover__bar">
                            <span class="visit-cover__caption">@(string.IsNullOrWhiteSpace(Model.CoverPhoto!.Caption) ? "Cover photo" : Model.CoverPhoto.Caption)</span>
                            <a href="#visit-photo-gallery" class="visit-cover__all">
                                <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
                                @(photoCount == 1 ? "View photo" : $"All {photoCount} photos")
                            </a>
                        </figcaption>
                    </figure>
                }

                @* SECTION: Remarks *@
                <section class="visit-panel" aria-labelledby="visit-remarks-heading">
                    <h2 id="visit-remarks-heading" class="visit-panel__title">Remarks</h2>
                    @if (string.IsNullOrWhiteSpace(visit.Remarks))
                    {
                        <p class="visit-panel__empty">No remarks were recorded for this visit.</p>
                    }
                    else
                    {
                        <div class="visit-remarks-text">@visit.Remarks</div>
                    }
                </section>

                @* SECTION: Photos *@
                <section class="visit-panel" id="visit-photo-gallery" aria-labelledby="visit-photos-heading">
                    <div class="visit-panel__head">
                        <h2 id="visit-photos-heading" class="visit-panel__title">Photos <span class="visit-panel__count">@photoCount</span></h2>
                        @if (Model.CanManage)
                        {
                            <a asp-page="Edit" asp-route-id="@visit.Id" asp-fragment="visit-photo-manager" class="visit-panel__link">
                                @(photoCount == 0 ? "Add photos" : "Add or manage photos")
                            </a>
                        }
                    </div>
                    @if (photoCount == 0)
                    {
                        <p class="visit-panel__empty">No photos have been added to this visit.</p>
                    }
                    else
                    {
                        <div class="visit-form-card--gallery">
                            <partial name="_PhotosPartial" model="Model.PhotoGallery" />
                        </div>
                    }
                </section>
            </div>

            <aside class="visit-record__aside">
                @* SECTION: Facts *@
                <section class="visit-panel" aria-labelledby="visit-facts-heading">
                    <h2 id="visit-facts-heading" class="visit-panel__title">The visit</h2>
                    <dl class="visit-facts">
                        <div>
                            <dt>Date</dt>
                            <dd>@visit.DateOfVisit.ToString("dd MMM yyyy", inv) <span>@visit.DateOfVisit.ToString("dddd", inv)</span></dd>
                        </div>
                        <div>
                            <dt>Visit type</dt>
                            <dd>
                                @Model.Visit.VisitType.Name
                                @if (!Model.Visit.VisitType.IsActive)
                                {
                                    <span>No longer used for new visits</span>
                                }
                            </dd>
                        </div>
                        <div>
                            <dt>Visitors</dt>
                            <dd>@visit.Strength.ToString("N0", inv)</dd>
                        </div>
                        <div>
                            <dt>Photos</dt>
                            <dd>@photoCount</dd>
                        </div>
                    </dl>
                </section>

                @* SECTION: Record history *@
                <section class="visit-panel" aria-labelledby="visit-history-heading">
                    <h2 id="visit-history-heading" class="visit-panel__title">Record</h2>
                    <ul class="visit-history">
                        @if (Model.Recorded is { } recorded)
                        {
                            <li>
                                <span class="visit-history__what">Recorded@(recorded.By is null ? string.Empty : $" by {recorded.By}")</span>
                                <span class="visit-history__when">@Stamp(recorded.AtIst)</span>
                            </li>
                        }
                        @if (Model.LastEdited is { } edited)
                        {
                            <li>
                                <span class="visit-history__what">Last edited@(edited.By is null ? string.Empty : $" by {edited.By}")</span>
                                <span class="visit-history__when">@Stamp(edited.AtIst)</span>
                            </li>
                        }
                        else
                        {
                            <li class="visit-history__quiet">Not edited since it was recorded.</li>
                        }
                    </ul>
                </section>
            </aside>
        </div>

        @if (photoCount > 0)
        {
            @* data-media-viewer-links keeps the open photo in the address (#media=…), so a photo can be linked. *@
            <script type="application/json" data-media-viewer-items="@VisitMediaViewerItems.Group" data-media-viewer-links="#media=">@Html.Raw(new ProjectManagement.ViewModels.MediaViewerItemsGroup(VisitMediaViewerItems.Group, VisitMediaViewerItems.ForPhotos(Url, visit, Model.PhotoGallery!.Photos)).ToJson())</script>
            <partial name="_MediaViewer" />
        }
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/project-office-reports/visits-register.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/project-office-reports/visits-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/widgets/media-viewer.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/widgets/media-viewer.js" asp-append-version="true"></script>
    <script type="module" src="~/js/pages/project-office-reports/visits.js" asp-append-version="true"></script>
}
