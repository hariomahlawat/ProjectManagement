@page "{id:guid}"
@model ProjectManagement.Areas.ProjectOfficeReports.Pages.Visits.EditModel
@using System.Globalization
@{
    var visitorName = Model.SavedVisitorName ?? Model.Input.VisitorName;
    ViewData["Title"] = $"Edit · {visitorName} · Visits to SDD";
    ViewData["VisitTypeOptions"] = Model.VisitTypeOptions;
    var totalPhotos = Model.Photos.Count;
}

<div class="visit-editor-page">
    <nav aria-label="Breadcrumb" class="visit-record__crumbs">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-page="Index">Visits to SDD</a></li>
            <li class="breadcrumb-item"><a asp-page="Details" asp-route-id="@Model.VisitId">@visitorName</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit</li>
        </ol>
    </nav>

    <header class="visit-editor-page__head">
        <h1>Edit visit</h1>
        <p>@visitorName</p>
    </header>

    <form method="post" class="visit-editor" data-visits-disable-on-submit>
        <input type="hidden" asp-for="RowVersion" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger visit-editor__summary" role="alert"></div>

        <section class="visit-editor__section" aria-labelledby="visit-editor-details">
            <h2 id="visit-editor-details" class="visit-editor__heading">The visit</h2>
            <partial name="_VisitFields" for="Input" />
        </section>

        <footer class="visit-editor__footer">
            <a asp-page="Details" asp-route-id="@Model.VisitId" class="btn btn-link visit-editor__cancel">Cancel</a>
            <div class="visit-editor__submit">
                <button type="submit" class="btn btn-primary" data-visits-busy-label="Saving…">
                    <i class="bi bi-check2" aria-hidden="true"></i> Save changes
                </button>
            </div>
        </footer>
    </form>

    @* SECTION: Photo manager *@
    <section class="visit-editor visit-editor--photos" id="@EditModel.PhotoManagerAnchor" aria-labelledby="visit-editor-photos">
        <div class="visit-editor__section">
            <h2 id="visit-editor-photos" class="visit-editor__heading">
                Photos <span class="visit-panel__count">@totalPhotos</span>
            </h2>
            <p class="visit-editor__hint">
                Photos save as soon as you upload them; this does not change the details above.
                @(totalPhotos > 0 ? "The cover photo leads the visit on the register and its record page." : string.Empty)
            </p>

            <form method="post"
                  enctype="multipart/form-data"
                  asp-page-handler="Upload"
                  asp-route-id="@Model.VisitId"
                  class="visit-editor__upload"
                  data-visits-disable-on-submit>
                <input type="hidden" name="id" value="@Model.VisitId" />
                <partial name="_PhotoPicker" model="Model.PhotoPicker" />
                <div class="visit-editor__upload-actions">
                    <button type="submit" class="btn btn-outline-primary" data-visits-busy-label="Uploading…">
                        <i class="bi bi-upload" aria-hidden="true"></i> Upload photos
                    </button>
                </div>
            </form>

            @if (totalPhotos > 0)
            {
                <div class="visit-editor__gallery visit-form-card--gallery">
                    <partial name="_PhotosPartial" model="Model.PhotoGallery" />
                </div>
            }
        </div>
    </section>

    @if (totalPhotos > 0)
    {
        <partial name="_PhotoViewer" model="visitorName" />
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/project-office-reports/visits-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/project-office-reports/visits-editor.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/pages/project-office-reports/visits.js" asp-append-version="true"></script>
}
