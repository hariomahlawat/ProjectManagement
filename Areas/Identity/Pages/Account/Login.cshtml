@page
@model ProjectManagement.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["UseFullWidth"] = true;
    ViewData["PageShell"] = "focused";
    ViewData["PublicHeaderMode"] = "Auth";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth-login.css" asp-append-version="true" />
}

<div class="lp auth">
    <div class="lp-aurora lp-aurora--auth" aria-hidden="true"></div>
    <div class="auth__grid-dots" aria-hidden="true"></div>

    <div class="lp-wrap auth__layout">
        <aside class="auth__art" aria-label="PRISM ERP">
            <p class="lp-badge auth__crests">
                <img src="~/img/logos/sdd.png" alt="" width="22" height="22" />
                <span>Simulator Development Division</span>
            </p>

            <div class="auth__prism">
                <partial name="_PrismSpectrum" model="false" />
            </div>

            <div class="auth__brand">
                <p class="auth__wordmark">PRISM <span>ERP</span></p>
                <p class="auth__tagline">Plan. Track. <span class="lp-spectrum-text">Deliver.</span></p>
                <p class="auth__strap">Project Reporting, Intelligence and Systems Management</p>
            </div>
        </aside>

        <section class="auth__card" data-glass-light aria-labelledby="auth-title">
            <header class="auth__head">
                <p class="lp-eyebrow">Welcome back</p>
                <h1 id="auth-title">Sign in to PRISM</h1>
            </header>

            <form method="post" class="auth__form" novalidate data-auth-form>
                @if (Model.Throttled)
                {
                    <div class="auth__alert" role="alert">
                        <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                        <span>Too many sign-in attempts. Wait up to @Model.ThrottleWaitText, then try again.</span>
                    </div>
                }
                <div asp-validation-summary="ModelOnly" class="auth__alert auth__alert--summary" role="alert"></div>

                <div class="auth__field">
                    <label asp-for="Input.UserName"></label>
                    <div class="auth__control">
                        <i class="bi bi-person" aria-hidden="true"></i>
                        <input asp-for="Input.UserName"
                               class="auth__input"
                               autocomplete="username"
                               autocapitalize="none"
                               spellcheck="false"
                               autofocus
                               placeholder="Your username" />
                    </div>
                    <span asp-validation-for="Input.UserName" class="auth__error"></span>
                </div>

                <div class="auth__field">
                    <label asp-for="Input.Password"></label>
                    <div class="auth__control password-container">
                        <i class="bi bi-key" aria-hidden="true"></i>
                        <input asp-for="Input.Password"
                               class="auth__input"
                               autocomplete="current-password"
                               placeholder="Your password"
                               aria-describedby="authCapsLock" />
                        <button type="button"
                                class="password-toggle auth__reveal"
                                aria-label="Show password"
                                aria-pressed="false">
                            <i class="eye-open bi bi-eye" aria-hidden="true"></i>
                            <i class="eye-closed bi bi-eye-slash" aria-hidden="true" hidden></i>
                        </button>
                    </div>
                    <p class="auth__caps" id="authCapsLock" data-caps-lock-hint hidden>
                        <i class="bi bi-capslock-fill" aria-hidden="true"></i> Caps Lock is on
                    </p>
                    <span asp-validation-for="Input.Password" class="auth__error"></span>
                </div>

                <label class="auth__remember">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <span>Keep me signed in on this computer</span>
                </label>

                <button type="submit" class="lp-btn lp-btn--primary auth__submit" data-auth-submit>
                    <span class="auth__submit-label">Sign in</span>
                    <span class="auth__submit-busy" aria-hidden="true">Signing in&hellip;</span>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
            </form>

            <footer class="auth__foot">
                <p><i class="bi bi-life-preserver" aria-hidden="true"></i> Can't sign in? Contact the PRISM administrator.</p>
                <p><i class="bi bi-shield-check" aria-hidden="true"></i> Every sign-in is recorded.</p>
            </footer>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/utils/password-toggle.js"></script>
    <script src="~/js/pages/auth-login.js" asp-append-version="true" defer></script>
    <script src="~/js/pages/glass-light.js" asp-append-version="true" defer></script>
}
