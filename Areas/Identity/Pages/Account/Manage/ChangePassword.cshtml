@page
@model ProjectManagement.Areas.Identity.Pages.Account.Manage.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/account.css" asp-append-version="true" />
}

<div class="account account--narrow">
  @if (!Model.MustChangePassword)
  {
    <a class="account__back" asp-page="./Index">
      <i class="bi bi-arrow-left" aria-hidden="true"></i>
      <span>My account</span>
    </a>
  }

  <h1 class="account__title">@ViewData["Title"]</h1>

  @if (Model.MustChangePassword)
  {
    <div class="alert alert-info account__alert" role="status">
      <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
      <span>Choose a new password to continue. You can use PRISM as soon as it is changed.</span>
    </div>
  }

  <section class="pm-card pm-shadow account__panel">
    <form method="post" class="account__form" data-account-password-form>
      <div asp-validation-summary="ModelOnly" class="alert alert-danger account__alert account__alert--summary" role="alert"></div>

      <div>
        <label asp-for="Input.OldPassword" class="form-label"></label>
        <div class="password-container">
          <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" autofocus />
          <button type="button" class="password-toggle" aria-label="Show password" aria-pressed="false">
            <i class="eye-open bi bi-eye" aria-hidden="true"></i>
            <i class="eye-closed bi bi-eye-slash" aria-hidden="true" hidden></i>
          </button>
        </div>
        <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
      </div>

      <div>
        <label asp-for="Input.NewPassword" class="form-label"></label>
        <div class="password-container">
          <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-describedby="newPasswordRules" />
          <button type="button" class="password-toggle" aria-label="Show password" aria-pressed="false">
            <i class="eye-open bi bi-eye" aria-hidden="true"></i>
            <i class="eye-closed bi bi-eye-slash" aria-hidden="true" hidden></i>
          </button>
        </div>
        <p class="account__hint" id="newPasswordRules">@Model.PasswordPolicyDescription</p>
        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
      </div>

      <div>
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <div class="password-container">
          <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
          <button type="button" class="password-toggle" aria-label="Show password" aria-pressed="false">
            <i class="eye-open bi bi-eye" aria-hidden="true"></i>
            <i class="eye-closed bi bi-eye-slash" aria-hidden="true" hidden></i>
          </button>
        </div>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
      </div>

      <p class="account__caps" data-caps-lock-hint hidden>
        <i class="bi bi-capslock-fill" aria-hidden="true"></i> Caps Lock is on
      </p>

      <div class="account__form-actions">
        <button type="submit" class="btn btn-primary">Change password</button>
        @if (!Model.MustChangePassword)
        {
          <a class="btn btn-outline-secondary" asp-page="./Index">Cancel</a>
        }
      </div>
    </form>
  </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/utils/password-toggle.js"></script>
    <script src="~/js/pages/account-password.js" asp-append-version="true" defer></script>
}
