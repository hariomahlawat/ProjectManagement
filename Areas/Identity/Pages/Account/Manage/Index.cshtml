@page
@model ProjectManagement.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = "My account";
    var portraitUrl = Model.PhotoIdentity is null
        ? null
        : Url.Page("/Photos/People/Portrait", new { area = "", id = Model.PhotoIdentity.PersonId });
    // The same resolved state the header uses, so the two pictures cannot disagree.
    var usePhotosPortrait = Model.PhotoIdentity?.ShouldUsePortraitAsAvatar == true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/account.css" asp-append-version="true" />
}

<div class="account">
  <h1 class="account__title">@ViewData["Title"]</h1>

  @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
  {
    <div class="alert alert-success account__alert" role="status">
      <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
      <span>@Model.StatusMessage</span>
    </div>
  }
  @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
  {
    <div class="alert alert-danger account__alert" role="alert">
      <i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i>
      <span>@Model.ErrorMessage</span>
    </div>
  }

  @* Who you are, then everything about your picture. *@
  <section class="pm-card pm-shadow account__panel" aria-labelledby="accountWho">
    <div class="account__who">
      <span class="account__avatar @(usePhotosPortrait ? "is-photo" : null)" aria-hidden="true">
        @if (usePhotosPortrait)
        {
          <img src="@portraitUrl" alt="" />
        }
        else
        {
          @Model.UserInitials
        }
      </span>
      <div class="account__who-copy">
        <h2 id="accountWho">@Model.DisplayName</h2>
        <p>
          <span>@Model.UserName</span>
          @if (Model.LastSignInText is not null)
          {
            <span aria-hidden="true">·</span>
            <span>Last sign-in @Model.LastSignInText</span>
          }
        </p>
        @if (Model.Roles.Count > 0)
        {
          <ul class="account__roles" aria-label="Your roles">
            @foreach (var role in Model.Roles)
            {
              <li class="account__chip">@role</li>
            }
          </ul>
        }
        else
        {
          <p>You do not have any roles yet.</p>
        }
      </div>
    </div>

    @if (Model.PhotoIdentity is not null)
    {
      <div id="photosIdentity" class="account__photos @(Model.PhotoIdentity.HasOpenConcern ? "has-concern" : null)">
        @if (Model.PhotoIdentity.HasOpenConcern)
        {
          <div class="account__concern" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <div>
              <strong>You reported that this Photos identity is not you</strong>
              <p>@Model.PhotoIdentity.ConcernReason</p>
              @if (Model.PhotoIdentity.ConcernRaisedAtUtc.HasValue)
              {
                <small>Reported @Model.PhotoIdentity.ConcernRaisedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm"). An identity manager will check the link. Until then PRISM shows your initials and My Photos is paused.</small>
              }
            </div>
          </div>
        }
        else
        {
          <div class="account__row">
            <div class="account__row-copy">
              <h3>PRISM profile image</h3>
              <p>
                <strong>
                  @(usePhotosPortrait
                      ? "Photos portrait in use."
                      : Model.PhotoIdentity.UsePortraitAsAvatar && !Model.PhotoIdentity.HasPortrait
                          ? "Initials in use; your portrait is unavailable."
                          : "Initials in use.")
                </strong>
                @(usePhotosPortrait
                    ? "Your portrait from Photos is shown at the top of every page."
                    : Model.PhotoIdentity.UsePortraitAsAvatar && !Model.PhotoIdentity.HasPortrait
                        ? "PRISM will show your portrait again when Photos has one."
                        : "Your initials are shown at the top of every page.")
              </p>
            </div>
            <div class="account__row-action">
              @if (Model.PhotoIdentity.UsePortraitAsAvatar)
              {
                <form method="post" asp-page-handler="UseInitials">
                  <button type="submit" class="btn btn-sm btn-outline-secondary account-photo-avatar-setting__use-initials">Use initials instead</button>
                </form>
              }
              else if (Model.PhotoIdentity.CanUsePortraitAsAvatar)
              {
                <form method="post" asp-page-handler="UsePhotosPortrait">
                  <button type="submit" class="btn btn-sm btn-outline-primary">
                    @if (Model.PhotoIdentity.HasPortrait)
                    {
                      <img class="account__portrait-thumb" src="@portraitUrl" alt="" />
                    }
                    <span>Use my Photos portrait</span>
                  </button>
                </form>
              }
              else
              {
                <span class="account__note">Photos has no suitable portrait of you yet.</span>
              }
            </div>
          </div>

          <div class="account__row">
            <div class="account__row-copy">
              <h3>Photos identity</h3>
              <p>Photos knows you as <strong>@Model.PhotoIdentity.PersonDisplayName</strong>. An identity manager confirmed this link.</p>
            </div>
            <div class="account__row-action">
              <a class="btn btn-sm btn-outline-primary" asp-area="" asp-page="/Photos/Index" asp-route-MyPhotos="true">
                <i class="bi bi-images" aria-hidden="true"></i>
                <span>My Photos</span>
              </a>
            </div>
          </div>

          <details class="account__report">
            <summary>
              <span>This isn't me</span>
              <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </summary>
            <form method="post" asp-page-handler="ReportPhotoIdentity" class="account__report-form">
              <p>
                Reporting stops PRISM using this portrait as your profile image and pauses My Photos until an identity manager has checked the link. Photographs already confirmed as you are not changed.
              </p>
              <div>
                <label for="photoIdentityConcern" class="form-label">What is wrong with this link?</label>
                <textarea id="photoIdentityConcern"
                          name="reason"
                          class="form-control"
                          rows="3"
                          maxlength="1024"
                          required
                          placeholder="For example: this is a different person with a similar name"></textarea>
              </div>
              <button type="submit" class="btn btn-sm btn-outline-danger">Report wrong identity</button>
            </form>
          </details>
        }
      </div>
    }
  </section>

  <section class="pm-card pm-shadow account__panel" aria-label="Settings">
    <div class="account__row">
      <div class="account__row-copy">
        <h3 id="accountAppearance">Appearance</h3>
        <p>How PRISM looks on this computer.</p>
      </div>
      @* Same controls and storage as the user menu (wwwroot/js/core/theme-preference.js). *@
      <div class="pm-theme-choice__options account__theme" role="group" aria-labelledby="accountAppearance">
        <button type="button" class="pm-theme-choice__option" aria-pressed="false" data-theme-preference-value="light">
          <i class="bi bi-sun" aria-hidden="true"></i><span>Light</span>
        </button>
        <button type="button" class="pm-theme-choice__option" aria-pressed="false" data-theme-preference-value="dark">
          <i class="bi bi-moon-stars" aria-hidden="true"></i><span>Dark</span>
        </button>
        <button type="button" class="pm-theme-choice__option" aria-pressed="false" data-theme-preference-value="system">
          <i class="bi bi-circle-half" aria-hidden="true"></i><span>System</span>
        </button>
      </div>
    </div>

    <div class="account__row">
      <div class="account__row-copy">
        <h3>Password</h3>
        <p>The password you use to sign in to PRISM.</p>
      </div>
      <div class="account__row-action">
        <a asp-page="./ChangePassword" class="btn btn-sm btn-outline-primary">Change password</a>
      </div>
    </div>
  </section>

  <section class="pm-card pm-shadow account__panel" aria-labelledby="accountSignIns">
    <div class="account__row">
      <div class="account__row-copy">
        <h3 id="accountSignIns">Recent sign-ins</h3>
        <p>Your last @ProjectManagement.Areas.Identity.Pages.Account.Manage.IndexModel.RecentSignInCount sign-ins in the past @Model.SignInLookbackDays days. If one of these was not you, change your password and tell the PRISM administrator.</p>
      </div>
    </div>
    @if (Model.RecentSignIns.Count > 0)
    {
      <ol class="account__signins">
        @foreach (var signIn in Model.RecentSignIns)
        {
          <li class="account__signin">
            <span class="account__signin-when">@signIn.When</span>
            <span class="account__signin-client">@signIn.Client</span>
            <span class="account__signin-where">
              @if (signIn.FromThisAddress)
              {
                <span class="account__chip">This computer</span>
              }
              <span class="account__signin-ip">@(signIn.Ip ?? "Address not recorded")</span>
            </span>
          </li>
        }
      </ol>
    }
    else
    {
      <p class="account__signins-empty">No sign-ins recorded in the past @Model.SignInLookbackDays days.</p>
    }
  </section>

  <form method="post" asp-area="Identity" asp-page="/Account/Logout" class="account__signout">
    <input type="hidden" name="returnUrl" value="/" />
    <button type="submit" class="btn btn-sm btn-outline-secondary">
      <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
      <span>Sign out</span>
    </button>
  </form>
</div>
