@model ProjectManagement.Areas.Admin.Models.AdminPageHeaderModel
@{
    // The eyebrow is the page's sidebar group, the same on every page of the group.
    var eyebrow = ProjectManagement.Services.Navigation.ModuleNav.AdminNavigationCatalog.EyebrowFor(
        ViewContext.RouteData.Values["area"]?.ToString(),
        ViewContext.RouteData.Values["page"]?.ToString(),
        ViewContext.HttpContext.Request.Query,
        Model.Eyebrow);
}

<header class="admin-page-header">
    <div class="admin-page-header__main">
        @if (!string.IsNullOrWhiteSpace(Model.Icon))
        {
            <span class="admin-page-header__icon" aria-hidden="true">
                <i class="bi @Model.Icon"></i>
            </span>
        }

        <div class="admin-page-header__copy">
            @if (!string.IsNullOrWhiteSpace(eyebrow))
            {
                <div class="admin-page-header__eyebrow">@eyebrow</div>
            }
            <h1>@Model.Title</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p>@Model.Description</p>
            }
        </div>
    </div>

    @if (Model.Actions.Count > 0)
    {
        <div class="admin-page-header__actions" aria-label="Page actions">
            @foreach (var action in Model.Actions)
            {
                if (!string.IsNullOrWhiteSpace(action.ModalTarget))
                {
                    <button type="button" class="btn @(action.IsPrimary ? "btn-primary" : "btn-outline-secondary")" data-bs-toggle="modal" data-bs-target="@action.ModalTarget">
                        @if (!string.IsNullOrWhiteSpace(action.Icon))
                        {
                            <i class="bi @action.Icon" aria-hidden="true"></i>
                        }
                        <span>@action.Text</span>
                    </button>
                }
                else if (!string.IsNullOrWhiteSpace(action.Href) && action.UsesPost)
                {
                    <form method="post" action="@action.Href" asp-antiforgery="true">
                        <button type="submit" class="btn @(action.IsPrimary ? "btn-primary" : "btn-outline-secondary")">
                            @if (!string.IsNullOrWhiteSpace(action.Icon))
                            {
                                <i class="bi @action.Icon" aria-hidden="true"></i>
                            }
                            <span>@action.Text</span>
                        </button>
                    </form>
                }
                else if (!string.IsNullOrWhiteSpace(action.Href))
                {
                    <a href="@action.Href"
                       class="btn @(action.IsPrimary ? "btn-primary" : "btn-outline-secondary")">
                        @if (!string.IsNullOrWhiteSpace(action.Icon))
                        {
                            <i class="bi @action.Icon" aria-hidden="true"></i>
                        }
                        <span>@action.Text</span>
                    </a>
                }
            }
        </div>
    }
</header>
