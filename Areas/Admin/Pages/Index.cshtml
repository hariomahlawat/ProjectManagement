@page
@model ProjectManagement.Areas.Admin.Pages.AdminIndexModel
@{
    ViewData["Title"] = "Administration";
}

<partial name="~/Areas/Admin/Pages/Shared/_AdminPageHeader.cshtml" model="Model.Header" />

<div class="admin-home">
    @* 1. Find a page or setting: every page the viewer can open, by name, purpose or everyday word. *@
    <section class="admin-home-find" data-admin-home-find aria-label="Find a page or setting">
        <div class="admin-home-find__box">
            <i class="bi bi-search" aria-hidden="true"></i>
            <label class="visually-hidden" for="admin-home-find-input">Find a page or setting</label>
            <input id="admin-home-find-input"
                   type="search"
                   placeholder="Find a page or setting"
                   autocomplete="off"
                   aria-describedby="admin-home-find-hint"
                   aria-controls="admin-home-find-results"
                   aria-keyshortcuts="/"
                   data-admin-home-search />
            <kbd class="admin-home-find__key" aria-hidden="true">/</kbd>
        </div>
        <p id="admin-home-find-hint" class="visually-hidden">Results appear below as you type. Press Enter to open the first one; the arrow keys move through them.</p>
        <p class="visually-hidden" role="status" aria-live="polite" data-admin-home-find-status></p>

        <ul id="admin-home-find-results" class="admin-home-find__results" data-admin-home-find-results hidden>
            @foreach (var entry in Model.SearchEntries)
            {
                <li hidden
                    data-admin-home-find-entry
                    data-title="@entry.Text.ToLowerInvariant()"
                    data-keywords="@entry.Keywords.ToLowerInvariant()"
                    data-label="@entry.SearchLabel">
                    <a href="@entry.Href">
                        <strong>@entry.Text</strong>
                        <span class="admin-home-find__group">@entry.Group</span>
                        <span class="admin-home-find__why">@entry.Description</span>
                    </a>
                </li>
            }
        </ul>
        <p class="admin-home-find__empty" data-admin-home-find-empty hidden>
            @* Keep each @if on its own: text such as "word" written straight before it reads as an e-mail address and the code shows on screen (H2). *@
            @if (Model.AllPagesHref is not null)
            {
                <text>Nothing matches. Try another word, or open <a href="@Model.AllPagesHref">Every admin page</a>.</text>
            }
            else
            {
                <text>Nothing matches. Try another word.</text>
            }
        </p>

        <div class="admin-home-find__try">
            <span>Try:</span>
            @foreach (var example in ProjectManagement.Areas.Admin.Pages.AdminIndexModel.ExampleSearches)
            {
                <button type="button" data-admin-home-try="@example">@example</button>
            }
        </div>
    </section>

    @* 2. One status line: calm unless something needs an administrator. *@
    <section class="admin-home-status admin-home-status--@Model.StatusCss" aria-labelledby="admin-home-status-label">
        <span id="admin-home-status-label" class="admin-home-status__pill">@Model.Status.Label</span>
        <p>@Model.Status.Summary</p>
        @if (Model.HealthHref is not null)
        {
            <a href="@Model.HealthHref">System health <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        }
    </section>

    @* 3. To look at: only shown when something needs an administrator. *@
    @if (Model.LookAt.Count > 0)
    {
        <section class="admin-panel admin-home-lookat" aria-labelledby="admin-home-lookat-title">
            <header class="admin-home-lookat__header">
                <h2 id="admin-home-lookat-title">To look at</h2>
                <small>Only shown when something needs you</small>
            </header>
            <ul class="admin-home-lookat__list">
                @foreach (var item in Model.LookAt)
                {
                    <li class="admin-home-lookat__item@(item.Urgent ? " admin-home-lookat__item--urgent" : string.Empty)">
                        <span class="admin-home-lookat__mark" aria-hidden="true"></span>
                        <div>
                            <strong>@item.Title</strong>
                            <span>@item.Detail</span>
                        </div>
                        @if (item.Href is not null)
                        {
                            <a href="@item.Href">@item.LinkText<span class="visually-hidden">: @item.Title</span></a>
                        }
                    </li>
                }
            </ul>
        </section>
    }

    @* 4. What do you want to do? Six tasks, each with one live figure. *@
    @if (Model.Tiles.Count > 0)
    {
        <section class="admin-home-tasks" aria-labelledby="admin-home-tasks-title">
            <h2 id="admin-home-tasks-title">What do you want to do?</h2>
            <div class="admin-home-tasks__grid">
                @foreach (var tile in Model.Tiles)
                {
                    <a class="admin-home-task" href="@tile.Href">
                        <span class="admin-home-task__icon" aria-hidden="true"><i class="bi @tile.Icon"></i></span>
                        <h3>@tile.Title</h3>
                        <p>@tile.Body</p>
                        @if (!string.IsNullOrEmpty(tile.Fact))
                        {
                            <span class="admin-home-task__fact">@tile.Fact</span>
                        }
                    </a>
                }
            </div>
        </section>
    }

    @* 5. Recent changes by administrators, folded away. *@
    <details class="admin-home-recent">
        <summary>Recent changes by administrators</summary>
        @if (Model.RecentActions.Count > 0)
        {
            <ul>
                @foreach (var action in Model.RecentActions)
                {
                    var presentation = Model.ActionPresentation(action);
                    <li>
                        <span>
                            <strong>@presentation.Label</strong>
                            @if (!string.Equals(action.Message, action.Action, StringComparison.OrdinalIgnoreCase))
                            {
                                <span> · @action.Message</span>
                            }
                        </span>
                        <span class="admin-home-recent__meta"><time>@action.WhenLocal</time> · @action.Actor</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="admin-home-recent__empty">No changes by administrators yet.</p>
        }
        @if (Model.AuditLogHref is not null)
        {
            <p class="admin-home-recent__more"><a href="@Model.AuditLogHref">Open the audit log <i class="bi bi-arrow-right" aria-hidden="true"></i></a></p>
        }
    </details>
</div>
