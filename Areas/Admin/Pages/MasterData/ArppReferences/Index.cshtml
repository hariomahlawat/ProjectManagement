@page
@using ProjectManagement.Services.Arpp
@model ProjectManagement.Areas.Admin.Pages.MasterData.ArppReferences.IndexModel
@{
    ViewData["Title"] = "ARPP values";
    var current = Model.Current;
}

<partial name="~/Areas/Admin/Pages/Shared/_AdminPageHeader.cshtml" model="Model.Header" />
<partial name="~/Areas/Admin/Pages/Shared/_AdminFlashMessages.cshtml" />

@* One ARPP list at a time, on the shared list page (docs/ux/admin-review-3-fixes.md, PR 11). *@
<p class="admin-restore-tabs__current" aria-hidden="true">Showing: <strong>@current.Label</strong></p>
<div class="admin-arpp-list-bar">
    <nav class="admin-restore-tabs" aria-label="ARPP value list" data-admin-restore-tabs>
        @foreach (var item in ProjectManagement.Areas.Admin.Pages.MasterData.ArppReferences.IndexModel.AllLists)
        {
            var isActive = item.Key == current.Key;
            <a class="admin-restore-tabs__tab@(isActive ? " is-active" : string.Empty)"
               asp-page="./Index" asp-route-list="@item.Key"
               aria-current="@(isActive ? "page" : null)">
                <span>@item.Label</span>
                @if (Model.Counts.TryGetValue(item.Key, out var count))
                {
                    <span class="admin-restore-tabs__count"><span class="visually-hidden">: </span>@count<span class="visually-hidden"> values</span></span>
                }
            </a>
        }
    </nav>
    <a class="btn btn-primary btn-sm" asp-page="./Create" asp-route-list="@current.Key">
        <span class="bi bi-plus-lg" aria-hidden="true"></span> Add @current.Definition.Label
    </a>
</div>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<partial name="~/Areas/Admin/Pages/Shared/_AdminReferenceList.cshtml" model="Model.ListModel" />

<section class="admin-guidance-strip" aria-label="Changing ARPP values">
    <span aria-hidden="true"><i class="bi bi-shield-check"></i></span>
    <div>
        <strong>Old ARPP entries keep their wording</strong>
        <p>Editing a value does not change the wording already stored in ARPP entries. Deactivate a value you no longer use; delete only a value no entry uses.</p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
