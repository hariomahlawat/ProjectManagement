@page
@model ProjectManagement.Areas.Admin.Pages.MasterData.IndexModel
@using ProjectManagement.Areas.Admin.Models
@{
    ViewData["Title"] = "Lists used in forms";
}

<partial name="~/Areas/Admin/Pages/Shared/_AdminPageHeader.cshtml" model="Model.Header" />
<partial name="~/Areas/Admin/Pages/Shared/_AdminFlashMessages.cshtml" />

<div class="admin-lists-layout">
    <div class="admin-lists">
        @foreach (var group in Model.Groups)
        {
            var headingId = "lists-" + group.Name.ToLowerInvariant().Replace(" ", "-");
            <section class="admin-lists__group" aria-labelledby="@headingId">
                <h2 id="@headingId" class="admin-lists__group-name">@group.Name</h2>
                <div class="admin-lists__grid">
                    @foreach (var list in group.Lists)
                    {
                        var opensIn = ProjectManagement.Areas.Admin.Pages.MasterData.IndexModel.OpensIn(list);
                        <a class="admin-list-card" href="@Model.DomainUrl(list)">
                            <span class="admin-list-card__head">
                                <span class="admin-list-card__icon" aria-hidden="true"><i class="bi @list.Icon"></i></span>
                                <strong>@list.Title</strong>
                                <span class="admin-list-card__count">@ProjectManagement.Areas.Admin.Pages.MasterData.IndexModel.Values(list)</span>
                            </span>
                            <span class="admin-list-card__description">@list.Description</span>
                            <span class="admin-list-card__where">
                                Used in: @list.UsedIn
                                @if (opensIn is not null)
                                {
                                    <span> · Opens in @opensIn <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></span>
                                }
                            </span>
                        </a>
                    }
                </div>
            </section>
        }

        <section class="admin-lists__rule" aria-label="Values that records use">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <p>
                <strong>A value that records use cannot be deleted.</strong>
                Deactivate it instead: records that use it keep it, and forms stop offering it.
                <a asp-area="Admin" asp-page="/Help/Index" asp-fragment="master-data">How lists work</a>
            </p>
        </section>
    </div>

    <aside class="admin-panel admin-master-activity" aria-labelledby="master-activity-title">
        <header class="admin-panel__header">
            <div>
                <h2 id="master-activity-title">Recent changes to the lists</h2>
            </div>
            <a asp-area="Admin" asp-page="/Logs/Index" asp-route-Category="master data">Open the audit log</a>
        </header>
        @if (Model.Snapshot.RecentChanges.Count == 0)
        {
            <partial name="~/Areas/Admin/Pages/Shared/_AdminEmptyState.cshtml"
                     model="@(new AdminEmptyStateModel
                     {
                         Icon = "bi-clock-history",
                         Title = "No changes yet",
                         Description = "Added, renamed and deactivated values appear here."
                     })" />
        }
        else
        {
            <div class="admin-master-change-list">
                @foreach (var change in Model.Snapshot.RecentChanges)
                {
                    <article>
                        <span class="admin-master-change-list__icon admin-master-change-list__icon--@change.Tone" aria-hidden="true"><i class="bi @change.Icon"></i></span>
                        <div>
                            <strong>@change.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(change.Message))
                            {
                                <span>@change.Message</span>
                            }
                            <small>@(string.IsNullOrWhiteSpace(change.Actor) ? "System" : change.Actor) · @Model.FormatIst(change.WhenUtc)</small>
                        </div>
                    </article>
                }
            </div>
        }
    </aside>
</div>
