@page
@model ProjectManagement.Areas.Admin.Pages.Recovery.IndexModel
@using ProjectManagement.Services.Admin.Recovery
@{
    ViewData["Title"] = "Restore deleted items";
}

<partial name="~/Areas/Admin/Pages/Shared/_AdminPageHeader.cshtml" model="Model.Header" />

@await Component.InvokeAsync("RestoreTabs", new { active = AdminRestoreTabKeys.Overview })

<section class="admin-panel admin-restore-overview" aria-labelledby="restore-kinds-title">
    <header class="admin-restore-overview__header">
        <h2 id="restore-kinds-title">What can be restored</h2>
        <small>Open a kind to restore items or to delete them for good</small>
    </header>
    <ul class="admin-restore-overview__list">
        @foreach (var kind in Model.Kinds)
        {
            <li>
                <a href="@kind.Href" class="admin-restore-overview__kind">
                    <span class="admin-restore-overview__count">@(kind.Count?.ToString("N0") ?? "–")</span>
                    <span class="admin-restore-overview__copy">
                        <strong>@kind.Label</strong>
                        <span>@kind.KeptFor</span>
                    </span>
                    <i class="bi @(kind.OpensAnotherPage ? "bi-box-arrow-up-right" : "bi-chevron-right")" aria-hidden="true"></i>
                </a>
            </li>
        }
    </ul>
    @if (Model.ArchivedProjectsHref is not null)
    {
        <p class="admin-restore-overview__note">
            Archived projects are not deleted; they are only hidden from everyday views.
            Find them in <a href="@Model.ArchivedProjectsHref">Archived projects</a>.
        </p>
    }
</section>

<section class="admin-panel" aria-labelledby="recent-recovery-title">
    <header class="admin-panel__header">
        <div><h2 id="recent-recovery-title">Recent restores and permanent deletions</h2></div>
        <a class="admin-panel__link" asp-area="Admin" asp-page="/Logs/Index" asp-route-Category="Recovery">Open the audit log <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
    </header>
    @if (Model.Summary.RecentOperations.Count == 0)
    {
        <partial name="~/Areas/Admin/Pages/Shared/_AdminEmptyState.cshtml" model="@(new ProjectManagement.Areas.Admin.Models.AdminEmptyStateModel { Icon = "bi-clock-history", Title = "Nothing restored or deleted for good yet", Description = "Restores and permanent deletions appear here when they happen." })" />
    }
    else
    {
        <div class="admin-recovery-activity-list">
            @foreach (var operation in Model.Summary.RecentOperations)
            {
                <article>
                    <span class="admin-recovery-activity-list__icon admin-recovery-activity-list__icon--@operation.Tone"><i class="bi @operation.Icon" aria-hidden="true"></i></span>
                    <div><strong>@operation.Title</strong><small>@(string.IsNullOrWhiteSpace(operation.Detail) ? operation.Action : operation.Detail)</small></div>
                    <div class="admin-recovery-activity-list__meta"><span>@(operation.Actor ?? "System")</span><time datetime="@operation.WhenUtc.ToString("O")">@Model.FormatTime(operation.WhenUtc)</time></div>
                </article>
            }
        </div>
    }
</section>
