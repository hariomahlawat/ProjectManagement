@page
@model ProjectManagement.Areas.Admin.Pages.Maintenance.IndexModel
@using ProjectManagement.Services.Navigation.ModuleNav
@{
    ViewData["Title"] = "Data jobs";
}

<partial name="~/Areas/Admin/Pages/Shared/_AdminPageHeader.cshtml" model="Model.Header" />

<div class="admin-maintenance-grid">
    <section class="admin-panel admin-maintenance-card" aria-labelledby="pdf-maintenance-title">
        <header class="admin-panel__header">
            <div><h2 id="pdf-maintenance-title">Copy PDFs into the repository</h2></div>
            <span class="admin-status-pill admin-status-pill--@(Model.Summary.PdfIngestionRunning ? "warning" : Model.Summary.LastPdfRun?.Status switch { "Failed" => "danger", "Completed" or null => "success", _ => "warning" })">
                @(Model.Summary.PdfIngestionRunning ? "Running" : Model.Summary.LastPdfRun?.Status ?? "Ready")
            </span>
        </header>
        <div class="admin-maintenance-card__body">
            <div class="admin-maintenance-card__icon"><i class="bi bi-file-earmark-arrow-up"></i></div>
            <div>
                <p>Adds the PDFs attached to FFC, IPR and activity records to the document repository, so they can be searched. PDFs already there are skipped, and only one run can happen at a time.</p>
                @if (Model.Summary.LastPdfRun is not null)
                {
                    <dl class="admin-maintenance-facts">
                        <div><dt>Last run</dt><dd>@Model.FormatTime(Model.Summary.LastPdfRun.CompletedAtUtc)</dd></div>
                        <div><dt>Outcome</dt><dd>@Model.Summary.LastPdfRun.Status</dd></div>
                        <div><dt>PDFs</dt><dd>@Model.Summary.LastPdfRun.Discovered found · @Model.Summary.LastPdfRun.IngestedOrLinked added</dd></div>
                        <div><dt>Duration</dt><dd>@Model.FormatDuration(Model.Summary.LastPdfRun.Duration)</dd></div>
                    </dl>
                }
                else
                {
                    <div class="admin-inline-notice"><i class="bi bi-info-circle"></i><span>No run since PRISM last started. Earlier runs are in the audit log.</span></div>
                }
            </div>
        </div>
        <footer class="admin-maintenance-card__footer">
            <a class="btn btn-primary" href="@Model.Path(AdminNavigationKeys.PdfIngestion)"><i class="bi bi-play-circle" aria-hidden="true"></i> Open</a>
            <a class="btn btn-outline-secondary" asp-area="Admin" asp-page="/Logs/Index" asp-route-Category="pdf-ingestion">Past runs</a>
        </footer>
    </section>

    <section class="admin-panel admin-maintenance-card" aria-labelledby="legacy-maintenance-title">
        <header class="admin-panel__header">
            <div><h2 id="legacy-maintenance-title">Legacy project import</h2></div>
        </header>
        <div class="admin-maintenance-card__body">
            <div class="admin-maintenance-card__icon"><i class="bi bi-database-up"></i></div>
            <div>
                <p>Brings in projects from an approved Excel workbook (legacy import). PRISM first shows every row, with warnings and errors; nothing is saved until you confirm.</p>
                <dl class="admin-maintenance-facts">
                    <div><dt>Imports</dt><dd>@Model.Summary.LegacyImportRuns</dd></div>
                    <div><dt>Projects imported</dt><dd>@Model.Summary.LegacyProjectsImported</dd></div>
                    <div><dt>Last import</dt><dd>@Model.FormatTime(Model.Summary.LastLegacyImportUtc)</dd></div>
                    <div><dt>Last run by</dt><dd>@(Model.Summary.LastLegacyImportBy ?? "—")</dd></div>
                </dl>
            </div>
        </div>
        <footer class="admin-maintenance-card__footer">
            <a class="btn btn-primary" href="@Model.Path(AdminNavigationKeys.LegacyImport)"><i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i> Check a workbook</a>
            <a class="btn btn-outline-secondary" asp-area="Admin" asp-page="/Logs/Index" asp-route-Category="legacy-import">Past runs</a>
        </footer>
    </section>
</div>

<p class="admin-lists__rule admin-data-jobs__note">
    <i class="bi bi-info-circle" aria-hidden="true"></i>
    <span>Running a job twice is safe: records already brought in are recognised and not added again.</span>
</p>
