@model ProjectManagement.Areas.Admin.Pages.Lookups.LookupItemModel
@using ProjectManagement.Areas.Admin.Models
@* The Add and Edit form of Project types, Sponsoring units and Line directorates, on the
   shared list form (docs/ux/admin-review-4-fixes.md, PRs 4 and 5). *@
@{
    var list = Model.List;
    Func<object?, Microsoft.AspNetCore.Html.IHtmlContent> fields =
        @<text>
            @if (Model.IsEdit)
            {
                <input asp-for="Input.Id" type="hidden" />
                <input asp-for="Input.RowVersion" type="hidden" />
                <input asp-for="Input.SortOrder" type="hidden" />
            }
            <div class="admin-field">
                <label asp-for="Input.Name">Name</label>
                <input asp-for="Input.Name" class="form-control" maxlength="200" autocomplete="off" autofocus="@(!Model.IsEdit)" />
                @if (Model.IsEdit)
                {
                    <small class="admin-field__hint">@AdminListFormWords.RenameHint(list.Definition.Key)</small>
                }
                else
                {
                    <small class="admin-field__hint">It is added at the end of the list.</small>
                }
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
        </text>;
    var form = AdminListFormModel.For(list.Definition, Model.IsEdit, list.Icon, Url.Page("./Index"), fields);
}
<partial name="~/Areas/Admin/Pages/Shared/_AdminListForm.cshtml" model="form" />
