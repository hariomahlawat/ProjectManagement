@page
@model ProjectManagement.Areas.Admin.Pages.Diagnostics.SearchIndexModel
@inject ProjectManagement.Services.Admin.IAdminTimeService Time
@{
    ViewData["Title"] = "Search index";
    var ready = Model.Health.IsReady && Model.Health.IndexVersion == Model.ConfiguredProjectionVersion;
}

<header class="admin-page-header">
    <div class="admin-page-header__content">
        <div class="admin-page-header__eyebrow">System health</div>
        <h1><i class="bi bi-search me-2" aria-hidden="true"></i>Search index</h1>
        <p>Whether PRISM search is up to date. Retry items that could not be added to search, or rebuild the whole index; search keeps working while it rebuilds.</p>
    </div>
    <div class="admin-page-header__actions">
        <a asp-area="Admin" asp-page="/Diagnostics/DbHealth" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>System health</a>
        @if (Model.CanMaintain)
        {
            <form method="post" asp-page-handler="Rebuild" data-confirm="Rebuild the search index? Search keeps using the current index until the new one is ready.">
                <button type="submit" class="btn btn-primary"><i class="bi bi-arrow-repeat me-1"></i>Rebuild search index</button>
            </form>
        }
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info" role="status">@Model.StatusMessage</div>
}

<section class="admin-monitoring-metric-grid" aria-label="Search index summary">
    <article class="admin-monitoring-metric admin-monitoring-metric--@(ready ? "success" : "warning")">
        <span class="admin-monitoring-metric__icon" aria-hidden="true"><i class="bi @(ready ? "bi-check-circle" : "bi-exclamation-triangle")"></i></span>
        <span class="admin-monitoring-metric__copy"><strong>@(ready ? "Working" : "Not ready")</strong><span>Search</span><small>Index build @Model.Health.ActiveGeneration</small></span>
    </article>
    <article class="admin-monitoring-metric">
        <span class="admin-monitoring-metric__icon" aria-hidden="true"><i class="bi bi-diagram-3"></i></span>
        <span class="admin-monitoring-metric__copy"><strong>@Model.Health.IndexVersion</strong><span>Index version</span><small>This version of PRISM needs @Model.ConfiguredProjectionVersion</small></span>
    </article>
    <article class="admin-monitoring-metric">
        <span class="admin-monitoring-metric__icon" aria-hidden="true"><i class="bi bi-files"></i></span>
        <span class="admin-monitoring-metric__copy"><strong>@Model.Health.EntryCount.ToString("N0")</strong><span>Items searchable</span><small>Index format @Model.SearchSchemaVersion</small></span>
    </article>
    <article class="admin-monitoring-metric">
        <span class="admin-monitoring-metric__icon" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
        <span class="admin-monitoring-metric__copy"><strong>@Model.Health.PendingItems.ToString("N0")</strong><span>Waiting to be indexed</span><small>@Model.Health.FailedItems.ToString("N0") failed</small></span>
    </article>
</section>

<section class="admin-panel mt-3">
    <header class="admin-panel__header">
        <div><div class="admin-panel__eyebrow">Generation lifecycle</div><h2>Current state</h2></div>
    </header>
    <div class="admin-health-facts">
        <article class="admin-health-fact"><span class="admin-health-fact__icon"><i class="bi bi-clock-history"></i></span><div><small>Whole index last rebuilt</small><strong>@Time.FormatIst(Model.Health.LastFullRebuildUtc)</strong><span>Search keeps working while it rebuilds</span></div></article>
        <article class="admin-health-fact"><span class="admin-health-fact__icon"><i class="bi bi-arrow-repeat"></i></span><div><small>Last full check</small><strong>@Time.FormatIst(Model.Health.LastReconciliationUtc)</strong><span>Runs once a day</span></div></article>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Health.LastError))
    {
        <div class="admin-inline-notice admin-inline-notice--danger mt-3"><i class="bi bi-exclamation-octagon"></i><span>@Model.Health.LastError</span></div>
    }
</section>

<section class="admin-panel mt-3">
    <header class="admin-panel__header">
        <div><div class="admin-panel__eyebrow">Relevance diagnostics</div><h2>Ranking inspector</h2></div>
    </header>
    <p class="text-muted small mb-2">Runs the production Search V2 ranker with your current authorization context and shows the first ten canonical results, including the winning relevance tier and contributing retrieval channels. It does not write search analytics.</p>
    <form method="get" class="row g-2 align-items-end" role="search" aria-label="Inspect Search V2 ranking">
        <div class="col-lg-8">
            <label class="form-label small" for="searchRankInspectQuery">Query</label>
            <input id="searchRankInspectQuery" name="InspectQuery" value="@Model.InspectQuery" class="form-control" autocomplete="off" placeholder="e.g. high tech" />
        </div>
        <div class="col-auto"><button type="submit" class="btn btn-outline-primary"><i class="bi bi-bar-chart-line me-1" aria-hidden="true"></i>Inspect ranking</button></div>
        @if (Model.InspectionRequested)
        {
            <div class="col-12 small text-muted">@(Model.InspectionReady ? $"{Model.InspectionTotalHits:N0} result(s) · {Model.InspectionLatencyMs:N0} ms" : "Search V2 is not ready for inspection.")</div>
        }
    </form>

    @if (Model.InspectionRequested && Model.InspectionReady)
    {
        if (Model.InspectionResults.Count == 0)
        {
            <div class="admin-compact-empty mt-3"><i class="bi bi-search"></i><span>No authorized Search V2 results for this query.</span></div>
        }
        else
        {
            <div class="table-responsive mt-3">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Rank</th><th>Result</th><th>Source</th><th>Matched in</th><th>Tier</th><th>Channels</th><th>RRF score</th></tr></thead>
                    <tbody>
                    @foreach (var result in Model.InspectionResults)
                    {
                        <tr>
                            <td><strong>@result.Rank</strong></td>
                            <td><a href="@result.Url">@result.Title</a></td>
                            <td><span class="small">@result.Category · @result.SourceModule</span></td>
                            <td><span class="small">@(result.MatchedField ?? "—")</span></td>
                            <td>@(result.MatchTier?.ToString() ?? "—")</td>
                            <td><code class="small">@(string.IsNullOrWhiteSpace(result.MatchChannels) ? "—" : result.MatchChannels)</code></td>
                            <td><code class="small">@result.Score.ToString("0.000000")</code></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

<section class="admin-panel mt-3">
    <header class="admin-panel__header">
        <div><div class="admin-panel__eyebrow">Recovery</div><h2>Failed indexing jobs</h2></div>
        @if (Model.CanMaintain && Model.FailedItems.Count > 0)
        {
            <form method="post" asp-page-handler="RetryAll"><button type="submit" class="btn btn-sm btn-outline-primary">Retry all failed</button></form>
        }
    </header>
    @if (Model.FailedItems.Count == 0)
    {
        <div class="admin-compact-empty"><i class="bi bi-check-circle"></i><span>No failed Search V2 indexing jobs.</span></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th>Entity</th><th>Key</th><th>Attempts</th><th>Requested</th><th>Last error</th><th></th></tr></thead>
                <tbody>
                @foreach (var item in Model.FailedItems)
                {
                    <tr>
                        <td>@item.EntityType</td><td><code>@item.EntityKey</code></td><td>@item.RetryCount</td><td>@item.RequestedAtUtc.ToLocalTime().ToString("dd MMM HH:mm")</td>
                        <td class="text-break small">@(string.IsNullOrWhiteSpace(item.LastError) ? "—" : item.LastError)</td>
                        <td class="text-end">
                            @if (Model.CanMaintain)
                            {
                                <form method="post" asp-page-handler="Retry"><input type="hidden" name="id" value="@item.Id" /><button type="submit" class="btn btn-sm btn-outline-secondary">Retry</button></form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
