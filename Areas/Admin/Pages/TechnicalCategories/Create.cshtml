@page
@model ProjectManagement.Areas.Admin.Pages.TechnicalCategories.CreateModel
@using ProjectManagement.Areas.Admin.Models
@using ProjectManagement.Services.Admin.MasterData.ReferenceLists
@* On the shared list form (docs/ux/admin-review-4-fixes.md, PR 5). *@
@{
    ViewData["Title"] = "Add technical category";
    Func<object?, Microsoft.AspNetCore.Html.IHtmlContent> fields =
        @<text>
            <div class="admin-form-grid admin-form-grid--two">
                <div class="admin-field">
                    <label asp-for="Input.Name">Name</label>
                    <input asp-for="Input.Name" class="form-control" maxlength="120" autocomplete="off" autofocus />
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>
                <div class="admin-field">
                    <label asp-for="Input.ParentId">Parent category</label>
                    <select asp-for="Input.ParentId" asp-items="Model.ParentOptions" class="form-select"></select>
                    <small class="admin-field__hint">Leave blank for a top-level category.</small>
                    <span asp-validation-for="Input.ParentId" class="text-danger"></span>
                </div>
            </div>
            <label class="admin-switch-row"><input asp-for="Input.IsActive" type="checkbox" class="form-check-input" /><span><strong>Active</strong><small>@AdminListFormWords.ActiveHint</small></span></label>
        </text>;
    var form = AdminListFormModel.For(ReferenceListCatalog.TechnicalCategories, isEdit: false, "bi-cpu", Url.Page("./Index"), fields);
}
<partial name="~/Areas/Admin/Pages/Shared/_AdminListForm.cshtml" model="form" />
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
