@page
@model ProjectManagement.Areas.Admin.Pages.Documents.IngestExternalPdfsModel
@{
    ViewData["Title"] = "Copy PDFs into the repository";
    var current = Model.Result;
}

<partial name="~/Areas/Admin/Pages/Shared/_AdminFlashMessages.cshtml" />
<partial name="~/Areas/Admin/Pages/Shared/_AdminPageHeader.cshtml" model="Model.Header" />

<section class="admin-panel admin-ingestion-control" aria-labelledby="ingestion-control-title">
    <div class="admin-ingestion-control__body">
        <span class="admin-ingestion-control__icon"><i class="bi bi-file-earmark-arrow-up"></i></span>
        <div><h2 id="ingestion-control-title">Copy the PDFs now</h2><p>PDFs already in the repository are skipped. The FFC, IPR and activity records themselves are not changed.</p><div class="admin-ingestion-principles"><span><i class="bi bi-shield-check"></i> Written to the audit log</span><span><i class="bi bi-lock"></i> One run at a time</span><span><i class="bi bi-hourglass-split"></i> Finishes even if you leave this page</span><span><i class="bi bi-arrow-repeat"></i> Safe to run again</span></div></div>
    </div>
    <form method="post" asp-page-handler="Run" data-pdf-ingestion-form>
        <button type="submit" class="btn btn-primary btn-lg" disabled="@Model.IsRunning" data-pdf-ingestion-submit><i class="bi @(Model.IsRunning ? "bi-hourglass-split" : "bi-play-circle")"></i> @(Model.IsRunning ? "Copying…" : "Copy PDFs")</button>
    </form>
</section>

@if (current is not null)
{
    <section class="admin-monitoring-metrics admin-monitoring-metrics--six" aria-label="Results of the last run">
        <article class="admin-monitoring-metric admin-monitoring-metric--neutral"><span class="admin-monitoring-metric__copy"><strong>@current.Discovered</strong><span>PDFs found</span><small>On FFC, IPR and activity records</small></span></article>
        <article class="admin-monitoring-metric admin-monitoring-metric--success"><span class="admin-monitoring-metric__copy"><strong>@current.IngestedOrLinked</strong><span>Copied</span><small>Now in the repository</small></span></article>
        <article class="admin-monitoring-metric admin-monitoring-metric--info"><span class="admin-monitoring-metric__copy"><strong>@current.AlreadyLinked</strong><span>Already there</span><small>Skipped</small></span></article>
        <article class="admin-monitoring-metric admin-monitoring-metric--warning"><span class="admin-monitoring-metric__copy"><strong>@current.Missing</strong><span>File missing</span><small>The PDF could not be found</small></span></article>
        <article class="admin-monitoring-metric admin-monitoring-metric--danger"><span class="admin-monitoring-metric__copy"><strong>@current.Failed</strong><span>Failed</span><small>Listed below</small></span></article>
        <article class="admin-monitoring-metric admin-monitoring-metric--@(current.Status == "Completed" ? "success" : current.Status == "Failed" ? "danger" : "warning")"><span class="admin-monitoring-metric__copy"><strong>@current.Status</strong><span>Result</span><small>@Model.FormatDuration(current.Duration)</small></span></article>
    </section>

    <div class="admin-maintenance-run-grid">
        <section class="admin-panel" aria-labelledby="source-summary-title">
            <header class="admin-panel__header"><div><h2 id="source-summary-title">By module</h2></div><span class="admin-panel__meta">@Model.FormatTime(current.CompletedAtUtc)</span></header>
            <div class="admin-table-wrap"><table class="admin-data-table"><thead><tr><th>Module</th><th class="text-end">Found</th><th class="text-end">Copied</th><th class="text-end">Already there</th><th class="text-end">Missing</th><th class="text-end">Failed</th></tr></thead><tbody>@foreach (var source in current.Sources){<tr><td><div class="admin-table-primary">@source.Source</div></td><td class="text-end">@source.Discovered</td><td class="text-end">@source.IngestedOrLinked</td><td class="text-end">@source.AlreadyLinked</td><td class="text-end">@source.Missing</td><td class="text-end">@source.Failed</td></tr>}</tbody></table></div>
            <footer class="admin-panel__footer">Started @Model.FormatTime(current.StartedAtUtc) · Started by @(current.InitiatedBy ?? "PRISM")@if (!string.IsNullOrWhiteSpace(current.TraceId)){<span> · Reference @current.TraceId</span>}</footer>
        </section>

        <section class="admin-panel" aria-labelledby="recent-ingestion-title">
            <header class="admin-panel__header"><div><h2 id="recent-ingestion-title">Recent runs</h2></div></header>
            @if (Model.RecentRuns.Count == 0)
            {
                <partial name="~/Areas/Admin/Pages/Shared/_AdminEmptyState.cshtml" model="@(new ProjectManagement.Areas.Admin.Models.AdminEmptyStateModel { Icon = "bi-clock-history", Title = "No completed runs", Description = "Runs are listed here until PRISM restarts." })" />
            }
            else
            {
                <div class="admin-maintenance-run-list">@foreach (var run in Model.RecentRuns){<a asp-page="./IngestExternalPdfs" asp-route-RunId="@run.RunId" class="@(run.RunId == current.RunId ? "active" : null)"><span class="admin-status-dot admin-status-dot--@(run.Status == "Completed" ? "success" : run.Status == "Failed" ? "danger" : "warning")"></span><div><strong>@run.Status</strong><small>@Model.FormatTime(run.CompletedAtUtc) · @run.Discovered found</small></div><i class="bi bi-chevron-right"></i></a>}</div>
            }
        </section>
    </div>

    @if (current.Failures.Count > 0)
    {
        <section class="admin-panel" aria-labelledby="ingestion-failures-title">
            <header class="admin-panel__header"><div><h2 id="ingestion-failures-title">PDFs that were not copied</h2></div><a class="btn btn-sm btn-outline-secondary" asp-page-handler="FailureReport" asp-route-runId="@current.RunId"><i class="bi bi-download"></i> Download CSV</a></header>
            <div class="admin-table-wrap"><table class="admin-data-table"><thead><tr><th>Module</th><th>Record</th><th>File</th><th>What went wrong</th></tr></thead><tbody>@foreach (var failure in current.Failures){<tr><td><span class="admin-status-pill admin-status-pill--neutral">@failure.Source</span></td><td><code>@failure.SourceItemId</code></td><td class="admin-break-word">@failure.FileName</td><td>@failure.Message</td></tr>}</tbody></table></div>
            @if (current.Missing + current.Failed > current.Failures.Count){<footer class="admin-panel__footer">Only the first @current.Failures.Count are listed here. The full list is in the application log.</footer>}
        </section>
    }
}
else
{
    <section class="admin-panel"><partial name="~/Areas/Admin/Pages/Shared/_AdminEmptyState.cshtml" model="@(new ProjectManagement.Areas.Admin.Models.AdminEmptyStateModel { Icon = "bi-file-earmark-arrow-up", Title = "Not run since PRISM started", Description = "Use Copy PDFs to add the FFC, IPR and activity PDFs to the repository." })" /></section>
}

@section Scripts { <script src="~/js/admin/admin-maintenance.js" asp-append-version="true" defer></script> }
