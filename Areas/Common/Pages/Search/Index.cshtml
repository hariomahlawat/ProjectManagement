@page
@model ProjectManagement.Areas.Common.Pages.Search.IndexModel
@using Microsoft.AspNetCore.Http
@using ProjectManagement.Services.SearchV2.Models
@{
    ViewData["Title"] = "Global Search";
    var hasQuery = !string.IsNullOrWhiteSpace(Model.Q);
    var selectedCategory = (Model.Category ?? Array.Empty<string>())
        .FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));
    var selectedSources = new HashSet<string>(
        (Model.Source ?? Array.Empty<string>()).Where(value => !string.IsNullOrWhiteSpace(value)),
        StringComparer.OrdinalIgnoreCase);
    var selectedProjects = new HashSet<int>((Model.Project ?? Array.Empty<int>()).Where(value => value > 0));
    var selectedStatuses = new HashSet<string>((Model.Status ?? Array.Empty<string>()).Where(value => !string.IsNullOrWhiteSpace(value)), StringComparer.OrdinalIgnoreCase);
    var selectedFileTypes = new HashSet<string>((Model.FileType ?? Array.Empty<string>()).Where(value => !string.IsNullOrWhiteSpace(value)), StringComparer.OrdinalIgnoreCase);
    var selectedStages = new HashSet<string>((Model.Stage ?? Array.Empty<string>()).Where(value => !string.IsNullOrWhiteSpace(value)), StringComparer.OrdinalIgnoreCase);
    var activeFilterCount = selectedSources.Count + selectedProjects.Count + selectedStatuses.Count + selectedFileTypes.Count + selectedStages.Count
        + (Model.DateFrom.HasValue ? 1 : 0) + (Model.DateTo.HasValue ? 1 : 0);
    var CategoryOrder = new[] { "Projects", "Documents", "Trackers", "Organisation", "My Work", "Media" };
    var orderedCategoryFacets = CategoryOrder
        .Select(category => Model.Search.Facets.Categories.FirstOrDefault(facet => string.Equals(facet.Value, category, StringComparison.OrdinalIgnoreCase)))
        .Where(facet => facet is not null)
        .Cast<SearchFacetValue>()
        .ToArray();


    string CategoryLabel(string? category) =>
        string.Equals(category, "Trackers", StringComparison.OrdinalIgnoreCase) ? "Records" : category ?? string.Empty;

    string BuildUrl(
        string query,
        string? category,
        string? cursor = null,
        bool preserveSources = true,
        bool preserveAdvanced = true)
    {
        var values = new List<KeyValuePair<string, string?>>
        {
            new("q", query)
        };
        if (!string.IsNullOrWhiteSpace(category)) values.Add(new("Category", category));
        if (preserveSources)
        {
            foreach (var source in selectedSources) values.Add(new("Source", source));
        }
        if (preserveAdvanced)
        {
            foreach (var project in selectedProjects) values.Add(new("Project", project.ToString(System.Globalization.CultureInfo.InvariantCulture)));
            foreach (var status in selectedStatuses) values.Add(new("Status", status));
            foreach (var fileType in selectedFileTypes) values.Add(new("FileType", fileType));
            foreach (var stage in selectedStages) values.Add(new("Stage", stage));
            if (Model.DateFrom.HasValue) values.Add(new("DateFrom", Model.DateFrom.Value.ToString("yyyy-MM-dd")));
            if (Model.DateTo.HasValue) values.Add(new("DateTo", Model.DateTo.Value.ToString("yyyy-MM-dd")));
        }
        if (!string.IsNullOrWhiteSpace(cursor)) values.Add(new("Cursor", cursor));
        return QueryString.Create(values).ToString();
    }

    string BuildUrlRemoving(string dimension, string value)
    {
        var values = new List<KeyValuePair<string, string?>> { new("q", Model.Q) };
        if (!string.IsNullOrWhiteSpace(selectedCategory) && !string.Equals(dimension, "Category", StringComparison.OrdinalIgnoreCase))
            values.Add(new("Category", selectedCategory));

        foreach (var source in selectedSources)
            if (!(string.Equals(dimension, "Source", StringComparison.OrdinalIgnoreCase) && string.Equals(source, value, StringComparison.OrdinalIgnoreCase))) values.Add(new("Source", source));
        foreach (var project in selectedProjects)
            if (!(string.Equals(dimension, "Project", StringComparison.OrdinalIgnoreCase) && string.Equals(project.ToString(System.Globalization.CultureInfo.InvariantCulture), value, StringComparison.OrdinalIgnoreCase))) values.Add(new("Project", project.ToString(System.Globalization.CultureInfo.InvariantCulture)));
        foreach (var status in selectedStatuses)
            if (!(string.Equals(dimension, "Status", StringComparison.OrdinalIgnoreCase) && string.Equals(status, value, StringComparison.OrdinalIgnoreCase))) values.Add(new("Status", status));
        foreach (var fileType in selectedFileTypes)
            if (!(string.Equals(dimension, "FileType", StringComparison.OrdinalIgnoreCase) && string.Equals(fileType, value, StringComparison.OrdinalIgnoreCase))) values.Add(new("FileType", fileType));
        foreach (var stage in selectedStages)
            if (!(string.Equals(dimension, "Stage", StringComparison.OrdinalIgnoreCase) && string.Equals(stage, value, StringComparison.OrdinalIgnoreCase))) values.Add(new("Stage", stage));
        if (Model.DateFrom.HasValue && !string.Equals(dimension, "DateFrom", StringComparison.OrdinalIgnoreCase)) values.Add(new("DateFrom", Model.DateFrom.Value.ToString("yyyy-MM-dd")));
        if (Model.DateTo.HasValue && !string.Equals(dimension, "DateTo", StringComparison.OrdinalIgnoreCase)) values.Add(new("DateTo", Model.DateTo.Value.ToString("yyyy-MM-dd")));
        return QueryString.Create(values).ToString();
    }

    string BuildRelatedUrl(SearchResult hit, SearchRelatedResult related)
    {
        var values = new List<KeyValuePair<string, string?>>
        {
            new("q", Model.Q),
            new("Source", related.SourceModule)
        };
        var projectId = hit.ParentProjectId;
        if (!projectId.HasValue && string.Equals(hit.CanonicalEntityType, "Project", StringComparison.OrdinalIgnoreCase)
            && int.TryParse(hit.CanonicalEntityKey, out var parsedProjectId))
        {
            projectId = parsedProjectId;
        }
        if (projectId.HasValue) values.Add(new("Project", projectId.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)));
        return QueryString.Create(values).ToString();
    }
}

<div class="pm-gs-page" data-search-page>
@if (!hasQuery)
{
    <section class="pm-gs-hero" aria-labelledby="searchTitle">
        <div class="pm-gs-brandmark" aria-hidden="true"><span>PRISM</span></div>
        <h1 id="searchTitle" class="pm-gs-hero__title">Search PRISM</h1>
        <p class="pm-gs-hero__tag">Find projects, documents, FFC, IPR, activities, visits, training, ToT, proliferation and ARPP records.</p>

        <form method="get" asp-area="Common" asp-page="/Search/Index" class="pm-gs-search" role="search" aria-label="Global search">
            <i class="bi bi-search pm-gs-search__icon" aria-hidden="true"></i>
            <label class="visually-hidden" for="prismSearchHero">Search PRISM</label>
            <input id="prismSearchHero"
                   type="search"
                   name="q"
                   class="pm-gs-search__input"
                   placeholder="Search projects, identifiers, documents and records"
                   autocomplete="off"
                   spellcheck="false"
                   data-search-suggest
                   aria-autocomplete="list"
                   aria-expanded="false" />
            <button class="pm-gs-search__clear" type="button" data-clear aria-label="Clear search"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            <button class="pm-gs-search__btn" type="submit">Search</button>
            <div class="pm-gs-suggestions" data-search-suggestions hidden></div>
        </form>

        <div class="pm-gs-hero__hints" aria-label="Search examples">
            <span>Try:</span>
            <a href="?q=AURA">AURA</a>
            <a href="?q=ARPP">ARPP</a>
            <a href="?q=autonomous+surveillance">autonomous surveillance</a>
        </div>
    </section>
}
else
{
    <header class="pm-gs-top">
        <div class="pm-gs-top__inner">
            <form method="get" asp-area="Common" asp-page="/Search/Index" class="pm-gs-top__form" role="search" aria-label="Global search">
                <div class="pm-gs-top__search">
                    <i class="bi bi-search pm-gs-top__icon" aria-hidden="true"></i>
                    <label class="visually-hidden" for="prismSearchResults">Search PRISM</label>
                    <input id="prismSearchResults"
                           type="search"
                           name="q"
                           value="@Model.Q"
                           class="pm-gs-top__input"
                           placeholder="Search PRISM"
                           autocomplete="off"
                           spellcheck="false"
                           data-search-suggest
                           aria-autocomplete="list"
                           aria-expanded="false" />
                    <button class="pm-gs-top__clear" type="button" data-clear aria-label="Clear search"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                    <div class="pm-gs-suggestions" data-search-suggestions hidden></div>
                </div>
                <button class="pm-gs-top__button" type="submit">Search</button>
            </form>

            @if (Model.Search.Facets.Categories.Count > 0)
            {
                <nav class="pm-gs-tabs" aria-label="Result categories">
                    <a class="pm-gs-tab @(selectedCategory is null ? "is-active" : string.Empty)" href="@BuildUrl(Model.Q!, null)">All <span class="pm-gs-tab__count">@Model.Search.TotalHits</span></a>
                    @foreach (var facet in orderedCategoryFacets)
                    {
                        <a class="pm-gs-tab @(string.Equals(selectedCategory, facet.Value, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)"
                           href="@BuildUrl(Model.Q!, facet.Value)">
                            @CategoryLabel(facet.Value) <span class="pm-gs-tab__count">@facet.Count</span>
                        </a>
                    }
                </nav>
            }
        </div>
    </header>

    <main class="pm-gs-body" role="main">
        <div class="pm-gs-body__inner">
            <section class="pm-gs-toolbar" aria-label="Search result controls">
                <div>
                    @if (Model.Search.IsPartial)
                    {
                        <div class="pm-gs-meta"><strong>Results</strong></div>
                    }
                    else
                    {
                        <div class="pm-gs-meta"><strong>@Model.Search.FilteredHits</strong> result@(Model.Search.FilteredHits == 1 ? "" : "s") <span>· @Model.Search.QueryTimeMilliseconds ms</span></div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Search.CorrectedQuery))
                    {
                        <div class="pm-gs-correction">
                            Did you mean <a href="?q=@Uri.EscapeDataString(Model.Search.CorrectedQuery)"><strong>@Model.Search.CorrectedQuery</strong></a>?
                        </div>
                    }

                    @if (Model.ShowEngineDiagnostics)
                    {
                        <div class="pm-gs-engine-diagnostic @(Model.Search.FellBackToLegacy ? "is-fallback" : string.Empty)" role="status">
                            <span>Engine: @Model.Search.EngineLabel</span>
                            @if (Model.Search.FellBackToLegacy)
                            {
                                <span> · V2: @Model.Search.V2ExecutionStatus</span>
                                @if (!string.IsNullOrWhiteSpace(Model.Search.V2DiagnosticId))
                                {
                                    <span> · ID @Model.Search.V2DiagnosticId</span>
                                }
                            }
                        </div>
                    }
                </div>

                @if (Model.Search.UsedSearchV2 && (Model.Search.TotalHits > 0 || activeFilterCount > 0))
                {
                    <details class="pm-gs-filter">
                        <summary><i class="bi bi-funnel" aria-hidden="true"></i> Filters @(activeFilterCount > 0 ? $"({activeFilterCount})" : string.Empty)</summary>
                        <form method="get" class="pm-gs-filter__panel pm-gs-filter__panel--advanced">
                            <input type="hidden" name="q" value="@Model.Q" />
                            @if (!string.IsNullOrWhiteSpace(selectedCategory))
                            {
                                <input type="hidden" name="Category" value="@selectedCategory" />
                            }

                            @if (Model.Search.Facets.Sources.Count > 0)
                            {
                                <details class="pm-gs-filter__section" open>
                                    <summary>Source <span>@Model.Search.Facets.Sources.Count</span></summary>
                                    <div class="pm-gs-filter__section-body">
                                        @{ var sourceIndex = 0; }
                                        @foreach (var sourceFacet in Model.Search.Facets.Sources)
                                        {
                                            var sourceId = $"source-{sourceIndex++}";
                                            <label class="pm-gs-filter__option" for="@sourceId">
                                                <input id="@sourceId" type="checkbox" name="Source" value="@sourceFacet.Value" checked="@selectedSources.Contains(sourceFacet.Value)" />
                                                <span>@sourceFacet.Value</span>
                                                <small>@sourceFacet.Count</small>
                                            </label>
                                        }
                                    </div>
                                </details>
                            }

                            @if (Model.Search.Facets.Projects.Count > 0)
                            {
                                <details class="pm-gs-filter__section" open="@(selectedProjects.Count > 0 ? "open" : null)">
                                    <summary>Project <span>@Model.Search.Facets.Projects.Count</span></summary>
                                    <div class="pm-gs-filter__section-body" data-project-facet-list>
                                        @if (Model.Search.Facets.Projects.Count > 8)
                                        {
                                            <label class="visually-hidden" for="projectFacetSearch">Filter project facets</label>
                                            <input id="projectFacetSearch" class="pm-gs-filter__facet-search" type="search" placeholder="Find project…" autocomplete="off" data-project-facet-search />
                                        }
                                        @{ var projectIndex = 0; }
                                        @foreach (var projectFacet in Model.Search.Facets.Projects)
                                        {
                                            var projectId = $"project-{projectIndex++}";
                                            var projectValue = int.TryParse(projectFacet.Value, out var parsedProject) ? parsedProject : 0;
                                            var projectLabel = projectFacet.Label ?? projectFacet.Value;
                                            <label class="pm-gs-filter__option" for="@projectId" data-project-facet data-project-label="@projectLabel.ToLowerInvariant()">
                                                <input id="@projectId" type="checkbox" name="Project" value="@projectFacet.Value" checked="@(projectValue > 0 && selectedProjects.Contains(projectValue))" />
                                                <span>@projectLabel</span>
                                                <small>@projectFacet.Count</small>
                                            </label>
                                        }
                                        @if (Model.Search.Facets.Projects.Count > 8)
                                        {
                                            <button class="pm-gs-filter__show-more" type="button" data-project-facet-more>Show more</button>
                                        }
                                    </div>
                                </details>
                            }

                            @if (Model.Search.Facets.Statuses.Count > 0)
                            {
                                <details class="pm-gs-filter__section" open="@(selectedStatuses.Count > 0 ? "open" : null)">
                                    <summary>Status <span>@Model.Search.Facets.Statuses.Count</span></summary>
                                    <div class="pm-gs-filter__section-body">
                                        @{ var statusIndex = 0; }
                                        @foreach (var statusFacet in Model.Search.Facets.Statuses.Take(20))
                                        {
                                            var statusId = $"status-{statusIndex++}";
                                            <label class="pm-gs-filter__option" for="@statusId">
                                                <input id="@statusId" type="checkbox" name="Status" value="@statusFacet.Value" checked="@selectedStatuses.Contains(statusFacet.Value)" />
                                                <span>@statusFacet.Value</span>
                                                <small>@statusFacet.Count</small>
                                            </label>
                                        }
                                    </div>
                                </details>
                            }

                            @if (Model.Search.Facets.FileTypes.Count > 0)
                            {
                                <details class="pm-gs-filter__section" open="@(selectedFileTypes.Count > 0 ? "open" : null)">
                                    <summary>File type <span>@Model.Search.Facets.FileTypes.Count</span></summary>
                                    <div class="pm-gs-filter__section-body">
                                        @{ var fileTypeIndex = 0; }
                                        @foreach (var fileTypeFacet in Model.Search.Facets.FileTypes)
                                        {
                                            var fileTypeId = $"file-type-{fileTypeIndex++}";
                                            <label class="pm-gs-filter__option" for="@fileTypeId">
                                                <input id="@fileTypeId" type="checkbox" name="FileType" value="@fileTypeFacet.Value" checked="@selectedFileTypes.Contains(fileTypeFacet.Value)" />
                                                <span>@fileTypeFacet.Value</span>
                                                <small>@fileTypeFacet.Count</small>
                                            </label>
                                        }
                                    </div>
                                </details>
                            }

                            @if (Model.Search.Facets.Stages.Count > 0)
                            {
                                <details class="pm-gs-filter__section" open="@(selectedStages.Count > 0 ? "open" : null)">
                                    <summary>Stage <span>@Model.Search.Facets.Stages.Count</span></summary>
                                    <div class="pm-gs-filter__section-body">
                                        @{ var stageIndex = 0; }
                                        @foreach (var stageFacet in Model.Search.Facets.Stages)
                                        {
                                            var stageId = $"stage-{stageIndex++}";
                                            <label class="pm-gs-filter__option" for="@stageId">
                                                <input id="@stageId" type="checkbox" name="Stage" value="@stageFacet.Value" checked="@selectedStages.Contains(stageFacet.Value)" />
                                                <span>@stageFacet.Value</span>
                                                <small>@stageFacet.Count</small>
                                            </label>
                                        }
                                    </div>
                                </details>
                            }

                            <details class="pm-gs-filter__section" open="@(Model.DateFrom.HasValue || Model.DateTo.HasValue ? "open" : null)">
                                <summary>Relevant date</summary>
                                <div class="pm-gs-filter__section-body">
                                    <p class="pm-gs-filter__hint">Uses the primary date associated with each result type.</p>
                                    <div class="pm-gs-filter__dates">
                                        <label><span>From</span><input type="date" name="DateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" /></label>
                                        <label><span>To</span><input type="date" name="DateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" /></label>
                                    </div>
                                </div>
                            </details>

                            <div class="pm-gs-filter__actions">
                                <a href="@BuildUrl(Model.Q!, selectedCategory, preserveSources: false, preserveAdvanced: false)" class="btn btn-sm btn-outline-secondary">Clear all</a>
                                <button type="submit" class="btn btn-sm btn-primary">Apply</button>
                            </div>
                        </form>
                    </details>
                }
            </section>

            @if (Model.Search.UsedSearchV2 && activeFilterCount > 0)
            {
                <nav class="pm-gs-active-filters" aria-label="Active search filters">
                    @foreach (var source in selectedSources)
                    {
                        <a class="pm-gs-active-filter" href="@BuildUrlRemoving("Source", source)" aria-label="Remove source filter @source"><span>Source: @source</span><i class="bi bi-x-lg" aria-hidden="true"></i></a>
                    }
                    @foreach (var project in selectedProjects)
                    {
                        var projectValue = project.ToString(System.Globalization.CultureInfo.InvariantCulture);
                        var projectLabel = Model.Search.Facets.Projects.FirstOrDefault(facet => string.Equals(facet.Value, projectValue, StringComparison.OrdinalIgnoreCase))?.Label ?? $"Project {projectValue}";
                        <a class="pm-gs-active-filter" href="@BuildUrlRemoving("Project", projectValue)" aria-label="Remove project filter @projectLabel"><span>@projectLabel</span><i class="bi bi-x-lg" aria-hidden="true"></i></a>
                    }
                    @foreach (var status in selectedStatuses)
                    {
                        <a class="pm-gs-active-filter" href="@BuildUrlRemoving("Status", status)" aria-label="Remove status filter @status"><span>Status: @status</span><i class="bi bi-x-lg" aria-hidden="true"></i></a>
                    }
                    @foreach (var fileType in selectedFileTypes)
                    {
                        <a class="pm-gs-active-filter" href="@BuildUrlRemoving("FileType", fileType)" aria-label="Remove file type filter @fileType"><span>@fileType</span><i class="bi bi-x-lg" aria-hidden="true"></i></a>
                    }
                    @foreach (var stage in selectedStages)
                    {
                        <a class="pm-gs-active-filter" href="@BuildUrlRemoving("Stage", stage)" aria-label="Remove stage filter @stage"><span>Stage: @stage</span><i class="bi bi-x-lg" aria-hidden="true"></i></a>
                    }
                    @if (Model.DateFrom.HasValue)
                    {
                        <a class="pm-gs-active-filter" href="@BuildUrlRemoving("DateFrom", string.Empty)" aria-label="Remove from date filter"><span>From @Model.DateFrom.Value.ToString("dd MMM yyyy")</span><i class="bi bi-x-lg" aria-hidden="true"></i></a>
                    }
                    @if (Model.DateTo.HasValue)
                    {
                        <a class="pm-gs-active-filter" href="@BuildUrlRemoving("DateTo", string.Empty)" aria-label="Remove to date filter"><span>To @Model.DateTo.Value.ToString("dd MMM yyyy")</span><i class="bi bi-x-lg" aria-hidden="true"></i></a>
                    }
                    <a class="pm-gs-active-filter pm-gs-active-filter--clear" href="@BuildUrl(Model.Q!, selectedCategory, preserveSources: false, preserveAdvanced: false)">Clear all</a>
                </nav>
            }

            @if (Model.Search.Results.Count > 0)
            {
                <section class="pm-gs-results" aria-label="Search results">
                    @foreach (var hit in Model.Search.Results)
                    {
                        <article class="pm-gs-hit">
                            <div class="pm-gs-hit__breadcrumb">
                                <span>@CategoryLabel(hit.Category)</span>
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                <span>@hit.SourceModule</span>
                                @if (!string.IsNullOrWhiteSpace(hit.Status))
                                {
                                    <span class="pm-gs-hit__status">@hit.Status</span>
                                }
                            </div>

                            <a class="pm-gs-hit__title"
                               href="@hit.Url"
                               data-search-result
                               data-search-entity-type="@hit.EntityType"
                               data-search-entity-key="@hit.EntityKey"
                               data-search-rank="@hit.Rank"
                               data-search-source="@hit.SourceModule">
                                @foreach (var segment in hit.TitleSegments)
                                {
                                    if (segment.Highlighted)
                                    {
                                        <mark>@segment.Text</mark>
                                    }
                                    else
                                    {
                                        @segment.Text
                                    }
                                }
                            </a>

                            @if (!string.IsNullOrWhiteSpace(hit.Subtitle))
                            {
                                <div class="pm-gs-hit__subtitle">@hit.Subtitle</div>
                            }

                            @if (hit.SnippetSegments.Count > 0)
                            {
                                <p class="pm-gs-hit__snippet">
                                    @foreach (var segment in hit.SnippetSegments)
                                    {
                                        if (segment.Highlighted)
                                        {
                                            <mark>@segment.Text</mark>
                                        }
                                        else
                                        {
                                            @segment.Text
                                        }
                                    }
                                </p>
                            }

                            <div class="pm-gs-hit__meta">
                                @if (!string.IsNullOrWhiteSpace(hit.MatchedField))
                                {
                                    <span class="pm-gs-hit__match"><i class="bi bi-check2-circle" aria-hidden="true"></i> Matched in @hit.MatchedField</span>
                                }
                                @if (hit.EventDate.HasValue)
                                {
                                    <span class="pm-gs-hit__sep">·</span>
                                    <time datetime="@hit.EventDate.Value.ToUniversalTime().ToString("O")">@hit.EventDate.Value.ToLocalTime().ToString("dd MMM yyyy")</time>
                                }
                                @if (!string.IsNullOrWhiteSpace(hit.FileType))
                                {
                                    <span class="pm-gs-hit__sep">·</span><span>@hit.FileType</span>
                                }
                            </div>

                            @if (hit.RelatedResults.Count > 0)
                            {
                                <div class="pm-gs-hit__related">
                                    <span>Related:</span>
                                    @foreach (var related in hit.RelatedResults.Take(4))
                                    {
                                        <a class="pm-gs-related-chip" href="@BuildRelatedUrl(hit, related)">@related.Label@if (related.Count > 1) {<text> · @related.Count</text>}</a>
                                    }
                                </div>
                            }
                        </article>
                    }
                </section>

                @if (!string.IsNullOrWhiteSpace(Model.Search.NextCursor))
                {
                    <nav class="pm-gs-pagination" aria-label="Search pagination">
                        <a class="btn btn-outline-primary" href="@BuildUrl(Model.Q!, selectedCategory, Model.Search.NextCursor)">Next results <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                    </nav>
                }
            }
            else
            {
                <section class="pm-gs-nores">
                    <div class="pm-gs-nores__icon"><i class="bi bi-search" aria-hidden="true"></i></div>
                    <div>
                        <h2>No results for “@Model.Q”</h2>
                        <p>Check the spelling, try a project acronym or identifier, or use fewer terms.</p>
                    </div>
                </section>
            }
        </div>
    </main>

    <form method="post" class="d-none" data-search-click-token aria-hidden="true">
        @Html.AntiForgeryToken()
    </form>
}
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/search.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/pages/search.js" asp-append-version="true" defer></script>
}
