@using ProjectManagement.Models
@using System.Linq
@model ProjectManagement.Pages.Projects.OverviewModel
@{
    var project = Model.Project;
    var portfolio = Model.Portfolio;
    var access = Model.Access;
    var jdpProfile = Model.MultiJdpProfile;
    var jdpSummary = jdpProfile.HasJdp
        ? jdpProfile.CardSummary
        : Model.CanManageJdp ? "Link an industry partner" : "No JDP recorded";
    var lifecycleStatus = Model.LifecycleSummary.Status;
    var isCompleted = lifecycleStatus == ProjectLifecycleStatus.Completed;
    var isActive = lifecycleStatus == ProjectLifecycleStatus.Active;
    var tot = Model.TotSummary;
    var pendingTot = tot.PendingRequest is { State: ProjectTotRequestDecisionState.Pending };
    var totTitle = pendingTot ? "Approval pending" : tot.StatusLabel;
    var totSummary = pendingTot
        ? $"Proposed: {tot.PendingRequest!.ProposedStatusLabel}"
        : tot.Status switch
        {
            ProjectTotStatus.InProgress => tot.Facts.FirstOrDefault(f => f.Label == "Started on") is { } started
                ? $"Started {started.Value}"
                : "ToT is in progress",
            ProjectTotStatus.Completed => tot.Facts.FirstOrDefault(f => f.Label == "Completed on") is { } completed
                ? $"Completed {completed.Value}"
                : "ToT marked completed",
            ProjectTotStatus.NotRequired => "No ToT action required",
            ProjectTotStatus.NotStarted when tot.HasTotRecord => "ToT action pending",
            _ => Model.CanManageTot ? "Record ToT position" : "No ToT position recorded"
        };

    static string DisplayUser(ApplicationUser? user)
    {
        if (user is null) return "—";
        return !string.IsNullOrWhiteSpace(user.FullName) ? user.FullName : user.UserName ?? "—";
    }

    static string StageTarget(ProjectManagement.ViewModels.TimelineItemVm? stage) =>
        stage is null ? "#timeline" : $"#timeline-stage-{stage.Code}";
}
<section class="project-command-header" aria-labelledby="project-title">
    <div class="project-command-header__main">
        <div class="project-command-header__identity">
            <div class="project-command-header__eyebrow">Project portfolio</div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h1 id="project-title" class="project-command-header__title">@portfolio.PageTitle</h1>
                @if (!string.IsNullOrWhiteSpace(project?.CaseFileNumber))
                {
                    <span class="project-command-header__case">@project.CaseFileNumber</span>
                }
                @if (!isActive)
                {
                    <span class="badge rounded-pill text-bg-secondary">@Model.LifecycleSummary.StatusLabel</span>
                }
            </div>
            <div class="project-command-header__meta">
                <span><i class="bi bi-diagram-3" aria-hidden="true"></i> Workflow @project?.WorkflowVersion</span>
                <span><i class="bi bi-calendar3" aria-hidden="true"></i> Created @(project is { } value ? value.CreatedAt.ToString("dd MMM yyyy") : "—")</span>
                <span><i class="bi bi-person-badge" aria-hidden="true"></i> PO @DisplayUser(project?.LeadPoUser)</span>
                <span><i class="bi bi-person-check" aria-hidden="true"></i> HoD @DisplayUser(project?.HodUser)</span>
            </div>
        </div>
        <div class="project-command-header__actions">
            @if (Model.RemarksPanel.ShowComposer)
            {
                <button type="button" class="btn btn-primary" data-project-quick-action="remark">
                    <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                    Add remark
                </button>
            }
            <partial name="_AssignRolesOffcanvas" model="Model.AssignRoles" />
            @if (Model.LifecycleActions.CanManageLifecycle)
            {
                <div class="dropdown">
                    <button class="btn btn-outline-secondary" type="button" id="project-actions-menu" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-three-dots" aria-hidden="true"></i>
                        <span class="visually-hidden">Project actions</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="project-actions-menu">
                        <li><button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#projectLifecycleActionsModal">Manage lifecycle</button></li>
                        @if (access.CanAssignRoles)
                        {
                            <li><hr class="dropdown-divider" /></li>
                            @if (project?.IsArchived == true)
                            {
                                <li><button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#projectRestoreArchiveModal">Restore from archive</button></li>
                            }
                            else
                            {
                                <li><button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#projectArchiveModal">Archive project</button></li>
                            }
                            <li><button class="dropdown-item text-danger" type="button" data-bs-toggle="modal" data-bs-target="#projectTrashModal">Move to Trash</button></li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
    <div class="project-intelligence-strip" aria-label="Project status summary">
        @if (isActive)
        {
            <button class="project-intelligence-card" type="button" data-scroll-target="@StageTarget(portfolio.CurrentStage)">
                <span class="project-intelligence-card__label">Current stage</span>
                <strong>@portfolio.CurrentStageDisplay</strong>
                <span>@portfolio.CurrentStageDetail</span>
            </button>
        }
        else if (isCompleted)
        {
            <button id="project-tot-card"
                    class="project-intelligence-card project-intelligence-card--tot"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#offcanvasTot"
                    aria-controls="offcanvasTot"
                    aria-label="@(Model.CanManageTot ? "View or update Transfer of Technology" : "View Transfer of Technology")">
                <span class="project-intelligence-card__label">
                    Transfer of Technology
                    @if (Model.CanManageTot && !pendingTot)
                    {
                        <i class="bi bi-pencil-square project-intelligence-card__edit-icon" aria-hidden="true"></i>
                    }
                </span>
                <strong data-tot-card-title title="@totTitle">@totTitle</strong>
                <span data-tot-card-summary title="@totSummary">@totSummary</span>
            </button>
        }
        else
        {
            <div class="project-intelligence-card" role="group" aria-label="Project lifecycle status">
                <span class="project-intelligence-card__label">Project status</span>
                <strong>@Model.LifecycleSummary.StatusLabel</strong>
                <span>@(Model.LifecycleSummary.PrimaryDetail ?? Model.LifecycleSummary.SecondaryDetail ?? "Lifecycle concluded")</span>
            </div>
        }
        <button id="project-jdp-card"
                class="project-intelligence-card project-intelligence-card--jdp"
                type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#offcanvasJdp"
                aria-controls="offcanvasJdp"
                aria-label="@(Model.CanManageJdp ? "View or manage project JDPs" : "View project JDPs")">
            <span class="project-intelligence-card__label">
                JDP
                @if (Model.CanManageJdp)
                {
                    <i class="bi bi-pencil-square project-intelligence-card__edit-icon" aria-hidden="true"></i>
                }
            </span>
            <strong data-jdp-card-title title="@jdpProfile.CardTitle">@jdpProfile.CardTitle</strong>
            <span data-jdp-card-summary title="@jdpSummary">@jdpSummary</span>
        </button>
        @if (Model.CanManageProliferation)
        {
            <button id="project-proliferation-card"
                    class="project-intelligence-card project-intelligence-card--proliferation"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#offcanvasProliferation"
                    aria-controls="offcanvasProliferation"
                    aria-label="Edit proliferation details">
                <span class="project-intelligence-card__label">
                    Proliferation
                    <i class="bi bi-pencil-square project-intelligence-card__edit-icon" aria-hidden="true"></i>
                </span>
                <strong data-proliferation-cost>@Model.ProliferationProfile.CostDisplay</strong>
                <span class="project-intelligence-card__status project-intelligence-card__status--@Model.ProliferationProfile.AvailabilityTone"
                      data-proliferation-status-wrap>
                    <span class="project-intelligence-card__status-dot" aria-hidden="true"></span>
                    <span data-proliferation-status>@Model.ProliferationProfile.AvailabilityDisplay</span>
                </span>
            </button>
        }
        else
        {
            <button id="project-proliferation-card"
                    class="project-intelligence-card project-intelligence-card--proliferation"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#offcanvasProliferation"
                    aria-controls="offcanvasProliferation"
                    aria-label="View proliferation details">
                <span class="project-intelligence-card__label">Proliferation</span>
                <strong data-proliferation-cost>@Model.ProliferationProfile.CostDisplay</strong>
                <span class="project-intelligence-card__status project-intelligence-card__status--@Model.ProliferationProfile.AvailabilityTone"
                      data-proliferation-status-wrap>
                    <span class="project-intelligence-card__status-dot" aria-hidden="true"></span>
                    <span data-proliferation-status>@Model.ProliferationProfile.AvailabilityDisplay</span>
                </span>
            </button>
        }
        <button class="project-intelligence-card" type="button" data-bs-toggle="modal" data-bs-target="#recordCompletenessModal" aria-controls="recordCompletenessModal">
            <span class="project-intelligence-card__label">Record completeness</span>
            <strong>@Model.RecordHealth.HealthPercent%</strong>
            <span>@(Model.RecordHealth.GapDetails.Count == 0
                ? "Project record complete"
                : $"{Model.RecordHealth.GapDetails.Count} record gap{(Model.RecordHealth.GapDetails.Count == 1 ? string.Empty : "s")}")</span>
        </button>
    </div>
</section>
