{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prism.local/schemas/search-v2-relevance-dataset.schema.json",
  "title": "PRISM Search V2 relevance benchmark",
  "type": "object",
  "required": ["version", "queries"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "query", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "query": { "type": "string", "minLength": 1 },
          "class": { "type": "string" },
          "rank1": { "$ref": "#/$defs/entityRef" },
          "expected": {
            "type": "array",
            "minItems": 1,
            "items": {
              "allOf": [
                { "$ref": "#/$defs/entityRef" },
                {
                  "type": "object",
                  "required": ["relevance"],
                  "properties": {
                    "relevance": { "type": "integer", "minimum": 1, "maximum": 3 }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "entityRef": {
      "type": "object",
      "required": ["entityType", "entityKey"],
      "properties": {
        "entityType": { "type": "string", "minLength": 1 },
        "entityKey": { "type": "string", "minLength": 1 }
      }
    }
  }
}
