+            .Select(stage => new ProjectBriefingSummaryPoint(
+                stage.Label,
+                counts.GetValueOrDefault(stage.Order),
+                stage.Order))
+            .ToList();
+
+        var unresolvedCount = counts
+            .Where(pair => !knownOrders.Contains(pair.Key))
+            .Sum(pair => pair.Value);
+        if (unresolvedCount > 0)
