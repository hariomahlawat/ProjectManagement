+@page "/Projects/Reports/ArppFyUpdate"
+@model ProjectManagement.Pages.Projects.Reports.ArppFyUpdateModel
+@using System.Globalization
+@using ProjectManagement.Services.Projects
+@using ProjectManagement.Services.Reports.ArppFyProjectUpdate
+@using ProjectManagement.Utilities
+@{
+    ViewData["Title"] = "ARPP FY Project Update";
+    var report = Model.Report;
+    string Date(DateOnly? value) => value?.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) ?? "—";
+    string SupplyOrder(ArppFyProjectUpdateRow row)
+    {
+        var amount = row.SupplyOrderAmountInCrores.HasValue
+            ? $"₹{row.SupplyOrderAmountInCrores.Value.ToString("0.##", CultureInfo.InvariantCulture)} Cr"
+            : null;
+        var date = row.SupplyOrderDate.HasValue ? Date(row.SupplyOrderDate) : null;
+        return amount is not null && date is not null ? $"{amount} · {date}" : amount ?? date ?? "—";
+    }
+}
+@section Styles {
+    <link rel="stylesheet" href="~/css/pages/projects-reports.css" asp-append-version="true" />
+}
+
+<div class="project-reports-page project-reports-page--workspace">
+    <nav class="project-reports-breadcrumb" aria-label="Breadcrumb">
+        <a asp-page="/Projects/Index">Projects</a>
+        <span>/</span>
+        <a asp-page="./Index">Reports</a>
+        <span>/</span>
+        <span>ARPP FY Project Update</span>
+    </nav>
+
+    <header class="report-workspace-header">
+        <div>
+            <p class="project-reports-eyebrow">ARPP / PPP · FORMAL FY RETURN</p>
+            <h1>ARPP FY Project Update</h1>
+            <p>Approved New, CL and CF projects from the selected FY's latest published ARPP position.</p>
+        </div>
+
+        @if (Model.AvailableFinancialYears.Count > 0)
+        {
+            <form method="get" class="report-toolbar__fy" aria-label="Select financial year">
+                <label for="financialYearStart">Financial Year</label>
+                <div class="input-group input-group-sm">
+                    <select class="form-select" id="financialYearStart" name="financialYearStart" onchange="this.form.submit()">
+                        @foreach (var year in Model.AvailableFinancialYears)
+                        {
+                            <option value="@year" selected="@(Model.FinancialYearStart == year)">FY @FinancialYearHelper.Format(year)</option>
+                        }
+                    </select>
+                    <button type="submit" class="btn btn-outline-secondary" title="Refresh report">
+                        <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
+                        <span class="visually-hidden">Refresh report</span>
+                    </button>
+                </div>
+            </form>
+        }
+    </header>
+
+    @if (Model.AvailableFinancialYears.Count == 0)
+    {
+        <section class="report-empty-state">
+            <i class="bi bi-journal-x" aria-hidden="true"></i>
+            <h2>No published ARPP data</h2>
+            <p>Publish an ARPP document before generating this report.</p>
+            <a class="btn btn-outline-primary" asp-page="/Projects/Arpp/Index">Open ARPP / PPP</a>
+        </section>
+    }
+    else if (report is null)
+    {
+        <section class="report-empty-state">
+            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
+            <h2>Report unavailable</h2>
+            <p>The selected FY could not be resolved from the published ARPP library.</p>
+        </section>
+    }
+    else
+    {
+        <section class="report-command-strip" aria-label="Report controls">
+            <div class="report-kpis">
+                <div><span>Projects</span><strong>@report.Rows.Count</strong></div>
+                <div><span>Completed</span><strong>@report.CompletedCount</strong></div>
+                <div><span>Ongoing / exceptions</span><strong>@report.OngoingCount</strong></div>
+                <div class="@(report.WarningCount > 0 ? "has-warning" : string.Empty)"><span>Data warnings</span><strong>@report.WarningCount</strong></div>
+            </div>
+            <div class="report-export-actions">
