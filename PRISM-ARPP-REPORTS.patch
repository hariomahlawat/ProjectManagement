+                <small>Rows are ordered by lifecycle maturity. Completed projects are classified directly from project lifecycle status and do not use stage history.</small>
+            </header>
+
+            @if (report.Rows.Count == 0)
+            {
+                <div class="formal-report-empty">No linked approved New / CL / CF projects are available for this FY.</div>
+            }
+            else
+            {
+                <div class="formal-report-scroll" tabindex="0" aria-label="Scrollable report table">
+                    <table class="formal-report-table">
+                        <thead>
+                            <tr>
+                                <th rowspan="2" class="col-serial">Ser No.</th>
+                                <th rowspan="2" class="col-arpp">ARPP No.</th>
+                                <th rowspan="2" class="col-project">Name of Project</th>
+                                <th rowspan="2" class="col-date">Dt of Grant of IPA / ARPP Listing</th>
+                                <th rowspan="2" class="col-sch">Sch</th>
