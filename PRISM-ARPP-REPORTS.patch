+                    <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF
+                </a>
+                <a class="btn btn-outline-success btn-sm @(report.CanExport ? string.Empty : "disabled")"
+                   asp-page-handler="Excel" asp-route-financialYearStart="@report.FinancialYearStart"
+                   aria-disabled="@(!report.CanExport)">
+                    <i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Excel
+                </a>
+            </div>
+        </section>
+
+        @if (report.Warnings.Count > 0)
+        {
+            <details class="report-preflight" @(report.WarningCount > 0 ? "open" : null)>
+                <summary>
+                    <span class="report-preflight__icon"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
+                    <span>
+                        <strong>Publication preflight</strong>
+                        <small>@report.WarningCount warning@(report.WarningCount == 1 ? "" : "s") before issue</small>
+                    </span>
+                    <i class="bi bi-chevron-down report-preflight__chevron" aria-hidden="true"></i>
+                </summary>
+                <div class="report-preflight__body">
+                    @foreach (var warning in report.Warnings)
