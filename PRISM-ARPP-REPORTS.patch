+                        </thead>
+                        <tbody>
+                            @foreach (var row in report.Rows)
+                            {
+                                <tr>
+                                    <td class="text-center">@row.SerialNumber</td>
+                                    <td class="text-center text-nowrap">@(row.PppNumber ?? "—")</td>
+                                    <td class="formal-report-project" title="Current position: @row.StageDisplay">
+                                        <a asp-page="/Projects/Overview" asp-route-id="@row.ProjectId" target="_blank" rel="noopener noreferrer">@row.ProjectName</a>
+                                    </td>
+                                    <td class="text-center">@Date(row.FirstArppListingDate)</td>
+                                    <td class="text-center">@(row.DfpdsSchedule ?? "—")</td>
+                                    <td class="text-center">@(row.Cfa ?? "—")</td>
