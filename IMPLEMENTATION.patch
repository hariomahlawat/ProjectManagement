+    grid-template-columns: auto minmax(0, 1fr);
+    align-items: center;
+    min-width: 0;
+    gap: .05rem .48rem;
+}
+
+.pbd-selector-summary i {
+    grid-row: 1 / 3;
+    color: var(--pbd-blue);
+}
+
+.pbd-selector-summary strong {
+    color: var(--pbd-ink);
+    font-size: .8rem;
+}
+
+.pbd-selector-summary small {
+    color: var(--pbd-muted);
+    font-size: .64rem;
+}
+
+.pbd-selector[open] > .pbd-selector-tabs {
+    border-top: 1px solid var(--pbd-border);
+}
+
+.pbd-selected {
+    overflow: hidden;
+}
+
+.pbd-section-header--selected .btn {
+    flex: 0 0 auto;
+}
+
+.pbd-table-wrap {
+    max-width: 100%;
+    overscroll-behavior-inline: contain;
+    scrollbar-width: thin;
+}
+
+.pbd-project-table {
+    max-width: none;
+}
+
+.pbd-selected-toolbar,
+.pbd-selected-actions {
+    max-width: 100%;
+}
+
+.pbd-saved-card__body small {
+    font-variant-numeric: tabular-nums;
+}
+
