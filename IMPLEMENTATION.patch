+        display: block;
+        width: 100%;
+    }
+
+    .arpp-v2-table tbody {
+        display: grid;
+        gap: .65rem;
+        padding: .65rem;
+    }
+
+    .arpp-v2-table tbody tr {
+        overflow: hidden;
+        border: 1px solid var(--arpp-v2-border);
+        border-radius: .65rem;
+        background: var(--arpp-v2-surface);
+    }
+
+    .arpp-v2-table tbody td {
+        display: grid;
+        grid-template-columns: 7rem minmax(0, 1fr);
+        gap: .55rem;
+        padding: .45rem .65rem;
