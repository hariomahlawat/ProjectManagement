+
+/* Journey-only operational workspace --------------------------------------- */
+.process-page {
+  --process-path-start: #7897bd;
+  --process-path-end: #4f78aa;
+  --process-active-start: #2563eb;
+  --process-active-end: #38a4f4;
+  --process-conditional-start: #a66d18;
+  --process-conditional-end: #d69b34;
+  --process-arrow: #6f8fb5;
+  --process-arrow-active: #2f80ed;
+  --process-arrow-conditional: #c48725;
+  width: 100%;
+  padding: .65rem clamp(.55rem, 1vw, 1rem) .8rem;
+  color: #17233a;
+}
+
+.process-workspace {
+  --process-guide-width: clamp(350px, 22vw, 455px);
+  width: 100%;
+  height: var(--process-available-height, calc(100dvh - 12rem));
+  min-height: 560px;
+  display: block;
+  overflow: hidden;
+  border: 1px solid #cfd9e7;
+  border-radius: 1.15rem;
+  background: #edf3fa;
+  box-shadow: 0 18px 52px rgba(33, 53, 82, .12);
+}
+
+.process-commandbar,
+.process-mode-switch,
+.process-map-tools {
+  display: none !important;
+}
+
+.process-experience {
+  height: 100%;
+  min-height: 0;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) var(--process-guide-width);
+  gap: 0;
+  background: #edf3fa;
+}
+
+.process-scene,
+.stage-guide {
+  height: 100%;
+  min-height: 0;
+  border: 0;
+  border-radius: 0;
+  box-shadow: none;
+}
+
+.process-scene {
+  --journey-ink: #17233a;
+  --journey-muted: #5f7089;
+  --journey-faint: #8594a9;
+  position: relative;
+  color: #17233a;
+  background:
+    radial-gradient(circle at 50% 42%, rgba(68, 132, 207, .13), transparent 34%),
+    linear-gradient(180deg, #f7faff 0%, #eef4fb 56%, #e6edf6 100%);
+  isolation: isolate;
+}
+
+.process-scene__atmosphere {
+  background:
+    radial-gradient(ellipse at 50% 100%, rgba(91, 145, 207, .16), transparent 56%),
+    radial-gradient(circle at 86% 12%, rgba(68, 132, 207, .08), transparent 26%),
+    radial-gradient(circle at 18% 18%, rgba(132, 44, 65, .035), transparent 28%);
+}
+
+.process-scene__horizon {
+  opacity: .26;
+  background-image:
+    linear-gradient(rgba(73, 112, 156, .13) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(73, 112, 156, .13) 1px, transparent 1px);
+}
+
+.process-scene__noise {
+  opacity: .06;
+}
+
+.process-path-grid line {
+  stroke: rgba(76, 111, 151, .13);
+}
+
+.process-connection {
+  opacity: .46;
+  filter: none;
+}
+
+.process-connection.is-traversed {
+  opacity: .68;
+}
+
+.process-connection.is-active {
+  opacity: 1;
+  filter: drop-shadow(0 0 5px rgba(47, 128, 237, .24));
+}
+
+.process-route-signal.is-active {
+  filter: drop-shadow(0 0 4px rgba(47, 128, 237, .28));
+}
+
+.process-node {
+  color: #26364e;
+  border-color: #c4d0df;
+  background: linear-gradient(145deg, rgba(255, 255, 255, .98), rgba(242, 247, 253, .98));
+  box-shadow:
+    0 13px 30px rgba(50, 76, 109, .13),
+    inset 0 1px 0 rgba(255, 255, 255, .9);
+  backdrop-filter: blur(10px);
+}
+
+.process-node:hover,
+.process-node:focus-visible {
+  border-color: #7ca7d8;
+  box-shadow: 0 18px 38px rgba(50, 76, 109, .17);
+}
+
+.process-node__index {
+  color: #2c65a8;
+  background: #e9f2fd;
+  border-color: #c5d8ef;
+}
+
+.process-node__body small {
+  color: #718198;
+}
+
+.process-node.is-past {
+  opacity: .76;
+}
+
+.process-node.is-past .process-node__index {
+  color: #397a5c;
+  border-color: #c7e0d2;
+  background: #ebf6f0;
+}
+
+.process-node.is-active {
+  color: #11223b;
+  border-color: #3f8ce8;
+  background: linear-gradient(145deg, #ffffff, #edf6ff);
+  box-shadow:
+    0 24px 55px rgba(46, 91, 145, .22),
+    0 0 0 2px rgba(63, 140, 232, .12),
+    0 0 32px rgba(63, 140, 232, .14),
+    inset 0 1px 0 rgba(255, 255, 255, .95);
+}
+
+.process-node.is-active .process-node__halo {
+  opacity: .52;
+  background: radial-gradient(circle, rgba(60, 139, 232, .2), transparent 68%);
+}
+
+.process-node.is-active .process-node__index {
+  color: #fff;
+  border-color: #3f8ce8;
+  background: linear-gradient(135deg, #529cf0, #2977d8);
+}
+
+.process-node.is-conditional {
+  border-color: rgba(175, 116, 24, .5);
+  background: linear-gradient(145deg, #fffdf8, #fbf4e8);
+}
+
+.process-node.is-conditional .process-node__index {
+  color: #936015;
+  border-color: #e4c68e;
+  background: #fbefd8;
+}
+
+.process-node.is-conditional.is-active {
+  border-color: #b77b24;
+  box-shadow:
+    0 22px 50px rgba(136, 91, 22, .18),
+    0 0 0 2px rgba(183, 123, 36, .11);
+}
+
+.process-loading {
+  color: #64748b;
+  background: #eef4fb;
+}
+
+.process-loading .spinner-border {
+  color: #347fd5;
+}
+
+.process-scene__topline {
+  top: .9rem;
+  left: .95rem;
+  right: .95rem;
+  align-items: flex-start;
+}
+
+.process-scene__identity {
+  border-color: rgba(95, 126, 164, .18);
+  color: #17233a;
+  background: rgba(255, 255, 255, .78);
+  box-shadow: 0 8px 24px rgba(52, 76, 106, .08);
+  backdrop-filter: blur(16px);
+}
+
+.process-scene__identity span {
+  color: #3f77bb;
+}
+
+.process-scene__identity strong {
+  color: #1a2c47;
+}
+
+.process-utility-dock {
+  display: inline-flex;
+  align-items: center;
+  gap: .28rem;
+  padding: .32rem;
+  border: 1px solid rgba(111, 139, 174, .22);
+  border-radius: .82rem;
+  background: rgba(255, 255, 255, .84);
+  box-shadow: 0 10px 28px rgba(51, 74, 103, .1);
+  backdrop-filter: blur(16px);
+  pointer-events: auto;
+}
+
+.process-utility-button {
+  width: 2.2rem;
+  height: 2.2rem;
+  display: grid;
+  place-items: center;
+  border: 0;
+  border-radius: .58rem;
+  color: #53677f;
+  background: transparent;
+}
+
+.process-utility-button:hover,
+.process-utility-button:focus-visible,
+.process-utility-button[aria-pressed="true"] {
+  color: #1f62ad;
+  background: #e8f1fc;
+  outline: none;
+}
+
+.process-fullscreen-exit {
+  min-height: 2.2rem;
+  color: #3d5878;
+  border-color: rgba(97, 128, 165, .25);
+  background: rgba(255, 255, 255, .84);
+}
+
+.process-fullscreen-exit:hover,
+.process-fullscreen-exit:focus-visible {
+  color: #174f91;
+  border-color: #8baed6;
+  background: #eef5fd;
+}
+
+.process-stage-nav {
