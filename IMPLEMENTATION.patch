+        grid-template-columns: minmax(0, 1fr);
+    }
+
+    .pbd-workspace.is-decks-collapsed .pbd-saved {
+        display: none;
+    }
+
+    .pbd-saved {
+        position: static;
+        max-width: 100%;
+    }
+
+    .pbd-saved__list {
+        display: flex;
+        max-height: none;
+        overflow-x: auto;
+        overscroll-behavior-inline: contain;
+    }
+
+    .pbd-saved-card {
+        flex: 0 0 14rem;
+    }
+
+    .pbd-preflight-detail-grid {
+        grid-template-columns: 1fr;
+    }
+}
+
+@media (max-width: 980px) {
+    .pbd-page-header,
+    .pbd-deck-header,
+    .pbd-preflight-header {
+        align-items: stretch;
