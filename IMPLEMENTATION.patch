+}
+
+.arpp-document-state--published .arpp-document-state__identity > .bi {
+    color: var(--bs-success-text-emphasis);
+}
+
+.arpp-document-state--correction .arpp-document-state__identity > .bi {
+    color: var(--bs-warning-text-emphasis);
+}
+
+.arpp-document-state--pending .arpp-document-state__identity > .bi {
+    color: var(--bs-primary);
+}
+
+.arpp-document-state__titleline {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: .45rem;
+}
+
+.arpp-document-state__titleline strong {
+    font-size: .9rem;
+}
+
+.arpp-document-state__revision {
