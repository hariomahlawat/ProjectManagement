+}
+
+.arpp-document-state--correction {
+    border-color: color-mix(in srgb, var(--bs-warning) 32%, var(--arpp-border));
+    background: color-mix(in srgb, var(--bs-warning-bg-subtle) 40%, var(--bs-body-bg));
+}
+
+.arpp-document-state--pending {
+    border-color: color-mix(in srgb, var(--bs-primary) 22%, var(--arpp-border));
