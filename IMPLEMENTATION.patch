diff --git a/wwwroot/css/project-office-reports/arpp-workspace.css b/wwwroot/css/project-office-reports/arpp-workspace.css
index c2d2858..2a183b8 100644
--- a/wwwroot/css/project-office-reports/arpp-workspace.css
+++ b/wwwroot/css/project-office-reports/arpp-workspace.css
@@ -499,3 +499,188 @@ body.arpp-workspace-fullscreen .arpp-page--workspace .arpp-table-wrap {
         transition: none;
     }
 }
+
+/* ============================================================
+   ARPP/PPP final workspace completion
+   One vertical scroll surface, compact issue review and truthful save state.
+   ============================================================ */
+.arpp-save-statusline {
+    grid-area: status;
+    display: flex;
+    min-width: 0;
+    align-items: center;
+    gap: .45rem;
+}
+
+.arpp-save-statusline .arpp-save-state {
+    min-width: 0;
+}
+
+.arpp-validation-toggle {
+    display: inline-flex;
+    align-items: center;
+    gap: .35rem;
+    min-height: 1.6rem;
+    padding: .05rem .2rem;
+    font-size: .73rem;
+    font-weight: 700;
+    text-decoration: none;
+    white-space: nowrap;
+}
+
+.arpp-validation-toggle .badge {
+    min-width: 1.35rem;
+    font-size: .62rem;
+    font-variant-numeric: tabular-nums;
+}
+
+.arpp-workspace-commandbar [data-arpp-save-button]:disabled {
+    border-color: color-mix(in srgb, var(--bs-primary) 28%, var(--arpp-border));
+    background: color-mix(in srgb, var(--bs-primary) 18%, var(--bs-body-bg));
+    box-shadow: none;
+    color: color-mix(in srgb, var(--bs-primary) 48%, var(--bs-secondary-color));
+    cursor: not-allowed;
+    opacity: 1;
+}
+
+.arpp-validation-navigator {
+    grid-template-columns: minmax(14rem, .7fr) minmax(22rem, 1.8fr) auto;
+    margin: -.2rem 0 .65rem;
+    padding: .52rem .65rem;
+    box-shadow: 0 .2rem .7rem rgba(127, 29, 29, .06);
+}
+
+.arpp-validation-navigator__items .btn {
+    max-width: 18rem;
+}
+
+/* Normal mode uses the page as the sole vertical scroll surface. */
+.arpp-page--workspace .arpp-table-wrap {
+    max-height: none;
+    overflow-x: auto;
+    overflow-y: visible;
+    overscroll-behavior-x: contain;
+    overscroll-behavior-y: auto;
+    scrollbar-gutter: auto;
+}
+
+.arpp-page--workspace .arpp-entry-table thead th {
+    top: calc(var(--arpp-app-chrome-height) + var(--arpp-commandbar-height) + .45rem);
+    z-index: 22;
+    box-shadow: inset 0 -1px 0 var(--arpp-border), 0 .2rem .35rem rgba(16, 24, 40, .05);
+}
+
