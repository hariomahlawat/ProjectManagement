+
+    .pbd-section-header--selected {
+        align-items: stretch;
+        flex-direction: column;
+    }
+
+    .pbd-section-header--selected .btn {
+        align-self: flex-start;
+    }
+
+    .pbd-selected-toolbar {
+        grid-template-columns: 1fr;
+    }
+}
