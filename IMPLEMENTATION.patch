+}
+
+.arpp-document-upload--compact {
+    padding-top: 0;
+    border-top: 0;
+}
+
+.arpp-document-remove {
+    margin: 0;
+}
+
+@media (max-width: 1199.98px) {
+    .arpp-kpis--details {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+    }
+}
+
+@media (max-width: 767.98px) {
+    .arpp-document-state {
+        flex-direction: column;
+    }
+
+    .arpp-document-state__action {
+        align-self: stretch;
