+        flex-basis: auto;
+        text-align: left;
+    }
+
+    .pbd-selected-toolbar {
+        position: static;
+        grid-template-columns: minmax(14rem, 1fr) repeat(2, minmax(9rem, .5fr));
+    }
+
+    .pbd-selected-filter-result {
+        grid-column: 1 / -1;
+        justify-self: start;
+    }
+}
+
+@media (max-width: 720px) {
+    .pbd-page-header__actions,
