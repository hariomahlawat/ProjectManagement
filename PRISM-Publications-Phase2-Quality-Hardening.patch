+    border: 2px solid rgba(255, 255, 255, .95);
+    box-shadow: 0 0 0 999px rgba(7, 24, 20, .34), inset 0 0 0 1px rgba(13, 61, 49, .35);
+    pointer-events: none;
+}
+
+.brochure-focal-marker {
+    position: absolute;
+    width: 14px;
+    height: 14px;
+    border: 2px solid #fff;
+    border-radius: 50%;
+    background: #d7a92f;
+    box-shadow: 0 0 0 1px rgba(10, 43, 35, .65), 0 2px 6px rgba(0, 0, 0, .25);
+    transform: translate(-50%, -50%);
+    pointer-events: none;
+}
+
+.brochure-focal-reset {
+    position: absolute;
+    right: 6px;
+    bottom: 6px;
+    padding: 3px 6px;
+    border: 1px solid rgba(255, 255, 255, .7);
+    border-radius: 4px;
+    background: rgba(14, 52, 43, .84);
+    color: #fff;
+    font-size: .53rem;
+    font-weight: 700;
+    cursor: pointer;
+}
+
+.brochure-preflight-spinner {
+    color: #2f6757;
+}
+
+.brochure-preflight-grid {
+    grid-template-columns: repeat(4, 1fr);
+}
+
+.brochure-preflight-grid > div.is-blocker strong {
+    color: #b42318;
+}
+
+.brochure-preflight-grid > div.is-warning strong {
+    color: #9a6700;
+}
+
+.brochure-preflight-message.is-checking {
+    border-color: #d9e4e0;
+    background: #f5f8f7;
+    color: #63756e;
+}
+
+.brochure-preflight-message.is-blocked {
+    border-color: #f0c3bd;
+    background: #fff5f4;
+    color: #8c2f26;
+}
+
+.brochure-preflight-message.is-ready {
+    border-color: #b9d8ca;
+    background: #f0faf5;
+    color: #236548;
+}
+
+.brochure-preflight-message.is-warning {
+    border-color: #ecd9a8;
+    background: #fff9e9;
+    color: #765812;
+}
+
+.brochure-preflight-issues {
+    display: grid;
+    gap: 5px;
+    margin-top: 9px;
+}
+
+.brochure-preflight-issue {
+    display: grid;
+    grid-template-columns: 14px minmax(0, 1fr);
+    gap: 6px;
+    align-items: start;
+    padding: 6px 7px;
+    border-radius: 5px;
+    background: #f6f8f7;
+    color: #53655e;
+    font-size: .59rem;
+    line-height: 1.35;
+}
+
+.brochure-preflight-issue.is-blocker {
+    background: #fff4f2;
+    color: #8f3329;
+}
+
+.brochure-preflight-issue.is-warning {
+    background: #fff8e6;
+    color: #775a16;
+}
+
+.brochure-preflight-issue.is-information {
+    background: #f1f6f4;
+    color: #4c665d;
+}
+
+.brochure-preflight-issue strong {
+    display: block;
+    margin-bottom: 1px;
+    color: inherit;
+    font-weight: 750;
+}
+
+.brochure-generate-actions {
+    grid-template-columns: 1fr;
+}
+
+.brochure-preview-button,
+.brochure-generate-button {
+    width: 100%;
+    min-height: 40px;
+}
+
+.brochure-generate-actions > small {
+    color: #73847d;
+    font-size: .59rem;
+    text-align: center;
+}
+
+@media (max-width: 1180px) {
+    .brochure-photo-picker {
+        grid-template-columns: repeat(4, minmax(0, 1fr));
+    }
+}
+
+@media (max-width: 767.98px) {
+    .brochure-photo-picker {
+        grid-template-columns: repeat(3, minmax(0, 1fr));
+    }
+
+    .brochure-preflight-grid {
+        grid-template-columns: repeat(2, 1fr);
+    }
+}
