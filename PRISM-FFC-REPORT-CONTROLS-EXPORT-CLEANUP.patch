+.report-toolbar__refresh {
+    display: flex;
+    flex-direction: column;
+    align-items: flex-start;
+    gap: .25rem;
+    flex: 0 0 auto;
+}
+
+.report-refresh-button {
+    min-height: 31px;
+    display: inline-flex;
+    align-items: center;
+    gap: .35rem;
+    white-space: nowrap;
+}
+
+.report-refresh-button--pending {
+    box-shadow: 0 0 0 .14rem rgba(37, 99, 235, .12);
+}
+
+.ffc-report-group-row small {
+    display: none;
+}
