@using System.Collections.Generic
@using System.Text.Json
@{
    var items = new List<(string Level, string Text)>();

    void AddIf(string key, string level)
    {
        if (TempData.ContainsKey(key) && TempData[key] is string value && !string.IsNullOrWhiteSpace(value))
        {
            items.Add((level, value));
        }
    }

    AddIf("ToastMessage", "info");
    AddIf("ToastSuccess", "success");
    AddIf("ToastInfo", "info");
    AddIf("ToastWarning", "warning");
    AddIf("ToastError", "danger");

    if (TempData.ContainsKey("ToastJson") && TempData["ToastJson"] is string json && !string.IsNullOrWhiteSpace(json))
    {
        try
        {
            var parsed = JsonSerializer.Deserialize<List<ToastItem>>(json) ?? new();
            foreach (var toast in parsed)
            {
                var level = toast.Level?.ToLowerInvariant() switch
                {
                    "success" => "success",
                    "info" => "info",
                    "warning" => "warning",
                    "danger" => "danger",
                    "error" => "danger",
                    _ => "info"
                };

                if (!string.IsNullOrWhiteSpace(toast.Text))
                {
                    items.Add((level, toast.Text!));
                }
            }
        }
        catch
        {
            // Ignore malformed JSON payloads; nothing should be rendered.
        }
    }
}

@functions
{
    private sealed class ToastItem
    {
        public string? Level { get; set; }

        public string? Text { get; set; }
    }
}

@*
    Server messages (TempData ToastSuccess / ToastInfo / ToastWarning / ToastError / ToastMessage /
    ToastJson) in the PRISM glass toast. wwwroot/js/components/prism-toast.js adds the timers,
    stacking and dismissal; without it they still show and can be read. docs/ux/toasts.md.
*@
@if (items.Count > 0)
{
    <div class="prism-toasts" data-prism-toasts role="region" aria-label="Notifications">
        @foreach (var item in items)
        {
            var icon = item.Level switch
            {
                "success" => "bi-check-lg",
                "danger" => "bi-x-lg",
                "warning" => "bi-exclamation-lg",
                _ => "bi-info-lg"
            };
            <div class="prism-toast" data-prism-toast data-tone="@item.Level" role="@(item.Level == "danger" ? "alert" : "status")" data-life="@(item.Level == "danger" ? "0" : "5500")">
                <span class="prism-toast__icon" aria-hidden="true"><i class="bi @icon"></i></span>
                <p class="prism-toast__text">@item.Text</p>
                <button type="button" class="prism-toast__close" data-prism-toast-close aria-label="Dismiss"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                @if (item.Level != "danger")
                {
                    <span class="prism-toast__timer" aria-hidden="true"></span>
                }
            </div>
        }
    </div>
}
