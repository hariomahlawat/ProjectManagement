@model ProjectManagement.Pages.Analytics.IndexModel
@using System.Linq
@using System.Text.Json

@{
    var ongoing = Model.Ongoing!;
    var json = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    var stageSeries = ongoing.ByStageByParentCategory;
    var stageBoard = ongoing.StageBoard;
    var maxStageCount = stageBoard.Count > 0 ? stageBoard.Max(item => item.StageCount) : 0;

    var options = Model.OngoingStageParentCategoryOptions.ToList();
    var selectedIds = Model.ActiveOngoingStageParentCategoryIds;
    var hasSelection = selectedIds.Count > 0 && selectedIds.Count < options.Count;
    var summary = !hasSelection
        ? "All"
        : selectedIds.Count == 1
            ? options.First(option => option.Id == selectedIds[0]).Name
            : $"{selectedIds.Count} selected";
    var overviewUrl = Url.Page("/Projects/Overview");
    var insightsUrl = Url.Page("./Index", new { tab = "Insights" });
}

<section class="analytics-panel analytics-panel--ongoing" aria-label="Ongoing projects analytics">
  <!-- SECTION: Ongoing projects by current stage -->
  <article class="analytics-card">
    <header class="analytics-card__head">
      <div class="analytics-card__text">
        <h2 class="analytics-card__title">Ongoing projects by current stage</h2>
        <p class="analytics-card__meta">Every workflow stage in order, grouped by phase under the axis; click a bar to see its projects below.</p>
      </div>
      <div class="analytics-card__actions">
        <form method="get" asp-page="/Analytics/Index" class="analytics-filter-form" data-stage-filter-form aria-label="Filter by parent category">
          <input type="hidden" name="tab" value="ongoing" />
          <button type="button"
                  class="analytics-filter"
                  data-stage-filter-trigger
                  aria-haspopup="dialog"
                  aria-expanded="false"
                  aria-controls="ongoing-stage-parent-category-popover">
            <span>Parent category</span>
            <b data-stage-filter-summary>@summary</b>
            <i class="bi bi-chevron-down" aria-hidden="true"></i>
          </button>
          <div id="ongoing-stage-parent-category-popover"
               class="analytics-popover"
               data-stage-filter-popover
               role="dialog"
               aria-label="Parent categories"
               hidden>
            <p class="analytics-popover__title">Parent categories</p>
            <div class="analytics-popover__options">
              @foreach (var option in options)
              {
                var isChecked = !hasSelection || selectedIds.Contains(option.Id);
                var optionId = $"ongoing-stage-parent-category-option-{option.Id}";
                <div class="analytics-popover__option">
                  <input id="@optionId" type="checkbox" name="ongoingStageParentCategoryIds" value="@option.Id" class="form-check-input" checked="@isChecked" data-stage-filter-option />
                  <label for="@optionId"><i class="analytics-dot" data-category-dot="@option.Name" aria-hidden="true"></i>@option.Name</label>
                </div>
              }
            </div>
            <div class="analytics-popover__actions">
              <button type="button" class="btn btn-sm btn-link" data-stage-filter-select-all>Select all</button>
              <button type="button" class="btn btn-sm btn-link" data-stage-filter-clear>Clear</button>
              <button type="submit" class="btn btn-sm btn-primary ms-auto">Apply</button>
            </div>
          </div>
        </form>
        <button type="button" class="analytics-icon-btn" data-chart-download-target="ongoing-by-stage-chart" aria-label="Download chart as PNG" title="Download chart as PNG">
          <i class="bi bi-download" aria-hidden="true"></i>
        </button>
      </div>
    </header>
    <div class="analytics-card__legend" data-legend="ongoing-by-stage-chart"></div>
    <div class="analytics-card__chart">
      <canvas id="ongoing-by-stage-chart"
              role="img"
              aria-label="Ongoing projects by current stage"
              data-empty-message="No ongoing projects in the selected parent categories."
              data-series='@Html.Raw(JsonSerializer.Serialize(stageSeries, json))'
              data-phases='@Html.Raw(JsonSerializer.Serialize(ongoing.Phases.Select(phase => new { phase.Key, phase.Name, phase.StageCodes }), json))'></canvas>
    </div>

    <!-- SECTION: Stage drill-down (stage → category → projects) -->
    @if (stageBoard.Count > 0)
    {
      <section class="analytics-drill" aria-label="Ongoing projects by stage">
        <h3 class="analytics-drill__title">Projects in each stage</h3>
        @foreach (var stage in stageBoard)
        {
          var width = maxStageCount > 0 ? (int)Math.Round(100.0 * stage.StageCount / maxStageCount) : 0;
          <details class="analytics-drill__row" data-drill-key="stage:@stage.StageCode">
            <summary class="analytics-drill__summary">
              <span class="analytics-drill__name">@stage.StageName</span>
              <span class="analytics-drill__bar" aria-hidden="true"><i style="--w:@(width)%"></i></span>
              <span class="analytics-drill__chips">
                @foreach (var category in stage.Categories)
                {
                  <span class="analytics-drill__chip"><i class="analytics-dot" data-category-dot="@category.ParentCategoryName" aria-hidden="true"></i>@category.ParentCategoryName <b>@category.CategoryCount</b></span>
                }
              </span>
              <span class="analytics-drill__count">@stage.StageCount</span>
              <i class="bi bi-chevron-down analytics-drill__caret" aria-hidden="true"></i>
            </summary>
            <div class="analytics-drill__body">
              @foreach (var category in stage.Categories)
              {
                <div class="analytics-drill__group">
                  <h4><i class="analytics-dot" data-category-dot="@category.ParentCategoryName" aria-hidden="true"></i>@category.ParentCategoryName <span>@category.CategoryCount</span></h4>
                  <ol>
                    @foreach (var project in category.Projects)
                    {
                      <li><a href="@overviewUrl?id=@project.ProjectId">@project.ProjectName</a></li>
                    }
                  </ol>
                </div>
              }
            </div>
          </details>
        }
      </section>
    }
    <!-- END SECTION -->
  </article>
  <!-- END SECTION -->

  <p class="analytics-note">
    Time spent in each stage now lives under <a href="@insightsUrl">Insights</a>, with the mean, median and cost-band views in one chart.
  </p>
</section>
