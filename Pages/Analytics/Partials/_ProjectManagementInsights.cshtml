@model ProjectManagement.Models.Analytics.StageTimeInsightsPanelVm
@using System.Linq
@using System.Text.Json
@using ProjectManagement.Pages.Analytics

@{
    var json = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    var categories = ViewData["AnalyticsCategories"] as IEnumerable<IndexModel.CategoryOption>
        ?? Array.Empty<IndexModel.CategoryOption>();
    var selectedCategoryId = Model.SelectedCategoryId;
    var selectedCategoryName = selectedCategoryId.HasValue
        ? categories.FirstOrDefault(category => category.Id == selectedCategoryId.Value)?.Name ?? "All"
        : "All";
    var hasData = Model.StageHotspots.HasData || Model.StageCycleTime.HasData;
    var portfolioMedian = Model.PortfolioMedianDays;
    static string Ratio(double ratio) => ratio >= 10 ? $"{ratio:0}×" : $"{ratio:0.0}×";
}

<section class="analytics-panel analytics-panel--insights" aria-label="Project management insights">
  <!-- SECTION: Stage cycle time (mean/median, all projects or by cost band) -->
  <article class="analytics-card">
    <header class="analytics-card__head">
      <div class="analytics-card__text">
        <h2 class="analytics-card__title">Stage cycle time</h2>
        <p class="analytics-card__meta">Days a finished stage took, across ongoing and completed projects. Stages still running are not counted.</p>
      </div>
      <div class="analytics-card__actions">
        <form method="get" asp-page="./Index" class="analytics-filter-form" aria-label="Filter by project category">
          <input type="hidden" name="tab" value="Insights" />
          <label class="analytics-filter analytics-filter--select">
            <span>Category</span>
            <b>@selectedCategoryName</b>
            <i class="bi bi-chevron-down" aria-hidden="true"></i>
            <select name="categoryId" class="analytics-filter__select" data-page-handled data-auto-submit="change" aria-label="Project category">
              <option value="" selected="@(!selectedCategoryId.HasValue ? "selected" : null)">All</option>
              @foreach (var category in categories)
              {
                <option value="@category.Id" selected="@(selectedCategoryId == category.Id ? "selected" : null)">@category.Name</option>
              }
            </select>
          </label>
        </form>
        <button type="button" class="analytics-icon-btn" data-chart-download-target="stage-cycle-time-chart" aria-label="Download chart as PNG" title="Download chart as PNG">
          <i class="bi bi-download" aria-hidden="true"></i>
        </button>
      </div>
    </header>

    @if (hasData)
    {
      <div class="analytics-card__toolbar">
        <div class="analytics-seg" role="group" aria-label="Measure" data-cycle-toggle="measure">
          <button type="button" data-value="median" aria-pressed="true">Median</button>
          <button type="button" data-value="mean" aria-pressed="false">Mean</button>
        </div>
        <div class="analytics-seg" role="group" aria-label="Split" data-cycle-toggle="split">
          <button type="button" data-value="all" aria-pressed="true">All projects</button>
          <button type="button" data-value="band" aria-pressed="false">By cost band</button>
        </div>
        <div class="analytics-card__legend analytics-card__legend--inline" data-legend="stage-cycle-time-chart"></div>
      </div>
    }
    <div class="analytics-card__chart">
      <canvas id="stage-cycle-time-chart"
              role="img"
              aria-label="Days per workflow stage"
              data-empty-message="Not enough finished stages yet to measure cycle time."
              data-rows='@Html.Raw(JsonSerializer.Serialize(Model.StageCycleTime.Rows, json))'
              data-points='@Html.Raw(JsonSerializer.Serialize(Model.StageHotspots.Points, json))'></canvas>
    </div>
    @if (hasData)
    {
      <p class="analytics-card__foot">
        Only stages with both a start and an end date count. Cost bands use the latest AoN, benchmark, PNC, L1 or IPA figure recorded for the project.
      </p>
    }
  </article>
  <!-- END SECTION -->

  <!-- SECTION: Hotspots, ranked slowest first -->
  <article class="analytics-card">
    <header class="analytics-card__head">
      <div class="analytics-card__text">
        <h2 class="analytics-card__title">Where time goes</h2>
        <p class="analytics-card__meta">
          Stages ranked by median days, against a portfolio median of
          <strong>@Math.Round(portfolioMedian) days</strong> per stage@(selectedCategoryId.HasValue ? $" for {selectedCategoryName}" : "").
          Two times the portfolio median or more is marked.
        </p>
      </div>
    </header>
    @if (Model.RankedHotspots.Count == 0)
    {
      <p class="analytics-empty" role="status">No finished stages yet to rank.</p>
    }
    else
    {
      <ol class="analytics-hotspots">
        @foreach (var stage in Model.RankedHotspots)
        {
          var isHot = stage.RatioToPortfolioMedian >= 2;
          var width = (int)Math.Round(100 * stage.ShareOfSlowest);
          <li class="analytics-hotspot @(isHot ? "is-hot" : null)">
            <span class="analytics-hotspot__rank">@stage.Rank</span>
            <div class="analytics-hotspot__body">
              <div class="analytics-hotspot__line">
                <strong>@stage.StageName</strong>
                <span>@Math.Round(stage.MedianDays) @(Math.Round(stage.MedianDays) == 1 ? "day" : "days") median · @Ratio(stage.RatioToPortfolioMedian) portfolio median · @stage.ProjectCount @(stage.ProjectCount == 1 ? "project" : "projects")@(stage.ProjectCount < 3 ? ", small sample" : "")</span>
              </div>
              <span class="analytics-hotspot__track" aria-hidden="true"><i style="--w:@(width)%"></i></span>
            </div>
            <span class="analytics-hotspot__days"><b>@Math.Round(stage.MedianDays)</b><small>days</small></span>
          </li>
        }
      </ol>
    }
  </article>
  <!-- END SECTION -->
</section>
