@model ProjectManagement.Models.Analytics.CoeAnalyticsVm
@using System.Linq
@using System.Text.Json

@{
    var json = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    var overviewUrl = Url.Page("/Projects/Overview");
    var buckets = Model.SubcategoryProjects ?? Array.Empty<ProjectManagement.Models.Analytics.CoeSubcategoryProjectsVm>();
    var maxBucket = buckets.Count > 0 ? buckets.Max(bucket => bucket.Projects.Count) : 0;
    string StatusClass(string status) => status switch
    {
        "Ongoing" => "is-ongoing",
        "Completed" => "is-completed",
        "Cancelled" => "is-cancelled",
        _ => string.Empty
    };
}

<section class="analytics-panel analytics-panel--coe" aria-label="CoE projects analytics">
  <div class="analytics-row analytics-row--7-5">
    <!-- SECTION: Ongoing CoE projects by current stage -->
    <article class="analytics-card">
      <header class="analytics-card__head">
        <div class="analytics-card__text">
          <h2 class="analytics-card__title">Ongoing CoE projects by current stage</h2>
          <p class="analytics-card__meta">Every workflow stage in order; click a bar to see its projects below.</p>
        </div>
        <div class="analytics-card__actions">
          <button type="button" class="analytics-icon-btn" data-chart-download-target="coe-by-stage-chart" aria-label="Download chart as PNG" title="Download chart as PNG">
            <i class="bi bi-download" aria-hidden="true"></i>
          </button>
        </div>
      </header>
      <div class="analytics-card__chart">
        <canvas id="coe-by-stage-chart"
                role="img"
                aria-label="Ongoing CoE projects by current stage"
                data-empty-message="No CoE projects yet. Create a CoE project to see it here."
                data-series='@Html.Raw(JsonSerializer.Serialize(Model.HasCoeProjects ? Model.ByStage : Array.Empty<ProjectManagement.Models.Analytics.CoeStageBucketVm>(), json))'></canvas>
      </div>
      @await Html.PartialAsync("Partials/_BoardRows", (Model.StageBoard, "stage", overviewUrl, "Projects in each stage"))
    </article>
    <!-- END SECTION -->

    <!-- SECTION: CoE sub-categories by lifecycle -->
    <article class="analytics-card">
      <header class="analytics-card__head">
        <div class="analytics-card__text">
          <h2 class="analytics-card__title">Sub-categories by lifecycle</h2>
          <p class="analytics-card__meta">Ongoing, completed and cancelled projects in each CoE sub-category.</p>
        </div>
        <div class="analytics-card__actions">
          <button type="button" class="analytics-icon-btn" data-chart-download-target="coe-subcategories-by-lifecycle-chart" aria-label="Download chart as PNG" title="Download chart as PNG">
            <i class="bi bi-download" aria-hidden="true"></i>
          </button>
        </div>
      </header>
      <div class="analytics-card__legend" data-legend="coe-subcategories-by-lifecycle-chart"></div>
      <div class="analytics-card__chart">
        <canvas id="coe-subcategories-by-lifecycle-chart"
                role="img"
                aria-label="CoE sub-categories by lifecycle status"
                data-empty-message="Sub-category breakdown appears once CoE projects have sub-categories."
                data-series='@Html.Raw(JsonSerializer.Serialize(Model.SubcategoriesByLifecycle, json))'></canvas>
      </div>
      @if (Model.HasSubcategoryBreakdown)
      {
        <p class="analytics-card__foot">Only sub-categories with at least one project are shown.</p>
      }
    </article>
    <!-- END SECTION -->
  </div>

  <!-- SECTION: CoE projects by sub-category (sub-category → projects) -->
  <article class="analytics-card">
    <header class="analytics-card__head">
      <div class="analytics-card__text">
        <h2 class="analytics-card__title">Projects in each sub-category</h2>
        <p class="analytics-card__meta">Open a sub-category to see its projects with their lifecycle and current stage.</p>
      </div>
    </header>
    @if (buckets.Count == 0)
    {
      <p class="analytics-empty" role="status">No CoE projects with sub-categories yet.</p>
    }
    else
    {
      <section class="analytics-drill analytics-drill--flush" aria-label="CoE projects by sub-category">
        @foreach (var bucket in Model.OverflowProjects is null ? buckets : buckets.Append(Model.OverflowProjects))
        {
          var width = maxBucket > 0 ? (int)Math.Round(100.0 * bucket.Projects.Count / maxBucket) : 0;
          var ongoing = bucket.OngoingCount;
          var completed = bucket.CompletedCount;
          var cancelled = bucket.CancelledCount;
          var drillKey = ReferenceEquals(bucket, Model.OverflowProjects) ? ProjectManagement.Models.Analytics.CoeAnalyticsVm.OverflowSubcategoryKey : bucket.SubcategoryName;
          <details class="analytics-drill__row" data-drill-key="sub:@drillKey">
            <summary class="analytics-drill__summary">
              <span class="analytics-drill__name">@bucket.SubcategoryName</span>
              <span class="analytics-drill__bar" aria-hidden="true"><i style="--w:@(width)%"></i></span>
              <span class="analytics-drill__chips">
                @if (ongoing > 0) { <span class="analytics-drill__chip"><i class="analytics-dot is-ongoing" aria-hidden="true"></i>Ongoing <b>@ongoing</b></span> }
                @if (completed > 0) { <span class="analytics-drill__chip"><i class="analytics-dot is-completed" aria-hidden="true"></i>Completed <b>@completed</b></span> }
                @if (cancelled > 0) { <span class="analytics-drill__chip"><i class="analytics-dot is-cancelled" aria-hidden="true"></i>Cancelled <b>@cancelled</b></span> }
              </span>
              <span class="analytics-drill__count">@bucket.Projects.Count</span>
              <i class="bi bi-chevron-down analytics-drill__caret" aria-hidden="true"></i>
            </summary>
            <div class="analytics-drill__body">
              <ol class="analytics-drill__list">
                @foreach (var project in bucket.Projects)
                {
                  <li>
                    <a href="@overviewUrl?id=@project.Id">@project.Name</a>
                    <span class="analytics-drill__status @StatusClass(project.LifecycleStatus)">@project.LifecycleStatus</span>
                    @* A finished or cancelled project is identified by its lifecycle; its last stage is not shown. *@
                    @if (project.LifecycleStatus == "Ongoing")
                    {
                      <span class="analytics-drill__stage">@project.CurrentStage</span>
                    }
                  </li>
                }
              </ol>
            </div>
          </details>
        }
      </section>
    }
  </article>
  <!-- END SECTION -->

  <!-- SECTION: AR/VR projects outside the CoE categories (by name; completed first) -->
  <article class="analytics-card">
    <header class="analytics-card__head">
      <div class="analytics-card__text">
        <h2 class="analytics-card__title">AR/VR projects outside the CoE</h2>
        <p class="analytics-card__meta">AR/VR projects (by technical category) that are not in a CoE category: the earlier ones, completed before the formal CoE (AR/VR) nomination in 2025, and the AR/VR projects under DCD as fresh projects and repeat builds. Completed projects first. Not counted in the CoE figures above.</p>
      </div>
    </header>
    @if (Model.ArVrOutsideCoe.Sum(group => group.Count) == 0)
    {
      <p class="analytics-empty" role="status">No AR/VR projects outside the CoE categories.</p>
    }
    else
    {
      @await Html.PartialAsync("Partials/_BoardRows", (Model.ArVrOutsideCoe, "arvr", overviewUrl, "Outside the CoE categories"))
    }
  </article>
  <!-- END SECTION -->
</section>
