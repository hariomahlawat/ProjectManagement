@page
@using ProjectManagement.Features.MediaLibrary.Domain
@model ProjectManagement.Pages.Photos.People.ReviewModel
@{
    ViewData["Title"] = "Identify people";
    ViewData["PageShell"] = "wide";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/photos-people.css" asp-append-version="true" />
}

<div class="people-workspace">
    <header class="people-header">
        <div>
            <span class="people-eyebrow">Human-confirmed identity intelligence</span>
            <h1>Identify people</h1>
            <p>Review possible matches generated only from trusted references. Similarity is a ranking signal—not an identity probability—and PRISM never names a person automatically.</p>
        </div>
        <nav class="people-header__actions">
            @if (Model.FeatureEnabled)
            {
                <form method="post" asp-page-handler="RefreshCandidates">
                    <partial name="_ReviewStateFields" model="Model" />
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-repeat"></i> Refresh matches
                    </button>
                </form>
            }
            <a class="btn btn-outline-secondary" asp-page="./Index"><i class="bi bi-people"></i> People</a>
            <a class="btn btn-outline-secondary" asp-page="/Admin/MediaIntelligence/Index"><i class="bi bi-cpu"></i> Readiness</a>
        </nav>
    </header>

    @if (!Model.FeatureEnabled)
    {
        <section class="people-empty">
            <i class="bi bi-shield-lock" aria-hidden="true"></i>
            <h2>People intelligence is disabled</h2>
            <p>The approved local detector and embedding models must pass readiness before face grouping and identity review can run.</p>
            <a class="btn btn-primary" asp-page="/Admin/MediaIntelligence/Index">Open readiness dashboard</a>
        </section>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-success" role="status">@Model.StatusMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
        }

        <nav class="identity-review-tabs" aria-label="People review mode">
            <a class="identity-review-tab @(Model.IsMatchesMode ? "is-active" : null)"
               href="@(Model.BuildReviewUrl("matches", 1, "detail"))">
                <i class="bi bi-person-check"></i>
                <span>Known-person suggestions</span>
                @if (!Model.IsGroupsMode)
                {
                    <strong>@Model.Result.KnownMatchCount</strong>
                }
            </a>
            <a class="identity-review-tab @(Model.IsUnidentifiedMode ? "is-active" : null)"
               href="@(Model.BuildReviewUrl("unidentified", 1, "triage"))">
                <i class="bi bi-person-question"></i>
                <span>Unidentified faces</span>
                @if (!Model.IsGroupsMode)
                {
                    <strong>@Model.Result.UnidentifiedCount</strong>
                }
            </a>
            @if (Model.GroupingEnabled && Model.GroupingAvailable)
            {
                <a class="identity-review-tab @(Model.IsGroupsMode ? "is-active" : null)"
                   href="@(Model.BuildReviewUrl("groups", 1, "detail"))">
                    <i class="bi bi-collection"></i>
                    <span>Identity groups</span>
                    @if (Model.IsGroupsMode)
                    {
                        <strong>@Model.GroupResult.TotalGroups</strong>
                    }
                </a>
            }
        </nav>

        @if (Model.IsScopedToMedia && !Model.IsGroupsMode)
        {
            <div class="identity-review-scope" role="status">
                <span><i class="bi bi-images"></i> Review is limited to faces detected in <strong>@Model.AssetIds.Length selected media item@(Model.AssetIds.Length == 1 ? "" : "s")</strong>.</span>
                <a href="@Model.BuildClearMediaScopeUrl()">Clear media scope</a>
            </div>
        }

        @if (!Model.IsGroupsMode && Model.Result.CandidateSearchPendingCount > 0)
        {
            <div class="alert alert-info py-2" role="status">
                <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>
                @Model.Result.CandidateSearchPendingCount face(s) are being compared with confirmed people in the background. This page may be refreshed safely.
            </div>
        }
        @if (!Model.IsGroupsMode && Model.Result.CandidateSearchFailureCount > 0)
        {
            <div class="alert alert-warning py-2" role="status">
                <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                @Model.Result.CandidateSearchFailureCount face(s) could not be matched. Open the unidentified queue to inspect the failure and retry matching.
            </div>
        }

        @if (Model.IsGroupsMode)
        {
            <section class="review-summary review-summary--people">
                <div><strong>@Model.GroupResult.TotalGroups</strong><span>suggested people groups</span></div>
                <div><strong>@Model.GroupResult.GroupedFaceCount</strong><span>appearances grouped</span></div>
                <div><strong>@Model.GroupResult.RemainingIndividualFaceCount</strong><span>faces needing individual review</span></div>
                <p><i class="bi bi-shield-check"></i> A group is only a similarity suggestion. An authorised reviewer must select the correct appearances and confirm a name.</p>
            </section>

            @if (Model.GroupResult.Groups.Count == 0)
            {
                <section class="people-empty">
                    <i class="bi bi-person-check"></i>
                    <h2>No repeated unnamed people found</h2>
                    <p>There are no strict multi-photo groups awaiting confirmation. Continue with individual face review.</p>
                    <a class="btn btn-primary" asp-page="./Review" asp-route-Mode="unidentified">Review unidentified faces</a>
                </section>
            }
            else
            {
                <div class="identity-group-list">
                    @foreach (var group in Model.GroupResult.Groups)
                    {
                        <article class="identity-group-card" data-identity-group="@group.GroupKey">
                            <header class="identity-group-card__header">
                                <div>
                                    <span class="identity-group-card__kicker">Suggested same person</span>
                                    <h2>@group.Members.Count appearances across @group.PhotoCount photographs</h2>
                                    <p>@group.FirstSeenUtc.ToLocalTime().ToString("dd MMM yyyy") – @group.LastSeenUtc.ToLocalTime().ToString("dd MMM yyyy")</p>
                                </div>
                                <div class="identity-group-card__cohesion" title="Average similarity to the representative face">
                                    <span>Group similarity</span>
                                    <strong>@group.CohesionScore.ToString("0.000")</strong>
                                </div>
                            </header>

                            <div class="identity-group-mosaic" role="list" aria-label="Suggested appearances">
                                @foreach (var member in group.Members)
                                {
                                    <a class="identity-group-face @(member.FaceId == group.RepresentativeFaceId ? "is-representative" : null)"
                                       href="@Url.Page("/Photos/Media", new { id = member.AssetId, variant = "preview" })"
                                       target="_blank" rel="noopener" role="listitem"
                                       title="@member.ContextTitle · similarity @member.SimilarityToRepresentative.ToString("0.000")">
                                        <img src="@Url.Page("/Photos/FaceThumbnail", new { id = member.FaceId })"
                                             alt="Face appearance from @member.ContextTitle" loading="lazy" />
                                        @if (member.FaceId == group.RepresentativeFaceId)
                                        {
                                            <span class="identity-similarity is-representative" title="Representative appearance used only as the comparison anchor for this suggested group.">
                                                <em>Representative</em>
                                            </span>
                                        }
                                        else
                                        {
                                            var similarityBand = Model.GroupSimilarityBand(member.SimilarityToRepresentative);
                                            <span class="identity-similarity is-@similarityBand" title="Similarity is a ranking signal, not identity probability.">
                                                <em>@(similarityBand == "strong" ? "Strong" : similarityBand == "moderate" ? "Moderate" : "Weak")</em> @member.SimilarityToRepresentative.ToString("0.000")
                                            </span>
                                        }
                                    </a>
                                }
                            </div>

                            @if (group.Candidates.Count > 0)
                            {
                                <section class="identity-group-candidates" aria-label="Known-person matches">
                                    <h3>Possible existing person</h3>
                                    @foreach (var candidate in group.Candidates.Take(3))
                                    {
                                        var isStrong = candidate.ConfidenceLevel == FaceCandidateConfidenceLevel.Strong;
                                        <div class="identity-group-candidate">
                                            <a class="face-candidate__portrait" asp-page="./Details" asp-route-id="@candidate.PersonId"
                                               title="Open @candidate.DisplayName">
                                                @if (candidate.RepresentativeFaceId.HasValue)
                                                {
                                                    <img src="@Url.Page("/Photos/FaceThumbnail", new { id = candidate.RepresentativeFaceId })"
                                                         alt="Reference appearance for @candidate.DisplayName" loading="lazy" />
                                                }
                                                else
                                                {
                                                    <i class="bi bi-person" aria-hidden="true"></i>
                                                }
                                            </a>
                                            <span>
                                                <a asp-page="./Details" asp-route-id="@candidate.PersonId"><strong>@candidate.DisplayName</strong></a>
                                                <small title="Embedding similarity is a ranking signal, not an identity probability.">
                                                    Similarity @candidate.Similarity.ToString("0.000") · @candidate.ReferenceCount trusted @(candidate.ReferenceCount == 1 ? "reference" : "references")
                                                    <em class="candidate-strength @(isStrong ? "is-strong" : "is-possible")">@(isStrong ? "Strong candidate" : "Possible match")</em>
                                                </small>
                                            </span>
                                            <div class="identity-group-candidate__actions">
                                                <button type="button"
                                                        class="btn btn-sm @(isStrong ? "btn-outline-success" : "btn-outline-primary")"
                                                        data-use-group-candidate
                                                        data-person-id="@candidate.PersonId"
                                                        data-target-select="existing-@group.GroupKey">
                                                    Use @candidate.DisplayName
                                                </button>
                                                <button type="submit"
                                                        form="group-decision-@group.GroupKey"
                                                        formaction="@(Url.Page("./Review", "RejectGroupCandidate"))"
                                                        name="candidatePersonId"
                                                        value="@candidate.PersonId"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        data-group-candidate-submit>
                                                    Reject for selected
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </section>
                            }

                            <form id="group-decision-@group.GroupKey" method="post" class="identity-group-decision" data-group-decision>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Mode" value="groups" />
                                <div class="identity-group-selection">
                                    <div>
                                        <strong>Select appearances that are the same person</strong>
                                        <span data-selected-count>0 selected</span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link" data-toggle-group-selection>Select all</button>
                                </div>
                                <div class="identity-group-checkboxes">
                                    @foreach (var member in group.Members)
                                    {
                                        <label>
                                            <input class="form-check-input" type="checkbox" name="faceIds" value="@member.FaceId" />
                                            <span>@member.ContextTitle</span>
                                        </label>
                                    }
                                </div>
                                <div class="identity-group-actions">
                                    <div>
                                        <label for="existing-@group.GroupKey">Assign to an existing person</label>
                                        <select id="existing-@group.GroupKey" class="form-select" name="personId">
                                            <option value="">Select a person</option>
                                            @foreach (var person in Model.AvailablePeople)
                                            {
                                                <option value="@person.Id">@person.DisplayName</option>
                                            }
                                        </select>
                                        <button type="submit" asp-page-handler="AssignGroup" class="btn btn-outline-primary">Assign selected</button>
                                    </div>
                                    <div>
                                        <label for="new-@group.GroupKey">Or create a new person</label>
                                        <input id="new-@group.GroupKey" class="form-control" name="displayName" maxlength="200" placeholder="Enter the correct name" />
                                        <button type="submit" asp-page-handler="CreateGroup" class="btn btn-primary">Create and confirm selected</button>
                                    </div>
                                </div>
                            </form>
                        </article>
                    }
                </div>
            }
        }
        else
        {
            @if (Model.ReviewDataAvailable)
            {
                <section class="review-summary">
                    <strong>@Model.Result.TotalFaces</strong>
                    <span>@(Model.IsMatchesMode ? "known-person suggestion" : "unidentified face")@(Model.Result.TotalFaces == 1 ? string.Empty : "s") awaiting a human decision</span>
                </section>
            }

            @if (!Model.ReviewDataAvailable)
            {
                <section class="people-empty">
                    <i class="bi bi-database-exclamation"></i>
                    <h2>Review data temporarily unavailable</h2>
                    <p>The error has been logged. Retry after checking database connectivity and application logs.</p>
                </section>
            }
            else if (Model.Result.Items.Count == 0)
            {
                <section class="people-empty">
                    @if (Model.HasQueueFilters)
                    {
                        <i class="bi bi-funnel"></i>
                        <h2>No faces match these filters</h2>
                        <p>The review queue may still contain other faces. Clear the current source, year or matching-status filters to continue reviewing.</p>
                        <a class="btn btn-outline-primary" href="@Model.BuildClearQueueFiltersUrl()">Clear review filters</a>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle"></i>
                        <h2>@(Model.IsMatchesMode ? "Known-person queue clear" : "Unidentified queue clear")</h2>
                        <p>@(Model.IsMatchesMode
                            ? "No detected face currently has a pending known-person suggestion. New matches are generated automatically in the background."
                            : "No valid detected face currently requires creation or manual assignment of a person.")</p>
                    }
                </section>
            }
            else
            {
                <div class="face-review-queue-controls">
                    <div class="face-review-layout-toggle" role="group" aria-label="Review layout">
                        @if (Model.IsUnidentifiedMode)
                        {
                            <a class="@(Model.IsTriageLayout ? "is-active" : null)" href="@(Model.BuildReviewUrl(layout: "triage", pageNumber: 1))">Triage</a>
                            <a class="@(!Model.IsTriageLayout ? "is-active" : null)" href="@(Model.BuildReviewUrl(layout: "detail", pageNumber: 1))">Detailed</a>
                        }
                    </div>

                    <form method="get" class="face-review-filters" aria-label="Filter review queue">
                        <input type="hidden" name="Mode" value="@Model.Mode" />
                        <input type="hidden" name="Layout" value="@Model.Layout" />
                        <input type="hidden" name="Sort" value="@Model.Sort" />
                        @foreach (var assetId in Model.AssetIds)
                        {
                            <input type="hidden" name="AssetIds" value="@assetId" />
                        }
                        <label>
                            <span>Source</span>
                            <select class="form-select form-select-sm" name="Source" onchange="this.form.submit()">
                                <option value="all" selected="@(Model.Source == "all")">All sources</option>
                                <option value="projects" selected="@(Model.Source == "projects")">Projects</option>
                                <option value="visits" selected="@(Model.Source == "visits")">Visits</option>
                                <option value="events" selected="@(Model.Source == "events")">Events</option>
                                <option value="activities" selected="@(Model.Source == "activities")">Activities</option>
                                @if (Model.ExternalSourcesEnabled)
                                {
                                    <option value="external" selected="@(Model.Source == "external")">External folders</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>Year</span>
                            <select class="form-select form-select-sm" name="Year" onchange="this.form.submit()">
                                <option value="">All years</option>
                                @foreach (var year in Model.AvailableYears)
                                {
                                    <option value="@year" selected="@(Model.Year == year)">@year</option>
                                }
                            </select>
                        </label>
                        @if (Model.IsUnidentifiedMode)
                        {
                            <label>
                                <span>Matching</span>
                                <select class="form-select form-select-sm" name="MatchStatus" onchange="this.form.submit()">
                                    <option value="all" selected="@(Model.MatchStatus == "all")">All statuses</option>
                                    <option value="no-match" selected="@(Model.MatchStatus == "no-match")">No reliable match</option>
                                    <option value="failed" selected="@(Model.MatchStatus == "failed")">Matching failed</option>
                                    <option value="not-requested" selected="@(Model.MatchStatus == "not-requested")">Not yet matched</option>
                                </select>
                            </label>
                        }
                    </form>

                    <label class="face-review-sort">
                        <span>Sort</span>
                        <select class="form-select form-select-sm" aria-label="Sort review queue" onchange="if(this.value) window.location.href=this.value">
                            <option value="@(Model.BuildReviewUrl(sort: "quality-desc", pageNumber: 1))" selected="@(Model.Sort == "quality-desc")">Highest quality first</option>
                            <option value="@(Model.BuildReviewUrl(sort: "quality-asc", pageNumber: 1))" selected="@(Model.Sort == "quality-asc")">Lowest quality first</option>
                            <option value="@(Model.BuildReviewUrl(sort: "newest", pageNumber: 1))" selected="@(Model.Sort == "newest")">Newest first</option>
                            <option value="@(Model.BuildReviewUrl(sort: "oldest", pageNumber: 1))" selected="@(Model.Sort == "oldest")">Oldest first</option>
                        </select>
                    </label>
                </div>

                <form id="batchAssignKnownPersonForm" method="post"
                      class="card border-0 shadow-sm mb-3 face-review-batch" data-batch-identity-form>
                    @Html.AntiForgeryToken()
                    <div class="card-body py-3 d-flex flex-wrap align-items-end gap-3">
                        <partial name="_ReviewStateFields" model="Model" />
                        @if (Model.AvailablePeople.Count > 0)
                        {
                            <div>
                                <label class="form-label mb-1" for="batchKnownPerson">Assign selected appearances to</label>
                                <select id="batchKnownPerson" class="form-select" name="personId">
                                    <option value="">Select a confirmed person</option>
                                    @foreach (var person in Model.AvailablePeople)
                                    {
                                        <option value="@person.Id">@person.DisplayName</option>
                                    }
                                </select>
                            </div>
                            <button type="submit" asp-page-handler="AssignSelected" class="btn btn-primary" data-batch-identity-submit data-requires-person>
                                Assign <span data-batch-identity-count>0</span> selected
                            </button>
                        }
                        @if (Model.IsUnidentifiedMode)
                        {
                            <button type="submit" asp-page-handler="IgnoreSelected" class="btn btn-outline-secondary" data-batch-triage-submit>Leave unidentified</button>
                            <button type="submit" asp-page-handler="SuppressSelected" class="btn btn-outline-danger" data-batch-triage-submit>Not a face</button>
                        }
                        <button type="button" class="btn btn-link" data-batch-select-all>Select all visible</button>
                        <button type="button" class="btn btn-link" data-batch-clear>Clear</button>
                        <span class="small text-body-secondary">Identity assignment still requires different photographs; PRISM validates this before confirmation.</span>
                    </div>
                </form>

                @if (Model.IsTriageLayout)
                {
                    <div class="face-review-triage-grid">
                        @foreach (var item in Model.Result.Items)
                        {
                            <article class="face-triage-card" id="face-@item.FaceId">
                                <label class="face-triage-card__select" title="Select this appearance for a batch action">
                                    <input class="form-check-input" type="checkbox" name="faceIds" value="@item.FaceId" form="batchAssignKnownPersonForm" data-batch-identity-face />
                                    <span class="visually-hidden">Select face from @item.ContextTitle</span>
                                </label>
                                <img src="@Url.Page("/Photos/FaceThumbnail", new { id = item.FaceId })" alt="Detected face from @item.ContextTitle" loading="lazy" />
                                <div class="face-triage-card__body">
                                    <div><strong>Quality @item.QualityScore.ToString("0.00")</strong><span>@item.MediaDateUtc.ToLocalTime().ToString("dd MMM yyyy")</span></div>
                                    <h2 title="@item.ContextTitle">@item.ContextTitle</h2>
                                    <p>@item.ContextSubtitle</p>
                                    <div class="face-triage-card__actions">
                                        <a href="@Url.Page("/Photos/Media", new { id = item.AssetId, variant = "preview" })" target="_blank" rel="noopener">Photograph <i class="bi bi-arrow-up-right"></i></a>
                                        <a href="@(Model.BuildReviewUrl(layout: "detail"))#face-@item.FaceId">Details</a>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="face-review-list">
                    @foreach (var item in Model.Result.Items)
                    {
                        <article class="face-review-card" id="face-@item.FaceId">
                            <label class="face-review-card__select" title="Select this appearance for a batch action">
                                <input class="form-check-input" type="checkbox" name="faceIds" value="@item.FaceId"
                                       form="batchAssignKnownPersonForm" data-batch-identity-face />
                                <span class="visually-hidden">Select face from @item.ContextTitle</span>
                            </label>
                            <div class="face-review-card__face">
                                <img src="@Url.Page("/Photos/FaceThumbnail", new { id = item.FaceId })" alt="Detected face" loading="lazy" />
                                <span>Quality @item.QualityScore.ToString("0.00")</span>
                            </div>
                            <div class="face-review-card__content">
                                <header>
                                    <div>
                                        <h2>@item.ContextTitle</h2>
                                        <p>@item.ContextSubtitle · @item.MediaDateUtc.ToLocalTime().ToString("dd MMM yyyy")</p>
                                    </div>
                                    <a class="btn btn-sm btn-outline-secondary"
                                       href="@Url.Page("/Photos/Media", new { id = item.AssetId, variant = "preview" })"
                                       target="_blank" rel="noopener">View photograph <i class="bi bi-arrow-up-right"></i></a>
                                </header>

                                @if (item.CandidateSearchStatus == ProjectManagement.Features.MediaLibrary.Domain.FaceCandidateSearchStatus.Failed)
                                {
                                    <div class="alert alert-warning py-2 mb-3" role="status">
                                        <strong>Known-person matching needs retry.</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.CandidateSearchFailureReason))
                                        {
                                            <span>@item.CandidateSearchFailureReason</span>
                                        }
                                    </div>
                                }
                                <div class="face-candidates" aria-label="Suggested people">
                                    @if (item.Candidates.Count == 0)
                                    {
                                        <div class="face-candidates__empty">
                                            <i class="bi bi-person-question" aria-hidden="true"></i>
                                            <span>@(Model.IsMatchesMode ? "No active suggestion remains for this face." : "No reliable known-person match was found. Assign an existing person or create a new identity.")</span>
                                        </div>
                                    }
                                    @foreach (var candidate in item.Candidates)
                                    {
                                        <div class="face-candidate face-candidate--with-portrait">
                                            <a class="face-candidate__portrait" asp-page="./Details" asp-route-id="@candidate.PersonId"
                                               title="Open @candidate.DisplayName">
                                                @if (candidate.RepresentativeFaceId.HasValue)
                                                {
                                                    <img src="@Url.Page("/Photos/FaceThumbnail", new { id = candidate.RepresentativeFaceId })"
                                                         alt="Reference appearance for @candidate.DisplayName" loading="lazy" />
                                                }
                                                else
                                                {
                                                    <i class="bi bi-person" aria-hidden="true"></i>
                                                }
                                            </a>
                                            <span class="face-candidate__identity">
                                                <a asp-page="./Details" asp-route-id="@candidate.PersonId"><strong>@candidate.DisplayName</strong></a>
                                                <small title="Embedding similarity is a ranking signal, not an identity probability.">
                                                    Similarity @(candidate.Similarity?.ToString("0.000") ?? "—") · rank @candidate.Rank · @candidate.ReferenceCount trusted @(candidate.ReferenceCount == 1 ? "reference" : "references")
                                                    @if (candidate.MarginAvailable && candidate.MarginToNext.HasValue)
                                                    {
                                                        <span> · separation @candidate.MarginToNext.Value.ToString("0.000")</span>
                                                    }
                                                    else
                                                    {
                                                        <span> · separation unavailable</span>
                                                    }
                                                    @if (candidate.IsStrong)
                                                    {
                                                        <em class="candidate-strength is-strong">Strong candidate</em>
                                                    }
                                                    else if (candidate.IsPossible)
                                                    {
                                                        <em class="candidate-strength is-possible">Possible match</em>
                                                    }
                                                </small>
                                                @if (!candidate.MarginAvailable)
                                                {
                                                    <span class="candidate-evidence-note">Strong separation evidence is unavailable for this candidate; confirm only after visual verification.</span>
                                                }
                                            </span>
                                            <form method="post" asp-page-handler="Confirm">
                                                <partial name="_ReviewStateFields" model="Model" />
                                                <input type="hidden" name="faceId" value="@item.FaceId" />
                                                <input type="hidden" name="personId" value="@candidate.PersonId" />
                                                <input type="hidden" name="confidence" value="@candidate.Similarity" />
                                                <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i> Confirm</button>
                                            </form>
                                            <form method="post" asp-page-handler="Reject">
                                                <partial name="_ReviewStateFields" model="Model" />
                                                <input type="hidden" name="faceId" value="@item.FaceId" />
                                                <input type="hidden" name="personId" value="@candidate.PersonId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i> Not this person</button>
                                            </form>
                                        </div>
                                    }
                                </div>

                                <div class="face-review-card__alternatives">
                                    @if (Model.AvailablePeople.Count > 0)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#assignExistingModal"
                                                data-face-id="@item.FaceId"
                                                data-face-context="@item.ContextTitle">
                                            <i class="bi bi-person-check"></i> Assign an existing person
                                        </button>
                                    }
                                    <form method="post" asp-page-handler="Create" class="face-create-person">
                                        <partial name="_ReviewStateFields" model="Model" />
                                        <input type="hidden" name="faceId" value="@item.FaceId" />
                                        <label for="new-person-@item.FaceId">Create a new person</label>
                                        <input id="new-person-@item.FaceId" class="form-control" name="displayName" maxlength="200" placeholder="Enter the correct name" required />
                                        <button type="submit" class="btn btn-primary">Create and confirm</button>
                                    </form>
                                    <div class="face-review-card__secondary-actions">
                                        @if (item.Candidates.Count > 0)
                                        {
                                            <form method="post" asp-page-handler="RejectAll">
                                                <partial name="_ReviewStateFields" model="Model" />
                                                <input type="hidden" name="faceId" value="@item.FaceId" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">Reject all suggestions</button>
                                            </form>
                                        }
                                        <form method="post" asp-page-handler="Ignore">
                                            <partial name="_ReviewStateFields" model="Model" />
                                            <input type="hidden" name="faceId" value="@item.FaceId" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Leave unidentified</button>
                                        </form>
                                        <form method="post" asp-page-handler="Suppress">
                                            <partial name="_ReviewStateFields" model="Model" />
                                            <input type="hidden" name="faceId" value="@item.FaceId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Not a face</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </article>
                    }
                    </div>
                }

                <nav class="people-pagination" aria-label="Review pages">
                    @if (Model.Result.HasPreviousPage)
                    {
                        <a class="btn btn-outline-secondary" href="@(Model.BuildReviewUrl(pageNumber: Model.Result.PageNumber - 1))">
                            <i class="bi bi-arrow-left"></i> Previous
                        </a>
                    }
                    <span>Page @Model.Result.PageNumber</span>
                    @if (Model.Result.HasNextPage)
                    {
                        <a class="btn btn-outline-secondary" href="@(Model.BuildReviewUrl(pageNumber: Model.Result.PageNumber + 1))">
                            Next <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                </nav>
            }
        }

        @if (Model.AvailablePeople.Count > 0 && !Model.IsGroupsMode)
        {
            <div class="modal fade" id="assignExistingModal" tabindex="-1" aria-labelledby="assignExistingModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form method="post" asp-page-handler="AssignExisting">
                            <div class="modal-header">
                                <div>
                                    <h2 class="modal-title fs-5" id="assignExistingModalLabel">Assign an existing person</h2>
                                    <p class="mb-0 small text-body-secondary" data-face-context>Choose the confirmed identity for this face.</p>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <partial name="_ReviewStateFields" model="Model" />
                                <input type="hidden" name="faceId" value="" />
                                <label for="existingPersonId" class="form-label">Person</label>
                                <select id="existingPersonId" class="form-select" name="personId" required>
                                    <option value="">Select a person</option>
                                    @foreach (var person in Model.AvailablePeople)
                                    {
                                        <option value="@person.Id">@person.DisplayName</option>
                                    }
                                </select>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary">Assign person</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script src="~/js/pages/photos-people-review.js" asp-append-version="true"></script>
}
