@page "/Photos"
@model ProjectManagement.Pages.Photos.IndexModel
@using ProjectManagement.Pages.Photos
@{
    ViewData["Title"] = Model.IsAlbumDetail && Model.CurrentAlbum is not null
        ? $"{Model.CurrentAlbum.Name} — Photos"
        : Model.SelectedPeople.Count == 1
            ? $"{Model.SelectedPeople[0].Name} — Photos"
            : Model.SelectedPeople.Count > 1
                ? "People together — Photos"
                : "Photos";
    ViewData["PageShell"] = "wide";
    var hasPeopleFilter = Model.PersonIds.Length > 0;
    var hasFilters = !Model.IsAlbumsWorkspace && !Model.IsAlbumDetail && (!string.IsNullOrWhiteSpace(Model.Q)
                     || Model.Source != "all"
                     || Model.Kind != "all"
                     || Model.Classification != "all"
                     || Model.ProjectId.HasValue
                     || hasPeopleFilter
                     || Model.Year.HasValue
                     || Model.IsCollectionDetail);
    var activeFilterCount = new[]
    {
        !string.IsNullOrWhiteSpace(Model.Q),
        Model.Source != "all",
        Model.Kind != "all",
        Model.Classification != "all",
        Model.ProjectId.HasValue,
        hasPeopleFilter,
        Model.Year.HasValue,
        Model.IsCollectionDetail
    }.Count(value => value);
    var galleryHeading = Model.SelectedPeople.Count == 1
        ? Model.SelectedPeople[0].Name
        : "Photos together";
    var selectedNames = string.Join(", ", Model.SelectedPeople.Select(person => person.Name));
}

@section Styles { <link rel="stylesheet" href="~/css/pages/photos-library.css" asp-append-version="true" /> }

<div class="photos-library @(Model.IsPeopleGallery ? "photos-library--people" : null)"
     data-photos-library
     data-library-version="@Model.LibraryRevision"
     data-auto-refresh-url="@(Model.IsAlbumsWorkspace ? null : Url.Page("./Index", "Revision", new { AlbumId = Model.AlbumId }))"
     data-organize-album="@(Model.OrganizeAlbum ? "true" : "false")"
     data-sparse-last-row="@(Model.IsPeopleGallery || Model.IsCollectionDetail || Model.IsAlbumDetail ? "true" : "false")">
    <header class="photos-hero @(Model.IsPeopleGallery ? "photos-hero--person" : null)">
        @if (Model.IsPeopleGallery && Model.SelectedPeople.Count > 0)
        {
            <div class="photos-person-hero">
                <a class="photos-person-hero__back" asp-page="/Photos/People/Index"><i class="bi bi-chevron-left"></i> People</a>
                <div class="photos-person-hero__main">
                    <div class="photos-person-hero__faces" aria-hidden="true">
                        @foreach (var person in Model.SelectedPeople.Take(4))
                        {
                            <span>
                                @if (person.RepresentativeFaceId.HasValue)
                                {
                                    <img src="@Url.Page("/Photos/People/Portrait", new { id = person.Id })" alt="" />
                                }
                                else
                                {
                                    <i class="bi bi-person-fill"></i>
                                }
                            </span>
                        }
                    </div>
                    <div>
                        <span class="photos-eyebrow">People in Photos</span>
                        <h1>@galleryHeading</h1>
                        <p>
                            @if (Model.SelectedPeople.Count == 1)
                            {
                                <text>@Model.Stats.Photos photograph@(Model.Stats.Photos == 1 ? "" : "s") featuring @Model.SelectedPeople[0].Name.</text>
                            }
                            else if (Model.MatchAllSelectedPeople)
                            {
                                <text>@Model.Stats.Photos photograph@(Model.Stats.Photos == 1 ? "" : "s") containing all selected people.</text>
                            }
                            else
                            {
                                <text>@Model.Stats.Photos photograph@(Model.Stats.Photos == 1 ? "" : "s") containing any selected person.</text>
                            }
                        </p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div>
                <span class="photos-eyebrow">Unified organisational media</span>
                <h1>Photos</h1>
                <p>Browse project photographs, visits, activities, events and videos in one place.</p>
            </div>
        }
        <div class="photos-hero__actions">
            @if (Model.IsPeopleGallery)
            {
                <a class="photos-action photos-action--quiet" href="@Model.BuildPeoplePickerUrl()"><i class="bi bi-people"></i><span>Choose people</span></a>
                @if (Model.CanManagePeople && Model.SelectedPeople.Count == 1)
                {
                    <a class="photos-action photos-action--quiet" asp-page="/Photos/People/Details" asp-route-id="@Model.SelectedPeople[0].Id"><i class="bi bi-sliders"></i><span>Manage identity</span></a>
                }
            }
            @if ((Model.View == "photos" || Model.IsAlbumDetail) && Model.Groups.Count > 0 && !Model.OrganizeAlbum)
            {
                <button type="button" class="photos-action photos-action--quiet" data-photos-select-toggle aria-pressed="false"><i class="bi bi-check2-circle"></i><span>Select</span></button>
            }
            @if (Model.IsAlbumsWorkspace)
            {
                <button type="button" class="photos-action photos-action--primary" data-bs-toggle="modal" data-bs-target="#createAlbumModal"><i class="bi bi-plus-lg"></i><span>New album</span></button>
            }
            <div class="dropdown">
                <button class="photos-action photos-action--quiet" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More options"><i class="bi bi-three-dots"></i></button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    @if (Model.IsPeopleGallery)
                    {
                        <li><a class="dropdown-item" href="@Model.BuildClearPeopleUrl()"><i class="bi bi-images me-2"></i>Remove people filter</a></li>
                    }
                    @if (Model.CanManagePeople)
                    {
                        <li><a class="dropdown-item" asp-page="/Admin/MediaIntelligence/Index"><i class="bi bi-cpu me-2"></i>Media intelligence</a></li>
                        <li><a class="dropdown-item" asp-page="/Admin/MediaSources/Index"><i class="bi bi-hdd-network me-2"></i>Media sources</a></li>
                    }
                </ul>
            </div>
        </div>
    </header>

    <nav class="photos-primary-tabs" aria-label="Photos sections">
        <a asp-page="./Index" asp-route-View="photos" class="@(!Model.IsPeopleGallery && Model.View == "photos" && !Model.IsCollectionDetail ? "is-active" : null)">Photos</a>
        <a asp-page="./Index" asp-route-View="collections" class="@(!Model.IsPeopleGallery && (Model.View == "collections" || Model.IsCollectionDetail || Model.IsAlbumDetail) ? "is-active" : null)">Collections</a>
        @if (Model.PeopleFeatureEnabled)
        {
            <a class="@(Model.IsPeopleGallery ? "is-active" : null)" asp-page="/Photos/People/Index">People</a>
        }
    </nav>

    @if (!Model.IsPeopleGallery && (Model.View == "collections" || Model.IsAlbumDetail))
    {
        <nav class="photos-collection-tabs" aria-label="Collection type">
            <a class="@(!Model.IsAlbumsWorkspace && !Model.IsAlbumDetail ? "is-active" : null)" href="@Model.BuildCollectionsUrl()">Source collections</a>
            <a class="@(Model.IsAlbumsWorkspace || Model.IsAlbumDetail ? "is-active" : null)" href="@Model.BuildAlbumsUrl()">Albums</a>
        </nav>
    }

    @if (Model.IsAlbumDetail && Model.CurrentAlbum is not null)
    {
        <section class="photos-album-context" aria-label="Current album">
            <div class="photos-album-context__main">
                <a class="photos-album-context__back" href="@Model.BuildAlbumsUrl()"><i class="bi bi-chevron-left" aria-hidden="true"></i> Albums</a>
                <div>
                    <div class="photos-album-context__title-row">
                        <h2>@Model.CurrentAlbum.Name</h2>
                        @if (Model.CurrentAlbum.IsArchived) { <span class="badge text-bg-secondary">Archived</span> }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentAlbum.Description)) { <p>@Model.CurrentAlbum.Description</p> }
                    <span>@Model.CurrentAlbum.ItemCount item@(Model.CurrentAlbum.ItemCount == 1 ? "" : "s") · Updated @Model.CurrentAlbum.UpdatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                </div>
            </div>
            @if (Model.CanManageCurrentAlbum)
            {
                <div class="photos-album-context__actions">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editAlbumModal"><i class="bi bi-pencil"></i> Edit album</button>
                    <a class="btn btn-sm @(Model.OrganizeAlbum ? "btn-primary" : "btn-outline-primary")" href="@Model.BuildAlbumUrl(Model.CurrentAlbum.Id, !Model.OrganizeAlbum)"><i class="bi bi-grip-vertical"></i> @(Model.OrganizeAlbum ? "Done organising" : "Organise")</a>
                </div>
            }
        </section>
    }

    @if (Model.IsCollectionDetail)
    {
        <section class="photos-collection-context" aria-label="Current collection">
            <a href="@Model.BuildCollectionsUrl()"><i class="bi bi-chevron-left" aria-hidden="true"></i> Collections</a>
            <span>@(Model.CurrentCollectionTitle ?? "Selected collection")</span>
        </section>
    }

    @if (Model.IsPeopleGallery && Model.SelectedPeople.Count > 0)
    {
        <section class="photos-people-bar" aria-label="Selected people">
            <div class="photos-people-chips">
                @foreach (var person in Model.SelectedPeople)
                {
                    <a class="photos-person-chip" href="@Model.BuildRemovePersonUrl(person.Id)" title="Remove @person.Name from this gallery">
                        @if (person.RepresentativeFaceId.HasValue)
                        {
                            <img src="@Url.Page("/Photos/People/Portrait", new { id = person.Id })" alt="" />
                        }
                        else
                        {
                            <i class="bi bi-person-fill"></i>
                        }
                        <span>@person.Name</span><i class="bi bi-x"></i>
                    </a>
                }
                <a class="photos-person-chip photos-person-chip--add" href="@Model.BuildPeoplePickerUrl()"><i class="bi bi-plus"></i><span>Add people</span></a>
            </div>
            @if (Model.SelectedPeople.Count > 1)
            {
                <div class="photos-people-match" role="group" aria-label="People matching mode">
                    <a class="@(Model.MatchAllSelectedPeople ? "is-active" : null)" href="@Model.BuildPeopleMatchUrl("all")">Together</a>
                    <a class="@(!Model.MatchAllSelectedPeople ? "is-active" : null)" href="@Model.BuildPeopleMatchUrl("any")">Any selected</a>
                </div>
            }
        </section>
    }

    @if (TempData["PhotosSuccess"] is string successMessage)
    {
        <div class="alert alert-success photos-flash" role="status">@successMessage</div>
    }
    @if (TempData["PhotosError"] is string errorMessage)
    {
        <div class="alert alert-danger photos-flash" role="alert">@errorMessage</div>
    }

    @if (!Model.IsAlbumDetail)
    {
        <section class="photos-toolbar" aria-label="Media controls">
            <form method="get" class="photos-search" role="search">
                <input type="hidden" name="View" value="@Model.View" />
                @if (Model.IsAlbumsWorkspace) { <input type="hidden" name="CollectionTab" value="albums" /> }
                <i class="bi bi-search"></i>
                <input type="search" name="Q" value="@Model.Q" placeholder="@(Model.IsAlbumsWorkspace ? "Search albums" : Model.IsPeopleGallery ? $"Search photos of {selectedNames}" : Model.PeopleFeatureEnabled ? "Search photos, projects, visits, activities, events, albums or people" : "Search photos, projects, visits, activities, events or albums")" autocomplete="off" data-photos-search />
                @if (!Model.IsAlbumsWorkspace)
                {
                    <input type="hidden" name="Source" value="@Model.Source" /><input type="hidden" name="Kind" value="@Model.Kind" /><input type="hidden" name="Classification" value="@Model.Classification" />
                    @if (Model.ProjectId.HasValue) { <input type="hidden" name="ProjectId" value="@Model.ProjectId" /> }
                    @foreach (var personId in Model.PersonIds) { <input type="hidden" name="PersonIds" value="@personId" /> }
                    @if (Model.PersonIds.Length > 1) { <input type="hidden" name="PeopleMatch" value="@Model.PeopleMatch" /> }
                    @if (Model.Year.HasValue) { <input type="hidden" name="Year" value="@Model.Year" /> }
                    @if (Model.IsCollectionDetail) { <input type="hidden" name="Collection" value="@Model.Collection" /> }
                    @if (Model.IncludeSingletonCollections) { <input type="hidden" name="IncludeSingletonCollections" value="true" /> }
                }
                @if (Model.Sort != "newest") { <input type="hidden" name="Sort" value="@Model.Sort" /> }
                @if (Model.IsAlbumsWorkspace && Model.IncludeArchivedAlbums) { <input type="hidden" name="IncludeArchivedAlbums" value="true" /> }
            </form>
            <div class="photos-toolbar__controls">
                @if (Model.IsAlbumsWorkspace)
                {
                    <a class="photos-control @(Model.IncludeArchivedAlbums ? "is-active" : null)" href="@Model.BuildAlbumsUrl(!Model.IncludeArchivedAlbums)"><i class="bi bi-archive"></i><span>@(Model.IncludeArchivedAlbums ? "Hide archived" : "Show archived")</span></a>
                }
                else
                {
                    <button class="photos-control" type="button" data-bs-toggle="offcanvas" data-bs-target="#photosFilters"><i class="bi bi-sliders2"></i><span>Filters</span>@if(activeFilterCount>0){<b>@activeFilterCount</b>}</button>
                }
                <div class="dropdown photos-sort">
                    <button class="photos-control" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Sort @(Model.IsAlbumsWorkspace ? "albums" : "media")">
                        <i class="bi bi-arrow-down-up"></i><span>@(Model.Sort == "oldest" ? "Oldest" : "Newest")</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><a class="dropdown-item @(Model.Sort == "newest" ? "active" : null)" href="@Model.BuildSortUrl("newest")">Newest first</a></li>
                        <li><a class="dropdown-item @(Model.Sort == "oldest" ? "active" : null)" href="@Model.BuildSortUrl("oldest")">Oldest first</a></li>
                    </ul>
                </div>
                @if (!Model.IsAlbumsWorkspace)
                {
                    <nav class="photos-segments" aria-label="Media type">
                        <a class="@(Model.Kind == "all" ? "is-active" : null)" href="@Model.BuildMediaTypeUrl("all")">All</a>
                        <a class="@(Model.Kind == "photo" ? "is-active" : null)" href="@Model.BuildMediaTypeUrl("photo")">Photos</a>
                        <a class="@(Model.Kind == "video" ? "is-active" : null)" href="@Model.BuildMediaTypeUrl("video")">Videos</a>
                    </nav>
                }
            </div>
        </section>
    }

    <div class="photos-summary">
        @if (Model.IsAlbumsWorkspace)
        {
            <span class="photos-summary__metric"><strong>@Model.Stats.Collections</strong> album@(Model.Stats.Collections == 1 ? "" : "s")</span>
            <span class="photos-summary__separator" aria-hidden="true">·</span>
            <span class="photos-summary__metric"><strong>@Model.Stats.Total</strong> album item@(Model.Stats.Total == 1 ? "" : "s")</span>
            <span class="photos-summary__separator" aria-hidden="true">·</span>
            <span class="photos-summary__metric"><strong>@Model.Stats.Photos</strong> photo@(Model.Stats.Photos == 1 ? "" : "s")</span>
            <span class="photos-summary__separator" aria-hidden="true">·</span>
            <span class="photos-summary__metric"><strong>@Model.Stats.Videos</strong> video@(Model.Stats.Videos == 1 ? "" : "s")</span>
        }
        else if (Model.View == "collections" && !Model.IsCollectionDetail)
        {
            <span class="photos-summary__metric"><strong>@Model.Stats.Collections</strong> collection@(Model.Stats.Collections == 1 ? "" : "s")</span>
            <span class="photos-summary__separator" aria-hidden="true">·</span>
            <span class="photos-summary__metric"><strong>@Model.Stats.Total</strong> grouped item@(Model.Stats.Total == 1 ? "" : "s")</span>
            <span class="photos-summary__separator" aria-hidden="true">·</span>
            <span class="photos-summary__metric"><strong>@Model.Stats.Photos</strong> photo@(Model.Stats.Photos == 1 ? "" : "s")</span>
            <span class="photos-summary__separator" aria-hidden="true">·</span>
            <span class="photos-summary__metric"><strong>@Model.Stats.Videos</strong> video@(Model.Stats.Videos == 1 ? "" : "s")</span>
        }
        else
        {
            <span class="photos-summary__metric"><strong>@Model.Stats.Total</strong> item@(Model.Stats.Total == 1 ? "" : "s")</span>
            <span class="photos-summary__separator" aria-hidden="true">·</span>
            <span class="photos-summary__metric"><strong>@Model.Stats.Photos</strong> photo@(Model.Stats.Photos == 1 ? "" : "s")</span>
            <span class="photos-summary__separator" aria-hidden="true">·</span>
            <span class="photos-summary__metric"><strong>@Model.Stats.Videos</strong> video@(Model.Stats.Videos == 1 ? "" : "s")</span>
        }
    </div>

    <div class="photos-update-banner" data-library-update-banner hidden role="status" aria-live="polite">
        <span><i class="bi bi-arrow-repeat" aria-hidden="true"></i><strong>New media is available.</strong> Refresh when convenient; your current work will not be interrupted.</span>
        <button type="button" class="btn btn-sm btn-primary" data-library-refresh>Refresh</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ExternalLibraryWarning))
    {
        <div class="photos-library-warning" role="status">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <span>@Model.ExternalLibraryWarning</span>
        </div>
    }

    @if (Model.CatalogueCatchUpPending && Model.AwaitingCatalogueCount > 0)
    {
        <div class="photos-catalogue-status" role="status">
            <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
            <span><strong>@Model.SourceVisibleCount visible</strong> · @Model.CatalogueBackedCount fully processed · @Model.AwaitingCatalogueCount awaiting catalogue intelligence</span>
        </div>
    }

    @if (hasFilters)
    {
        <div class="photos-active-filters">
            @if (!string.IsNullOrWhiteSpace(Model.Q)) { <span class="photos-filter-chip"><i class="bi bi-search"></i>@Model.Q</span> }
            @if (Model.Source != "all") { <span class="photos-filter-chip"><i class="bi bi-folder2"></i>@Model.Source</span> }
            @if (Model.Kind != "all") { <span class="photos-filter-chip"><i class="bi bi-images"></i>@Model.Kind</span> }
            @if (Model.Classification != "all") { <span class="photos-filter-chip"><i class="bi bi-stars"></i>@Model.Classification.Replace("-", " ")</span> }
            @if (Model.ProjectId.HasValue) { <span class="photos-filter-chip"><i class="bi bi-folder"></i>@(Model.SelectedProjectName ?? $"Project {Model.ProjectId}")</span> }
            @if (Model.Year.HasValue) { <span class="photos-filter-chip"><i class="bi bi-calendar3"></i>@Model.Year</span> }
            @if (hasPeopleFilter) { <span class="photos-filter-chip"><i class="bi bi-people"></i>@Model.SelectedPeople.Count person@(Model.SelectedPeople.Count == 1 ? "" : "s")@(Model.PersonIds.Length > 1 ? $" · {Model.PeopleMatch}" : "")</span> }
            @if (Model.IsCollectionDetail) { <span class="photos-filter-chip"><i class="bi bi-collection"></i>@(Model.CurrentCollectionTitle ?? "Collection")</span> }
            <a asp-page="./Index" asp-route-View="@Model.View">Clear filters</a>
        </div>
    }

    @if ((Model.IsAlbumsWorkspace ? Model.Albums.Count : Model.View == "collections" && !Model.IsCollectionDetail ? Model.Collections.Count : Model.Groups.Count) == 0)
    {
        <section class="photos-empty">
            <i class="bi bi-images"></i>
            @if (Model.IsPeopleGallery && Model.SelectedPeople.Count > 1 && Model.MatchAllSelectedPeople)
            {
                <h2>No photographs found together</h2>
                <p>These people do not yet have a confirmed photograph together. Try “Any selected” or choose different people.</p>
                <a class="btn btn-outline-primary" href="@Model.BuildPeopleMatchUrl("any")">Show any selected person</a>
            }
            else if (Model.IsPeopleGallery)
            {
                <h2>No matching photographs</h2>
                <p>Try clearing the search or another filter. Only human-confirmed appearances are included.</p>
            }
            else if (Model.IsAlbumsWorkspace)
            {
                <h2>@(Model.IncludeArchivedAlbums ? "No albums found" : "No active albums yet")</h2>
                <p>@(!string.IsNullOrWhiteSpace(Model.Q) ? "Try a different album search." : "Create an organisation-wide album to curate media for briefings, visits and institutional use.")</p>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createAlbumModal"><i class="bi bi-plus-lg"></i> Create album</button>
            }
            else if (Model.IsAlbumDetail)
            {
                <h2>This album has no available media</h2>
                <p>@(Model.CanManageCurrentAlbum ? "Select media from Photos and add it to this album." : "The album is currently empty or its media is unavailable.")</p>
                @if (Model.CanManageCurrentAlbum) { <a class="btn btn-outline-primary" asp-page="./Index" asp-route-View="photos">Browse Photos</a> }
            }
            else if (Model.View == "collections")
            {
                <h2>No collections found</h2>
                <p>@(hasFilters ? "Try clearing one or more filters." : "Collections will appear as organisational media is added.")</p>
            }
            else
            {
                <h2>No media found</h2><p>@(hasFilters ? "Try clearing one or more filters." : "New PRISM photos will appear here automatically.")</p>
            }
        </section>
    }
    else if (Model.IsAlbumsWorkspace)
    {
        <section class="collections-grid albums-grid" aria-label="Organisation-wide media albums">
            @foreach (var album in Model.Albums)
            {
                <article class="collection-card album-card @(album.IsArchived ? "album-card--archived" : null)">
                    <div class="collection-card__cover" aria-hidden="true">
                        @if (!string.IsNullOrWhiteSpace(album.CoverThumbnailUrl))
                        {
                            <img src="@album.CoverThumbnailUrl" alt="" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <span class="collection-card__placeholder" aria-hidden="true"><i class="bi bi-images"></i></span>
                        }
                        <span class="collection-card__stack">@album.ItemCount</span>
                    </div>
                    <div class="collection-card__body">
                        <div class="album-card__type-row"><span class="collection-card__type">Album</span>@if(album.IsArchived){<span class="badge text-bg-secondary">Archived</span>}</div>
                        <a class="album-card__title collection-card__primary-link" href="@Model.BuildAlbumUrl(album.Id)" title="@album.Name" aria-label="Open @album.Name album">@album.Name</a>
                        @if (!string.IsNullOrWhiteSpace(album.Description)) { <span class="album-card__description">@album.Description</span> }
                        <span>@album.ItemCount item@(album.ItemCount == 1 ? "" : "s") · Updated @album.UpdatedAt.ToString("dd MMM yyyy")</span>
                        @if (album.CanManage) { <span class="album-card__ownership">@(album.IsOwner ? "Created by you" : "Organisation-managed")</span> }
                    </div>
                </article>
            }
        </section>
        <nav class="photos-pagination" aria-label="Album pages">
            @if(Model.HasPreviousPage){<a class="photos-page-btn" href="@Model.BuildPageUrl(Model.CurrentPage - 1)"><i class="bi bi-arrow-left"></i> Previous</a>}
            <span>Page @Model.CurrentPage</span>
            @if(Model.HasNextPage){<a class="photos-page-btn" href="@Model.BuildPageUrl(Model.CurrentPage + 1)">Next <i class="bi bi-arrow-right"></i></a>}
        </nav>
    }
    else if (Model.View == "collections" && !Model.IsCollectionDetail)
    {
        <section class="collections-grid" aria-label="Media collections">
            @foreach (var collection in Model.Collections)
            {
                <article class="collection-card">
                    <div class="collection-card__cover" aria-hidden="true">
                        @if (!string.IsNullOrWhiteSpace(collection.CoverThumbnailUrl))
                        {
                            <img src="@collection.CoverThumbnailUrl" alt="" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <span class="collection-card__placeholder" aria-hidden="true"><i class="bi bi-collection"></i></span>
                        }
                        @if(collection.ItemCount > 1){<span class="collection-card__stack">@collection.ItemCount</span>}
                    </div>
                    <div class="collection-card__body">
                        <span class="collection-card__type">@collection.TypeLabel</span>
                        <a class="album-card__title collection-card__primary-link" href="@Model.BuildCollectionUrl(collection.CollectionKey)" title="@collection.Title" aria-label="Open @collection.Title collection">@collection.Title</a>
                        <span>@collection.Subtitle · @collection.ItemCount item@(collection.ItemCount == 1 ? "" : "s") · @collection.LatestDate.ToString("dd MMM yyyy")</span>
                        @if (!string.IsNullOrWhiteSpace(collection.SourceUrl))
                        {
                            <a class="collection-card__source" href="@collection.SourceUrl">Open source <i class="bi bi-arrow-up-right"></i></a>
                        }
                    </div>
                </article>
            }
        </section>
        <nav class="photos-pagination" aria-label="Collection pages">
            @if(Model.HasPreviousPage){<a class="photos-page-btn" href="@Model.BuildPageUrl(Model.CurrentPage - 1)"><i class="bi bi-arrow-left"></i> Previous</a>}
            <span>Page @Model.CurrentPage</span>
            @if(Model.HasNextPage){<a class="photos-page-btn" href="@Model.BuildPageUrl(Model.CurrentPage + 1)">Next <i class="bi bi-arrow-right"></i></a>}
        </nav>
    }
    else
    {
        <div class="photos-timeline">
            @foreach (var day in (Model.Sort == "oldest"
                ? Model.Groups.GroupBy(group => group.Date.Date).OrderBy(group => group.Key)
                : Model.Groups.GroupBy(group => group.Date.Date).OrderByDescending(group => group.Key)))
            {
                var dayItems = Model.IsAlbumDetail
                    ? day.SelectMany(group => group.Items).ToList()
                    : (Model.Sort == "oldest"
                        ? day.SelectMany(group => group.Items).OrderBy(item => item.MediaDate)
                        : day.SelectMany(group => group.Items).OrderByDescending(item => item.MediaDate)).ToList();
                <section class="photos-day @(Model.IsAlbumDetail ? "photos-day--album" : null)" aria-labelledby="day-@day.Key.ToString("yyyyMMdd")">
                    @if (!Model.IsAlbumDetail)
                    {
                        <header class="photos-day__header"><h2 id="day-@day.Key.ToString("yyyyMMdd")">@day.Key.ToString("dd MMMM yyyy")</h2><span>@day.Key.ToString("dddd") · @dayItems.Count item@(dayItems.Count == 1 ? "" : "s")</span></header>
                    }
                    <div class="photos-grid @(Model.OrganizeAlbum ? "photos-grid--organize" : null)" role="group" aria-label="@(Model.IsAlbumDetail ? $"Media in {Model.CurrentAlbum?.Name}" : $"Media for {day.Key:dd MMMM yyyy}")" data-album-sortable="@(Model.OrganizeAlbum ? "true" : null)">
                        @foreach (var item in dayItems)
                        {
                            <button type="button"
                                                class="photos-tile @(item.IsAlbumCover ? "photos-tile--album-cover" : null)"
                                                style="--media-ratio:@item.AspectRatio.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-aspect-ratio="@item.AspectRatio.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-media-item
                                                data-media-key="@(item.AssetId.HasValue ? $"asset-{item.AssetId.Value}" : item.Id)"
                                                data-kind="@item.Kind.ToString().ToLowerInvariant()"
                                                data-title="@item.Title"
                                                data-original-title="@item.OriginalTitle"
                                                data-caption="@item.Caption"
                                                data-editorial-caption="@item.EditorialCaption"
                                                data-editorial-token="@item.EditorialConcurrencyToken"
                                                data-context="@(IndexModel.DisplayContext(item) ?? item.ContextTitle)"
                                                data-subtitle="@(item.DisplaySubtitle ?? item.ContextSubtitle)"
                                                data-date="@item.MediaDate.ToString("dd MMMM yyyy")"
                                                data-source-label="@item.SourceLabel"
                                                data-classification="@IndexModel.ClassificationLabel(item.Classification)"
                                                data-people="@Model.SerializeViewerPeople(item)"
                                                data-albums="@Model.SerializeViewerAlbums(item)"
                                                data-unidentified="@item.UnidentifiedFaceCount"
                                                data-asset-id="@item.AssetId"
                                                data-display-url="@item.DisplayUrl"
                                                data-original-url="@item.OriginalUrl"
                                                data-download-url="@item.DownloadUrl"
                                                data-source-url="@item.SourceUrl"
                                                data-filename="@item.OriginalFileName"
                                                data-file-size="@IndexModel.FormatFileSize(item.FileSizeBytes)"
                                                data-duration="@IndexModel.FormatDuration(item.DurationSeconds)"
                                                data-width="@item.Width"
                                                data-height="@item.Height"
                                                data-album-cover="@(item.IsAlbumCover ? "true" : "false")"
                                                draggable="@(Model.OrganizeAlbum ? "true" : null)"
                                                aria-label="@(Model.OrganizeAlbum ? $"Reorder {item.Title}" : $"Open {item.Title}")">
                                            <span class="photos-tile__placeholder" aria-hidden="true"></span>
                                            <img src="@item.ThumbnailUrl" alt="" loading="lazy" decoding="async" data-media-image />
                                            <span class="photos-tile__unavailable" aria-hidden="true"><i class="bi bi-image"></i><strong>Media unavailable</strong><small>Source file could not be opened</small></span>
                                            <span class="photos-tile__shade"></span>
                                            <span class="photos-tile__select" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                                            @if (item.Kind == IndexModel.MediaKind.Video)
                                            {
                                                <span class="photos-tile__play"><i class="bi bi-play-fill" aria-hidden="true"></i></span>
                                                <span class="photos-tile__duration">@IndexModel.FormatDuration(item.DurationSeconds)</span>
                                            }
                                            @if (item.IsCover)
                                            {
                                                <span class="photos-tile__cover" title="Cover media"><i class="bi bi-bookmark-star-fill"></i></span>
                                            }
                                            @if (item.IsAlbumCover)
                                            {
                                                <span class="photos-tile__album-cover" title="Album cover"><i class="bi bi-image-fill"></i></span>
                                            }
                                            @if (Model.OrganizeAlbum)
                                            {
                                                <span class="photos-tile__drag" title="Drag to reorder"><i class="bi bi-grip-vertical"></i></span>
                                            }
                                            @if (item.People.Count > 0 || item.UnidentifiedFaceCount > 0)
                                            {
                                                <span class="photos-tile__people" title="@IndexModel.PeopleBadgeTitle(item)"><i class="bi bi-person-fill"></i> @IndexModel.PeopleBadgeLabel(item)</span>
                                            }
                                            <span class="photos-tile__meta"><strong>@item.Title</strong>@if (!string.IsNullOrWhiteSpace(IndexModel.DisplayContext(item))) { <span>@IndexModel.DisplayContext(item)</span> }</span>
                                        </button>
                        }
                    </div>
                </section>
            }
        </div>
        @if (!Model.IsAlbumDetail)
        {
            <nav class="photos-pagination" aria-label="Media pages">
                @if(Model.HasPreviousPage){<a class="photos-page-btn" href="@Model.BuildPageUrl(Model.CurrentPage - 1)"><i class="bi bi-arrow-left"></i> Previous</a>}
                <span>Page @Model.CurrentPage</span>
                @if(Model.HasNextPage){<a class="photos-page-btn" href="@Model.BuildPageUrl(Model.CurrentPage + 1)">Next <i class="bi bi-arrow-right"></i></a>}
            </nav>
        }
    }

    @if ((Model.View == "photos" || Model.IsAlbumDetail) && Model.Groups.Count > 0 && !Model.OrganizeAlbum)
    {
        <div class="photos-selection-bar" data-photos-selection-bar hidden aria-live="polite">
            <div class="photos-selection-bar__count"><strong data-selection-count>0 selected</strong><span data-selection-note></span></div>
            <div class="photos-selection-bar__actions">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-selection-select-all>Select page</button>
                <form method="post" asp-page="/Photos/Download" data-selection-download-form>
                    <button type="submit" class="btn btn-sm btn-primary" data-selection-download disabled><i class="bi bi-file-zip"></i> Download ZIP</button>
                </form>
                <button type="button" class="btn btn-sm btn-outline-primary" data-selection-add-album disabled data-bs-toggle="modal" data-bs-target="#addToAlbumModal"><i class="bi bi-folder-plus"></i> Add to album</button>
                @if (Model.IsAlbumDetail && Model.CanManageCurrentAlbum && Model.CurrentAlbum is not null)
                {
                    <form method="post" asp-page="/Photos/Albums/Actions" asp-page-handler="RemoveItems" data-selection-remove-album-form>
                        <input type="hidden" name="albumId" value="@Model.CurrentAlbum.Id" />
                        <input type="hidden" name="returnUrl" value="@Model.CurrentReturnUrl" />
                        <button type="submit" class="btn btn-sm btn-outline-danger" data-selection-remove-album disabled><i class="bi bi-folder-minus"></i> Remove</button>
                    </form>
                    <form method="post" asp-page="/Photos/Albums/Actions" asp-page-handler="SetCover" data-selection-cover-form>
                        <input type="hidden" name="albumId" value="@Model.CurrentAlbum.Id" />
                        <input type="hidden" name="returnUrl" value="@Model.CurrentReturnUrl" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary" data-selection-set-cover disabled title="Select exactly one photo"><i class="bi bi-image"></i> Set cover</button>
                    </form>
                }
                @if (Model.CanManagePeople && Model.PeopleFeatureEnabled)
                {
                    <a class="btn btn-sm btn-outline-primary disabled" href="@Url.Page("/Photos/People/Review", new { Mode = "unidentified" })" data-selection-review-people data-base-url="@Url.Page("/Photos/People/Review", new { Mode = "unidentified" })" aria-disabled="true"><i class="bi bi-people"></i> Review people</a>
                }
                <button type="button" class="btn btn-sm btn-link" data-selection-clear>Clear</button>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="createAlbumModal" tabindex="-1" aria-labelledby="createAlbumModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page="/Photos/Albums/Actions" asp-page-handler="Create" class="modal-content">
            <div class="modal-header"><div><span class="photos-library__eyebrow">Organisation-wide curation</span><h2 class="modal-title fs-5" id="createAlbumModalTitle">Create album</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body photos-album-form">
                <input type="hidden" name="returnUrl" value="@Model.CurrentReturnUrl" />
                <div><label class="form-label" for="createAlbumName">Album name</label><input class="form-control" id="createAlbumName" name="name" maxlength="160" required autocomplete="off" /></div>
                <div><label class="form-label" for="createAlbumDescription">Description <span>optional</span></label><textarea class="form-control" id="createAlbumDescription" name="description" maxlength="1024" rows="3"></textarea></div>
                <p class="photos-form-note"><i class="bi bi-building"></i> Albums are organisation-wide. All authorised Photos users can view them.</p>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Create album</button></div>
        </form>
    </div>
</div>

<div class="modal fade" id="addToAlbumModal" tabindex="-1" aria-labelledby="addToAlbumModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page="/Photos/Albums/Actions" asp-page-handler="AddItems" class="modal-content" data-selection-album-form>
            <div class="modal-header"><div><span class="photos-library__eyebrow">Organisation-wide curation</span><h2 class="modal-title fs-5" id="addToAlbumModalTitle">Add selected media to album</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body photos-album-form">
                <input type="hidden" name="returnUrl" value="@Model.CurrentReturnUrl" />
                @if (Model.ManageableAlbums.Count > 0)
                {
                    <fieldset class="photos-album-choice">
                        <legend class="visually-hidden">Choose existing or new album</legend>
                        <label><input type="radio" name="albumChoice" value="existing" checked data-album-choice /> Existing album</label>
                        <label><input type="radio" name="albumChoice" value="new" data-album-choice /> New album</label>
                    </fieldset>
                    <div data-album-existing-fields>
                        <label class="form-label" for="albumSelect">Album</label>
                        <select class="form-select" id="albumSelect" name="albumId">
                            @foreach (var album in Model.ManageableAlbums) { <option value="@album.Id">@album.Name (@album.ItemCount)</option> }
                        </select>
                    </div>
                }
                else
                {
                    <input type="hidden" name="albumChoice" value="new" />
                }
                <div data-album-new-fields hidden="@(Model.ManageableAlbums.Count > 0)">
                    <label class="form-label" for="newAlbumName">New album name</label>
                    <input class="form-control" id="newAlbumName" name="newAlbumName" maxlength="160" autocomplete="off" required="@(Model.ManageableAlbums.Count == 0)" />
                    <label class="form-label mt-3" for="newAlbumDescription">Description <span>optional</span></label>
                    <textarea class="form-control" id="newAlbumDescription" name="newAlbumDescription" maxlength="1024" rows="2"></textarea>
                </div>
                <p class="photos-form-note"><i class="bi bi-info-circle"></i> A media item may belong to several albums. Adding it here does not move or alter its source collection.</p>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Add selected</button></div>
        </form>
    </div>
</div>

@if (Model.IsAlbumDetail && Model.CurrentAlbum is not null && Model.CanManageCurrentAlbum)
{
    <div class="modal fade" id="editAlbumModal" tabindex="-1" aria-labelledby="editAlbumModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-page="/Photos/Albums/Actions" asp-page-handler="Update">
                    <div class="modal-header"><div><span class="photos-library__eyebrow">Album governance</span><h2 class="modal-title fs-5" id="editAlbumModalTitle">Edit album</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                    <div class="modal-body photos-album-form">
                        <input type="hidden" name="albumId" value="@Model.CurrentAlbum.Id" /><input type="hidden" name="concurrencyToken" value="@Model.CurrentAlbum.ConcurrencyToken" /><input type="hidden" name="returnUrl" value="@Model.CurrentReturnUrl" />
                        <div><label class="form-label" for="editAlbumName">Album name</label><input class="form-control" id="editAlbumName" name="name" value="@Model.CurrentAlbum.Name" maxlength="160" required /></div>
                        <div><label class="form-label" for="editAlbumDescription">Description <span>optional</span></label><textarea class="form-control" id="editAlbumDescription" name="description" maxlength="1024" rows="3">@Model.CurrentAlbum.Description</textarea></div>
                    </div>
                    <div class="modal-footer justify-content-between">
                        <div></div>
                        <div class="d-flex gap-2"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save changes</button></div>
                    </div>
                </form>
                <div class="photos-album-danger-zone">
                    @if (Model.CurrentAlbum.IsArchived)
                    {
                        <form method="post" asp-page="/Photos/Albums/Actions" asp-page-handler="Restore"><input type="hidden" name="albumId" value="@Model.CurrentAlbum.Id" /><input type="hidden" name="concurrencyToken" value="@Model.CurrentAlbum.ConcurrencyToken" /><input type="hidden" name="returnUrl" value="@Model.CurrentReturnUrl" /><button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-arrow-counterclockwise"></i> Restore album</button></form>
                    }
                    else
                    {
                        <form method="post" asp-page="/Photos/Albums/Actions" asp-page-handler="Archive" onsubmit="return confirm('Archive this organisation-wide album? Its media will remain in Photos and source collections.');"><input type="hidden" name="albumId" value="@Model.CurrentAlbum.Id" /><input type="hidden" name="concurrencyToken" value="@Model.CurrentAlbum.ConcurrencyToken" /><input type="hidden" name="returnUrl" value="@Model.CurrentReturnUrl" /><button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-archive"></i> Archive album</button></form>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (Model.CanCurateMedia)
{
    <div class="modal fade" id="editCaptionModal" tabindex="-1" aria-labelledby="editCaptionModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form method="post" asp-page="/Photos/Albums/Actions" asp-page-handler="UpdateCaption" class="modal-content" data-caption-form>
                <div class="modal-header"><div><span class="photos-library__eyebrow">Media information</span><h2 class="modal-title fs-5" id="editCaptionModalTitle">Edit editorial caption</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body photos-album-form">
                    <input type="hidden" name="assetId" data-caption-asset-id /><input type="hidden" name="concurrencyToken" data-caption-token /><input type="hidden" name="returnUrl" value="@Model.CurrentReturnUrl" />
                    <label class="form-label" for="editorialCaption">Caption</label><textarea class="form-control" id="editorialCaption" name="caption" maxlength="1024" rows="4" data-caption-value></textarea>
                    <p class="photos-form-note"><i class="bi bi-shield-check"></i> This is an editorial Photos caption. It does not overwrite the title or caption in the owning Project, Visit, Activity or Event.</p>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save caption</button></div>
            </form>
        </div>
    </div>
}

@if (Model.IsAlbumDetail && Model.CurrentAlbum is not null && Model.CanManageCurrentAlbum && Model.OrganizeAlbum)
{
    <form method="post" asp-page="/Photos/Albums/Actions" asp-page-handler="Reorder" data-album-reorder-form data-album-id="@Model.CurrentAlbum.Id" hidden>
        @Html.AntiForgeryToken()
    </form>
    <div class="photos-organize-status" data-album-organize-status role="status" aria-live="polite">Drag media to change album order. Changes save automatically.</div>
}

<div class="offcanvas offcanvas-end photos-filters" tabindex="-1" id="photosFilters" aria-labelledby="photosFiltersTitle">
    <div class="offcanvas-header">
        <div>
            <span class="photos-library__eyebrow">Refine library</span>
            <h2 class="offcanvas-title" id="photosFiltersTitle">Filters</h2>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form method="get" class="photos-filter-form" data-photos-filter-form>
            <input type="hidden" name="View" value="@Model.View" />
            <input type="hidden" name="Q" value="@Model.Q" />
            @foreach (var personId in Model.PersonIds) { <input type="hidden" name="PersonIds" value="@personId" /> }
            @if (Model.PersonIds.Length > 1) { <input type="hidden" name="PeopleMatch" value="@Model.PeopleMatch" /> }
            @if (Model.Sort != "newest") { <input type="hidden" name="Sort" value="@Model.Sort" /> }
            @if (Model.IsCollectionDetail) { <input type="hidden" name="Collection" value="@Model.Collection" /> }
            <div>
                <label for="sourceFilter">Source</label>
                <select id="sourceFilter" name="Source" class="form-select">
                    <option value="all" selected="@(Model.Source == "all")">All sources</option>
                    <option value="projects" selected="@(Model.Source == "projects")">Projects</option>
                    <option value="visits" selected="@(Model.Source == "visits")">Visits to SDD</option>
                    <option value="events" selected="@(Model.Source == "events")">Events</option>
                    <option value="activities" selected="@(Model.Source == "activities")">Institutional activities</option>
                    @if (Model.ExternalSourcesEnabled)
                    {
                        <option value="external" selected="@(Model.Source == "external")">External folders</option>
                    }
                </select>
            </div>
            <div>
                <label for="kindFilter">Media type</label>
                <select id="kindFilter" name="Kind" class="form-select">
                    <option value="all" selected="@(Model.Kind == "all")">Photos and videos</option>
                    <option value="photo" selected="@(Model.Kind == "photo")">Photos only</option>
                    <option value="video" selected="@(Model.Kind == "video")">Videos only</option>
                </select>
            </div>
            <div>
                <label for="classificationFilter">Automatic classification</label>
                <select id="classificationFilter" name="Classification" class="form-select">
                    <option value="all" selected="@(Model.Classification == "all")">All classifications</option>
                    <option value="photograph" selected="@(Model.Classification == "photograph")">Photographs</option>
                    <option value="screenshot" selected="@(Model.Classification == "screenshot")">Screenshots</option>
                    <option value="scanned-document" selected="@(Model.Classification == "scanned-document")">Scanned documents</option>
                    <option value="diagram" selected="@(Model.Classification == "diagram")">Diagrams</option>
                    <option value="presentation-slide" selected="@(Model.Classification == "presentation-slide")">Presentation slides</option>
                    <option value="graphic" selected="@(Model.Classification == "graphic")">Graphics</option>
                    <option value="unknown" selected="@(Model.Classification == "unknown")">Not yet classified</option>
                </select>
                <small>Classification is deterministic, auditable and can be overridden by authorised administrators.</small>
            </div>
            <div>
                <label for="projectFilter">Project</label>
                <select id="projectFilter" name="ProjectId" class="form-select">
                    <option value="">All projects</option>
                    @foreach (var project in Model.Projects)
                    {
                        <option value="@project.Id" selected="@(Model.ProjectId == project.Id)">@project.Name</option>
                    }
                </select>
                <small>Selecting a project limits the library to project media.</small>
            </div>
            @if (Model.PeopleFeatureEnabled && Model.People.Count > 0)
            {
                <div>
                    <label for="personFilter">People</label>
                    @if (Model.PersonIds.Length == 0)
                    {
                        <select id="personFilter" name="PersonId" class="form-select">
                            <option value="">All people</option>
                            @foreach (var person in Model.People)
                            {
                                <option value="@person.Id">@person.Name (@person.PhotoCount)</option>
                            }
                        </select>
                        <small>Select one person here, or use the People page to select a group.</small>
                    }
                    else
                    {
                        <div class="photos-filter-people-summary">
                            @foreach (var person in Model.SelectedPeople)
                            {
                                <span>@person.Name</span>
                            }
                        </div>
                        <a class="btn btn-sm btn-outline-primary mt-2" href="@Model.BuildPeoplePickerUrl()">Change selected people</a>
                    }
                </div>
            }
            <div>
                <label for="yearFilter">Year</label>
                <select id="yearFilter" name="Year" class="form-select">
                    <option value="">All years</option>
                    @foreach (var year in Model.Years)
                    {
                        <option value="@year" selected="@(Model.Year == year)">@year</option>
                    }
                </select>
            </div>
            @if (Model.View == "collections")
            {
                <div class="form-check form-switch photos-collection-singletons">
                    <input class="form-check-input" type="checkbox" role="switch" id="singletonCollections" name="IncludeSingletonCollections" value="true" checked="@Model.IncludeSingletonCollections" />
                    <label class="form-check-label" for="singletonCollections">Include single-item project collections</label>
                    <small>Visits, events and activities remain visible even when they contain one item.</small>
                </div>
            }
            <div class="photos-filter-form__actions">
                <a asp-page="./Index" class="btn btn-outline-secondary">Reset</a>
                <button type="submit" class="btn btn-primary" data-photos-filter-submit disabled>Apply filters</button>
            </div>
        </form>
    </div>
</div>

<div class="photos-viewer" data-photos-viewer hidden aria-hidden="true">
    <div class="photos-viewer__backdrop" data-viewer-close></div>
    <div class="photos-viewer__dialog" role="dialog" aria-modal="true" aria-labelledby="photosViewerTitle">
        <header class="photos-viewer__header">
            <div class="photos-viewer__heading">
                <span data-viewer-context></span>
                <div class="photos-viewer__title-line">
                    <strong id="photosViewerTitle" data-viewer-title></strong>
                    <span class="photos-viewer__position" data-viewer-position></span>
                </div>
            </div>
            <div class="photos-viewer__actions">
                <button type="button" data-viewer-zoom-out title="Zoom out" aria-label="Zoom out"><i class="bi bi-dash-lg"></i></button>
                <button type="button" data-viewer-zoom-reset title="Reset zoom" aria-label="Reset zoom"><span data-viewer-zoom-label>100%</span></button>
                <button type="button" data-viewer-zoom-in title="Zoom in" aria-label="Zoom in"><i class="bi bi-plus-lg"></i></button>
                <a href="#" data-viewer-original target="_blank" rel="noopener" title="Open original" aria-label="Open original"><i class="bi bi-arrows-fullscreen"></i></a>
                <a href="#" data-viewer-download title="Download" aria-label="Download"><i class="bi bi-download"></i></a>
                <button type="button" data-viewer-info aria-pressed="false" title="Show information" aria-label="Show information"><i class="bi bi-info-circle"></i></button>
                <button type="button" data-viewer-close title="Close" aria-label="Close"><i class="bi bi-x-lg"></i></button>
            </div>
        </header>
        <main class="photos-viewer__stage">
            <button type="button" class="photos-viewer__nav photos-viewer__nav--prev" data-viewer-prev aria-label="Previous item"><i class="bi bi-chevron-left"></i></button>
            <div class="photos-viewer__media" data-viewer-media></div>
            <button type="button" class="photos-viewer__nav photos-viewer__nav--next" data-viewer-next aria-label="Next item"><i class="bi bi-chevron-right"></i></button>
        </main>
        <aside class="photos-viewer__info" data-viewer-info-panel aria-hidden="true">
            <h2>Information</h2>
            <dl>
                <div><dt>Collection</dt><dd data-info-context></dd></div>
                <div><dt>Date</dt><dd data-info-date></dd></div>
                <div><dt>Source</dt><dd data-info-source></dd></div>
                <div><dt>Classification</dt><dd data-info-classification></dd></div>
                <div data-info-albums-row><dt>Albums</dt><dd data-info-albums class="photos-viewer__albums"></dd></div>
                <div data-info-people-row><dt>People</dt><dd data-info-people class="photos-viewer__people"></dd></div>
                <div data-info-unidentified-row><dt>Unidentified</dt><dd data-info-unidentified></dd></div>
                <div data-info-filename-row><dt>File</dt><dd data-info-filename></dd></div>
                <div data-info-file-size-row><dt>File size</dt><dd data-info-file-size></dd></div>
                <div data-info-dimensions-row><dt>Dimensions</dt><dd data-info-dimensions></dd></div>
                <div data-info-duration-row><dt>Duration</dt><dd data-info-duration></dd></div>
            </dl>
            <div class="photos-viewer__caption-block" data-info-caption-row><span>Caption</span><p data-info-caption></p></div>
            <div class="photos-viewer__info-actions">
                <a href="#" data-info-source-link class="btn btn-outline-light">Open source record <i class="bi bi-arrow-up-right"></i></a>
                @if (Model.CanCurateMedia)
                {
                    <button type="button" class="btn btn-outline-light" data-info-edit-caption><i class="bi bi-pencil"></i> Edit caption</button>
                }
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/photos-library.js" asp-append-version="true"></script>
}
