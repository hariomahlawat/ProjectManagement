@using ProjectManagement.Models
@using ProjectManagement.Services.Projects
@model ProjectManagement.Pages.Projects.OverviewModel
@{
    var project = Model.Project;
    var portfolio = Model.Portfolio;
    var access = Model.Access;
    var lifecycleStatus = Model.LifecycleSummary.Status;
    var isCompleted = lifecycleStatus == ProjectLifecycleStatus.Completed;
    var isCancelled = lifecycleStatus == ProjectLifecycleStatus.Cancelled;
    var isActive = lifecycleStatus == ProjectLifecycleStatus.Active;
    var completionDisplay = Model.LifecycleSummary.CompletionDisplay ?? "Date not recorded";
    var cancellationDisplay = Model.LifecycleSummary.CancellationDisplay ?? "Date not recorded";
    var lifecycleHeaderClass = isCompleted
        ? "project-command-header--completed"
        : isCancelled ? "project-command-header--cancelled" : string.Empty;
    var workflowLabel = project?.IsLegacy == true ? "Mapped workflow" : "Workflow";
    var recordDateLabel = project?.IsLegacy == true ? "Record added" : "Created";
    static string DisplayUser(ApplicationUser? user)
    {
        if (user is null) return "—";
        return !string.IsNullOrWhiteSpace(user.FullName) ? user.FullName : user.UserName ?? "—";
    }

    // The cover photo gives the header the project's identity at a glance.
    var headerCover = Model.MediaSummary.CoverPhoto ?? Model.CoverPhoto;
    var headerCoverUrl = headerCover is null
        ? null
        : Url.Page("/Projects/Photos/View", new { id = project!.Id, photoId = headerCover.Id, size = "xs", v = Model.MediaSummary.CoverPhotoVersion ?? Model.CoverPhotoVersion ?? headerCover.Version });
}
<section class="card pm-card project-command-header @lifecycleHeaderClass"
         aria-labelledby="project-title"
         data-project-command-header="true">
    <div class="project-command-header__main">
        @if (headerCoverUrl is not null)
        {
            @* Same fallback contract as the overview cover (cover-photo-fallback.js): if the
               thumbnail cannot load, the image is removed and the icon tile shows instead. *@
            <a class="project-command-header__cover" href="#project-profile-details" aria-label="Project overview and cover photo" data-project-cover-host>
                <img src="@headerCoverUrl" alt="" decoding="async" data-project-cover-image />
                <span class="project-command-header__cover-fallback d-none" data-project-cover-fallback aria-hidden="true">
                    <i class="bi bi-image"></i>
                </span>
            </a>
        }
        <div class="project-command-header__identity">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h1 id="project-title" class="project-command-header__title">@portfolio.PageTitle</h1>
                @if (!string.IsNullOrWhiteSpace(project?.CaseFileNumber))
                {
                    <span class="project-command-header__case">@project.CaseFileNumber</span>
                }
                @if (project?.IsBuild == true)
                {
                    <span class="project-command-header__case project-command-header__case--repeat">Repeat build</span>
                }
                @if (!isActive && !isCompleted && !isCancelled)
                {
                    <span class="badge rounded-pill text-bg-secondary">@Model.LifecycleSummary.StatusLabel</span>
                }
            </div>
            <div class="project-command-header__meta">
                @if (!string.IsNullOrWhiteSpace(project?.Category?.Name))
                {
                    <span><i class="bi bi-folder2" aria-hidden="true"></i> @project.Category.Name</span>
                }
                <span><i class="bi bi-diagram-3" aria-hidden="true"></i> @workflowLabel @project?.WorkflowVersion</span>
                <span><i class="bi bi-calendar3" aria-hidden="true"></i> @recordDateLabel @(project is { } value ? value.CreatedAt.ToString("dd MMM yyyy") : "—")</span>
                <span data-chat-user="@project?.LeadPoUserId" data-chat-name="@DisplayUser(project?.LeadPoUser)"><i class="bi bi-person-badge" aria-hidden="true"></i> PO @DisplayUser(project?.LeadPoUser)</span>
                <span data-chat-user="@project?.HodUserId" data-chat-name="@DisplayUser(project?.HodUser)"><i class="bi bi-person-check" aria-hidden="true"></i> HoD @DisplayUser(project?.HodUser)</span>
                @if (Model.LifecycleSummary.IsLegacy)
                {
                    <span class="project-command-header__legacy">
                        <i class="bi bi-archive" aria-hidden="true"></i>
                        Legacy record
                    </span>
                }
            </div>
        </div>
        <div class="project-command-header__commands">
            <div class="project-command-header__actions">
                @if (Model.RemarksPanel.ShowComposer)
                {
                    <button type="button" class="btn btn-primary" data-project-quick-action="remark">
                        <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                        Add remark
                    </button>
                }
                <partial name="_AssignRolesOffcanvas" model="Model.AssignRoles" />
                @if (Model.LifecycleActions.CanManageLifecycle)
                {
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary" type="button" id="project-actions-menu" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-three-dots" aria-hidden="true"></i>
                            <span class="visually-hidden">Project actions</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="project-actions-menu">
                            <li><button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#projectLifecycleActionsModal">Manage lifecycle</button></li>
                            @if (access.CanAssignRoles)
                            {
                                <li><hr class="dropdown-divider" /></li>
                                @if (project?.IsArchived == true)
                                {
                                    <li><button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#projectRestoreArchiveModal">Restore from archive</button></li>
                                }
                                else
                                {
                                    <li><button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#projectArchiveModal">Archive project</button></li>
                                }
                                <li><button class="dropdown-item text-danger" type="button" data-bs-toggle="modal" data-bs-target="#projectTrashModal">Move to Trash</button></li>
                            }
                        </ul>
                    </div>
                }
            </div>
            @if (isCompleted)
            {
                <div class="project-lifecycle-lockup project-lifecycle-lockup--completed"
                     aria-label="Project completed. Completion date: @completionDisplay.">
                    <span class="project-lifecycle-lockup__icon" aria-hidden="true">
                        <i class="bi bi-check2"></i>
                    </span>
                    <span class="project-lifecycle-lockup__copy">
                        <span class="project-lifecycle-lockup__label">Project completed</span>
                        <strong class="project-lifecycle-lockup__date">@completionDisplay</strong>
                    </span>
                </div>
            }
            else if (isCancelled)
            {
                <div class="project-lifecycle-lockup project-lifecycle-lockup--cancelled"
                     aria-label="Project cancelled. Cancellation date: @cancellationDisplay.">
                    <span class="project-lifecycle-lockup__icon" aria-hidden="true">
                        <i class="bi bi-x-lg"></i>
                    </span>
                    <span class="project-lifecycle-lockup__copy">
                        <span class="project-lifecycle-lockup__label">Project cancelled</span>
                        <strong class="project-lifecycle-lockup__date">@cancellationDisplay</strong>
                    </span>
                </div>
            }
        </div>
    </div>
    @* The strip follows the project's phase (ProjectHeaderStripBuilder); tiles it leaves out
       render in the Project overview card instead. *@
    <div class="project-intelligence-strip" aria-label="Project status summary">
        @foreach (var tile in Model.HeaderStrip.Tiles)
        {
            @await Html.PartialAsync("_ProjectHeaderTile", Model, new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["HeaderTile"] = tile })
        }
    </div>
    @if (Model.HeaderStrip.ShowsLastUpdate)
    {
        var update = Model.HeaderStrip.LastUpdate;
        @* A remark is prose, so it reads at full width: three lines, then "Show more"
           (project-portfolio.js) reveals the rest in place. *@
        <section class="project-latest-update@(update.HasRemark ? null : " project-latest-update--empty")"
                 aria-labelledby="project-latest-update-label"
                 data-latest-update>
            <div class="project-latest-update__head">
                <h2 id="project-latest-update-label" class="project-latest-update__label">
                    <i class="bi bi-chat-left-text" aria-hidden="true"></i>Latest update
                </h2>
                <span class="project-latest-update__meta@(update.IsStale ? " project-latest-update__meta--stale" : null)">@update.Meta</span>
                @if (update.HasRemark)
                {
                    <a class="project-latest-update__all" href="#remarks" data-project-open-remarks>All remarks</a>
                }
            </div>
            <p id="project-latest-update-text" class="project-latest-update__text" data-latest-update-text>@update.Text</p>
            @if (update.HasRemark)
            {
                <button type="button"
                        class="project-latest-update__more"
                        aria-expanded="false"
                        aria-controls="project-latest-update-text"
                        data-latest-update-toggle
                        hidden>Show more</button>
            }
        </section>
    }
</section>
