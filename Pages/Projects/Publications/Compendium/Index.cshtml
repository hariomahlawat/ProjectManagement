@page "/Projects/Publications/Compendium"
@model ProjectManagement.Pages.Projects.Publications.Compendium.IndexModel
@using System.Text.Json
@using ProjectManagement.Services.Compendiums
@using ProjectManagement.Services.Publications
@{
    ViewData["Title"] = "Simulators Compendium";
    var jsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/projects-publications.css" asp-append-version="true" />
}

<div class="publications-page compendium-builder-page">
    <nav class="publications-breadcrumb" aria-label="Breadcrumb">
        <a asp-page="/Projects/Index">Projects</a>
        <span>/</span>
        <a asp-page="/Projects/Publications/Index">Publications</a>
        <span>/</span>
        <span>Compendium</span>
    </nav>

    <header class="publications-header compendium-builder-header">
        <div>
            <p class="publications-eyebrow">DETAILED PROJECT PUBLICATION</p>
            <h1>Simulators Compendium</h1>
            <p>Create a structured project reference by selecting and arranging projects from across the PRISM portfolio.</p>
        </div>

        <section class="compendium-preset-control" aria-label="Saved Compendium">
            <div class="compendium-preset-heading">
                <strong>Saved Compendium</strong>
                <span data-compendium-preset-dirty hidden>Modified</span>
            </div>
            <div class="compendium-preset-row">
                <select class="form-select form-select-sm" data-compendium-preset-select aria-label="Saved Compendium">
                    <option value="">Unsaved Compendium</option>
                    @foreach (var preset in Model.SavedCompendiums)
                    {
                        if (Model.PresetId == preset.Id)
                        {
                            <option value="@preset.Id" selected>@preset.Name</option>
                        }
                        else
                        {
                            <option value="@preset.Id">@preset.Name</option>
                        }
                    }
                </select>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-compendium-preset-load>Load</button>

                @if (Model.CanManagePresets)
                {
                    <div class="btn-group">
                        <button type="button" class="btn btn-sm btn-primary" data-compendium-save-as-new>Save</button>
                        <button type="button"
                                class="btn btn-sm btn-primary dropdown-toggle dropdown-toggle-split"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <span class="visually-hidden">Saved Compendium actions</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><button class="dropdown-item" type="button" data-compendium-save-changes>Save changes</button></li>
                            <li><button class="dropdown-item" type="button" data-compendium-rename>Rename</button></li>
                            <li><button class="dropdown-item" type="button" data-compendium-duplicate>Duplicate</button></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><button class="dropdown-item text-danger" type="button" data-compendium-delete>Delete</button></li>
                        </ul>
                    </div>
                }
            </div>
            <small data-compendium-preset-meta>
                @if (Model.ActivePreset is null)
                {
                    <text>Load a shared publication configuration or continue with an ad-hoc Compendium.</text>
                }
                else
                {
                    <text>Shared · @Model.ActivePreset.ProjectCount projects · Updated @Model.ActivePreset.UpdatedAtUtc.ToString("dd MMM yyyy") · @Model.ActivePreset.UpdatedByDisplay</text>
                }
            </small>
        </section>
    </header>

    <partial name="/Pages/Projects/Publications/_PublicationTabs.cshtml" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger brochure-validation" role="alert"></div>
    @foreach (var diagnostic in Model.PresetDiagnostics)
    {
        var alertClass = diagnostic.Severity == CompendiumPresetDiagnosticSeverity.Warning
            ? "alert-warning"
            : "alert-info";
        <div class="alert @alertClass py-2">@diagnostic.Message</div>
    }

    <form method="post"
          class="compendium-builder-form"
          data-compendium-builder
          data-preflight-url="@Url.Page("/Projects/Publications/Compendium/Index", "Preflight")"
          data-review-url="@Url.Page("/Projects/Publications/Compendium/Index", "Review")"
          data-preview-url="@Url.Page("/Projects/Publications/Compendium/Index", "Preview")"
          data-generate-url="@Url.Page("/Projects/Publications/Compendium/Index", "Generate")"
          data-photo-frame-width="@CompendiumPublicationImagePolicy.FrameWidthPoints"
          data-photo-frame-height="@CompendiumPublicationImagePolicy.FrameHeightPoints"
          data-can-maintain-project-data="@(Model.CanMaintainProjectData ? "true" : "false")"
          data-save-url="@Url.Page("/Projects/Publications/Compendium/Index", "SavePreset")"
          data-rename-url="@Url.Page("/Projects/Publications/Compendium/Index", "RenamePreset")"
          data-duplicate-url="@Url.Page("/Projects/Publications/Compendium/Index", "DuplicatePreset")"
          data-delete-url="@Url.Page("/Projects/Publications/Compendium/Index", "DeletePreset")">
        @Html.AntiForgeryToken()
        <input asp-for="Input.SelectedProjectIdsCsv" type="hidden" data-selected-project-ids />
        <input asp-for="Input.ProjectSelectionsJson" type="hidden" data-project-selections />
        <input asp-for="Input.NarrativeSource" type="hidden" data-narrative-source />
        <input asp-for="Input.GroupingMode" type="hidden" data-grouping-mode />
        <input asp-for="Input.SortMode" type="hidden" data-sort-mode />
        <input asp-for="PresetId" type="hidden" data-active-preset-id />
        <input asp-for="ActivePresetRowVersion" type="hidden" data-active-preset-row-version />
        <input asp-for="Input.CoverImageMode" type="hidden" data-cover-image-mode />
        <input asp-for="Input.CoverHeroProjectId" type="hidden" data-cover-hero-project />
        <input asp-for="Input.CoverHeroPhotoId" type="hidden" data-cover-hero-photo />
        <input asp-for="Input.CoverFocalX" type="hidden" data-cover-focal-x />
        <input asp-for="Input.CoverFocalY" type="hidden" data-cover-focal-y />

        <script type="application/json" data-compendium-projects>@Html.Raw(JsonSerializer.Serialize(Model.Projects, jsonOptions))</script>
        <script type="application/json" data-compendium-presets>@Html.Raw(JsonSerializer.Serialize(Model.SavedCompendiums, jsonOptions))</script>
        <script type="application/json" data-compendium-active-preset>@Html.Raw(JsonSerializer.Serialize(new
        {
            id = Model.ActivePreset?.Id,
            rowVersion = Model.ActivePreset?.RowVersion,
            canManage = Model.CanManagePresets
        }, jsonOptions))</script>

        <div class="compendium-builder-layout">
            <main class="compendium-builder-main">
                <section class="publication-panel" id="compendium-settings">
                    <header class="publication-panel__header">
                        <div>
                            <span class="publication-step">1</span>
                            <div>
                                <h2>Publication settings</h2>
                                <p>Set the title and publication details for this Compendium.</p>
                            </div>
                        </div>
                    </header>
                    <div class="publication-panel__body">
                        <div class="brochure-form-grid">
                            <label class="brochure-field">
                                <span>Compendium title</span>
                                <input asp-for="Input.Title" class="form-control" maxlength="120" data-compendium-durable />
                            </label>
                            <label class="brochure-field">
                                <span>Edition</span>
                                <input asp-for="Input.Edition" class="form-control" maxlength="80" data-compendium-durable />
                            </label>
                            <label class="brochure-field">
                                <span>Subtitle</span>
                                <input asp-for="Input.Subtitle" class="form-control" maxlength="160" data-compendium-durable />
                            </label>
                            <label class="brochure-field">
                                <span>Handling/classification marking</span>
                                <input asp-for="Input.HandlingMarking"
                                       class="form-control"
                                       maxlength="80"
                                       placeholder="Optional, e.g. RESTRICTED"
                                       data-compendium-durable />
                                <small>PRISM never assigns a classification automatically.</small>
                            </label>
                        </div>

                        <section class="compendium-composer" aria-label="Publication composition">
                            <div class="compendium-composer__heading">
                                <div>
                                    <span>Publication composition</span>
                                    <strong>Choose what the Compendium says and how it is organised.</strong>
                                </div>
                                <span class="compendium-composer__badge">Editorial controls</span>
                            </div>
                            <div class="compendium-composer__grid">
                                <div class="compendium-composer__control">
                                    <div class="compendium-composer__label"><i class="bi bi-file-text"></i><span><strong>Project narrative</strong><small>Used on every project dossier.</small></span></div>
                                    <div class="compendium-segmented" role="group" aria-label="Project narrative source">
                                        <button type="button" data-narrative-value="ProjectBrief">Project brief <span>Default</span></button>
                                        <button type="button" data-narrative-value="CapabilityOverview">Capability overview</button>
                                        <button type="button" data-narrative-value="ProjectDescription">Description</button>
                                    </div>
                                </div>
                                <div class="compendium-composer__control">
                                    <div class="compendium-composer__label"><i class="bi bi-collection"></i><span><strong>Grouping</strong><small>Controls catalogue sections and index headings.</small></span></div>
                                    <div class="compendium-segmented" role="group" aria-label="Publication grouping">
                                        <button type="button" data-grouping-value="TechnicalCategory">Technical category</button>
                                        <button type="button" data-grouping-value="None">No grouping</button>
                                        <button type="button" data-grouping-value="CustomSections">Custom sections</button>
                                    </div>
                                </div>
                                <div class="compendium-composer__control">
                                    <div class="compendium-composer__label"><i class="bi bi-sort-down"></i><span><strong>Order</strong><small>Project sequence inside the publication.</small></span></div>
                                    <div class="compendium-segmented" role="group" aria-label="Publication order">
                                        <button type="button" data-sort-value="Manual">Manual</button>
                                        <button type="button" data-sort-value="LatestFirst">Latest first</button>
                                        <button type="button" data-sort-value="Alphabetical">A–Z</button>
                                    </div>
                                </div>
                            </div>
                            <p class="compendium-composer__note" data-composer-note>Technical categories remain authoritative project data. Publication sections only change this Compendium.</p>
                        </section>

                        <div class="compendium-cover-setting" data-cover-setting>
                            <div class="compendium-cover-preview" data-cover-preview>
                                <i class="bi bi-image" aria-hidden="true"></i>
                                <img alt="" data-cover-preview-image hidden />
                            </div>
                            <div class="compendium-cover-copy">
                                <span>Cover imagery</span>
                                <strong data-cover-status>Automatic hero</strong>
                                <small data-cover-detail>PRISM uses the strongest available publication image from the selected projects.</small>
                            </div>
                            <div class="compendium-cover-actions">
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-cover-automatic>Automatic hero</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-cover-choose><i class="bi bi-images"></i> Choose hero</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-cover-none>No imagery</button>
                            </div>
                        </div>
                        <small class="compendium-cover-help">Choose a hero directly here or use <b>Use as cover hero</b> while reviewing a project. Cover crop is stored independently from the project page.</small>
                    </div>
                </section>

                <section class="publication-panel" id="compendium-select">
                    <header class="publication-panel__header">
                        <div>
                            <span class="publication-step">2</span>
                            <div>
                                <h2>Select projects</h2>
                                <p><span data-compendium-matching>@Model.Projects.Count</span> matching · <span data-compendium-selected-count>0</span> selected</p>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-select-matching>Select matching</button>
                    </header>
                    <div class="publication-panel__body publication-panel__body--projects">
                        <div class="compendium-filter-toolbar">
                            <label class="brochure-search-field">
                                <i class="bi bi-search"></i>
                                <input class="form-control" type="search" placeholder="Search projects..." data-filter-search />
                            </label>
                            <select class="form-select" data-filter-lifecycle aria-label="Lifecycle">
                                <option value="">All lifecycle</option>
                                <option>Ongoing</option>
                                <option>Completed</option>
                            </select>
                            <select class="form-select" data-filter-category aria-label="Project category">
                                <option value="">All project categories</option>
                                @foreach (var category in Model.ProjectCategories)
                                {
                                    <option>@category</option>
                                }
                            </select>
                            <select class="form-select" data-filter-technical aria-label="Technical category">
                                <option value="">All technical categories</option>
                                @foreach (var category in Model.TechnicalCategories)
                                {
                                    <option>@category</option>
                                }
                            </select>
                            <select class="form-select" data-filter-proliferation aria-label="Proliferation status">
                                <option value="">All proliferation status</option>
                                <option value="available">Available for proliferation</option>
                                <option value="notavailable">Not available for proliferation</option>
                                <option value="notassessed">Availability not assessed</option>
                            </select>
                            <label class="brochure-selected-only">
                                <input class="form-check-input" type="checkbox" data-filter-selected />
                                Selected only
                            </label>
                        </div>

                        <div class="compendium-project-table-wrap">
                            <table class="compendium-project-table">
                                <thead>
                                    <tr>
                                        <th scope="col"></th>
                                        <th scope="col">Project</th>
                                        <th scope="col">Status</th>
                                        <th scope="col">Compendium data</th>
                                        <th scope="col">Photography</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var project in Model.Projects)
                                    {
                                        var costClass = project.HasProliferationCost
                                            ? "is-ok"
                                            : project.IsAvailableForProliferation ? "is-missing" : "is-neutral";
                                        var costTitle = project.HasProliferationCost
                                            ? "Proliferation cost available"
                                            : project.IsAvailableForProliferation
                                                ? "Proliferation cost missing"
                                                : "Proliferation cost not required for the current proliferation status";
                                        var costIcon = project.HasProliferationCost
                                            ? "bi-check2"
                                            : project.IsAvailableForProliferation ? "bi-exclamation-lg" : "bi-dash";
                                        var photoLabel = project.PhotoCount == 1 ? "1 photo" : $"{project.PhotoCount} photos";
                                        var photoTitle = project.PhotoCount == 1
                                            ? "1 project photograph available"
                                            : $"{project.PhotoCount} project photographs available";
                                        <tr data-project-row
                                            data-id="@project.ProjectId"
                                            data-name="@project.ProjectName.ToLowerInvariant()"
                                            data-lifecycle="@project.Lifecycle"
                                            data-category="@project.ProjectCategory"
                                            data-technical="@project.TechnicalCategory"
                                            data-proliferation="@(project.ProliferationAvailability == true ? "available" : project.ProliferationAvailability == false ? "notavailable" : "notassessed")">
                                            <td>
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       value="@project.ProjectId"
                                                       data-project-checkbox
                                                       aria-label="Select @project.ProjectName" />
                                            </td>
                                            <td>
                                                <strong>@project.ProjectName</strong>
                                                <small>@(project.ProjectCategory ?? "Uncategorised") · @(project.TechnicalCategory ?? "Technical category not recorded")</small>
                                            </td>
                                            <td>
                                                <span>@project.Lifecycle</span>
                                                <small>@project.CompletionDisplay</small>
                                            </td>
                                            <td>
                                                <div class="compendium-data-badges" aria-label="Compendium data readiness">
                                                    <span class="@(project.HasProjectBrief ? "is-ok" : "is-missing")" title="@(project.HasProjectBrief ? $"Project brief available · {project.ProjectBriefWordCount} words" : "Project brief missing")" data-source-readiness="ProjectBrief">
                                                        <i class="bi @(project.HasProjectBrief ? "bi-check2" : "bi-exclamation-lg")" aria-hidden="true"></i><span>Brief</span>
                                                    </span>
                                                    <span class="@(project.HasCapabilityOverview ? "is-ok" : "is-missing")" title="@(project.HasCapabilityOverview ? $"Capability overview available · {project.CapabilityStatementCount} statements" : "Capability overview missing")" data-source-readiness="CapabilityOverview">
                                                        <i class="bi @(project.HasCapabilityOverview ? "bi-check2" : "bi-exclamation-lg")" aria-hidden="true"></i><span>Capabilities</span>
                                                    </span>
                                                    <span class="@(project.HasDescription ? "is-ok" : "is-missing")" title="@(project.HasDescription ? $"Description available · {project.DescriptionWordCount} words" : "Description missing")" data-source-readiness="ProjectDescription">
                                                        <i class="bi @(project.HasDescription ? "bi-check2" : "bi-exclamation-lg")" aria-hidden="true"></i><span>Description</span>
                                                    </span>
                                                    <span class="@(project.HasArmService ? "is-ok" : "is-missing")"
                                                          title="@(project.HasArmService ? "Arm/Service available" : "Arm/Service missing")">
                                                        <i class="bi @(project.HasArmService ? "bi-check2" : "bi-exclamation-lg")" aria-hidden="true"></i>
                                                        <span>Arm/Service</span>
                                                    </span>
                                                    <span class="@costClass" title="@costTitle">
                                                        <i class="bi @costIcon" aria-hidden="true"></i>
                                                        <span>Cost</span>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                @if (project.PhotoCount > 0)
                                                {
                                                    <span class="compendium-photo-count" title="@photoTitle">
                                                        <i class="bi bi-image" aria-hidden="true"></i>
                                                        <span>@photoLabel</span>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="compendium-photo-count is-missing" title="No project photograph is available">
                                                        <i class="bi bi-image" aria-hidden="true"></i>
                                                        <span>No photo</span>
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <section class="publication-panel" id="compendium-review">
                    <header class="publication-panel__header compendium-review-header">
                        <div>
                            <span class="publication-step">3</span>
                            <div>
                                <h2>Review publication</h2>
                                <p><span data-review-progress aria-live="polite">0 of 0 reviewed</span> · inspect the information and image that will be published.</p>
                            </div>
                        </div>
                        <div class="compendium-review-nav" aria-label="Project review navigation">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-review-previous title="Previous project" aria-label="Previous project" disabled aria-disabled="true"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-review-next-attention disabled aria-disabled="true">Next requiring attention</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-review-next title="Next project" aria-label="Next project" disabled aria-disabled="true"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                        </div>
                    </header>
                    <div class="publication-panel__body">
                        <div class="compendium-review-empty" data-review-empty>
                            <i class="bi bi-journal-text"></i>
                            <strong>Select projects to begin review.</strong>
                            <span>The review workspace will show the current PRISM facts and publication photograph for each selected project.</span>
                        </div>
                        <article class="compendium-review-card compendium-review-card--phase23" data-review-card hidden>
                            <header class="compendium-review-card__heading">
                                <div>
                                    <small data-review-ordinal></small>
                                    <h3 data-review-name></h3>
                                    <p data-review-meta></p>
                                </div>
                                <span class="compendium-review-state" data-review-state aria-live="polite">Review required</span>
                            </header>

                            <div class="compendium-review-workspace">
                                <section class="compendium-review-image-panel" aria-label="Publication photograph">
                                    <div class="compendium-review-image-frame" data-review-image-frame>
                                        <img alt="" data-review-image hidden />
                                        <div class="compendium-review-image-empty" data-review-image-empty>
                                            <i class="bi bi-image"></i>
                                            <strong>No publication image</strong>
                                        </div>
                                    </div>
                                    <div class="compendium-review-image-meta">
                                        <div>
                                            <span class="compendium-image-badge" data-review-image-mode>Automatic</span>
                                            <span class="compendium-image-badge" data-review-image-quality>Quality pending</span>
                                        </div>
                                        <small data-review-image-detail></small>
                                    </div>
                                    <div class="compendium-review-image-actions">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-review-change-image><i class="bi bi-images"></i> Change image</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-review-adjust-crop><i class="bi bi-crop"></i> Adjust crop</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-review-use-cover><i class="bi bi-card-image"></i> Use as cover hero</button>
                                        <button type="button" class="btn btn-sm btn-link" data-review-use-automatic>Use automatic</button>
                                    </div>
                                    <a class="compendium-manage-photos" data-review-manage-photos><i class="bi bi-box-arrow-up-right"></i> Manage project photographs</a>
                                </section>

                                <section class="compendium-review-information">
                                    <div class="compendium-review-facts compendium-review-facts--phase23" data-review-facts></div>
                                    <div class="compendium-review-narrative-selector" data-review-narrative-options aria-label="Narrative availability"></div>
                                    <div class="compendium-review-description">
                                        <div class="compendium-review-section-heading">
                                            <strong data-review-narrative-label>Project Brief</strong>
                                            <span data-review-description-state></span>
                                        </div>
                                        <div class="compendium-review-description-text" data-review-description></div>
                                    </div>
                                    <div class="compendium-review-actions">
                                        <a class="btn btn-sm btn-outline-secondary" data-review-open-project><i class="bi bi-box-arrow-up-right"></i> Open project</a>
                                        <a class="btn btn-sm btn-outline-secondary" data-review-edit-record hidden><i class="bi bi-pencil"></i> Edit record</a>
                                    </div>
                                </section>
                            </div>

                            <footer class="compendium-review-footer">
                                <div>
                                    <strong data-review-footer-title>Review required</strong>
                                    <span data-review-footer-copy>Confirm the current project facts and publication image.</span>
                                </div>
                                <button type="button" class="btn btn-sm btn-primary" data-review-mark-reviewed title="Review & next · Ctrl+Enter"><i class="bi bi-check2-circle"></i> Review & next</button>
                            </footer>
                        </article>
                    </div>
                </section>

                <section class="publication-panel" id="compendium-readiness">
                    <header class="publication-panel__header">
                        <div>
                            <span class="publication-step">4</span>
                            <div>
                                <h2>Publication readiness</h2>
                                <p>Check the selected projects for publication completeness and quality.</p>
                            </div>
                        </div>
                        <span class="spinner-border spinner-border-sm d-none" data-preflight-spinner role="status" aria-label="Checking publication readiness"></span>
                    </header>
                    <div class="publication-panel__body">
                        <div class="compendium-readiness-metrics">
                            <div><span>Selected</span><strong data-ready-selected>0</strong></div>
                            <div><span>Blockers</span><strong data-ready-blockers>—</strong></div>
                            <div><span>Warnings</span><strong data-ready-warnings>—</strong></div>
                            <div><span>Info</span><strong data-ready-info>—</strong></div>
                        </div>
                        <div class="compendium-readiness-structure">
                            <strong>Catalogue structure</strong>
                            <span data-ready-structure-copy>Select projects to build the catalogue structure.</span>
                            <span class="visually-hidden"><b data-ready-reviewed>0</b><b data-ready-categories>0</b></span>
                        </div>
                        <div class="compendium-finding-toolbar is-disabled" data-finding-toolbar aria-disabled="true">
                            <div class="btn-group btn-group-sm" role="group" aria-label="Finding severity">
                                <button type="button" class="btn btn-outline-secondary active" data-finding-filter="all" disabled>All</button>
                                <button type="button" class="btn btn-outline-secondary" data-finding-filter="blocker" disabled>Blockers</button>
                                <button type="button" class="btn btn-outline-secondary" data-finding-filter="warning" disabled>Warnings</button>
                                <button type="button" class="btn btn-outline-secondary" data-finding-filter="information" disabled>Info</button>
                            </div>
                            <label class="compendium-current-findings">
                                <input class="form-check-input" type="checkbox" data-findings-current-only disabled /> Current project only
                            </label>
                        </div>
                        <div class="compendium-findings" data-ready-findings>
                            <div class="compendium-readiness-empty"><i class="bi bi-journal-check" aria-hidden="true"></i><span>Select projects to begin publication readiness checks.</span></div>
                        </div>
                    </div>
                </section>
            </main>

            <aside class="compendium-builder-rail">
                <section class="publication-panel compendium-order-card">
                    <header class="publication-panel__header publication-panel__header--compact">
                        <div>
                            <div>
                                <h2>Publication structure</h2>
                                <p><span data-rail-count>0</span> selected · <span data-order-mode-copy>manual order</span></p>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-link" data-clear-selection hidden disabled aria-disabled="true">Clear selection</button>
                    </header>
                    <div class="compendium-custom-section-toolbar" data-custom-section-toolbar hidden>
                        <div>
                            <input class="form-control form-control-sm" maxlength="120" placeholder="New section name" data-custom-section-name />
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-custom-section-add><i class="bi bi-plus-lg"></i> Add</button>
                        </div>
                        <small>Create publication-only sections, then assign projects below.</small>
                    </div>
                    <div class="compendium-order-list" data-order-list>
                        <div class="compendium-order-empty">
                            <i class="bi bi-journal"></i>
                            <span>Select projects from the portfolio.</span>
                        </div>
                    </div>
                    <p class="compendium-order-note" data-order-note>Projects are grouped by their authoritative technical category. Manual drag order is retained within those sections.</p>
                </section>

                <section class="publication-panel compendium-final-card">
                    <header class="publication-panel__header publication-panel__header--compact">
                        <div>
                            <div>
                                <h2>Final output</h2>
                                <p>Preview the current publication at any valid stage; download when it is ready for issue.</p>
                            </div>
                        </div>
                    </header>
                    <div class="publication-panel__body">
                        <div class="compendium-output-status" data-output-status aria-live="polite">
                            <i class="bi bi-journal"></i>
                            <div>
                                <strong>Select projects</strong>
                                <span>Choose at least one project to begin publication preflight.</span>
                            </div>
                        </div>
                        <div class="compendium-output-verification" data-output-verification hidden>
                            <i class="bi bi-patch-check-fill" aria-hidden="true"></i>
                            <span data-output-verification-text>PDF verified</span>
                        </div>
                        <div class="compendium-output-actions">
                            <button type="submit"
                                    asp-page-handler="Preview"
                                    class="btn btn-outline-primary"
                                    data-preview
                                    disabled
                                    aria-disabled="true">
                                <i class="bi bi-eye"></i> Preview PDF
                            </button>
                            <button type="submit"
                                    asp-page-handler="Generate"
                                    class="btn btn-primary"
                                    data-generate
                                    disabled
                                    aria-disabled="true">
                                <i class="bi bi-download"></i> Download Compendium PDF
                            </button>
                        </div>
                    </div>
                </section>
            </aside>
        </div>
    </form>
</div>

<div class="modal fade compendium-photo-modal" id="compendiumPhotoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title">Publication photograph</h5>
                    <small data-photo-modal-project></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="compendium-photo-modal-layout">
                    <section>
                        <div class="compendium-photo-modal-heading">
                            <div><strong>Choose image</strong><span>Select the photograph to lock for this Compendium.</span></div>
                            <button type="button" class="btn btn-sm btn-link" data-photo-use-automatic>Use automatic selection</button>
                        </div>
                        <div class="compendium-photo-picker" data-photo-picker></div>
                    </section>
                    <section class="compendium-crop-panel">
                        <div class="compendium-photo-modal-heading">
                            <div><strong>Publication crop</strong><span>Click the source image to position the focal point inside the Compendium frame.</span></div>
                            <button type="button" class="btn btn-sm btn-link" data-photo-reset-crop>Centre crop</button>
                        </div>
                        <div class="compendium-crop-stage" data-photo-crop-stage>
                            <img alt="Publication crop source" data-photo-crop-image />
                            <div class="compendium-crop-frame" data-photo-crop-frame aria-hidden="true"></div>
                            <span class="compendium-focal-marker" data-photo-focal-marker aria-hidden="true"></span>
                            <div class="compendium-crop-empty" data-photo-crop-empty hidden>No usable photograph is selected.</div>
                        </div>
                        <div class="compendium-crop-status">
                            <span data-photo-crop-selection></span>
                            <span data-photo-crop-quality></span>
                        </div>
                    </section>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-outline-secondary me-auto" data-photo-manage-link><i class="bi bi-images"></i> Manage project photographs</a>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Done</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade compendium-cover-hero-modal" id="compendiumCoverHeroModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div><h5 class="modal-title">Choose cover hero</h5><small>Select the publication image that should lead the Compendium.</small></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="compendium-cover-hero-picker" data-cover-hero-picker></div>
                <div class="compendium-cover-hero-empty" data-cover-hero-empty hidden>No selected project currently has a usable publication image.</div>
            </div>
            <div class="modal-footer">
                <span class="me-auto">The selected project's current publication crop is copied to the cover and can later diverge independently.</span>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="compendiumDiscardModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Unsaved changes</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">This Compendium has configuration changes that have not been saved. Discard them and load the selected saved Compendium?</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Stay here</button>
                <button type="button" class="btn btn-danger" data-discard-load>Discard and load</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="compendiumSaveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Save Compendium</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label class="form-label w-100">Name
                    <input class="form-control" maxlength="120" data-save-name />
                </label>
                <label class="form-label w-100 mt-2">Description
                    <textarea class="form-control" maxlength="500" rows="2" data-save-description></textarea>
                </label>
                <div class="compendium-modal-message" data-save-message></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" type="button" data-save-confirm>Save shared Compendium</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="compendiumRenameModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Rename Compendium</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label class="form-label w-100">Name
                    <input class="form-control" maxlength="120" data-rename-name />
                </label>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" type="button" data-rename-confirm>Rename</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="compendiumDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete saved Compendium?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">This removes the shared configuration. It does not alter any project record.</div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-danger" type="button" data-delete-confirm>Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pages/projects-compendium.js" asp-append-version="true"></script>
}
