@page "/Projects/Publications/Brochure"
@model ProjectManagement.Pages.Projects.Publications.Brochure.IndexModel
@using ProjectManagement.Services.Publications
@using System.Text.Json
@{
    ViewData["Title"] = "Capability Brochure";
    var selectedIds = Model.Input.Selections.Select(selection => selection.ProjectId).ToHashSet();
    var jsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    var clientProjects = Model.Projects.Select(project => new
    {
        project.ProjectId,
        project.ProjectName,
        project.Lifecycle,
        project.ProjectCategory,
        project.TechnicalCategory,
        project.HasProjectBrief,
        project.HasCapabilityOverview,
        project.HasFullDescription,
        project.ProjectBriefWordCount,
        project.CapabilityOverviewWordCount,
        project.FullDescriptionWordCount,
        project.DefaultPrimaryPhotoId,
        project.DefaultSecondaryPhotoId,
        overviewUrl = Url.Page("/Projects/Overview", new { id = project.ProjectId, ContentTab = "brief" }),
        photosUrl = Url.Page("/Projects/Photos/Index", new { id = project.ProjectId }),
        photos = project.Photos.Select(photo => new
        {
            photo.PhotoId,
            photo.Version,
            photo.Caption,
            photo.Width,
            photo.Height,
            photo.IsCover,
            thumbnailUrl = Url.Page("/Projects/Publications/Brochure/Index", "Photo", new
            {
                projectId = project.ProjectId,
                photoId = photo.PhotoId,
                mode = "thumb",
                v = photo.Version
            }),
            previewUrl = Url.Page("/Projects/Publications/Brochure/Index", "Photo", new
            {
                projectId = project.ProjectId,
                photoId = photo.PhotoId,
                mode = "source",
                v = photo.Version
            })
        })
    }).ToArray();
    var projectJson = JsonSerializer.Serialize(clientProjects, jsonOptions);
    var selectionJson = JsonSerializer.Serialize(Model.Input.Selections, jsonOptions);
    var approvedPrintJson = JsonSerializer.Serialize(Model.ApprovedPrintMatter, jsonOptions);
    var preflightUrl = Url.Page("/Projects/Publications/Brochure/Index", "Preflight");
    var projectStateUrl = Url.Page("/Projects/Publications/Brochure/Index", "ProjectState");
    var previewUrl = Url.Page("/Projects/Publications/Brochure/Index", "Preview");
    var generateUrl = Url.Page("/Projects/Publications/Brochure/Index", "Generate");
    var savePresetUrl = Url.Page("/Projects/Publications/Brochure/Index", "SavePreset");
    var renamePresetUrl = Url.Page("/Projects/Publications/Brochure/Index", "RenamePreset");
    var duplicatePresetUrl = Url.Page("/Projects/Publications/Brochure/Index", "DuplicatePreset");
    var deletePresetUrl = Url.Page("/Projects/Publications/Brochure/Index", "DeletePreset");
    var savedPresetJson = JsonSerializer.Serialize(Model.SavedBrochures.Select(preset => new
    {
        preset.Id,
        preset.Name,
        preset.Description,
        publicationProfile = preset.PublicationProfile.ToString(),
        preset.ProjectCount,
        updatedAtUtc = preset.UpdatedAtUtc,
        preset.UpdatedByDisplay,
        preset.RowVersion
    }), jsonOptions);
    var activePresetJson = JsonSerializer.Serialize(new
    {
        id = Model.ActiveSavedBrochure?.Id,
        name = Model.ActiveSavedBrochure?.Name,
        description = Model.ActiveSavedBrochure?.Description,
        rowVersion = Model.ActivePresetRowVersion,
        canManage = Model.CanManageSavedBrochures
    }, jsonOptions);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/projects-publications.css" asp-append-version="true" />
}

<div class="publications-page brochure-builder">
    <nav class="publications-breadcrumb" aria-label="Breadcrumb">
        <a asp-page="/Projects/Index">Projects</a>
        <span aria-hidden="true">/</span>
        <a asp-page="/Projects/Publications/Index">Publications</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Brochure</span>
    </nav>

    <header class="publications-header publications-header--builder brochure-workspace-header">
        <div class="brochure-workspace-header__copy">
            <h1>Brochure Builder</h1>
            <p>Compose, review and generate capability publications from authoritative PRISM project records.</p>
        </div>

        <section class="brochure-preset-control" data-brochure-preset-control aria-label="Saved brochure configuration">
            <div class="brochure-preset-control__label">
                <span>Saved brochure</span>
                <span class="brochure-preset-dirty" hidden data-preset-dirty-state></span>
            </div>
            <div class="brochure-preset-control__actions">
                <select class="form-select form-select-sm" data-preset-select aria-label="Choose a saved brochure">
                    <option value="">Unsaved brochure</option>
                    @foreach (var preset in Model.SavedBrochures)
                    {
                        if (Model.ActivePresetId == preset.Id)
                        {
                            <option value="@preset.Id" selected>@preset.Name</option>
                        }
                        else
                        {
                            <option value="@preset.Id">@preset.Name</option>
                        }
                    }
                </select>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-preset-load disabled>Load</button>
                @if (Model.CanManageSavedBrochures)
                {
                    <div class="dropdown brochure-preset-save-menu">
                        <button type="button"
                                class="btn btn-sm btn-primary dropdown-toggle"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                data-preset-save-menu>
                            Save
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><button type="button" class="dropdown-item" data-preset-save-changes>Save changes</button></li>
                            <li><button type="button" class="dropdown-item" data-preset-save-as-new>Save as new</button></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><button type="button" class="dropdown-item" data-preset-rename>Rename</button></li>
                            <li><button type="button" class="dropdown-item" data-preset-duplicate>Duplicate saved version</button></li>
                            <li><button type="button" class="dropdown-item" data-preset-manage>Manage saved brochures</button></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><button type="button" class="dropdown-item text-danger" data-preset-delete>Delete saved brochure</button></li>
                        </ul>
                    </div>
                }
            </div>
            <div class="brochure-preset-control__meta" data-preset-meta>
                @if (Model.ActiveSavedBrochure is not null)
                {
                    <span>Shared · @Model.ActiveSavedBrochure.ProjectCount project@(Model.ActiveSavedBrochure.ProjectCount == 1 ? string.Empty : "s")</span>
                    <span>Updated @Model.ActiveSavedBrochure.UpdatedAtUtc.ToString("dd MMM yyyy") · @Model.ActiveSavedBrochure.UpdatedByDisplay</span>
                }
                else
                {
                    <span>Load a shared institutional configuration, or continue with an ad-hoc brochure.</span>
                }
            </div>
            <div class="brochure-preset-control__status" hidden role="status" aria-live="polite" data-preset-status></div>
        </section>
    </header>

    <partial name="/Pages/Projects/Publications/_PublicationTabs.cshtml" />

    @if (Model.PresetLoadDiagnostics.Count > 0)
    {
        <section class="brochure-preset-diagnostics" aria-label="Saved brochure load diagnostics">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            <div>
                <strong>Saved brochure loaded with changes</strong>
                @foreach (var diagnostic in Model.PresetLoadDiagnostics)
                {
                    <span>@diagnostic.Message</span>
                }
            </div>
        </section>
    }

    <div asp-validation-summary="ModelOnly" class="alert alert-danger brochure-validation" role="alert"></div>
    <span asp-validation-for="Input.Selections" class="text-danger small"></span>

    <form method="post"
          asp-page-handler="Generate"
          class="brochure-form"
          data-brochure-form
          data-brochure-preflight-url="@preflightUrl"
          data-brochure-project-state-url="@projectStateUrl"
          data-brochure-preview-url="@previewUrl"
          data-brochure-generate-url="@generateUrl"
          data-brochure-save-preset-url="@savePresetUrl"
          data-brochure-rename-preset-url="@renamePresetUrl"
          data-brochure-duplicate-preset-url="@duplicatePresetUrl"
          data-brochure-delete-preset-url="@deletePresetUrl">
        <input asp-for="ActivePresetId" type="hidden" data-active-preset-id />
        <input asp-for="ActivePresetRowVersion" type="hidden" data-active-preset-row-version />
        <input asp-for="Input.CoverHeroProjectId" type="hidden" data-brochure-cover-hero-project />
        <input asp-for="Input.CoverHeroPhotoId" type="hidden" data-brochure-cover-hero-photo />
        <input asp-for="Input.CoverHeroFocalX" type="hidden" data-brochure-cover-hero-focal-x />
        <input asp-for="Input.CoverHeroFocalY" type="hidden" data-brochure-cover-hero-focal-y />
        <input asp-for="Input.CoverReviewed" type="hidden" data-brochure-cover-reviewed />
        <input asp-for="Input.CoverReviewFingerprint" type="hidden" data-brochure-cover-review-fingerprint />
        <div data-brochure-hidden-inputs></div>
        <script type="application/json" data-brochure-project-data>@Html.Raw(projectJson)</script>
        <script type="application/json" data-brochure-initial-selections>@Html.Raw(selectionJson)</script>
        <script type="application/json" data-brochure-approved-print-content>@Html.Raw(approvedPrintJson)</script>
        <script type="application/json" data-brochure-saved-presets>@Html.Raw(savedPresetJson)</script>
        <script type="application/json" data-brochure-active-preset>@Html.Raw(activePresetJson)</script>

        <div class="brochure-layout">
            <main class="brochure-main">
                <section class="publication-panel brochure-settings-panel">
                    <header class="publication-panel__header">
                        <div>
                            <span class="publication-step">1</span>
                            <div>
                                <h2>Publication settings</h2>
                                <p>Project Brief is recommended. One narrative source is applied consistently across the publication.</p>
                            </div>
                        </div>
                    </header>
                    <div class="publication-panel__body brochure-settings-body">
                        <div class="brochure-form-grid brochure-form-grid--compact">
                            <label class="form-label brochure-field" data-cover-a-identity-field>
                                <span>Brochure title</span>
                                <input asp-for="Input.Title" class="form-control" maxlength="120" />
                                <span asp-validation-for="Input.Title" class="text-danger small"></span>
                            </label>
                            <label class="form-label brochure-field" data-cover-a-identity-field>
                                <span>Edition</span>
                                <input asp-for="Input.Edition" class="form-control" maxlength="80" />
                                <span asp-validation-for="Input.Edition" class="text-danger small"></span>
                            </label>
                            <label class="form-label brochure-field" data-cover-a-identity-field>
                                <span>Subtitle</span>
                                <input asp-for="Input.Subtitle" class="form-control" maxlength="160" />
                                <span asp-validation-for="Input.Subtitle" class="text-danger small"></span>
                            </label>
                            <label class="form-label brochure-field" data-narrative-source-field>
                                <span>Project narrative source</span>
                                <select asp-for="Input.NarrativeSource"
                                        class="form-select"
                                        data-brochure-narrative-source
                                        data-brochure-preflight-trigger>
                                    <option value="@BrochureNarrativeSource.ProjectBrief">Project Brief — recommended</option>
                                    <option value="@BrochureNarrativeSource.CapabilityOverview">Capability Overview</option>
                                    <option value="@BrochureNarrativeSource.FullDescription">Full Description</option>
                                </select>
                                <small>Sources are never merged automatically.</small>
                            </label>
                        </div>
                        <div class="brochure-cover-a-identity-note" hidden data-cover-a-identity-note>
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                            <span>
                                <strong>Cover A uses the approved institutional artwork unchanged in Print / Compact.</strong>
                                <small>Brochure title, subtitle and edition remain document metadata and file-naming values; PRISM does not overlay them on the approved artwork.</small>
                            </span>
                        </div>

                        <fieldset class="brochure-profile-fieldset">
                            <legend>Publication profile</legend>
                            <div class="brochure-profile-options">
                                <label class="brochure-profile-option @(Model.Input.PublicationProfile == BrochurePublicationProfile.PrintCompact ? "is-selected" : string.Empty)" data-profile-option>
                                    <input type="radio"
                                           asp-for="Input.PublicationProfile"
                                           value="@BrochurePublicationProfile.PrintCompact"
                                           data-brochure-profile
                                           data-brochure-preflight-trigger />
                                    <span class="brochure-profile-option__icon"><i class="bi bi-journal-richtext" aria-hidden="true"></i></span>
                                    <span>
                                        <strong>Print / Compact</strong>
                                        <small>Original brochure format · narrow portrait · balanced hard-copy packing with content-bearing first and final pages.</small>
                                    </span>
                                </label>
                                <label class="brochure-profile-option @(Model.Input.PublicationProfile == BrochurePublicationProfile.DigitalComfortable ? "is-selected" : string.Empty)" data-profile-option>
                                    <input type="radio"
                                           asp-for="Input.PublicationProfile"
                                           value="@BrochurePublicationProfile.DigitalComfortable"
                                           data-brochure-profile
                                           data-brochure-preflight-trigger />
                                    <span class="brochure-profile-option__icon"><i class="bi bi-display" aria-hidden="true"></i></span>
                                    <span>
                                        <strong>Digital / Comfortable</strong>
                                        <small>A4 screen-first profile with larger imagery, comfortable typography and deliberate editorial pacing.</small>
                                    </span>
                                </label>
                            </div>
                        </fieldset>

                        <fieldset class="brochure-cover-fieldset">
                            <legend>Cover style</legend>
                            <div class="brochure-cover-options">
                                <label class="brochure-cover-option @(Model.Input.CoverStyle == BrochureCoverStyle.Institutional ? "is-selected" : string.Empty)" data-cover-option>
                                    <input type="radio"
                                           asp-for="Input.CoverStyle"
                                           value="@BrochureCoverStyle.Institutional"
                                           data-brochure-preflight-trigger />
                                    <span class="brochure-cover-preview brochure-cover-preview--institutional" aria-hidden="true">
                                        <span class="brochure-cover-preview__mark"></span>
                                        <span class="brochure-cover-preview__title"></span>
                                        <span class="brochure-cover-preview__montage"><i></i><i></i><i></i></span>
                                    </span>
                                    <span class="brochure-cover-option__copy">
                                        <strong>A · Institutional / Evolutionary</strong>
                                        <small>Approved institutional artwork when available; disciplined institutional treatment as fallback.</small>
                                    </span>
                                </label>
                                <label class="brochure-cover-option @(Model.Input.CoverStyle == BrochureCoverStyle.Contemporary ? "is-selected" : string.Empty)" data-cover-option>
                                    <input type="radio"
                                           asp-for="Input.CoverStyle"
                                           value="@BrochureCoverStyle.Contemporary"
                                           data-brochure-preflight-trigger />
                                    <span class="brochure-cover-preview brochure-cover-preview--contemporary" aria-hidden="true">
                                        <span class="brochure-cover-preview__mark"></span>
                                        <span class="brochure-cover-preview__title"></span>
                                        <span class="brochure-cover-preview__hero"></span>
                                    </span>
                                    <span class="brochure-cover-option__copy">
                                        <strong>B · Contemporary / Premium</strong>
                                        <small>Editorial cover with a dedicated hero selected from the chosen project imagery.</small>
                                    </span>
                                </label>
                            </div>
                        </fieldset>

                        <section class="brochure-institutional-artwork-panel" data-brochure-institutional-artwork-panel>
                            <div class="brochure-cover-hero-heading">
                                <div>
                                    <strong>Cover A artwork</strong>
                                    <small>The reference artwork is the default. Alternative offline artworks retain the same SDD technology narrative while offering a different visual treatment.</small>
                                    <small>Identity marks are embedded in every approved artwork; PRISM does not overlay additional organisation logos.</small>
                                </div>
                            </div>
                            <div class="brochure-artwork-options">
                                <label class="brochure-artwork-option @(Model.Input.InstitutionalCoverArtwork == BrochureInstitutionalCoverArtwork.ReferenceOriginal ? "is-selected" : string.Empty)" data-artwork-option>
                                    <input type="radio" asp-for="Input.InstitutionalCoverArtwork" value="@BrochureInstitutionalCoverArtwork.ReferenceOriginal" data-brochure-preflight-trigger />
                                    <img src="~/img/publications/covers/cover-a-reference-original.jpg" alt="Reference institutional cover artwork" decoding="async" />
                                    <span><strong>Reference Original</strong><small>Approved brochure visual · default</small></span>
                                </label>
                                <label class="brochure-artwork-option @(Model.Input.InstitutionalCoverArtwork == BrochureInstitutionalCoverArtwork.PremiumGreenGold ? "is-selected" : string.Empty)" data-artwork-option>
                                    <input type="radio" asp-for="Input.InstitutionalCoverArtwork" value="@BrochureInstitutionalCoverArtwork.PremiumGreenGold" data-brochure-preflight-trigger />
                                    <img src="~/img/publications/covers/cover-a-premium-green-gold.jpg" alt="Premium green and gold cover artwork" loading="lazy" decoding="async" />
                                    <span><strong>Premium Green–Gold</strong><small>Sharper institutional technology treatment</small></span>
                                </label>
                                <label class="brochure-artwork-option @(Model.Input.InstitutionalCoverArtwork == BrochureInstitutionalCoverArtwork.CinematicCyber ? "is-selected" : string.Empty)" data-artwork-option>
                                    <input type="radio" asp-for="Input.InstitutionalCoverArtwork" value="@BrochureInstitutionalCoverArtwork.CinematicCyber" data-brochure-preflight-trigger />
                                    <img src="~/img/publications/covers/cover-a-cinematic-cyber.jpg" alt="Cinematic cyber cover artwork" loading="lazy" decoding="async" />
                                    <span><strong>Cinematic Cyber</strong><small>High-contrast premium technology visual</small></span>
                                </label>
                                <label class="brochure-artwork-option @(Model.Input.InstitutionalCoverArtwork == BrochureInstitutionalCoverArtwork.ExecutiveTeal ? "is-selected" : string.Empty)" data-artwork-option>
                                    <input type="radio" asp-for="Input.InstitutionalCoverArtwork" value="@BrochureInstitutionalCoverArtwork.ExecutiveTeal" data-brochure-preflight-trigger />
                                    <img src="~/img/publications/covers/cover-a-executive-teal.jpg" alt="Executive teal cover artwork" loading="lazy" decoding="async" />
                                    <span><strong>Executive Teal</strong><small>Clean, restrained editorial treatment</small></span>
                                </label>
                                <label class="brochure-artwork-option @(Model.Input.InstitutionalCoverArtwork == BrochureInstitutionalCoverArtwork.LuminousHalo ? "is-selected" : string.Empty)" data-artwork-option>
                                    <input type="radio" asp-for="Input.InstitutionalCoverArtwork" value="@BrochureInstitutionalCoverArtwork.LuminousHalo" data-brochure-preflight-trigger />
                                    <img src="~/img/publications/covers/cover-a-luminous-halo.jpg" alt="Luminous halo cover artwork" loading="lazy" decoding="async" />
                                    <span><strong>Luminous Halo</strong><small>Bold ceremonial technology treatment</small></span>
                                </label>
                            </div>
                        </section>

                        <section class="brochure-cover-hero-panel" data-brochure-cover-hero-panel>
                            <div class="brochure-cover-hero-heading">
                                <div>
                                    <strong>Cover B hero</strong>
                                    <small>Automatic proposes the best suitable selected project image. Choose a hero to lock it independently of project order.</small>
                                </div>
                                <button type="button" class="btn btn-sm btn-link" data-cover-hero-automatic>Use automatic hero</button>
                            </div>
                            <div class="brochure-cover-hero-current" data-cover-hero-current>
                                <span class="brochure-cover-hero-current__image" data-cover-hero-image>
                                    <i class="bi bi-image" aria-hidden="true"></i>
                                </span>
                                <span class="brochure-cover-hero-current__copy">
                                    <strong data-cover-hero-name>Waiting for project selection</strong>
                                    <small data-cover-hero-meta>Select projects to resolve the automatic Cover B hero.</small>
                                    <span class="brochure-cover-hero-statuses">
                                        <span class="brochure-cover-review-state" data-cover-hero-review-state>Cover review required</span>
                                        <span class="brochure-cover-quality-state" hidden data-cover-hero-quality-state></span>
                                    </span>
                                </span>
                                <span class="brochure-cover-hero-current__actions">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-cover-hero-choose>Change hero</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-cover-hero-crop disabled>Adjust crop</button>
                                    <button type="button" class="btn btn-sm btn-success" data-cover-hero-approve disabled>
                                        <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                        Approve cover
                                    </button>
                                </span>
                            </div>
                            <div class="brochure-cover-hero-choices" hidden data-cover-hero-choices></div>
                            <div class="brochure-cover-crop-editor" hidden data-cover-hero-crop-panel>
                                <div class="brochure-focal-stage brochure-focal-stage--cover" data-cover-hero-focal-stage>
                                    <img alt="Cover B hero focal-point source" data-cover-hero-focal-image />
                                    <span class="brochure-focal-crop-frame" data-cover-hero-crop-frame aria-hidden="true"></span>
                                    <span class="brochure-focal-marker" data-cover-hero-focal-marker aria-hidden="true"></span>
                                    <button type="button" class="brochure-focal-reset" data-cover-hero-focal-reset>Reset</button>
                                </div>
                                <div class="brochure-cover-crop-editor__footer">
                                    <small>Click the source image to set the independent Cover B focal point. The outlined frame matches the cover-specific crop.</small>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-cover-hero-crop-close>Done</button>
                                </div>
                            </div>
                        </section>

                        <details class="brochure-cover-text" data-brochure-digital-only>
                            <summary><i class="bi bi-type" aria-hidden="true"></i> Digital cover text</summary>
                            <div class="brochure-cover-text__note">
                                <i class="bi bi-info-circle" aria-hidden="true"></i>
                                <span>Every line PRISM adds to the digital front or back cover is editable or suppressible. Text embedded inside an approved artwork remains part of that artwork.</span>
                            </div>
                            <div class="brochure-cover-text-grid">
                                <section class="brochure-cover-text-group" aria-label="Front cover text">
                                    <h3>Front cover</h3>
                                    <label class="form-label brochure-field">
                                        <span>Institution / kicker <small>optional</small></span>
                                        <input asp-for="Input.FrontCoverKicker" class="form-control" maxlength="120" placeholder="Simulator Development Division" data-brochure-preflight-trigger />
                                    </label>
                                    <label class="form-label brochure-field">
                                        <span>Publication descriptor <small>optional</small></span>
                                        <input asp-for="Input.FrontCoverDescriptor" class="form-control" maxlength="160" placeholder="Capability Publication" data-brochure-preflight-trigger />
                                    </label>
                                    <div class="brochure-cover-visibility" aria-label="Front cover visibility">
                                        <label><input asp-for="Input.ShowFrontCoverTitle" class="form-check-input" data-brochure-preflight-trigger /> <span>Show title</span></label>
                                        <label><input asp-for="Input.ShowFrontCoverSubtitle" class="form-check-input" data-brochure-preflight-trigger /> <span>Show subtitle</span></label>
                                        <label><input asp-for="Input.ShowFrontCoverEdition" class="form-check-input" data-brochure-preflight-trigger /> <span>Show edition</span></label>
                                        <label><input asp-for="Input.ShowFrontCoverStrapline" class="form-check-input" data-brochure-preflight-trigger /> <span>Show strapline</span></label>
                                    </div>
                                    <small>Title, subtitle and edition use the publication metadata fields above. The strapline remains editable under Advanced publication settings.</small>
                                </section>
                                <section class="brochure-cover-text-group" aria-label="Back cover text">
                                    <h3>Back cover</h3>
                                    <label class="form-label brochure-field">
                                        <span>Organisation line <small>optional</small></span>
                                        <input asp-for="Input.BackCoverKicker" class="form-control" maxlength="120" placeholder="Simulator Development Division" data-brochure-preflight-trigger />
                                    </label>
                                    <label class="form-label brochure-field">
                                        <span>Closing strapline <small>optional</small></span>
                                        <input asp-for="Input.BackCoverStrapline" class="form-control" maxlength="180" data-brochure-preflight-trigger />
                                    </label>
                                    <label class="form-label brochure-field">
                                        <span>Edition line <small>optional</small></span>
                                        <input asp-for="Input.BackCoverEdition" class="form-control" maxlength="80" data-brochure-preflight-trigger />
                                    </label>
                                    <small>Leave any back-cover field blank to omit that line. The back cover remains minimal even when all text is removed.</small>
                                </section>
                            </div>
                        </details>

                        <details class="brochure-advanced-options" open="@(!string.IsNullOrWhiteSpace(Model.Input.IntroductionText) || !string.IsNullOrWhiteSpace(Model.Input.HandlingMarking) || Model.Input.AllowTextOnlyProjects ? "open" : null)">
                            <summary><i class="bi bi-sliders" aria-hidden="true"></i> Advanced publication settings</summary>
                            <div class="brochure-advanced-grid">
                                <label class="form-label brochure-field brochure-field--wide">
                                    <span>Cover strapline</span>
                                    <input asp-for="Input.Strapline" class="form-control" maxlength="180" />
                                    <span asp-validation-for="Input.Strapline" class="text-danger small"></span>
                                </label>
                                <label class="form-label brochure-field">
                                    <span>Handling/classification marking</span>
                                    <input asp-for="Input.HandlingMarking" class="form-control" maxlength="80" placeholder="Optional, e.g. RESTRICTED" />
                                    <small>PRISM never assigns a marking automatically.</small>
                                </label>
                                <label class="brochure-policy-option">
                                    <input asp-for="Input.AllowTextOnlyProjects"
                                           class="form-check-input"
                                           data-brochure-preflight-trigger />
                                    <span>
                                        <strong>Permit text-only project blocks</strong>
                                        <small>Enable only where a project genuinely has no suitable publication photograph.</small>
                                    </span>
                                </label>
                                <label class="brochure-policy-option" data-brochure-digital-only>
                                    <input asp-for="Input.IncludeBackCover" class="form-check-input" data-brochure-preflight-trigger />
                                    <span>
                                        <strong>Include digital back cover</strong>
                                        <small>Digital profile only. The institutional closing page remains content-bearing and is separate from this minimal back cover.</small>
                                    </span>
                                </label>
                                <label class="form-label brochure-field" data-brochure-digital-only>
                                    <span>Additional introduction heading</span>
                                    <input asp-for="Input.IntroductionTitle" class="form-control" maxlength="120" placeholder="Simulator Development Division" data-brochure-preflight-trigger />
                                </label>
                                <label class="form-label brochure-field brochure-field--wide" data-brochure-digital-only>
                                    <span>Additional introduction (optional)</span>
                                    <textarea asp-for="Input.IntroductionText" class="form-control" rows="5" maxlength="3000" placeholder="Optional supplementary introduction..." data-brochure-preflight-trigger></textarea>
                                    <small>Digital profile only. This follows the dedicated About SDD page and continues automatically when required.</small>
                                </label>
                            </div>
                        </details>

                        <details class="brochure-print-content">
                            <summary><i class="bi bi-file-text" aria-hidden="true"></i> Institutional content</summary>
                            <div class="brochure-print-content-note">
                                <span>
                                    <strong>One authoritative institutional source serves both publication profiles.</strong>
                                    <span>Print / Compact packs this content into its reference-format front/final pages; Digital / Comfortable creates dedicated About SDD and Future capability &amp; engagement pages.</span>
                                </span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-print-restore-approved>
                                    <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                                    Restore approved text
                                </button>
                            </div>
                            <div class="brochure-print-content-grid">
                                <label class="form-label brochure-field brochure-field--wide">
                                    <span>Centre of Expertise statement</span>
                                    <textarea asp-for="Input.PrintCentreStatement" class="form-control" rows="2" maxlength="1200" data-brochure-print-matter data-print-word-limit="@BrochurePrintPublicationPolicy.CentreStatementMaximumWords"></textarea>
                                    <small class="brochure-print-word-status"><span data-print-word-count>0</span> / @BrochurePrintPublicationPolicy.CentreStatementMaximumWords words</small>
                                </label>
                                <label class="form-label brochure-field brochure-field--wide">
                                    <span>Role of simulators / opening narrative</span>
                                    <textarea asp-for="Input.PrintIntroText" class="form-control" rows="6" maxlength="5000" data-brochure-print-matter data-print-word-limit="@BrochurePrintPublicationPolicy.OpeningNarrativeMaximumWords"></textarea>
                                    <small class="brochure-print-word-status"><span data-print-word-count>0</span> / @BrochurePrintPublicationPolicy.OpeningNarrativeMaximumWords words</small>
                                </label>
                                <label class="form-label brochure-field brochure-field--wide">
                                    <span>Technology and future-readiness narrative</span>
                                    <textarea asp-for="Input.PrintFutureText" class="form-control" rows="4" maxlength="3500" data-brochure-print-matter data-print-word-limit="@BrochurePrintPublicationPolicy.FutureNarrativeMaximumWords"></textarea>
                                    <small class="brochure-print-word-status"><span data-print-word-count>0</span> / @BrochurePrintPublicationPolicy.FutureNarrativeMaximumWords words</small>
                                </label>
                                <label class="form-label brochure-field brochure-field--wide">
                                    <span>Procurement guidance</span>
                                    <textarea asp-for="Input.PrintProcurementText" class="form-control" rows="4" maxlength="3500" data-brochure-print-matter data-print-word-limit="@BrochurePrintPublicationPolicy.ProcurementMaximumWords"></textarea>
                                    <small class="brochure-print-word-status"><span data-print-word-count>0</span> / @BrochurePrintPublicationPolicy.ProcurementMaximumWords words</small>
                                </label>
                                <label class="form-label brochure-field">
                                    <span>Developing Agency / contact details</span>
                                    <textarea asp-for="Input.PrintDevelopingAgencyText" class="form-control" rows="6" maxlength="1800" data-brochure-print-matter data-print-word-limit="@BrochurePrintPublicationPolicy.DevelopingAgencyMaximumWords"></textarea>
                                    <small class="brochure-print-word-status"><span data-print-word-count>0</span> / @BrochurePrintPublicationPolicy.DevelopingAgencyMaximumWords words</small>
                                </label>
                                <label class="form-label brochure-field">
                                    <span>Manufacturing Agency details</span>
                                    <textarea asp-for="Input.PrintManufacturingAgencyText" class="form-control" rows="6" maxlength="1200" data-brochure-print-matter data-print-word-limit="@BrochurePrintPublicationPolicy.ManufacturingAgencyMaximumWords"></textarea>
                                    <small class="brochure-print-word-status"><span data-print-word-count>0</span> / @BrochurePrintPublicationPolicy.ManufacturingAgencyMaximumWords words</small>
                                </label>
                                <label class="form-label brochure-field brochure-field--wide">
                                    <span>Visionary Horizons &amp; Strategic Objectives</span>
                                    <textarea asp-for="Input.PrintVisionaryText" class="form-control" rows="6" maxlength="4500" data-brochure-print-matter data-print-word-limit="@BrochurePrintPublicationPolicy.VisionaryMaximumWords"></textarea>
                                    <small class="brochure-print-word-status"><span data-print-word-count>0</span> / @BrochurePrintPublicationPolicy.VisionaryMaximumWords words</small>
                                </label>
                                <label class="form-label brochure-field brochure-field--wide">
                                    <span>New Simulators guidance</span>
                                    <textarea asp-for="Input.PrintNewSimulatorsText" class="form-control" rows="3" maxlength="1800" data-brochure-print-matter data-print-word-limit="@BrochurePrintPublicationPolicy.NewSimulatorsMaximumWords"></textarea>
                                    <small class="brochure-print-word-status"><span data-print-word-count>0</span> / @BrochurePrintPublicationPolicy.NewSimulatorsMaximumWords words</small>
                                </label>
                            </div>
                        </details>
                    </div>
                </section>

                <section class="publication-panel brochure-project-selector">
                    <header class="publication-panel__header publication-panel__header--actions">
                        <div>
                            <span class="publication-step">2</span>
                            <div>
                                <h2>Select projects</h2>
                                <p><strong data-brochure-match-count>@Model.Projects.Count</strong> matching · <strong data-brochure-selected-inline>0</strong> selected</p>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary brochure-select-visible" data-brochure-select-visible>
                            <i class="bi bi-check2-square" aria-hidden="true"></i>
                            <span data-brochure-select-visible-label>Select @Model.Projects.Count matching</span>
                        </button>
                    </header>
                    <div class="publication-panel__body publication-panel__body--projects">
                        <div class="brochure-filter-toolbar">
                            <label class="brochure-search-field">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <input type="search" class="form-control" placeholder="Search projects..." aria-label="Search projects" data-brochure-search />
                            </label>
                            <select class="form-select" data-brochure-filter="lifecycle" aria-label="Filter by lifecycle">
                                <option value="">All lifecycle</option>
                                <option value="ongoing">Ongoing</option>
                                <option value="completed">Completed</option>
                            </select>
                            <select class="form-select" data-brochure-filter="category" aria-label="Filter by project category">
                                <option value="">All project categories</option>
                                @foreach (var category in Model.ProjectCategories)
                                {
                                    <option value="@category.ToLowerInvariant()">@category</option>
                                }
                            </select>
                            <select class="form-select" data-brochure-filter="technical" aria-label="Filter by technical category">
                                <option value="">All technical categories</option>
                                @foreach (var category in Model.TechnicalCategories)
                                {
                                    <option value="@category.ToLowerInvariant()">@category</option>
                                }
                            </select>
                            <select class="form-select" data-brochure-filter="readiness" aria-label="Filter by publication readiness">
                                <option value="">All readiness</option>
                                <option value="ready">Brochure ready</option>
                                <option value="missing-copy">Missing selected narrative</option>
                                <option value="missing-photo">Missing photograph</option>
                            </select>
                            <label class="brochure-selected-only">
                                <input type="checkbox" class="form-check-input" data-brochure-selected-only />
                                <span>Selected only</span>
                            </label>
                        </div>

                        <div class="brochure-project-table-wrap" data-brochure-project-table-wrap>
                            <table class="table brochure-project-table">
                                <thead>
                                    <tr>
                                        <th class="brochure-select-cell"><span class="visually-hidden">Select</span></th>
                                        <th>Project</th>
                                        <th>Publication copy</th>
                                        <th>Photography</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var project in Model.Projects)
                                {
                                    var selected = selectedIds.Contains(project.ProjectId);
                                    var defaultPhoto = project.Photos.FirstOrDefault(photo => photo.PhotoId == project.DefaultPrimaryPhotoId);
                                    var defaultPhotoUrl = defaultPhoto is null
                                        ? null
                                        : Url.Page("/Projects/Publications/Brochure/Index", "Photo", new
                                        {
                                            projectId = project.ProjectId,
                                            photoId = defaultPhoto.PhotoId,
                                            mode = "thumb",
                                            v = defaultPhoto.Version
                                        });
                                    <tr data-brochure-project-row
                                        data-project-id="@project.ProjectId"
                                        data-project-name="@project.ProjectName"
                                        data-lifecycle="@project.Lifecycle.ToLowerInvariant()"
                                        data-category="@(project.ProjectCategory?.ToLowerInvariant() ?? string.Empty)"
                                        data-technical="@(project.TechnicalCategory?.ToLowerInvariant() ?? string.Empty)"
                                        data-has-photo="@(project.HasPhoto ? "true" : "false")">
                                        <td class="brochure-select-cell">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   value="@project.ProjectId"
                                                   checked="@selected"
                                                   data-brochure-project-checkbox
                                                   aria-label="Select @project.ProjectName" />
                                        </td>
                                        <td>
                                            <div class="brochure-project-name">@project.ProjectName</div>
                                            <div class="brochure-project-meta">
                                                <span>@project.Lifecycle</span>
                                                @if (!string.IsNullOrWhiteSpace(project.TechnicalCategory))
                                                {
                                                    <span>@project.TechnicalCategory</span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <div class="brochure-copy-status" data-brochure-narrative-status>
                                                <i class="bi bi-circle" aria-hidden="true"></i>
                                                <span data-brochure-narrative-label>Project Brief</span>
                                            </div>
                                            <small class="brochure-word-count" data-brochure-word-count></small>
                                        </td>
                                        <td>
                                            <div class="brochure-photo-summary">
                                                @if (!string.IsNullOrWhiteSpace(defaultPhotoUrl))
                                                {
                                                    <span class="brochure-photo-thumb">
                                                        <img src="@defaultPhotoUrl" alt="" loading="lazy" data-brochure-photo-thumb />
                                                        <i class="bi bi-image" aria-hidden="true"></i>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="brochure-photo-placeholder"><i class="bi bi-image" aria-hidden="true"></i></span>
                                                }
                                                <span>
                                                    <strong>@project.Photos.Count photo@(project.Photos.Count == 1 ? string.Empty : "s")</strong>
                                                    <small>@(project.HasPhoto ? "quality checked when selected" : "no photo recorded")</small>
                                                </span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                            <div class="brochure-empty-filter" hidden data-brochure-empty-filter>
                                <i class="bi bi-funnel" aria-hidden="true"></i>
                                <strong>No projects match these filters.</strong>
                                <span>Adjust the search or readiness filters.</span>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="publication-panel brochure-review-panel" data-brochure-review-panel>
                    <header class="publication-panel__header publication-panel__header--actions">
                        <div>
                            <span class="publication-step">3</span>
                            <div>
                                <h2>Review publication</h2>
                                <p><strong data-review-reviewed-count>0</strong> of <strong data-review-total-count>0</strong> approved · Preview follows technical preflight; final download requires publication approval.</p>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-review-next-unreviewed disabled>
                            Review next
                        </button>
                    </header>
                    <div class="publication-panel__body brochure-review-body">
                        <div class="brochure-review-empty" data-review-empty>
                            <i class="bi bi-eye" aria-hidden="true"></i>
                            <strong>Select projects to begin publication review.</strong>
                            <span>Review uses the authoritative selected narrative and the exact brochure image choice.</span>
                        </div>
                        <div class="brochure-review-notice" hidden data-review-notice role="status" aria-live="polite">
                            <i class="bi bi-info-circle" aria-hidden="true"></i>
                            <span data-review-notice-text></span>
                        </div>
                        <div class="brochure-review-workspace" hidden data-review-workspace>
                            <nav class="brochure-review-nav" aria-label="Selected projects for publication review" data-review-nav></nav>
                            <article class="brochure-review-card">
                                <div class="brochure-review-card__header">
                                    <div>
                                        <span data-review-position>Project 1 of 1</span>
                                        <h3 data-review-project-name></h3>
                                        <small data-review-project-meta></small>
                                    </div>
                                    <span class="brochure-review-state" data-review-state>Approval required</span>
                                </div>
                                <div class="brochure-review-card__content">
                                    <div class="brochure-review-image">
                                        <div class="brochure-review-image__frame" data-review-image-frame>
                                            <i class="bi bi-image" aria-hidden="true"></i>
                                        </div>
                                        <div class="brochure-review-image__meta" data-review-image-meta></div>
                                        <label class="brochure-review-image-mode">
                                            <span>Image treatment</span>
                                            <select class="form-select form-select-sm" data-review-image-mode>
                                                <option value="@((int)BrochureImageMode.Automatic)">Automatic</option>
                                                <option value="@((int)BrochureImageMode.Single)">1 image</option>
                                                <option value="@((int)BrochureImageMode.GalleryTwo)">Gallery 2</option>
                                            </select>
                                            <small data-review-image-mode-help>Automatic keeps one image unless a second image has been explicitly selected.</small>
                                        </label>
                                        <div class="brochure-review-action-group">
                                            <span>Publication image</span>
                                            <div class="brochure-review-image__actions">
                                                <button type="button" class="btn btn-sm btn-outline-secondary" data-review-change-image>Change image</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" data-review-adjust-crop>Adjust crop</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="brochure-review-copy">
                                        <div class="brochure-review-copy__heading">
                                            <strong data-review-narrative-label>Project Brief</strong>
                                            <span data-review-word-count></span>
                                        </div>
                                        <div class="brochure-review-narrative" data-review-narrative>
                                            Loading current publication copy…
                                        </div>
                                        <div class="brochure-review-action-group brochure-review-action-group--source">
                                            <span>Authoritative source</span>
                                            <div class="brochure-review-copy__actions">
                                                <a class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener" data-review-open-brief>Project brief</a>
                                                <a class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener" data-review-manage-photos>Project photos</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <footer class="brochure-review-card__footer">
                                    <div class="brochure-review-navigation">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-review-previous><i class="bi bi-arrow-left" aria-hidden="true"></i> Previous</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-review-next>Next <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-success" data-review-mark-reviewed>
                                        <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                        Approve for publication
                                    </button>
                                </footer>
                            </article>
                        </div>
                    </div>
                </section>

                <section class="publication-panel brochure-preflight-panel">
                    <header class="publication-panel__header publication-panel__header--actions">
                        <div>
                            <span class="publication-step">4</span>
                            <div>
                                <h2>Publication readiness</h2>
                                <p>Authoritative preflight, profile-specific composition and final publication findings.</p>
                            </div>
                        </div>
                        <span class="brochure-preflight-spinner" hidden data-preflight-spinner>
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        </span>
                    </header>
                    <div class="publication-panel__body brochure-preflight-body">
                        <div class="brochure-preflight-grid">
                            <div><span>Selected</span><strong data-preflight-selected>0</strong></div>
                            <div class="is-blocker"><span>Blockers</span><strong data-preflight-blockers>0</strong></div>
                            <div class="is-warning"><span>Warnings</span><strong data-preflight-warnings>0</strong></div>
                            <div><span>Info</span><strong data-preflight-info>0</strong></div>
                        </div>
                        <div class="brochure-print-plan-summary" hidden data-print-plan-summary>
                            <div>
                                <span>Planned pages</span>
                                <strong data-print-estimate-pages>—</strong>
                            </div>
                            <div>
                                <span>Average page fill</span>
                                <strong data-print-estimate-fill>—</strong>
                            </div>
                            <div>
                                <span>Lowest page fill</span>
                                <strong data-print-lowest-fill>—</strong>
                            </div>
                            <div>
                                <span>Final page fill</span>
                                <strong data-print-final-fill>—</strong>
                            </div>
                            <div class="brochure-print-plan-summary__closing">
                                <span>Final page composition</span>
                                <strong data-print-estimate-closing>—</strong>
                            </div>
                            <div class="brochure-print-sheet-map" data-print-sheet-map></div>
                            <div class="brochure-smart-flow" hidden data-smart-flow>
                                <div class="brochure-smart-flow__header">
                                    <span class="brochure-smart-flow__icon"><i class="bi bi-stars" aria-hidden="true"></i></span>
                                    <div>
                                        <strong data-smart-flow-title>Smart Flow opportunity</strong>
                                        <p data-smart-flow-summary></p>
                                    </div>
                                </div>
                                <div class="brochure-smart-flow__metrics">
                                    <div><span>Pages</span><strong data-smart-flow-pages>—</strong></div>
                                    <div><span>Lowest page fill</span><strong data-smart-flow-fill>—</strong></div>
                                    <div><span>Order changes</span><strong data-smart-flow-moves>—</strong></div>
                                </div>
                                <div class="brochure-smart-flow__treatment" data-smart-flow-treatment></div>
                                <div class="brochure-smart-flow__suggested-map" data-smart-flow-sheet-map></div>
                                <div class="brochure-smart-flow__moves" data-smart-flow-move-list></div>
                                <div class="brochure-smart-flow__actions">
                                    <button type="button" class="btn btn-sm btn-primary" data-smart-flow-apply>
                                        <i class="bi bi-magic" aria-hidden="true"></i>
                                        Apply suggested order
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" hidden data-smart-flow-undo>
                                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                                        Undo order change
                                    </button>
                                </div>
                                <small data-smart-flow-note>PRISM does not reorder projects automatically. Apply the suggestion to change publication sequence; project content and image treatment remain unchanged.</small>
                            </div>
                            <small>Layout is measured using final PDF geometry and verified again after composition.</small>
                        </div>
                        <div class="brochure-digital-plan-summary" hidden data-digital-plan-summary>
                            <div><span>Planned pages</span><strong data-digital-estimate-pages>—</strong></div>
                            <div><span>Project pages</span><strong data-digital-project-pages>—</strong></div>
                            <div><span>Feature pages</span><strong data-digital-feature-pages>—</strong></div>
                            <div><span>Two-project pages</span><strong data-digital-paired-pages>—</strong></div>
                            <div><span>Editorial pages</span><strong data-digital-editorial-pages>—</strong></div>
                            <div class="brochure-digital-page-map" data-digital-page-map></div>
                            <small>Screen-first composition limits project density to one or two projects per page and is physically verified after PDF generation.</small>
                        </div>
                        <div class="brochure-preflight-message" data-preflight-message>
                            Select projects to run publication preflight.
                        </div>
                        <div class="brochure-preflight-findings-heading">
                            <div>
                                <strong>Findings</strong>
                                <span>Resolve blockers before preview. Review warnings before final issue.</span>
                            </div>
                        </div>
                        <div class="brochure-preflight-issues" data-preflight-issues></div>
                        <button type="button" class="brochure-preflight-show-all" hidden data-preflight-show-all>Show all findings</button>
                    </div>
                </section>

                @if (!Model.FontStatus.DmSansAvailable)
                {
                    <section class="publication-panel brochure-font-panel brochure-font-panel--warning">
                        <div class="publication-panel__body">
                            <div class="brochure-font-status is-fallback">
                                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                                <span>
                                    <strong>Publication font fallback active</strong>
                                    <small>Lato is being used. Add the approved DM Sans static TTF package and restart PRISM.</small>
                                </span>
                            </div>
                        </div>
                    </section>
                }
            </main>

            <aside class="brochure-sidebar" aria-label="Publication controls">
                <section class="publication-panel brochure-selection-panel">
                    <header class="publication-panel__header publication-panel__header--compact">
                        <div>
                            <div>
                                <h2>Publication order</h2>
                                <p><strong data-brochure-selected-count>0</strong> selected · drag to reorder</p>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-link" data-brochure-clear disabled>Clear selection</button>
                    </header>
                    <div class="publication-panel__body brochure-selection-body">
                        <div class="brochure-selected-empty" data-brochure-selected-empty>
                            <i class="bi bi-journals" aria-hidden="true"></i>
                            <span>Select projects from the portfolio.</span>
                        </div>
                        <ol class="brochure-selected-list" data-brochure-selected-list></ol>
                    </div>
                </section>

                <section class="publication-panel brochure-output-panel">
                    <header class="publication-panel__header publication-panel__header--compact">
                        <div>
                            <div>
                                <h2>Final output</h2>
                                <p>Preview at any technically valid stage; download after publication approval.</p>
                            </div>
                        </div>
                    </header>
                    <div class="publication-panel__body brochure-output-body">
                        <div class="brochure-output-readiness is-pending" data-output-readiness>
                            <span class="brochure-output-readiness__icon" data-output-readiness-icon>
                                <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                            </span>
                            <span>
                                <strong data-output-readiness-title>Not ready</strong>
                                <small data-output-readiness-detail>Select projects to begin.</small>
                            </span>
                        </div>
                        <div class="brochure-output-verification" hidden data-output-verification>
                            <i class="bi bi-patch-check-fill" aria-hidden="true"></i>
                            <span data-output-verification-text>PDF verified</span>
                        </div>
                <div class="brochure-generate-actions">
                    <button type="submit"
                            class="btn btn-outline-primary brochure-preview-button"
                            formaction="@previewUrl"
                            data-brochure-preview
                            disabled>
                        <i class="bi bi-eye" aria-hidden="true"></i>
                        Preview PDF
                    </button>
                    <button type="submit" class="btn btn-primary brochure-generate-button" data-brochure-generate disabled>
                        <span class="spinner-border spinner-border-sm d-none" aria-hidden="true" data-brochure-generate-spinner></span>
                        <i class="bi bi-file-earmark-arrow-down" aria-hidden="true" data-brochure-generate-icon></i>
                        <span data-brochure-generate-label>Download brochure PDF</span>
                    </button>
                    <div class="brochure-export-status" role="status" aria-live="polite" data-brochure-export-status></div>
                </div>
                    </div>
                </section>
            </aside>
        </div>

        <div class="brochure-photo-editor"
             hidden
             data-brochure-photo-editor
             role="dialog"
             aria-modal="true"
             aria-labelledby="brochure-photo-editor-title">
            <button type="button"
                    class="brochure-photo-editor__backdrop"
                    data-photo-editor-dismiss
                    tabindex="-1"
                    aria-label="Close photograph setup"></button>
            <section class="publication-panel brochure-photo-editor-panel">
                    <header class="publication-panel__header publication-panel__header--compact">
                        <div>
                            <div>
                                <p class="publication-panel__kicker">PROJECT IMAGERY</p>
                                <h2 id="brochure-photo-editor-title" data-photo-editor-title>Photograph setup</h2>
                                <p class="brochure-photo-editor-project" data-photo-editor-project-name></p>
                            </div>
                        </div>
                        <button type="button" class="brochure-icon-button" data-photo-editor-close title="Close imagery editor" aria-label="Close imagery editor">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    </header>
                    <div class="publication-panel__body">
                        <label class="brochure-image-mode-field">
                            <span>Image treatment</span>
                            <select class="form-select form-select-sm" data-photo-image-mode>
                                <option value="@((int)BrochureImageMode.Automatic)">Automatic</option>
                                <option value="@((int)BrochureImageMode.Single)">Single image</option>
                                <option value="@((int)BrochureImageMode.GalleryTwo)">Gallery 2</option>
                            </select>
                            <small>Automatic uses a second image only when you explicitly select one and the page layout has room.</small>
                        </label>

                        <div class="brochure-photo-editor-section">
                            <div class="brochure-photo-editor-heading">
                                <strong>Primary photograph</strong>
                                <span>Used on project pages. Cover B imagery is selected independently.</span>
                            </div>
                            <div class="brochure-photo-picker" data-primary-photo-picker></div>
                            <div class="brochure-focal-stage" data-primary-focal-stage hidden>
                                <img alt="Primary brochure focal-point source" data-primary-focal-image />
                                <span class="brochure-focal-crop-frame" data-primary-crop-frame aria-hidden="true"></span>
                                <span class="brochure-focal-marker" data-primary-focal-marker aria-hidden="true"></span>
                                <button type="button" class="brochure-focal-reset" data-primary-focal-reset>Reset</button>
                            </div>
                            <small class="brochure-focal-help">Click the source image to set the focal point. The outlined frame is the 16:9 publication crop.</small>
                        </div>

                        <div class="brochure-photo-editor-section" data-secondary-photo-section>
                            <div class="brochure-photo-editor-heading">
                                <strong>Second photograph</strong>
                                <span>Optional in Automatic; required for Gallery 2.</span>
                            </div>
                            <div class="brochure-photo-picker" data-secondary-photo-picker></div>
                            <div class="brochure-focal-stage" data-secondary-focal-stage hidden>
                                <img alt="Second brochure focal-point source" data-secondary-focal-image />
                                <span class="brochure-focal-crop-frame" data-secondary-crop-frame aria-hidden="true"></span>
                                <span class="brochure-focal-marker" data-secondary-focal-marker aria-hidden="true"></span>
                                <button type="button" class="brochure-focal-reset" data-secondary-focal-reset>Reset</button>
                            </div>
                        </div>
                    </div>
                <footer class="brochure-photo-editor__footer">
                    <div>
                        <strong>Publication image editor</strong>
                        <span>Image or crop changes reset this project's publication approval.</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-primary" data-photo-editor-close>
                        <i class="bi bi-check2" aria-hidden="true"></i>
                        Done
                    </button>
                </footer>
            </section>
        </div>

    </form>

    @if (Model.CanManageSavedBrochures)
    {
        <div class="modal fade" id="brochurePresetSaveModal" tabindex="-1" aria-labelledby="brochurePresetSaveModalTitle" aria-hidden="true" data-preset-save-modal>
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content brochure-preset-modal">
                    <div class="modal-header">
                        <div>
                            <h2 class="modal-title fs-6" id="brochurePresetSaveModalTitle">Save shared brochure</h2>
                            <p>Creates a reusable institutional configuration available to all authorised Publications users.</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">
                            <span>Name</span>
                            <input type="text" class="form-control" maxlength="120" data-preset-save-name />
                        </label>
                        <label class="form-label">
                            <span>Description <small>optional</small></span>
                            <textarea class="form-control" rows="3" maxlength="500" data-preset-save-description></textarea>
                        </label>
                        <div class="brochure-preset-modal__message" hidden data-preset-save-message></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-sm btn-primary" data-preset-save-confirm>Save shared brochure</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="brochurePresetRenameModal" tabindex="-1" aria-labelledby="brochurePresetRenameModalTitle" aria-hidden="true" data-preset-rename-modal>
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content brochure-preset-modal">
                    <div class="modal-header">
                        <div>
                            <h2 class="modal-title fs-6" id="brochurePresetRenameModalTitle">Rename shared brochure</h2>
                            <p>The configuration and project order are unchanged.</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">
                            <span>Name</span>
                            <input type="text" class="form-control" maxlength="120" data-preset-rename-name />
                        </label>
                        <div class="brochure-preset-modal__message" hidden data-preset-rename-message></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-sm btn-primary" data-preset-rename-confirm>Rename</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="brochurePresetDuplicateModal" tabindex="-1" aria-labelledby="brochurePresetDuplicateModalTitle" aria-hidden="true" data-preset-duplicate-modal>
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content brochure-preset-modal">
                    <div class="modal-header">
                        <div>
                            <h2 class="modal-title fs-6" id="brochurePresetDuplicateModalTitle">Duplicate saved brochure</h2>
                            <p>Copies the stored shared version. Current unsaved working changes are not included.</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">
                            <span>New name</span>
                            <input type="text" class="form-control" maxlength="120" data-preset-duplicate-name />
                        </label>
                        <label class="form-label">
                            <span>Description <small>optional</small></span>
                            <textarea class="form-control" rows="3" maxlength="500" data-preset-duplicate-description></textarea>
                        </label>
                        <div class="brochure-preset-modal__message" hidden data-preset-duplicate-message></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-sm btn-primary" data-preset-duplicate-confirm>Duplicate</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="brochurePresetManageModal" tabindex="-1" aria-labelledby="brochurePresetManageModalTitle" aria-hidden="true" data-preset-manage-modal>
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content brochure-preset-modal">
                    <div class="modal-header">
                        <div>
                            <h2 class="modal-title fs-6" id="brochurePresetManageModalTitle">Manage saved brochures</h2>
                            <p>Shared institutional configurations available to all authorised Publications users.</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="brochure-preset-manage-list" data-preset-manage-list>
                            @foreach (var preset in Model.SavedBrochures)
                            {
                                <article data-preset-manage-row data-preset-id="@preset.Id">
                                    <div>
                                        <strong>@preset.Name</strong>
                                        <span>@preset.ProjectCount project@(preset.ProjectCount == 1 ? string.Empty : "s") · @preset.PublicationProfile</span>
                                        <small>Updated @preset.UpdatedAtUtc.ToString("dd MMM yyyy") · @preset.UpdatedByDisplay</small>
                                    </div>
                                    <div>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-preset-row-load>Load</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-preset-row-rename>Rename</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-preset-row-duplicate>Duplicate</button>
                                        <button type="button" class="btn btn-sm btn-link text-danger" data-preset-row-delete>Delete</button>
                                    </div>
                                </article>
                            }
                            @if (Model.SavedBrochures.Count == 0)
                            {
                                <div class="brochure-preset-manage-empty" data-preset-manage-empty>No shared brochures have been saved yet.</div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-sm btn-primary" data-preset-manage-create>Save current brochure as new</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="brochurePresetConflictModal" tabindex="-1" aria-labelledby="brochurePresetConflictModalTitle" aria-hidden="true" data-preset-conflict-modal>
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content brochure-preset-modal">
                    <div class="modal-header">
                        <div>
                            <h2 class="modal-title fs-6" id="brochurePresetConflictModalTitle">Saved brochure has changed</h2>
                            <p data-preset-conflict-message>This shared brochure was updated by another user after you loaded it.</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body brochure-preset-conflict-actions">
                        <button type="button" class="btn btn-outline-secondary" data-preset-conflict-reload>Reload current version</button>
                        <button type="button" class="btn btn-primary" data-preset-conflict-save-as-new>Save my version as new</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pages/projects-brochure.js" asp-append-version="true"></script>
}
