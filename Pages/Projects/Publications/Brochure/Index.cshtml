@page "/Projects/Publications/Brochure"
@model ProjectManagement.Pages.Projects.Publications.Brochure.IndexModel
@using ProjectManagement.Services.Publications
@{
    ViewData["Title"] = "Capability Brochure";
    var selectedIds = Model.Input.ProjectIds.ToHashSet();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/projects-publications.css" asp-append-version="true" />
}

<div class="publications-page brochure-builder">
    <nav class="publications-breadcrumb" aria-label="Breadcrumb">
        <a asp-page="/Projects/Index">Projects</a>
        <span aria-hidden="true">/</span>
        <a asp-page="/Projects/Publications/Index">Publications</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Brochure</span>
    </nav>

    <header class="publications-header publications-header--builder">
        <div>
            <p class="publications-eyebrow">CAPABILITY PUBLICATION</p>
            <h1>Brochure Builder</h1>
            <p>Compose a publication-quality A4 brochure from selected PRISM projects. The source project records remain authoritative.</p>
        </div>
        <div class="brochure-header-badge">
            <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
            <span>QuestPDF · offline generation</span>
        </div>
    </header>

    <partial name="/Pages/Projects/Publications/_PublicationTabs.cshtml" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger brochure-validation" role="alert"></div>
    <span asp-validation-for="Input.ProjectIds" class="text-danger small"></span>

    <form method="post" asp-page-handler="Generate" class="brochure-form" data-brochure-form>
        <div class="brochure-layout">
            <main class="brochure-main">
                <section class="publication-panel">
                    <header class="publication-panel__header">
                        <div>
                            <span class="publication-step">1</span>
                            <div>
                                <h2>Publication settings</h2>
                                <p>Choose the brochure copy source and cover treatment. Project Brief is the recommended default.</p>
                            </div>
                        </div>
                    </header>
                    <div class="publication-panel__body">
                        <div class="brochure-form-grid">
                            <label class="form-label brochure-field brochure-field--wide">
                                <span>Brochure title</span>
                                <input asp-for="Input.Title" class="form-control" maxlength="120" />
                                <span asp-validation-for="Input.Title" class="text-danger small"></span>
                            </label>
                            <label class="form-label brochure-field">
                                <span>Subtitle</span>
                                <input asp-for="Input.Subtitle" class="form-control" maxlength="160" />
                                <span asp-validation-for="Input.Subtitle" class="text-danger small"></span>
                            </label>
                            <label class="form-label brochure-field">
                                <span>Edition</span>
                                <input asp-for="Input.Edition" class="form-control" maxlength="80" />
                                <span asp-validation-for="Input.Edition" class="text-danger small"></span>
                            </label>
                            <label class="form-label brochure-field brochure-field--wide">
                                <span>Cover strapline</span>
                                <input asp-for="Input.Strapline" class="form-control" maxlength="180" />
                                <span asp-validation-for="Input.Strapline" class="text-danger small"></span>
                            </label>
                            <label class="form-label brochure-field">
                                <span>Project narrative source</span>
                                <select asp-for="Input.NarrativeSource" class="form-select" data-brochure-narrative-source>
                                    <option value="@BrochureNarrativeSource.ProjectBrief">Project Brief — recommended</option>
                                    <option value="@BrochureNarrativeSource.CapabilityOverview">Capability Overview</option>
                                    <option value="@BrochureNarrativeSource.FullDescription">Full Description</option>
                                </select>
                                <small>One source is used consistently for every selected project. Sources are never merged automatically.</small>
                            </label>
                            <label class="form-label brochure-field">
                                <span>Handling/classification marking</span>
                                <input asp-for="Input.HandlingMarking" class="form-control" maxlength="80" placeholder="Optional, e.g. RESTRICTED" />
                                <small>Enter only when authorised and applicable. PRISM does not assign a marking automatically.</small>
                            </label>
                        </div>

                        <fieldset class="brochure-cover-fieldset">
                            <legend>Cover style</legend>
                            <div class="brochure-cover-options">
                                <label class="brochure-cover-option @(Model.Input.CoverStyle == BrochureCoverStyle.Institutional ? "is-selected" : string.Empty)" data-cover-option>
                                    <input type="radio" asp-for="Input.CoverStyle" value="@BrochureCoverStyle.Institutional" />
                                    <span class="brochure-cover-preview brochure-cover-preview--institutional" aria-hidden="true">
                                        <span class="brochure-cover-preview__mark"></span>
                                        <span class="brochure-cover-preview__title"></span>
                                        <span class="brochure-cover-preview__montage"><i></i><i></i><i></i></span>
                                    </span>
                                    <span class="brochure-cover-option__copy">
                                        <strong>A · Institutional / Evolutionary</strong>
                                        <small>Retains the green institutional character and visual DNA of the present brochure.</small>
                                    </span>
                                </label>
                                <label class="brochure-cover-option @(Model.Input.CoverStyle == BrochureCoverStyle.Contemporary ? "is-selected" : string.Empty)" data-cover-option>
                                    <input type="radio" asp-for="Input.CoverStyle" value="@BrochureCoverStyle.Contemporary" />
                                    <span class="brochure-cover-preview brochure-cover-preview--contemporary" aria-hidden="true">
                                        <span class="brochure-cover-preview__mark"></span>
                                        <span class="brochure-cover-preview__title"></span>
                                        <span class="brochure-cover-preview__hero"></span>
                                    </span>
                                    <span class="brochure-cover-option__copy">
                                        <strong>B · Contemporary / Premium</strong>
                                        <small>Cleaner editorial cover with stronger typography and a dominant project photograph.</small>
                                    </span>
                                </label>
                            </div>
                        </fieldset>

                        <details class="brochure-intro-options" open="@(!string.IsNullOrWhiteSpace(Model.Input.IntroductionText))">
                            <summary><i class="bi bi-file-text" aria-hidden="true"></i> Optional introduction page</summary>
                            <div class="brochure-form-grid brochure-form-grid--intro">
                                <label class="form-label brochure-field">
                                    <span>Introduction title</span>
                                    <input asp-for="Input.IntroductionTitle" class="form-control" maxlength="120" placeholder="Simulator Development Division" />
                                </label>
                                <label class="form-label brochure-field brochure-field--wide">
                                    <span>Introduction text</span>
                                    <textarea asp-for="Input.IntroductionText" class="form-control" rows="6" maxlength="3000" placeholder="Leave blank to omit the introduction page."></textarea>
                                    <small>PRISM prints this text as entered; it does not generate or rewrite institutional narrative.</small>
                                </label>
                            </div>
                        </details>
                    </div>
                </section>

                <section class="publication-panel">
                    <header class="publication-panel__header">
                        <div>
                            <span class="publication-step">2</span>
                            <div>
                                <h2>Select projects</h2>
                                <p>Select the projects to publish. Drag selected projects in the right-hand tray to set their publication order.</p>
                            </div>
                        </div>
                        <div class="publication-panel__header-count"><strong>@Model.Projects.Count</strong> available</div>
                    </header>

                    <div class="publication-panel__body publication-panel__body--projects">
                        <div class="brochure-project-filters">
                            <label class="brochure-project-search">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <input type="search" class="form-control" placeholder="Search project name" autocomplete="off" data-brochure-project-search />
                            </label>
                            <select class="form-select" aria-label="Lifecycle" data-brochure-filter="lifecycle">
                                <option value="">All lifecycle states</option>
                                <option value="ongoing">Ongoing</option>
                                <option value="completed">Completed</option>
                            </select>
                            <select class="form-select" aria-label="Project category" data-brochure-filter="category">
                                <option value="">All project categories</option>
                                @foreach (var category in Model.ProjectCategories)
                                {
                                    <option value="@category.ToLowerInvariant()">@category</option>
                                }
                            </select>
                            <select class="form-select" aria-label="Technical category" data-brochure-filter="technical">
                                <option value="">All technical categories</option>
                                @foreach (var category in Model.TechnicalCategories)
                                {
                                    <option value="@category.ToLowerInvariant()">@category</option>
                                }
                            </select>
                            <button type="button" class="btn btn-outline-secondary" data-brochure-select-visible>Select visible</button>
                        </div>

                        <div class="brochure-project-list" role="list" data-brochure-project-list>
                            @foreach (var project in Model.Projects)
                            {
                                var isSelected = selectedIds.Contains(project.ProjectId);
                                <article class="brochure-project-row"
                                         role="listitem"
                                         data-project-row
                                         data-project-id="@project.ProjectId"
                                         data-project-name="@project.ProjectName"
                                         data-lifecycle="@project.Lifecycle.ToLowerInvariant()"
                                         data-category="@(project.ProjectCategory?.ToLowerInvariant() ?? string.Empty)"
                                         data-technical="@(project.TechnicalCategory?.ToLowerInvariant() ?? string.Empty)"
                                         data-has-project-brief="@project.HasProjectBrief.ToString().ToLowerInvariant()"
                                         data-has-capability-overview="@project.HasCapabilityOverview.ToString().ToLowerInvariant()"
                                         data-has-full-description="@project.HasFullDescription.ToString().ToLowerInvariant()"
                                         data-project-brief-words="@project.ProjectBriefWordCount"
                                         data-capability-overview-words="@project.CapabilityOverviewWordCount"
                                         data-full-description-words="@project.FullDescriptionWordCount"
                                         data-has-photo="@project.HasPhoto.ToString().ToLowerInvariant()"
                                         data-has-print-photo="@project.HasPrintReadyPhoto.ToString().ToLowerInvariant()">
                                    <label class="brochure-project-row__select">
                                        <input type="checkbox" value="@project.ProjectId" data-brochure-project-checkbox checked="@isSelected" />
                                        <span class="visually-hidden">Select @project.ProjectName</span>
                                    </label>
                                    <div class="brochure-project-row__main">
                                        <strong>@project.ProjectName</strong>
                                        <span>
                                            @project.Lifecycle
                                            @if (!string.IsNullOrWhiteSpace(project.ProjectCategory)) { <text> · @project.ProjectCategory</text> }
                                            @if (!string.IsNullOrWhiteSpace(project.TechnicalCategory)) { <text> · @project.TechnicalCategory</text> }
                                        </span>
                                    </div>
                                    <div class="brochure-project-row__readiness" aria-label="Publication readiness">
                                        <span class="@(project.HasProjectBrief ? "is-ready" : "is-missing")" title="Project Brief" data-brochure-narrative-status><i class="bi bi-file-text"></i></span>
                                        <span class="@(project.HasPhoto ? "is-ready" : "is-missing")" title="Project photograph"><i class="bi bi-image"></i></span>
                                        @if (project.HasPhoto && !project.HasPrintReadyPhoto)
                                        {
                                            <span class="is-warning" title="Only low-resolution photographs are recorded"><i class="bi bi-exclamation-triangle"></i></span>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                        <div class="brochure-project-empty" hidden data-brochure-project-empty>No projects match the current filters.</div>
                    </div>
                </section>
            </main>

            <aside class="brochure-sidebar">
                <section class="brochure-selection-card">
                    <header>
                        <div>
                            <span>SELECTED PROJECTS</span>
                            <strong data-brochure-selected-count>@selectedIds.Count</strong>
                        </div>
                        <button type="button" class="btn btn-link" data-brochure-clear-selection disabled="@(selectedIds.Count == 0)">Clear</button>
                    </header>
                    <p>Drag to reorder. The first project with a usable photograph becomes the primary image on Cover B.</p>
                    <ol class="brochure-selected-list" data-brochure-selected-list></ol>
                    <div class="brochure-selected-empty" data-brochure-selected-empty hidden="@(selectedIds.Count > 0)">
                        <i class="bi bi-check2-square" aria-hidden="true"></i>
                        <span>Select projects from the list.</span>
                    </div>
                    <div data-brochure-hidden-inputs>
                        @foreach (var id in Model.Input.ProjectIds)
                        {
                            <input type="hidden" name="Input.ProjectIds" value="@id" />
                        }
                    </div>
                </section>

                <section class="brochure-preflight-card">
                    <header>
                        <span>PUBLICATION PREFLIGHT</span>
                        <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                    </header>
                    <div class="brochure-preflight-metrics">
                        <div><span>Selected</span><strong data-preflight-selected>0</strong></div>
                        <div><span>Missing copy</span><strong data-preflight-narrative>0</strong></div>
                        <div><span>No photo</span><strong data-preflight-photo>0</strong></div>
                        <div><span>Low-res only</span><strong data-preflight-lowres>0</strong></div>
                        <div><span>Long copy</span><strong data-preflight-longcopy>0</strong></div>
                    </div>
                    <p data-preflight-message>Select projects to run brochure preflight.</p>
                </section>

                <section class="brochure-font-card @(Model.FontStatus.DmSansAvailable ? "is-ready" : "is-warning")">
                    <div class="brochure-font-card__icon"><i class="bi bi-fonts" aria-hidden="true"></i></div>
                    <div>
                        <strong>@(Model.FontStatus.DmSansAvailable ? "DM Sans publication fonts ready" : "DM Sans font package not yet installed")</strong>
                        @if (Model.FontStatus.DmSansAvailable)
                        {
                            <span>PDFs use PRISM's local DM Sans files. No network font request is required.</span>
                        }
                        else
                        {
                            <span>The brochure remains functional using Lato. Add the local static DM Sans files under <code>wwwroot/fonts/publications/dm-sans</code> for the intended premium typography.</span>
                        }
                    </div>
                </section>

                <button type="submit" class="btn btn-primary brochure-generate-button" data-brochure-generate disabled="@(selectedIds.Count == 0)">
                    <span class="spinner-border spinner-border-sm d-none" aria-hidden="true" data-brochure-spinner></span>
                    <i class="bi bi-file-earmark-pdf" aria-hidden="true" data-brochure-generate-icon></i>
                    <span data-brochure-generate-label>Generate brochure PDF</span>
                </button>
                <small class="brochure-generate-note">Generation uses live project data and does not modify any project record.</small>
            </aside>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pages/projects-brochure.js" asp-append-version="true"></script>
}
