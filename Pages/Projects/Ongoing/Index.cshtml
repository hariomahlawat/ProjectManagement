@page
@using System.Text.RegularExpressions
@using ProjectManagement.Models.Execution
@using ProjectManagement.Models.Stages
@using ProjectManagement.Models.Remarks
@model ProjectManagement.Pages.Projects.Ongoing.IndexModel
@{
    ViewData["Title"] = "Ongoing projects";
    ViewData["UseFullWidth"] = true;
    ViewData["PageShell"] = "analytics";

    // SECTION: View state
    var isTableView = string.Equals(Model.View, "table", StringComparison.OrdinalIgnoreCase);

    // SECTION: Inline remark defaults
    var remarkType = RemarkType.External.ToString();
    var actorRole = Model.CanInlineEditExternalRemarks
        ? RemarkActorRole.HeadOfDepartment.ToString()
        : RemarkActorRole.ProjectOfficer.ToString();

    // turn <span class="remark-mention">…</span> into a small pill
    string RenderRemark(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return string.Empty;
        }

        const string pattern = "<span class=\"remark-mention\"[^>]*>(.*?)</span>";

        var replaced = Regex.Replace(
            text,
            pattern,
            m => $"<span class=\"badge remark-pill\">{m.Groups[1].Value}</span>");

        return replaced;
    }

    // SECTION: Table helpers
    string FormatValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? "N/A" : value;

    string StageNodeLabel(string code)
        => string.Equals(code, "PAYMENT", StringComparison.OrdinalIgnoreCase) ? "₹" : code;

    // SECTION: Update age helper
    // Updates older than this are marked so a stale status shows without opening the project.
    const int staleUpdateDays = 30;
    var nowUtc = DateTime.UtcNow;

    (string Label, bool IsStale) UpdateAge(DateTime createdAtUtc)
    {
        var days = Math.Max(0, (int)(nowUtc - DateTime.SpecifyKind(createdAtUtc, DateTimeKind.Utc)).TotalDays);
        var months = Math.Max(1, (int)Math.Round(days / 30.4));
        var years = Math.Max(1, (int)Math.Round(days / 365.25));
        var label = days switch
        {
            0 => "today",
            1 => "yesterday",
            < 31 => $"{days} days ago",
            < 365 => months == 1 ? "1 month ago" : $"{months} months ago",
            _ => years == 1 ? "1 year ago" : $"{years} years ago"
        };
        return (label, days > staleUpdateDays);
    }

}

<!-- SECTION: Ongoing projects top area: two rows, multi-select chips -->
@{
    var stageChips = new[]
    {
        (Key: "approval", Label: "Approval", Codes: "FS, IPA, SOW", Count: Model.BucketApvlCount),
        (Key: "aon", Label: "AoN", Codes: "AON", Count: Model.BucketAonCount),
        (Key: "procurement", Label: "Tender", Codes: "BID, TEC, BM, COB, PNC, EAS, SO", Count: Model.BucketProcCount),
        (Key: "development", Label: "Development", Codes: "DEVP, ATP, PAYMENT, TOT", Count: Model.BucketDevpCount)
    };
}
<form id="ongoingProjectsFilterForm"
      method="get"
      class="ongoing-head"
      aria-labelledby="ongoing-head-title"
      novalidate>
    <input type="hidden" asp-for="View" />
    @if (isTableView)
    {
        <input type="hidden" asp-for="StageFlow" />
    }
    @foreach (var bucket in Model.SelectedStageBuckets)
    {
        <input type="hidden" name="Stage" value="@bucket" />
    }
    @foreach (var categoryId in Model.SelectedCategoryIds)
    {
        <input type="hidden" name="Category" value="@categoryId" />
    }

    <!-- SECTION: Row 1 - title, stage and category chips -->
    <div class="ongoing-head__row">
        <div class="ongoing-head__identity">
            <h1 id="ongoing-head-title" class="ongoing-head__title">Ongoing projects</h1>
            <p class="ongoing-head__count" aria-live="polite">
                <span>
                    <strong>@Model.FilteredTotal</strong>
                    @if (Model.HasFilters)
                    {
                        @:of @Model.AllProjectsCount
                    }
                    project@(Model.FilteredTotal == 1 && !Model.HasFilters ? "" : "s")
                </span>
                @if (Model.HasFilters)
                {
                    <span aria-hidden="true">·</span>
                    <a asp-page="./Index"
                       asp-route-View="@Model.View"
                       asp-route-StageFlow="@Model.StageFlow"
                       class="ongoing-head__clear">Clear all</a>
                }
                @if (Model.BucketUnknownCount > 0)
                {
                    <span aria-hidden="true">·</span>
                    <span title="Projects whose current stage code is not recognised">@Model.BucketUnknownCount unknown stage</span>
                }
            </p>
        </div>

        <div class="ongoing-head__stages" role="group" aria-label="Stage (select one or more)">
            @foreach (var chip in stageChips)
            {
                var isOn = Model.SelectedStageBuckets.Contains(chip.Key);
                <button type="button"
                        class="ongoing-head__seg js-stage-bucket-chip @(isOn ? "is-active" : null) @(chip.Count == 0 ? "is-empty" : null)"
                        data-stage-bucket="@chip.Key"
                        style="--grow:@Math.Max(chip.Count, 3)"
                        title="@chip.Label: @chip.Codes"
                        aria-pressed="@(isOn ? "true" : "false")">
                    @if (isOn)
                    {
                        <span class="ongoing-head__tick" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                    }
                    <span>@chip.Label</span>
                    <strong>@chip.Count</strong>
                </button>
            }
        </div>

        <div class="ongoing-head__categories" role="group" aria-label="Category (select one or more)">
            @foreach (var chip in Model.CategoryChips)
            {
                var isOn = chip.IsSelected;
                <button type="button"
                        class="ongoing-head__chip js-kpi-chip @(isOn ? "is-active" : null) @(chip.Count == 0 ? "is-empty" : null)"
                        data-category-id="@chip.Id"
                        title="@chip.FullName"
                        aria-pressed="@(isOn ? "true" : "false")">
                    @if (isOn)
                    {
                        <span class="ongoing-head__tick" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                    }
                    <span>@chip.Label</span>
                    <strong>@chip.Count</strong>
                </button>
            }
        </div>
    </div>

    <!-- SECTION: Row 2 - search, officer, exact stage, view and actions -->
    <div class="ongoing-head__row ongoing-head__row--tools">
        <input asp-for="Search"
               type="search"
               class="form-control form-control-sm ongoing-head__search"
               placeholder="Search project name"
               aria-label="Search by project name"
               autocomplete="off" />
        <select asp-for="ProjectOfficerId"
                asp-items="Model.ProjectOfficerOptions"
                class="form-select form-select-sm ongoing-head__select"
                aria-label="Project officer"></select>
        <select asp-for="PresentStageCode"
                asp-items="Model.PresentStageOptions"
                class="form-select form-select-sm ongoing-head__select"
                aria-label="Exact stage"></select>
        @if (Model.HasSubCategories)
        {
            <select asp-for="SubCategory"
                    asp-items="Model.SubCategoryOptions"
                    class="form-select form-select-sm ongoing-head__select"
                    aria-label="Sub-category"></select>
        }

        <span class="ongoing-head__divider" aria-hidden="true"></span>

        <div class="segmented" role="group" aria-label="View">
            <a href="@Model.FilterUrl(view: "timeline")"
               class="segmented__item @(isTableView ? string.Empty : "is-active")"
               aria-current="@(isTableView ? null : "page")">Timeline</a>
            <a href="@Model.FilterUrl(view: "table")"
               class="segmented__item @(isTableView ? "is-active" : string.Empty)"
               aria-current="@(isTableView ? "page" : null)">Table</a>
        </div>
        @if (!isTableView)
        {
            <select asp-for="StageFlow"
                    class="form-select form-select-sm ongoing-head__order"
                    aria-label="Order"
                    data-stage-flow-select>
                <option value="reverse">Later stages first</option>
                <option value="forward">Earlier stages first</option>
            </select>
        }
        <a href="@Model.FilterUrl(handler: "Export")" class="btn btn-sm btn-outline-primary ongoing-head__export">
            <i class="bi bi-download" aria-hidden="true"></i> Export
        </a>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <p class="text-muted">No ongoing projects matched the selected filters.</p>
}
else
{
    <!-- SECTION: Timeline view -->
    <section class="row g-3" @(isTableView ? "hidden" : string.Empty)>
        @foreach (var item in Model.Items)
        {
            // SECTION: Identify current stage index using the present snapshot first
            var currentIdx = -1;
            if (!string.IsNullOrWhiteSpace(item.PresentStage.CurrentStageCode))
            {
                currentIdx = item.Stages
                    .Select((stage, idx) => new { stage, idx })
                    .FirstOrDefault(x => string.Equals(
                        x.stage.Code,
                        item.PresentStage.CurrentStageCode,
                        StringComparison.OrdinalIgnoreCase))?.idx ?? -1;
            }

            if (currentIdx == -1)
            {
                for (var i = 0; i < item.Stages.Count; i++)
                {
                    if (item.Stages[i].IsCurrent)
                    {
                        currentIdx = i;
                        break;
                    }
                }
            }

            if (currentIdx == -1)
            {
                currentIdx = 0;
            }

            <div class="col-12">
                <article class="ongoing-card card border-0 shadow-sm h-100">
                    <div class="card-body p-0">
                        @{
                            // SECTION: Timeline helper values
                            var today = DateOnly.FromDateTime(ProjectManagement.Infrastructure.IstClock.ToIst(DateTime.UtcNow));
                            var cur = item.Stages[currentIdx];
                            var presentStage = item.PresentStage;

                            // SECTION: Days to PDC / overdue
                            int? daysToPdc = null;
                            bool isOverdue = false;
                            if (cur.PlannedDue.HasValue)
                            {
                                daysToPdc = (cur.PlannedDue.Value.ToDateTime(TimeOnly.MinValue) -
                                today.ToDateTime(TimeOnly.MinValue)).Days;
                                if (daysToPdc < 0)
                                {
                                    isOverdue = true;
                                    daysToPdc = Math.Abs(daysToPdc.Value);
                                }
                            }
                        }

                        <!-- SECTION: Timeline card header -->
                        <header class="ongoing-card__header">
                            <!-- SECTION: Header thumbnail -->
                            <div class="ongoing-card__thumb" aria-hidden="true">
                                @if (item.CoverPhotoId.HasValue)
                                {
                                    <img src="@Url.Page("/Projects/Photos/View", new { id = item.ProjectId, photoId = item.CoverPhotoId.Value, size = "sm", v = item.CoverPhotoVersion })"
                                         loading="lazy"
                                         alt=""
                                         class="ongoing-card__thumb-img" />
                                }
                                else
                                {
                                    <div class="ongoing-card__thumb-placeholder" aria-hidden="true">
                                        <i class="bi bi-image" aria-hidden="true"></i>
                                    </div>
                                }
                            </div>

                            <!-- SECTION: Header main content -->
                            <div class="ongoing-card__main">
                                <h2 class="ongoing-card__title mb-1">
                                    <a asp-page="/Projects/Overview"
                                       asp-route-id="@item.ProjectId"
                                       class="text-decoration-none">
                                        @item.ProjectName
                                    </a>
                                </h2>
                                <p class="ongoing-card__meta mb-1">
                                    <span>@FormatValue(item.ProjectCategoryName)</span>
                                    <span class="ongoing-card__meta-divider">•</span>
                                    <span>@(string.IsNullOrWhiteSpace(item.LeadPoName) ? "Project Officer not assigned" : item.LeadPoName)</span>
                                    <span class="ongoing-card__meta-divider">•</span>
                                    <span>Cost: @item.CostLakhsText</span>
                                </p>
                                <div class="ongoing-card__stage-summary">
                                    <p class="mb-0">
                                        <span class="ongoing-card__current-label">Current stage</span>
                                        @if (cur.Status == StageStatus.Completed)
                                        {
                                            <span class="ongoing-card__current-value">@cur.Name</span>
                                            @if (cur.ActualCompletedOn.HasValue)
                                            {
                                                @: (@cur.ActualCompletedOn.Value.ToString("dd-MMM-yyyy"))
                                            }
                                            else
                                            {
                                                <span class="text-muted">date not recorded</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="ongoing-card__current-value">@cur.Name</span>
                                            @if (cur.PlannedDue.HasValue)
                                            {
                                                @: (PDC: @cur.PlannedDue.Value.ToString("dd-MMM-yyyy"))
                                            }
                                        }

                                        <!-- SECTION: Stage age -->
                                        <span class="ms-2 text-muted ongoing-card__stage-chip">
                                            @if (presentStage.DaysSinceStartOrLastCompletion.HasValue)
                                            {
                                                var daysInCurrent = presentStage.DaysSinceStartOrLastCompletion.Value;
                                                @: • @daysInCurrent day@(daysInCurrent == 1 ? "" : "s") in this stage
                                            }
                                        </span>

                                        @if (cur.Status != StageStatus.Completed)
                                        {
                                            if (cur.PlannedDue.HasValue)
                                            {
                                                if (!isOverdue)
                                                {
                                                    <span class="ms-2 text-success ongoing-card__stage-chip">
                                                        @daysToPdc day@(daysToPdc == 1 ? "" : "s") to PDC
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="ms-2 oc-pill oc-pill--danger">
                                                        overdue by @daysToPdc day@(daysToPdc == 1 ? "" : "s")
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="ms-2 oc-pill oc-pill--neutral">
                                                    PDC not set
                                                </span>
                                            }
                                        }

                                        @if (item.IsCurrentStageProlonged)
                                        {
                                            <span class="ms-2 oc-pill oc-pill--warning">
                                                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                                                @(string.Equals(cur.Code, StageCodes.DEVP, StringComparison.OrdinalIgnoreCase)
                                                    ? "Development prolonged (6 months+)"
                                                    : "Stage prolonged")
                                            </span>
                                        }
                                    </p>
                                </div>
                            </div>

                            <!-- SECTION: Header right meta -->
                            <div class="ongoing-card__right">
                                <p class="ongoing-card__lc-label mb-0">Last completed</p>
                                <p class="ongoing-card__last mb-0">
                                    @if (!string.IsNullOrEmpty(item.LastCompletedStageName))
                                    {
                                        <span class="ongoing-card__lc-value">@item.LastCompletedStageName</span>
                                        if (item.LastCompletedStageDate.HasValue)
                                        {
                                            @: (@item.LastCompletedStageDate.Value.ToString("dd-MMM-yy"))
                                        }
                                        else
                                        {
                                            <span class="text-muted">date not recorded</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">None</span>
                                    }
                                </p>
                            </div>
                        </header>


                        <!-- SECTION: Complete lifecycle timeline -->
                        <section class="briefing-timeline" aria-label="Project lifecycle timeline">
                            @{
                                var priorStagesMissingCompletion = item.Stages
                                    .Take(Math.Max(currentIdx, 0))
                                    .Count(stage => stage.Status is not StageStatus.Completed and not StageStatus.Skipped);
                            }
                            @if (priorStagesMissingCompletion > 0)
                            {
                                <div class="briefing-timeline__alerts" aria-label="Timeline attention items">
                                    <span class="briefing-timeline__alert briefing-timeline__alert--neutral">
                                        <i class="bi bi-calendar-x" aria-hidden="true"></i>
                                        @priorStagesMissingCompletion earlier @(priorStagesMissingCompletion == 1 ? "stage has" : "stages have") no completion date
                                    </span>
                                </div>
                            }
                            <div class="briefing-timeline__rail" role="list" data-auto-focus-current="true">
                                @{
                                    // Skipped stages are left off the rail; the current stage always stays.
                                    var railStages = item.Stages
                                        .Select((stage, index) => (Stage: stage, Index: index))
                                        .Where(entry => entry.Stage.Status != StageStatus.Skipped || entry.Index == currentIdx)
                                        .ToList();
                                }
                                @for (var position = 0; position < railStages.Count; position++)
                                {
                                    var (stage, i) = railStages[position];
                                    var isCurrent = i == currentIdx;
                                    var isCompleted = stage.Status == StageStatus.Completed;
                                    var isSkipped = stage.Status == StageStatus.Skipped;
                                    var isPastMissing = i < currentIdx && !isCompleted && !isSkipped;
                                    var isFuture = i > currentIdx;
                                    var historicalDuration = stage.ActualDurationDays;
                                    var stageStateClass = isCompleted
                                        ? "is-complete"
                                        : isSkipped
                                            ? "is-skipped"
                                            : isPastMissing
                                                ? "is-past-missing"
                                                : isCurrent
                                                    ? "is-current"
                                                    : "is-future";
                                    var isCurrentProlonged = isCurrent && item.IsCurrentStageProlonged;

                                    <div class="briefing-stage @stageStateClass @(isCurrentProlonged ? "is-prolonged" : string.Empty)"
                                         role="listitem"
                                         data-current-stage="@(isCurrent ? "true" : "false")">
                                        <div class="briefing-stage__node" title="@stage.Name">@StageNodeLabel(stage.Code)</div>
                                        <div class="briefing-stage__detail">
                                            <span class="briefing-stage__name" title="@stage.Name">@stage.Name</span>
                                            @if (isSkipped)
                                            {
                                                <span class="briefing-stage__date briefing-stage__date--skipped">Skipped</span>
                                            }
                                            else if (isCompleted)
                                            {
                                                <span class="briefing-stage__date">@(stage.ActualCompletedOn?.ToString("dd MMM yyyy") ?? "Date not recorded")</span>
                                            }
                                            else if (isPastMissing)
                                            {
                                                <span class="briefing-stage__date briefing-stage__date--attention">Completion date not recorded</span>
                                            }
                                            else if (isCurrent)
                                            {
                                                <span class="briefing-stage__date">
                                                    @if (presentStage.DaysSinceStartOrLastCompletion.HasValue)
                                                    {
                                                        @($"{presentStage.DaysSinceStartOrLastCompletion.Value} days in stage")
                                                    }
                                                    else
                                                    {
                                                        @("Stage age not recorded")
                                                    }
                                                </span>
                                                <span class="briefing-stage__pdc">@(stage.PlannedDue.HasValue ? $"PDC {stage.PlannedDue.Value:dd MMM yyyy}" : "PDC not set")</span>
                                            }
                                        </div>
                                    </div>

                                    @if (position < railStages.Count - 1)
                                    {
                                        <div class="briefing-connector">
                                            <span class="briefing-connector__line" aria-hidden="true"></span>
                                            @if (isCompleted && historicalDuration.HasValue)
                                            {
                                                <span class="briefing-duration briefing-duration--normal"
                                                      title="@stage.Name took @historicalDuration.Value day@(historicalDuration.Value == 1 ? "" : "s")">@historicalDuration.Value d</span>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </section>

                        <!-- SECTION: Remarks -->
                        <section class="ongoing-remarks border-top"
                                 data-remarks-panel
                                 data-expanded="0">
                            @{
                                // SECTION: Remarks preview settings
                                const int collapsedInternalCount = 2;
                                var internalRemarksCollapsed = item.RecentInternalRemarks.Take(collapsedInternalCount).ToList();
                                var internalRemarksExpandedOnly = item.RecentInternalRemarks.Skip(collapsedInternalCount).ToList();
                                var hasExpandableInternalRemarks = internalRemarksExpandedOnly.Count > 0;
                                var latestExternalRemark = item.LatestExternalRemark;
                            }

                            <!-- SECTION: Remarks panel heading and toggle -->
                            <div class="ongoing-remarks__header">
                                <div class="ongoing-remarks__title-wrap">
                                    <span class="ongoing-remarks__title">Internal updates</span>
                                    
                                </div>
                                @if (hasExpandableInternalRemarks)
                                {
                                    <button type="button"
                                            class="ongoing-remarks__toggle btn btn-sm btn-link p-0 text-decoration-none"
                                            data-remarks-toggle
                                            aria-expanded="false">
                                        <span data-remarks-toggle-label>View earlier updates</span>
                                        <span class="ongoing-remarks__toggle-chevron" data-remarks-toggle-chevron aria-hidden="true">▾</span>
                                    </button>
                                }
                            </div>

                            <!-- SECTION: Remarks two-column summary -->
                            <div class="ongoing-remarks__summary">
                                <!-- SECTION: Internal remarks (70%) -->
                                <div class="ongoing-remarks__column ongoing-remarks__column--internal">
                                    @if (item.RecentInternalRemarks.Count == 0)
                                    {
                                        <p class="small text-muted mb-0">No internal update recorded.</p>
                                    }
                                    else
                                    {
                                        <ul class="ongoing-remarks__list">
                                            @foreach (var r in internalRemarksCollapsed)
                                            {
                                                <li class="ongoing-remarks__item">
                                                    <div class="ongoing-remarks__body ongoing-remarks__body--collapsed">
                                                        @Html.Raw(RenderRemark(r.Text))
                                                    </div>
                                                    <div class="ongoing-remarks__meta">
                                                        <span class="ongoing-remarks__author">@r.AuthorDisplayName</span>
                                                        <span class="ongoing-remarks__meta-sep">·</span>
                                                        <span>@r.CreatedAtUtc.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</span>
                                                        @{ var internalAge = UpdateAge(r.CreatedAtUtc); }
                                                        <span class="ongoing-remarks__meta-sep">·</span>
                                                        <span class="ongoing-remarks__age @(internalAge.IsStale ? "is-stale" : null)">@internalAge.Label</span>
                                                    </div>
                                                </li>
                                            }
                                        </ul>

                                        @if (hasExpandableInternalRemarks)
                                        {
                                            <ul class="ongoing-remarks__list ongoing-remarks__list--expanded" data-remarks-expanded-list hidden>
                                                @foreach (var r in internalRemarksExpandedOnly)
                                                {
                                                    <li class="ongoing-remarks__item">
                                                        <div class="ongoing-remarks__body">
                                                            @Html.Raw(RenderRemark(r.Text))
                                                        </div>
                                                        <div class="ongoing-remarks__meta">
                                                            <span class="ongoing-remarks__author">@r.AuthorDisplayName</span>
                                                            <span class="ongoing-remarks__meta-sep">·</span>
                                                            <span>@r.CreatedAtUtc.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</span>
                                                            @{ var olderAge = UpdateAge(r.CreatedAtUtc); }
                                                            <span class="ongoing-remarks__meta-sep">·</span>
                                                            <span class="ongoing-remarks__age @(olderAge.IsStale ? "is-stale" : null)">@olderAge.Label</span>
                                                        </div>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    }
                                </div>

                                <!-- SECTION: External status · Higher HQ (30%) -->
                                <div class="ongoing-remarks__column ongoing-remarks__column--external">
                                    <h3 class="ongoing-remarks__column-title">External status · Higher HQ</h3>
                                    @if (string.IsNullOrWhiteSpace(latestExternalRemark?.Body))
                                    {
                                        <p class="small text-muted mb-0">No external status recorded.</p>
                                    }
                                    else
                                    {
                                        var externalRemark = latestExternalRemark!;
                                        var externalRemarkBody = externalRemark.Body ?? string.Empty;
                                        <article class="ongoing-remarks__item">
                                            <div class="ongoing-remarks__body ongoing-remarks__body--collapsed">
                                                @Html.Raw(RenderRemark(externalRemarkBody))
                                            </div>
                                            <div class="ongoing-remarks__meta">
                                                <span class="ongoing-remarks__author">@externalRemark.AuthorDisplayName</span>
                                                <span class="ongoing-remarks__meta-sep">·</span>
                                                <span>@externalRemark.CreatedAtUtc.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</span>
                                                <span class="ongoing-remarks__meta-sep">·</span>
                                                <span>Event: @externalRemark.EventDate.ToString("dd-MMM-yyyy")</span>
                                                @{ var externalAge = UpdateAge(externalRemark.CreatedAtUtc); }
                                                <span class="ongoing-remarks__meta-sep">·</span>
                                                <span class="ongoing-remarks__age @(externalAge.IsStale ? "is-stale" : null)">@externalAge.Label</span>
                                            </div>
                                        </article>
                                    }
                                </div>
                            </div>
                        </section>
                    </div>
                </article>
            </div>
        }
    </section>

    <!-- SECTION: Table view -->
    <section @(isTableView ? string.Empty : "hidden")>
        @{
            // SECTION: Preserve service-provided operational order in table view
            var tableRows = Model.Items;
        }

        <!-- SECTION: Table inline remark metadata -->
        <div id="oprTableRoot"
             data-today-ist="@Model.TodayIstIso"
             data-can-edit="@(Model.CanInlineEditExternalRemarks ? "1" : "0")">
            @if (Model.CanInlineEditExternalRemarks)
            {
                <div id="oprInlineRemarkToken" class="d-none">
                    @Html.AntiForgeryToken()
                </div>
            }
        </div>

        <div class="pm-card-table shadow-sm border-0">
            <div class="pm-table-wrap table-responsive ongoing-table-wrap">
                <table class="table pm-table pm-table-sm align-middle mb-0 ongoing-table">
                    <colgroup>
                        <col class="col-project" />
                        <col class="col-stage" />
                        <col class="col-age" />
                        <col class="col-pdc" />
                        <col class="col-internal" />
                        <col class="col-remarks" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="col-project">Project</th>
                            <th class="col-stage">Current stage</th>
                            <th class="col-age">Stage age</th>
                            <th class="col-pdc">PDC</th>
                            <th class="col-internal">Internal update</th>
                            <th class="col-remarks">External status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in tableRows)
                        {
                            // SECTION: External status · Higher HQ metadata
                            var latestExternal = row.LatestExternalRemark;
                            var remarkBody = latestExternal?.Body ?? string.Empty;
                            var remarkEventDate = latestExternal?.EventDate.ToString("yyyy-MM-dd") ?? Model.TodayIstIso;
                            var remarkScope = latestExternal?.Scope.ToString() ?? RemarkScope.General.ToString();
                            var remarkRowVersion = latestExternal?.RowVersion ?? string.Empty;
                            var remarkId = latestExternal?.Id ?? 0;
                            var hasRemarkBody = !string.IsNullOrWhiteSpace(remarkBody);

                            <tr>
                                <td class="col-project">
                                    <!-- SECTION: Project name cell (thumbnail + link) -->
                                    <div class="projcell">
                                        @if (row.CoverPhotoId.HasValue)
                                        {
                                            <img class="projcell__thumb"
                                                 src="@Url.Page("/Projects/Photos/View", new { id = row.ProjectId, photoId = row.CoverPhotoId.Value, size = "xs", v = row.CoverPhotoVersion })"
                                                 alt=""
                                                 loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="projcell__thumb projcell__thumb--placeholder" aria-hidden="true">
                                                <span class="bi bi-image" aria-hidden="true"></span>
                                            </div>
                                        }
                                        <div class="projcell__text">
                                            <a asp-page="/Projects/Overview"
                                               asp-route-id="@row.ProjectId"
                                               class="project-link text-decoration-none fw-semibold">
                                                @row.ProjectName
                                            </a>
                                            <span class="ongoing-table__secondary">
                                                @(string.IsNullOrWhiteSpace(row.LeadPoName) ? "Project Officer not assigned" : row.LeadPoName)
                                                <span aria-hidden="true"> · </span>
                                                @FormatValue(row.ProjectCategoryName)
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td class="col-stage">
                                    <strong>@FormatValue(row.PresentStage.CurrentStageName)</strong>
                                    @if (!string.IsNullOrWhiteSpace(row.LastCompletedStageName))
                                    {
                                        <span class="ongoing-table__secondary">Last: @row.LastCompletedStageName</span>
                                    }
                                </td>
                                <td class="col-age">
                                    @if (row.DaysInCurrentStage.HasValue)
                                    {
                                        var stageAgeClass = row.IsCurrentStageProlonged
                                            ? "is-danger"
                                            : row.IsCurrentStageApproachingProlonged
                                                ? "is-warning"
                                                : string.Empty;
                                        var stageAgeTitle = row.IsCurrentStageProlonged
                                            ? string.Equals(row.CurrentStageCode, StageCodes.DEVP, StringComparison.OrdinalIgnoreCase)
                                                ? "Development stage has reached six months"
                                                : "Current stage has reached 90 days"
                                            : row.IsCurrentStageApproachingProlonged
                                                ? "Current stage is approaching its prolonged threshold"
                                                : null;
                                        <span class="stage-age @stageAgeClass" title="@stageAgeTitle">@row.DaysInCurrentStage d</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not recorded</span>
                                    }
                                </td>
                                <td class="col-pdc">@(row.PresentStagePdc.HasValue ? row.PresentStagePdc.Value.ToString("dd MMM yyyy") : "Not set")</td>
                                <td class="col-internal">
                                    @if (row.RecentInternalRemarks.Count > 0)
                                    {
                                        var latestInternal = row.RecentInternalRemarks[0];
                                        <div class="pm-remark-text">@Html.Raw(RenderRemark(latestInternal.Text))</div>
                                        <span class="ongoing-table__secondary">@latestInternal.AuthorDisplayName · @latestInternal.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No update</span>
                                    }
                                </td>
                                <td class="col-remarks js-ongoing-remark-cell"
                                    data-project-id="@row.ProjectId"
                                    data-remark-id="@remarkId"
                                    data-row-version="@remarkRowVersion"
                                    data-event-date="@remarkEventDate"
                                    data-scope="@remarkScope"
                                    data-type="@remarkType"
                                    data-actor-role="@actorRole"
                                    data-remark-body="@remarkBody"
                                    data-current-text="@remarkBody"
                                    data-empty-text="N/A"
                                    data-can-edit="@(Model.CanInlineEditExternalRemarks ? "1" : "0")">
                                    @if (Model.CanInlineEditExternalRemarks)
                                    {
                                        <div class="pm-remark-text @(hasRemarkBody ? string.Empty : "text-muted fst-italic")"
                                             title="Double-click to edit">
                                            @FormatValue(remarkBody)
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="pm-remark-text @(hasRemarkBody ? string.Empty : "text-muted fst-italic")">
                                            @FormatValue(remarkBody)
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
}

@section Styles {
    <link rel="stylesheet" href="~/css/components/pm-table.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/projects/ongoing-conference.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/projects/ongoing.js"
            asp-append-version="true"
            defer></script>
    <script src="~/js/projects/ongoing-remarks-inline.js"
            asp-append-version="true"
            defer></script>
}
