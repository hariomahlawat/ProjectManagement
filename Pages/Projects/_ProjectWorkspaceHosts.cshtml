@model ProjectManagement.Pages.Projects.OverviewModel
@using ProjectManagement.Models
@using ProjectManagement.Models.Plans
<partial name="Projects/_BackfillModal" model="Model.Backfill" />
<partial name="_StageDirectApplyModal" />
<partial name="Projects/Stages/_StageRequestModal" />

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasProcurement" aria-labelledby="offcanvasProcurementLabel">
    <div class="offcanvas-header">
        <h5 id="offcanvasProcurementLabel" class="mb-0">Edit procurement details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body"><partial name="Projects/Procurement/_EditFormBody" model="Model.ProcurementEdit" /></div>
</div>
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasActualDates" aria-labelledby="offcanvasActualDatesLabel">
    <div class="offcanvas-header">
        <h5 id="offcanvasActualDatesLabel" class="mb-0">Correct recorded dates</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body"><partial name="Projects/Timeline/_EditActualsForm" model="Model.ActualsEditor" /></div>
</div>
@if (Model.CanManageHistoricalStageHistory)
{
    <div class="offcanvas offcanvas-end historical-stage-offcanvas"
         tabindex="-1"
         id="offcanvasHistoricalStages"
         aria-labelledby="offcanvasHistoricalStagesLabel"
         data-bs-backdrop="static">
        <div class="offcanvas-header">
            <div>
                <h5 id="offcanvasHistoricalStagesLabel" class="mb-0">Historical stage data</h5>
                <p class="text-muted small mb-0 mt-1">@Model.Project.Name</p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0">
            <partial name="Projects/Timeline/_HistoricalStageForm" model="Model.HistoricalStageEditor" />
        </div>
    </div>
}
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasPlanReview" aria-labelledby="offcanvasPlanReviewLabel">
    <div class="offcanvas-header">
        <h5 id="offcanvasPlanReviewLabel" class="mb-0">Review current plan</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        @{
            ViewBag.ProjectId = Model.Project.Id;
            ViewBag.HasBackfill = Model.HasBackfill;
            ViewBag.PlanState = Model.PlanEdit?.State ?? new ProjectManagement.ViewModels.PlanEditorStateVm();
            ViewBag.WorkflowVersion = Model.Project.WorkflowVersion;
            var differences = await Model.PlanCompare.GetDraftVsCurrentAsync(Model.Project.Id);
            await Html.RenderPartialAsync("~/Pages/Projects/Timeline/_ReviewPlan.cshtml", differences ?? Array.Empty<ProjectManagement.Services.Stages.PlanDiffRow>());
        }
    </div>
</div>
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasPlanEdit" aria-labelledby="offcanvasPlanEditLabel">
    <div class="offcanvas-header">
        <h5 id="offcanvasPlanEditLabel" class="mb-0">Edit planned dates</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body"><partial name="Projects/Timeline/_EditPlanForm" model="Model.PlanEdit" /></div>
</div>

<div class="offcanvas offcanvas-end project-jdp-offcanvas"
     tabindex="-1"
     id="offcanvasJdp"
     aria-labelledby="offcanvasJdpLabel"
     data-bs-backdrop="static"
     data-bs-keyboard="false">
    <div class="offcanvas-header">
        <div>
            <h5 id="offcanvasJdpLabel" class="mb-0">JDP details</h5>
            <p class="text-muted small mb-0 mt-1">@Model.Project.Name</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <partial name="_ProjectJdpDrawer" model="Model" />
    </div>
</div>

<div class="offcanvas offcanvas-end proliferation-editor"
     tabindex="-1"
     id="offcanvasProliferation"
     aria-labelledby="offcanvasProliferationLabel"
     data-bs-backdrop="static"
     data-bs-keyboard="false">
    <div class="offcanvas-header">
        <div>
            <h5 id="offcanvasProliferationLabel" class="mb-0">@(Model.CanManageProliferation ? "Edit proliferation details" : "Proliferation details")</h5>
            <p class="text-muted small mb-0 mt-1">@Model.Project.Name</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        @if (Model.CanManageProliferation)
        {
            <partial name="_ProjectProliferationEditForm" model="Model" />
        }
        else
        {
            <partial name="_ProjectProliferationReadOnly" model="Model" />
        }
    </div>
</div>

@if (Model.Project.LifecycleStatus == ProjectLifecycleStatus.Completed)
{
    <div class="offcanvas offcanvas-end project-tot-offcanvas"
         tabindex="-1"
         id="offcanvasTot"
         aria-labelledby="offcanvasTotLabel"
         data-bs-backdrop="static"
         data-bs-keyboard="false"
         data-project-id="@Model.Project.Id"
         data-can-manage="@Model.CanManageTot.ToString().ToLowerInvariant()">
        <div class="offcanvas-header">
            <div>
                <h5 id="offcanvasTotLabel" class="mb-0">Transfer of Technology</h5>
                <p class="text-muted small mb-0 mt-1">@Model.Project.Name</p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0">
            <partial name="_ProjectTotDrawer" model="Model" />
        </div>
    </div>
}
