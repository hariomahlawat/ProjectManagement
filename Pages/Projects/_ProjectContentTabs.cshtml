@using System
@using ProjectManagement.Models
@using ProjectManagement.Services.Projects
@model ProjectManagement.Pages.Projects.OverviewModel

@{
    var activeTab = Model.ContentTab ?? "brief";
    var canEdit = Model.CanEditProjectContent;
    var briefIsActive = string.Equals(activeTab, "brief", StringComparison.OrdinalIgnoreCase);
    var capabilitiesAreActive = string.Equals(activeTab, "capabilities", StringComparison.OrdinalIgnoreCase);
    var descriptionIsActive = string.Equals(activeTab, "description", StringComparison.OrdinalIgnoreCase);
    var capabilityEditorCount = Math.Max(1, Model.CapabilityInput.Statements.Count);
    var briefWordLabel = Model.ProjectBriefWordCount == 1 ? "word" : "words";
    var descriptionCharacterCount = Model.ContentDescriptionInput.Description?.Length ?? 0;
    var descriptionWordLabel = Model.DescriptionWordCount == 1 ? "word" : "words";
    var remainingCapabilityCount = Math.Max(
        0,
        ProjectFieldLimits.CapabilityRecommendedMinimumCount - Model.CapabilityStatements.Count);
    var remainingCapabilityLabel = remainingCapabilityCount == 1 ? "statement" : "statements";
    var descriptionPreviewUrl = Url.Page(
        "/Projects/Overview",
        "PreviewProjectDescription",
        new { id = Model.Project.Id });

    var (briefStatusText, briefStatusClass) = Model.BriefReadiness switch
    {
        ProjectBriefReadiness.NotRecorded => ("Not recorded", "is-neutral"),
        ProjectBriefReadiness.NeedsExpansion => ("Needs expansion", "is-warning"),
        ProjectBriefReadiness.Concise => ("Concise", "is-neutral"),
        ProjectBriefReadiness.Recommended => ("Recommended length", "is-ready"),
        ProjectBriefReadiness.AboveRecommended => ("Consider shortening", "is-warning"),
        ProjectBriefReadiness.ExceedsMaximum => ("Maximum exceeded", "is-danger"),
        _ => ("Not recorded", "is-neutral")
    };

    var (capabilityStatusText, capabilityStatusClass) = Model.CapabilityReadiness switch
    {
        ProjectCapabilityReadiness.NotRecorded => ("Not recorded", "is-neutral"),
        ProjectCapabilityReadiness.Draft => ("Draft for briefing", "is-warning"),
        ProjectCapabilityReadiness.PresentationReady => ("Presentation ready", "is-ready"),
        _ => ("Not recorded", "is-neutral")
    };
}

<section class="project-content"
         id="project-content"
         data-project-content
         data-project-id="@Model.Project.Id"
         data-save-timeout-ms="20000">
    <div class="project-content__header">
        <h3 class="h6 mb-0">Project content</h3>
    </div>

    @if (TempData["ProjectContentError"] is string contentError)
    {
        <div class="alert alert-danger alert-dismissible fade show project-content__message"
             role="alert">
            @contentError
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ProjectContentFlash"] is string contentMessage)
    {
        <div class="alert alert-success alert-dismissible fade show project-content__message"
             role="status"
             aria-live="polite"
             data-auto-dismiss="6000">
            @contentMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <ul class="nav nav-tabs project-content__tabs" role="tablist" aria-label="Project content">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(briefIsActive ? "active" : null)"
                    id="content-brief-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#content-brief"
                    type="button"
                    role="tab"
                    aria-controls="content-brief"
                    aria-selected="@(briefIsActive.ToString().ToLowerInvariant())"
                    data-content-tab="brief">
                Project brief
                @if (Model.ProjectBriefWordCount > 0)
                {
                    <span class="project-content__count">@Model.ProjectBriefWordCount @briefWordLabel</span>
                }
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(capabilitiesAreActive ? "active" : null)"
                    id="content-capabilities-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#content-capabilities"
                    type="button"
                    role="tab"
                    aria-controls="content-capabilities"
                    aria-selected="@(capabilitiesAreActive.ToString().ToLowerInvariant())"
                    data-content-tab="capabilities">
                Capability overview
                @if (Model.CapabilityStatements.Count > 0)
                {
                    <span class="project-content__count">@Model.CapabilityStatements.Count</span>
                }
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(descriptionIsActive ? "active" : null)"
                    id="content-description-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#content-description"
                    type="button"
                    role="tab"
                    aria-controls="content-description"
                    aria-selected="@(descriptionIsActive.ToString().ToLowerInvariant())"
                    data-content-tab="description">
                Full description
            </button>
        </li>
    </ul>

    <div class="tab-content project-content__body">
        <div class="tab-pane fade @(briefIsActive ? "show active" : null)"
             id="content-brief"
             role="tabpanel"
             aria-labelledby="content-brief-tab"
             tabindex="0">
            <div class="project-content__view" data-content-view>
                <div class="project-content__toolbar">
                    <div class="project-content__guidance">
                        Recommended: @ProjectFieldLimits.ProjectBriefRecommendedMinimumWords–@ProjectFieldLimits.ProjectBriefRecommendedMaximumWords words.
                        Maximum: @ProjectFieldLimits.ProjectBriefHardMaximumWords words.
                    </div>
                    <div class="project-content__toolbar-actions">
                        <span class="project-content__status @briefStatusClass">@briefStatusText</span>
                        @if (canEdit)
                        {
                            <button class="btn btn-sm btn-outline-primary" type="button" data-content-edit>
                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                Edit brief
                            </button>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.ProjectBriefHtml))
                {
                    <div class="project-content__narrative pm-markdown">@Html.Raw(Model.ProjectBriefHtml)</div>
                }
                else
                {
                    <div class="project-content__empty">
                        <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                        <div>
                            <strong>Project brief not recorded</strong>
                            <span>Add a concise brief for search, reports and briefing decks.</span>
                        </div>
                    </div>
                }
            </div>
            @if (canEdit)
            {
                <form method="post"
                      asp-page-handler="SaveProjectBrief"
                      asp-route-id="@Model.Project.Id"
                      class="project-content__editor d-none"
                      data-content-form
                      data-content-kind="brief">
                    <input asp-for="ContentBriefInput.ProjectId" type="hidden" />
                    <input asp-for="ContentBriefInput.RowVersion" type="hidden" />
                    <label asp-for="ContentBriefInput.Brief" class="form-label fw-semibold">Project brief</label>
                    <textarea asp-for="ContentBriefInput.Brief"
                              class="form-control project-content__textarea"
                              rows="10"
                              maxlength="@ProjectFieldLimits.ProjectBriefMaxLength"
                              data-word-concise-min="@ProjectFieldLimits.ProjectBriefConciseMinimumWords"
                              data-word-min="@ProjectFieldLimits.ProjectBriefRecommendedMinimumWords"
                              data-word-recommended-max="@ProjectFieldLimits.ProjectBriefRecommendedMaximumWords"
                              data-word-hard-max="@ProjectFieldLimits.ProjectBriefHardMaximumWords"
                              data-word-counter
                              aria-describedby="project-brief-editor-meta"></textarea>
                    <div class="project-content__editor-meta" id="project-brief-editor-meta">
                        <span>
                            Recommended: @ProjectFieldLimits.ProjectBriefRecommendedMinimumWords–@ProjectFieldLimits.ProjectBriefRecommendedMaximumWords words.
                            Maximum: @ProjectFieldLimits.ProjectBriefHardMaximumWords words.
                        </span>
                        <span class="project-content__editor-readiness">
                            <span data-word-count>@Model.ProjectBriefWordCount @briefWordLabel</span>
                            <span class="project-content__status @briefStatusClass" data-word-status>@briefStatusText</span>
                        </span>
                    </div>
                    <div class="invalid-feedback d-block d-none" role="alert" aria-live="polite" data-content-error></div>
                    <div class="project-content__actions">
                        <button class="btn btn-sm btn-outline-secondary" type="button" data-content-cancel>Cancel</button>
                        <button class="btn btn-sm btn-primary" type="submit" data-content-save>
                            <span class="spinner-border spinner-border-sm d-none" aria-hidden="true" data-content-spinner></span>
                            <span data-content-save-label>Save brief</span>
                        </button>
                    </div>
                </form>
            }
        </div>

        <div class="tab-pane fade @(capabilitiesAreActive ? "show active" : null)"
             id="content-capabilities"
             role="tabpanel"
             aria-labelledby="content-capabilities-tab"
             tabindex="0">
            <div class="project-content__view" data-content-view>
                <div class="project-content__toolbar">
                    <div class="project-content__guidance">
                        Use @ProjectFieldLimits.CapabilityRecommendedMinimumCount–@ProjectFieldLimits.CapabilityMaximumCount distinct capability statements.
                    </div>
                    <div class="project-content__toolbar-actions">
                        <span class="project-content__status @capabilityStatusClass">@capabilityStatusText</span>
                        @if (canEdit)
                        {
                            <button class="btn btn-sm btn-outline-primary" type="button" data-content-edit>
                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                Edit capabilities
                            </button>
                        }
                    </div>
                </div>
                @if (Model.CapabilityStatements.Count > 0)
                {
                    <ol class="project-content__capabilities">
                        @foreach (var capability in Model.CapabilityStatements)
                        {
                            <li>@capability.Statement</li>
                        }
                    </ol>
                    @if (Model.CapabilityReadiness == ProjectCapabilityReadiness.Draft)
                    {
                        <div class="project-content__advisory">
                            Add @remainingCapabilityCount more distinct capability @remainingCapabilityLabel for a presentation-ready overview.
                        </div>
                    }
                }
                else
                {
                    <div class="project-content__empty">
                        <i class="bi bi-list-check" aria-hidden="true"></i>
                        <div>
                            <strong>Capability overview not recorded</strong>
                            <span>Add ordered statements for PowerPoint and concise capability reporting.</span>
                        </div>
                    </div>
                }
            </div>
            @if (canEdit)
            {
                <form method="post"
                      asp-page-handler="SaveProjectCapabilities"
                      asp-route-id="@Model.Project.Id"
                      class="project-content__editor d-none"
                      data-content-form
                      data-content-kind="capabilities"
                      data-capability-editor
                      data-capability-min="@ProjectFieldLimits.CapabilityRecommendedMinimumCount"
                      data-capability-max="@ProjectFieldLimits.CapabilityMaximumCount">
                    <input asp-for="CapabilityInput.ProjectId" type="hidden" />
                    <input asp-for="CapabilityInput.RowVersion" type="hidden" />
                    <div class="project-content__capability-list" data-capability-list>
                        @for (var index = 0; index < capabilityEditorCount; index++)
                        {
                            var value = index < Model.CapabilityInput.Statements.Count
                                ? Model.CapabilityInput.Statements[index]
                                : string.Empty;
                            <div class="project-content__capability-row" data-capability-row>
                                <span class="project-content__capability-number" data-capability-number>@(index + 1)</span>
                                <input class="form-control"
                                       name="CapabilityInput.Statements"
                                       value="@value"
                                       maxlength="@ProjectFieldLimits.CapabilityStatementMaxLength"
                                       aria-label="Capability statement @(index + 1)" />
                                <div class="btn-group btn-group-sm project-content__row-actions"
                                     role="group"
                                     aria-label="Actions for capability statement @(index + 1)">
                                    <button class="btn btn-outline-secondary" type="button" data-capability-up title="Move up" aria-label="Move capability @(index + 1) up">
                                        <i class="bi bi-arrow-up" aria-hidden="true"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary" type="button" data-capability-down title="Move down" aria-label="Move capability @(index + 1) down">
                                        <i class="bi bi-arrow-down" aria-hidden="true"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" type="button" data-capability-remove title="Remove" aria-label="Remove capability @(index + 1)">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="project-content__capability-controls">
                        <button class="btn btn-sm btn-outline-primary" type="button" data-capability-add>
                            <i class="bi bi-plus-lg" aria-hidden="true"></i>
                            Add capability
                        </button>
                        <span class="project-content__editor-readiness">
                            <span data-capability-count>@Model.CapabilityInput.Statements.Count of @ProjectFieldLimits.CapabilityMaximumCount</span>
                            <span class="project-content__status @capabilityStatusClass" data-capability-status>@capabilityStatusText</span>
                        </span>
                    </div>
                    <template data-capability-template>
                        <div class="project-content__capability-row" data-capability-row>
                            <span class="project-content__capability-number" data-capability-number></span>
                            <input class="form-control"
                                   name="CapabilityInput.Statements"
                                   maxlength="@ProjectFieldLimits.CapabilityStatementMaxLength"
                                   aria-label="Capability statement" />
                            <div class="btn-group btn-group-sm project-content__row-actions"
                                 role="group"
                                 aria-label="Actions for capability statement">
                                <button class="btn btn-outline-secondary" type="button" data-capability-up title="Move up" aria-label="Move capability up">
                                    <i class="bi bi-arrow-up" aria-hidden="true"></i>
                                </button>
                                <button class="btn btn-outline-secondary" type="button" data-capability-down title="Move down" aria-label="Move capability down">
                                    <i class="bi bi-arrow-down" aria-hidden="true"></i>
                                </button>
                                <button class="btn btn-outline-danger" type="button" data-capability-remove title="Remove" aria-label="Remove capability">
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    </template>
                    <div class="invalid-feedback d-block d-none" role="alert" aria-live="polite" data-content-error></div>
                    <div class="project-content__actions">
                        <button class="btn btn-sm btn-outline-secondary" type="button" data-content-cancel>Cancel</button>
                        <button class="btn btn-sm btn-primary" type="submit" data-content-save>
                            <span class="spinner-border spinner-border-sm d-none" aria-hidden="true" data-content-spinner></span>
                            <span data-content-save-label>Save capabilities</span>
                        </button>
                    </div>
                </form>
            }
        </div>

        <div class="tab-pane fade @(descriptionIsActive ? "show active" : null)"
             id="content-description"
             role="tabpanel"
             aria-labelledby="content-description-tab"
             tabindex="0">
            <div class="project-content__view" data-content-view>
                <div class="project-content__toolbar">
                    <div class="project-content__guidance">
                        <span>Markdown supported</span>
                        @if (Model.DescriptionWordCount > 0)
                        {
                            <span aria-hidden="true"> · </span>
                            <span>@Model.DescriptionWordCount @descriptionWordLabel</span>
                        }
                    </div>
                    @if (canEdit)
                    {
                        <button class="btn btn-sm btn-outline-primary" type="button" data-content-edit>
                            <i class="bi bi-pencil-square" aria-hidden="true"></i>
                            Edit description
                        </button>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.DescriptionHtml))
                {
                    <div class="project-content__description @(Model.DescriptionShouldCollapse ? "is-collapsed" : null)"
                         data-description-container>
                        <div class="project-content__narrative pm-markdown">@Html.Raw(Model.DescriptionHtml)</div>
                        @if (Model.DescriptionShouldCollapse)
                        {
                            <div class="project-content__description-fade" aria-hidden="true"></div>
                            <button class="btn btn-sm btn-link project-content__description-toggle"
                                    type="button"
                                    aria-expanded="false"
                                    data-description-toggle>
                                Show full description
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="project-content__empty">
                        <i class="bi bi-card-text" aria-hidden="true"></i>
                        <div>
                            <strong>Full description not recorded</strong>
                            <span>Add the detailed project narrative and key deliverables.</span>
                        </div>
                    </div>
                }
            </div>
            @if (canEdit)
            {
                <form method="post"
                      asp-page-handler="SaveProjectDescription"
                      asp-route-id="@Model.Project.Id"
                      class="project-content__editor d-none"
                      data-content-form
                      data-content-kind="description"
                      data-description-editor
                      data-description-preview-url="@descriptionPreviewUrl">
                    <input asp-for="ContentDescriptionInput.ProjectId" type="hidden" />
                    <input asp-for="ContentDescriptionInput.RowVersion" type="hidden" />
                    <div class="project-content__editor-heading">
                        <label asp-for="ContentDescriptionInput.Description" class="form-label fw-semibold mb-0">Full project description</label>
                        <details class="project-content__markdown-help">
                            <summary>Markdown help</summary>
                            <div class="project-content__markdown-help-body">
                                <span><code>## Heading</code> for a section heading</span>
                                <span><code>- Item</code> for a bullet list</span>
                                <span><code>**text**</code> for emphasis</span>
                                <span>Plain text and normal paragraphs are also valid.</span>
                            </div>
                        </details>
                    </div>
                    <textarea asp-for="ContentDescriptionInput.Description"
                              class="form-control project-content__textarea project-content__textarea--large"
                              rows="14"
                              maxlength="@ProjectFieldLimits.DescriptionMaxLength"
                              data-character-counter
                              aria-describedby="project-description-editor-meta"></textarea>
                    <div class="project-content__editor-meta" id="project-description-editor-meta">
                        <span>Markdown optional.</span>
                        <span data-character-count>@descriptionCharacterCount.ToString("N0") / @ProjectFieldLimits.DescriptionMaxLength.ToString("N0") characters</span>
                    </div>
                    <div class="project-content__description-preview d-none" data-description-preview-panel>
                        <div class="project-content__description-preview-header">
                            <strong>Preview</strong>
                            <button class="btn btn-sm btn-link" type="button" data-description-preview-close>Hide preview</button>
                        </div>
                        <div class="project-content__narrative pm-markdown" data-description-preview-content></div>
                        <div class="small text-danger d-none" role="alert" data-description-preview-error></div>
                    </div>
                    <div class="invalid-feedback d-block d-none" role="alert" aria-live="polite" data-content-error></div>
                    <div class="project-content__actions project-content__actions--split">
                        <button class="btn btn-sm btn-outline-secondary" type="button" data-description-preview-trigger>
                            <i class="bi bi-eye" aria-hidden="true"></i>
                            <span data-description-preview-label>Preview</span>
                        </button>
                        <span class="project-content__actions-primary">
                            <button class="btn btn-sm btn-outline-secondary" type="button" data-content-cancel>Cancel</button>
                            <button class="btn btn-sm btn-primary" type="submit" data-content-save>
                                <span class="spinner-border spinner-border-sm d-none" aria-hidden="true" data-content-spinner></span>
                                <span data-content-save-label>Save description</span>
                            </button>
                        </span>
                    </div>
                </form>
            }
        </div>
    </div>
</section>
