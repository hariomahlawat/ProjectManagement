@page "/Projects/Reports/ArppFyUpdate"
@model ProjectManagement.Pages.Projects.Reports.ArppFyUpdateModel
@using System.Globalization
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Html
@using ProjectManagement.Services.Projects
@using ProjectManagement.Services.Reports.ArppFyProjectUpdate
@using ProjectManagement.Utilities
@{
    ViewData["Title"] = "ARPP FY Project Update";
    ViewData["UseFullWidth"] = true;
    ViewData["PageShell"] = "workspace";
    var report = Model.Report;
    var presentationOptions = new ArppFyProjectUpdatePresentationOptions(
        Model.IncludePresentStage,
        ArppFyProjectUpdatePresentationOptions.NormalizeListingDateMode(Model.ListingDateMode));
    string Date(DateOnly? value) => value?.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) ?? "—";
    string Pdc(ArppFyProjectUpdateRow row) => row.IsCompleted ? "Completed" : Date(row.DevelopmentPdcDate);
    IHtmlContent ArppNumber(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return new HtmlString("—");
        }

        // Keep the identifier exact while preferring line breaks at its natural '/' separators.
        var encoded = HtmlEncoder.Default.Encode(value);
        return new HtmlString(encoded.Replace("/", "/<wbr>", StringComparison.Ordinal));
    }

    string SupplyOrder(ArppFyProjectUpdateRow row)
    {
        var amount = row.SupplyOrderAmountInCrores.HasValue
            ? $"₹{row.SupplyOrderAmountInCrores.Value.ToString("0.##", CultureInfo.InvariantCulture)} Cr"
            : null;
        var date = row.SupplyOrderDate.HasValue ? Date(row.SupplyOrderDate) : null;
        return amount is not null && date is not null ? $"{amount} · {date}" : amount ?? date ?? "—";
    }
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/projects-reports.css" asp-append-version="true" />
}

<div class="project-reports-page project-reports-page--workspace">
    <nav class="project-reports-breadcrumb" aria-label="Breadcrumb">
        <a asp-page="/Projects/Index">Projects</a>
        <span>/</span>
        <a asp-page="./Index">Reports</a>
        <span>/</span>
        <span>ARPP FY Project Update</span>
    </nav>

    <header class="report-workspace-header">
        <div class="report-workspace-header__identity">
            <p class="project-reports-eyebrow">ARPP / PPP · FORMAL FY RETURN</p>
            <h1>ARPP FY Project Update</h1>
            <p>Listed New, CL and CF projects from the selected FY's latest published ARPP position.</p>
        </div>

        <div class="report-workspace-actions">
            @if (Model.AvailableFinancialYears.Count > 0)
            {
                <form method="get" class="report-display-controls" aria-label="Report display options">
                    <div class="report-toolbar__fy">
                        <label for="financialYearStart">Financial Year</label>
                        <div class="input-group input-group-sm">
                            <select class="form-select" id="financialYearStart" name="financialYearStart" onchange="this.form.submit()">
                                @foreach (var year in Model.AvailableFinancialYears)
                                {
                                    <option value="@year" selected="@(Model.FinancialYearStart == year)">FY @FinancialYearHelper.Format(year)</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-outline-secondary" title="Refresh report">
                                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                                <span class="visually-hidden">Refresh report</span>
                            </button>
                        </div>
                    </div>

                    <div class="report-toolbar__listing">
                        <label for="listingDateMode">Listing date</label>
                        <select class="form-select form-select-sm"
                                id="listingDateMode"
                                name="listingDateMode"
                                onchange="this.form.submit()"
                                title="Initial listing uses the project's first authoritative ARPP listing. Current FY listing uses the published Original ARPP/Addendum date that establishes the project's current FY position.">
                            <option value="@ArppListingDateMode.InitialListing"
                                    selected="@(presentationOptions.EffectiveListingDateMode == ArppListingDateMode.InitialListing)">
                                Initial listing
                            </option>
                            <option value="@ArppListingDateMode.CurrentFinancialYear"
                                    selected="@(presentationOptions.EffectiveListingDateMode == ArppListingDateMode.CurrentFinancialYear)">
                                Current FY listing
                            </option>
                        </select>
                    </div>

                    <div class="report-toolbar__options">
                        <span class="report-toolbar__options-label">Optional columns</span>
                        <label class="report-option-toggle" for="includePresentStage">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="includePresentStage"
                                   name="includePresentStage"
                                   value="true"
                                   checked="@Model.IncludePresentStage"
                                   onchange="this.form.submit()" />
                            <span>Present Stage</span>
                        </label>
                    </div>
                </form>
            }

            @if (report is not null)
            {
                <div class="report-export-group" aria-label="Export report">
                    <span class="report-export-group__label">Export</span>
                    <div class="report-export-actions">
                        <a class="btn btn-outline-primary btn-sm @(report.CanExport ? string.Empty : "disabled")"
                           asp-page-handler="Word" asp-route-financialYearStart="@report.FinancialYearStart" asp-route-includePresentStage="@Model.IncludePresentStage" asp-route-listingDateMode="@presentationOptions.EffectiveListingDateMode"
                           aria-disabled="@(!report.CanExport)">
                            <i class="bi bi-file-earmark-word" aria-hidden="true"></i> Word
                        </a>
                        <a class="btn btn-outline-danger btn-sm @(report.CanExport ? string.Empty : "disabled")"
                           asp-page-handler="Pdf" asp-route-financialYearStart="@report.FinancialYearStart" asp-route-includePresentStage="@Model.IncludePresentStage" asp-route-listingDateMode="@presentationOptions.EffectiveListingDateMode"
                           aria-disabled="@(!report.CanExport)">
                            <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF
                        </a>
                        <a class="btn btn-outline-success btn-sm @(report.CanExport ? string.Empty : "disabled")"
                           asp-page-handler="Excel" asp-route-financialYearStart="@report.FinancialYearStart" asp-route-includePresentStage="@Model.IncludePresentStage" asp-route-listingDateMode="@presentationOptions.EffectiveListingDateMode"
                           aria-disabled="@(!report.CanExport)">
                            <i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Excel
                        </a>
                    </div>
                </div>
            }
        </div>
    </header>

    @if (Model.AvailableFinancialYears.Count == 0)
    {
        <section class="report-empty-state">
            <i class="bi bi-journal-x" aria-hidden="true"></i>
            <h2>No published ARPP data</h2>
            <p>Publish an ARPP document before generating this report.</p>
            <a class="btn btn-outline-primary" asp-page="/Projects/Arpp/Index">Open ARPP / PPP</a>
        </section>
    }
    else if (report is null)
    {
        <section class="report-empty-state">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            <h2>Report unavailable</h2>
            <p>The selected FY could not be resolved from the published ARPP library.</p>
        </section>
    }
    else
    {
        <section class="report-command-strip" aria-label="Report summary">
            <div class="report-kpis">
                <div><span>Projects</span><strong>@report.Rows.Count</strong></div>
                <div><span>Completed</span><strong>@report.CompletedCount</strong></div>
                <div><span>Ongoing / exceptions</span><strong>@report.OngoingCount</strong></div>
                <div class="@(report.WarningCount > 0 ? "has-warning" : string.Empty)"><span>Data warnings</span><strong>@report.WarningCount</strong></div>
            </div>
            <div class="report-order-note">
                <i class="bi bi-sort-down-alt" aria-hidden="true"></i>
                <span>Ordered by lifecycle maturity</span>
            </div>
        </section>

        @if (report.Warnings.Count > 0)
        {
            <details class="report-preflight">
                <summary>
                    <span class="report-preflight__icon"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
                    <span>
                        <strong>Report preflight</strong>
                        <small>@report.WarningCount warning@(report.WarningCount == 1 ? "" : "s") · review before issue</small>
                    </span>
                    <i class="bi bi-chevron-down report-preflight__chevron" aria-hidden="true"></i>
                </summary>
                <div class="report-preflight__body">
                    @foreach (var warning in report.Warnings)
                    {
                        <div class="report-preflight__item">
                            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                            <span>@warning.Message</span>
                            @if (warning.ProjectId.HasValue)
                            {
                                <a asp-page="/Projects/Overview" asp-route-id="@warning.ProjectId.Value" target="_blank" rel="noopener noreferrer">Open project</a>
                            }
                        </div>
                    }
                </div>
            </details>
        }

        <section class="formal-report-card" aria-label="ARPP FY project update preview">
            <header class="formal-report-card__header">
                <h2>@report.FormalTitle</h2>
                <small>Ordered by lifecycle maturity</small>
            </header>

            @if (report.Rows.Count == 0)
            {
                <div class="formal-report-empty">No linked listed New / CL / CF projects are available for this FY.</div>
            }
            else
            {
                <div class="formal-report-scroll" tabindex="0" aria-label="Scrollable report table">
                    <table class="formal-report-table @(Model.IncludePresentStage ? "formal-report-table--with-stage" : string.Empty)">
                        <colgroup>
                            <col class="col-serial" />
                            <col class="col-arpp" />
                            <col class="col-project" />
                            <col class="col-date" />
                            <col class="col-sch" />
                            <col class="col-cfa" />
                            <col class="col-est" />
                            <col class="col-aon" />
                            @if (Model.IncludePresentStage)
                            {
                                <col class="col-stage" />
                            }
                            <col class="col-so" />
                            <col class="col-pdc" />
                            <col class="col-case" />
                            <col class="col-remarks" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th rowspan="2">Ser No.</th>
                                <th rowspan="2">ARPP No.</th>
                                <th rowspan="2">Name of Project</th>
                                <th rowspan="2">Dt of Grant of IPA / ARPP Listing</th>
                                <th rowspan="2">Sch</th>
                                <th rowspan="2">CFA</th>
                                <th rowspan="2">Est</th>
                                <th colspan="@(Model.IncludePresentStage ? 4 : 3)">Status</th>
                                <th rowspan="2">Proj Case</th>
                                <th rowspan="2">Remarks</th>
                            </tr>
                            <tr>
                                <th>AoN</th>
                                @if (Model.IncludePresentStage)
                                {
                                    <th>Present Stage</th>
                                }
                                <th>SO amt &amp; dt</th>
                                <th>PDC dt</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in report.Rows)
                            {
                                <tr>
                                    <td class="text-center">@row.SerialNumber</td>
                                    <td class="text-center formal-report-arpp">@ArppNumber(row.PppNumber)</td>
                                    <td class="formal-report-project" title="Current position: @row.StageDisplay">
                                        <a asp-page="/Projects/Overview" asp-route-id="@row.ProjectId" target="_blank" rel="noopener noreferrer">@row.ProjectName</a>
                                    </td>
                                    <td class="text-center">@Date(presentationOptions.ResolveListingDate(row))</td>
                                    <td class="text-center">@(row.DfpdsSchedule ?? "—")</td>
                                    <td class="text-center formal-report-cfa">@(row.Cfa ?? "—")</td>
                                    <td class="text-center">@row.Establishment</td>
                                    <td class="text-center">@Date(row.AonDate)</td>
                                    @if (Model.IncludePresentStage)
                                    {
                                        <td class="text-center formal-report-stage">@row.StageDisplay</td>
                                    }
                                    <td class="text-center formal-report-so">
                                        @if (row.SupplyOrderAmountInCrores.HasValue)
                                        {
                                            <strong>₹@row.SupplyOrderAmountInCrores.Value.ToString("0.##", CultureInfo.InvariantCulture) Cr</strong>
                                            @if (row.SupplyOrderDate.HasValue)
                                            {
                                                <span>@Date(row.SupplyOrderDate)</span>
                                            }
                                            <small>@(row.SupplyOrderAmountBasis == ProjectSupplyOrderValueBasis.Pnc ? "PNC" : "L1")</small>
                                        }
                                        else
                                        {
                                            <span>@SupplyOrder(row)</span>
                                        }
                                    </td>
                                    <td class="text-center formal-report-pdc">@Pdc(row)</td>
                                    <td class="text-center"><span class="report-case-badge">@row.ProjectCaseDisplay</span></td>
                                    <td class="formal-report-remarks">@(row.LatestExternalRemark ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>
