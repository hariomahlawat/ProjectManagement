@page "/Projects/Reports"
@model ProjectManagement.Pages.Projects.Reports.IndexModel
@using ProjectManagement.Utilities
@{
    ViewData["Title"] = "Project Reports";
    ViewData["UseFullWidth"] = true;
    ViewData["PageShell"] = "workspace";
    var latestFy = Model.AvailableFinancialYears.FirstOrDefault();
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/projects-reports.css" asp-append-version="true" />
}

<div class="project-reports-page">
    <nav class="project-reports-breadcrumb" aria-label="Breadcrumb">
        <a asp-page="/Projects/Index">Projects</a>
        <span>/</span>
        <span>Reports</span>
    </nav>

    <header class="project-reports-hero">
        <div>
            <p class="project-reports-eyebrow">PROJECT REPORTING</p>
            <h1>Reports</h1>
            <p>Generate formal project returns directly from published ARPP and current PRISM records.</p>
        </div>
    </header>

    <section class="project-report-grid" aria-label="Available project reports">
        <article class="project-report-card">
            <div class="project-report-card__icon" aria-hidden="true">
                <i class="bi bi-table"></i>
            </div>

            <div class="project-report-card__body">
                <div class="project-report-card__meta">ARPP / PPP · FY RETURN</div>
                <h2>ARPP FY Project Update</h2>
                <p>ARPP-listed New, CL and CF projects for the selected financial year with original listing date, DFPDS schedule, CFA, AoN, Supply Order, PDC and latest external update.</p>
                <div class="project-report-card__facts" aria-label="Report capabilities">
                    <span><i class="bi bi-sort-down-alt" aria-hidden="true"></i> Lifecycle-maturity order</span>
                    <span><i class="bi bi-file-earmark-word" aria-hidden="true"></i> Word</span>
                    <span><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF</span>
                    <span><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Excel</span>
                </div>
            </div>

            <div class="project-report-card__aside">
                @if (latestFy > 0)
                {
                    <div class="project-report-card__availability">
                        <span>Latest available</span>
                        <strong>FY @FinancialYearHelper.Format(latestFy)</strong>
                    </div>
                    <a class="btn btn-primary btn-sm" asp-page="./ArppFyUpdate" asp-route-financialYearStart="@latestFy">
                        Open report
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </a>
                }
                else
                {
                    <div class="project-report-card__availability">
                        <span>Availability</span>
                        <strong>No published ARPP data</strong>
                    </div>
                    <button class="btn btn-secondary btn-sm" type="button" disabled>Unavailable</button>
                }
            </div>
        </article>
    </section>
</div>
