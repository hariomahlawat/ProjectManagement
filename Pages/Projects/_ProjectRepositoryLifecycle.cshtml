@model ProjectManagement.Pages.Projects.IndexModel
@using ProjectManagement.Services.Projects

        <div class="projects-classification-bar" data-project-lifecycle-region>
            <nav class="projects-lifecycle" aria-label="Project lifecycle filters">
                @foreach (var lifecycle in Model.LifecycleTabs)
                {
                    var routeValues = Model.BuildBaseRouteValues();
                    routeValues["Lifecycle"] = lifecycle.RouteValue;
                    routeValues["p"] = "1";
                    if (lifecycle.Filter != ProjectLifecycleFilter.Active)
                    {
                        // The pipeline filters belong to the Active tab.
                        routeValues.Remove("CurrentStage");
                        routeValues.Remove("Attention");
                    }
                    if (lifecycle.Filter != ProjectLifecycleFilter.Completed)
                    {
                        // The record filter (PRISM or legacy entries) belongs to the Completed tab.
                        routeValues.Remove("Record");
                    }
                    <a class="projects-lifecycle__tab @(lifecycle.IsActive ? "is-active" : null)"
                       asp-page="/Projects/Index"
                       asp-all-route-data="routeValues"
                       aria-current="@(lifecycle.IsActive ? "page" : null)">
                        <span>@lifecycle.Label</span>
                        <span class="projects-lifecycle__count">@lifecycle.Count</span>
                    </a>
                }
            </nav>
        </div>
