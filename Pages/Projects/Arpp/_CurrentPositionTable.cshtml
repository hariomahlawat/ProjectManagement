@using ProjectManagement.Helpers
@using ProjectManagement.Models.Arpp
@using ProjectManagement.Services.Arpp
@using ProjectManagement.Utilities
@model IReadOnlyList<ArppLibraryCurrentRow>
@{
    var libraryQuery = Context.Request.Query["Query"].ToString();

    static bool IsSameReference(string issuedReference, string projectName)
        => string.Equals(
            issuedReference.Trim(),
            projectName.Trim(),
            StringComparison.OrdinalIgnoreCase);
}

@if (Model.Count == 0)
{
    <div class="project-arpp-table-empty">No projects in this section.</div>
}
else
{
    <div class="project-arpp-table-wrap">
        <table class="project-arpp-table project-arpp-table--current">
            <thead>
                <tr>
                    <th>Project</th>
                    <th>Latest source</th>
                    <th>Serial</th>
                    <th>Category</th>
                    <th class="text-end">IPA cost (₹)</th>
                    <th>CFA</th>
                    <th>Fund</th>
                    <th>DFPDS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr id="arpp-project-@row.ProjectId"
                        class="project-arpp-project-row @(row.Category == ArppCategory.Delisted ? "is-delisted" : string.Empty)">
                        <td>
                            <a class="project-arpp-table__project project-arpp-table__project-link"
                               asp-page="/Projects/Overview"
                               asp-route-id="@row.ProjectId"
                               target="_blank"
                               rel="noopener noreferrer"
                               title="Open project in a new tab">
                                <span>@row.ProjectName</span>
                                <i class="bi bi-box-arrow-up-right project-arpp-table__external-icon" aria-hidden="true"></i>
                                <span class="visually-hidden">(opens in a new tab)</span>
                            </a>
                            @if (!IsSameReference(row.ProjectReference, row.ProjectName))
                            {
                                <div class="project-arpp-table__issued-reference">
                                    Issued as: @row.ProjectReference
                                </div>
                            }
                            <div class="project-arpp-table__linked">
                                <span>PRISM status: @row.ProjectStatus</span>
                                <a class="project-arpp-history-link"
                                   asp-page="./History"
                                   asp-route-projectId="@row.ProjectId"
                                   asp-route-financialYearStart="@row.SourceFinancialYearStart"
                                   asp-route-query="@libraryQuery">
                                    History
                                </a>
                            </div>
                        </td>
                        <td>
                            <a asp-page="./Index"
                               asp-route-issueId="@row.SourceIssueId"
                               asp-route-query="@libraryQuery"
                               data-arpp-library-reader-link>
                                @row.SourceIssueName
                            </a>
                            <small>@(row.SourceKind == ArppIssueKind.Original ? "Original ARPP" : $"Addendum No. {row.SourceSequence}") · @row.SourceIssueDate.ToString("dd MMM yyyy")</small>
                        </td>
                        <td class="project-arpp-table__serial">@row.SerialNumber</td>
                        <td><span class="arpp-badge arpp-badge--@(row.Category.ToString().ToLowerInvariant())">@ArppDisplayNames.For(row.Category)</span></td>
                        <td class="text-end text-nowrap fw-semibold" title="@IndianCurrencyFormatter.FormatRupees(row.IpaCost)">@IndianCurrencyFormatter.FormatCompact(row.IpaCost)</td>
                        <td>@row.Cfa</td>
                        <td>@row.Fund</td>
                        <td>@row.DfpdsSchedule</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
