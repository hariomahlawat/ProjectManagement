@using ProjectManagement.Helpers
@using ProjectManagement.Models.Arpp
@using ProjectManagement.Services.Arpp
@using ProjectManagement.Utilities
@model IReadOnlyList<ArppLibraryRow>
@{
    static bool IsSameReference(string issuedReference, string? projectName)
        => !string.IsNullOrWhiteSpace(projectName)
           && string.Equals(
               issuedReference.Trim(),
               projectName.Trim(),
               StringComparison.OrdinalIgnoreCase);
}

<div class="project-arpp-table-wrap">
    <table class="project-arpp-table">
        <thead>
            <tr>
                <th class="project-arpp-table__order">#</th>
                <th class="project-arpp-table__serial">Serial</th>
                <th class="project-arpp-table__ppp">PPP No.</th>
                <th>Project reference</th>
                <th>Category</th>
                <th class="text-end">IPA cost (₹)</th>
                <th>CFA</th>
                <th>Fund</th>
                <th>DFPDS</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.OrderBy(row => row.SortOrder).ThenBy(row => row.EntryId))
            {
                <tr class="@(row.Category == ArppCategory.Delisted ? "is-delisted" : string.Empty)">
                    <td class="project-arpp-table__order">@row.SortOrder</td>
                    <td class="project-arpp-table__serial">@(row.Category == ArppCategory.Delisted ? "—" : row.SerialNumber)</td>
                    <td class="project-arpp-table__ppp">@(row.Category == ArppCategory.Delisted ? "—" : row.PppNumber)</td>
                    <td>
                        @if (row.ProjectId.HasValue)
                        {
                            <a class="project-arpp-table__project project-arpp-table__project-link"
                               asp-page="/Projects/Overview"
                               asp-route-id="@row.ProjectId"
                               target="_blank"
                               rel="noopener noreferrer"
                               title="Open project in a new tab">
                                <span>@row.ProjectReference</span>
                                <i class="bi bi-box-arrow-up-right project-arpp-table__external-icon" aria-hidden="true"></i>
                                <span class="visually-hidden">(opens in a new tab)</span>
                            </a>

                            <div class="project-arpp-table__linked">
                                @if (!IsSameReference(row.ProjectReference, row.ProjectName))
                                {
                                    <span>PRISM project: @row.ProjectName</span>
                                    @if (!string.IsNullOrWhiteSpace(row.ProjectStatus))
                                    {
                                        <span> · Status: @row.ProjectStatus</span>
                                    }
                                }
                                else if (!string.IsNullOrWhiteSpace(row.ProjectStatus))
                                {
                                    <span>PRISM status: @row.ProjectStatus</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="project-arpp-table__project">@row.ProjectReference</div>
                            <div class="project-arpp-table__linked project-arpp-table__linked--pending">
                                Not yet linked to a PRISM project
                            </div>
                        }
                    </td>
                    <td><span class="arpp-badge arpp-badge--@(row.Category.ToString().ToLowerInvariant())">@ArppDisplayNames.For(row.Category)</span></td>
                    <td class="text-end text-nowrap fw-semibold" title="@IndianCurrencyFormatter.FormatRupees(row.IpaCost)">@IndianCurrencyFormatter.FormatCompact(row.IpaCost)</td>
                    <td>@row.Cfa</td>
                    <td>@row.Fund</td>
                    <td>@row.DfpdsSchedule</td>
                </tr>
            }
        </tbody>
    </table>
</div>
