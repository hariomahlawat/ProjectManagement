@model ProjectManagement.ViewModels.ProcurementEditVm
@using ProjectManagement.Services.Projects

@{
    // Amounts are entered in rupees; the hint under each field reads the figure back in
    // lakh or crore (procurement-inr-preview.js) so a missing or extra zero is easy to spot.
    void CostField(string key, string label, decimal? value, bool canEdit, string lockedNote, string? managedNote = null)
    {
        var id = $"{Model.IdPrefix}Input_{key}";
        var hintId = $"{id}_Hint";
        <div class="col-md-6">
            <label for="@id" class="form-label">@label</label>
            <div class="input-group procurement-cost-input@(canEdit ? string.Empty : " is-locked")">
                <span class="input-group-text" aria-hidden="true">₹</span>
                <input class="form-control" id="@id" name="Input.@key"
                       inputmode="decimal"
                       autocomplete="off"
                       placeholder="@(canEdit ? "Amount in rupees" : "Locked")"
                       aria-describedby="@hintId"
                       value="@(value?.ToString("0.##"))"
                       data-inr-preview-source
                       data-inr-max="@ProjectManagement.ViewModels.ProcurementEditInput.MaxAmountText"
                       @(canEdit ? null : "disabled") />
            </div>
            <div class="form-text" id="@hintId">
                @if (managedNote is not null)
                {
                    @managedNote
                }
                else if (!canEdit)
                {
                    <i class="bi bi-lock" aria-hidden="true"></i> @lockedNote
                }
                else
                {
                    <span data-inr-preview>In rupees, for example 48000000 for ₹4.8 crore.</span>
                }
            </div>
        </div>
    }
}

<form method="post" asp-page="/Projects/Procurement/Edit" asp-route-id="@Model.Input.ProjectId" asp-route-returnUrl="@Model.ReturnUrl" class="procurement-edit-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Input.ProjectId" value="@Model.Input.ProjectId" />

    <div class="row g-3">
        @{
            CostField("IpaCost", "IPA cost", Model.Input.IpaCost, Model.CanEditIpaCost,
                ProcurementStageRules.LockedNote(ProcurementStageRules.StageForIpaCost),
                Model.IsIpaManagedByArpp
                    ? Model.IpaManagementMessage ?? "Managed through ARPP. Update this value from the ARPP register."
                    : null);
            CostField("AonCost", "AoN cost", Model.Input.AonCost, Model.CanEditAonCost,
                ProcurementStageRules.LockedNote(ProcurementStageRules.StageForAonCost));
            CostField("BenchmarkCost", "Benchmark cost", Model.Input.BenchmarkCost, Model.CanEditBenchmarkCost,
                ProcurementStageRules.LockedNote(ProcurementStageRules.StageForBenchmarkCost));
            CostField("L1Cost", "L1 cost", Model.Input.L1Cost, Model.CanEditL1Cost,
                ProcurementStageRules.LockedNote(ProcurementStageRules.StageForL1Cost));
            CostField("PncCost", "PNC cost", Model.Input.PncCost, Model.CanEditPncCost,
                ProcurementStageRules.LockedNote(ProcurementStageRules.StageForPncCost));
        }

        <div class="col-md-6">
            <label for="@(Model.IdPrefix)Input_SupplyOrderDate" class="form-label">Supply order date</label>
            <div class="input-group procurement-cost-input@(Model.CanEditSupplyOrderDate ? string.Empty : " is-locked")">
                <span class="input-group-text" aria-hidden="true"><i class="bi bi-calendar3"></i></span>
                <input class="form-control" type="date" id="@(Model.IdPrefix)Input_SupplyOrderDate" name="Input.SupplyOrderDate"
                       aria-describedby="@(Model.IdPrefix)Input_SupplyOrderDate_Hint"
                       value="@(Model.Input.SupplyOrderDate.HasValue ? Model.Input.SupplyOrderDate.Value.ToString("yyyy-MM-dd") : null)"
                       @(Model.CanEditSupplyOrderDate ? null : "disabled") />
            </div>
            @if (!Model.CanEditSupplyOrderDate)
            {
                <div class="form-text" id="@(Model.IdPrefix)Input_SupplyOrderDate_Hint"><i class="bi bi-lock" aria-hidden="true"></i> @ProcurementStageRules.LockedNote(ProcurementStageRules.StageForSupplyOrder)</div>
            }
        </div>
    </div>

    <div class="pm-overlay-actions">
        <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="offcanvas">Cancel</button>
        <button class="btn btn-primary" type="submit">Save details</button>
    </div>
</form>
