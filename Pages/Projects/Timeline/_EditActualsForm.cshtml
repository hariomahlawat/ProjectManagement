@model ProjectManagement.ViewModels.ActualsEditorVm
@using ProjectManagement.ViewModels
@using ProjectManagement.Models.Execution
@{
    var rows = Model?.Rows ?? Array.Empty<ActualsEditorRowVm>();
    var todayIso = Model?.Today.ToString("yyyy-MM-dd") ?? string.Empty;
    // HoD/Admin publish directly; the assigned PO-only user submits for approval (D-3c).
    // Both flags are server-computed for rendering only; EditActuals re-checks on POST.
    // A host that passes neither renders the editor read-only.
    var directPublication = ViewData["ActualsDirectPublication"] as bool? ?? false;
    var proposalSubmission = !directPublication && (ViewData["ActualsProposalSubmission"] as bool? ?? false);
    var canEdit = directPublication || proposalSubmission;
    var pending = Model?.PendingProposal;
    var unrendered = ViewData["ActualsUnrenderedPendingStages"] as IReadOnlyList<string> ?? Array.Empty<string>();
    // A refused post (ActualsEditorRecovery): the server's messages and, when unchanged, the user's entries.
    var submissionErrors = Model?.SubmissionErrors ?? Array.Empty<string>();
    var restored = canEdit && Model?.RestoredSubmission == true;
    string Display(DateOnly? date) => date?.ToString("dd MMM yyyy") ?? "not recorded";
    var submittedDisplay = pending is null
        ? string.Empty
        : ProjectManagement.Infrastructure.IstClock.ToIst(pending.SubmittedOn.UtcDateTime).ToString("dd MMM yyyy, HH:mm") + " IST";
}

<form method="post"
      asp-page="/Projects/Timeline/EditActuals"
      asp-route-id="@Model?.ProjectId"
      class="actuals-editor d-flex flex-column gap-3"
      data-actuals-form
      data-actuals-resubmit="@(proposalSubmission && pending is { NeedsResubmission: true } ? "true" : null)"
      data-actuals-restored="@(restored ? "true" : null)"
      data-today="@todayIso">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Input.ProjectId" value="@Model?.ProjectId" />
    <input type="hidden" name="Input.BaselineVersion" value="@Model?.BaselineVersion" />
    <input type="hidden" name="Input.SubmissionMode" value="@(proposalSubmission ? ActualsSubmissionMode.Proposal : ActualsSubmissionMode.Direct)" />
    @if (proposalSubmission)
    {
        @* The pending proposal this form was rendered with; both empty means "none". *@
        <input type="hidden" name="Input.BasedOnRevisionId" value="@pending?.RevisionId" data-actuals-based-on />
        <input type="hidden" name="Input.BasedOnSubmittedOn" value="@pending?.SubmittedOnRoundTrip" />
    }

    @if (canEdit && submissionErrors.Count > 0)
    {
        @* Chronology is decided by the server's Actual validator; its messages name each affected stage. *@
        <div class="alert alert-danger mb-0" role="alert" tabindex="-1" data-actuals-submission-errors>
            <div class="fw-semibold">
                @(proposalSubmission ? "Nothing was submitted." : "Nothing was saved.")
                @(restored
                    ? "Your entries are shown below. Correct the stages named here, together if needed, and submit again."
                    : "The recorded dates changed since you submitted, so the current dates are shown. Review them and enter your correction again.")
            </div>
            <ul class="small mb-0 mt-1">
                @foreach (var submissionError in submissionErrors)
                {
                    <li>@submissionError</li>
                }
            </ul>
        </div>
    }

    <!-- SECTION: Introduction -->
    <div class="small text-muted">
        Correct the actual dates each stage started and was completed. A completed stage's start date is optional and can be cleared; a stage in progress needs its start date. To complete a stage, use Update stage on the timeline.
    </div>

    @if (proposalSubmission && pending is not null)
    {
        <div class="alert alert-warning mb-0" role="status" data-actuals-pending-proposal>
            <div class="fw-semibold">Revision @pending.RevisionNo is awaiting HoD or Admin approval</div>
            <div class="small">
                Submitted @submittedDisplay@(pending.SubmittedByCurrentUser ? " by you" : " by the previous Project Officer"). The dates below include your proposed corrections; official dates are unchanged until approval.
                Edit and submit again to revise it, or withdraw it.
            </div>
            @if (pending.AlreadySatisfied)
            {
                <div class="small mt-1 fw-semibold" data-actuals-pending-satisfied>
                    The official dates now match every date in this update, so there is nothing left to approve. Withdraw the pending update.
                </div>
            }
            else if (pending.ChangedStageCodes.Count > 0)
            {
                <div class="small mt-1 fw-semibold" data-actuals-pending-stale>
                    Official dates changed for @string.Join(", ", pending.ChangedStageCodes.Select(code => rows.FirstOrDefault(row => string.Equals(row.StageCode, code, StringComparison.OrdinalIgnoreCase))?.StageName ?? code)) after @(pending.SubmittedByCurrentUser ? "you submitted" : "it was submitted"). A HoD or Admin cannot approve this update until you review the dates below and submit again.
                </div>
            }
        </div>
    }
    else if (proposalSubmission && Model?.LastRejection is { } rejection)
    {
        <div class="alert alert-secondary mb-0" role="status" data-actuals-last-rejection>
            <div class="fw-semibold">@(rejection.SubmittedByCurrentUser ? "Your" : "The previous Project Officer's") correction (revision @rejection.RevisionNo) was returned@(rejection.RejectedOn is { } on ? " on " + ProjectManagement.Infrastructure.IstClock.ToIst(on.UtcDateTime).ToString("dd MMM yyyy") : string.Empty).</div>
            @if (!string.IsNullOrWhiteSpace(rejection.Remarks))
            {
                <div class="small">Reviewer's remarks: @rejection.Remarks</div>
            }
            <div class="small">The dates below are the official dates. You can submit a new correction for approval.</div>
        </div>
    }
    else if (proposalSubmission)
    {
        <div class="alert alert-info mb-0" role="status" data-actuals-proposal-mode>
            Your corrections are sent to a HoD or Admin for approval. Official dates change only after approval, and you can revise or withdraw a pending submission.
        </div>
    }
    else if (directPublication && pending is not null)
    {
        <div class="alert alert-info mb-0" role="status" data-actuals-pending-proposal>
            A Project Officer's correction (revision @pending.RevisionNo, stages @string.Join(", ", pending.StageCodes)) is awaiting approval. Saving here publishes directly and does not change that proposal.
        </div>
    }
    else if (!canEdit)
    {
        <div class="alert alert-info mb-0" role="status" data-actuals-read-only>
            Only the assigned Project Officer (for approval) or a HoD or Admin can correct these dates.
        </div>
    }

    @if (proposalSubmission && unrendered.Count > 0)
    {
        <div class="alert alert-danger mb-0" role="alert" data-actuals-unrendered>
            Your pending update also covers @string.Join(", ", unrendered), which this editor cannot show. Submitting from this editor would drop those corrections, so it is unavailable; withdraw the pending update or ask a HoD or Admin.
        </div>
    }

    <!-- SECTION: Actuals list -->
    <fieldset class="actuals-editor__list border-0 p-0 m-0" data-actuals-list disabled="@(!canEdit)">
        <div class="d-grid gap-3">
            @for (var i = 0; i < rows.Count; i++)
            {
                var row = rows[i];
                var startId = $"actual-start-{row.StageCode}";
                var completedId = $"actual-completed-{row.StageCode}";
                // A PO proposal prefills its proposed values; official values stay visible.
                var startValue = (proposalSubmission ? row.EditStart : row.ActualStart)?.ToString("yyyy-MM-dd");
                var completedValue = (proposalSubmission ? row.EditCompletedOn : row.CompletedOn)?.ToString("yyyy-MM-dd");
                var entered = restored && Model!.EnteredValues.TryGetValue(row.StageCode, out var enteredValues) ? enteredValues : null;
                var officialStartValue = row.ActualStart?.ToString("yyyy-MM-dd");
                var showsProposal = proposalSubmission && row.HasProposal;
                var earliestStartValue = row.EarliestAllowedStartDate?.ToString("yyyy-MM-dd");
                var startBoundarySourceName = row.StartBoundarySourceName ?? "predecessor";
                // A proposal is checked against pending lifecycle requests on the server (F.6), so
                // the PO is not frozen by them; a row carrying a proposal always stays postable.
                var canEditStart = (row.IsEditable && (proposalSubmission || !row.HasPendingDecision)) || showsProposal;
                var canEditCompletion = canEditStart && row.Status == StageStatus.Completed && !row.IsArppManaged;
                // Entries are shown again only in fields that were posted and are still editable.
                if (entered is { HasStart: true } && canEditStart)
                {
                    startValue = entered.ActualStart?.ToString("yyyy-MM-dd");
                }
                if (entered is { HasCompletedOn: true } && canEditCompletion)
                {
                    completedValue = entered.CompletedOn?.ToString("yyyy-MM-dd");
                }
                var startDisabledAttr = canEditStart ? null : "disabled";
                var completionDisabledAttr = canEditCompletion ? null : "disabled";
                // An explicit control for the optional Completed start; blank still means
                // "clear" to the server, so the toggle only mirrors and sets the field (C3.4).
                var canClearStart = canEditStart && row.Status == StageStatus.Completed && row.ActualStart.HasValue;
                var clearsStart = canClearStart && string.IsNullOrEmpty(startValue);
                var rejectedItem = proposalSubmission ? Model?.LastRejection?.ItemFor(row.StageCode) : null;
                <section class="actuals-editor__stage border rounded p-3"
                         data-actuals-row
                         data-stage-code="@row.StageCode"
                         data-stage-name="@row.StageName"
                         data-stage-status="@row.Status"
                         data-earliest-start="@earliestStartValue"
                         data-official-start="@officialStartValue"
                         data-start-source="@row.StartBoundarySourceName">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                        <div class="d-flex flex-column">
                            <div class="fw-semibold">@row.StageName</div>
                            <div class="text-muted small">@row.StageCode</div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <span class="badge text-bg-secondary">@ProjectManagement.ViewModels.ProjectPortfolioPresentationVm.StageStatusLabel(row.Status)</span>
                            @if (showsProposal)
                            {
                                <span class="badge bg-info-subtle text-info border border-info-subtle" data-actuals-proposed>Proposed correction</span>
                            }
                            @if (row.HasPendingDecision)
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Stage update awaiting approval</span>
                            }
                            @if (row.RequiresBackfill)
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Completion details needed</span>
                            }
                            @if (row.IsArppManaged)
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">ARPP-derived</span>
                            }
                            @if (row.IsAutoCompleted)
                            {
                                <span class="badge bg-info-subtle text-info border border-info-subtle">Auto-completed</span>
                            }
                        </div>
                    </div>

                    <div class="actuals-editor__fields">
                        <div>
                            <label class="form-label" for="@startId">Actual start date @(row.Status == StageStatus.Completed ? "(optional)" : string.Empty)</label>
                            <input type="date"
                                   class="form-control"
                                   id="@startId"
                                   name="Input.Rows[@i].ActualStart"
                                   value="@startValue"
                                   max="@todayIso"
                                   aria-describedby="@startId-help"
                                   data-field="start"
                                   @(startDisabledAttr) />
                            @if (showsProposal)
                            {
                                <div class="small text-muted" data-actuals-official-start>Official: @Display(row.ActualStart)</div>
                            }
                            @if (canClearStart)
                            {
                                <div class="form-check mt-1">
                                    <input class="form-check-input" type="checkbox" id="@startId-clear" data-clear-start-toggle @(clearsStart ? "checked" : null) />
                                    <label class="form-check-label small" for="@startId-clear">Clear the recorded start date (@Display(row.ActualStart))</label>
                                </div>
                            }
                            <div class="form-text" id="@startId-help">
                                @if (row.IsArppManaged)
                                {
                                    <text>Optional. Leave blank when the actual start is not documented; PRISM will show duration as unavailable.</text>
                                }
                                else
                                {
                                    @if (row.EarliestAllowedStartDate.HasValue)
                                    {
                                        <text>Earliest permitted: @row.EarliestAllowedStartDate.Value.ToString("dd MMM yyyy") (@startBoundarySourceName completion). Same-day commencement is permitted. @(row.Status == StageStatus.Completed ? "If omitted, duration may be inferred from the following day." : string.Empty)</text>
                                    }
                                    else
                                    {
                                        <text>@(row.Status == StageStatus.Completed ? "Optional. If omitted, duration may be inferred from the preceding completion date." : "Enter when work began for the current stage.")</text>
                                    }
                                }
                            </div>
                        </div>
                        <div>
                            <label class="form-label" for="@completedId">Completed on</label>
                            <input type="date"
                                   class="form-control"
                                   id="@completedId"
                                   name="Input.Rows[@i].CompletedOn"
                                   value="@completedValue"
                                   max="@todayIso"
                                   aria-describedby="@completedId-help"
                                   data-field="completed"
                                   @(completionDisabledAttr) />
                            @if (showsProposal)
                            {
                                <div class="small text-muted" data-actuals-official-completed>Official: @Display(row.CompletedOn)</div>
                            }
                            <div class="form-text" id="@completedId-help">
                                @if (row.IsArppManaged)
                                {
                                    <text>Controlled by @row.ArppSourceLabel. Change the published ARPP record or project linkage to revise it.</text>
                                }
                                else if (row.Status == StageStatus.InProgress)
                                {
                                    <text>To complete this stage, use Update stage on the timeline.</text>
                                }
                                else
                                {
                                    <text>Enter the known completion date. Leaving this blank preserves the recorded completion.</text>
                                }
                            </div>
                        </div>
                    </div>

                    @if (showsProposal)
                    {
                        <div class="small text-muted" data-actuals-official>
                            The fields show your proposal; the official dates are shown under each field.@(row.ProposalClearsStart ? " Your proposal clears the recorded start." : string.Empty)
                            To drop this correction, enter the official dates again.
                        </div>
                    }

                    @if (rejectedItem is not null)
                    {
                        <div class="small text-muted" data-actuals-rejected>
                            Rejected proposal: start @(rejectedItem.ClearsActualStart ? "cleared" : Display(rejectedItem.ProposedActualStart)) · completed @Display(rejectedItem.ProposedCompletedOn).
                        </div>
                    }

                    @if (!row.IsEditable)
                    {
                        <div class="text-muted small">Actual dates can be edited only for a stage that is in progress or completed.</div>
                    }

                    <div class="text-danger small d-none" data-row-error role="alert"></div>

                    @* Rendered from the pending proposal so a clear survives a post made before (or without) actuals-edit.js. *@
                    <input type="hidden" name="Input.Rows[@i].ClearActualStart" value="@(showsProposal && row.ProposalClearsStart ? "true" : "false")" data-clear-start />
                    <input type="hidden" name="Input.Rows[@i].StageCode" value="@row.StageCode" />
                    <input type="hidden" name="Input.Rows[@i].StageName" value="@row.StageName" />
                    <input type="hidden" name="Input.Rows[@i].StageToken" value="@row.StageToken" />
                </section>
            }
        </div>
    </fieldset>

    @if (proposalSubmission)
    {
        <div>
            <label class="form-label" for="actuals-proposal-note">Reason for correction <span class="text-muted fw-normal">(optional)</span></label>
            <textarea class="form-control" id="actuals-proposal-note" name="Input.Note" rows="2" maxlength="1024" data-actuals-note>@(restored ? Model!.EnteredNote : pending?.Note)</textarea>
        </div>
    }

    <!-- SECTION: Footer actions -->
    <div class="actuals-editor__footer border-top pt-3 d-flex justify-content-end gap-2">
        <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="offcanvas">Close</button>
        @if (proposalSubmission && pending is not null)
        {
            <button class="btn btn-outline-danger" type="submit" form="actuals-withdraw-form" data-actuals-withdraw
                    data-confirm="Withdraw your pending correction (revision @pending.RevisionNo)? Official dates are not changed.">Withdraw pending update</button>
        }
        @if (directPublication)
        {
            <button class="btn btn-primary" type="submit" data-actuals-save disabled>Save changes</button>
        }
        else if (proposalSubmission && unrendered.Count == 0)
        {
            <button class="btn btn-primary" type="submit" data-actuals-save disabled>Submit for approval</button>
        }
    </div>
</form>

@if (proposalSubmission && pending is not null)
{
    @* Withdraws exactly the revision shown; a stale identity is refused by the server. *@
    <form method="post"
          id="actuals-withdraw-form"
          asp-page="/Projects/Timeline/EditActuals"
          asp-page-handler="Withdraw"
          asp-route-id="@Model?.ProjectId"
          class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Input.ProjectId" value="@Model?.ProjectId" />
        <input type="hidden" name="revisionId" value="@pending.RevisionId" />
        <input type="hidden" name="submittedOn" value="@pending.SubmittedOnRoundTrip" />
    </form>
}
