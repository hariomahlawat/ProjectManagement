@model ProjectManagement.ViewModels.PlanDurationRowRenderVm
@{
    var row = Model.Row;
    var i = Model.Index;
    var disableAttr = Model.IsDisabled ? "disabled" : null;
    var hasErrors = Model.Errors.Count > 0;
    var inputId = $"DurationRows_{i}__DurationDays";
    var labelId = $"DurationRows_{i}__Label";
    var errorId = $"DurationRows_{i}__Errors";
}
<div class="col-12 plan-editor-stage-row" data-plan-stage-status="@row.Status" data-plan-stage-code="@row.Code">
    <div class="d-flex justify-content-between gap-2">
        <strong>@row.Name</strong>
        <div>
            <span class="text-muted small">@row.Code</span>
            @if (row.IsOptional)
            {
                <span class="badge text-bg-info ms-2">Optional</span>
            }
        </div>
    </div>
    <div class="input-group@(hasErrors ? " has-validation" : null)">
        <label class="input-group-text" for="@inputId" id="@labelId">Duration (days)<span class="visually-hidden"> for @row.Name</span></label>
        <input class="form-control@(hasErrors ? " is-invalid" : null)" type="number" min="0" step="1"
               id="@inputId"
               name="Input.Rows[@i].DurationDays"
               value="@(row.DurationDays?.ToString() ?? "")"
               aria-invalid="@(hasErrors ? "true" : null)"
               aria-describedby="@(hasErrors ? errorId : null)"
               @(disableAttr) />
        @if (hasErrors)
        {
            <div class="invalid-feedback" id="@errorId" data-plan-row-error>
                @foreach (var error in Model.Errors)
                {
                    <div>@error</div>
                }
            </div>
        }
    </div>
    @if (row.IsOptional)
    {
        <div class="form-text">Leave blank if this optional stage is not applicable.</div>
    }
    @if (row.PreviewStart.HasValue || row.PreviewDue.HasValue)
    {
        <div class="form-text text-muted">
            Preview:
            @((row.PreviewStart.HasValue ? row.PreviewStart.Value.ToString("dd MMM yyyy") : "—"))
            →
            @((row.PreviewDue.HasValue ? row.PreviewDue.Value.ToString("dd MMM yyyy") : "—"))
        </div>
    }
    <input type="hidden" name="Input.Rows[@i].Code" value="@row.Code" />
    <input type="hidden" name="Input.Rows[@i].Name" value="@row.Name" />
</div>
