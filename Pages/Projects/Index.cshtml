@page
@model ProjectManagement.Pages.Projects.IndexModel
@using System
@using System.Linq
@using ProjectManagement.Models
@using ProjectManagement.Services.Projects
@{
    ViewData["Title"] = "Projects";

    var projectTypeChips = Model.ProjectTypeChips
        .OrderByDescending(chip => chip.Count)
        .ThenBy(chip => chip.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/projects/index.css" asp-append-version="true" />
}

<div class="projects-repository" data-projects-page>
    <div class="container-xxl projects-repository__container">
        <header class="projects-header">
            <div class="projects-header__identity">
                <div>
                    <h1 class="projects-header__title">Projects</h1>
                    <partial name="_ProjectRepositoryHeaderSummary" model="Model" />
                </div>
            </div>
            <div class="projects-header__actions">
                <div class="projects-view-toggle" role="group" aria-label="Project result view" data-project-view-cookie="@ProjectManagement.Pages.Projects.IndexModel.ViewCookieName">
                    <button type="button" class="projects-view-toggle__button @(Model.ShowTableView ? null : "is-active")" data-project-view="cards" aria-pressed="@(Model.ShowTableView ? "false" : "true")" title="Card view">
                        <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i><span class="visually-hidden">Card view</span>
                    </button>
                    <button type="button" class="projects-view-toggle__button @(Model.ShowTableView ? "is-active" : null)" data-project-view="table" aria-pressed="@(Model.ShowTableView ? "true" : "false")" title="Table view">
                        <i class="bi bi-list-ul" aria-hidden="true"></i><span class="visually-hidden">Table view</span>
                    </button>
                </div>
            </div>
        </header>


        <partial name="_ProjectRepositoryLifecycle" model="Model" />

        <form method="get" class="projects-toolbar" data-project-filter-form>
            <input type="hidden" name="p" value="1" />
            <input type="hidden" name="Lifecycle" value="@Model.Lifecycle" />
            <input type="hidden" name="Sort" value="@Model.Sort" data-project-sort-field />
            <input type="hidden" name="Dir" value="@Model.Dir" data-project-sort-direction-field />
            @* The quick-filter menus' values. Always present, so a live menu or chip click (which
               syncs the form from its link) keeps them for the next search. *@
            <input type="hidden" name="LeadPoUserId" value="@Model.LeadPoUserId" />
            <input type="hidden" name="HodUserId" value="@Model.HodUserId" />
            <input type="hidden" name="CategoryId" value="@Model.CategoryId" />
            <input type="hidden" name="Build" value="@Model.Build" />
            <input type="hidden" name="Mine" value="@(Model.Mine ? "true" : null)" />
            @* Filters that arrive by link or from the Active pipeline ride along as hidden fields. *@
            @if (Model.CompletedFrom.HasValue) { <input type="hidden" name="CompletedFrom" value="@ProjectManagement.Pages.Projects.IndexModel.DayValue(Model.CompletedFrom)" /> }
            @if (Model.CompletedTo.HasValue) { <input type="hidden" name="CompletedTo" value="@ProjectManagement.Pages.Projects.IndexModel.DayValue(Model.CompletedTo)" /> }
            @if (Model.StageCompletedFrom.HasValue) { <input type="hidden" name="StageCompletedFrom" value="@ProjectManagement.Pages.Projects.IndexModel.DayValue(Model.StageCompletedFrom)" /> }
            @if (Model.StageCompletedTo.HasValue) { <input type="hidden" name="StageCompletedTo" value="@ProjectManagement.Pages.Projects.IndexModel.DayValue(Model.StageCompletedTo)" /> }
            @if (!string.IsNullOrWhiteSpace(Model.StageCode)) { <input type="hidden" name="StageCode" value="@Model.StageCode" /> }
            @if (!string.IsNullOrWhiteSpace(Model.StageCompletedMonth)) { <input type="hidden" name="StageCompletedMonth" value="@Model.StageCompletedMonth" /> }
            @if (!string.IsNullOrWhiteSpace(Model.SlipBucket)) { <input type="hidden" name="SlipBucket" value="@Model.SlipBucket" /> }
            @if (Model.IncludeCategoryDescendants) { <input type="hidden" name="IncludeCategoryDescendants" value="true" /> }
            @if (!string.IsNullOrWhiteSpace(Model.CurrentStage)) { <input type="hidden" name="CurrentStage" value="@Model.CurrentStage" /> }
            @if (Model.Attention.HasValue) { <input type="hidden" name="Attention" value="@Model.Attention" /> }
            @if (Model.Record.HasValue) { <input type="hidden" name="Record" value="@Model.Record" /> }

            <div class="projects-toolbar__main">
                <label class="projects-search" for="Query">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input asp-for="Query"
                           class="form-control"
                           placeholder="Search by project, case file, officer or keyword"
                           autocomplete="off"
                           aria-controls="projectRepositoryResults"
                           aria-describedby="projectSearchStatus"
                           data-project-search />
                    <span class="projects-search__activity" data-project-search-activity hidden aria-hidden="true">
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    </span>
                    <span class="visually-hidden">Search projects</span>
                </label>

                <label class="projects-toolbar__page-size">
                    <span class="visually-hidden">Projects per page</span>
                    <select asp-for="PageSize" class="form-select" data-project-auto-submit title="Projects per page">
                        <option value="25">25 per page</option>
                        <option value="50">50 per page</option>
                        <option value="100">100 per page</option>
                        <option value="0">Show all</option>
                    </select>
                </label>
            </div>

            @* More filters: the rarer filters. The common ones are quick-filter menus. *@
            <div class="offcanvas offcanvas-end projects-filter-drawer" tabindex="-1" id="projectFilters" aria-labelledby="projectFiltersLabel">
                <div class="offcanvas-header">
                    <div>
                        <h2 class="offcanvas-title" id="projectFiltersLabel">More filters</h2>
                        <p class="projects-filter-drawer__subtitle">Officer, HoD, category and build are in the quick filters above the list.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body">
                    <section class="projects-filter-section">
                        <h3 class="projects-filter-section__title">Classification</h3>
                        <div class="projects-filter-grid">
                            <div>
                                <label asp-for="TechnicalCategoryId" class="form-label">Technical category</label>
                                <select asp-for="TechnicalCategoryId" class="form-select" asp-items="Model.TechnicalCategoryOptions"></select>
                            </div>
                        </div>

                        <div class="projects-filter-choice-group">
                            <span class="form-label">Project type</span>
                            <div class="projects-filter-choice-list projects-filter-choice-list--wrap">
                                <label class="projects-filter-choice">
                                    <input type="radio" name="ProjectTypeId" value="" checked="@(!Model.ProjectTypeId.HasValue && !Model.ProjectTypeUnclassified)" data-clear-unclassified />
                                    <span>All types</span>
                                </label>
                                @if (Model.ProjectTypeUnclassifiedCount > 0 || Model.ProjectTypeUnclassified)
                                {
                                    <label class="projects-filter-choice">
                                        <input type="radio" name="ProjectTypeUnclassified" value="true" checked="@Model.ProjectTypeUnclassified" data-project-type-unclassified />
                                        <span>Unclassified <small data-project-type-unclassified-count>@Model.ProjectTypeUnclassifiedCount</small></span>
                                    </label>
                                }
                                @foreach (var chip in projectTypeChips)
                                {
                                    <label class="projects-filter-choice">
                                        <input type="radio" name="ProjectTypeId" value="@chip.Id" checked="@(Model.ProjectTypeId == chip.Id)" data-project-type />
                                        <span>@chip.Name <small data-project-type-count-display="@chip.Id">@chip.Count</small></span>
                                    </label>
                                }
                            </div>
                        </div>
                    </section>

                    <section class="projects-filter-section">
                        <h3 class="projects-filter-section__title">Completion and records</h3>
                        <div class="projects-filter-grid">
                            <div>
                                <label asp-for="CompletedYear" class="form-label">Completion year</label>
                                <select asp-for="CompletedYear" class="form-select" asp-items="Model.CompletionYearOptions"></select>
                            </div>
                            <div>
                                <label asp-for="TotStatus" class="form-label">ToT status</label>
                                <select asp-for="TotStatus" class="form-select" asp-items="Model.TotStatusOptions"></select>
                            </div>
                        </div>
                        <label class="projects-filter-check">
                            <input class="form-check-input" type="checkbox" asp-for="IncludeArchived" />
                            <span>Include archived projects</span>
                        </label>
                    </section>
                </div>
                <div class="projects-filter-drawer__footer">
                    <a asp-page="./Index" asp-all-route-data="Model.BuildClearRoute()" class="btn btn-outline-secondary">Reset</a>
                    <button type="submit" class="btn btn-primary" data-project-filter-apply>
                        <i class="bi bi-funnel" aria-hidden="true"></i>
                        Show results
                    </button>
                </div>
            </div>
        </form>

        <partial name="_ProjectRepositoryResults" model="Model" />
        <partial name="_ProjectRepositoryLiveMetadata" model="Model" />

        <div id="projectSearchStatus"
             class="visually-hidden"
             role="status"
             aria-live="polite"
             aria-atomic="true"
             data-project-live-status></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/projects-index.js" asp-append-version="true"></script>
}
