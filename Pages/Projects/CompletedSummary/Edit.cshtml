@page "{id:int}"
@model ProjectManagement.Pages.Projects.CompletedSummary.EditModel
@using ProjectManagement.Services.Projects
@{
    ViewData["Title"] = "Edit technology and proliferation details";
    ViewData["UseFullWidth"] = true;
    ViewData["PageShell"] = "workspace";

    static string FormatMoney(decimal? value)
    {
        if (!value.HasValue) return "Not recorded";
        return value.Value >= 100m
            ? $"₹{value.Value / 100m:0.##} Cr"
            : $"₹{value.Value:0.##} L";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/projects-completed-summary-edit.css" asp-append-version="true" />
}

<div class="cpe">
    <header class="cpe-page-header">
        <div>
            <a href="@Model.BackUrl" class="cpe-back" data-cancel-edit>
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Completed projects
            </a>
            <div class="cpe-kicker">Completed-project assessment</div>
            <h1>Edit technology and proliferation details</h1>
            <p>@Model.ProjectName · Completed @(Model.CompletedYear?.ToString() ?? "year not recorded")</p>
        </div>
        <a asp-page="/Projects/Overview"
           asp-route-id="@Model.Input.ProjectId"
           class="cpe-open-project"
           data-cancel-edit>Open full project</a>
    </header>

    <section class="cpe-authoritative-strip" aria-label="Authoritative project information">
        <article>
            <span>Recorded development cost</span>
            <strong>@FormatMoney(Model.RecordedDevelopmentCostLakhs)</strong>
            <small>Managed in the project financial record</small>
        </article>
        <article>
            <span>Completion year</span>
            <strong>@(Model.CompletedYear?.ToString() ?? "Not recorded")</strong>
            <small>Managed in the project lifecycle record</small>
        </article>
        <article>
            <span>ToT status</span>
            <strong>@Model.TotStatusLabel</strong>
            <small>Managed in the project lifecycle workspace</small>
        </article>
    </section>

    <form method="post" class="cpe-form" data-completed-project-edit-form>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Input.ProjectId" />
        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="ModelOnly" class="cpe-validation-summary" role="alert"></div>

        <div class="cpe-layout">
            <div class="cpe-column">
                <section class="cpe-card" aria-labelledby="technologyHeading">
                    <div class="cpe-card-head">
                        <div>
                            <span>Assessment</span>
                            <h2 id="technologyHeading">Technology assessment</h2>
                        </div>
                    </div>

                    <div class="cpe-field">
                        <label asp-for="Input.TechStatus">Technology status</label>
                        <select asp-for="Input.TechStatus" asp-items="Model.TechStatusOptions"></select>
                        <span asp-validation-for="Input.TechStatus" class="cpe-field-error"></span>
                    </div>

                    <div class="cpe-field">
                        <label asp-for="Input.TechRemarks">Technology remarks</label>
                        <textarea asp-for="Input.TechRemarks" rows="4" maxlength="500" data-autogrow></textarea>
                        <span asp-validation-for="Input.TechRemarks" class="cpe-field-error"></span>
                    </div>
                </section>

                <section class="cpe-card" aria-labelledby="proliferationHeading">
                    <div class="cpe-card-head">
                        <div>
                            <span>Decision</span>
                            <h2 id="proliferationHeading">Availability for proliferation</h2>
                        </div>
                    </div>

                    <fieldset class="cpe-choice-field">
                        <legend>Recorded decision</legend>
                        <div class="cpe-choice-grid">
                            <label>
                                <input type="radio"
                                       name="Input.AvailableForProliferation"
                                       value=""
                                       checked="@(Model.Input.AvailableForProliferation is null ? "checked" : null)" />
                                <span><strong>Not assessed</strong><small>Decision is pending</small></span>
                            </label>
                            <label>
                                <input type="radio"
                                       name="Input.AvailableForProliferation"
                                       value="true"
                                       checked="@(Model.Input.AvailableForProliferation == true ? "checked" : null)" />
                                <span><strong>Available</strong><small>Available for proliferation</small></span>
                            </label>
                            <label>
                                <input type="radio"
                                       name="Input.AvailableForProliferation"
                                       value="false"
                                       checked="@(Model.Input.AvailableForProliferation == false ? "checked" : null)" />
                                <span><strong>Not available</strong><small>Reason must be recorded</small></span>
                            </label>
                        </div>
                    </fieldset>

                    <div class="cpe-field cpe-reason-field @(Model.Input.AvailableForProliferation == false ? string.Empty : "is-hidden")"
                         data-not-available-reason>
                        <label asp-for="Input.NotAvailableReason">Reason for non-availability <span aria-hidden="true">*</span></label>
                        <textarea asp-for="Input.NotAvailableReason"
                                  rows="3"
                                  maxlength="500"
                                  data-autogrow
                                  data-reason-input></textarea>
                        <span asp-validation-for="Input.NotAvailableReason" class="cpe-field-error"></span>
                    </div>
                    <p class="cpe-cleared-value-note" data-reason-clear-note hidden>
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        The recorded non-availability reason will be cleared when these changes are saved.
                    </p>

                    <div class="cpe-field">
                        <label asp-for="Input.ProliferationRemarks">Proliferation remarks</label>
                        <textarea asp-for="Input.ProliferationRemarks" rows="4" maxlength="500" data-autogrow></textarea>
                        <span asp-validation-for="Input.ProliferationRemarks" class="cpe-field-error"></span>
                    </div>
                </section>
            </div>

            <div class="cpe-column">
                <section class="cpe-card" aria-labelledby="proliferationCostHeading">
                    <div class="cpe-card-head">
                        <div>
                            <span>Proliferation</span>
                            <h2 id="proliferationCostHeading">Proliferation cost</h2>
                        </div>
                    </div>

                    <div class="cpe-field cpe-field-compact">
                        <label asp-for="Input.ProliferationCostLakhs">Proliferation cost (lakh)</label>
                        <div class="cpe-money-input">
                            <span aria-hidden="true">₹</span>
                            <input asp-for="Input.ProliferationCostLakhs"
                                   type="number"
                                   min="0.01"
                                   step="0.01"
                                   inputmode="decimal" />
                        </div>
                        <small class="cpe-field-note">Enter the indicative cost for one proliferation unit or package, as applicable.</small>
                        <span asp-validation-for="Input.ProliferationCostLakhs" class="cpe-field-error"></span>
                    </div>

                    <div class="cpe-field">
                        <label asp-for="Input.ProliferationCostRemarks">Proliferation cost remarks</label>
                        <textarea asp-for="Input.ProliferationCostRemarks" rows="4" maxlength="500" data-autogrow></textarea>
                        <span asp-validation-for="Input.ProliferationCostRemarks" class="cpe-field-error"></span>
                    </div>
                </section>

                <section class="cpe-card cpe-lpp-card" aria-labelledby="lppHeading">
                    <div class="cpe-card-head">
                        <div>
                            <span>Purchase history</span>
                            <h2 id="lppHeading">Latest purchase price records</h2>
                        </div>
                    </div>

                    @if (Model.Input.LppRecords == null || Model.Input.LppRecords.Count == 0)
                    {
                        <div class="cpe-empty-state">
                            <i class="bi bi-receipt" aria-hidden="true"></i>
                            <strong>No LPP record has been added</strong>
                            <span>Add a record when a purchase price becomes available.</span>
                        </div>
                    }
                    else
                    {
                        <div class="cpe-lpp-table-wrap">
                            <table class="cpe-lpp-table">
                                <thead>
                                    <tr>
                                        <th>Amount (lakh)</th>
                                        <th>Date</th>
                                        <th>Supply order number</th>
                                        <th>Supporting document</th>
                                        <th>Remarks</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < Model.Input.LppRecords.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                <input asp-for="Input.LppRecords[i].Id" type="hidden" />
                                                <input asp-for="Input.LppRecords[i].Amount" type="number" min="0" step="0.01" inputmode="decimal" />
                                                <span asp-validation-for="Input.LppRecords[i].Amount" class="cpe-field-error"></span>
                                            </td>
                                            <td>
                                                <input asp-for="Input.LppRecords[i].Date" type="date" />
                                                <span asp-validation-for="Input.LppRecords[i].Date" class="cpe-field-error"></span>
                                            </td>
                                            <td>
                                                <input asp-for="Input.LppRecords[i].SupplyOrderNumber" maxlength="64" />
                                                <span asp-validation-for="Input.LppRecords[i].SupplyOrderNumber" class="cpe-field-error"></span>
                                            </td>
                                            <td>
                                                <select asp-for="Input.LppRecords[i].DocumentId" asp-items="Model.DocumentOptions"></select>
                                                <span asp-validation-for="Input.LppRecords[i].DocumentId" class="cpe-field-error"></span>
                                            </td>
                                            <td>
                                                <input asp-for="Input.LppRecords[i].Remarks" maxlength="500" />
                                                <span asp-validation-for="Input.LppRecords[i].Remarks" class="cpe-field-error"></span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <details class="cpe-add-lpp" data-new-lpp-panel data-open-on-load="@Model.ShowNewLppEditor.ToString().ToLowerInvariant()">
                        <summary><i class="bi bi-plus-lg" aria-hidden="true"></i> Add LPP record</summary>
                        <div class="cpe-add-lpp-body">
                            <p>This record will be added when the page is saved.</p>
                            <div class="cpe-lpp-form-grid">
                                <div class="cpe-field">
                                    <label asp-for="Input.NewLppAmount">Amount (lakh)</label>
                                    <input asp-for="Input.NewLppAmount" type="number" min="0" step="0.01" inputmode="decimal" data-new-lpp-input />
                                    <span asp-validation-for="Input.NewLppAmount" class="cpe-field-error"></span>
                                </div>
                                <div class="cpe-field">
                                    <label asp-for="Input.NewLppDate">Date</label>
                                    <input asp-for="Input.NewLppDate" type="date" data-new-lpp-input />
                                    <span asp-validation-for="Input.NewLppDate" class="cpe-field-error"></span>
                                </div>
                                <div class="cpe-field">
                                    <label asp-for="Input.NewSupplyOrderNumber">Supply order number</label>
                                    <input asp-for="Input.NewSupplyOrderNumber" maxlength="64" data-new-lpp-input />
                                    <span asp-validation-for="Input.NewSupplyOrderNumber" class="cpe-field-error"></span>
                                </div>
                                <div class="cpe-field">
                                    <label asp-for="Input.NewProjectDocumentId" title="Upload and publish the project document before selecting it here.">Supporting document</label>
                                    <select asp-for="Input.NewProjectDocumentId" asp-items="Model.DocumentOptions" data-new-lpp-input></select>
                                    <span asp-validation-for="Input.NewProjectDocumentId" class="cpe-field-error"></span>
                                </div>
                                <div class="cpe-field cpe-field-full">
                                    <label asp-for="Input.NewLppRemarks">Remarks</label>
                                    <textarea asp-for="Input.NewLppRemarks" rows="3" maxlength="500" data-new-lpp-input data-autogrow></textarea>
                                    <span asp-validation-for="Input.NewLppRemarks" class="cpe-field-error"></span>
                                </div>
                            </div>
                            <button type="button" class="cpe-text-button" data-cancel-new-lpp>Cancel new LPP entry</button>
                        </div>
                    </details>
                </section>
            </div>
        </div>

        <div class="cpe-action-bar">
            <div>
                <strong>Review the changes before saving.</strong>
                <span>Authoritative development cost and ToT information remain managed in the full project workspace.</span>
            </div>
            <div class="cpe-action-buttons">
                <a href="@Model.BackUrl" class="cpe-button cpe-button-secondary" data-cancel-edit>Cancel</a>
                <button type="submit" class="cpe-button cpe-button-primary" data-save-button>
                    <span data-save-label>Save changes</span>
                    <span data-saving-label hidden>Saving…</span>
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pages/projects-completed-summary-edit.js" asp-append-version="true"></script>
}
