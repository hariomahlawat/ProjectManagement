@page
@model ProjectManagement.Pages.Projects.CompletedSummary.IndexModel
@using ProjectManagement.Models
@using ProjectManagement.Models.Projects
@using ProjectManagement.Services.Projects
@using System.Globalization
@{
    ViewData["Title"] = "Completed projects";
    ViewData["UseFullWidth"] = true;

    var items = Model.Items;
    var overview = Model.Overview;
    var total = items.Count;
    var projectLabel = total == 1 ? "project" : "projects";
    var criticalCompletenessScore = total == 0
        ? 0
        : Math.Round((total - overview.CriticalIncompleteCount) * 100d / total);

    var criticalItems = items
        .Where(x => CompletedProjectPortfolioPolicy.GetCriticalMissingCount(x) > 0)
        .OrderByDescending(CompletedProjectPortfolioPolicy.GetCriticalMissingCount)
        .ThenByDescending(CompletedProjectPortfolioPolicy.GetSupplementaryMissingCount)
        .ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();

    var supplementaryOnlyItems = items
        .Where(x => CompletedProjectPortfolioPolicy.GetCriticalMissingCount(x) == 0
                    && CompletedProjectPortfolioPolicy.GetSupplementaryMissingCount(x) > 0)
        .OrderByDescending(CompletedProjectPortfolioPolicy.GetSupplementaryMissingCount)
        .ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();

    var nameSort = (Aria: Model.GetSortAria("name"), Direction: Model.NextSortDirection("name"), Indicator: Model.GetSortIndicator("name"));
    var yearSort = (Aria: Model.GetSortAria("year"), Direction: Model.NextSortDirection("year"), Indicator: Model.GetSortIndicator("year"));
    var rdSort = (Aria: Model.GetSortAria("rd"), Direction: Model.NextSortDirection("rd"), Indicator: Model.GetSortIndicator("rd"));
    var productionSort = (Aria: Model.GetSortAria("prod"), Direction: Model.NextSortDirection("prod"), Indicator: Model.GetSortIndicator("prod"));
    var lppSort = (Aria: Model.GetSortAria("lpp"), Direction: Model.NextSortDirection("lpp"), Indicator: Model.GetSortIndicator("lpp"));
    var technologySort = (Aria: Model.GetSortAria("tech"), Direction: Model.NextSortDirection("tech"), Indicator: Model.GetSortIndicator("tech"));
    var availabilitySort = (Aria: Model.GetSortAria("avail"), Direction: Model.NextSortDirection("avail"), Indicator: Model.GetSortIndicator("avail"));
    var totSort = (Aria: Model.GetSortAria("tot"), Direction: Model.NextSortDirection("tot"), Indicator: Model.GetSortIndicator("tot"));
    var qualitySort = (Aria: Model.GetSortAria("quality"), Direction: Model.NextSortDirection("quality"), Indicator: Model.GetSortIndicator("quality"));

    static string FormatMoney(decimal? value)
    {
        if (!value.HasValue) return "—";
        return value.Value >= 100m
            ? $"₹{value.Value / 100m:0.##} Cr"
            : $"₹{value.Value:0.##} L";
    }

    static string TechnologyTone(string? status)
    {
        if (string.Equals(status, ProjectTechStatusCodes.Current, StringComparison.OrdinalIgnoreCase)) return "positive";
        if (string.Equals(status, ProjectTechStatusCodes.Outdated, StringComparison.OrdinalIgnoreCase)) return "warning";
        if (string.Equals(status, ProjectTechStatusCodes.Obsolete, StringComparison.OrdinalIgnoreCase)) return "negative";
        return "muted";
    }

    static string AvailabilityTone(bool? available) => available switch
    {
        true => "positive",
        false => "negative",
        _ => "muted"
    };

    static string TotTone(ProjectTotStatus? status) => status switch
    {
        ProjectTotStatus.Completed => "positive",
        ProjectTotStatus.NotRequired => "neutral",
        ProjectTotStatus.InProgress => "info",
        ProjectTotStatus.NotStarted => "warning",
        _ => "muted"
    };

    static string JoinFields(IReadOnlyList<string> fields) => string.Join(", ", fields);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/projects-completed-summary.css" asp-append-version="true" />
}

<div class="cpw" data-default-view="register" data-requested-view="@Model.WorkspaceView">
    <header class="cpw-commandbar">
        <div class="cpw-titleblock">
            <div class="cpw-kicker">Completed project portfolio</div>
            <div class="cpw-titleline">
                <h1>Completed projects</h1>
                <span class="cpw-count">@total</span>
            </div>
            <p>Readiness, technology health, transfer-of-technology maturity and financial visibility.</p>
        </div>
        <div class="cpw-command-actions">
            <button type="button"
                    class="cpw-btn cpw-btn-ghost"
                    data-filter-toggle
                    aria-expanded="@Model.HasActiveFilters.ToString().ToLowerInvariant()"
                    aria-controls="cpwFilters">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" /></svg>
                Filters
                @if (Model.HasActiveFilters)
                {
                    <span class="cpw-filter-count">@Model.ActiveFilterCount</span>
                }
            </button>
            <a asp-page="./Index"
               asp-page-handler="Export"
               asp-route-TechnicalCategoryId="@Model.TechnicalCategoryId"
               asp-route-TechStatus="@Model.TechStatus"
               asp-route-AvailableForProliferation="@Model.AvailableForProliferation"
               asp-route-TotCompleted="@Model.TotCompleted"
               asp-route-CompletedYear="@Model.CompletedYear"
               asp-route-Search="@Model.Search"
               asp-route-Build="@Model.Build"
               asp-route-PortfolioStatus="@Model.PortfolioStatus"
               asp-route-Sort="@Model.Sort"
               asp-route-Dir="@Model.Dir"
               class="cpw-btn cpw-btn-primary">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 19h14" /></svg>
                Export register
            </a>
        </div>
    </header>

    <section class="cpw-filter-panel @(Model.HasActiveFilters ? "is-open" : string.Empty)"
             id="cpwFilters"
             data-filter-panel>
        <form method="get" id="cpwFiltersForm" class="cpw-filter-form">
            <div class="cpw-search-field">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <input asp-for="Search" placeholder="Search by project name…" autocomplete="off" />
            </div>
            <label class="cpw-field"><span>Portfolio position</span><select asp-for="PortfolioStatus" asp-items="Model.PortfolioStatusOptions"></select></label>
            <label class="cpw-field"><span>Technical category</span><select asp-for="TechnicalCategoryId" asp-items="Model.TechnicalCategoryOptions"></select></label>
            <label class="cpw-field"><span>Technology</span><select asp-for="TechStatus" asp-items="Model.TechStatusOptions"></select></label>
            <label class="cpw-field"><span>Completion year</span><input asp-for="CompletedYear" inputmode="numeric" placeholder="All years" /></label>
            <label class="cpw-field"><span>Proliferation</span><select asp-for="AvailableForProliferation" asp-items="Model.AvailabilityOptions"></select></label>
            <label class="cpw-field"><span>ToT</span><select asp-for="TotCompleted" asp-items="Model.TotStatusOptions"></select></label>
            <div class="cpw-build-field">
                <span>Build type</span>
                <div class="cpw-segmented">
                    <label><input type="radio" name="Build" value="" @(string.IsNullOrWhiteSpace(Model.Build) ? "checked" : null) /><span>All</span></label>
                    <label><input type="radio" name="Build" value="New" @(string.Equals(Model.Build, "New", StringComparison.OrdinalIgnoreCase) ? "checked" : null) /><span>New</span></label>
                    <label><input type="radio" name="Build" value="Rebuild" @(string.Equals(Model.Build, "Rebuild", StringComparison.OrdinalIgnoreCase) ? "checked" : null) /><span>Rebuild</span></label>
                </div>
            </div>
            <input type="hidden" asp-for="Sort" />
            <input type="hidden" asp-for="Dir" />
            <div class="cpw-filter-actions">
                @if (Model.HasActiveFilters)
                {
                    <a asp-page="./Index" class="cpw-btn cpw-btn-ghost">Clear all</a>
                }
                <button type="submit" class="cpw-btn cpw-btn-primary">Apply filters</button>
            </div>
        </form>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.PortfolioStatus))
    {
        <div class="cpw-active-scope">
            <span>Portfolio position</span>
            <strong>@CompletedProjectPortfolioStatusCodes.GetLabel(Model.PortfolioStatus)</strong>
            <a asp-page="./Index"
               asp-route-TechnicalCategoryId="@Model.TechnicalCategoryId"
               asp-route-TechStatus="@Model.TechStatus"
               asp-route-AvailableForProliferation="@Model.AvailableForProliferation"
               asp-route-TotCompleted="@Model.TotCompleted"
               asp-route-CompletedYear="@Model.CompletedYear"
               asp-route-Search="@Model.Search"
               asp-route-Build="@Model.Build"
               asp-route-Sort="@Model.Sort"
               asp-route-Dir="@Model.Dir">Remove</a>
        </div>
    }

    <section class="cpw-summary-strip" aria-label="Portfolio position summary">
        <article class="cpw-summary-card neutral">
            <span class="cpw-summary-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3" /><path d="M8 9h8M8 13h8M8 17h5" /></svg></span>
            <span><strong>@overview.TotalCount</strong><small>Completed projects</small></span>
        </article>
        <article class="cpw-summary-card info">
            <span class="cpw-summary-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18V8l8-4 8 4v10" /><path d="M8 18v-5h8v5" /></svg></span>
            <span><strong>@overview.AvailableCount</strong><small>Available for proliferation</small></span>
        </article>
        <article class="cpw-summary-card positive">
            <span class="cpw-summary-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg></span>
            <span><strong>@overview.FullyReadyCount</strong><small>Fully ready</small></span>
        </article>
        <article class="cpw-summary-card warning">
            <span class="cpw-summary-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8v5m0 3h.01M10.3 4.5 3.7 16a2 2 0 0 0 1.7 3h13.2a2 2 0 0 0 1.7-3L13.7 4.5a2 2 0 0 0-3.4 0Z" /></svg></span>
            <span><strong>@overview.AvailableBlockedCount</strong><small>Available but blocked</small></span>
        </article>
        <article class="cpw-summary-card danger">
            <span class="cpw-summary-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v4m0 10v4M3 12h4m10 0h4M5.6 5.6l2.8 2.8m7.2 7.2 2.8 2.8m0-12.8-2.8 2.8m-7.2 7.2-2.8 2.8" /><circle cx="12" cy="12" r="3" /></svg></span>
            <span><strong>@overview.TechnologyActionCount</strong><small>Technology action required</small></span>
        </article>
        <article class="cpw-summary-card critical">
            <span class="cpw-summary-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM8 9h8M8 13h5" /></svg></span>
            <span><strong>@overview.CriticalIncompleteCount</strong><small>Critical records incomplete</small></span>
        </article>
    </section>

    <div class="cpw-workspace-toolbar">
        <div class="cpw-view-tabs" role="tablist" aria-label="Completed-project workspace">
            <button type="button" id="cpw-tab-register" class="is-active" data-view="register" role="tab" aria-controls="cpw-panel-register" aria-selected="true">Register</button>
            <button type="button" id="cpw-tab-overview" data-view="overview" role="tab" aria-controls="cpw-panel-overview" aria-selected="false">Overview</button>
            <button type="button" id="cpw-tab-quality" data-view="quality" role="tab" aria-controls="cpw-panel-quality" aria-selected="false">Data quality</button>
        </div>
        <div class="cpw-workspace-meta"><strong>@total</strong> @projectLabel in current scope</div>
    </div>

    <main class="cpw-workspace">
        <section class="cpw-view is-active"
                 id="cpw-panel-register"
                 data-view-panel="register"
                 role="tabpanel"
                 aria-labelledby="cpw-tab-register">
            @if (total == 0)
            {
                <div class="cpw-empty"><h2>No completed projects found</h2><p>Adjust or clear the selected filters.</p></div>
            }
            else
            {
                <div class="cpw-register-shell">
                    <div class="cpw-register-head">
                        <div><h2>Portfolio register</h2><p>High-density comparison across completion, cost, readiness and record quality.</p></div>
                        <span>@total record@(total == 1 ? string.Empty : "s")</span>
                    </div>
                    <div class="cpw-table-scroll">
                        <table class="cpw-table">
                            <thead>
                                <tr>
                                    <th aria-sort="@nameSort.Aria">
                                        <a asp-page="./Index" asp-route-TechnicalCategoryId="@Model.TechnicalCategoryId" asp-route-TechStatus="@Model.TechStatus" asp-route-AvailableForProliferation="@Model.AvailableForProliferation" asp-route-TotCompleted="@Model.TotCompleted" asp-route-CompletedYear="@Model.CompletedYear" asp-route-Search="@Model.Search" asp-route-Build="@Model.Build" asp-route-PortfolioStatus="@Model.PortfolioStatus" asp-route-Sort="name" asp-route-Dir="@nameSort.Direction">Project <span aria-hidden="true">@nameSort.Indicator</span></a>
                                    </th>
                                    <th aria-sort="@yearSort.Aria">
                                        <a asp-page="./Index" asp-route-TechnicalCategoryId="@Model.TechnicalCategoryId" asp-route-TechStatus="@Model.TechStatus" asp-route-AvailableForProliferation="@Model.AvailableForProliferation" asp-route-TotCompleted="@Model.TotCompleted" asp-route-CompletedYear="@Model.CompletedYear" asp-route-Search="@Model.Search" asp-route-Build="@Model.Build" asp-route-PortfolioStatus="@Model.PortfolioStatus" asp-route-Sort="year" asp-route-Dir="@yearSort.Direction">Completed <span aria-hidden="true">@yearSort.Indicator</span></a>
                                    </th>
                                    <th aria-sort="@rdSort.Aria">
                                        <a asp-page="./Index" asp-route-TechnicalCategoryId="@Model.TechnicalCategoryId" asp-route-TechStatus="@Model.TechStatus" asp-route-AvailableForProliferation="@Model.AvailableForProliferation" asp-route-TotCompleted="@Model.TotCompleted" asp-route-CompletedYear="@Model.CompletedYear" asp-route-Search="@Model.Search" asp-route-Build="@Model.Build" asp-route-PortfolioStatus="@Model.PortfolioStatus" asp-route-Sort="rd" asp-route-Dir="@rdSort.Direction">Development <span aria-hidden="true">@rdSort.Indicator</span></a>
                                    </th>
                                    <th aria-sort="@productionSort.Aria">
                                        <a asp-page="./Index" asp-route-TechnicalCategoryId="@Model.TechnicalCategoryId" asp-route-TechStatus="@Model.TechStatus" asp-route-AvailableForProliferation="@Model.AvailableForProliferation" asp-route-TotCompleted="@Model.TotCompleted" asp-route-CompletedYear="@Model.CompletedYear" asp-route-Search="@Model.Search" asp-route-Build="@Model.Build" asp-route-PortfolioStatus="@Model.PortfolioStatus" asp-route-Sort="prod" asp-route-Dir="@productionSort.Direction">Production <span aria-hidden="true">@productionSort.Indicator</span></a>
                                    </th>
                                    <th aria-sort="@lppSort.Aria">
                                        <a asp-page="./Index" asp-route-TechnicalCategoryId="@Model.TechnicalCategoryId" asp-route-TechStatus="@Model.TechStatus" asp-route-AvailableForProliferation="@Model.AvailableForProliferation" asp-route-TotCompleted="@Model.TotCompleted" asp-route-CompletedYear="@Model.CompletedYear" asp-route-Search="@Model.Search" asp-route-Build="@Model.Build" asp-route-PortfolioStatus="@Model.PortfolioStatus" asp-route-Sort="lpp" asp-route-Dir="@lppSort.Direction">Latest LPP <span aria-hidden="true">@lppSort.Indicator</span></a>
                                    </th>
                                    <th aria-sort="@technologySort.Aria">
                                        <a asp-page="./Index" asp-route-TechnicalCategoryId="@Model.TechnicalCategoryId" asp-route-TechStatus="@Model.TechStatus" asp-route-AvailableForProliferation="@Model.AvailableForProliferation" asp-route-TotCompleted="@Model.TotCompleted" asp-route-CompletedYear="@Model.CompletedYear" asp-route-Search="@Model.Search" asp-route-Build="@Model.Build" asp-route-PortfolioStatus="@Model.PortfolioStatus" asp-route-Sort="tech" asp-route-Dir="@technologySort.Direction">Technology <span aria-hidden="true">@technologySort.Indicator</span></a>
                                    </th>
                                    <th aria-sort="@availabilitySort.Aria">
                                        <a asp-page="./Index" asp-route-TechnicalCategoryId="@Model.TechnicalCategoryId" asp-route-TechStatus="@Model.TechStatus" asp-route-AvailableForProliferation="@Model.AvailableForProliferation" asp-route-TotCompleted="@Model.TotCompleted" asp-route-CompletedYear="@Model.CompletedYear" asp-route-Search="@Model.Search" asp-route-Build="@Model.Build" asp-route-PortfolioStatus="@Model.PortfolioStatus" asp-route-Sort="avail" asp-route-Dir="@availabilitySort.Direction">Proliferation <span aria-hidden="true">@availabilitySort.Indicator</span></a>
                                    </th>
                                    <th aria-sort="@totSort.Aria">
                                        <a asp-page="./Index" asp-route-TechnicalCategoryId="@Model.TechnicalCategoryId" asp-route-TechStatus="@Model.TechStatus" asp-route-AvailableForProliferation="@Model.AvailableForProliferation" asp-route-TotCompleted="@Model.TotCompleted" asp-route-CompletedYear="@Model.CompletedYear" asp-route-Search="@Model.Search" asp-route-Build="@Model.Build" asp-route-PortfolioStatus="@Model.PortfolioStatus" asp-route-Sort="tot" asp-route-Dir="@totSort.Direction">ToT <span aria-hidden="true">@totSort.Indicator</span></a>
                                    </th>
                                    <th aria-sort="@qualitySort.Aria">
                                        <a asp-page="./Index" asp-route-TechnicalCategoryId="@Model.TechnicalCategoryId" asp-route-TechStatus="@Model.TechStatus" asp-route-AvailableForProliferation="@Model.AvailableForProliferation" asp-route-TotCompleted="@Model.TotCompleted" asp-route-CompletedYear="@Model.CompletedYear" asp-route-Search="@Model.Search" asp-route-Build="@Model.Build" asp-route-PortfolioStatus="@Model.PortfolioStatus" asp-route-Sort="quality" asp-route-Dir="@qualitySort.Direction">Data quality <span aria-hidden="true">@qualitySort.Indicator</span></a>
                                    </th>
                                    <th><span class="visually-hidden">Open</span></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in items)
                            {
                                var criticalMissing = CompletedProjectPortfolioPolicy.GetCriticalMissingFields(item);
                                var supplementaryMissing = CompletedProjectPortfolioPolicy.GetSupplementaryMissingFields(item);
                                var qualityTitle = criticalMissing.Count > 0
                                    ? $"Critical: {JoinFields(criticalMissing)}" + (supplementaryMissing.Count > 0 ? $"; Supplementary: {JoinFields(supplementaryMissing)}" : string.Empty)
                                    : supplementaryMissing.Count > 0
                                        ? $"Supplementary: {JoinFields(supplementaryMissing)}"
                                        : "All portfolio fields recorded";
                                <tr>
                                    <td><button type="button" class="cpw-project-link" data-open-project="@item.ProjectId">@item.Name</button></td>
                                    <td>@(item.CompletedYear?.ToString(CultureInfo.InvariantCulture) ?? "—")</td>
                                    <td class="cpw-num">@FormatMoney(item.RdCostLakhs)</td>
                                    <td class="cpw-num">@FormatMoney(item.ApproxProductionCost)</td>
                                    <td class="cpw-num">@(item.LatestLpp is null ? "—" : FormatMoney(item.LatestLpp.Amount))</td>
                                    <td><span class="cpw-inline-status @TechnologyTone(item.TechStatus)">@CompletedProjectPortfolioPolicy.GetTechnologyLabel(item.TechStatus)</span></td>
                                    <td><span class="cpw-inline-status @AvailabilityTone(item.AvailableForProliferation)">@CompletedProjectPortfolioPolicy.GetAvailabilityLabel(item.AvailableForProliferation)</span></td>
                                    <td><span class="cpw-inline-status @TotTone(item.TotStatus)">@CompletedProjectPortfolioPolicy.GetTotLabel(item.TotStatus)</span></td>
                                    <td title="@qualityTitle">
                                        @if (criticalMissing.Count > 0)
                                        {
                                            <span class="cpw-quality-score critical">@criticalMissing.Count critical</span>
                                        }
                                        else if (supplementaryMissing.Count > 0)
                                        {
                                            <span class="cpw-quality-score supplementary">@supplementaryMissing.Count supplementary</span>
                                        }
                                        else
                                        {
                                            <span class="cpw-quality-score complete">Complete</span>
                                        }
                                    </td>
                                    <td><button type="button" class="cpw-row-open" data-open-project="@item.ProjectId" aria-label="Open @item.Name">→</button></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </section>

        <section class="cpw-view"
                 id="cpw-panel-overview"
                 data-view-panel="overview"
                 role="tabpanel"
                 aria-labelledby="cpw-tab-overview"
                 hidden>
            @if (total == 0)
            {
                <div class="cpw-empty"><h2>No portfolio overview available</h2><p>Adjust or clear the selected filters.</p></div>
            }
            else
            {
                <div class="cpw-overview">
                    <section class="cpw-intelligence-grid" aria-label="Portfolio intelligence">
                        <article class="cpw-intelligence-card cpw-investment-card">
                            <div class="cpw-card-label">Recorded development cost</div>
                            <div class="cpw-investment-value">@FormatMoney(overview.RecordedDevelopmentCostLakhs)</div>
                            <div class="cpw-card-note">Across @overview.RecordedDevelopmentCostCount projects with recorded cost</div>
                        </article>

                        <article class="cpw-intelligence-card">
                            <div class="cpw-card-heading"><span>Technology health</span><strong>@overview.TechnologyCurrentCount current</strong></div>
                            <div class="cpw-stacked-bar" aria-label="Technology status distribution">
                                <span class="is-current" style="width:@(overview.TechnologyCurrentCount * 100d / total)%"></span>
                                <span class="is-outdated" style="width:@(overview.TechnologyOutdatedCount * 100d / total)%"></span>
                                <span class="is-obsolete" style="width:@(overview.TechnologyObsoleteCount * 100d / total)%"></span>
                                <span class="is-unknown" style="width:@(overview.TechnologyAssessmentPendingCount * 100d / total)%"></span>
                            </div>
                            <div class="cpw-bar-legend">
                                <span><i class="current"></i>Current @overview.TechnologyCurrentCount</span>
                                <span><i class="outdated"></i>Outdated @overview.TechnologyOutdatedCount</span>
                                <span><i class="obsolete"></i>Obsolete @overview.TechnologyObsoleteCount</span>
                                <span><i class="unknown"></i>Not assessed @overview.TechnologyAssessmentPendingCount</span>
                            </div>
                        </article>

                        <article class="cpw-intelligence-card">
                            <div class="cpw-card-heading"><span>Portfolio age profile</span><strong>@overview.Age0To5Count completed in last 5 years</strong></div>
                            <div class="cpw-age-bar" aria-label="Completed project age distribution">
                                <span class="age-new" style="width:@(overview.Age0To5Count * 100d / total)%" title="0–5 years: @overview.Age0To5Count"></span>
                                <span class="age-mid" style="width:@(overview.Age6To10Count * 100d / total)%" title="6–10 years: @overview.Age6To10Count"></span>
                                <span class="age-mature" style="width:@(overview.Age11To15Count * 100d / total)%" title="11–15 years: @overview.Age11To15Count"></span>
                                <span class="age-legacy" style="width:@(overview.Age16PlusCount * 100d / total)%" title="16+ years: @overview.Age16PlusCount"></span>
                                <span class="age-unknown" style="width:@(overview.AgeUnknownCount * 100d / total)%" title="Year not recorded: @overview.AgeUnknownCount"></span>
                            </div>
                            <div class="cpw-age-bands">
                                <span><i class="new"></i><b>@overview.Age0To5Count</b><small>0–5 yrs</small></span>
                                <span><i class="mid"></i><b>@overview.Age6To10Count</b><small>6–10 yrs</small></span>
                                <span><i class="mature"></i><b>@overview.Age11To15Count</b><small>11–15 yrs</small></span>
                                <span><i class="legacy"></i><b>@overview.Age16PlusCount</b><small>16+ yrs</small></span>
                                @if (overview.AgeUnknownCount > 0)
                                {
                                    <span><i class="unknown"></i><b>@overview.AgeUnknownCount</b><small>Unknown</small></span>
                                }
                            </div>
                        </article>
                    </section>

                    <section class="cpw-readiness-grid">
                        <article class="cpw-overview-card">
                            <div class="cpw-section-heading"><div><span>Readiness position</span><h2>Proliferation posture</h2></div><small>Current filtered scope</small></div>
                            <div class="cpw-position-list">
                                <div><span><i class="positive"></i>Fully ready</span><strong>@overview.FullyReadyCount</strong></div>
                                <div><span><i class="warning"></i>Available but blocked</span><strong>@overview.AvailableBlockedCount</strong></div>
                                <div><span><i class="negative"></i>Not available</span><strong>@overview.NotAvailableCount</strong></div>
                                <div><span><i class="muted"></i>Decision not recorded</span><strong>@overview.AvailabilityPendingCount</strong></div>
                            </div>
                            <p class="cpw-definition">Fully ready means current technology, marked available for proliferation, with ToT completed or not required.</p>
                        </article>

                        <article class="cpw-overview-card">
                            <div class="cpw-section-heading">
                                <div><span>Exploitation candidates</span><h2>Fully ready projects</h2></div>
                                <a asp-page="./Index" asp-route-TechnicalCategoryId="@Model.TechnicalCategoryId" asp-route-TechStatus="@Model.TechStatus" asp-route-AvailableForProliferation="@Model.AvailableForProliferation" asp-route-TotCompleted="@Model.TotCompleted" asp-route-CompletedYear="@Model.CompletedYear" asp-route-Search="@Model.Search" asp-route-Build="@Model.Build" asp-route-PortfolioStatus="@CompletedProjectPortfolioStatusCodes.FullyReady" asp-route-WorkspaceView="register" asp-route-Sort="year" asp-route-Dir="desc">View in register</a>
                            </div>
                            <div class="cpw-queue-list">
                                @if (overview.ReadyProjects.Count == 0)
                                {
                                    <div class="cpw-queue-empty">No project currently meets the full readiness rule.</div>
                                }
                                else
                                {
                                    @foreach (var item in overview.ReadyProjects)
                                    {
                                        <button type="button" class="cpw-queue-row" data-open-project="@item.ProjectId">
                                            <span><strong>@item.Name</strong><small>Completed @(item.CompletedYear?.ToString(CultureInfo.InvariantCulture) ?? "year not recorded")</small></span>
                                            <b>@FormatMoney(item.RdCostLakhs)</b>
                                        </button>
                                    }
                                }
                            </div>
                        </article>
                    </section>

                    <section class="cpw-action-grid" aria-label="Priority action queues">
                        <article class="cpw-action-card warning">
                            <div class="cpw-action-head">
                                <div><span>Readiness blocker</span><h3>Available but blocked</h3></div>
                                <strong>@overview.AvailableBlockedCount</strong>
                            </div>
                            <div class="cpw-action-list">
                                @if (overview.AvailableBlockedProjects.Count == 0)
                                {
                                    <p>No available project has an unresolved readiness blocker.</p>
                                }
                                else
                                {
                                    @foreach (var item in overview.AvailableBlockedProjects)
                                    {
                                        <button type="button" data-open-project="@item.ProjectId"><span>@item.Name</span><small>@CompletedProjectPortfolioPolicy.GetReadinessBlockers(item)</small></button>
                                    }
                                }
                            </div>
                            <a class="cpw-action-link" asp-page="./Index" asp-route-TechnicalCategoryId="@Model.TechnicalCategoryId" asp-route-TechStatus="@Model.TechStatus" asp-route-AvailableForProliferation="@Model.AvailableForProliferation" asp-route-TotCompleted="@Model.TotCompleted" asp-route-CompletedYear="@Model.CompletedYear" asp-route-Search="@Model.Search" asp-route-Build="@Model.Build" asp-route-PortfolioStatus="@CompletedProjectPortfolioStatusCodes.AvailableBlocked" asp-route-WorkspaceView="register" asp-route-Sort="year" asp-route-Dir="desc">Open filtered register →</a>
                        </article>

                        <article class="cpw-action-card danger">
                            <div class="cpw-action-head">
                                <div><span>Technology health</span><h3>Technology action required</h3></div>
                                <strong>@overview.TechnologyActionCount</strong>
                            </div>
                            <div class="cpw-action-list">
                                @if (overview.TechnologyActionProjects.Count == 0)
                                {
                                    <p>No project is marked outdated or obsolete.</p>
                                }
                                else
                                {
                                    @foreach (var item in overview.TechnologyActionProjects)
                                    {
                                        <button type="button" data-open-project="@item.ProjectId"><span>@item.Name</span><small>@CompletedProjectPortfolioPolicy.GetTechnologyLabel(item.TechStatus) · Completed @(item.CompletedYear?.ToString(CultureInfo.InvariantCulture) ?? "year not recorded")</small></button>
                                    }
                                }
                            </div>
                            <a class="cpw-action-link" asp-page="./Index" asp-route-TechnicalCategoryId="@Model.TechnicalCategoryId" asp-route-TechStatus="@Model.TechStatus" asp-route-AvailableForProliferation="@Model.AvailableForProliferation" asp-route-TotCompleted="@Model.TotCompleted" asp-route-CompletedYear="@Model.CompletedYear" asp-route-Search="@Model.Search" asp-route-Build="@Model.Build" asp-route-PortfolioStatus="@CompletedProjectPortfolioStatusCodes.TechnologyAction" asp-route-WorkspaceView="register" asp-route-Sort="year" asp-route-Dir="desc">Open filtered register →</a>
                        </article>

                        <article class="cpw-action-card info">
                            <div class="cpw-action-head">
                                <div><span>Transfer of technology</span><h3>ToT action pending</h3></div>
                                <strong>@overview.TotActionPendingCount</strong>
                            </div>
                            <div class="cpw-action-list">
                                @if (overview.TotActionProjects.Count == 0)
                                {
                                    <p>No project has ToT marked not started or in progress.</p>
                                }
                                else
                                {
                                    @foreach (var item in overview.TotActionProjects)
                                    {
                                        <button type="button" data-open-project="@item.ProjectId"><span>@item.Name</span><small>@CompletedProjectPortfolioPolicy.GetTotLabel(item.TotStatus) · @CompletedProjectPortfolioPolicy.GetAvailabilityLabel(item.AvailableForProliferation)</small></button>
                                    }
                                }
                            </div>
                            <a class="cpw-action-link" asp-page="./Index" asp-route-TechnicalCategoryId="@Model.TechnicalCategoryId" asp-route-TechStatus="@Model.TechStatus" asp-route-AvailableForProliferation="@Model.AvailableForProliferation" asp-route-TotCompleted="@Model.TotCompleted" asp-route-CompletedYear="@Model.CompletedYear" asp-route-Search="@Model.Search" asp-route-Build="@Model.Build" asp-route-PortfolioStatus="@CompletedProjectPortfolioStatusCodes.TotAction" asp-route-WorkspaceView="register" asp-route-Sort="year" asp-route-Dir="desc">Open filtered register →</a>
                        </article>
                    </section>

                    <section class="cpw-quality-callout">
                        <div class="cpw-quality-callout-score"><strong>@overview.CriticalIncompleteCount</strong><span>critical records incomplete</span></div>
                        <div><h2>Record quality is managed separately from readiness</h2><p>Critical fields are technology assessment, proliferation decision, ToT status and development cost. Production cost and latest LPP are supplementary fields.</p></div>
                        <button type="button" class="cpw-btn cpw-btn-ghost" data-open-view="quality">Open data quality</button>
                    </section>
                </div>
            }
        </section>

        <section class="cpw-view"
                 id="cpw-panel-quality"
                 data-view-panel="quality"
                 role="tabpanel"
                 aria-labelledby="cpw-tab-quality"
                 hidden>
            <div class="cpw-quality-layout">
                <aside class="cpw-quality-summary">
                    <div class="cpw-card-label">Critical completeness</div>
                    <div class="cpw-quality-donut" style="--score:@criticalCompletenessScore">
                        <strong>@criticalCompletenessScore%</strong><span>critical fields complete</span>
                    </div>
                    <dl class="cpw-quality-stats">
                        <div><dt>Critical incomplete</dt><dd>@overview.CriticalIncompleteCount</dd></div>
                        <div><dt>Supplementary incomplete</dt><dd>@overview.SupplementaryIncompleteCount</dd></div>
                        <div><dt>Fully complete</dt><dd>@overview.FullyCompleteCount</dd></div>
                    </dl>
                    <p>Critical: technology assessment, proliferation decision, ToT status and development cost.</p>
                    <p>Supplementary: production cost and latest LPP.</p>
                </aside>

                <div class="cpw-quality-content">
                    <section class="cpw-quality-section">
                        <div class="cpw-quality-list-head"><div><span>Priority 1</span><h2>Critical records requiring action</h2><p>Ordered by the number of missing critical fields.</p></div><strong>@criticalItems.Count</strong></div>
                        @if (criticalItems.Count == 0)
                        {
                            <div class="cpw-quality-empty">All records contain the four critical portfolio fields.</div>
                        }
                        else
                        {
                            <div class="cpw-quality-list">
                                @foreach (var item in criticalItems)
                                {
                                    var criticalMissing = CompletedProjectPortfolioPolicy.GetCriticalMissingFields(item);
                                    var supplementaryMissing = CompletedProjectPortfolioPolicy.GetSupplementaryMissingFields(item);
                                    <article class="cpw-quality-row">
                                        <div class="cpw-quality-rank critical">@criticalMissing.Count</div>
                                        <div class="cpw-quality-main">
                                            <button type="button" data-open-project="@item.ProjectId">@item.Name</button>
                                            <span>Critical: @JoinFields(criticalMissing)@(supplementaryMissing.Count > 0 ? $" · Supplementary: {JoinFields(supplementaryMissing)}" : string.Empty)</span>
                                        </div>
                                        <div class="cpw-quality-action">@criticalMissing.Count critical</div>
                                    </article>
                                }
                            </div>
                        }
                    </section>

                    <section class="cpw-quality-section supplementary">
                        <div class="cpw-quality-list-head"><div><span>Priority 2</span><h2>Supplementary information gaps</h2><p>Critical fields are complete; production cost or latest LPP remains unrecorded.</p></div><strong>@supplementaryOnlyItems.Count</strong></div>
                        @if (supplementaryOnlyItems.Count == 0)
                        {
                            <div class="cpw-quality-empty">No supplementary-only gaps in the current scope.</div>
                        }
                        else
                        {
                            <div class="cpw-quality-list">
                                @foreach (var item in supplementaryOnlyItems)
                                {
                                    var supplementaryMissing = CompletedProjectPortfolioPolicy.GetSupplementaryMissingFields(item);
                                    <article class="cpw-quality-row">
                                        <div class="cpw-quality-rank supplementary">@supplementaryMissing.Count</div>
                                        <div class="cpw-quality-main"><button type="button" data-open-project="@item.ProjectId">@item.Name</button><span>Supplementary: @JoinFields(supplementaryMissing)</span></div>
                                        <div class="cpw-quality-action">@supplementaryMissing.Count supplementary</div>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                </div>
            </div>
        </section>
    </main>

    @foreach (var item in items)
    {
        var criticalMissing = CompletedProjectPortfolioPolicy.GetCriticalMissingFields(item);
        var supplementaryMissing = CompletedProjectPortfolioPolicy.GetSupplementaryMissingFields(item);
        <template id="cpw-project-@item.ProjectId">
            <div class="cpw-drawer-content">
                <div class="cpw-drawer-kicker">Completed project · @(item.CompletedYear?.ToString(CultureInfo.InvariantCulture) ?? "Year not recorded")</div>
                <h2>@item.Name</h2>
                <div class="cpw-drawer-status-grid">
                    <div><span>Technology</span><strong>@CompletedProjectPortfolioPolicy.GetTechnologyLabel(item.TechStatus)</strong></div>
                    <div><span>Proliferation</span><strong>@CompletedProjectPortfolioPolicy.GetAvailabilityLabel(item.AvailableForProliferation)</strong></div>
                    <div><span>ToT</span><strong>@CompletedProjectPortfolioPolicy.GetTotLabel(item.TotStatus)</strong></div>
                </div>
                <div class="cpw-drawer-section">
                    <h3>Financial picture</h3>
                    <dl>
                        <div><dt>Development / L1 cost</dt><dd>@FormatMoney(item.RdCostLakhs)</dd></div>
                        <div><dt>Approx. production cost</dt><dd>@FormatMoney(item.ApproxProductionCost)</dd></div>
                        <div><dt>Latest LPP</dt><dd>@(item.LatestLpp is null ? "Not recorded" : $"{FormatMoney(item.LatestLpp.Amount)} · {item.LatestLpp.Date:dd MMM yyyy}")</dd></div>
                    </dl>
                </div>
                <div class="cpw-drawer-section">
                    <h3>Readiness</h3>
                    <p>@(CompletedProjectPortfolioPolicy.IsFullyReady(item) ? "Fully ready for proliferation." : CompletedProjectPortfolioPolicy.GetReadinessBlockers(item))</p>
                </div>
                <div class="cpw-drawer-section">
                    <h3>Data quality</h3>
                    @if (criticalMissing.Count == 0 && supplementaryMissing.Count == 0)
                    {
                        <p>All portfolio fields are recorded.</p>
                    }
                    else
                    {
                        @if (criticalMissing.Count > 0)
                        {
                            <p><strong>Critical:</strong> @JoinFields(criticalMissing)</p>
                        }
                        @if (supplementaryMissing.Count > 0)
                        {
                            <p><strong>Supplementary:</strong> @JoinFields(supplementaryMissing)</p>
                        }
                    }
                </div>
                <div class="cpw-drawer-section"><h3>Remarks</h3><p class="cpw-remarks">@(string.IsNullOrWhiteSpace(item.Remarks) ? "No remarks recorded." : item.Remarks)</p></div>
                @if (Model.CanEdit)
                {
                    <a asp-page="./Edit" asp-route-id="@item.ProjectId" class="cpw-btn cpw-btn-primary cpw-drawer-edit">Edit completed-project record</a>
                }
            </div>
        </template>
    }

    <div class="cpw-drawer-backdrop" data-drawer-backdrop hidden></div>
    <aside class="cpw-drawer"
           data-drawer
           role="dialog"
           aria-modal="true"
           aria-hidden="true"
           aria-labelledby="cpwDrawerTitle">
        <div class="cpw-drawer-header"><span id="cpwDrawerTitle">Project intelligence</span><button type="button" data-close-drawer aria-label="Close">×</button></div>
        <div data-drawer-body></div>
    </aside>
</div>

@section Scripts {
    <script src="~/js/pages/projects-completed-summary.js" asp-append-version="true"></script>
}
