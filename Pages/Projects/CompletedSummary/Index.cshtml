@page
@model ProjectManagement.Pages.Projects.CompletedSummary.IndexModel
@using ProjectManagement.Models
@using ProjectManagement.Models.Projects
@using ProjectManagement.Services.Projects
@{
    ViewData["Title"] = "Completed projects";
    ViewData["UseFullWidth"] = true;
    ViewData["PageShell"] = "workspace";

    var items = Model.Items;
    var overview = Model.Overview;
    var total = items.Count;
    var projectLabel = total == 1 ? "project" : "projects";
    var returnUrl = $"{Request.Path}{Request.QueryString}";
    var criticalCompletenessScore = total == 0
        ? 0
        : Math.Round((total - overview.CriticalIncompleteCount) * 100d / total);

    var criticalItems = items
        .Where(x => CompletedProjectPortfolioPolicy.GetCriticalMissingCount(x) > 0)
        .OrderByDescending(CompletedProjectPortfolioPolicy.GetCriticalMissingCount)
        .ThenByDescending(CompletedProjectPortfolioPolicy.GetSupplementaryMissingCount)
        .ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();

    var supplementaryOnlyItems = items
        .Where(x => CompletedProjectPortfolioPolicy.GetCriticalMissingCount(x) == 0
                    && CompletedProjectPortfolioPolicy.GetSupplementaryMissingCount(x) > 0)
        .OrderByDescending(CompletedProjectPortfolioPolicy.GetSupplementaryMissingCount)
        .ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();

    var nameSort = (Aria: Model.GetSortAria("name"), Direction: Model.NextSortDirection("name"), Indicator: Model.GetSortIndicator("name"));
    var completionSort = (Aria: Model.GetSortAria("completed"), Direction: Model.NextSortDirection("completed"), Indicator: Model.GetSortIndicator("completed"));
    var categorySort = (Aria: Model.GetSortAria("category"), Direction: Model.NextSortDirection("category"), Indicator: Model.GetSortIndicator("category"));
    var buildSort = (Aria: Model.GetSortAria("build"), Direction: Model.NextSortDirection("build"), Indicator: Model.GetSortIndicator("build"));
    var rdSort = (Aria: Model.GetSortAria("rd"), Direction: Model.NextSortDirection("rd"), Indicator: Model.GetSortIndicator("rd"));
    var productionSort = (Aria: Model.GetSortAria("prod"), Direction: Model.NextSortDirection("prod"), Indicator: Model.GetSortIndicator("prod"));
    var lppSort = (Aria: Model.GetSortAria("lpp"), Direction: Model.NextSortDirection("lpp"), Indicator: Model.GetSortIndicator("lpp"));
    var technologySort = (Aria: Model.GetSortAria("tech"), Direction: Model.NextSortDirection("tech"), Indicator: Model.GetSortIndicator("tech"));
    var availabilitySort = (Aria: Model.GetSortAria("avail"), Direction: Model.NextSortDirection("avail"), Indicator: Model.GetSortIndicator("avail"));
    var totSort = (Aria: Model.GetSortAria("tot"), Direction: Model.NextSortDirection("tot"), Indicator: Model.GetSortIndicator("tot"));
    var qualitySort = (Aria: Model.GetSortAria("quality"), Direction: Model.NextSortDirection("quality"), Indicator: Model.GetSortIndicator("quality"));

    static string FormatMoney(decimal? value)
    {
        if (!value.HasValue) return "—";
        return value.Value >= 100m
            ? $"₹{value.Value / 100m:0.##} Cr"
            : $"₹{value.Value:0.##} L";
    }

    static string TechnologyTone(string? status)
    {
        if (string.Equals(status, ProjectTechStatusCodes.Current, StringComparison.OrdinalIgnoreCase)) return "positive";
        if (string.Equals(status, ProjectTechStatusCodes.Outdated, StringComparison.OrdinalIgnoreCase)) return "warning";
        if (string.Equals(status, ProjectTechStatusCodes.Obsolete, StringComparison.OrdinalIgnoreCase)) return "negative";
        return "muted";
    }

    static string AvailabilityTone(bool? available) => available switch
    {
        true => "positive",
        false => "negative",
        _ => "muted"
    };

    static string TotTone(ProjectTotStatus? status) => status switch
    {
        ProjectTotStatus.Completed => "positive",
        ProjectTotStatus.NotRequired => "neutral",
        ProjectTotStatus.InProgress => "info",
        ProjectTotStatus.NotStarted => "warning",
        _ => "muted"
    };

    static string FormatLatestLpp(LatestLppViewModel? lpp)
    {
        if (lpp is null) return "Not recorded";
        return lpp.Date.HasValue
            ? $"{FormatMoney(lpp.Amount)} · {lpp.Date.Value:dd MMM yyyy}"
            : FormatMoney(lpp.Amount);
    }

    static string JoinFields(IReadOnlyList<string> fields) => string.Join(", ", fields);

    var editSuccessMessage = TempData["CompletedProjectEditSuccess"] as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/projects-completed-summary.css" asp-append-version="true" />
}

<div class="cpw"
     data-default-view="register"
     data-requested-view="@Model.WorkspaceView"
     data-success-message="@editSuccessMessage">
    @if (!string.IsNullOrWhiteSpace(editSuccessMessage))
    {
        <div class="cpw-success-banner" role="status">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
            <span>@editSuccessMessage</span>
        </div>
    }
    <header class="cpw-commandbar">
        <div class="cpw-titleblock">
            <div class="cpw-kicker">Completed project portfolio</div>
            <div class="cpw-titleline">
                <h1>Completed projects</h1>
                <span class="cpw-count">@total</span>
            </div>
            <p>Proliferation availability, technology health, transfer-of-technology maturity and financial visibility.</p>
        </div>
        <div class="cpw-command-actions">
            <button type="button"
                    class="cpw-btn cpw-btn-ghost"
                    data-filter-toggle
                    aria-expanded="@Model.HasActiveFilters.ToString().ToLowerInvariant()"
                    aria-controls="cpwFilters">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" /></svg>
                Filters
                @if (Model.HasActiveFilters)
                {
                    <span class="cpw-filter-count">@Model.ActiveFilterCount</span>
                }
            </button>
            <a asp-page="./Index"
               asp-page-handler="Export"
               asp-route-TechnicalCategoryId="@Model.TechnicalCategoryId"
               asp-route-TechStatus="@Model.TechStatus"
               asp-route-AvailableForProliferation="@Model.AvailableForProliferation"
               asp-route-TotCompleted="@Model.TotCompleted"
               asp-route-CompletedYear="@Model.CompletedYear"
               asp-route-Search="@Model.Search"
               asp-route-Build="@Model.Build"
               asp-route-PortfolioStatus="@Model.PortfolioStatus"
               asp-route-Sort="@Model.Sort"
               asp-route-Dir="@Model.Dir"
               class="cpw-btn cpw-btn-primary">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 19h14" /></svg>
                Export register
            </a>
        </div>
    </header>

    <section class="cpw-filter-panel @(Model.HasActiveFilters ? "is-open" : string.Empty)"
             id="cpwFilters"
             data-filter-panel>
        <form method="get" id="cpwFiltersForm" class="cpw-filter-form">
            <div class="cpw-search-field cpw-filter-search">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <input asp-for="Search" placeholder="Search by project name…" autocomplete="off" />
            </div>
            <label class="cpw-field cpw-filter-position"><span>Portfolio focus</span><select asp-for="PortfolioStatus" asp-items="Model.PortfolioStatusOptions"></select></label>
            <label class="cpw-field cpw-filter-category"><span>Technical category</span><select asp-for="TechnicalCategoryId" asp-items="Model.TechnicalCategoryOptions"></select></label>
            <label class="cpw-field cpw-filter-technology"><span>Technology</span><select asp-for="TechStatus" asp-items="Model.TechStatusOptions"></select></label>
            <label class="cpw-field cpw-filter-year"><span>Completion year</span><select asp-for="CompletedYear" asp-items="Model.CompletedYearOptions"></select></label>
            <label class="cpw-field cpw-filter-proliferation"><span>Availability</span><select asp-for="AvailableForProliferation" asp-items="Model.AvailabilityOptions"></select></label>
            <label class="cpw-field cpw-filter-tot"><span>ToT</span><select asp-for="TotCompleted" asp-items="Model.TotStatusOptions"></select></label>
            <div class="cpw-build-field cpw-filter-build">
                <span>Build type</span>
                <div class="cpw-segmented">
                    <label><input type="radio" name="Build" value="" @(string.IsNullOrWhiteSpace(Model.Build) ? "checked" : null) /><span>All</span></label>
                    <label><input type="radio" name="Build" value="New" @(string.Equals(Model.Build, "New", StringComparison.OrdinalIgnoreCase) ? "checked" : null) /><span>New</span></label>
                    <label><input type="radio" name="Build" value="Rebuild" @(string.Equals(Model.Build, "Rebuild", StringComparison.OrdinalIgnoreCase) ? "checked" : null) /><span>Rebuild</span></label>
                </div>
            </div>
            <input type="hidden" asp-for="Sort" />
            <input type="hidden" asp-for="Dir" />
            <input type="hidden" asp-for="WorkspaceView" data-workspace-view-input />
            <div class="cpw-filter-actions">
                @if (Model.HasActiveFilters)
                {
                    <a asp-page="./Index" asp-all-route-data="Model.GetClearFilterRoutes()" class="cpw-btn cpw-btn-ghost">Clear filters</a>
                }
                <button type="submit" class="cpw-btn cpw-btn-primary">Apply filters</button>
            </div>
        </form>
    </section>

    @if (Model.ActiveFilters.Count > 0)
    {
        <div class="cpw-active-filters" aria-label="Active filters">
            <span class="cpw-active-filters-label">Current scope</span>
            <div class="cpw-filter-chips">
                @foreach (var filter in Model.ActiveFilters)
                {
                    <a asp-page="./Index"
                       asp-all-route-data="Model.GetRoutesWithoutFilter(filter.Key)"
                       class="cpw-filter-chip"
                       title="Remove @filter.Label filter">
                        <span>@filter.Label</span>
                        <strong>@filter.Value</strong>
                        <b aria-hidden="true">×</b>
                    </a>
                }
            </div>
            <a asp-page="./Index"
               asp-all-route-data="Model.GetClearFilterRoutes()"
               class="cpw-clear-filters">Clear all</a>
        </div>
    }

    <section class="cpw-summary-strip" aria-label="Completed-project action summary">
        <a asp-page="./Index"
           asp-all-route-data="Model.GetRoutesForAvailability(true)"
           class="cpw-summary-card info"
           title="Open projects marked available for proliferation">
            <span class="cpw-summary-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18V8l8-4 8 4v10" /><path d="M8 18v-5h8v5" /></svg></span>
            <span><strong>@overview.AvailableCount</strong><small>Available for proliferation</small></span>
        </a>
        <a asp-page="./Index"
           asp-all-route-data="Model.GetRoutesForPortfolioStatus(CompletedProjectPortfolioStatusCodes.ProliferationAssessmentPending)"
           class="cpw-summary-card neutral"
           title="Open projects where the proliferation assessment is pending">
            <span class="cpw-summary-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM8 9h8M8 13h5" /><path d="M17 16h.01" /></svg></span>
            <span><strong>@overview.AvailabilityPendingCount</strong><small>Proliferation assessment pending</small></span>
        </a>
        <a asp-page="./Index"
           asp-all-route-data="Model.GetRoutesForPortfolioStatus(CompletedProjectPortfolioStatusCodes.TechnologyAction)"
           class="cpw-summary-card danger"
           title="Open projects requiring technology review">
            <span class="cpw-summary-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v4m0 10v4M3 12h4m10 0h4M5.6 5.6l2.8 2.8m7.2 7.2 2.8 2.8m0-12.8-2.8 2.8m-7.2 7.2-2.8 2.8" /><circle cx="12" cy="12" r="3" /></svg></span>
            <span><strong>@overview.TechnologyActionCount</strong><small>Technology review required</small></span>
        </a>
        <a asp-page="./Index"
           asp-all-route-data="Model.GetRoutesForPortfolioStatus(CompletedProjectPortfolioStatusCodes.TotAction)"
           class="cpw-summary-card tot"
           title="Open projects with pending ToT action">
            <span class="cpw-summary-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10H7z" /><path d="m4 12 3-3m-3 3 3 3m13-3-3-3m3 3-3 3" /></svg></span>
            <span><strong>@overview.TotActionPendingCount</strong><small>ToT action pending</small></span>
        </a>
        <a asp-page="./Index"
           asp-all-route-data="Model.GetRoutesForPortfolioStatus(CompletedProjectPortfolioStatusCodes.CriticalIncomplete)"
           class="cpw-summary-card critical"
           title="Open records with missing critical fields">
            <span class="cpw-summary-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM8 9h8M8 13h5" /></svg></span>
            <span><strong>@overview.CriticalIncompleteCount</strong><small>Records with critical gaps</small></span>
        </a>
    </section>

    <div class="cpw-workspace-toolbar">
        <div class="cpw-view-tabs" role="tablist" aria-label="Completed-project workspace">
            <button type="button" id="cpw-tab-register" class="is-active" data-view="register" role="tab" aria-controls="cpw-panel-register" aria-selected="true">Register</button>
            <button type="button" id="cpw-tab-overview" data-view="overview" role="tab" aria-controls="cpw-panel-overview" aria-selected="false">Overview</button>
            <button type="button" id="cpw-tab-quality" data-view="quality" role="tab" aria-controls="cpw-panel-quality" aria-selected="false">Data quality</button>
        </div>
        @if (Model.HasActiveFilters)
        {
            <div class="cpw-workspace-meta">
                <span>Showing <strong>@total</strong> @projectLabel in the current scope</span>
            </div>
        }
    </div>

    <main class="cpw-workspace">
        <section class="cpw-view is-active"
                 id="cpw-panel-register"
                 data-view-panel="register"
                 role="tabpanel"
                 aria-labelledby="cpw-tab-register">
            @if (total == 0)
            {
                <div class="cpw-empty"><h2>No completed projects found</h2><p>Adjust or clear the selected filters.</p></div>
            }
            else
            {
                <div class="cpw-register-shell">
                    <div class="cpw-register-head">
                        <div><h2>Completed projects register</h2><p>High-density comparison across completion, cost, proliferation and record quality.</p></div>
                        <span>Open a project name for details</span>
                    </div>
                    <div class="cpw-table-scroll" role="region" aria-label="Completed projects register" tabindex="0">
                        <table class="cpw-table">
                            <thead>
                                <tr>
                                    <th class="cpw-cell-project" aria-sort="@nameSort.Aria">
                                        <a asp-page="./Index"
                                           asp-all-route-data='Model.GetRoutesForSort("name", nameSort.Direction)'
                                           title="Sort by project name">
                                            Project <span aria-hidden="true">@nameSort.Indicator</span>
                                        </a>
                                    </th>
                                    <th class="cpw-cell-category cpw-wide-column" aria-sort="@categorySort.Aria">
                                        <a asp-page="./Index"
                                           asp-all-route-data='Model.GetRoutesForSort("category", categorySort.Direction)'
                                           title="Sort by technical category">
                                            Technical category <span aria-hidden="true">@categorySort.Indicator</span>
                                        </a>
                                    </th>
                                    <th class="cpw-cell-build cpw-ultrawide-column" aria-sort="@buildSort.Aria">
                                        <a asp-page="./Index"
                                           asp-all-route-data='Model.GetRoutesForSort("build", buildSort.Direction)'
                                           title="Sort by build type">
                                            Build <span aria-hidden="true">@buildSort.Indicator</span>
                                        </a>
                                    </th>
                                    <th class="cpw-cell-year" aria-sort="@completionSort.Aria">
                                        <a asp-page="./Index"
                                           asp-all-route-data='Model.GetRoutesForSort("completed", completionSort.Direction)'
                                           title="Sort by completion date">
                                            Completed <span aria-hidden="true">@completionSort.Indicator</span>
                                        </a>
                                    </th>
                                    <th class="cpw-cell-money" aria-sort="@rdSort.Aria">
                                        <a asp-page="./Index"
                                           asp-all-route-data='Model.GetRoutesForSort("rd", rdSort.Direction)'
                                           title="Sort by development cost">
                                            Development <span aria-hidden="true">@rdSort.Indicator</span>
                                        </a>
                                    </th>
                                    <th class="cpw-cell-money cpw-cell-proliferation-cost cpw-secondary-column" aria-sort="@productionSort.Aria">
                                        <a asp-page="./Index"
                                           asp-all-route-data='Model.GetRoutesForSort("prod", productionSort.Direction)'
                                           title="Sort by proliferation cost">
                                            <span class="cpw-header-text">Proliferation<br />cost</span>
                                            <span aria-hidden="true">@productionSort.Indicator</span>
                                        </a>
                                    </th>
                                    <th class="cpw-cell-money cpw-secondary-column" aria-sort="@lppSort.Aria">
                                        <a asp-page="./Index"
                                           asp-all-route-data='Model.GetRoutesForSort("lpp", lppSort.Direction)'
                                           title="Sort by latest LPP date">
                                            Latest LPP <span aria-hidden="true">@lppSort.Indicator</span>
                                        </a>
                                    </th>
                                    <th class="cpw-cell-status" aria-sort="@technologySort.Aria">
                                        <a asp-page="./Index"
                                           asp-all-route-data='Model.GetRoutesForSort("tech", technologySort.Direction)'
                                           title="Sort by technology status">
                                            Technology <span aria-hidden="true">@technologySort.Indicator</span>
                                        </a>
                                    </th>
                                    <th class="cpw-cell-proliferation" aria-sort="@availabilitySort.Aria">
                                        <a asp-page="./Index"
                                           asp-all-route-data='Model.GetRoutesForSort("avail", availabilitySort.Direction)'
                                           title="Sort by availability for proliferation">
                                            Availability <span aria-hidden="true">@availabilitySort.Indicator</span>
                                        </a>
                                    </th>
                                    <th class="cpw-cell-tot" aria-sort="@totSort.Aria">
                                        <a asp-page="./Index"
                                           asp-all-route-data='Model.GetRoutesForSort("tot", totSort.Direction)'
                                           title="Sort by ToT status">
                                            ToT <span aria-hidden="true">@totSort.Indicator</span>
                                        </a>
                                    </th>
                                    <th class="cpw-cell-quality" aria-sort="@qualitySort.Aria">
                                        <a asp-page="./Index"
                                           asp-all-route-data='Model.GetRoutesForSort("quality", qualitySort.Direction)'
                                           title="Sort by data quality">
                                            Data quality <span aria-hidden="true">@qualitySort.Indicator</span>
                                        </a>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in items)
                            {
                                var criticalMissing = CompletedProjectPortfolioPolicy.GetCriticalMissingFields(item);
                                var supplementaryMissing = CompletedProjectPortfolioPolicy.GetSupplementaryMissingFields(item);
                                var qualityTitle = criticalMissing.Count > 0
                                    ? $"Critical: {JoinFields(criticalMissing)}" + (supplementaryMissing.Count > 0 ? $"; Supplementary: {JoinFields(supplementaryMissing)}" : string.Empty)
                                    : supplementaryMissing.Count > 0
                                        ? $"Supplementary: {JoinFields(supplementaryMissing)}"
                                        : "All portfolio fields recorded";
                                <tr>
                                    <td class="cpw-cell-project">
                                        <button type="button"
                                                class="cpw-project-link"
                                                data-open-project="@item.ProjectId"
                                                title="@item.Name"
                                                aria-label="Open @item.Name">
                                            @item.Name
                                        </button>
                                    </td>
                                    <td class="cpw-cell-category cpw-wide-column" title="@(item.TechnicalCategoryName ?? "Not recorded")">
                                        @(item.TechnicalCategoryName ?? "—")
                                    </td>
                                    <td class="cpw-cell-build cpw-ultrawide-column">@item.BuildType</td>
                                    <td class="cpw-cell-year">@(item.FormatCompletion())</td>
                                    <td class="cpw-cell-money cpw-num">@FormatMoney(item.RdCostLakhs)</td>
                                    <td class="cpw-cell-money cpw-cell-proliferation-cost cpw-num cpw-secondary-column">@FormatMoney(item.ProliferationCostLakhs)</td>
                                    <td class="cpw-cell-money cpw-num cpw-secondary-column">@(item.LatestLpp is null ? "—" : FormatMoney(item.LatestLpp.Amount))</td>
                                    <td class="cpw-cell-status"><span class="cpw-inline-status @TechnologyTone(item.TechStatus)">@CompletedProjectPortfolioPolicy.GetTechnologyLabel(item.TechStatus)</span></td>
                                    <td class="cpw-cell-proliferation"><span class="cpw-inline-status @AvailabilityTone(item.AvailableForProliferation)">@CompletedProjectPortfolioPolicy.GetAvailabilityLabel(item.AvailableForProliferation)</span></td>
                                    <td class="cpw-cell-tot"><span class="cpw-inline-status @TotTone(item.TotStatus)">@CompletedProjectPortfolioPolicy.GetTotLabel(item.TotStatus)</span></td>
                                    <td class="cpw-cell-quality" title="@qualityTitle">
                                        @if (criticalMissing.Count > 0)
                                        {
                                            <span class="cpw-quality-score critical" title="@qualityTitle" aria-label="@qualityTitle">@criticalMissing.Count critical gap@(criticalMissing.Count == 1 ? string.Empty : "s")</span>
                                        }
                                        else if (supplementaryMissing.Count > 0)
                                        {
                                            <span class="cpw-quality-score supplementary" title="@qualityTitle" aria-label="@qualityTitle">@supplementaryMissing.Count supplementary gap@(supplementaryMissing.Count == 1 ? string.Empty : "s")</span>
                                        }
                                        else
                                        {
                                            <span class="cpw-quality-score complete" title="@qualityTitle" aria-label="@qualityTitle">Complete</span>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </section>

        <section class="cpw-view"
                 id="cpw-panel-overview"
                 data-view-panel="overview"
                 role="tabpanel"
                 aria-labelledby="cpw-tab-overview"
                 hidden>
            @if (total == 0)
            {
                <div class="cpw-empty"><h2>No portfolio overview available</h2><p>Adjust or clear the selected filters.</p></div>
            }
            else
            {
                <div class="cpw-overview">
                    <section class="cpw-intelligence-grid" aria-label="Portfolio intelligence">
                        <article class="cpw-intelligence-card cpw-investment-card">
                            <div class="cpw-card-label">Recorded development cost</div>
                            <div class="cpw-investment-value">@FormatMoney(overview.RecordedDevelopmentCostLakhs)</div>
                            <div class="cpw-card-note">Across @overview.RecordedDevelopmentCostCount projects with recorded cost</div>
                        </article>

                        <article class="cpw-intelligence-card">
                            <div class="cpw-card-heading"><span>Technology health</span><strong>@overview.TechnologyCurrentCount current</strong></div>
                            <div class="cpw-stacked-bar" aria-label="Technology status distribution">
                                <span class="is-current" style="width:@(overview.TechnologyCurrentCount * 100d / total)%"></span>
                                <span class="is-outdated" style="width:@(overview.TechnologyOutdatedCount * 100d / total)%"></span>
                                <span class="is-obsolete" style="width:@(overview.TechnologyObsoleteCount * 100d / total)%"></span>
                                <span class="is-unknown" style="width:@(overview.TechnologyAssessmentPendingCount * 100d / total)%"></span>
                            </div>
                            <div class="cpw-bar-legend">
                                <span><i class="current"></i>Current @overview.TechnologyCurrentCount</span>
                                <span><i class="outdated"></i>Outdated @overview.TechnologyOutdatedCount</span>
                                <span><i class="obsolete"></i>Obsolete @overview.TechnologyObsoleteCount</span>
                                <span><i class="unknown"></i>Not assessed @overview.TechnologyAssessmentPendingCount</span>
                            </div>
                        </article>

                        <article class="cpw-intelligence-card">
                            <div class="cpw-card-heading"><span>Portfolio age profile</span><strong>@overview.Age0To5Count completed in last 5 years</strong></div>
                            <div class="cpw-age-bar" aria-label="Completed project age distribution">
                                <span class="age-new" style="width:@(overview.Age0To5Count * 100d / total)%" title="0–5 years: @overview.Age0To5Count"></span>
                                <span class="age-mid" style="width:@(overview.Age6To10Count * 100d / total)%" title="6–10 years: @overview.Age6To10Count"></span>
                                <span class="age-mature" style="width:@(overview.Age11To15Count * 100d / total)%" title="11–15 years: @overview.Age11To15Count"></span>
                                <span class="age-legacy" style="width:@(overview.Age16PlusCount * 100d / total)%" title="16+ years: @overview.Age16PlusCount"></span>
                                <span class="age-unknown" style="width:@(overview.AgeUnknownCount * 100d / total)%" title="Year not recorded: @overview.AgeUnknownCount"></span>
                            </div>
                            <div class="cpw-age-bands">
                                <span><i class="new"></i><b>@overview.Age0To5Count</b><small>0–5 yrs</small></span>
                                <span><i class="mid"></i><b>@overview.Age6To10Count</b><small>6–10 yrs</small></span>
                                <span><i class="mature"></i><b>@overview.Age11To15Count</b><small>11–15 yrs</small></span>
                                <span><i class="legacy"></i><b>@overview.Age16PlusCount</b><small>16+ yrs</small></span>
                                @if (overview.AgeUnknownCount > 0)
                                {
                                    <span><i class="unknown"></i><b>@overview.AgeUnknownCount</b><small>Unknown</small></span>
                                }
                            </div>
                        </article>
                    </section>

                    <section class="cpw-availability-grid">
                        <article class="cpw-overview-card">
                            <div class="cpw-section-heading"><div><span>Proliferation position</span><h2>Availability posture</h2></div><small>Current filtered scope</small></div>
                            <div class="cpw-position-list">
                                <div><span><i class="positive"></i>Available for proliferation</span><strong>@overview.AvailableCount</strong></div>
                                <div><span><i class="negative"></i>Not available</span><strong>@overview.NotAvailableCount</strong></div>
                                <div><span><i class="muted"></i>Assessment pending</span><strong>@overview.AvailabilityPendingCount</strong></div>
                            </div>
                            <p class="cpw-definition">Availability is the recorded proliferation decision. Technology and ToT actions are managed separately.</p>
                        </article>

                        <article class="cpw-overview-card">
                            <div class="cpw-section-heading">
                                <div><span>Available portfolio</span><h2>Recently completed projects available for proliferation</h2></div>
                                <a asp-page="./Index" asp-all-route-data='Model.GetRoutesForAvailability(true, "completed", "desc")'>View in register</a>
                            </div>
                            <div class="cpw-queue-list">
                                @if (overview.AvailableProjects.Count == 0)
                                {
                                    <div class="cpw-queue-empty">No project in the current scope is marked available for proliferation.</div>
                                }
                                else
                                {
                                    @foreach (var item in overview.AvailableProjects)
                                    {
                                        <button type="button"
                                                class="cpw-queue-row"
                                                data-open-project="@item.ProjectId"
                                                title="@item.Name">
                                            <span>
                                                <strong>@item.Name</strong>
                                                <small>@(item.TechnicalCategoryName ?? "Category not recorded") · Completed @(item.FormatCompletion("date not recorded")) · Technology: @CompletedProjectPortfolioPolicy.GetTechnologyLabel(item.TechStatus) · ToT: @CompletedProjectPortfolioPolicy.GetTotLabel(item.TotStatus)</small>
                                            </span>
                                            @if (item.RdCostLakhs.HasValue)
                                            {
                                                <b>@FormatMoney(item.RdCostLakhs)</b>
                                            }
                                        </button>
                                    }
                                }
                            </div>
                        </article>
                    </section>

                    <section class="cpw-action-grid" aria-label="Priority action queues">
                        <article class="cpw-action-card neutral">
                            <div class="cpw-action-head">
                                <div><span>Proliferation decision</span><h3>Assessment pending</h3></div>
                                <strong>@overview.AvailabilityPendingCount</strong>
                            </div>
                            <div class="cpw-action-list">
                                @if (overview.AvailabilityPendingProjects.Count == 0)
                                {
                                    <p>All projects in the current scope have a recorded proliferation decision.</p>
                                }
                                else
                                {
                                    @foreach (var item in overview.AvailabilityPendingProjects)
                                    {
                                        <button type="button" data-open-project="@item.ProjectId" title="@item.Name"><span>@item.Name</span><small>Proliferation decision not recorded · Completed @(item.FormatCompletion("date not recorded"))</small></button>
                                    }
                                }
                            </div>
                            <a class="cpw-action-link" asp-page="./Index" asp-all-route-data='Model.GetRoutesForPortfolioStatus(CompletedProjectPortfolioStatusCodes.ProliferationAssessmentPending, "completed", "desc")'>Open filtered register →</a>
                        </article>

                        <article class="cpw-action-card danger">
                            <div class="cpw-action-head">
                                <div><span>Technology health</span><h3>Technology review required</h3></div>
                                <strong>@overview.TechnologyActionCount</strong>
                            </div>
                            <div class="cpw-action-list">
                                @if (overview.TechnologyActionProjects.Count == 0)
                                {
                                    <p>No project is marked outdated or obsolete.</p>
                                }
                                else
                                {
                                    @foreach (var item in overview.TechnologyActionProjects)
                                    {
                                        <button type="button" data-open-project="@item.ProjectId" title="@item.Name"><span>@item.Name</span><small>Technology: @CompletedProjectPortfolioPolicy.GetTechnologyLabel(item.TechStatus) · Completed @(item.FormatCompletion("date not recorded"))</small></button>
                                    }
                                }
                            </div>
                            <a class="cpw-action-link" asp-page="./Index" asp-all-route-data='Model.GetRoutesForPortfolioStatus(CompletedProjectPortfolioStatusCodes.TechnologyAction, "completed", "desc")'>Open filtered register →</a>
                        </article>

                        <article class="cpw-action-card info">
                            <div class="cpw-action-head">
                                <div><span>Transfer of technology</span><h3>ToT action pending</h3></div>
                                <strong>@overview.TotActionPendingCount</strong>
                            </div>
                            <div class="cpw-action-list">
                                @if (overview.TotActionProjects.Count == 0)
                                {
                                    <p>No project has ToT marked not started or in progress.</p>
                                }
                                else
                                {
                                    @foreach (var item in overview.TotActionProjects)
                                    {
                                        <button type="button" data-open-project="@item.ProjectId" title="@item.Name"><span>@item.Name</span><small>ToT: @CompletedProjectPortfolioPolicy.GetTotLabel(item.TotStatus) · Availability: @CompletedProjectPortfolioPolicy.GetAvailabilityLabel(item.AvailableForProliferation)</small></button>
                                    }
                                }
                            </div>
                            <a class="cpw-action-link" asp-page="./Index" asp-all-route-data='Model.GetRoutesForPortfolioStatus(CompletedProjectPortfolioStatusCodes.TotAction, "completed", "desc")'>Open filtered register →</a>
                        </article>
                    </section>

                    <section class="cpw-quality-callout">
                        <div>
                            <h2>Record quality is managed separately from proliferation availability</h2>
                            <p><strong>@overview.CriticalIncompleteCount projects</strong> have one or more critical fields incomplete. Technology assessment, proliferation decision, ToT status and development cost are critical; proliferation cost and latest LPP are supplementary.</p>
                        </div>
                        <button type="button" class="cpw-btn cpw-btn-ghost" data-open-view="quality">Open data quality</button>
                    </section>
                </div>
            }
        </section>

        <section class="cpw-view"
                 id="cpw-panel-quality"
                 data-view-panel="quality"
                 role="tabpanel"
                 aria-labelledby="cpw-tab-quality"
                 hidden>
            <div class="cpw-quality-layout">
                <aside class="cpw-quality-summary">
                    <div class="cpw-card-label">Critical completeness</div>
                    <div class="cpw-quality-donut" style="--score:@criticalCompletenessScore">
                        <strong>@criticalCompletenessScore%</strong><span>critical fields complete</span>
                    </div>
                    <dl class="cpw-quality-stats">
                        <div><dt>Critical incomplete</dt><dd>@overview.CriticalIncompleteCount</dd></div>
                        <div><dt>Supplementary incomplete</dt><dd>@overview.SupplementaryIncompleteCount</dd></div>
                        <div><dt>Fully complete</dt><dd>@overview.FullyCompleteCount</dd></div>
                    </dl>
                    <p>Critical: technology assessment, proliferation decision, ToT status and development cost.</p>
                    <p>Supplementary: proliferation cost and latest LPP.</p>
                </aside>

                <div class="cpw-quality-content">
                    <section class="cpw-quality-section">
                        <div class="cpw-quality-list-head"><div><span>Priority 1</span><h2>Critical records requiring action</h2><p>Ordered by the number of missing critical fields.</p></div><strong>@criticalItems.Count</strong></div>
                        @if (criticalItems.Count == 0)
                        {
                            <div class="cpw-quality-empty">All records contain the four critical portfolio fields.</div>
                        }
                        else
                        {
                            <div class="cpw-quality-list">
                                @foreach (var item in criticalItems)
                                {
                                    var criticalMissing = CompletedProjectPortfolioPolicy.GetCriticalMissingFields(item);
                                    var supplementaryMissing = CompletedProjectPortfolioPolicy.GetSupplementaryMissingFields(item);
                                    <article class="cpw-quality-row">
                                        <div class="cpw-quality-rank critical">@criticalMissing.Count</div>
                                        <div class="cpw-quality-main">
                                            <button type="button" data-open-project="@item.ProjectId">@item.Name</button>
                                            <span>Critical: @JoinFields(criticalMissing)@(supplementaryMissing.Count > 0 ? $" · Supplementary: {JoinFields(supplementaryMissing)}" : string.Empty)</span>
                                        </div>
                                        <div class="cpw-quality-action">@criticalMissing.Count critical</div>
                                    </article>
                                }
                            </div>
                        }
                    </section>

                    <section class="cpw-quality-section supplementary">
                        <div class="cpw-quality-list-head"><div><span>Priority 2</span><h2>Supplementary information gaps</h2><p>Critical fields are complete; proliferation cost or latest LPP remains unrecorded.</p></div><strong>@supplementaryOnlyItems.Count</strong></div>
                        @if (supplementaryOnlyItems.Count == 0)
                        {
                            <div class="cpw-quality-empty">No supplementary-only gaps in the current scope.</div>
                        }
                        else
                        {
                            <div class="cpw-quality-list">
                                @foreach (var item in supplementaryOnlyItems)
                                {
                                    var supplementaryMissing = CompletedProjectPortfolioPolicy.GetSupplementaryMissingFields(item);
                                    <article class="cpw-quality-row">
                                        <div class="cpw-quality-rank supplementary">@supplementaryMissing.Count</div>
                                        <div class="cpw-quality-main"><button type="button" data-open-project="@item.ProjectId">@item.Name</button><span>Supplementary: @JoinFields(supplementaryMissing)</span></div>
                                        <div class="cpw-quality-action">@supplementaryMissing.Count supplementary</div>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                </div>
            </div>
        </section>
    </main>

    @foreach (var item in items)
    {
        var criticalMissing = CompletedProjectPortfolioPolicy.GetCriticalMissingFields(item);
        var supplementaryMissing = CompletedProjectPortfolioPolicy.GetSupplementaryMissingFields(item);
        var actionItems = CompletedProjectPortfolioPolicy.GetActionItems(item);
        var hasTechnologyRemarks = !string.IsNullOrWhiteSpace(item.TechnologyRemarks);
        var hasProliferationRemarks = !string.IsNullOrWhiteSpace(item.ProliferationRemarks);
        var hasNotAvailableReason = !string.IsNullOrWhiteSpace(item.NotAvailableReason);
        var hasProliferationCostRemarks = !string.IsNullOrWhiteSpace(item.ProliferationCostRemarks);
        var hasAnyRemarks = hasTechnologyRemarks
                            || hasProliferationRemarks
                            || hasNotAvailableReason
                            || hasProliferationCostRemarks;
        <template id="cpw-project-@item.ProjectId">
            <div class="cpw-drawer-scroll">
                <div class="cpw-drawer-identity">
                    <div class="cpw-drawer-kicker">Completed project · @(item.FormatCompletion("Completion date not recorded"))</div>
                    <h2>@item.Name</h2>
                </div>

                <div class="cpw-drawer-content">
                    <div class="cpw-drawer-status-grid">
                        <div><span>Technology</span><strong>@CompletedProjectPortfolioPolicy.GetTechnologyLabel(item.TechStatus)</strong></div>
                        <div><span>Availability</span><strong>@CompletedProjectPortfolioPolicy.GetAvailabilityLabel(item.AvailableForProliferation)</strong></div>
                        <div><span>ToT</span><strong>@CompletedProjectPortfolioPolicy.GetTotLabel(item.TotStatus)</strong></div>
                    </div>

                    <div class="cpw-drawer-section">
                        <h3>Financial information</h3>
                        <dl>
                            <div><dt>Recorded development cost</dt><dd>@FormatMoney(item.RdCostLakhs)</dd></div>
                            <div><dt>Proliferation cost</dt><dd>@FormatMoney(item.ProliferationCostLakhs)</dd></div>
                            <div><dt>Latest LPP</dt><dd>@FormatLatestLpp(item.LatestLpp)</dd></div>
                        </dl>
                    </div>

                    @if (actionItems.Count > 0)
                    {
                        <div class="cpw-drawer-section cpw-drawer-actions">
                            <h3>Actions required</h3>
                            <ul>
                                @foreach (var action in actionItems)
                                {
                                    <li>@action</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="cpw-drawer-section">
                        <h3>Data quality</h3>
                        @if (criticalMissing.Count == 0 && supplementaryMissing.Count == 0)
                        {
                            <p>All completed-project portfolio fields are recorded.</p>
                        }
                        else
                        {
                            @if (criticalMissing.Count > 0)
                            {
                                <p><strong>Critical information missing:</strong> @JoinFields(criticalMissing)</p>
                            }
                            @if (supplementaryMissing.Count > 0)
                            {
                                <p><strong>Supplementary information missing:</strong> @JoinFields(supplementaryMissing)</p>
                            }
                        }
                    </div>

                    <div class="cpw-drawer-section">
                        <h3>Remarks</h3>
                        @if (!hasAnyRemarks)
                        {
                            <p class="cpw-remarks">No remarks recorded.</p>
                        }
                        else
                        {
                            <div class="cpw-remark-list">
                                @if (hasTechnologyRemarks)
                                {
                                    <div class="cpw-remark-item">
                                        <span>Technology</span>
                                        <p>@item.TechnologyRemarks</p>
                                    </div>
                                }
                                @if (hasProliferationRemarks)
                                {
                                    <div class="cpw-remark-item">
                                        <span>Availability for proliferation</span>
                                        <p>@item.ProliferationRemarks</p>
                                    </div>
                                }
                                @if (hasNotAvailableReason)
                                {
                                    <div class="cpw-remark-item">
                                        <span>Reason not available</span>
                                        <p>@item.NotAvailableReason</p>
                                    </div>
                                }
                                @if (hasProliferationCostRemarks)
                                {
                                    <div class="cpw-remark-item">
                                        <span>Proliferation cost</span>
                                        <p>@item.ProliferationCostRemarks</p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="cpw-drawer-footer">
                <a asp-page="/Projects/Overview"
                   asp-route-id="@item.ProjectId"
                   class="cpw-btn cpw-btn-ghost">Open full project</a>
                @if (Model.CanEdit)
                {
                    <a asp-page="./Edit"
                       asp-route-id="@item.ProjectId"
                       asp-route-returnUrl="@returnUrl"
                       data-edit-project
                       data-project-id="@item.ProjectId"
                       class="cpw-btn cpw-btn-primary">Edit details</a>
                }
            </div>
        </template>
    }

    <div class="cpw-drawer-backdrop" data-drawer-backdrop hidden></div>
    <aside class="cpw-drawer"
           data-drawer
           role="dialog"
           aria-modal="true"
           aria-hidden="true"
           aria-labelledby="cpwDrawerTitle">
        <div class="cpw-drawer-header">
            <span id="cpwDrawerTitle">Completed project details</span>
            <button type="button" data-close-drawer aria-label="Close">×</button>
        </div>
        <div class="cpw-drawer-success" data-drawer-success role="status" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
            <span></span>
        </div>
        <div class="cpw-drawer-body" data-drawer-body></div>
    </aside>
</div>

@section Scripts {
    <script src="~/js/pages/projects-completed-summary.js" asp-append-version="true"></script>
}
