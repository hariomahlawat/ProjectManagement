@model ProjectManagement.ViewModels.Notebook.NotebookConferenceDigestCardVm
@using ProjectManagement.Infrastructure
@using System.Text.Json
@{
    const int previewOfficerLimit = 2;
    const int previewDirectionLimit = 3;

    var digest = Model.Digest;
    var preference = Model.Preference;
    var previewGroups = digest.OfficerGroups.Take(previewOfficerLimit).ToArray();
    var previewTakes = new int[previewGroups.Length];
    var remainingPreviewSlots = previewDirectionLimit;
    var colorKey = string.IsNullOrWhiteSpace(preference.ColorKey) ? "white" : preference.ColorKey;
    var labels = preference.Labels.Take(3).ToArray();
    var extraLabels = Math.Max(0, preference.Labels.Count - labels.Length);

    // Preserve PO context in the compact preview: when two officers are available,
    // reserve at least one direction for the second officer.
    for (var index = 0; index < previewGroups.Length && remainingPreviewSlots > 0; index++)
    {
        var groupsAfter = previewGroups.Length - index - 1;
        var reservedForLaterGroups = Math.Min(groupsAfter, remainingPreviewSlots);
        var availableForCurrentGroup = Math.Max(0, remainingPreviewSlots - reservedForLaterGroups);
        var take = Math.Min(previewGroups[index].Directions.Count, availableForCurrentGroup);
        if (take == 0 && previewGroups[index].Directions.Count > 0) take = 1;
        previewTakes[index] = take;
        remainingPreviewSlots -= take;
    }
}

@* SECTION: A live PRISM-owned note with user-owned presentation metadata.
   Conference content stays read-only; colour, labels, pin and home placement are personal. *@
<article class="notebook-card notebook-card-color-@colorKey notebook-conference-shared-card @(preference.IsPinned && Model.IsHomePlacement ? "is-system-pinned" : string.Empty)"
         data-notebook-system-card="conference-directions"
         data-system-item-key="conference-directions"
         data-system-show-home="@preference.ShowInHome.ToString().ToLowerInvariant()"
         data-system-is-pinned="@preference.IsPinned.ToString().ToLowerInvariant()"
         data-system-home-position="@preference.HomePosition"
         data-system-preference-version="@preference.Version"
         data-labels='@JsonSerializer.Serialize(preference.Labels)'
         data-reorderable="@(Model.IsHomePlacement ? "true" : "false")"
         data-notebook-system-home-card="@(Model.IsHomePlacement ? "conference-directions" : null)">

    @if (Model.IsHomePlacement)
    {
        <button type="button"
                class="notebook-card-drag-handle"
                data-notebook-drag-handle
                hidden
                aria-label="Rearrange Latest Conference Directions"
                aria-grabbed="false"
                title="Drag to rearrange">
            <i class="bi bi-grip-vertical" aria-hidden="true"></i>
        </button>
    }

    <button type="button"
            class="notebook-conference-shared-card__open"
            data-card-passive-open
            data-bs-toggle="modal"
            data-bs-target="#notebookConferenceDigestModal"
            aria-haspopup="dialog"
            aria-label="Open latest conference directions"></button>

    <div class="notebook-card-body notebook-conference-shared-card__body">
        @if (Model.IsHomePlacement)
        {
            <div class="notebook-card-topline" data-system-pin-state hidden="@(!preference.IsPinned)">
                <span class="notebook-card-indicators"></span>
                <span class="notebook-card-pin-indicator" title="Pinned" aria-label="Pinned"><i class="bi bi-pin-angle-fill"></i></span>
            </div>
        }

        <h3 class="notebook-card-title">Latest Conference Directions</h3>
        <p class="notebook-card-preview notebook-conference-shared-card__summary">
            @digest.TotalDirectionCount latest direction@(digest.TotalDirectionCount == 1 ? string.Empty : "s") · @digest.OfficerCount Project Officer@(digest.OfficerCount == 1 ? string.Empty : "s")
        </p>

        <div class="notebook-conference-shared-card__groups">
            @for (var groupIndex = 0; groupIndex < previewGroups.Length; groupIndex++)
            {
                var group = previewGroups[groupIndex];
                var previewTake = previewTakes[groupIndex];
                <div class="notebook-conference-shared-card__group">
                    <div class="notebook-conference-shared-card__officer">
                        <span title="@group.OfficerDisplayName">@group.OfficerDisplayName</span>
                        <small>@group.Directions.Count</small>
                    </div>
                    @foreach (var item in group.Directions.Take(previewTake))
                    {
                        <div class="notebook-conference-shared-card__item">
                            <strong title="@item.Title">@item.Title</strong>
                            <span>@item.DirectionText</span>
                        </div>
                    }
                </div>
            }
        </div>

        <button type="button"
                class="notebook-conference-shared-card__view-all"
                data-bs-toggle="modal"
                data-bs-target="#notebookConferenceDigestModal">
            View all @digest.TotalDirectionCount <i class="bi bi-chevron-right" aria-hidden="true"></i>
        </button>

        @if (preference.Labels.Count > 0)
        {
            <div class="notebook-card-tags" data-system-card-tags aria-label="Labels">
                @foreach (var label in labels)
                {
                    <a class="notebook-tag-chip" asp-page="/Notebook/Index" asp-route-view="labels" asp-route-tag="@label" aria-label="Open label @label">@label</a>
                }
                @if (extraLabels > 0)
                {
                    <span class="notebook-tag-chip">+@extraLabels</span>
                }
            </div>
        }
        else
        {
            <div class="notebook-card-tags" data-system-card-tags aria-label="Labels" hidden></div>
        }
    </div>

    <div class="notebook-sharing-summary notebook-conference-shared-card__sharing"
         title="Shared by PRISM. Available to authorised Comdt / HoD users. Content is read only."
         aria-label="Shared by PRISM. Read only.">
        <i class="bi bi-shield-lock" aria-hidden="true"></i>
        <span>
            PRISM · Read only
            @if (!Model.IsHomePlacement)
            {
                <span class="notebook-system-home-state"
                      data-system-home-state
                      hidden="@(!preference.ShowInHome)"> · In My Notebook</span>
            }
        </span>
    </div>

    <div class="notebook-card-actions notebook-conference-shared-card__actions" data-no-card-drag>
        <div class="notebook-actions" aria-label="System note actions">
            @if (Model.IsHomePlacement)
            {
                <button type="button"
                        class="notebook-action-icon notebook-action-pin @(preference.IsPinned ? "is-active" : string.Empty)"
                        data-action="system-pin-note"
                        title="@(preference.IsPinned ? "Unpin" : "Pin")"
                        aria-label="@(preference.IsPinned ? "Unpin system note" : "Pin system note")">
                    <i class="bi @(preference.IsPinned ? "bi-pin-angle-fill" : "bi-pin-angle")"></i>
                </button>
            }

            <partial name="~/Pages/Notebook/_NotebookColourPicker.cshtml" model="colorKey" />

            <button type="button"
                    class="notebook-action-icon"
                    data-action="label-note"
                    title="Edit labels"
                    aria-label="Edit labels">
                <i class="bi bi-tags"></i>
            </button>

            <span class="notebook-system-home-control" data-system-home-control>
                @if (!preference.ShowInHome)
                {
                    <button type="button"
                            class="notebook-system-home-toggle"
                            data-action="system-add-home"
                            title="Add this live PRISM note to All Notes">
                        <i class="bi bi-journal-plus" aria-hidden="true"></i>
                        <span>Add to My Notebook</span>
                    </button>
                }
                else
                {
                    <details class="notebook-card-more">
                        <summary class="notebook-action-button" aria-label="More actions" aria-expanded="false"><i class="bi bi-three-dots"></i></summary>
                        <div class="notebook-card-more__menu" role="menu">
                            <button type="button" role="menuitem" data-action="system-remove-home">
                                <i class="bi bi-journal-minus" aria-hidden="true"></i> Remove from My Notebook
                            </button>
                        </div>
                    </details>
                }
            </span>
        </div>
    </div>
</article>
