@page
@model ProjectManagement.Pages.Notebook.IndexModel
@using ProjectManagement.ViewModels.Notebook
@inject ProjectManagement.Services.Notebook.INotebookCardModelFactory CardModelFactory
@{
    ViewData["Title"] = "My Notebook";
    ViewData["UseFullWidth"] = true;
    var emptyTitle = Model.Notebook.View switch
    {
        "labels" => "No labels yet.",
        "today" => "No reminders due today.",
        "overdue" => "No overdue reminders.",
        "reminders" => "No active reminders.",
        "archive" or "archived" => "No archived items.",
        "completed" => "No completed items.",
        "trash" => "Trash is empty.",
        _ => "No notebook items yet."
    };
    var emptyText = Model.Notebook.View switch
    {
        "labels" => "Add tags to notebook items, then browse by label here.",
        "today" or "overdue" or "reminders" => "Add a reminder to any note or checklist.",
        "shared" => "Shared notes from other PRISM users will appear here.",
        "archive" or "archived" => "Archived notes will appear here.",
        "completed" => "Completed notes will appear here.",
        "trash" => "Items moved to Trash will appear here until permanently deleted.",
        _ => "Use quick capture or create a structured notebook item."
    };
    var selectedLabelName = Model.Notebook.Tags
        .FirstOrDefault(label => string.Equals(label.Name, Model.Notebook.Tag, StringComparison.OrdinalIgnoreCase))?.Name
        ?? Model.Notebook.Tag;
    var viewTitle = Model.Notebook.View switch
    {
        "archive" or "archived" => "Archive",
        "completed" => "Completed",
        "today" => "Today",
        "overdue" => "Overdue",
        "reminders" => "Reminders",
        "shared" => "Shared with me",
        "labels" when !string.IsNullOrWhiteSpace(Model.Notebook.Tag) => selectedLabelName,
        "labels" => "Labels",
        "trash" => "Trash",
        _ => "My Notebook"
    };
    var viewSubtitle = Model.Notebook.View switch
    {
        "archive" or "archived" => "Archived notes and checklists.",
        "completed" => "Completed reminders and notebook items.",
        "today" => "Items due today.",
        "overdue" => "Past reminders that still need attention.",
        "reminders" => "All active reminders across your notebook.",
        "shared" => "Notes and checklists shared with you by other PRISM users.",
        "labels" when !string.IsNullOrWhiteSpace(Model.Notebook.Tag) => $"Items labelled {selectedLabelName}.",
        "labels" => "Browse and organise notebook labels.",
        "trash" => "Items in Trash are permanently deleted after 30 days.",
        _ => "Notes, checklists and reminders."
    };
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
}
@section Styles { <link rel="stylesheet" href="~/css/notebook.css" asp-append-version="true" /> }

<div class="notebook-shell editor-collapsed" data-board-view="grid" data-view="@Model.Notebook.View" data-current-user-id="@currentUserId" data-open-label-manager-on-load="@Model.EditLabels.ToString().ToLowerInvariant()">
    @* SECTION: Dedicated anti-forgery token for Notebook API mutations *@
    <div id="notebook-antiforgery-token" hidden>
        @Html.AntiForgeryToken()
    </div>
    <script id="notebook-label-catalog" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Notebook.Tags.Select(tag => new { id = tag.Id, name = tag.Name, count = tag.Count })))</script>
    <aside class="notebook-rail" aria-label="Notebook views">
        <div class="notebook-rail__brand"><i class="bi bi-journal-bookmark"></i><span>My Notebook</span></div>

        @foreach (var item in Model.Notebook.RailItems.Where(item => item.Key is "home" or "today" or "overdue" or "reminders" or "shared"))
        {
            <a class="notebook-rail__item @(item.IsActive ? "is-active" : "")" href="@item.Url" hidden="@(item.Key == "overdue" && item.Count == 0 && !item.IsActive)"><i class="bi @item.Icon"></i><span>@item.Label</span><b data-notebook-count="@item.Key">@item.Count</b></a>
        }

        <div class="notebook-rail-labels notebook-rail-labels--flat" data-notebook-label-rail aria-label="Notebook labels">
            @foreach (var label in Model.Notebook.Tags)
            {
                <a asp-page="/Notebook/Index"
                   asp-route-view="labels"
                   asp-route-tag="@label.Name"
                   class="notebook-rail__item notebook-rail__item--label @(string.Equals(Model.Notebook.Tag, label.Name, StringComparison.OrdinalIgnoreCase) ? "is-active" : "")">
                    <i class="bi bi-tag"></i><span>@label.Name</span><b>@label.Count</b>
                </a>
            }
        </div>

        <button type="button"
                class="notebook-rail__item notebook-rail__item--button"
                data-open-label-manager
                aria-haspopup="dialog">
            <i class="bi bi-pencil"></i><span>Edit labels</span><b aria-hidden="true"></b>
        </button>

        <div class="notebook-rail__separator" aria-hidden="true"></div>

        @foreach (var item in Model.Notebook.RailItems.Where(item => item.Key is "archive" or "completed" or "trash"))
        {
            <a class="notebook-rail__item @(item.IsActive ? "is-active" : "")" href="@item.Url"><i class="bi @item.Icon"></i><span>@item.Label</span><b data-notebook-count="@item.Key">@item.Count</b></a>
        }
    </aside>

    <main class="notebook-main">
        <section class="notebook-commandbar">
            <div class="notebook-commandbar__heading"><h1>@viewTitle</h1><p>@viewSubtitle</p></div>
            <div class="notebook-command-actions">
                @if (Model.Notebook.View == "trash" && Model.Notebook.Items.Any())
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" data-empty-notebook-trash><i class="bi bi-trash3"></i> Empty trash</button>
                }
                <form method="get" class="notebook-search" aria-label="Search this notebook"><input type="hidden" name="view" value="@Model.Notebook.View" /><input type="hidden" name="filter" value="@Model.Notebook.Filter" /><input type="hidden" name="tag" value="@Model.Notebook.Tag" /><i class="bi bi-search"></i><input name="Query" value="@Model.Query" placeholder="Search this notebook" aria-label="Search this notebook" /></form>
                <div class="notebook-view-toggle" role="group" aria-label="Board layout">
                    <button type="button" data-notebook-view="grid" aria-label="Grid view"><i class="bi bi-grid-3x3-gap"></i></button>
                    <button type="button" data-notebook-view="list" aria-label="List view"><i class="bi bi-list-ul"></i></button>
                </div>
                @if (Model.Notebook.View == "home" && string.IsNullOrWhiteSpace(Model.Query) && string.IsNullOrWhiteSpace(Model.Notebook.Tag) && string.IsNullOrWhiteSpace(Model.Notebook.Filter))
                {
                    <button type="button" class="notebook-rearrange-toggle" data-notebook-rearrange-toggle><i class="bi bi-arrows-move"></i><span>Rearrange</span></button>
                    <button type="button" class="notebook-rearrange-toggle is-done" data-notebook-rearrange-done hidden><i class="bi bi-check2"></i><span>Done</span></button>
                }
            </div>
        </section>

        @* SECTION: Expandable async notebook composer *@
        @if (string.Equals(Model.Notebook.View, "home", StringComparison.OrdinalIgnoreCase) && string.IsNullOrWhiteSpace(Model.Query) && string.IsNullOrWhiteSpace(Model.Tag) && string.IsNullOrWhiteSpace(Model.Notebook.Filter))
        {
                    <section class="notebook-composer" aria-label="Create a notebook item" data-notebook-composer data-state="collapsed">
                        <div class="notebook-composer__collapsed" data-composer-collapsed>
                            <button type="button" class="notebook-composer__trigger" data-composer-open-note>Take a note…</button>
                            <div class="notebook-composer__quick-actions">
                                <button type="button" class="notebook-composer__checklist-trigger" data-composer-open-checklist aria-label="Create checklist"><i class="bi bi-check2-square"></i></button>
                                <button type="button" class="notebook-composer__reminder-trigger" data-notebook-create-type="Reminder" aria-label="Create reminder"><i class="bi bi-bell"></i></button>
                            </div>
                        </div>
                        <div class="notebook-composer__expanded" data-composer-expanded hidden>
                            <div class="notebook-composer__top">
                                <input type="text" data-composer-title maxlength="220" placeholder="Title" aria-label="Note title" />
                                <button type="button" data-composer-pin aria-label="Pin note"><i class="bi bi-pin-angle"></i></button>
                            </div>
                            <textarea data-composer-body maxlength="20000" placeholder="Take a note…" aria-label="Note body"></textarea>
                            <div data-composer-checklist hidden></div>
                            <div class="notebook-composer__footer">
                                <span data-composer-status aria-live="polite"></span>
                                <button type="button" data-composer-close>Close</button>
                            </div>
                        </div>
                    </section>
        }

        @* SECTION: Visible async operation errors *@
        <div class="notebook-global-error" data-notebook-global-error role="alert" hidden>
            <span data-notebook-global-error-text></span>
            <button type="button" data-notebook-global-error-close aria-label="Dismiss error">×</button>
        </div>

        @* SECTION: Card-first notebook board *@
        @if (Model.Notebook.View == "labels" && string.IsNullOrWhiteSpace(Model.Notebook.Tag))
        {
            <section class="notebook-labels-panel" data-notebook-label-directory aria-label="Notebook labels">
                <div class="notebook-section-header"><h2>Labels</h2><span>@Model.Notebook.Tags.Count</span></div>
                <div class="notebook-label-chips" data-notebook-label-directory-list>
                    @foreach (var tag in Model.Notebook.Tags)
                    {
                        <a asp-page="/Notebook/Index" asp-route-view="labels" asp-route-tag="@tag.Name" class="@(string.Equals(Model.Notebook.Tag, tag.Name.ToUpperInvariant(), StringComparison.OrdinalIgnoreCase) ? "is-active" : "")"><i class="bi bi-tag"></i>@tag.Name <span>@tag.Count</span></a>
                    }
                </div>
                <div class="notebook-label-directory-empty" data-notebook-label-directory-empty hidden="@(Model.Notebook.Tags.Any())">
                    <i class="bi bi-tags"></i><strong>No labels yet</strong><span>Create labels to organise your notes.</span>
                    <button type="button" class="btn btn-sm btn-primary" data-open-label-manager>Create label</button>
                </div>
            </section>
        }
        @if (Model.Notebook.View == "home")
        {

            var hasAnyHomeItems = Model.Notebook.PinnedItems.Any() || Model.Notebook.OtherItems.Any();

            @* SECTION: Manual-order friendly home board sections *@
            <section class="notebook-board-section" data-notebook-section="pinned" hidden="@(!Model.Notebook.PinnedItems.Any())">
                <div class="notebook-section-header"><h2>Pinned</h2><span data-notebook-count="pinned">@Model.Notebook.PinnedItems.Count</span></div>
                <div class="notebook-board" data-notebook-board="pinned" data-sortable="true" data-layout-policy="masonry-threshold" data-layout="grid" data-item-count="@Model.Notebook.PinnedItems.Count">
                    @foreach (var item in Model.Notebook.PinnedItems)
                    {
                        <partial name="_NotebookCard" model="@(CardModelFactory.Create(item, new ProjectManagement.Services.Notebook.NotebookCardContext { View = Model.Notebook.View, Query = Model.Notebook.Query, Filter = Model.Notebook.Filter, Tag = Model.Notebook.Tag, SelectedId = null }))" />
                    }
                </div>
            </section>
            <section class="notebook-board-section" data-notebook-section="others">
                <div class="notebook-section-header"><h2>Others</h2><span data-notebook-count="others">@Model.Notebook.OtherItems.Count</span></div>
                <div class="notebook-board" data-notebook-board="others" data-sortable="true" data-layout-policy="masonry-threshold" data-layout="@(Model.Notebook.OtherItems.Count > 4 ? "masonry" : "grid")" data-item-count="@Model.Notebook.OtherItems.Count">
                    @foreach (var item in Model.Notebook.OtherItems)
                    {
                        <partial name="_NotebookCard" model="@(CardModelFactory.Create(item, new ProjectManagement.Services.Notebook.NotebookCardContext { View = Model.Notebook.View, Query = Model.Notebook.Query, Filter = Model.Notebook.Filter, Tag = Model.Notebook.Tag, SelectedId = null }))" />
                    }
                </div>
                @if (!hasAnyHomeItems)
                {
                    <div class="notebook-empty notebook-empty-compact" data-notebook-empty-state><h3>@emptyTitle</h3><p>@emptyText</p></div>
                }
            </section>
        }
        else if (!(Model.Notebook.View == "labels" && string.IsNullOrWhiteSpace(Model.Notebook.Tag)))
        {
            <section class="notebook-board-section">
                <div class="notebook-board" data-notebook-board data-layout-policy="masonry-threshold" data-layout="@(Model.Notebook.Items.Count > 4 ? "masonry" : "grid")" data-item-count="@Model.Notebook.Items.Count">
                    @foreach (var item in Model.Notebook.Items)
                    {
                        <partial name="_NotebookCard" model="@(CardModelFactory.Create(item, new ProjectManagement.Services.Notebook.NotebookCardContext { View = Model.Notebook.View, Query = Model.Notebook.Query, Filter = Model.Notebook.Filter, Tag = Model.Notebook.Tag, SelectedId = null }))" />
                    }
                </div>
                @if (!Model.Notebook.Items.Any())
                {
                    var emptyType = Model.Notebook.View switch
                    {
                        "reminders" or "today" or "overdue" => "Reminder",
                        _ => "Note"
                    };
                    var cta = Model.Notebook.View is "archive" or "archived" or "completed" or "trash" ? null : $"New {emptyType}";
                    <div class="notebook-empty" data-notebook-empty-state><h3>@emptyTitle</h3><p>@emptyText</p>@if (cta is not null) { <a asp-page="/Notebook/Index" asp-route-view="@Model.Notebook.View" asp-route-mode="new" asp-route-type="@emptyType" data-notebook-create-type="@emptyType" class="btn btn-sm btn-primary">@cta</a> }</div>
                }
            </section>
        }
        <div class="visually-hidden" data-notebook-reorder-live aria-live="polite" aria-atomic="true"></div>
    </main>

</div>


<partial name="_NotebookCardLabelPicker" />
<partial name="_NotebookLabelManager" model="Model.Notebook.Tags" />
<partial name="_NotebookConfirmDialog" />
<partial name="_NotebookToastRegion" />
<partial name="_NotebookCollaboratorsDialog" />
<partial name="_NotebookEditorTemplate" />

@section Scripts { <script type="module" src="~/dist/notebook-index.bundle.js" asp-append-version="true"></script> }
