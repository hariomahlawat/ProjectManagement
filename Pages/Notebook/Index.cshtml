@page
@model ProjectManagement.Pages.Notebook.IndexModel
@using ProjectManagement.ViewModels.Notebook
@inject ProjectManagement.Services.Notebook.INotebookCardModelFactory CardModelFactory
@{
    ViewData["Title"] = "My Notebook";
    ViewData["UseFullWidth"] = true;
    var hasQuery = !string.IsNullOrWhiteSpace(Model.Query);
    var emptyTitle = hasQuery ? "No matching items" : Model.Notebook.View switch
    {
        "labels" => "Nothing has this label yet",
        "today" => "Nothing due today",
        "overdue" => "No overdue reminders",
        "reminders" => "No upcoming reminders",
        "archive" or "archived" => "No archived items",
        "completed" => "No completed items",
        "trash" => "Trash is empty",
        "shared" => "Nothing shared with you yet",
        _ => "Your notes will appear here"
    };
    var emptyText = hasQuery ? "Try a different word, or clear the search." : Model.Notebook.View switch
    {
        "labels" => "Add this label to a note from the label button on its card.",
        "today" or "overdue" or "reminders" => "Add a reminder to any note or checklist.",
        "shared" => "Notes that PRISM or colleagues share with you appear here.",
        "archive" or "archived" => "Archive a note to keep it without cluttering All Notes.",
        "completed" => "Reminders you mark as done appear here.",
        "trash" => "Notes in Trash are deleted permanently after 30 days.",
        _ => "Use “Take a note…” above to add a note, checklist or reminder."
    };
    var emptyIcon = hasQuery ? "bi-search" : Model.Notebook.View switch
    {
        "labels" => "bi-tag",
        "today" => "bi-calendar-check",
        "overdue" => "bi-exclamation-circle",
        "reminders" => "bi-bell",
        "shared" => "bi-people",
        "archive" or "archived" => "bi-archive",
        "completed" => "bi-check2-circle",
        "trash" => "bi-trash3",
        _ => "bi-journal-text"
    };
    var selectedLabelName = Model.Notebook.Tags
        .FirstOrDefault(label => string.Equals(label.Name, Model.Notebook.Tag, StringComparison.OrdinalIgnoreCase))?.Name
        ?? Model.Notebook.Tag;
    var viewTitle = Model.Notebook.View switch
    {
        "archive" or "archived" => "Archive",
        "completed" => "Completed",
        "today" => "Today",
        "overdue" => "Overdue",
        "reminders" => "Reminders",
        "shared" => "Shared with me",
        "labels" when !string.IsNullOrWhiteSpace(Model.Notebook.Tag) => selectedLabelName,
        "labels" => "Labels",
        "trash" => "Trash",
        _ => "All Notes"
    };
    var viewSubtitle = Model.Notebook.View switch
    {
        "archive" or "archived" => "Archived notes and checklists.",
        "completed" => "Completed reminders and notebook items.",
        "today" => "Items due today.",
        "overdue" => "Past reminders that still need attention.",
        "reminders" => "All active reminders across your notebook.",
        "shared" => "Items shared with you by PRISM and other users.",
        "labels" when !string.IsNullOrWhiteSpace(Model.Notebook.Tag) => $"Items labelled {selectedLabelName}.",
        "labels" => "Browse and organise notebook labels.",
        "trash" => "Items in Trash are permanently deleted after 30 days.",
        _ => "Notes, checklists and reminders."
    };
    // All Notes splits results into Pinned and Others; every other view uses Items.
    // ShowConferenceDigest is the same fact that renders the live PRISM card in this
    // view, so a visible system card counts as a result too.
    var resultCount = (Model.Notebook.View == "home"
        ? Model.Notebook.PinnedItems.Count + Model.Notebook.OtherItems.Count
        : Model.Notebook.Items.Count)
        + (Model.ShowConferenceDigest ? 1 : 0);
    var headingTitle = hasQuery ? $"Results for “{Model.Query!.Trim()}”" : viewTitle;
    var headingSubtitle = hasQuery ? $"{resultCount} {(resultCount == 1 ? "item" : "items")} in {viewTitle}" : viewSubtitle;
    var hasLabels = Model.Notebook.Tags.Any();
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
}
@section Styles { <link rel="stylesheet" href="~/css/notebook.css" asp-append-version="true" /> }

<div class="notebook-shell editor-collapsed" data-board-view="grid" data-view="@Model.Notebook.View" data-current-user-id="@currentUserId" data-system-shared-count="@Model.SystemSharedSurfaceCount" data-system-home-count="@Model.SystemHomeSurfaceCount" data-open-label-manager-on-load="@Model.EditLabels.ToString().ToLowerInvariant()">
    @* SECTION: Dedicated anti-forgery token for Notebook API mutations *@
    <div id="notebook-antiforgery-token" hidden>
        @Html.AntiForgeryToken()
    </div>
    <script id="notebook-label-catalog" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Notebook.Tags.Select(tag => new { id = tag.Id, name = tag.Name, count = tag.Count })))</script>
    <aside class="notebook-rail" aria-label="Notebook views">
        @* Counts appear only where they ask for attention; zero renders empty. *@
        @foreach (var item in Model.Notebook.RailItems.Where(item => item.Key is "home" or "today" or "overdue" or "reminders" or "shared"))
        {
            <a class="notebook-rail__item @(item.IsActive ? "is-active" : "")" href="@item.Url" aria-current="@(item.IsActive ? "page" : null)" hidden="@(item.Key == "overdue" && item.Count == 0 && !item.IsActive)"><i class="bi @item.Icon" aria-hidden="true"></i><span>@item.Label</span><b data-notebook-count="@item.Key">@(item.Count > 0 ? item.Count.ToString() : string.Empty)</b></a>
        }

        <div class="notebook-rail__group" data-notebook-label-group data-collapsed="false" hidden="@(!hasLabels)">
            <div class="notebook-rail__group-header">
                <button type="button" class="notebook-rail__group-toggle" data-notebook-label-group-toggle aria-expanded="true" aria-controls="notebook-label-rail">
                    <i class="bi bi-chevron-down" aria-hidden="true"></i><span>Labels</span>
                </button>
                <button type="button" class="notebook-rail__group-action" data-open-label-manager aria-haspopup="dialog" aria-label="Edit labels" title="Edit labels">
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                </button>
            </div>
            <div id="notebook-label-rail" class="notebook-rail-labels notebook-rail-labels--flat" data-notebook-label-rail aria-label="Notebook labels">
                @foreach (var label in Model.Notebook.Tags)
                {
                    var labelIsActive = string.Equals(Model.Notebook.Tag, label.Name, StringComparison.OrdinalIgnoreCase);
                    <a asp-page="/Notebook/Index"
                       asp-route-view="labels"
                       asp-route-tag="@label.Name"
                       aria-current="@(labelIsActive ? "page" : null)"
                       class="notebook-rail__item notebook-rail__item--label @(labelIsActive ? "is-active" : "")">
                        <i class="bi bi-tag" aria-hidden="true"></i><span>@label.Name</span><b>@(label.Count > 0 ? label.Count.ToString() : string.Empty)</b>
                    </a>
                }
            </div>
        </div>

        <button type="button"
                class="notebook-rail__item notebook-rail__item--button"
                data-open-label-manager
                data-notebook-label-create
                aria-haspopup="dialog"
                hidden="@hasLabels">
            <i class="bi bi-plus-lg" aria-hidden="true"></i><span>Create label</span><b aria-hidden="true"></b>
        </button>

        <div class="notebook-rail__separator" aria-hidden="true"></div>

        @foreach (var item in Model.Notebook.RailItems.Where(item => item.Key is "archive" or "completed" or "trash"))
        {
            <a class="notebook-rail__item @(item.IsActive ? "is-active" : "")" href="@item.Url" aria-current="@(item.IsActive ? "page" : null)"><i class="bi @item.Icon" aria-hidden="true"></i><span>@item.Label</span><b aria-hidden="true"></b></a>
        }
    </aside>

    <main class="notebook-main">
        <section class="notebook-commandbar">
            <div class="notebook-commandbar__heading"><h1>@headingTitle</h1><p>@headingSubtitle</p></div>
            <div class="notebook-command-actions">
                @if (Model.Notebook.View == "trash" && Model.Notebook.Items.Any())
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" data-empty-notebook-trash><i class="bi bi-trash3"></i> Empty trash</button>
                }
                <form method="get" class="notebook-search" aria-label="Search this notebook"><input type="hidden" name="view" value="@Model.Notebook.View" /><input type="hidden" name="filter" value="@Model.Notebook.Filter" /><input type="hidden" name="tag" value="@Model.Notebook.Tag" /><i class="bi bi-search" aria-hidden="true"></i><input name="Query" value="@Model.Query" placeholder="Search this notebook" aria-label="Search this notebook" enterkeyhint="search" autocomplete="off" />@if (hasQuery) { <a class="notebook-search__clear" asp-page="/Notebook/Index" asp-route-view="@Model.Notebook.View" asp-route-filter="@Model.Notebook.Filter" asp-route-tag="@Model.Notebook.Tag" aria-label="Clear search" title="Clear search"><i class="bi bi-x-lg" aria-hidden="true"></i></a> }</form>
                <div class="notebook-view-toggle" role="group" aria-label="Board layout">
                    <button type="button" data-notebook-view="grid" aria-label="Grid view"><i class="bi bi-grid-3x3-gap"></i></button>
                    <button type="button" data-notebook-view="list" aria-label="List view"><i class="bi bi-list-ul"></i></button>
                </div>
            </div>
        </section>

        @* SECTION: Expandable async notebook composer *@
        @if (string.Equals(Model.Notebook.View, "home", StringComparison.OrdinalIgnoreCase) && string.IsNullOrWhiteSpace(Model.Query) && string.IsNullOrWhiteSpace(Model.Tag) && string.IsNullOrWhiteSpace(Model.Notebook.Filter))
        {
                    <section class="notebook-composer" aria-label="Create a notebook item" data-notebook-composer data-state="collapsed">
                        <div class="notebook-composer__collapsed" data-composer-collapsed>
                            <button type="button" class="notebook-composer__trigger" data-composer-open-note>Take a note…</button>
                            <div class="notebook-composer__quick-actions">
                                <button type="button" class="notebook-composer__checklist-trigger" data-composer-open-checklist aria-label="Create checklist" title="Create checklist"><i class="bi bi-check2-square"></i></button>
                                <button type="button" class="notebook-composer__reminder-trigger" data-notebook-create-type="Reminder" aria-label="Create reminder" title="Create reminder"><i class="bi bi-bell"></i></button>
                            </div>
                        </div>
                        <div class="notebook-composer__expanded" data-composer-expanded hidden>
                            <div class="notebook-composer__top">
                                <input type="text" data-composer-title maxlength="220" placeholder="Title" aria-label="Note title" />
                                <button type="button" class="notebook-composer__pin" data-composer-pin aria-label="Pin note" aria-pressed="false" title="Pin note"><i class="bi bi-pin-angle"></i></button>
                            </div>
                            <textarea data-composer-body maxlength="20000" placeholder="Take a note…" aria-label="Note body"></textarea>
                            <div data-composer-checklist hidden></div>
                            <div class="notebook-composer__footer">
                                <div class="notebook-composer__tools" role="toolbar" aria-label="Note options">
                                    <partial name="_NotebookColourPicker" model="string.Empty" />
                                    <partial name="_NotebookLabelPicker" />
                                </div>
                                <span data-composer-status aria-live="polite"></span>
                                <button type="button" class="notebook-composer__close" data-composer-close>Close</button>
                            </div>
                        </div>
                    </section>
        }

        @* SECTION: Visible async operation errors *@
        <div class="notebook-global-error" data-notebook-global-error role="alert" hidden>
            <span data-notebook-global-error-text></span>
            <button type="button" data-notebook-global-error-close aria-label="Dismiss error">×</button>
        </div>

        @* SECTION: Card-first notebook board *@
        @if (Model.Notebook.View == "labels" && string.IsNullOrWhiteSpace(Model.Notebook.Tag))
        {
            <section class="notebook-labels-panel" data-notebook-label-directory aria-label="Notebook labels">
                <div class="notebook-section-header"><h2>Labels</h2><span>@Model.Notebook.Tags.Count</span></div>
                <div class="notebook-label-chips" data-notebook-label-directory-list>
                    @foreach (var tag in Model.Notebook.Tags)
                    {
                        <a asp-page="/Notebook/Index" asp-route-view="labels" asp-route-tag="@tag.Name" class="@(string.Equals(Model.Notebook.Tag, tag.Name.ToUpperInvariant(), StringComparison.OrdinalIgnoreCase) ? "is-active" : "")"><i class="bi bi-tag"></i>@tag.Name <span>@tag.Count</span></a>
                    }
                </div>
                <div class="notebook-label-directory-empty" data-notebook-label-directory-empty hidden="@(Model.Notebook.Tags.Any())">
                    <i class="bi bi-tags"></i><strong>No labels yet</strong><span>Create labels to organise your notes.</span>
                    <button type="button" class="btn btn-sm btn-primary" data-open-label-manager>Create label</button>
                </div>
            </section>
        }
        @if (Model.Notebook.View == "home")
        {
            var showSystemHome = Model.ShowConferenceDigest && Model.ConferenceDigestPreference is not null;
            var systemPinned = showSystemHome && Model.ConferenceDigestPreference!.IsPinned;
            var systemOthers = showSystemHome && !Model.ConferenceDigestPreference!.IsPinned;
            var ownedOthers = Model.Notebook.OtherItems.Where(item => item.OwnerId == currentUserId).ToArray();
            var sharedOthers = Model.Notebook.OtherItems.Where(item => item.OwnerId != currentUserId).ToArray();
            var pinnedSystemPosition = systemPinned ? Math.Clamp(Model.ConferenceDigestPreference!.HomePosition, 0, Model.Notebook.PinnedItems.Count) : -1;
            var otherSystemPosition = systemOthers ? Math.Clamp(Model.ConferenceDigestPreference!.HomePosition, 0, ownedOthers.Length) : -1;
            var pinnedVisibleCount = Model.Notebook.PinnedItems.Count + (systemPinned ? 1 : 0);
            var otherVisibleCount = Model.Notebook.OtherItems.Count + (systemOthers ? 1 : 0);
            var hasAnyHomeItems = pinnedVisibleCount > 0 || otherVisibleCount > 0;

            @* SECTION: Manual-order friendly home board sections. The PRISM system note
               participates in the user's visual order without becoming a NotebookItem. *@
            <section class="notebook-board-section" data-notebook-section="pinned" hidden="@(pinnedVisibleCount == 0)">
                <div class="notebook-section-header"><h2>Pinned</h2><span data-notebook-count="pinned">@pinnedVisibleCount</span></div>
                <div class="notebook-board" data-notebook-board="pinned" data-sortable="true" data-layout-policy="masonry-always" data-layout="masonry" data-item-count="@pinnedVisibleCount">
                    @for (var index = 0; index <= Model.Notebook.PinnedItems.Count; index++)
                    {
                        if (systemPinned && index == pinnedSystemPosition)
                        {
                            <partial name="_NotebookConferenceDigest" model="Model.CreateConferenceDigestCardVm()" />
                        }
                        if (index < Model.Notebook.PinnedItems.Count)
                        {
                            var item = Model.Notebook.PinnedItems[index];
                            <partial name="_NotebookCard" model="@(CardModelFactory.Create(item, new ProjectManagement.Services.Notebook.NotebookCardContext { View = Model.Notebook.View, Query = Model.Notebook.Query, Filter = Model.Notebook.Filter, Tag = Model.Notebook.Tag, SelectedId = null }))" />
                        }
                    }
                </div>
            </section>
            <section class="notebook-board-section" data-notebook-section="others">
                <div class="notebook-section-header" data-notebook-section-header="others" hidden="@(pinnedVisibleCount == 0 || otherVisibleCount == 0)"><h2>Others</h2><span data-notebook-count="others">@otherVisibleCount</span></div>
                <div class="notebook-board" data-notebook-board="others" data-sortable="true" data-layout-policy="masonry-always" data-layout="masonry" data-item-count="@otherVisibleCount">
                    @for (var index = 0; index <= ownedOthers.Length; index++)
                    {
                        if (systemOthers && index == otherSystemPosition)
                        {
                            <partial name="_NotebookConferenceDigest" model="Model.CreateConferenceDigestCardVm()" />
                        }
                        if (index < ownedOthers.Length)
                        {
                            var item = ownedOthers[index];
                            <partial name="_NotebookCard" model="@(CardModelFactory.Create(item, new ProjectManagement.Services.Notebook.NotebookCardContext { View = Model.Notebook.View, Query = Model.Notebook.Query, Filter = Model.Notebook.Filter, Tag = Model.Notebook.Tag, SelectedId = null }))" />
                        }
                    }
                    @foreach (var item in sharedOthers)
                    {
                        <partial name="_NotebookCard" model="@(CardModelFactory.Create(item, new ProjectManagement.Services.Notebook.NotebookCardContext { View = Model.Notebook.View, Query = Model.Notebook.Query, Filter = Model.Notebook.Filter, Tag = Model.Notebook.Tag, SelectedId = null }))" />
                    }
                </div>
                @if (!hasAnyHomeItems)
                {
                    <div class="notebook-empty" data-notebook-empty-state><i class="bi @emptyIcon notebook-empty__icon" aria-hidden="true"></i><h3>@emptyTitle</h3><p>@emptyText</p></div>
                }
            </section>
        }
        else if (Model.Notebook.View == "shared")
        {
            var showPrismShared = Model.ShowConferenceDigest
                && Model.ConferenceDigest is { TotalDirectionCount: > 0 };
            var hasPeopleShared = Model.Notebook.Items.Any();

            @* SECTION: System-shared surfaces are intentionally separated from person-to-person
               collaboration. They use normal Notebook card geometry but remain live/read-only. *@
            @if (showPrismShared)
            {
                <section class="notebook-board-section notebook-shared-source-section" data-notebook-shared-source="prism">
                    <div class="notebook-section-header"><h2>From PRISM</h2><span>1</span></div>
                    <div class="notebook-board notebook-system-shared-board" data-layout="grid" data-item-count="1">
                        <partial name="_NotebookConferenceDigest" model="Model.CreateConferenceDigestCardVm()" />
                    </div>
                </section>
            }

            @if (hasPeopleShared)
            {
                <section class="notebook-board-section notebook-shared-source-section" data-notebook-shared-source="people">
                    <div class="notebook-section-header"><h2>From people</h2><span>@Model.Notebook.Items.Count</span></div>
                    <div class="notebook-board" data-notebook-board data-layout-policy="masonry-always" data-layout="masonry" data-item-count="@Model.Notebook.Items.Count">
                        @foreach (var item in Model.Notebook.Items)
                        {
                            <partial name="_NotebookCard" model="@(CardModelFactory.Create(item, new ProjectManagement.Services.Notebook.NotebookCardContext { View = Model.Notebook.View, Query = Model.Notebook.Query, Filter = Model.Notebook.Filter, Tag = Model.Notebook.Tag, SelectedId = null }))" />
                        }
                    </div>
                </section>
            }

            @if (!showPrismShared && !hasPeopleShared)
            {
                <div class="notebook-empty" data-notebook-empty-state><i class="bi @emptyIcon notebook-empty__icon" aria-hidden="true"></i><h3>@emptyTitle</h3><p>@emptyText</p></div>
            }
        }
        else if (Model.Notebook.View is "reminders" or "today")
        {
            @* SECTION: Reminder views grouped by urgency. The grouping only partitions on
               IsPastDue / IsDueToday, which the service resolves once per item. *@
            var reminderItems = Model.Notebook.Items;
            var reminderGroups = new List<(string Key, string Title, NotebookItemListVm[] Items)>
            {
                ("past-due", "Past due", reminderItems.Where(item => item.IsPastDue).ToArray()),
                ("today", Model.Notebook.View == "today" ? "Later today" : "Today", reminderItems.Where(item => !item.IsPastDue && item.IsDueToday).ToArray())
            };
            if (Model.Notebook.View == "reminders")
            {
                reminderGroups.Add(("upcoming", "Upcoming", reminderItems.Where(item => !item.IsPastDue && !item.IsDueToday).ToArray()));
            }

            foreach (var group in reminderGroups)
            {
                <section class="notebook-board-section" data-notebook-group="@group.Key" hidden="@(group.Items.Length == 0)">
                    <div class="notebook-section-header"><h2>@group.Title</h2><span data-notebook-group-count>@group.Items.Length</span></div>
                    <div class="notebook-board" data-notebook-board data-layout-policy="masonry-always" data-layout="masonry" data-item-count="@group.Items.Length">
                        @foreach (var item in group.Items)
                        {
                            <partial name="_NotebookCard" model="@(CardModelFactory.Create(item, new ProjectManagement.Services.Notebook.NotebookCardContext { View = Model.Notebook.View, Query = Model.Notebook.Query, Filter = Model.Notebook.Filter, Tag = Model.Notebook.Tag, SelectedId = null }))" />
                        }
                    </div>
                </section>
            }

            @if (!reminderItems.Any())
            {
                <div class="notebook-empty" data-notebook-empty-state><i class="bi @emptyIcon notebook-empty__icon" aria-hidden="true"></i><h3>@emptyTitle</h3><p>@emptyText</p>@if (!hasQuery) { <a asp-page="/Notebook/Index" asp-route-view="@Model.Notebook.View" asp-route-mode="new" asp-route-type="Reminder" data-notebook-create-type="Reminder" class="btn btn-sm btn-primary">New Reminder</a> }</div>
            }
        }
        else if (!(Model.Notebook.View == "labels" && string.IsNullOrWhiteSpace(Model.Notebook.Tag)))
        {
            var showSystemInCurrentView = Model.ShowConferenceDigest && Model.ConferenceDigestPreference is not null;
            <section class="notebook-board-section">
                <div class="notebook-board" data-notebook-board data-layout-policy="masonry-always" data-layout="masonry" data-item-count="@(Model.Notebook.Items.Count + (showSystemInCurrentView ? 1 : 0))">
                    @if (showSystemInCurrentView)
                    {
                        <partial name="_NotebookConferenceDigest" model="Model.CreateConferenceDigestCardVm()" />
                    }
                    @foreach (var item in Model.Notebook.Items)
                    {
                        <partial name="_NotebookCard" model="@(CardModelFactory.Create(item, new ProjectManagement.Services.Notebook.NotebookCardContext { View = Model.Notebook.View, Query = Model.Notebook.Query, Filter = Model.Notebook.Filter, Tag = Model.Notebook.Tag, SelectedId = null }))" />
                    }
                </div>
                @if (!Model.Notebook.Items.Any() && !showSystemInCurrentView)
                {
                    var emptyType = Model.Notebook.View switch
                    {
                        "reminders" or "today" or "overdue" => "Reminder",
                        _ => "Note"
                    };
                    var cta = hasQuery || Model.Notebook.View is "archive" or "archived" or "completed" or "trash" ? null : $"New {emptyType}";
                    <div class="notebook-empty" data-notebook-empty-state><i class="bi @emptyIcon notebook-empty__icon" aria-hidden="true"></i><h3>@emptyTitle</h3><p>@emptyText</p>@if (cta is not null) { <a asp-page="/Notebook/Index" asp-route-view="@Model.Notebook.View" asp-route-mode="new" asp-route-type="@emptyType" data-notebook-create-type="@emptyType" class="btn btn-sm btn-primary">@cta</a> }</div>
                }
            </section>
        }
        <div class="visually-hidden" data-notebook-reorder-live aria-live="polite" aria-atomic="true"></div>
    </main>

</div>


<partial name="_NotebookCardLabelPicker" />
<partial name="_NotebookLabelManager" model="Model.Notebook.Tags" />
<partial name="_NotebookConfirmDialog" />
<partial name="_NotebookToastRegion" />
<partial name="_NotebookCollaboratorsDialog" />
<partial name="_NotebookEditorTemplate" />
@if (Model.ConferenceDigest is { TotalDirectionCount: > 0 } conferenceDigestModal)
{
    <partial name="_NotebookConferenceDigestModal" model="conferenceDigestModal" />
}

@section Scripts { <script type="module" src="~/dist/notebook-index.bundle.js" asp-append-version="true"></script> }
