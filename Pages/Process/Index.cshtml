@page
@model ProjectManagement.Pages.Process.IndexModel
@{
    ViewData["Title"] = "Procurement Process";
    ViewData["PageShell"] = "workspace";
    ViewData["UseFullWidth"] = true;
    var updatedText = Model.ProcessUpdatedOn.HasValue
        ? Model.ProcessUpdatedOn.Value.ToLocalTime().ToString("dd MMM yyyy")
        : null;
}

<section class="process-page"
         data-process-flow-root
         data-process-version="@Model.ProcessVersion"
         data-can-edit-checklist="@(Model.CanEditChecklist ? "true" : "false")"
         data-can-edit-purpose="@(Model.CanEditPurpose ? "true" : "false")">

    <header class="process-header">
        <div class="process-header__identity">
            <h1 id="processRouteTitle">The procurement route</h1>
            <p class="process-header__summary">
                <span data-route-summary>Loading stages…</span>
                @if (updatedText is not null)
                {
                    <span>Guidance updated @updatedText</span>
                }
                <span>Version @Model.ProcessVersion</span>
            </p>
        </div>

        <div class="process-header__tools">
            <div class="route-search" data-route-search>
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search"
                       id="processStageSearch"
                       class="form-control"
                       placeholder="Find a stage or topic"
                       autocomplete="off"
                       role="combobox"
                       aria-autocomplete="list"
                       aria-expanded="false"
                       aria-controls="processStageSearchResults"
                       aria-label="Find a stage by name, code or a word in its guidance"
                       data-stage-search />
                <div class="route-search__results" id="processStageSearchResults" role="listbox" aria-label="Matching stages" data-search-results hidden></div>
            </div>
            <button type="button" class="btn btn-primary route-walk-button" data-action="toggle-walkthrough" aria-pressed="false" aria-label="Walk me through it">
                <i class="bi bi-signpost-split" aria-hidden="true"></i>
                <span data-walk-label>Walk me through it</span>
            </button>
        </div>
    </header>

    <section class="route-board" aria-labelledby="processRouteTitle" data-route-board>
        <div class="route-map-scroll" data-route-scroll>
            <div class="route-map" data-route-map role="group" aria-label="Procurement route. Use the arrow keys to move between stages." aria-busy="true">
                <svg class="route-map__lines" data-route-svg viewBox="0 0 1000 300" preserveAspectRatio="none" aria-hidden="true"></svg>
                <div class="route-map__loading" data-route-placeholder>
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span>Loading the procurement route…</span>
                </div>
            </div>
        </div>

        @* Phones get a stage picker and a vertical route list instead of the wide map. *@
        <div class="route-picker">
            <button type="button" class="route-picker__step" data-action="previous-stage" aria-label="Previous stage">
                <i class="bi bi-chevron-left" aria-hidden="true"></i>
            </button>
            <label class="visually-hidden" for="processStagePicker">Stage</label>
            <select id="processStagePicker" class="form-select" data-stage-picker></select>
            <button type="button" class="route-picker__step" data-action="next-stage" aria-label="Next stage">
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </button>
        </div>
        <details class="route-list" data-route-list-panel>
            <summary>Show the whole route</summary>
            <ol class="route-list__items" data-route-list></ol>
        </details>

        <div class="route-board__footer">
            <ul class="route-legend" aria-label="Legend">
                <li><i class="route-legend__line" aria-hidden="true"></i>Main route</li>
                <li><i class="route-legend__line route-legend__line--fork" aria-hidden="true"></i>Runs in parallel</li>
                <li><i class="route-legend__line route-legend__line--conditional" aria-hidden="true"></i>Only when required</li>
            </ul>
            <p class="route-board__keys"><kbd>←</kbd><kbd>→</kbd> move between stages on the map</p>
        </div>
    </section>

    @* Compact route that stays under the PRISM header once the map has scrolled away. *@
    <div class="route-strip-dock">
        <nav class="route-strip" data-route-strip aria-label="Stages" aria-hidden="true">
            <button type="button" class="route-strip__step" data-action="previous-stage" aria-label="Previous stage" tabindex="-1">
                <i class="bi bi-chevron-left" aria-hidden="true"></i>
            </button>
            <ol class="route-strip__dots" data-route-strip-dots></ol>
            <span class="route-strip__current" data-route-strip-current></span>
            <button type="button" class="route-strip__step" data-action="next-stage" aria-label="Next stage" tabindex="-1">
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </button>
        </nav>
    </div>

    <div class="visually-hidden" aria-live="polite" data-route-announcer></div>

    <section class="stage-guide" data-stage-guide aria-labelledby="processStageTitle">
        <article class="stage-sheet">
            <div class="stage-walk" data-walk-panel hidden>
                <div class="stage-walk__text">
                    <span class="stage-walk__step" data-walk-step></span>
                    <p data-walk-story></p>
                </div>
                <div class="stage-walk__actions">
                    <button type="button" class="stage-action" data-action="walk-restart" data-walk-restart>
                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> From stage 1
                    </button>
                    <button type="button" class="stage-action" data-action="previous-stage" data-walk-back>
                        <i class="bi bi-arrow-left" aria-hidden="true"></i> Back
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" data-action="walk-next" data-walk-next></button>
                    <button type="button" class="stage-action stage-action--icon" data-action="toggle-walkthrough" aria-label="End walkthrough">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <header class="stage-sheet__header">
                <div class="stage-sheet__number" aria-hidden="true">
                    <span data-stage-number>01</span><small data-stage-total>/15</small>
                </div>
                <div class="stage-sheet__identity">
                    <h2 id="processStageTitle" data-stage-title tabindex="-1">Loading stage…</h2>
                    <div class="stage-sheet__chips">
                        <span class="stage-chip stage-chip--code" data-stage-code-label></span>
                        <span class="stage-chip stage-chip--conditional" data-stage-conditional hidden>
                            <i class="bi bi-signpost" aria-hidden="true"></i> Only when required
                        </span>
                        <span class="stage-chip stage-chip--parallel" data-stage-parallel hidden></span>
                    </div>
                </div>
            </header>

            <section class="stage-block stage-block--purpose">
                <div class="stage-block__heading">
                    <h3>Why this stage exists</h3>
                    <button type="button" class="stage-action" data-action="edit-purpose" data-purpose-edit hidden>
                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                        Edit purpose
                    </button>
                </div>
                <p class="stage-purpose" data-stage-purpose>Loading stage purpose…</p>
                <small class="stage-block__meta" data-purpose-updated></small>
            </section>

            <section class="stage-block">
                <div class="stage-block__heading">
                    <h3>Processing checklist <span class="stage-block__count" data-checklist-count></span></h3>
                    <div class="stage-block__actions">
                        <button type="button" class="stage-action" data-action="copy-checklist" data-checklist-copy hidden>
                            <i class="bi bi-clipboard" aria-hidden="true"></i>
                            Copy as text
                        </button>
                        <button type="button" class="stage-action" data-action="toggle-checklist-edit" data-checklist-manage hidden>
                            <i class="bi bi-sliders" aria-hidden="true"></i>
                            <span data-manage-label>Manage</span>
                        </button>
                        <button type="button" class="btn btn-primary btn-sm stage-add" data-action="add-item" data-checklist-add hidden>
                            <i class="bi bi-plus-lg" aria-hidden="true"></i>
                            Add item
                        </button>
                    </div>
                </div>
                <ol class="stage-checklist" data-checklist-list aria-busy="false"></ol>
            </section>

            <nav class="stage-pager" aria-label="Previous and next stage">
                <button type="button" class="stage-pager__link" data-action="previous-stage" data-pager-previous>
                    <span class="stage-pager__direction"><i class="bi bi-arrow-left" aria-hidden="true"></i> Previous</span>
                    <strong data-pager-previous-name></strong>
                </button>
                <button type="button" class="stage-pager__link stage-pager__link--next" data-action="next-stage" data-pager-next>
                    <span class="stage-pager__direction">Next <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                    <strong data-pager-next-name></strong>
                </button>
            </nav>
        </article>

        <aside class="stage-rail" aria-label="How this stage connects">
            <section class="stage-card">
                <h3>How it connects</h3>
                <p class="stage-card__story" data-stage-story></p>
                <div class="stage-neighbours" data-stage-neighbours></div>
            </section>
        </aside>
    </section>
</section>

<div class="modal fade" id="stagePurposeModal" tabindex="-1" aria-labelledby="stagePurposeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content process-modal" data-purpose-form>
            <div class="modal-header">
                <div>
                    <div class="process-modal__eyebrow" data-modal-stage>STAGE PURPOSE</div>
                    <h2 class="modal-title fs-5" id="stagePurposeModalLabel">Edit purpose</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label for="stagePurposeText" class="form-label fw-semibold">Why this stage exists</label>
                <textarea class="form-control" id="stagePurposeText" name="purpose" rows="6" maxlength="600" required></textarea>
                <div class="form-text d-flex justify-content-between">
                    <span>Keep the purpose concise and authoritative.</span>
                    <span data-purpose-character-count>0 / 600</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">
                    <span data-submit-label>Save purpose</span>
                    <span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true" hidden></span>
                </button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="checklistItemModal" tabindex="-1" aria-labelledby="checklistItemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content process-modal" data-checklist-form>
            <div class="modal-header">
                <div>
                    <div class="process-modal__eyebrow" data-modal-stage>PROCESSING CHECKLIST</div>
                    <h2 class="modal-title fs-5" id="checklistItemModalLabel">Checklist item</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label for="checklistItemText" class="form-label fw-semibold">Action or verification required</label>
                <textarea class="form-control"
                          id="checklistItemText"
                          name="text"
                          rows="8"
                          maxlength="512"
                          spellcheck="true"
                          placeholder="Describe the action or check"
                          aria-describedby="checklistItemHelp"
                          required></textarea>
                <div class="form-text d-flex justify-content-between" id="checklistItemHelp">
                    <span>Use blank lines and start sub-items with <strong>1.</strong> or <strong>-</strong>, for example "Documents required" followed by "1. Drawings". Formatting is applied automatically.</span>
                    <span data-character-count>0 / 512</span>
                </div>
                <input type="hidden" name="itemId" />
                <input type="hidden" name="itemRowVersion" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">
                    <span data-submit-label>Add item</span>
                    <span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true" hidden></span>
                </button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="checklistDeleteModal" tabindex="-1" aria-labelledby="checklistDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content process-modal" data-checklist-delete-form>
            <div class="modal-header">
                <div>
                    <div class="process-modal__eyebrow" data-modal-stage>PROCESSING CHECKLIST</div>
                    <h2 class="modal-title fs-5" id="checklistDeleteModalLabel">Remove checklist item?</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <blockquote class="process-modal__quote" data-delete-preview></blockquote>
                <p class="mb-0">This item will be permanently removed from the stage guidance for everyone.</p>
                <input type="hidden" name="itemId" />
                <input type="hidden" name="itemRowVersion" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger">
                    <span data-submit-label>Delete item</span>
                    <span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true" hidden></span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/process-flow.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/lib/sortable/1.15.2/Sortable.min.js" asp-append-version="true"></script>
    <script src="~/js/process-route.js" asp-append-version="true"></script>
    <script type="module" src="~/js/process-flow.js" asp-append-version="true"></script>
}
