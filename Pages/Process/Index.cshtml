@page
@model ProjectManagement.Pages.Process.IndexModel
@{
    ViewData["Title"] = "Procurement Process";
    var updatedText = Model.ProcessUpdatedOn.HasValue
        ? Model.ProcessUpdatedOn.Value.ToLocalTime().ToString("dd MMM yyyy")
        : "Not available";
}

<section class="process-page"
         data-process-flow-root
         data-process-version="@Model.ProcessVersion"
         data-can-edit-checklist="@(Model.CanEditChecklist ? "true" : "false")"
         data-can-edit-purpose="@(Model.CanEditPurpose ? "true" : "false")">

    <header class="process-hero" data-process-hero>
        <div class="process-hero__glow process-hero__glow--one" aria-hidden="true"></div>
        <div class="process-hero__glow process-hero__glow--two" aria-hidden="true"></div>
        <div class="process-hero__grid" aria-hidden="true"></div>

        <div class="process-hero__content">
            <div class="process-eyebrow">PROCUREMENT GOVERNANCE</div>
            <h1>From concept to capability.</h1>
            <p>
                Travel through the complete procurement process, understand every gate and open the
                authorised checklist at the point where it matters.
            </p>

            <div class="process-hero__actions">
                <button type="button" class="btn process-primary-action" data-action="begin-journey">
                    <span>Begin journey</span>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn process-secondary-action" data-action="show-map">
                    <i class="bi bi-diagram-3" aria-hidden="true"></i>
                    <span>View complete process</span>
                </button>
            </div>
        </div>

        <div class="process-hero__meta" aria-label="Process summary">
            <div><strong data-stage-count>15</strong><span>Stages</span></div>
            <div><strong>@Model.ProcessVersion</strong><span>Workflow version</span></div>
            <div><strong>@updatedText</strong><span>Guidance updated</span></div>
        </div>
    </header>

    <section class="process-commandbar" aria-label="Process controls">
        <div class="process-mode-switch" role="group" aria-label="Process view">
            <button type="button" class="process-mode-button is-active" data-mode-button="journey" aria-pressed="true">
                <i class="bi bi-signpost-split" aria-hidden="true"></i>
                Journey
            </button>
            <button type="button" class="process-mode-button" data-mode-button="map" aria-pressed="false">
                <i class="bi bi-diagram-3" aria-hidden="true"></i>
                Complete map
            </button>
        </div>

        <div class="process-search-wrap">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search"
                   class="form-control"
                   placeholder="Search or jump to a stage…"
                   data-stage-search
                   aria-label="Search or jump to a procurement stage" />
            <button type="button" class="btn process-search-clear" data-search-clear aria-label="Clear search" hidden>
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
            <div class="process-search-results" data-search-results hidden></div>
        </div>

        <div class="process-command-actions">
            <button type="button" class="btn process-command-button process-intro-button" data-action="show-introduction" title="Show introduction">
                <i class="bi bi-stars" aria-hidden="true"></i>
                <span class="d-none d-xxl-inline">Introduction</span>
            </button>
            <button type="button" class="btn process-command-button" data-action="toggle-fullscreen" title="Open the journey in full screen">
                <i class="bi bi-arrows-fullscreen" aria-hidden="true"></i>
                <span class="d-none d-xxl-inline">Full screen</span>
            </button>
            <button type="button" class="btn process-command-button" data-action="print-process" title="Print process" aria-label="Print process">
                <i class="bi bi-printer" aria-hidden="true"></i>
            </button>
        </div>
    </section>

    <section class="process-experience" data-process-experience data-mode="journey">
        <div class="process-scene" data-process-scene tabindex="0" aria-label="Interactive procurement journey">
            <div class="process-scene__atmosphere" aria-hidden="true"></div>
            <div class="process-scene__horizon" aria-hidden="true"></div>
            <div class="process-scene__noise" aria-hidden="true"></div>

            <div class="process-world-viewport" data-world-viewport>
                <div class="process-world" data-process-world aria-live="polite" aria-busy="true">
                    <svg class="process-path-layer" data-process-svg aria-hidden="true"></svg>
                    <div class="process-node-layer" data-process-nodes></div>
                </div>
            </div>

            <div class="process-loading" data-flow-placeholder>
                <div class="spinner-border" role="status" aria-hidden="true"></div>
                <span>Preparing procurement journey…</span>
            </div>

            <div class="process-scene__topline">
                <div class="process-scene__identity">
                    <span>PROCUREMENT JOURNEY</span>
                    <strong data-scene-stage-label>Loading workflow…</strong>
                </div>
                <div class="process-scene__tools">
                    <div class="process-map-tools" data-map-tools hidden>
                        <button type="button" data-action="zoom-out" aria-label="Zoom out"><i class="bi bi-dash-lg"></i></button>
                        <span data-map-zoom>100%</span>
                        <button type="button" data-action="zoom-in" aria-label="Zoom in"><i class="bi bi-plus-lg"></i></button>
                        <button type="button" data-action="reset-map" aria-label="Reset map"><i class="bi bi-bullseye"></i></button>
                    </div>
                    <button type="button" class="process-fullscreen-exit" data-action="toggle-fullscreen" data-fullscreen-exit aria-label="Exit full screen" hidden>
                        <i class="bi bi-fullscreen-exit" aria-hidden="true"></i>
                        <span>Exit full screen</span>
                    </button>
                </div>
            </div>

            <div class="process-scene__footer">
                <button type="button" class="process-stage-nav" data-action="previous-stage" aria-label="Previous stage">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                </button>

                <div class="process-progress">
                    <div class="process-progress__track" data-progress-track></div>
                    <div class="process-progress__copy">
                        <span data-progress-current>01</span>
                        <span>of</span>
                        <span data-progress-total>15</span>
                    </div>
                </div>

                <button type="button" class="process-stage-nav" data-action="next-stage" aria-label="Next stage">
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
            </div>

            <div class="process-wheel-cue" data-wheel-cue>
                <i class="bi bi-mouse" aria-hidden="true"></i>
                <span>Scroll or use arrow keys to travel</span>
            </div>
        </div>

        <aside class="stage-guide" data-stage-guide aria-label="Selected stage guidance">
            <div class="stage-guide__header">
                <div class="stage-guide__number" data-stage-number>01</div>
                <div class="stage-guide__identity">
                    <div class="stage-guide__code-row">
                        <span data-stage-code-label>FS</span>
                        <span class="stage-guide__conditional" data-stage-conditional hidden>Conditional</span>
                    </div>
                    <h2 data-stage-title>Feasibility Study</h2>
                </div>
            </div>

            <section class="stage-purpose-block">
                <div class="stage-section-heading">
                    <div>
                        <span>Purpose</span>
                        <small data-purpose-updated></small>
                    </div>
                    <button type="button" class="stage-inline-action" data-action="edit-purpose" data-purpose-edit hidden>
                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                        Edit
                    </button>
                </div>
                <p data-stage-purpose>Loading stage purpose…</p>
            </section>

            <section class="stage-checklist-block">
                <div class="stage-section-heading stage-section-heading--checklist">
                    <div>
                        <span>Processing checklist</span>
                        <small><strong data-checklist-count>0</strong> reference checks</small>
                    </div>
                    <div class="stage-checklist-actions">
                        <button type="button" class="stage-inline-action" data-action="toggle-checklist-edit" data-checklist-manage hidden>
                            <i class="bi bi-sliders" aria-hidden="true"></i>
                            <span data-manage-label>Manage</span>
                        </button>
                        <button type="button" class="stage-inline-action stage-inline-action--primary" data-action="add-item" data-checklist-add hidden>
                            <i class="bi bi-plus-lg" aria-hidden="true"></i>
                            Add item
                        </button>
                    </div>
                </div>

                <ol class="stage-checklist" data-checklist-list aria-live="polite" aria-busy="false"></ol>
            </section>
        </aside>
    </section>
</section>

<div class="modal fade" id="stagePurposeModal" tabindex="-1" aria-labelledby="stagePurposeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content process-modal" data-purpose-form>
            <div class="modal-header">
                <div>
                    <div class="process-modal__eyebrow">STAGE PURPOSE</div>
                    <h2 class="modal-title fs-5" id="stagePurposeModalLabel">Edit purpose</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label for="stagePurposeText" class="form-label fw-semibold">Why this stage exists</label>
                <textarea class="form-control" id="stagePurposeText" name="purpose" rows="6" maxlength="600" required></textarea>
                <div class="form-text d-flex justify-content-between">
                    <span>Keep the purpose concise and authoritative.</span>
                    <span data-purpose-character-count>0 / 600</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">
                    <span data-submit-label>Save purpose</span>
                    <span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true" hidden></span>
                </button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="checklistItemModal" tabindex="-1" aria-labelledby="checklistItemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content process-modal" data-checklist-form>
            <div class="modal-header">
                <div>
                    <div class="process-modal__eyebrow">PROCESSING CHECKLIST</div>
                    <h2 class="modal-title fs-5" id="checklistItemModalLabel">Checklist item</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label for="checklistItemText" class="form-label fw-semibold">Action or verification required</label>
                <textarea class="form-control" id="checklistItemText" name="text" rows="5" maxlength="512" required></textarea>
                <div class="form-text d-flex justify-content-between">
                    <span>Use clear, action-oriented language.</span>
                    <span data-character-count>0 / 512</span>
                </div>
                <input type="hidden" name="itemId" />
                <input type="hidden" name="itemRowVersion" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">
                    <span data-submit-label>Add item</span>
                    <span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true" hidden></span>
                </button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="checklistDeleteModal" tabindex="-1" aria-labelledby="checklistDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content process-modal" data-checklist-delete-form>
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="checklistDeleteModalLabel">Remove checklist item?</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">This item will be permanently removed from the stage guidance.</p>
                <input type="hidden" name="itemId" />
                <input type="hidden" name="itemRowVersion" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger">
                    <span data-submit-label>Delete item</span>
                    <span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true" hidden></span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/process-flow.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/lib/sortable/1.15.2/Sortable.min.js" asp-append-version="true"></script>
    <script type="module" src="~/js/process-flow.js" asp-append-version="true"></script>
}
