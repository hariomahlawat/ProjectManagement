@page "/ItProjects/{id:int}"
@using ProjectManagement.Models.ItProjects
@using ProjectManagement.Pages.ItProjects
@using ProjectManagement.Services.ItProjects
@using ProjectManagement.Utilities
@model ProjectManagement.Pages.ItProjects.DetailsModel
@{
    ViewData["Title"] = Model.Project.Title;
    ViewData["PageShell"] = "wide";
    var editErrors = Model.DrawerErrors(DetailsModel.OpenEdit, nameof(Model.Details));
    var stageErrors = Model.DrawerErrors(DetailsModel.OpenStages, nameof(Model.Stages));
    var dropErrors = Model.DrawerErrors(DetailsModel.OpenDrop, nameof(Model.Drop));
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/it-projects.css" asp-append-version="true" />
}

<div class="itp-page itp-page--details" data-itp-details data-itp-open="@Model.Open">
    <div class="itp-crumb" aria-label="Breadcrumb">ERP / <a asp-page="./Index">IT projects</a> / @Model.Project.PppReferenceNumber</div>
    <header class="itp-hero">
        <div class="itp-hero__top">
            <div class="itp-hero__id">
                <div class="itp-hero__chips">
                    <span class="itp-ref" title="IT PPP reference number in its first year">@Model.Project.PppReferenceNumber</span>
                    <span class="itp-chip itp-chip--fy">@ItProjectBoardPresentation.FinancialYear(Model.Project.FinancialYearStart)</span>
                    @if (Model.LatestYear is { } latest && !latest.IsOwnYear)
                    {
                        <span class="itp-type itp-type--@latest.Code.ToLowerInvariant()" title="@latest.Label in FY @FinancialYearHelper.Format(latest.FinancialYearStart)@(latest.PppReferenceNumber is { } number ? $", {number}" : ", number not entered")">@latest.Code · FY @FinancialYearHelper.Format(latest.FinancialYearStart)</span>
                    }
                </div>
                <h1 class="itp-hero__title">@Model.Project.Title</h1>
                <p class="itp-hero__desc itp-desc">@Model.Project.Description</p>
            </div>
            @if (Model.CanManage)
            {
                <div class="itp-hero__actions">
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="offcanvas" data-bs-target="#itpEditDrawer" aria-controls="itpEditDrawer">Edit</button>
                    <button type="button" class="btn btn-primary itp-btn-primary" data-bs-toggle="offcanvas" data-bs-target="#itpStagesDrawer" aria-controls="itpStagesDrawer"><i class="bi bi-signpost-split" aria-hidden="true"></i><span>Update stages</span></button>
                </div>
            }
        </div>
        @if (Model.HeroStatus is { } heroStatus)
        {
            <p class="itp-hero__status itp-hero__status--@heroStatus.Tone">
                <b>@heroStatus.Text</b>@if (heroStatus.Note is not null)
                {
                    <span> · @heroStatus.Note</span>
                }
            </p>
        }
    </header>

    <section class="itp-journey @(Model.IsDropped ? "itp-journey--dropped" : null)" aria-labelledby="itpJourneyTitle">
        <div class="itp-journey__head">
            <h2 class="itp-journey__title" id="itpJourneyTitle">Journey</h2>
            <p class="itp-journey__lead">Days between stages above the line, counted from the stage dates.</p>
        </div>
        <ol class="itp-journey__steps">
            @foreach (var step in Model.Journey)
            {
                <li class="itp-jstep itp-jstep--@step.State itp-jstep--@step.Tone @(step.Travelled ? "itp-jstep--travelled" : null)">
                    @if (step.Gap is not null)
                    {
                        <span class="itp-jstep__gap"><span>@step.Gap</span></span>
                    }
                    <span class="itp-jstep__dot" aria-hidden="true"></span>
                    <span class="itp-jstep__label">@step.Label</span>
                    <span class="itp-jstep__date">@step.DateText</span>
                    @if (step.Cost is not null)
                    {
                        <span class="itp-jstep__cost">@step.Cost</span>
                    }
                    <span class="visually-hidden">@(step.Gap is null ? null : $", {step.Gap} since the previous stage")</span>
                </li>
            }
        </ol>
    </section>

    <div class="itp-grid">
        <div class="itp-grid__main">
            <section class="itp-card itp-remarks" id="remarks" aria-labelledby="itpRemarksTitle">
                <h2 class="itp-card__title" id="itpRemarksTitle">Remarks and history <span class="itp-card__count">@Model.Remarks.Count</span></h2>
                @if (Model.CanRemark)
                {
                    var remarkErrors = Model.DrawerErrors(DetailsModel.OpenRemark, nameof(Model.Remark));
                    <form method="post" asp-page-handler="RemarkAdd" asp-route-id="@Model.Project.Id" class="itp-composer" id="remark-composer" novalidate>
                        @if (remarkErrors.Count > 0)
                        {
                            <div class="alert alert-danger itp-drawer__errors" role="alert">
                                <ul class="mb-0 ps-3">
                                    @foreach (var error in remarkErrors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </div>
                        }
                        @if (Model.CanWriteConference)
                        {
                            <div class="itp-kind" role="radiogroup" aria-label="Kind of remark">
                                <label class="itp-kind__opt">
                                    <input type="radio" asp-for="Remark.Type" value="General" />
                                    <span>Remark</span>
                                </label>
                                <label class="itp-kind__opt itp-kind__opt--conference">
                                    <input type="radio" asp-for="Remark.Type" value="Conference" />
                                    <span><i class="bi bi-people" aria-hidden="true"></i> Conference</span>
                                </label>
                            </div>
                        }
                        <textarea asp-for="Remark.Body" class="form-control itp-composer__text" rows="3" maxlength="@ItProjectRemark.BodyMaxLength" placeholder="Write a remark as @Model.RemarkRole…"></textarea>
                        <div class="itp-composer__row">
                            <label class="itp-composer__field"><span>Event date</span><input type="date" asp-for="Remark.EventDate" asp-format="{0:yyyy-MM-dd}" class="form-control form-control-sm" /></label>
                            <span class="itp-composer__spacer"></span>
                            <span class="itp-composer__as">as <span class="itp-role @ItProjectBoardPresentation.RoleClass(Model.RemarkRole ?? "")">@Model.RemarkRole</span></span>
                            <button type="submit" class="btn btn-primary itp-btn-primary btn-sm">Add remark</button>
                        </div>
                    </form>
                }

                @if (Model.Feed.Count == 0)
                {
                    <p class="itp-remarks__empty">
                        @if (Model.CanRemark)
                        {
                            <text>No remarks yet. Note where this case stands, or what is holding it up.</text>
                        }
                        else
                        {
                            <text>No remarks yet. The ITO, MCO, HoD and Comdt can write them.</text>
                        }
                    </p>
                }
                else
                {
                    <ol class="itp-remarks__list">
                        @foreach (var entry in Model.Feed)
                        {
                            if (entry.Remark is { } remark)
                            {
                                var canEdit = Model.CanEditRemark(remark);
                                var canDelete = Model.CanDeleteRemark(remark);
                                var rowVersion = DetailsModel.EncodeRowVersion(remark.RowVersion);
                            <li class="itp-remark @(remark.Type == ItProjectRemarkType.Conference ? "itp-remark--conference" : null)" id="remark-@remark.Id">
                                <span class="itp-remark__avatar @ItProjectBoardPresentation.RoleClass(remark.AuthorRole)" aria-hidden="true">@ItProjectBoardPresentation.Initials(remark.AuthorName)</span>
                                <div class="itp-remark__main">
                                    <div class="itp-remark__who">
                                        <span class="itp-remark__name">@remark.AuthorName</span>
                                        <span class="itp-role @ItProjectBoardPresentation.RoleClass(remark.AuthorRole)">@remark.AuthorRole</span>
                                        @if (remark.Type == ItProjectRemarkType.Conference)
                                        {
                                            <span class="itp-remark__conf"><i class="bi bi-people" aria-hidden="true"></i> Conference</span>
                                        }
                                        <time class="itp-remark__when" datetime="@remark.EventDate.ToString("yyyy-MM-dd")">@ItProjectBoardPresentation.ShortDate(remark.EventDate)</time>
                                    </div>
                                    <div class="itp-remark__body">@remark.Body</div>
                                    <div class="itp-remark__meta">
                                        @if (remark.LastEditedAtUtc.HasValue)
                                        {
                                            <span>edited</span>
                                        }
                                        @if (canEdit)
                                        {
                                            <a class="itp-remark__action" href="#remark-edit-@remark.Id" data-itp-remark-edit>Edit</a>
                                        }
                                        @if (canDelete)
                                        {
                                            <form method="post" asp-page-handler="RemarkDelete" asp-route-id="@Model.Project.Id" class="itp-remark__delete"
                                                  data-confirm="Delete this remark? It is removed from the project; the audit trail keeps it." data-confirm-tone="danger" data-confirm-action="Delete remark">
                                                <input type="hidden" name="remarkId" value="@remark.Id" />
                                                <input type="hidden" name="remarkRowVersion" value="@rowVersion" />
                                                <button type="submit" class="itp-remark__action itp-remark__action--danger">Delete</button>
                                            </form>
                                        }
                                    </div>
                                    @if (canEdit)
                                    {
                                        <details class="itp-remark__editor" id="remark-edit-@remark.Id">
                                            <summary class="visually-hidden">Edit this remark</summary>
                                            <form method="post" asp-page-handler="RemarkEdit" asp-route-id="@Model.Project.Id" class="itp-composer itp-composer--edit" novalidate>
                                                <input type="hidden" name="RemarkEdit.Id" value="@remark.Id" />
                                                <input type="hidden" name="RemarkEdit.RowVersion" value="@rowVersion" />
                                                <textarea name="RemarkEdit.Body" class="form-control itp-composer__text" rows="3" maxlength="@ItProjectRemark.BodyMaxLength" aria-label="Remark" required>@remark.Body</textarea>
                                                <div class="itp-composer__row">
                                                    <label class="itp-composer__field"><span>Event date</span><input type="date" name="RemarkEdit.EventDate" value="@remark.EventDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" required /></label>
                                                    <span class="itp-composer__spacer"></span>
                                                    <a class="btn btn-outline-secondary btn-sm" href="#remark-@remark.Id" data-itp-remark-cancel>Cancel</a>
                                                    <button type="submit" class="btn btn-primary btn-sm">Save remark</button>
                                                </div>
                                            </form>
                                        </details>
                                    }
                                </div>
                            </li>
                            }
                            else if (entry.Folded)
                            {
                                <li class="itp-event itp-event--folded">
                                    <span class="itp-event__dot" aria-hidden="true"></span>
                                    <details class="itp-event__more">
                                        <summary>@entry.FoldedText</summary>
                                        <ol class="itp-event__list">
                                            @foreach (var item in entry.Stages)
                                            {
                                                <li><span>@item.Text</span><time datetime="@item.On.ToString("yyyy-MM-dd")">@ItProjectBoardPresentation.ShortDate(item.On)</time></li>
                                            }
                                        </ol>
                                    </details>
                                </li>
                            }
                            else
                            {
                                var item = entry.Stages[0];
                                <li class="itp-event @(item.StageCode == "DROPPED" ? "itp-event--dropped" : null)">
                                    <span class="itp-event__dot" aria-hidden="true"></span>
                                    <span class="itp-event__text">@item.Text</span>
                                    <time class="itp-event__when" datetime="@item.On.ToString("yyyy-MM-dd")">@ItProjectBoardPresentation.ShortDate(item.On)</time>
                                </li>
                            }
                        }
                    </ol>
                }
            </section>
        </div>
        <aside class="itp-grid__side">
            <section class="itp-card itp-card--facts" aria-labelledby="itpRecordTitle">
                <h2 class="itp-card__title" id="itpRecordTitle">Record</h2>
                <dl class="itp-facts">
                    <dt>Added</dt><dd>@ItProjectPagePresentation.LongDate(DateOnly.FromDateTime(Model.Project.CreatedAtUtc))</dd>
                    <dt>Last change</dt><dd>@ItProjectPagePresentation.LongDate(DateOnly.FromDateTime(Model.Project.UpdatedAtUtc))@(Model.UpdatedByName is { } who ? $" · {who}" : "")</dd>
                </dl>
                @if (Model.YearTypes.Count > 0)
                {
                    <h3 class="itp-years__title">In each year's IT PPP</h3>
                    <ul class="itp-years">
                        @foreach (var year in Model.YearTypes.Reverse())
                        {
                            var fyLabel = ItProjectBoardPresentation.FinancialYear(year.FinancialYearStart);
                            var how = year.IsManual ? $"set by hand (automatic: {ItProjectYearTypes.Code(year.AutomaticType)})" : "automatic";
                            <li class="itp-years__row">
                                <span class="itp-years__fy">@fyLabel</span>
                                <span class="itp-years__type itp-years__type--@year.Code.ToLowerInvariant()" title="@year.Label, @how">@year.Code</span>
                                <span class="itp-years__ref @(year.PppReferenceNumber is null ? "itp-years__ref--none" : null)">@(year.PppReferenceNumber ?? "number not entered")</span>
                                @* The first year is New and its number is changed with Edit, so it has no form, unless a type
                                   was once set there by hand: then the form stays so it can be put back to automatic. *@
                                @if (Model.CanManage && (!year.IsOwnYear || year.IsManual))
                                {
                                    <form method="post" asp-page-handler="Year" asp-route-id="@Model.Project.Id" class="itp-years__form">
                                        <input type="hidden" asp-for="RowVersion" />
                                        <input type="hidden" name="fy" value="@year.FinancialYearStart" />
                                        @if (!year.IsOwnYear)
                                        {
                                            <label class="visually-hidden" for="itpYearRef@(year.FinancialYearStart)">IT PPP reference number in FY @fyLabel</label>
                                            <input id="itpYearRef@(year.FinancialYearStart)" name="yearReference" value="@year.PppReferenceNumber" maxlength="@ItProjectFinancialYear.ReferenceMaxLength"
                                                   class="form-control form-control-sm" placeholder="IT PPP no. in @fyLabel" autocomplete="off" />
                                        }
                                        <label class="visually-hidden" for="itpYearType@(year.FinancialYearStart)">Type in FY @fyLabel</label>
                                        <select id="itpYearType@(year.FinancialYearStart)" name="yearType" class="form-select form-select-sm">
                                            <option value="auto" selected="@(!year.IsManual)">Automatic (@ItProjectYearTypes.Code(year.AutomaticType))</option>
                                            <option value="New" selected="@(year.IsManual && year.Type == ItProjectYearType.New)">New</option>
                                            <option value="CL" selected="@(year.IsManual && year.Type == ItProjectYearType.CommittedLiability)">CL</option>
                                            <option value="CF" selected="@(year.IsManual && year.Type == ItProjectYearType.CarriedForward)">CF</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                }
                @if (Model.CanManage)
                {
                    <div class="itp-record__actions">
                        @if (Model.IsDropped)
                        {
                            <form method="post" asp-page-handler="Reinstate" asp-route-id="@Model.Project.Id"
                                  data-confirm="Reinstate this IT project? It returns to the active board at the stage it had reached." data-confirm-tone="primary" data-confirm-action="Reinstate">
                                <input type="hidden" asp-for="RowVersion" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Reinstate</button>
                            </form>
                        }
                        else if (!Model.IsCompleted)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="offcanvas" data-bs-target="#itpDropDrawer" aria-controls="itpDropDrawer">Mark dropped</button>
                        }
                        <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Project.Id"
                              data-confirm="Delete this IT project? It leaves the board; an administrator can restore it later." data-confirm-tone="danger" data-confirm-action="Delete project">
                            <input type="hidden" asp-for="RowVersion" />
                            <button type="submit" class="btn btn-sm btn-link itp-record__delete">Delete</button>
                        </form>
                    </div>
                }
            </section>

            <section class="itp-card itp-files" id="attachments" aria-labelledby="itpFilesTitle">
                <h2 class="itp-card__title" id="itpFilesTitle">Attachments <span class="itp-card__count">@Model.Attachments.Count</span></h2>
                @if (Model.Attachments.Count == 0)
                {
                    <p class="itp-files__empty">
                        @if (Model.CanManage)
                        {
                            <text>No files yet. Attach the PPP, the AoN or the SO as PDF or Office documents.</text>
                        }
                        else
                        {
                            <text>No files attached.</text>
                        }
                    </p>
                }
                else
                {
                    <ul class="itp-files__list">
                        @foreach (var file in Model.Attachments)
                        {
                            <li class="itp-file">
                                <i class="bi @ItProjectBoardPresentation.FileIcon(file.ContentType) itp-file__icon" aria-hidden="true"></i>
                                <div class="itp-file__main">
                                    <a class="itp-file__name" asp-page-handler="Attachment" asp-route-id="@Model.Project.Id" asp-route-attachmentId="@file.Id" title="Download @file.FileName">@file.FileName</a>
                                    <div class="itp-file__meta">@ItProjectBoardPresentation.FileSize(file.SizeBytes) &middot; @file.UploadedByName &middot; <time datetime="@file.UploadedAtUtc.ToString("yyyy-MM-dd")">@ItProjectBoardPresentation.ShortDate(DateOnly.FromDateTime(file.UploadedAtUtc))</time></div>
                                </div>
                                @if (Model.CanManage)
                                {
                                    <form method="post" asp-page-handler="AttachmentDelete" asp-route-id="@Model.Project.Id" asp-route-attachmentId="@file.Id" class="itp-file__delete"
                                          data-confirm="Remove this file from the project? An administrator can restore it later." data-confirm-tone="danger" data-confirm-action="Remove file">
                                        <button type="submit" class="itp-file__remove" aria-label="Remove @file.FileName"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                }
                @if (Model.CanManage)
                {
                    <form method="post" asp-page-handler="AttachmentUpload" asp-route-id="@Model.Project.Id" enctype="multipart/form-data" class="itp-files__upload">
                        <label class="btn btn-outline-secondary btn-sm itp-files__add">
                            <i class="bi bi-paperclip" aria-hidden="true"></i><span>Add file</span>
                            <input type="file" name="AttachmentFile" class="visually-hidden" accept="@ItProjectAttachmentValidator.AcceptList" data-auto-submit />
                        </label>
                        <noscript><button type="submit" class="btn btn-primary btn-sm">Upload</button></noscript>
                        <span class="itp-files__hint">PDF, Word, Excel or PowerPoint, up to @Model.AttachmentMaxMb MB.</span>
                    </form>
                }
            </section>
        </aside>
    </div>

    @if (Model.CanManage)
    {
        <div class="offcanvas offcanvas-end itp-drawer" tabindex="-1" id="itpStagesDrawer" aria-labelledby="itpStagesDrawerLabel">
            <div class="offcanvas-header">
                <div>
                    <h5 id="itpStagesDrawerLabel" class="mb-0">Update stages</h5>
                    <p class="itp-drawer__hint mb-0">Tick what is done. Dates are optional. Ticking a later stage completes the earlier ones.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <form method="post" asp-page-handler="Stages" asp-route-id="@Model.Project.Id" data-page-handled data-itp-stage-editor data-itp-preview-url="@Url.Page(null, "Preview", new { id = Model.Project.Id })" novalidate>
                    <input type="hidden" asp-for="Stages.RowVersion" />
                    <input type="hidden" name="reopen" value="@Model.ReopenPending" data-itp-reopen />
                    @if (stageErrors.Count > 0)
                    {
                        <div class="alert alert-danger itp-drawer__errors" role="alert">
                            <ul class="mb-0 ps-3">
                                @foreach (var error in stageErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }
                    <div class="itp-stage-rows">
                        @for (var i = 0; i < Model.Stages.Items.Count; i++)
                        {
                            var item = Model.Stages.Items[i];
                            var row = Model.StageRows.First(r => r.Code == item.StageCode);
                            <div class="itp-stage-row @(row.IsOptional && !item.IsIncluded ? "itp-stage-row--skipped" : null) @(row.CarriesCost ? "itp-stage-row--cost" : null)" data-itp-stage data-itp-code="@row.Code" data-itp-label="@row.Label" data-itp-optional="@(row.IsOptional ? "true" : "false")">
                                <input type="hidden" asp-for="Stages.Items[i].StageCode" />
                                <label class="itp-stage-row__tick">
                                    <input type="checkbox" asp-for="Stages.Items[i].IsCompleted" class="form-check-input" data-itp-completed disabled="@(row.IsOptional && !item.IsIncluded)" />
                                    <span class="visually-hidden">@row.Label complete</span>
                                </label>
                                <div class="itp-stage-row__label">
                                    <span class="itp-stage-row__name">@row.Label</span>
                                    @if (row.IsOptional)
                                    {
                                        <label class="itp-stage-row__include">
                                            <input type="checkbox" asp-for="Stages.Items[i].IsIncluded" class="form-check-input" data-itp-included />
                                            <span>include this stage</span>
                                        </label>
                                    }
                                    @if (row.CarriesCost)
                                    {
                                        <span class="itp-stage-row__sub">SO date and cost in lakhs, both optional</span>
                                    }
                                </div>
                                <div class="itp-stage-row__inputs">
                                    <input type="date" asp-for="Stages.Items[i].CompletedOn" asp-format="{0:yyyy-MM-dd}" class="form-control form-control-sm" data-itp-date aria-label="@row.Label completion date" disabled="@(row.IsOptional && !item.IsIncluded)" />
                                    @if (row.CarriesCost)
                                    {
                                        <input type="number" asp-for="Stages.Items[i].CostLakhs" class="form-control form-control-sm" step="0.01" min="0" placeholder="cost (L)" data-itp-cost aria-label="SO cost in lakhs" />
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <p class="itp-stage-note" data-itp-stage-note hidden></p>
                    <div class="itp-drawer__actions">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Cancel</button>
                        <button type="submit" class="btn btn-primary itp-btn-primary">Save stages</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="offcanvas offcanvas-end itp-drawer" tabindex="-1" id="itpEditDrawer" aria-labelledby="itpEditDrawerLabel">
            <div class="offcanvas-header">
                <h5 id="itpEditDrawerLabel" class="mb-0">Edit details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <form method="post" asp-page-handler="Details" asp-route-id="@Model.Project.Id" novalidate>
                    <input type="hidden" asp-for="Details.RowVersion" />
                    @if (editErrors.Count > 0)
                    {
                        <div class="alert alert-danger itp-drawer__errors" role="alert">
                            <ul class="mb-0 ps-3">
                                @foreach (var error in editErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }
                    <div class="itp-form__field">
                        <label asp-for="Details.Title" class="form-label"></label>
                        <input asp-for="Details.Title" class="form-control" maxlength="200" />
                        <span asp-validation-for="Details.Title" class="text-danger"></span>
                    </div>
                    <div class="itp-form__field">
                        <label asp-for="Details.PppReferenceNumber" class="form-label"></label>
                        <input asp-for="Details.PppReferenceNumber" class="form-control" maxlength="100" />
                        <span asp-validation-for="Details.PppReferenceNumber" class="text-danger"></span>
                    </div>
                    <div class="itp-form__field">
                        <label asp-for="Details.FinancialYearStart" class="form-label"></label>
                        <select asp-for="Details.FinancialYearStart" asp-items="Model.FinancialYearOptions" class="form-select"></select>
                        <span asp-validation-for="Details.FinancialYearStart" class="text-danger"></span>
                    </div>
                    <div class="itp-form__field">
                        <label asp-for="Details.Description" class="form-label"></label>
                        <textarea asp-for="Details.Description" class="form-control" rows="7"></textarea>
                        <span asp-validation-for="Details.Description" class="text-danger"></span>
                    </div>
                    <div class="itp-drawer__actions">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Cancel</button>
                        <button type="submit" class="btn btn-primary itp-btn-primary">Save details</button>
                    </div>
                </form>
            </div>
        </div>

        @if (!Model.IsDropped)
        {
            <div class="offcanvas offcanvas-end itp-drawer" tabindex="-1" id="itpDropDrawer" aria-labelledby="itpDropDrawerLabel">
                <div class="offcanvas-header">
                    <div>
                        <h5 id="itpDropDrawerLabel" class="mb-0">Mark dropped</h5>
                        <p class="itp-drawer__hint mb-0">The project stays on the board, muted, with the reason. It can be reinstated.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body">
                    <form method="post" asp-page-handler="Drop" asp-route-id="@Model.Project.Id" novalidate>
                        <input type="hidden" asp-for="Drop.RowVersion" />
                        @if (dropErrors.Count > 0)
                        {
                            <div class="alert alert-danger itp-drawer__errors" role="alert">
                                <ul class="mb-0 ps-3">
                                    @foreach (var error in dropErrors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </div>
                        }
                        <div class="itp-form__field">
                            <label asp-for="Drop.DroppedOn" class="form-label"></label>
                            <input type="date" asp-for="Drop.DroppedOn" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                            <span asp-validation-for="Drop.DroppedOn" class="text-danger"></span>
                        </div>
                        <div class="itp-form__field">
                            <label asp-for="Drop.Reason" class="form-label"></label>
                            <textarea asp-for="Drop.Reason" class="form-control" rows="4" maxlength="500" placeholder="e.g. Merged into the HQ rate contract"></textarea>
                            <span asp-validation-for="Drop.Reason" class="text-danger"></span>
                        </div>
                        <div class="itp-drawer__actions">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Cancel</button>
                            <button type="submit" class="btn btn-danger">Mark dropped</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script src="~/js/pages/it-projects-details.js" asp-append-version="true" defer></script>
}
