@page
@using ProjectManagement.Models.ItProjects
@using ProjectManagement.Pages.ItProjects
@using ProjectManagement.Services.ItProjects
@using ProjectManagement.Utilities
@model ProjectManagement.Pages.ItProjects.IndexModel
@{
    ViewData["Title"] = "IT projects";
    ViewData["PageShell"] = "wide";
    var scopeKey = Model.ScopeKey;
    var fyLabel = Model.Fy.HasValue ? FinancialYearHelper.Format(Model.Fy.Value) : "All years";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/it-projects.css" asp-append-version="true" />
}

<div class="itp-page" data-itp-board data-itp-server-search="@(string.IsNullOrWhiteSpace(Model.Q) ? "false" : "true")">
    <header class="itp-board-head">
        <div class="itp-board-head__identity">
            <div class="itp-crumb" aria-label="Breadcrumb">ERP / IT projects</div>
            <h1 class="itp-board-head__title">IT projects</h1>
            <p class="itp-board-head__lead">Every IT PPP case, where it stands and how long it has been there.</p>
        </div>
        <div class="itp-board-head__actions">
            <nav class="itp-fy" aria-label="Financial year">
                <a class="itp-fy__item @(Model.Fy is null ? "itp-fy__item--on" : null)" aria-current="@(Model.Fy is null ? "page" : null)"
                   asp-page="./Index" asp-route-scope="@scopeKey" asp-route-q="@Model.Q" asp-route-group="@Model.Group">All years</a>
                @foreach (var year in Model.RecentYears)
                {
                    <a class="itp-fy__item @(Model.Fy == year ? "itp-fy__item--on" : null)" aria-current="@(Model.Fy == year ? "page" : null)"
                       asp-page="./Index" asp-route-scope="@scopeKey" asp-route-fy="@year" asp-route-q="@Model.Q" asp-route-group="@Model.Group">@FinancialYearHelper.Format(year)</a>
                }
                @if (Model.EarlierYears.Count > 0)
                {
                    <form method="get" class="itp-fy__earlier">
                        <input type="hidden" name="scope" value="@scopeKey" />
                        <input type="hidden" name="q" value="@Model.Q" />
                        <input type="hidden" name="group" value="@Model.Group" />
                        <label class="visually-hidden" for="itpEarlierYear">Earlier financial year</label>
                        <select id="itpEarlierYear" name="fy" class="form-select form-select-sm @(Model.EarlierYears.Contains(Model.Fy ?? 0) ? "itp-fy__select--on" : null)" data-auto-submit>
                            <option value="" selected="@(!Model.EarlierYears.Contains(Model.Fy ?? 0))">Earlier</option>
                            @foreach (var year in Model.EarlierYears)
                            {
                                <option value="@year" selected="@(Model.Fy == year)">@FinancialYearHelper.Format(year)</option>
                            }
                        </select>
                        <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">Go</button></noscript>
                    </form>
                }
            </nav>
            @if (Model.CanManage)
            {
                <a class="btn btn-primary itp-btn-primary" asp-page="./Create"><i class="bi bi-plus-lg" aria-hidden="true"></i><span>New IT project</span></a>
            }
        </div>
    </header>

    @{
        var figures = Model.Board.Figures;
        var figuresYear = FinancialYearHelper.Format(figures.FinancialYearStart);
    }
    <section class="itp-figs" aria-label="Summary for @(Model.Fy.HasValue ? $"FY {fyLabel}" : "all years")">
        <a class="itp-fig itp-fig--progress @(scopeKey == "active" ? "itp-fig--selected" : null)" asp-page="./Index" asp-route-scope="active" asp-route-fy="@Model.Fy" asp-route-q="@Model.Q" asp-route-group="@Model.Group">
            <span class="itp-fig__k">In progress</span>
            <span class="itp-fig__v">@Model.Board.ActiveCount <small>@(Model.Board.ActiveCount == 1 ? "case" : "cases")</small></span>
            <span class="itp-fig__types" aria-label="By type in FY @figuresYear">
                <span class="itp-type itp-type--new" title="New in FY @figuresYear">@figures.ActiveNew New</span>
                <span class="itp-type itp-type--cl" title="Committed liability: SO placed, carried into FY @figuresYear">@figures.ActiveCommittedLiability CL</span>
                <span class="itp-type itp-type--cf" title="Carried forward without an SO into FY @figuresYear">@figures.ActiveCarriedForward CF</span>
            </span>
            <span class="itp-fig__s">@ItProjectBoardPresentation.InProgressNote(figures)</span>
        </a>

        @if (figures.LongestWait is { } longest)
        {
            <a class="itp-fig itp-fig--wait" asp-page="./Details" asp-route-id="@longest.Id">
                <span class="itp-fig__k">Waiting longest</span>
                <span class="itp-fig__v">@longest.Days <small>@(longest.Days == 1 ? "day" : "days")</small></span>
                <span class="itp-fig__s"><b>@longest.Title</b> at @ItProjectStages.LabelOf(longest.StageCode)@ItProjectBoardPresentation.LeftOutNote(figures.ActiveWithoutStageDate)</span>
            </a>
        }
        else
        {
            <div class="itp-fig itp-fig--wait itp-fig--static">
                <span class="itp-fig__k">Waiting longest</span>
                <span class="itp-fig__v">—</span>
                <span class="itp-fig__s">@(figures.ActiveWithoutStageDate > 0 ? "No case in progress has a stage date yet." : "No case in progress.")</span>
            </div>
        }

        <div class="itp-fig itp-fig--order itp-fig--static">
            <span class="itp-fig__k">On order, not yet delivered</span>
            <span class="itp-fig__v">@ItProjectBoardPresentation.Lakhs(figures.OnOrderLakhs) <small>lakh</small></span>
            <span class="itp-fig__s">@(figures.OnOrderCount == 0 ? "No supply order awaiting delivery" : figures.OnOrderCount == 1 ? "1 supply order awaiting delivery and ATP" : $"{figures.OnOrderCount} supply orders awaiting delivery and ATP")</span>
        </div>

        <a class="itp-fig itp-fig--done @(scopeKey == "completed" ? "itp-fig--selected" : null)" asp-page="./Index" asp-route-scope="completed" asp-route-fy="@Model.Fy" asp-route-q="@Model.Q" asp-route-group="@Model.Group">
            <span class="itp-fig__k">Delivered</span>
            <span class="itp-fig__v">@Model.Board.CompletedCount <small>@(Model.Board.CompletedCount == 1 ? "case" : "cases")</small></span>
            <span class="itp-fig__s">@ItProjectBoardPresentation.DeliveredNote(figures)</span>
        </a>
    </section>

    <form method="get" class="itp-toolbar" role="search" aria-label="Filter the board">
        <input type="hidden" name="scope" value="@scopeKey" />
        <input type="hidden" name="group" value="@Model.Group" />
        <input type="hidden" name="fy" value="@Model.Fy" />
        <label class="itp-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <span class="visually-hidden">Search title or IT PPP reference</span>
            <input type="search" name="q" value="@Model.Q" placeholder="Search title or IT PPP reference" autocomplete="off" data-itp-search />
        </label>
        <nav class="itp-pills" aria-label="Status">
            <a class="itp-pill @(scopeKey == "active" ? "itp-pill--on" : null)" asp-page="./Index" asp-route-scope="active" asp-route-fy="@Model.Fy" asp-route-q="@Model.Q" asp-route-group="@Model.Group">Active <b>@Model.Board.ActiveCount</b></a>
            <a class="itp-pill @(scopeKey == "completed" ? "itp-pill--on" : null)" asp-page="./Index" asp-route-scope="completed" asp-route-fy="@Model.Fy" asp-route-q="@Model.Q" asp-route-group="@Model.Group">Delivered <b>@Model.Board.CompletedCount</b></a>
            <a class="itp-pill @(scopeKey == "dropped" ? "itp-pill--on" : null)" asp-page="./Index" asp-route-scope="dropped" asp-route-fy="@Model.Fy" asp-route-q="@Model.Q" asp-route-group="@Model.Group">Dropped <b>@Model.Board.DroppedCount</b></a>
            <a class="itp-pill @(scopeKey == "all" ? "itp-pill--on" : null)" asp-page="./Index" asp-route-scope="all" asp-route-fy="@Model.Fy" asp-route-q="@Model.Q" asp-route-group="@Model.Group">All <b>@Model.AllCount</b></a>
        </nav>
        <a class="itp-toggle @(Model.GroupByFinancialYear ? "itp-toggle--on" : null)" asp-page="./Index" asp-route-scope="@scopeKey" asp-route-fy="@Model.Fy" asp-route-q="@Model.Q" asp-route-group="@(Model.GroupByFinancialYear ? null : "fy")" role="switch" aria-checked="@(Model.GroupByFinancialYear ? "true" : "false")">
            <i aria-hidden="true"></i><span>Group by FY</span>
        </a>
        <noscript><button type="submit" class="btn btn-outline-secondary btn-sm">Apply</button></noscript>
    </form>

    @if (Model.ScopedRows.Count == 0)
    {
        <div class="itp-empty">
            @if (!string.IsNullOrWhiteSpace(Model.Q) || Model.Fy.HasValue)
            {
                <p class="itp-empty__title">No IT project matches.</p>
                <p class="itp-empty__text">Try another word, or <a asp-page="./Index" asp-route-scope="@scopeKey">clear the filters</a>.</p>
            }
            else if (Model.AllCount == 0)
            {
                <p class="itp-empty__title">No IT project yet.</p>
                <p class="itp-empty__text">
                    @if (Model.CanManage)
                    {
                        <text>Add the first one with <strong>New IT project</strong>. It starts at IT PPP / IPA.</text>
                    }
                    else
                    {
                        <text>The ITO, HoD or an administrator adds them.</text>
                    }
                </p>
            }
            else
            {
                <p class="itp-empty__title">Nothing @(scopeKey == "all" ? "here" : scopeKey).</p>
                <p class="itp-empty__text"><a asp-page="./Index" asp-route-scope="all" asp-route-fy="@Model.Fy" asp-route-q="@Model.Q" asp-route-group="@Model.Group">Show all @Model.AllCount</a>.</p>
            }
        </div>
    }
    else
    {
        <div class="itp-board" role="region" aria-label="Stage board">
            <table class="itp-table">
                <thead>
                    <tr>
                        <th scope="col" class="itp-th-project">Project</th>
                        @foreach (var stage in ItProjectStages.All)
                        {
                            var atStage = Model.Board.StageCounts.FirstOrDefault(count => count.StageCode == stage.Code)?.AtStage ?? 0;
                            <th scope="col" class="itp-th-stage @(stage.IsOptional ? "itp-th-stage--opt" : null)">
                                <span class="itp-th-stage__label">@stage.Label</span>
                                @if (stage.IsOptional)
                                {
                                    <small>optional</small>
                                }
                                else
                                {
                                    <small><b>@atStage</b> here</small>
                                }
                            </th>
                        }
                    </tr>
                </thead>
                @foreach (var band in Model.Bands)
                {
                    <tbody class="itp-band" data-itp-band="@band.Key">
                        @if (Model.Bands.Count > 1 || Model.GroupByFinancialYear)
                        {
                            <tr class="itp-band__head">
                                <td colspan="10">@band.Title <span data-itp-band-count>@ItProjectBoardPresentation.Projects(band.Count)</span></td>
                            </tr>
                        }
                        @foreach (var row in band.Rows)
                        {
                            var isDropped = row.Status.Kind == ItProjectStatusKind.Dropped;
                            <tr class="itp-row @(isDropped ? "itp-row--dropped" : null)" data-itp-row data-itp-search-text="@row.SearchText">
                                <td class="itp-project">
                                    <div class="itp-project__title"><a asp-page="./Details" asp-route-id="@row.Id" class="itp-project__link">@row.Title</a></div>
                                    <div class="itp-project__meta">
                                        @if (row.YearType is { } yearType)
                                        {
                                            <span class="itp-type itp-type--@yearType.Code.ToLowerInvariant()" title="@yearType.Label in FY @FinancialYearHelper.Format(yearType.FinancialYearStart)@(yearType.IsManual ? ", set by hand" : null)">@yearType.Code</span>
                                        }
                                        <b>@row.DisplayReference</b>
                                        <span>·</span>
                                        <span>@ItProjectBoardPresentation.FinancialYear(row.FinancialYearStart)</span>
                                        @if (row.Status.Kind == ItProjectStatusKind.Completed)
                                        {
                                            var delivered = row.Stages.FirstOrDefault(cell => cell.StageCode == ItProjectStages.Delivery)?.CompletedOn;
                                            <span>·</span>
                                            <span class="itp-chip itp-chip--ok">@(delivered.HasValue ? $"Delivered {ItProjectBoardPresentation.ShortDate(delivered.Value)}" : "Delivered")</span>
                                        }
                                        else if (isDropped)
                                        {
                                            <span>·</span>
                                            <span class="itp-chip itp-chip--drop" title="@row.DroppedReason">Dropped@(row.Status.CurrentStageLabel is { } at ? $" at {at}" : "")@(row.DroppedOn.HasValue ? $" · {ItProjectBoardPresentation.ShortDate(row.DroppedOn.Value)}" : "")</span>
                                        }
                                    </div>
                                </td>
                                @foreach (var cell in row.Stages)
                                {
                                    var text = ItProjectBoardPresentation.CellText(cell);
                                    var cost = ItProjectBoardPresentation.CellCost(cell);
                                    <td class="itp-stage">
                                        <span class="itp-cell @ItProjectBoardPresentation.CellClass(cell)" title="@ItProjectBoardPresentation.CellTitle(cell)">
                                            <i class="itp-dot" aria-hidden="true"></i>
                                            <span class="visually-hidden">@ItProjectBoardPresentation.CellTitle(cell)</span>
                                            @if (text is not null)
                                            {
                                                <small class="@(cell.IsCompleted && !cell.CompletedOn.HasValue ? "itp-cell__text--nd" : null)" aria-hidden="true">@text</small>
                                            }
                                            @if (cost is not null)
                                            {
                                                <small class="itp-cell__text--cost" aria-hidden="true">@cost</small>
                                            }
                                        </span>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                }
            </table>
            <p class="itp-no-match" data-itp-no-match hidden>No IT project on this board matches what you typed.</p>
        </div>
        <div class="itp-legend" aria-label="Legend">
            <span class="itp-cell itp-cell--done"><i class="itp-dot" aria-hidden="true"></i> done, date on hover</span>
            <span class="itp-cell itp-cell--cur"><i class="itp-dot" aria-hidden="true"></i> current stage</span>
            <span class="itp-cell itp-cell--pend"><i class="itp-dot" aria-hidden="true"></i> not yet</span>
            <span class="itp-cell itp-cell--skip"><i class="itp-dot" aria-hidden="true"></i> skipped</span>
            <span class="itp-legend__note">Rows sort by current stage, then title.</span>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/pages/it-projects.js" asp-append-version="true" defer></script>
}
