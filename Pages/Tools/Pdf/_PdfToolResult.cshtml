<div class="pdft-result" data-result hidden>
    <div class="pdft-result__icon" aria-hidden="true"><i class="bi bi-check-circle-fill"></i></div>
    <h2 class="h4">Your file is ready</h2>
    <p class="pdft-result__name" data-result-name></p>
    <canvas class="pdft-result__preview" data-result-preview hidden aria-label="Preview of the first page"></canvas>
    <div class="pdft-result__actions">
        <button type="button" class="btn btn-primary btn-lg" data-action="download"><i class="bi bi-download" aria-hidden="true"></i> Download</button>
        <button type="button" class="btn btn-outline-secondary" data-action="back-to-edit"><i class="bi bi-pencil" aria-hidden="true"></i> Keep editing</button>
        <button type="button" class="btn btn-outline-secondary" data-action="start-over"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Start over</button>
    </div>
    <p class="pdft-result__note">Nothing was uploaded. The file was created on this computer.</p>
</div>
