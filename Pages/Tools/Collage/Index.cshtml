@page
@model ProjectManagement.Pages.Tools.Collage.IndexModel
@{
    // Collage Studio (docs/ux/collage-studio.md). A standalone tool, like Photo Tools: its own tab,
    // its own minimal shell, and everything in the browser. No photo or collage is sent to the
    // PRISM server. The top bar is shared with PDF Tools and Photo Tools through pdf-tools.css; the
    // page is drawn with Konva, shipped with the application.
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#10213f" />
    <title>Collage Studio | PRISM ERP</title>
    <script src="~/js/core/theme-preference.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/fonts/mulish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pdf-tools.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/prism-confirm-dialog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tools-shared/prism-confirm-standalone.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/collage.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
</head>
<body class="pdft clg" data-collage>

    <header class="pdft-topbar">
        <a class="pdft-brand" href="#" data-action="home">
            <span class="pdft-brand__mark clg-brand__mark" aria-hidden="true"><i class="bi bi-images"></i></span>
            <span class="pdft-brand__text">Collage Studio <span>by PRISM</span></span>
        </a>
        <span class="pdft-privacy" title="Your collage is made in this browser. No photo is sent to the PRISM server.">
            <i class="bi bi-shield-lock" aria-hidden="true"></i>
            <span>Photos are not saved in PRISM</span>
            <span class="visually-hidden">. Your collage is made in this browser. No photo is sent to the PRISM server.</span>
        </span>
        <a class="pdft-topbar__back" asp-page="/Dashboard/Index">
            <i class="bi bi-box-arrow-up-left" aria-hidden="true"></i>
            <span>PRISM</span>
        </a>
    </header>

    <input type="file" class="visually-hidden" accept="image/jpeg,image/png,image/webp,image/gif,image/bmp,.jpg,.jpeg,.png,.webp,.gif,.bmp" multiple data-file-input tabindex="-1" aria-hidden="true" />

    <main class="clg-main">
        @* ---------- Start ---------- *@
        <section class="clg-start" data-view="start" aria-labelledby="clgStartTitle">
            <h1 id="clgStartTitle" tabindex="-1">Make a collage</h1>
            <p class="clg-lede">Put your photos on a page, turn them to any angle and arrange them as you like. Everything happens in this browser; no photo is sent to PRISM.</p>
            <p class="clg-building" role="note"><i class="bi bi-stars" aria-hidden="true"></i> More is on the way: text in English and Hindi, stickers, frames, backgrounds and drafts.</p>
            <h2 class="clg-start__heading">Start with a layout <small>A4 landscape; the size can be changed later</small></h2>
            <div class="clg-layouts" data-start-layouts></div>
            <h2 class="clg-start__heading">Start with a blank page</h2>
            <div class="clg-sizes" data-sizes></div>
        </section>

        @* ---------- Editor ---------- *@
        <section class="clg-editor" data-view="editor" aria-labelledby="clgEditorTitle" hidden>
            <h1 id="clgEditorTitle" class="visually-hidden" tabindex="-1">Collage editor</h1>
            <div class="clg-bar">
                <button type="button" class="btn btn-outline-secondary btn-sm clg-icon-btn" data-action="home" title="Back to the start" aria-label="Back to the start">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                </button>
                <label class="visually-hidden" for="clgName">Collage name</label>
                <input id="clgName" class="clg-name" type="text" maxlength="80" autocomplete="off" data-name />
                <span class="clg-bar__grow"></span>
                <label class="visually-hidden" for="clgSize">Page size</label>
                <select id="clgSize" class="form-select form-select-sm clg-size" data-size></select>
                <div class="btn-group btn-group-sm" role="group" aria-label="Undo and redo">
                    <button type="button" class="btn btn-outline-secondary" data-action="undo" title="Undo (Ctrl+Z)" aria-label="Undo"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-secondary" data-action="redo" title="Redo (Ctrl+Y)" aria-label="Redo"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button>
                </div>
                <div class="btn-group btn-group-sm clg-zoom" role="group" aria-label="Zoom">
                    <button type="button" class="btn btn-outline-secondary" data-action="zoom-out" title="Zoom out" aria-label="Zoom out"><i class="bi bi-dash-lg" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-secondary clg-zoom__value" data-action="zoom-fit" title="Fit the page" aria-label="Fit the page" data-zoom-value>100%</button>
                    <button type="button" class="btn btn-outline-secondary" data-action="zoom-in" title="Zoom in" aria-label="Zoom in"><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
                </div>
                <button type="button" class="btn btn-primary btn-sm clg-save-btn" data-action="save-open">
                    <i class="bi bi-download" aria-hidden="true"></i> <span>Save as…</span>
                </button>
            </div>

            <div class="clg-body" data-body>
                <nav class="clg-rail" aria-label="Add to the collage">
                    <button type="button" data-panel="layouts" aria-pressed="false" aria-controls="clgDrawer">
                        <i class="bi bi-grid-1x2" aria-hidden="true"></i><span>Layouts</span>
                    </button>
                    <button type="button" data-panel="photos" aria-pressed="true" aria-controls="clgDrawer">
                        <i class="bi bi-images" aria-hidden="true"></i><span>Photos</span>
                    </button>
                </nav>

                <aside class="clg-drawer" id="clgDrawer" data-drawer aria-label="Add to the collage">
                    <section data-drawer-panel="photos" aria-labelledby="clgPhotosTitle">
                        <h2 class="clg-panel-title" id="clgPhotosTitle">Photos</h2>
                        <div class="clg-banner" data-replace-banner hidden>
                            <span data-replace-text>Choose the photo for the selected frame.</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="replace-cancel">Cancel</button>
                        </div>
                        <button type="button" class="btn btn-primary w-100" data-action="choose">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add photos
                        </button>
                        <p class="clg-hint">Or drop photos on the page, or paste one with Ctrl+V. Empty frames fill first. Click a photo below to add it again, or drag it onto the page or into a frame.</p>
                        <p class="clg-hint clg-count" data-photo-count></p>
                        <div class="clg-tray" data-tray></div>
                    </section>
                    <section data-drawer-panel="layouts" aria-labelledby="clgLayoutsTitle" hidden>
                        <h2 class="clg-panel-title" id="clgLayoutsTitle">Layouts</h2>
                        <div class="clg-layout-grid" data-layout-grid></div>
                        <label class="clg-field"><span class="clg-field__label">Space between photos<output data-out="gap"></output></span>
                            <input type="range" min="0" max="60" step="1" data-layout-input="gap" aria-label="Space between photos, in page units"></label>
                        <label class="clg-field"><span class="clg-field__label">Rounded corners<output data-out="radius"></output></span>
                            <input type="range" min="0" max="60" step="1" data-layout-input="radius" aria-label="Rounded corners, in page units"></label>
                        <p class="clg-hint" data-layout-hint></p>
                        <div class="clg-section">
                            <p class="clg-section__title">Mix it up</p>
                            <div class="clg-stack">
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-action="casual"><i class="bi bi-shuffle" aria-hidden="true"></i> Make it casual: tilt the photos</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-action="straighten-all"><i class="bi bi-distribute-vertical" aria-hidden="true"></i> Straighten all</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-action="shuffle"><i class="bi bi-arrow-left-right" aria-hidden="true"></i> Shuffle photos</button>
                            </div>
                        </div>
                    </section>
                </aside>

                <div class="clg-stage" data-stage>
                    <div class="clg-stage__canvas" data-konva></div>
                    <div class="clg-toolbar" data-toolbar role="toolbar" aria-label="Selected item" hidden>
                        <button type="button" class="clg-toolbar__text" data-action="adjust-done" data-for="adjusting">Done</button>
                        <button type="button" data-action="fill-slot" data-for="slot" class="clg-toolbar__text"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add photo</button>
                        <button type="button" data-action="adjust" data-for="photo" title="Move the photo inside its frame (double-click)" aria-label="Move the photo inside its frame"><i class="bi bi-arrows-move" aria-hidden="true"></i></button>
                        <button type="button" data-action="replace" data-for="photo" title="Replace the photo" aria-label="Replace the photo"><i class="bi bi-arrow-left-right" aria-hidden="true"></i></button>
                        <span class="clg-toolbar__sep" data-for="photo" aria-hidden="true"></span>
                        <button type="button" data-action="duplicate" data-for="item" title="Duplicate (Ctrl+D)" aria-label="Duplicate"><i class="bi bi-copy" aria-hidden="true"></i></button>
                        <button type="button" data-action="forward" data-for="item" title="Bring forward (])" aria-label="Bring forward"><i class="bi bi-arrow-up" aria-hidden="true"></i></button>
                        <button type="button" data-action="backward" data-for="item" title="Send backward ([)" aria-label="Send backward"><i class="bi bi-arrow-down" aria-hidden="true"></i></button>
                        <button type="button" class="clg-toolbar__delete" data-action="delete" data-for="item" title="Delete (Delete)" aria-label="Delete"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                    </div>
                    <div class="clg-angle" data-angle hidden></div>
                    <div class="clg-stage-hint" data-adjust-hint hidden>Drag to move the photo in its frame · scroll or use the slider to zoom · Esc when done</div>
                    <div class="clg-empty" data-empty>
                        <i class="bi bi-images" aria-hidden="true"></i>
                        <p>Add photos, drop them here, or paste one with Ctrl+V.</p>
                        <button type="button" class="btn btn-primary btn-sm" data-action="choose">Add photos</button>
                    </div>
                </div>

                <aside class="clg-props" data-props aria-label="Settings"></aside>
            </div>
        </section>

        @* ---------- Save as… ---------- *@
        <dialog class="clg-dialog" data-save-dialog aria-labelledby="clgSaveTitle">
            <div class="clg-dialog__body" data-save-form>
                <div class="clg-dialog__head">
                    <h2 id="clgSaveTitle">Save the collage</h2>
                    <button type="button" class="btn-close" data-action="save-close" aria-label="Close"></button>
                </div>
                <fieldset class="clg-options">
                    <legend>Save as</legend>
                    <label class="clg-option"><input type="radio" name="format" value="png" checked>
                        <span><b>PNG picture</b><small>The sharpest. Best for WhatsApp, slides and screens.</small></span></label>
                    <label class="clg-option"><input type="radio" name="format" value="jpeg">
                        <span><b>JPG picture</b><small>A smaller file. It can be kept under a size a form asks for.</small></span></label>
                    <label class="clg-option"><input type="radio" name="format" value="pdf">
                        <span><b>PDF for printing</b><small data-pdf-note>The exact page size, ready to print.</small></span></label>
                </fieldset>
                <div class="clg-target" data-target-row hidden>
                    <label class="form-check">
                        <input class="form-check-input" type="checkbox" data-target-on>
                        <span class="form-check-label">Keep it under</span>
                    </label>
                    <input type="text" inputmode="decimal" class="form-control form-control-sm" value="500" data-target-value aria-label="Largest file size" disabled>
                    <select class="form-select form-select-sm" data-target-unit aria-label="Unit" disabled>
                        <option value="KB" selected>KB</option>
                        <option value="MB">MB</option>
                    </select>
                </div>
                <fieldset class="clg-options">
                    <legend>Quality</legend>
                    <label class="clg-option"><input type="radio" name="quality" value="print" checked>
                        <span><b>Print quality</b><small data-print-note></small></span></label>
                    <label class="clg-option"><input type="radio" name="quality" value="screen">
                        <span><b>Screen</b><small>1,920 pixels on the long side. Quicker to share.</small></span></label>
                </fieldset>
                <p class="clg-hint" data-save-empty hidden></p>
                <p class="clg-save-result" data-save-result role="status" hidden></p>
                <div class="clg-dialog__foot">
                    <button type="button" class="btn btn-outline-secondary" data-action="save-close">Close</button>
                    <button type="button" class="btn btn-primary" data-action="save-go" data-save-go><i class="bi bi-download" aria-hidden="true"></i> Save</button>
                </div>
            </div>
        </dialog>

        <div class="visually-hidden" role="status" aria-live="polite" data-announce></div>
        <div class="alert alert-warning clg-alert" role="alert" data-alert hidden>
            <span data-alert-text></span>
            <button type="button" class="btn-close" data-action="alert-close" aria-label="Close"></button>
        </div>
        <div class="clg-busy" data-busy hidden>
            <div class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></div>
            <span data-busy-text>Adding photos…</span>
        </div>
    </main>

    @* The PRISM confirmation dialog, as on every other page (docs/ux/confirm-dialogs.md). *@
    <partial name="_PrismConfirmDialog" />
    <script src="~/js/components/prism-confirm-dialog.js" asp-append-version="true"></script>
    @* Konva draws the page; it ships with the application (libman.json). *@
    <script src="~/lib/konva/10.9.1/konva.min.js"></script>
    @* Save as PDF uses the PDF library Photo Tools and PDF Tools ship; "keep it under" uses Photo
       Tools' own size search, so both tools reach a file size the same way. *@
    <script src="~/lib/pdf-lib/1.17.1/dist/pdf-lib.min.js"></script>
    <script src="~/js/photo-tools/photo-tools-core.js" asp-append-version="true"></script>
    <script src="~/js/collage/collage-core.js" asp-append-version="true"></script>
    <script src="~/js/collage/collage-app.js" asp-append-version="true"></script>
</body>
</html>
