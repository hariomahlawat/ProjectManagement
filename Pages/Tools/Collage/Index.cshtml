@page
@model ProjectManagement.Pages.Tools.Collage.IndexModel
@{
    // Collage Studio (docs/ux/collage-studio.md). A standalone tool, like Photo Tools: its own tab,
    // its own minimal shell, and everything in the browser. No photo or collage is sent to the
    // PRISM server. The top bar is shared with PDF Tools and Photo Tools through pdf-tools.css; the
    // page is drawn with Konva, shipped with the application.
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#10213f" />
    <title>Collage Studio | PRISM ERP</title>
    <script src="~/js/core/theme-preference.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/fonts/mulish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pdf-tools.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/prism-confirm-dialog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/prism-toast.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tools-shared/prism-confirm-standalone.css" asp-append-version="true" />
    @* Fonts for collage text, shipped with PRISM (wwwroot/fonts/collage, SIL Open Font License). *@
    <link rel="stylesheet" href="~/css/fonts/collage-fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/collage.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
</head>
<body class="pdft clg" data-collage data-sticker-base="@Url.Content("~/img/collage/stickers/twemoji/")" data-library="@(Model.LibraryOn ? "on" : "off")">

    <header class="pdft-topbar">
        <a class="pdft-brand" href="#" data-action="home">
            <span class="pdft-brand__mark clg-brand__mark" aria-hidden="true"><i class="bi bi-images"></i></span>
            <span class="pdft-brand__text">Collage Studio <span>by PRISM</span></span>
        </a>
        <span class="pdft-privacy" title="Your collage is made in this browser. No photo is sent to the PRISM server.">
            <i class="bi bi-shield-lock" aria-hidden="true"></i>
            <span>Photos are not saved in PRISM</span>
            <span class="visually-hidden">. Your collage is made in this browser. No photo is sent to the PRISM server.</span>
        </span>
        <a class="pdft-topbar__back" asp-page="/Dashboard/Index">
            <i class="bi bi-box-arrow-up-left" aria-hidden="true"></i>
            <span>PRISM</span>
        </a>
    </header>

    <input type="file" class="visually-hidden" accept="image/jpeg,image/png,image/webp,image/gif,image/bmp,.jpg,.jpeg,.png,.webp,.gif,.bmp" multiple data-file-input tabindex="-1" aria-hidden="true" />

    <main class="clg-main">
        @* ---------- Start ---------- *@
        <section class="clg-start" data-view="start" aria-labelledby="clgStartTitle">
            <h1 id="clgStartTitle" tabindex="-1">Make a collage</h1>
            <p class="clg-lede">Put your photos on a page, turn them to any angle and arrange them as you like. Everything happens in this browser; no photo is sent to PRISM.</p>
            <section class="clg-drafts" data-drafts-section aria-labelledby="clgDraftsTitle" hidden>
                <div class="clg-drafts__head">
                    <h2 class="clg-start__heading" id="clgDraftsTitle">Your drafts <small data-drafts-count></small></h2>
                    <button type="button" class="btn btn-sm btn-link clg-drafts-all" data-action="drafts-all" aria-expanded="false" hidden></button>
                </div>
                <p class="clg-hint clg-drafts__note" title="Clearing the browser's data removes drafts.">Kept in this browser on this computer, with their photos, and saved as you work. Save a picture or a PDF to keep a copy. <span data-drafts-space></span></p>
                <div class="clg-draft-grid" data-drafts></div>
            </section>
            <h2 class="clg-start__heading">Start with a layout <small>A4 landscape; the size can be changed later</small></h2>
            <div class="clg-layouts" data-start-layouts></div>
            <h2 class="clg-start__heading">Start with a blank page</h2>
            <div class="clg-sizes" data-sizes></div>
            <p class="clg-credits-link"><button type="button" class="btn btn-link btn-sm" data-action="credits">Credits for the fonts, stickers and libraries</button></p>
        </section>

        @* ---------- Editor ---------- *@
        <section class="clg-editor" data-view="editor" aria-labelledby="clgEditorTitle" hidden>
            <h1 id="clgEditorTitle" class="visually-hidden" tabindex="-1">Collage editor</h1>
            @* Passes the top bar, the panels and the page in one step (docs/ux/collage-review-3-fixes.md, PR 8). *@
            <a class="clg-skip" href="#clgProps">Skip to settings</a>
            <div class="clg-bar">
                <button type="button" class="btn btn-outline-secondary btn-sm clg-icon-btn" data-action="home" title="Back to the start" aria-label="Back to the start">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                </button>
                <label class="visually-hidden" for="clgName">Collage name</label>
                <input id="clgName" class="clg-name" type="text" maxlength="80" autocomplete="off" data-name placeholder="Untitled collage" />
                <span class="clg-draft-status" data-draft-status role="status" aria-live="polite"></span>
                <button type="button" class="btn btn-sm btn-outline-warning clg-keep-draft" data-action="keep-draft" hidden>Keep as a draft</button>
                <span class="clg-bar__grow"></span>
                <label class="visually-hidden" for="clgSize">Page size</label>
                <select id="clgSize" class="form-select form-select-sm clg-size" data-size></select>
                <div class="btn-group btn-group-sm" role="group" aria-label="Undo and redo">
                    <button type="button" class="btn btn-outline-secondary" data-action="undo" title="Undo (Ctrl+Z)" aria-label="Undo"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-secondary" data-action="redo" title="Redo (Ctrl+Y)" aria-label="Redo"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button>
                </div>
                <div class="btn-group btn-group-sm clg-zoom" role="group" aria-label="Zoom">
                    <button type="button" class="btn btn-outline-secondary" data-action="zoom-out" title="Zoom out" aria-label="Zoom out"><i class="bi bi-dash-lg" aria-hidden="true"></i></button>
                    <button type="button" class="btn btn-outline-secondary clg-zoom__value" data-action="zoom-fit" title="Fit the page" aria-label="Fit the page" data-zoom-value>100%</button>
                    <button type="button" class="btn btn-outline-secondary" data-action="zoom-in" title="Zoom in" aria-label="Zoom in"><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm clg-preview-btn" data-action="preview" title="See the page alone (Esc to come back)" aria-label="Preview">
                    <i class="bi bi-eye" aria-hidden="true"></i> <span>Preview</span>
                </button>
                <button type="button" class="btn btn-primary btn-sm clg-save-btn" data-action="save-open" aria-label="Save as…">
                    <i class="bi bi-download" aria-hidden="true"></i> <span>Save as…</span>
                </button>
            </div>

            <div class="clg-body" data-body>
                <nav class="clg-rail" aria-label="Add to the collage">
                    <button type="button" data-panel="layouts" aria-pressed="false" aria-controls="clgDrawer">
                        <i class="bi bi-grid-1x2" aria-hidden="true"></i><span>Layouts</span>
                    </button>
                    <button type="button" data-panel="photos" aria-pressed="true" aria-controls="clgDrawer">
                        <i class="bi bi-images" aria-hidden="true"></i><span>Photos</span>
                    </button>
                    <button type="button" data-panel="text" aria-pressed="false" aria-controls="clgDrawer">
                        <i class="bi bi-fonts" aria-hidden="true"></i><span>Text</span>
                    </button>
                    <button type="button" data-panel="stickers" aria-pressed="false" aria-controls="clgDrawer">
                        <i class="bi bi-emoji-smile" aria-hidden="true"></i><span>Stickers</span>
                    </button>
                    <button type="button" data-panel="background" aria-pressed="false" aria-controls="clgDrawer">
                        <i class="bi bi-palette" aria-hidden="true"></i><span>Background</span>
                    </button>
                    @* On phones the settings sheet, with Layers, opens from here even when nothing is selected. *@
                    <button type="button" class="clg-rail-layers" data-action="toggle-props" aria-pressed="false">
                        <i class="bi bi-layers" aria-hidden="true"></i><span>Layers</span>
                    </button>
                </nav>

                <aside class="clg-drawer" id="clgDrawer" data-drawer aria-label="Add to the collage">
                    <button type="button" class="clg-sheet-close" data-action="close-drawer" aria-label="Close panel"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                    <section data-drawer-panel="photos" aria-labelledby="clgPhotosTitle">
                        <h2 class="clg-panel-title" id="clgPhotosTitle">Photos</h2>
                        <div class="clg-banner" data-replace-banner hidden>
                            <span data-replace-text>Choose the photo for the selected frame.</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="replace-cancel">Cancel</button>
                        </div>
                        <button type="button" class="btn btn-primary w-100" data-action="choose">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add photos
                        </button>
                        @if (Model.LibraryOn)
                        {
                            <button type="button" class="btn btn-outline-primary w-100 clg-library-open" data-action="library-open">
                                <i class="bi bi-images" aria-hidden="true"></i> From PRISM Photos
                            </button>
                        }
                        <p class="clg-hint"><span class="clg-for-mouse">Or drop photos on the page, or paste one with Ctrl+V. Empty frames fill first. Click a photo below to add it again, or drag it onto the page or into a frame.</span><span class="clg-for-touch">Empty frames fill first. Tap a photo below to add it again; tap an empty frame first to put it there.</span></p>
                        <p class="clg-hint clg-count" data-photo-count></p>
                        <div class="clg-tray" data-tray></div>
                    </section>
                    <section data-drawer-panel="text" aria-labelledby="clgTextTitle" hidden>
                        <h2 class="clg-panel-title" id="clgTextTitle">Text</h2>
                        <div class="clg-stack" data-text-starts></div>
                        <p class="clg-section__title clg-text-heading">Ready-made headings</p>
                        <div class="clg-headings" data-text-headings></div>
                        <p class="clg-section__title clg-text-heading" lang="hi">हिंदी शीर्षक</p>
                        <div class="clg-headings" data-text-headings-hi></div>
                        <p class="clg-hint">Type Hindi with the Windows Hindi keyboard, or paste it. The fonts, Hindi ones too, are part of PRISM.</p>
                    </section>
                    <section data-drawer-panel="stickers" aria-labelledby="clgStickersTitle" hidden>
                        <h2 class="clg-panel-title" id="clgStickersTitle">Stickers</h2>
                        <label class="visually-hidden" for="clgStickerSearch">Search stickers</label>
                        <input id="clgStickerSearch" type="search" class="form-control form-control-sm" placeholder="Search: cake, thank you, diya…" autocomplete="off" data-sticker-search />
                        <div class="clg-chips" data-sticker-groups></div>
                        <div class="clg-stickers" data-sticker-grid></div>
                        <p class="clg-hint" data-sticker-none hidden>No sticker matches. Try another word.</p>
                        <p class="clg-hint">Click a sticker to add it. Shapes can take any colour. All stickers are part of PRISM; see Credits on the start screen.</p>
                    </section>
                    <section data-drawer-panel="background" aria-labelledby="clgBackgroundTitle" hidden>
                        <h2 class="clg-panel-title" id="clgBackgroundTitle">Background</h2>
                        <p class="clg-section__title">Colours</p>
                        <div class="clg-swatches">
                            <span class="clg-swatches" data-bg-colours></span>
                            <label class="visually-hidden" for="clgBgPick">Any colour</label>
                            <input id="clgBgPick" type="color" class="clg-swatch-pick" data-bg-pick title="Any colour" />
                        </div>
                        <p class="clg-section__title clg-text-heading">Gradients</p>
                        <div class="clg-bg-grid" data-bg-gradients></div>
                        <p class="clg-section__title clg-text-heading">Patterns</p>
                        <div class="clg-bg-grid" data-bg-patterns></div>
                        <p class="clg-section__title clg-text-heading">Textures</p>
                        <div class="clg-bg-grid" data-bg-textures></div>
                        <p class="clg-section__title clg-text-heading">One of your photos, softly blurred</p>
                        <div class="clg-bg-grid" data-bg-photos></div>
                        <p class="clg-hint" data-bg-photos-none>Add a photo to the page first.</p>
                    </section>
                    <section data-drawer-panel="layouts" aria-labelledby="clgLayoutsTitle" hidden>
                        <h2 class="clg-panel-title" id="clgLayoutsTitle">Layouts</h2>
                        <div class="clg-layout-grid" data-layout-grid></div>
                        <label class="clg-field"><span class="clg-field__label">Space between photos<output data-out="gap"></output></span>
                            <input type="range" min="0" max="60" step="1" data-layout-input="gap" aria-label="Space between photos, in page units"></label>
                        <label class="clg-field"><span class="clg-field__label">Rounded corners<output data-out="radius"></output></span>
                            <input type="range" min="0" max="60" step="1" data-layout-input="radius" aria-label="Rounded corners, in page units"></label>
                        <p class="clg-hint" data-layout-hint></p>
                        <div class="clg-section">
                            <p class="clg-section__title">Mix it up</p>
                            <div class="clg-stack">
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-action="casual"><i class="bi bi-shuffle" aria-hidden="true"></i> Make it casual: tilt the photos</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-action="straighten-all"><i class="bi bi-distribute-vertical" aria-hidden="true"></i> Straighten all</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-action="shuffle"><i class="bi bi-arrow-left-right" aria-hidden="true"></i> Shuffle photos</button>
                            </div>
                        </div>
                    </section>
                </aside>

                <div class="clg-stage" data-stage>
                    <div class="clg-stage__canvas" data-konva role="img" aria-label="The collage page. To work without a mouse, pick an item in the Layers list, then move it with the arrow keys."></div>
                    <div class="clg-toolbar" data-toolbar role="toolbar" aria-label="Selected item" hidden>
                        <button type="button" class="clg-toolbar__text" data-action="adjust-done" data-for="adjusting">Done</button>
                        <button type="button" data-action="fill-slot" data-for="slot" class="clg-toolbar__text"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add photo</button>
                        <button type="button" data-action="adjust" data-for="photo" title="Move the photo inside its frame (double-click)" aria-label="Move the photo inside its frame"><i class="bi bi-arrows-move" aria-hidden="true"></i></button>
                        <button type="button" data-action="replace" data-for="photo" title="Replace the photo" aria-label="Replace the photo"><i class="bi bi-arrow-left-right" aria-hidden="true"></i></button>
                        <span class="clg-toolbar__sep" data-for="photo" aria-hidden="true"></span>
                        <button type="button" class="clg-phone-only" data-action="edit-props" data-for="item" title="Settings" aria-label="Settings"><i class="bi bi-sliders" aria-hidden="true"></i></button>
                        <button type="button" data-action="duplicate" data-for="item" title="Duplicate (Ctrl+D)" aria-label="Duplicate"><i class="bi bi-copy" aria-hidden="true"></i></button>
                        <button type="button" data-action="forward" data-for="item" title="Bring forward (])" aria-label="Bring forward"><i class="bi bi-arrow-up" aria-hidden="true"></i></button>
                        <button type="button" data-action="backward" data-for="item" title="Send backward ([)" aria-label="Send backward"><i class="bi bi-arrow-down" aria-hidden="true"></i></button>
                        <button type="button" data-action="lock" data-for="item" title="Lock" aria-label="Lock" aria-pressed="false"><i class="bi bi-unlock" aria-hidden="true"></i></button>
                        <button type="button" class="clg-toolbar__delete" data-action="delete" data-for="item" title="Delete (Delete)" aria-label="Delete"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                    </div>
                    <div class="clg-angle" data-angle hidden></div>
                    <button type="button" class="btn btn-light btn-sm clg-preview-exit" data-action="preview-exit" data-preview-exit hidden><i class="bi bi-x-lg" aria-hidden="true"></i> Exit preview</button>
                    <div class="clg-stage-hint" data-adjust-hint hidden><span class="clg-for-mouse">Drag to move the photo in its frame · scroll or use the slider to zoom · Esc when done</span><span class="clg-for-touch">Drag to move the photo in its frame · use the Zoom slider · Done when finished</span></div>
                    <div class="clg-empty" data-empty>
                        <i class="bi bi-images" aria-hidden="true"></i>
                        <p><span class="clg-for-mouse">Add photos, drop them here, or paste one with Ctrl+V.</span><span class="clg-for-touch">Add photos from this phone or from PRISM Photos.</span></p>
                        <button type="button" class="btn btn-primary btn-sm" data-action="choose">Add photos</button>
                    </div>
                </div>

                <aside class="clg-props" id="clgProps" tabindex="-1" data-props aria-label="Settings"></aside>
            </div>
        </section>

        @* ---------- Credits: what Collage Studio ships and under which licence ---------- *@
        <dialog class="clg-dialog" data-credits aria-labelledby="clgCreditsTitle">
            <div class="clg-dialog__body">
                <div class="clg-dialog__head">
                    <h2 id="clgCreditsTitle">Credits</h2>
                    <button type="button" class="btn-close" data-action="credits-close" aria-label="Close"></button>
                </div>
                <p class="clg-hint">Collage Studio works without the Internet: everything below ships with PRISM, with its licence beside it.</p>
                <ul class="clg-credits">
                    <li><b>Emoji stickers:</b> Twemoji 15.0, copyright Twitter, Inc. and other contributors, under the Creative Commons Attribution 4.0 licence (CC BY 4.0). A chosen set, unchanged.</li>
                    <li><b>Fonts:</b> Playfair Display, Dancing Script, Caveat, Bebas Neue, Courier Prime, Baloo 2, Kalam, Tiro Devanagari Hindi, Noto Sans Devanagari and Mulish, each under the SIL Open Font License 1.1, by their designers.</li>
                    <li><b>Konva</b> 10.9.1, MIT licence, draws the page.</li>
                    <li><b>pdf-lib</b> 1.17.1, MIT licence, writes the PDF.</li>
                    <li><b>Drawn stickers</b> (ribbon, rosette, stamps and the rest) were made for PRISM.</li>
                </ul>
                <div class="clg-dialog__foot">
                    <button type="button" class="btn btn-primary" data-action="credits-close">Close</button>
                </div>
            </div>
        </dialog>

        @* ---------- From PRISM Photos: pick photos the user can see in /Photos ---------- *@
        @if (Model.LibraryOn)
        {
            <dialog class="clg-dialog clg-dialog--library" data-library-dialog aria-labelledby="clgLibraryTitle">
                <div class="clg-dialog__body">
                    <div class="clg-dialog__head">
                        <h2 id="clgLibraryTitle">From PRISM Photos</h2>
                        <button type="button" class="btn-close" data-action="library-close" aria-label="Close"></button>
                    </div>
                    <p class="clg-hint">Photos you can see in PRISM Photos. Tick the ones you want, then Add. They are copied into this browser like photos from your computer; nothing you make is sent to PRISM.</p>
                    <div class="clg-library-filters">
                        <input type="search" class="form-control form-control-sm" data-library-q placeholder="Search words, places, people" aria-label="Search PRISM Photos" maxlength="200" />
                        <select class="form-select form-select-sm" data-library-project aria-label="Project"><option value="">All projects</option></select>
                        <select class="form-select form-select-sm" data-library-year aria-label="Year"><option value="">Any year</option></select>
                    </div>
                    <p class="clg-hint" data-library-status role="status"></p>
                    <div class="clg-library-grid" data-library-grid></div>
                    <button type="button" class="btn btn-sm btn-outline-secondary clg-library-more" data-action="library-more" hidden>Show more</button>
                    <div class="clg-dialog__foot clg-library-foot">
                        <span class="clg-hint" data-library-chosen>None ticked</span>
                        <button type="button" class="btn btn-outline-secondary" data-action="library-close">Close</button>
                        <button type="button" class="btn btn-primary" data-action="library-add" disabled><i class="bi bi-plus-lg" aria-hidden="true"></i> Add</button>
                    </div>
                </div>
            </dialog>
        }

        @* ---------- Save as… ---------- *@
        <dialog class="clg-dialog" data-save-dialog aria-labelledby="clgSaveTitle">
            <div class="clg-dialog__body" data-save-form>
                <div class="clg-dialog__head">
                    <h2 id="clgSaveTitle">Save the collage</h2>
                    <button type="button" class="btn-close" data-action="save-close" aria-label="Close"></button>
                </div>
                @* What it is for comes first, with what it makes; the type and quality it picks are
                   under More options (docs/ux/collage-review-3-fixes.md, PR 6). *@
                <div class="clg-purpose" role="group" aria-labelledby="clgPurposeLabel">
                    <span class="clg-purpose__label" id="clgPurposeLabel">What is it for?</span>
                    <div class="clg-purpose__choices">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-save-purpose="share" aria-pressed="false"><i class="bi bi-check-lg" aria-hidden="true"></i> WhatsApp or email</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-save-purpose="print" aria-pressed="false"><i class="bi bi-check-lg" aria-hidden="true"></i> Printing</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-save-purpose="slide" aria-pressed="false"><i class="bi bi-check-lg" aria-hidden="true"></i> A slide or a screen</button>
                    </div>
                    <p class="clg-save-summary" data-save-summary></p>
                </div>
                <details class="clg-more" data-save-more>
                <summary>More options <span class="clg-more__hint">type and quality</span></summary>
                <fieldset class="clg-options">
                    <legend>Save as</legend>
                    <label class="clg-option"><input type="radio" name="format" value="png" checked>
                        <span><b>PNG picture</b><small>The sharpest, and a larger file. Best for slides and screens.</small></span></label>
                    <label class="clg-option"><input type="radio" name="format" value="jpeg">
                        <span><b>JPG picture</b><small>A smaller file. Best for WhatsApp and email; it can be kept under a size a form asks for.</small></span></label>
                    <label class="clg-option"><input type="radio" name="format" value="pdf">
                        <span><b>PDF for printing</b><small data-pdf-note>The exact page size, ready to print.</small></span></label>
                </fieldset>
                <div class="clg-target" data-target-row hidden>
                    <label class="form-check">
                        <input class="form-check-input" type="checkbox" data-target-on>
                        <span class="form-check-label">Keep it under</span>
                    </label>
                    <input type="text" inputmode="decimal" class="form-control form-control-sm" value="500" data-target-value aria-label="Largest file size" disabled>
                    <select class="form-select form-select-sm" data-target-unit aria-label="Unit" disabled>
                        <option value="KB" selected>KB</option>
                        <option value="MB">MB</option>
                    </select>
                </div>
                <fieldset class="clg-options">
                    <legend>Quality</legend>
                    <label class="clg-option"><input type="radio" name="quality" value="print" checked>
                        <span><b>Print quality</b><small data-print-note></small></span></label>
                    <label class="clg-option"><input type="radio" name="quality" value="screen">
                        <span><b>Screen</b><small>1,920 pixels on the long side. Quicker to share.</small></span></label>
                </fieldset>
                </details>
                <p class="clg-hint" data-save-empty hidden></p>
                <p class="clg-save-result" data-save-result role="status" hidden></p>
                <div class="clg-dialog__foot">
                    <button type="button" class="btn btn-outline-secondary" data-action="save-close">Close</button>
                    <button type="button" class="btn btn-primary" data-action="save-go" data-save-go><i class="bi bi-download" aria-hidden="true"></i> Save</button>
                </div>
            </div>
        </dialog>

        <div class="visually-hidden" role="status" aria-live="polite" data-announce></div>
        <div class="alert alert-warning clg-alert" role="alert" data-alert hidden>
            <span data-alert-text></span>
            <button type="button" class="btn-close" data-action="alert-close" aria-label="Close"></button>
        </div>
        <div class="clg-busy" data-busy hidden>
            <div class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></div>
            <span data-busy-text>Adding photos…</span>
        </div>
    </main>

    @* The PRISM confirmation dialog, as on every other page (docs/ux/confirm-dialogs.md). *@
    <partial name="_PrismConfirmDialog" />
    <script src="~/js/components/prism-confirm-dialog.js" asp-append-version="true"></script>
