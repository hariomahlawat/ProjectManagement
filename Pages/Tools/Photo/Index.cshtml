@page
@model ProjectManagement.Pages.Tools.Photo.IndexModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    // Standalone tool: it opens in its own tab with its own minimal shell instead of the
    // PRISM layout. Every tool works in the browser, except Remove background, which sends a
    // copy of the photo to the PRISM server's model and gets back only the mask, and Passport
    // photo, which asks the server where the face is and, when needed, for the same mask; nothing
    // is stored. The shell (top bar, cards, drop zone) is shared with PDF Tools through pdf-tools.css.
    Layout = null;
    var csrfToken = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#10213f" />
    <meta name="csrf-token" content="@csrfToken" />
    <title>Photo Tools | PRISM ERP</title>
    <script src="~/js/core/theme-preference.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/fonts/mulish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pdf-tools.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/photo-tools.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
</head>
<body class="pdft phot" data-photo-tools>

    <header class="pdft-topbar">
        <a class="pdft-brand" href="#" data-nav-home>
            <span class="pdft-brand__mark" aria-hidden="true"><i class="bi bi-image"></i></span>
            <span class="pdft-brand__text">Photo Tools <span>by PRISM</span></span>
        </a>
        <span class="pdft-privacy" title="Your photos are changed in this browser. Two screens send a copy to the PRISM server: Remove background, to find the person or object, and Passport photo, to place the face and, when the wall is not plain, to change the background. Nothing is stored there.">
            <i class="bi bi-shield-lock" aria-hidden="true"></i>
            <span>Photos are not saved in PRISM</span>
            <span class="visually-hidden">. Your photos are changed in this browser. Two screens send a copy to the PRISM server: Remove background, to find the person or object, and Passport photo, to place the face and, when the wall is not plain, to change the background. Nothing is stored there.</span>
        </span>
        <a class="pdft-topbar__back" asp-page="/Dashboard/Index">
            <i class="bi bi-box-arrow-up-left" aria-hidden="true"></i>
            <span>PRISM</span>
        </a>
    </header>

    <input type="file" class="visually-hidden" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" multiple data-file-input tabindex="-1" aria-hidden="true" />

    <main class="pdft-main phot-main" id="photMain">
        @* ---------- Home ---------- *@
        <section class="pdft-view" data-view="home" aria-labelledby="photHomeTitle">
            <div class="pdft-hero">
                <h1 id="photHomeTitle">What do you want to do with your photo?</h1>
                <p>Everything happens in this browser, except Remove background and Passport photo, which send a copy of the photo to the PRISM server to find the person or the face. Nothing is saved in PRISM; you download the result.</p>
            </div>
            <div class="pdft-grid phot-grid">
                <a class="pdft-card" href="#passport">
                    <span class="pdft-card__icon pdft-accent--blue" aria-hidden="true"><i class="bi bi-person-bounding-box"></i></span>
                    <span class="pdft-card__title">Passport photo</span>
                    <span class="pdft-card__text">The exact size a form asks for, with a face guide, and a new background if you need one.</span>
                </a>
                <a class="pdft-card" href="#signature">
                    <span class="pdft-card__icon pdft-accent--indigo" aria-hidden="true"><i class="bi bi-pen"></i></span>
                    <span class="pdft-card__title">Signature</span>
                    <span class="pdft-card__text">A photo of your signature as dark ink on clean white paper.</span>
                </a>
                <a class="pdft-card" href="#sheet">
                    <span class="pdft-card__icon pdft-accent--purple" aria-hidden="true"><i class="bi bi-printer"></i></span>
                    <span class="pdft-card__title">Print sheet</span>
                    <span class="pdft-card__text">Copies of one photo on 4 × 6, 5 × 7, A5 or A4 paper, ready to print.</span>
                </a>
                <a class="pdft-card" href="#idcard">
                    <span class="pdft-card__icon pdft-accent--red" aria-hidden="true"><i class="bi bi-person-vcard"></i></span>
                    <span class="pdft-card__title">ID card copy</span>
                    <span class="pdft-card__text">Front and back of a card on one A4 page, at its true size.</span>
                </a>
                <a class="pdft-card" href="#reduce">
                    <span class="pdft-card__icon pdft-accent--orange" aria-hidden="true"><i class="bi bi-arrows-angle-contract"></i></span>
                    <span class="pdft-card__title">Reduce size</span>
                    <span class="pdft-card__text">Get under a size such as 100 KB, set exact pixels or add a watermark, for one photo or many.</span>
                </a>
                <a class="pdft-card" href="#remove" data-remove-card>
                    <span class="pdft-card__icon pdft-accent--teal" aria-hidden="true"><i class="bi bi-person-square"></i></span>
                    <span class="pdft-card__title">Remove background</span>
                    <span class="pdft-card__text">Cut out a person or object and put it on a new background.</span>
                    <span class="pdft-card__note" data-remove-card-note hidden>Not set up on this server</span>
                </a>
                <a class="pdft-card" href="#edit">
                    <span class="pdft-card__icon pdft-accent--green" aria-hidden="true"><i class="bi bi-crop"></i></span>
                    <span class="pdft-card__title">Edit photo</span>
                    <span class="pdft-card__text">Crop, rotate, clean up, add a filter, mark up, or hide or blur a part.</span>
                </a>
            </div>
        </section>

        @* ---------- Passport photo ---------- *@
        <section class="pdft-view" data-view="passport" hidden aria-labelledby="photPassportTitle">
            <input type="file" class="visually-hidden" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" data-passport-input tabindex="-1" aria-hidden="true" />
            <div class="phot-head">
                <a class="phot-head__back" href="#" data-nav-home>
                    <i class="bi bi-arrow-left" aria-hidden="true"></i> All tools
                </a>
                <h1 id="photPassportTitle" data-passport-title>Passport photo</h1>
                <div class="phot-segment phot-head__mode" role="group" aria-label="What to make">
                    <button type="button" aria-pressed="true" data-mode="photo">Photo</button>
                    <button type="button" aria-pressed="false" data-mode="signature">Signature</button>
                </div>
                <span class="phot-head__file" data-passport-file></span>
                <button type="button" class="btn btn-outline-secondary phot-head__action" data-action="change-photo" hidden>
                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Change photo
                </button>
            </div>

            <div class="pdft-drop" data-drop data-empty>
                <button type="button" class="btn btn-primary btn-lg pdft-drop__button" data-action="choose-photo">
                    <i class="bi bi-folder2-open" aria-hidden="true"></i> Choose a photo
                </button>
                <p class="pdft-drop__hint" data-passport-drop-hint>or drop a photo here, or paste one (Ctrl+V). JPG, PNG or WEBP. A plain, light background works best.</p>
                <p class="pdft-drop__hint phot-remove-privacy" data-photo-only>
                    <i class="bi bi-shield-lock" aria-hidden="true"></i>
                    To place the face, and for a new background when the wall is not plain, a copy of the photo is sent to the PRISM server. It is not stored.
                </p>
            </div>

            <div class="phot-layout" data-workspace data-drop hidden>
                <div class="phot-layout__main">
                    <div class="phot-stage">
                        <div class="phot-crop" data-crop tabindex="0" role="group" aria-label="Photo position. Drag to move it, or use the arrow keys; plus and minus zoom.">
                            <canvas class="phot-crop__canvas" data-crop-canvas></canvas>
                            <div class="phot-crop__frame" data-crop-frame aria-hidden="true">
                                <div class="phot-crop__guide" data-crop-guide>
                                    <span class="phot-crop__oval"></span>
                                    <span class="phot-crop__rule phot-crop__rule--top"></span>
                                    <span class="phot-crop__label phot-crop__label--top">Top of head</span>
                                    <span class="phot-crop__rule phot-crop__rule--chin"></span>
                                    <span class="phot-crop__label phot-crop__label--chin">Chin</span>
                                </div>
                            </div>
                        </div>
                        <div class="phot-stage__bar phot-stage__bar--tools">
                            <label class="phot-stage__control" for="photZoom">Zoom
                                <input type="range" class="form-range" id="photZoom" min="100" max="400" step="1" value="100" data-zoom />
                            </label>
                            <label class="phot-stage__control" for="photStraighten">Straighten
                                <input type="range" class="form-range" id="photStraighten" min="-15" max="15" step="0.5" value="0" data-straighten />
                                <span class="phot-stage__value" data-straighten-value>0°</span>
                            </label>
                            <button type="button" class="btn btn-outline-light btn-sm phot-phone-only" data-action="bg-original-stage" hidden>
                                <i class="bi bi-eye" aria-hidden="true"></i> Hold to see the original
                            </button>
                            <button type="button" class="btn btn-outline-light btn-sm" data-action="rotate">
                                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Rotate
                            </button>
                            <button type="button" class="btn btn-outline-light btn-sm" data-action="place-face" hidden>
                                <i class="bi bi-person-bounding-box" aria-hidden="true"></i> Place the face again
                            </button>
                            <span class="phot-stage__value phot-stage__face" data-face-state role="status"></span>
                            <button type="button" class="btn btn-outline-light btn-sm" data-action="face-retry" hidden>
                                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Try again
                            </button>
                            <div class="form-check phot-stage__check" data-photo-only>
                                <input class="form-check-input" type="checkbox" id="photGuide" checked data-guide />
                                <label class="form-check-label" for="photGuide">Face guide</label>
                            </div>
                        </div>
                        <p class="phot-stage__hint" data-stage-hint>Drag the photo so the face fills the oval, with the top of the head and the chin near the two lines.</p>
                    </div>
                </div>

                <aside class="phot-layout__side" aria-label="Passport photo settings">
                    <div class="phot-panel">
                        <h2 class="phot-panel__title"><span class="phot-step" aria-hidden="true">1</span><span data-size-title>Photo size</span></h2>
                        <div class="phot-sizes" role="group" aria-label="Photo size" data-sizes></div>
                        <div class="phot-custom" data-custom-size hidden>
                            <div class="phot-custom__field">
                                <label for="photCustomWidth">Width</label>
                                <input type="text" inputmode="decimal" class="form-control" id="photCustomWidth" value="35" maxlength="6" data-custom-width />
                            </div>
                            <div class="phot-custom__field">
                                <label for="photCustomHeight">Height</label>
                                <input type="text" inputmode="decimal" class="form-control" id="photCustomHeight" value="45" maxlength="6" data-custom-height />
                            </div>
                            <div class="phot-custom__field">
                                <label for="photCustomUnit">Unit</label>
                                <select class="form-select" id="photCustomUnit" data-custom-unit>
                                    <option value="mm" selected>mm</option>
                                    <option value="inch">inch</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="phot-panel">
                        <h2 class="phot-panel__title"><span class="phot-step" aria-hidden="true">2</span>Clean up</h2>
                        <div class="phot-fix" data-photo-only>
                            <button type="button" class="phot-toggle" aria-pressed="false" data-action="fix-lighting">
                                <i class="bi bi-magic" aria-hidden="true"></i> Fix lighting
                            </button>
                            <span class="phot-hint">Corrects a dull photo and a yellow or blue colour cast.</span>
                        </div>
                        <div class="phot-fix" data-signature-only hidden>
                            <button type="button" class="phot-toggle" aria-pressed="true" data-action="clean-paper">
                                <i class="bi bi-magic" aria-hidden="true"></i> Clean paper
                            </button>
                            <span class="phot-hint" data-paper-hint>Makes the paper white and the ink black.</span>
                        </div>
                        <label class="phot-slider" for="photBrightness" data-photo-only>Brightness
                            <input type="range" class="form-range" id="photBrightness" min="-50" max="50" step="1" value="0" data-brightness />
                            <span class="phot-slider__value" data-brightness-value>0</span>
                        </label>
                        <div class="phot-bg" data-photo-only>
                            <span class="phot-bg__title" id="photBgTitle">Background</span>
                            <div class="phot-bg__choices" role="group" aria-labelledby="photBgTitle">
                                <button type="button" class="phot-bgchoice" aria-pressed="true" data-bg="">
                                    <i class="bi bi-image" aria-hidden="true"></i> Keep
                                </button>
                                <button type="button" class="phot-bgchoice" aria-pressed="false" data-bg="#ffffff">
                                    <span class="phot-bgchoice__dot" aria-hidden="true"></span> White
                                </button>
                                <button type="button" class="phot-bgchoice" aria-pressed="false" data-bg="#cfe3f7">
                                    <span class="phot-bgchoice__dot" aria-hidden="true"></span> Light blue
                                </button>
                                <label class="phot-bgchoice" data-bg-other>
                                    <input type="color" value="#e6ecf2" data-bg-colour aria-label="Other background colour" autocomplete="off" />
                                    Other
                                </label>
                            </div>
                            <label class="phot-slider" for="photBgAmount" data-bg-amount-row hidden>How much counts as background
                                <input type="range" class="form-range" id="photBgAmount" min="0" max="100" step="5" value="50" data-bg-amount autocomplete="off" />
                                <span class="phot-slider__value" data-bg-amount-value>Normal</span>
                            </label>
                            <button type="button" class="btn btn-outline-secondary phot-bg__compare" data-action="bg-original" hidden>
                                <i class="bi bi-eye" aria-hidden="true"></i> Hold to see the original
                            </button>
                            <button type="button" class="btn btn-outline-secondary phot-bg__compare" data-action="bg-fix" aria-expanded="false" hidden>
                                <i class="bi bi-brush" aria-hidden="true"></i> <span data-bg-fix-label>Touch up edges</span>
                            </button>
                            <div class="phot-bgfix" data-bg-fix hidden>
                                <div class="phot-segment phot-brushes" role="group" aria-label="Brush">
                                    <button type="button" aria-pressed="true" data-bg-brush="refine"><i class="bi bi-magic" aria-hidden="true"></i> Refine edge</button>
                                    <button type="button" aria-pressed="false" data-bg-brush="erase"><i class="bi bi-eraser" aria-hidden="true"></i> Erase</button>
                                    <button type="button" aria-pressed="false" data-bg-brush="restore"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Restore</button>
                                </div>
                                <p class="phot-hint" data-bg-brush-hint aria-live="polite"></p>
                                <div class="phot-bgfix__row">
                                    <span class="phot-bg__title" id="photBrushSize">Brush size</span>
                                    <div class="phot-segment" role="group" aria-labelledby="photBrushSize">
                                        <button type="button" aria-pressed="false" data-bg-size="small" title="Smaller: [">Small</button>
                                        <button type="button" aria-pressed="true" data-bg-size="medium">Medium</button>
                                        <button type="button" aria-pressed="false" data-bg-size="large" title="Larger: ]">Large</button>
                                    </div>
                                </div>
                                <div class="phot-bgfix__row">
                                    <button type="button" class="btn btn-outline-secondary" data-action="bg-fix-undo" disabled>Undo</button>
                                    <button type="button" class="btn btn-outline-secondary" data-action="bg-fix-clear" disabled>Reset</button>
                                    <button type="button" class="btn btn-primary" data-action="bg-fix-done">Done</button>
                                </div>
                            </div>
                            <button type="button" class="btn btn-outline-secondary phot-bg__compare" data-action="bg-model" hidden>
                                <i class="bi bi-stars" aria-hidden="true"></i> Better edges
                            </button>
                            <p class="phot-hint" data-bg-model-hint hidden>Better edges sends a copy of the photo to the PRISM server, which finds the person. Nothing is stored.</p>
                            <div class="phot-busy phot-busy--inline" data-bg-wait tabindex="-1" hidden>
                                <span class="phot-busy__line">
                                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                    <span data-bg-wait-text>Sending a copy to the PRISM server to find the person…</span>
                                </span>
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-action="bg-model-cancel" hidden>Cancel</button>
                            </div>
                            <div class="phot-busy phot-busy--inline phot-busy--retry" data-bg-retry hidden>
                                <span data-bg-retry-text></span>
                                <button type="button" class="btn btn-primary btn-sm" data-action="bg-model-retry">
                                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Try again
                                </button>
                            </div>
                            <p class="visually-hidden" role="status" data-bg-wait-status></p>
                            <p class="phot-hint phot-hint--warning" data-bg-problem aria-live="polite" hidden></p>
                            <p class="phot-hint" data-bg-model-note tabindex="-1" hidden>Edges by the PRISM server's background model. A copy of the photo was sent to the PRISM server, used in memory and not stored. Check the hair and shoulders before you use the photo; some offices do not accept a changed background.</p>
                            <p class="phot-hint" data-bg-note hidden>Works on a plain wall or curtain. Check the hair and shoulders before you use the photo. Some offices do not accept a photo with a changed background, so check the rules of your form.</p>
                        </div>
                    </div>

                    <div class="phot-panel">
                        <h2 class="phot-panel__title"><span class="phot-step" aria-hidden="true">3</span>Save</h2>
                        <div class="phot-custom">
                            <div class="phot-custom__field">
                                <label for="photOutWidth">Width (px)</label>
                                <input type="text" inputmode="numeric" class="form-control" id="photOutWidth" maxlength="5" data-out-width />
                            </div>
                            <div class="phot-custom__field">
                                <label for="photOutHeight">Height (px)</label>
                                <input type="text" inputmode="numeric" class="form-control" id="photOutHeight" maxlength="5" data-out-height />
                            </div>
                            <div class="phot-custom__field">
                                <label for="photOutLimit">Under (KB)</label>
                                <input type="text" inputmode="decimal" class="form-control" id="photOutLimit" maxlength="6" placeholder="No limit" data-out-limit />
                            </div>
                        </div>
                        <p class="phot-hint">Pixels (px) are the dots the photo is made of. Change them, or the file size, only if your form gives other numbers. It is saved as a JPG that prints at its true size.</p>
                        <p class="phot-result" data-passport-result aria-live="polite"></p>
                        <div class="phot-check" data-passport-check aria-live="polite" hidden>
                            <p class="phot-check__title" data-check-title></p>
                            <ul class="phot-check__list" data-check-list></ul>
                            <p class="phot-hint">A guide only. It looks at detail, head position, background and light on the face, and cannot check every rule of your form.</p>
                        </div>
                        <button type="button" class="btn btn-primary btn-lg" data-action="download-passport" disabled>
                            <i class="bi bi-download" aria-hidden="true"></i> <span data-download-passport-label>Download photo</span>
                        </button>
                        <div class="phot-next" data-photo-only>
                            <button type="button" class="btn btn-outline-primary" data-action="print-sheet" aria-describedby="photSheetNote" disabled>
                                <i class="bi bi-printer" aria-hidden="true"></i> Print sheet
                            </button>
                            <p class="phot-hint" id="photSheetNote">Puts copies of this photo on 4 × 6 inch, 5 × 7 inch, A5 or A4 paper.</p>
                        </div>
                    </div>
                </aside>
                @* The Save bar: the checks' summary and a copy of Download at the foot of the screen
                   while the panel's own Download is out of view, on a laptop as on a phone
                   (photo-tools-canvas.js, wireSaveBar). *@
                <div class="phot-savebar" data-save-bar hidden>
                    <button type="button" class="btn btn-link phot-savebar__checks" data-action="savebar-checks"></button>
                    <button type="button" class="btn btn-primary" data-save-bar-download disabled>
                        <i class="bi bi-download" aria-hidden="true"></i> Download
                    </button>
                </div>
            </div>
        </section>

        @* ---------- Print sheet ---------- *@
        <section class="pdft-view" data-view="sheet" hidden aria-labelledby="photSheetTitle">
            <input type="file" class="visually-hidden" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" data-sheet-input tabindex="-1" aria-hidden="true" />
            <div class="phot-head">
                <a class="phot-head__back" href="#" data-nav-home>
                    <i class="bi bi-arrow-left" aria-hidden="true"></i> All tools
                </a>
                <h1 id="photSheetTitle">Print sheet</h1>
                <span class="phot-head__file" data-sheet-file></span>
                <button type="button" class="btn btn-outline-secondary phot-head__action" data-action="change-photo" hidden>
                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Change photo
                </button>
            </div>

            <div class="pdft-drop" data-drop data-empty>
                <button type="button" class="btn btn-primary btn-lg pdft-drop__button" data-action="choose-photo">
                    <i class="bi bi-folder2-open" aria-hidden="true"></i> Choose a photo
                </button>
                <p class="pdft-drop__hint">or drop a photo here, or paste one (Ctrl+V). JPG, PNG or WEBP. For a passport photo, make it in <a href="#passport">Passport photo</a> first and press Print sheet there.</p>
            </div>

            <div class="phot-layout" data-workspace data-drop hidden>
                <div class="phot-layout__main">
                    <div class="phot-stage">
                        <div class="phot-paper" data-sheet-stage>
                            <canvas class="phot-paper__canvas" data-sheet-canvas role="img" aria-label="Preview of the print sheet" aria-describedby="photSheetCaption"></canvas>
                        </div>
                        <p class="phot-stage__hint phot-paper__caption">
                            <strong id="photSheetCaption" data-sheet-caption aria-live="polite"></strong>
                            <span>Print at actual size (100%), not “fit to page”.</span>
                        </p>
                    </div>
                </div>

                <aside class="phot-layout__side" aria-label="Print sheet settings">
                    <div class="phot-panel">
                        <h2 class="phot-panel__title"><span class="phot-step" aria-hidden="true">1</span>Photo</h2>
                        <div class="phot-mini">
                            <canvas class="phot-mini__thumb" data-sheet-thumb aria-hidden="true"></canvas>
                            <div class="phot-mini__text">
                                <div class="phot-mini__title" data-sheet-origin></div>
                                <p class="phot-hint">Each copy is printed at the size chosen here.</p>
                                <div class="phot-place" data-sheet-place hidden>
                                    <p class="phot-hint">This photo is a different shape, so only part of it fits. Drag the picture to choose the part.</p>
                                    <label class="phot-slider" for="photSheetZoom">Zoom
                                        <input type="range" class="form-range" id="photSheetZoom" min="100" max="300" step="1" value="100" data-sheet-zoom autocomplete="off" />
                                    </label>
                                    <button type="button" class="btn btn-outline-secondary" data-action="centre-photo" disabled>Centre</button>
                                </div>
                            </div>
                        </div>
                        <div class="phot-sizes" role="group" aria-label="Print size of one copy" data-sheet-sizes></div>
                    </div>

                    <div class="phot-panel">
                        <h2 class="phot-panel__title"><span class="phot-step" aria-hidden="true">2</span>Paper and copies</h2>
                        <div class="phot-sizes" role="group" aria-label="Paper" data-sheet-papers></div>
                        <div class="phot-copies">
                            <span class="phot-copies__label" id="photCopiesLabel">Copies</span>
                            <span class="phot-stepper" role="group" aria-labelledby="photCopiesLabel">
                                <button type="button" data-action="fewer-copies" aria-label="One copy fewer"><i class="bi bi-dash-lg" aria-hidden="true"></i></button>
