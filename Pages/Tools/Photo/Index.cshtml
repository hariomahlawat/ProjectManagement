                    </div>
                </div>

                <aside class="phot-layout__side" aria-label="Size settings">
                    <div class="phot-panel">
                        <h2 class="phot-panel__title"><label for="photTargetValue">Make each photo under</label></h2>
                        <div class="phot-target">
                            <input type="text" inputmode="decimal" class="form-control phot-target__value" id="photTargetValue" value="100" maxlength="7" data-target-value aria-describedby="photTargetHint" />
