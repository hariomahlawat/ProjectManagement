                        <div class="phot-tool" data-tool-panel="crop">
                            <div class="phot-field">
                                <label for="photCropShape">Shape</label>
                                <select class="form-select" id="photCropShape" autocomplete="off" data-crop-shape></select>
                            </div>
                            <p class="phot-hint" data-crop-size aria-live="polite"></p>
                            <button type="button" class="btn btn-primary" data-action="apply-crop" disabled>
                                <i class="bi bi-check-lg" aria-hidden="true"></i> Crop
                            </button>
                        </div>

                        <div class="phot-tool" data-tool-panel="rotate" hidden>
                            <div class="phot-turns" role="group" aria-label="Turn or flip">
                                <button type="button" class="btn btn-outline-secondary" data-turn="-1"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Turn left</button>
                                <button type="button" class="btn btn-outline-secondary" data-turn="1"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Turn right</button>
                                <button type="button" class="btn btn-outline-secondary" data-flip="h"><i class="bi bi-symmetry-vertical" aria-hidden="true"></i> Flip sideways</button>
                                <button type="button" class="btn btn-outline-secondary" data-flip="v"><i class="bi bi-symmetry-horizontal" aria-hidden="true"></i> Flip upside down</button>
                            </div>
                            <label class="phot-slider" for="photEditStraighten">Straighten
                                <input type="range" class="form-range" id="photEditStraighten" min="-15" max="15" step="0.5" value="0" autocomplete="off" data-edit-straighten />
                                <span class="phot-slider__value" data-edit-straighten-value>0°</span>
                            </label>
                            <p class="phot-hint">Straightening trims a little off the edges so no empty corner shows.</p>
                            <button type="button" class="btn btn-primary" data-action="apply-straighten" disabled>
                                <i class="bi bi-check-lg" aria-hidden="true"></i> Straighten
                            </button>
                        </div>

                        <div class="phot-tool" data-tool-panel="resize" hidden>
                            <div class="phot-custom phot-custom--two">
                                <div class="phot-custom__field">
                                    <label for="photResizeWidth">Width (px)</label>
                                    <input type="text" inputmode="numeric" class="form-control" id="photResizeWidth" maxlength="5" autocomplete="off" data-resize-width />
                                </div>
                                <div class="phot-custom__field">
                                    <label for="photResizeHeight">Height (px)</label>
                                    <input type="text" inputmode="numeric" class="form-control" id="photResizeHeight" maxlength="5" autocomplete="off" data-resize-height />
                                </div>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="photResizeKeep" checked autocomplete="off" data-resize-keep />
                                <label class="form-check-label" for="photResizeKeep">Keep the shape</label>
                            </div>
                            <div class="phot-chips" role="group" aria-label="Quick sizes">
                                <button type="button" data-resize-percent="75">75%</button>
                                <button type="button" data-resize-percent="50">50%</button>
                                <button type="button" data-resize-percent="25">25%</button>
                            </div>
                            <p class="phot-hint" data-resize-note aria-live="polite"></p>
                            <button type="button" class="btn btn-primary" data-action="apply-resize" disabled>
                                <i class="bi bi-check-lg" aria-hidden="true"></i> Resize
                            </button>
                        </div>

                        <div class="phot-tool" data-tool-panel="cleanup" hidden>
                            <div class="phot-cleanups" data-cleanups></div>
                            <p class="phot-hint">Each press is one step. Undo takes it back.</p>
                        </div>

                        <div class="phot-tool" data-tool-panel="adjust" hidden>
                            <label class="phot-slider phot-slider--named" for="photAdjustBrightness">Brightness
                                <input type="range" class="form-range" id="photAdjustBrightness" min="-50" max="50" step="1" value="0" autocomplete="off" data-adjust="brightness" />
                                <span class="phot-slider__value" data-adjust-value="brightness">0</span>
                            </label>
                            <label class="phot-slider phot-slider--named" for="photAdjustContrast">Contrast
                                <input type="range" class="form-range" id="photAdjustContrast" min="-50" max="50" step="1" value="0" autocomplete="off" data-adjust="contrast" />
                                <span class="phot-slider__value" data-adjust-value="contrast">0</span>
                            </label>
                            <label class="phot-slider phot-slider--named" for="photAdjustSaturation">Colour
                                <input type="range" class="form-range" id="photAdjustSaturation" min="-50" max="50" step="1" value="0" autocomplete="off" data-adjust="saturation" />
                                <span class="phot-slider__value" data-adjust-value="saturation">0</span>
                            </label>
                            <label class="phot-slider phot-slider--named" for="photAdjustWarmth">Warmth
                                <input type="range" class="form-range" id="photAdjustWarmth" min="-50" max="50" step="1" value="0" autocomplete="off" data-adjust="warmth" />
                                <span class="phot-slider__value" data-adjust-value="warmth">0</span>
                            </label>
                            <div class="phot-tool__actions">
                                <button type="button" class="btn btn-primary" data-action="apply-adjust" disabled>
                                    <i class="bi bi-check-lg" aria-hidden="true"></i> Apply
                                </button>
                                <button type="button" class="btn btn-outline-secondary" data-action="reset-adjust" disabled>Reset</button>
                            </div>
                        </div>

                        <div class="phot-tool" data-tool-panel="filters" hidden>
                            <div class="phot-filters" role="group" aria-label="Filters" data-filters></div>
                            <p class="phot-hint">Press a filter to use it. Undo takes it back.</p>
                        </div>

                        <div class="phot-tool" data-tool-panel="markup" hidden>
                            <div class="phot-chips" role="group" aria-label="What to draw" data-mark-kinds></div>
                            <div class="phot-field">
                                <span class="phot-field__label" id="photMarkColour">Colour</span>
                                <div class="phot-swatches" role="group" aria-labelledby="photMarkColour" data-mark-colours></div>
                            </div>
                            <div class="phot-field">
                                <span class="phot-field__label" id="photMarkSize">Size</span>
                                <div class="phot-segment" role="group" aria-labelledby="photMarkSize" data-mark-sizes></div>
                            </div>
                            <div class="phot-field" data-mark-text-row hidden>
                                <label for="photMarkText">Text</label>
                                <input type="text" class="form-control" id="photMarkText" maxlength="80" autocomplete="off" data-mark-text />
                            </div>
                            <p class="phot-hint" data-mark-note aria-live="polite"></p>
                        </div>

                        <div class="phot-tool" data-tool-panel="hide" hidden>
                            <div class="phot-segment phot-segment--start" role="group" aria-label="How to hide it">
                                <button type="button" aria-pressed="true" data-hide-mode="cover">Cover</button>
                                <button type="button" aria-pressed="false" data-hide-mode="blur">Blur</button>
                                <button type="button" aria-pressed="false" data-hide-mode="pixelate">Pixelate</button>
                            </div>
                            <p class="phot-hint">Drag over the part to hide. Cover fills it with solid black, so nothing of it is left in the saved photo. Use Cover for writing, names and numbers.</p>
                            <p class="phot-hint">Blur and Pixelate suit faces and backgrounds. They keep a rough outline, and short words or numbers can sometimes be guessed back from it.</p>
                        </div>
                    </div>

                    <div class="phot-panel">
                        <h2 class="phot-panel__title">Save</h2>
                        <div class="phot-field">
                            <label for="photEditFormat">Save as</label>
                            <select class="form-select" id="photEditFormat" autocomplete="off" data-edit-format>
                                <option value="jpeg">JPG (smallest, accepted everywhere)</option>
                                <option value="png">PNG (keeps every pixel, larger)</option>
                                <option value="webp">WEBP (small; some offices do not accept it)</option>
                            </select>
                        </div>
                        <label class="phot-slider" for="photEditQuality" data-edit-quality-row>Quality
                            <input type="range" class="form-range" id="photEditQuality" min="40" max="100" step="1" value="90" autocomplete="off" data-edit-quality />
                            <span class="phot-slider__value" data-edit-quality-value>90</span>
                        </label>
                        <p class="phot-result" data-edit-result aria-live="polite"></p>
                        <button type="button" class="btn btn-primary btn-lg" data-action="download-edit" disabled>
                            <i class="bi bi-download" aria-hidden="true"></i> Download photo
                        </button>
                        @* Continue in another tool: the photo Download would save, opened there
                           (photo-tools-canvas.js, sendPhoto). *@
                        <div class="phot-next phot-continue" role="group" aria-labelledby="photEditContinueTitle">
                            <p class="phot-continue__title" id="photEditContinueTitle">Continue in another tool</p>
                            <div class="phot-continue__buttons">
                                <button type="button" class="btn btn-outline-primary btn-sm" data-send-to="passport" disabled>
                                    <i class="bi bi-person-bounding-box" aria-hidden="true"></i> Passport photo
                                </button>
                                <button type="button" class="btn btn-outline-primary btn-sm" data-send-to="remove" disabled>
                                    <i class="bi bi-person-square" aria-hidden="true"></i> Remove background
                                </button>
                                <button type="button" class="btn btn-outline-primary btn-sm" data-send-to="reduce" disabled>
                                    <i class="bi bi-arrows-angle-contract" aria-hidden="true"></i> Reduce size
                                </button>
                                <button type="button" class="btn btn-outline-primary btn-sm" data-send-to="sheet" disabled>
                                    <i class="bi bi-printer" aria-hidden="true"></i> Print sheet
                                </button>
                            </div>
                            <p class="phot-hint">Opens the photo there as Download would save it. This screen keeps its work.</p>
                        </div>
                        <p class="phot-hint">
                            <i class="bi bi-geo-alt" aria-hidden="true"></i>
                            Location and camera details hidden in a photo are always left out of the saved file.
                        </p>
                    </div>
                </aside>
                @* The Save bar: a copy of Download at the foot of the screen while the panel's own
                   Download is out of view (photo-tools-canvas.js, wireSaveBar). *@
                <div class="phot-savebar" data-save-bar hidden>
                    <span class="phot-savebar__text" data-save-bar-text></span>
                    <button type="button" class="btn btn-primary" data-save-bar-download disabled>
                        <i class="bi bi-download" aria-hidden="true"></i> Download photo
                    </button>
                </div>
            </div>
        </section>


        @* ---------- Remove background ---------- *@
        <section class="pdft-view" data-view="remove" hidden aria-labelledby="photRemoveTitle">
            <input type="file" class="visually-hidden" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" data-remove-input tabindex="-1" aria-hidden="true" />
            <div class="phot-head">
                <a class="phot-head__back" href="#" data-nav-home>
                    <i class="bi bi-arrow-left" aria-hidden="true"></i> All tools
                </a>
                <h1 id="photRemoveTitle">Remove background</h1>
                <span class="phot-head__file" data-remove-file></span>
                <button type="button" class="btn btn-outline-secondary phot-head__action" data-action="change-photo" hidden>
                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Change photo
                </button>
            </div>

            <div class="alert alert-warning phot-remove-status" role="status" data-remove-status hidden></div>

            <div class="pdft-drop" data-drop data-empty>
                <button type="button" class="btn btn-primary btn-lg pdft-drop__button" data-action="choose-photo">
                    <i class="bi bi-folder2-open" aria-hidden="true"></i> Choose a photo
                </button>
                <p class="pdft-drop__hint" data-remove-ready-only>or drop a photo here, or paste one (Ctrl+V). JPG, PNG or WEBP. A person, an animal or an object; any background.</p>
                <p class="pdft-drop__hint phot-remove-privacy" data-remove-ready-only>
                    <i class="bi bi-shield-lock" aria-hidden="true"></i>
                    A copy of the photo is sent to the PRISM server to find the person or object. It is not stored.
                </p>
            </div>

            <div class="phot-layout" data-workspace data-drop hidden>
                <div class="phot-layout__main">
                    <div class="phot-stage">
                        <div class="phot-stage__bar phot-stage__bar--tools">
                            <button type="button" class="btn btn-outline-light btn-sm" data-action="remove-original" disabled>
                                <i class="bi bi-eye" aria-hidden="true"></i>
                                <span class="d-none d-sm-inline">Hold to see the original</span><span class="d-sm-none">Hold for original</span>
                            </button>
                            <span class="phot-edit__size" data-remove-size aria-live="polite"></span>
                        </div>
                        <div class="phot-edit" data-remove-stage>
                            <div class="phot-edit__photo phot-remove__photo" data-remove-photo tabindex="0" role="group"
                                 aria-label="Photo. Paint on it with the brush. With the keyboard, the arrow keys move the brush, Space paints, and [ and ] change its size.">
                                <canvas class="phot-edit__canvas" data-remove-canvas></canvas>
                            </div>
                            <div class="phot-busy" data-remove-busy hidden>
                                <span class="phot-busy__line">
                                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                    <span data-remove-busy-text>Finding the person or object…</span>
                                </span>
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-action="remove-cancel" hidden>Cancel</button>
                            </div>
                            <div class="phot-busy phot-busy--retry" data-remove-retry hidden>
                                <span data-remove-retry-text></span>
                                <button type="button" class="btn btn-primary btn-sm" data-action="remove-retry">
                                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Try again
                                </button>
                            </div>
                        </div>
                        <p class="visually-hidden" role="status" data-remove-busy-status></p>
                        <p class="phot-stage__hint" data-remove-hint hidden>Check the edges. Where hair or fur needs work, drag on the photo to paint with Refine edge.</p>
                    </div>
                </div>

                <aside class="phot-layout__side" aria-label="Remove background settings">
                    <div class="phot-panel">
                        <h2 class="phot-panel__title"><span class="phot-step" aria-hidden="true">1</span>Background</h2>
                        <div class="phot-bg__choices" role="group" aria-label="New background">
                            <button type="button" class="phot-bgchoice" aria-pressed="true" data-remove-bg="transparent">
                                <span class="phot-bgchoice__dot phot-bgchoice__dot--clear" aria-hidden="true"></span> See-through
                            </button>
                            <button type="button" class="phot-bgchoice" aria-pressed="false" data-remove-bg="#ffffff">
                                <span class="phot-bgchoice__dot" aria-hidden="true"></span> White
                            </button>
                            <button type="button" class="phot-bgchoice" aria-pressed="false" data-remove-bg="#cfe3f7">
                                <span class="phot-bgchoice__dot" aria-hidden="true"></span> Light blue
                            </button>
                            <label class="phot-bgchoice" data-remove-bg-other>
                                <input type="color" value="#e6ecf2" data-remove-bg-colour aria-label="Other background colour" autocomplete="off" />
                                Other
                            </label>
                            <button type="button" class="phot-bgchoice" aria-pressed="false" data-remove-bg="blur">
                                <i class="bi bi-droplet-half" aria-hidden="true"></i> Blur
                            </button>
                        </div>
                    </div>

                    <div class="phot-panel">
                        <h2 class="phot-panel__title"><span class="phot-step" aria-hidden="true">2</span>Touch up</h2>
                        <div class="phot-segment phot-brushes" role="group" aria-label="Brush">
                            <button type="button" aria-pressed="true" data-remove-brush="refine"><i class="bi bi-magic" aria-hidden="true"></i> Refine edge</button>
                            <button type="button" aria-pressed="false" data-remove-brush="erase"><i class="bi bi-eraser" aria-hidden="true"></i> Erase</button>
                            <button type="button" aria-pressed="false" data-remove-brush="restore"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Restore</button>
                        </div>
                        <p class="phot-hint" data-remove-brush-hint aria-live="polite"></p>
                        <div class="phot-bgfix__row">
                            <span class="phot-bg__title" id="photRemoveBrushSize">Brush size</span>
                            <div class="phot-segment" role="group" aria-labelledby="photRemoveBrushSize">
                                <button type="button" aria-pressed="false" data-remove-size-choice="small" title="Smaller: [">Small</button>
                                <button type="button" aria-pressed="true" data-remove-size-choice="medium">Medium</button>
                                <button type="button" aria-pressed="false" data-remove-size-choice="large" title="Larger: ]">Large</button>
                            </div>
                        </div>
                        @* The same pair, in the same place, as Passport photo's Touch up edges. *@
                        <div class="phot-bgfix__row">
                            <button type="button" class="btn btn-outline-secondary" data-action="remove-undo" aria-label="Undo the last stroke" disabled>Undo</button>
                            <button type="button" class="btn btn-outline-secondary" data-action="remove-reset" disabled>Reset</button>
                        </div>
                    </div>

                    <div class="phot-panel">
                        <h2 class="phot-panel__title"><span class="phot-step" aria-hidden="true">3</span>Save</h2>
                        <label class="phot-field" for="photRemoveFormat">File type
                            <select class="form-select" id="photRemoveFormat" data-remove-format>
                                <option value="png">PNG (keeps see-through areas)</option>
                                <option value="webp">WEBP (smaller, keeps see-through areas)</option>
                                <option value="jpeg">JPG (no see-through areas)</option>
                            </select>
                        </label>
                        <p class="phot-hint" data-remove-jpeg-hint>For a JPG, choose White, Light blue, Other or Blur first.</p>
                        <p class="phot-result" data-remove-result aria-live="polite"></p>
                        <button type="button" class="btn btn-primary btn-lg" data-action="download-remove" disabled>
                            <i class="bi bi-download" aria-hidden="true"></i> Download
                        </button>
                        @* Continue in another tool: the photo Download would save, opened there
                           (photo-tools-canvas.js, sendPhoto). *@
                        <div class="phot-next phot-continue" role="group" aria-labelledby="photRemoveContinueTitle">
                            <p class="phot-continue__title" id="photRemoveContinueTitle">Continue in another tool</p>
                            <div class="phot-continue__buttons">
                                <button type="button" class="btn btn-outline-primary btn-sm" data-send-to="edit" disabled>
                                    <i class="bi bi-crop" aria-hidden="true"></i> Edit photo
                                </button>
                                <button type="button" class="btn btn-outline-primary btn-sm" data-send-to="passport" disabled>
                                    <i class="bi bi-person-bounding-box" aria-hidden="true"></i> Passport photo
                                </button>
                                <button type="button" class="btn btn-outline-primary btn-sm" data-send-to="reduce" disabled>
                                    <i class="bi bi-arrows-angle-contract" aria-hidden="true"></i> Reduce size
                                </button>
                                <button type="button" class="btn btn-outline-primary btn-sm" data-send-to="sheet" disabled>
                                    <i class="bi bi-printer" aria-hidden="true"></i> Print sheet
                                </button>
                            </div>
                            <p class="phot-hint">Opens the photo there as Download would save it. This screen keeps its work.</p>
                        </div>
                        <p class="phot-hint">
                            <i class="bi bi-shield-lock" aria-hidden="true"></i>
                            The photo was sent to the PRISM server only to find the person or object. It is not stored there. Location and camera details are left out of the saved file.
                        </p>
                        <p class="phot-hint phot-remove-credit" data-remove-credit hidden></p>
                    </div>
                </aside>
                @* The Save bar: a copy of Download at the foot of the screen while the panel's own
                   Download is out of view (photo-tools-canvas.js, wireSaveBar). *@
                <div class="phot-savebar" data-save-bar hidden>
                    <span class="phot-savebar__text" data-save-bar-text></span>
                    <button type="button" class="btn btn-primary" data-save-bar-download disabled>
                        <i class="bi bi-download" aria-hidden="true"></i> Download
                    </button>
                </div>
            </div>
        </section>

        <div class="alert alert-danger pdft-error" role="alert" data-error hidden></div>
    </main>

    <script src="~/js/tools-shared/zip-writer.js" asp-append-version="true"></script>
    <script src="~/js/photo-tools/photo-tools-core.js" asp-append-version="true"></script>
    <script src="~/js/photo-tools/photo-tools-canvas.js" asp-append-version="true"></script>
    <script src="~/js/photo-tools/photo-tools-app.js" asp-append-version="true"></script>
    <script src="~/js/photo-tools/photo-tools-passport.js" asp-append-version="true"></script>
    @* The same PDF library PDF Tools uses, shipped with the application. Print sheet writes its PDF with it. *@
    <script src="~/lib/pdf-lib/1.17.1/dist/pdf-lib.min.js"></script>
    <script src="~/js/photo-tools/photo-tools-print.js" asp-append-version="true"></script>
    <script src="~/js/photo-tools/photo-tools-idcard.js" asp-append-version="true"></script>
    <script src="~/js/photo-tools/photo-tools-editor.js" asp-append-version="true"></script>
    <script src="~/js/photo-tools/photo-tools-background.js" asp-append-version="true"></script>
</body>
</html>
