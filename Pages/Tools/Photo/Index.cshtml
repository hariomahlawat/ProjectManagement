                            <label class="form-check-label" for="photWatermarkOn">Add a watermark</label>
                        </div>
                        <div class="phot-watermark" id="photWatermarkFields" data-watermark-fields hidden>
                            <div class="phot-field">
                                <label for="photWatermarkText">Text</label>
                                <input type="text" class="form-control" id="photWatermarkText" maxlength="60" placeholder="For official use only" autocomplete="off" data-watermark-text aria-describedby="photWatermarkHint" />
                            </div>
                            <div class="phot-field">
                                <label for="photWatermarkPlace">Place</label>
                                <select class="form-select" id="photWatermarkPlace" data-watermark-place>
                                    <option value="bottom-right" selected>Bottom right</option>
                                    <option value="bottom-left">Bottom left</option>
                                    <option value="centre">Centre</option>
                                    <option value="across">Across the photo, repeated</option>
                                </select>
                            </div>
                            <div class="phot-field">
                                <span class="phot-field__label" id="photWatermarkStrength">Strength</span>
                                <div class="phot-segment" role="group" aria-labelledby="photWatermarkStrength">
                                    <button type="button" aria-pressed="true" data-watermark-strength="light">Light</button>
                                    <button type="button" aria-pressed="false" data-watermark-strength="strong">Strong</button>
                                </div>
                            </div>
                            <p class="phot-hint" id="photWatermarkHint" data-watermark-hint>White letters with a soft dark edge, sized to each photo. Across the photo is the hardest to crop out.</p>
                        </div>
                    </div>

                    <div class="phot-summary" aria-live="polite">
                        <span class="phot-summary__count" data-summary-count></span>
                        <div class="phot-summary__sizes">
                            <span class="phot-summary__before" data-summary-before></span>
                            <span class="phot-summary__after" data-summary-after></span>
                        </div>
                        <p class="phot-summary__note" data-summary-note hidden></p>
                        <button type="button" class="btn btn-light btn-lg" data-action="download" disabled>
                            <i class="bi bi-download" aria-hidden="true"></i> <span data-download-label>Download</span>
                        </button>
                    </div>
                </aside>
            </div>
        </section>

