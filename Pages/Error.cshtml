@page
@model ErrorModel
@inject Microsoft.AspNetCore.Identity.SignInManager<ProjectManagement.Models.ApplicationUser> SignInManager
@{
    ViewData["Title"] = "Error";
    ViewData["UseFullWidth"] = true;
    ViewData["PageShell"] = "focused";
    ViewData["PublicHeaderMode"] = "Auth";
    var signedIn = SignInManager.IsSignedIn(User);
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/status-page.css" asp-append-version="true" />
}

<div class="lp status lp-hue-1@(signedIn ? " status--in-app" : string.Empty)">
    <div class="lp-aurora lp-aurora--status" aria-hidden="true"></div>
    <div class="status__dots" aria-hidden="true"></div>
    <div class="status__beam" aria-hidden="true"></div>
    <div class="status__fan" aria-hidden="true"></div>

    <div class="lp-wrap">
        <section class="status__card" data-glass-light aria-labelledby="status-title">
            <span class="status__glyph" aria-hidden="true"><i class="bi bi-exclamation-triangle"></i></span>
            <p class="lp-eyebrow">Something went wrong</p>
            <h1 id="status-title">PRISM could not finish that request</h1>
            <p class="status__lead">
                The error has been recorded. Try again in a moment; if it keeps happening, tell the
                PRISM administrator what you were doing@(Model.ShowRequestId ? " and quote the reference below" : string.Empty).
            </p>

            <div class="status__actions">
                @if (signedIn)
                {
                    <a class="lp-btn lp-btn--primary" asp-area="" asp-page="/Index">
                        <span>Go to dashboard</span>
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </a>
                }
                else
                {
                    <a class="lp-btn lp-btn--primary" asp-area="" asp-page="/Index">
                        <span>Back to home</span>
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </a>
                    <a class="lp-btn lp-btn--ghost" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
                }
            </div>

            @if (Model.ShowRequestId)
            {
                <footer class="status__foot">
                    <p><span>Reference</span> <code class="status__ref">@Model.RequestId</code></p>
                </footer>
            }
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/glass-light.js" asp-append-version="true" defer></script>
}
