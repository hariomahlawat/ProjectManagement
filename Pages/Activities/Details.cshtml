@page "{id:int}"
@model ProjectManagement.Pages.Activities.DetailsModel
@using System.Globalization
@using ProjectManagement.Infrastructure
@{
    var activity = Model.Activity;
    if (activity is null)
    {
        <div class="alert alert-danger mt-4" role="alert">The requested activity could not be found.</div>;
        return;
    }

    ViewData["Title"] = activity.Title;

    var latestDeleteRequest = activity.DeleteRequests
        .OrderByDescending(request => request.RequestedAtUtc)
        .FirstOrDefault();

    string FormatEventDate(DateTimeOffset? value) => value.HasValue ? IstClock.ToIst(value.Value).ToString("dd MMM yyyy", CultureInfo.CurrentCulture) : "—";
    string FormatTimestamp(DateTimeOffset? value) => value.HasValue ? IstClock.ToIst(value.Value).ToString("dd MMM yyyy, HH:mm", CultureInfo.CurrentCulture) : "—";

    string FormatUser(string? displayName, string? userId)
    {
        if (!string.IsNullOrWhiteSpace(displayName)) return displayName;
        if (!string.IsNullOrWhiteSpace(userId)) return userId;
        return "Unknown";
    }

    string FormatFileSize(long bytes)
    {
        if (bytes <= 0) return "0 B";
        var sizes = new[] { "B", "KB", "MB", "GB" };
        var order = Math.Min((int)Math.Floor(Math.Log(bytes, 1024)), sizes.Length - 1);
        var value = bytes / Math.Pow(1024, order);
        return $"{value:0.#} {sizes[order]}";
    }

    string ResolveDeleteRequestStatus()
    {
        if (latestDeleteRequest is null) return "No delete request";
        if (latestDeleteRequest.ApprovedAtUtc.HasValue)
        {
            return $"Approved on {FormatTimestamp(latestDeleteRequest.ApprovedAtUtc)} by {FormatUser(latestDeleteRequest.ApprovedByUser?.FullName, latestDeleteRequest.ApprovedByUserId)}";
        }
        if (latestDeleteRequest.RejectedAtUtc.HasValue)
        {
            return $"Rejected on {FormatTimestamp(latestDeleteRequest.RejectedAtUtc)} by {FormatUser(latestDeleteRequest.RejectedByUser?.FullName, latestDeleteRequest.RejectedByUserId)}";
        }
        return $"Pending since {FormatTimestamp(latestDeleteRequest.RequestedAtUtc)} by {FormatUser(latestDeleteRequest.RequestedByUser?.FullName, latestDeleteRequest.RequestedByUserId)}";
    }

    var standardMaxMb = Model.MaxStandardAttachmentSizeBytes / (1024 * 1024);
    var videoMaxMb = Model.MaxVideoAttachmentSizeBytes / (1024 * 1024);
}

@section Styles {
    <link rel="stylesheet" href="~/css/activities/details.css" asp-append-version="true" />
}

<div class="container-xxl activities-details-page" data-module="activity-details">
    <nav aria-label="breadcrumb" class="activity-details-breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-page="/Activities/Index">Activities</a></li>
            <li class="breadcrumb-item active" aria-current="page">Details</li>
        </ol>
    </nav>

    <header class="activity-detail-hero">
        <div class="activity-detail-hero__main">
            <div class="activity-detail-hero__eyebrow">
                <span class="activity-detail-hero__type">@(activity.ActivityType?.Name ?? "Activity")</span>
                <span><i class="bi bi-calendar3" aria-hidden="true"></i>@FormatEventDate(activity.ScheduledStartUtc)</span>
                @if (!string.IsNullOrWhiteSpace(activity.Location))
                {
                    <span><i class="bi bi-geo-alt" aria-hidden="true"></i>@activity.Location</span>
                }
                @if (Model.Attachments.Count > 0)
                {
                    <a href="#activity-media" class="activity-detail-hero__media-link">
                        <i class="bi bi-paperclip" aria-hidden="true"></i>@Model.Attachments.Count supporting record@(Model.Attachments.Count == 1 ? string.Empty : "s")
                    </a>
                }
            </div>
            <h1>@activity.Title</h1>
        </div>

        <div class="activity-detail-hero__actions">
            @if (Model.HasPendingDelete)
            {
                <span class="activity-pending-delete" title="@ResolveDeleteRequestStatus()">
                    <i class="bi bi-hourglass-split" aria-hidden="true"></i>Deletion pending
                </span>
            }
            @if (Model.CanManage)
            {
                <a class="btn btn-outline-secondary btn-sm" asp-page="./Edit" asp-route-id="@activity.Id">
                    <i class="bi bi-pencil" aria-hidden="true"></i>Edit
                </a>
            }
            @if (Model.CanRequestDelete && !Model.HasPendingDelete)
            {
                <form method="post"
                      asp-page="./Index"
                      asp-page-handler="RequestDelete"
                      asp-route-id="@activity.Id"
                      class="d-inline"
                      data-activities-delete-form
                      data-confirm="Request deletion of this activity?">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-trash" aria-hidden="true"></i>Request delete
                    </button>
                </form>
            }
        </div>
    </header>

    <section class="activity-detail-card" aria-labelledby="activity-remarks-heading">
        <div class="activity-detail-card__header">
            <div>
                <span class="activity-detail-card__eyebrow">Activity record</span>
                <h2 id="activity-remarks-heading">Remarks / Brief</h2>
            </div>
        </div>
        <div class="activity-detail-card__body activity-detail-brief">
            @if (string.IsNullOrWhiteSpace(activity.Description))
            {
                <p class="activity-empty-copy mb-0">No remarks or brief recorded.</p>
            }
            else
            {
                <div class="pm-text-prewrap">@activity.Description</div>
            }
        </div>
    </section>

    <section class="activity-detail-card" id="activity-media" aria-labelledby="activity-media-heading">
        <div class="activity-detail-card__header activity-detail-card__header--media">
            <div>
                <span class="activity-detail-card__eyebrow">Evidence &amp; attachments</span>
                <h2 id="activity-media-heading">Media gallery</h2>
                <p>
                    @Model.Attachments.Count attachment@(Model.Attachments.Count == 1 ? string.Empty : "s")
                    @if (Model.Attachments.Count > 0)
                    {
                        <span>· @Model.PhotoAttachments.Count photo@(Model.PhotoAttachments.Count == 1 ? string.Empty : "s")</span>
                        @if (Model.VideoAttachments.Count > 0)
                        {
                            <span> · @Model.VideoAttachments.Count video@(Model.VideoAttachments.Count == 1 ? string.Empty : "s")</span>
                        }
                        @if (Model.DocumentAttachments.Count > 0)
                        {
                            <span> · @Model.DocumentAttachments.Count document@(Model.DocumentAttachments.Count == 1 ? string.Empty : "s")</span>
                        }
                    }
                </p>
            </div>
            @if (Model.CanManage)
            {
                <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#activityUploadPanel" aria-expanded="false" aria-controls="activityUploadPanel">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>Add media
                </button>
            }
        </div>

        <div class="activity-detail-card__body activity-media-body">
            @if (Model.CanManage)
            {
                <div class="collapse activity-upload-panel" id="activityUploadPanel">
                    <form method="post" asp-page-handler="Upload" asp-route-id="@activity.Id" enctype="multipart/form-data" class="activity-upload-form">
                        @Html.AntiForgeryToken()
                        <div class="flex-grow-1">
                            <label for="activityUploads" class="form-label fw-semibold">Add supporting files</label>
                            <input id="activityUploads"
                                   type="file"
                                   name="Uploads"
                                   multiple
                                   class="form-control"
                                   accept="application/pdf,application/msword,application/vnd.ms-excel,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,image/png,image/jpeg,video/mp4,video/quicktime,video/webm,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.png,.jpg,.jpeg,.mp4,.mov,.webm"
                                   data-activity-upload-input
                                   data-standard-max="@Model.MaxStandardAttachmentSizeBytes"
                                   data-video-max="@Model.MaxVideoAttachmentSizeBytes"
                               data-batch-max="@Model.MaxUploadBatchSizeBytes"
                                   data-max-files="@Model.RemainingAttachmentSlots"
                                   @(Model.RemainingAttachmentSlots <= 0 ? "disabled" : null) />
                            <div class="form-text">
                                Up to @Model.RemainingAttachmentSlots more files. Images/documents: @standardMaxMb MB each; videos: @videoMaxMb MB each. Maximum @Model.MaxAttachments attachments per activity.
                            </div>
                            <div class="text-danger small mt-1" data-activity-upload-error hidden></div>
                        </div>
                        <button type="submit" class="btn btn-primary align-self-lg-end" @(Model.RemainingAttachmentSlots <= 0 ? "disabled" : null)>
                            <i class="bi bi-upload" aria-hidden="true"></i>Upload
                        </button>
                    </form>
                </div>
            }

            @if (Model.Attachments.Count == 0)
            {
                <div class="activity-media-empty">
                    <i class="bi bi-paperclip" aria-hidden="true"></i>
                    <div>
                        <strong>No supporting records yet</strong>
                        <span>Photos, videos and documents added to this activity will appear here.</span>
                    </div>
                </div>
            }
            else
            {
                @if (Model.PhotoAttachments.Count > 0)
                {
                    <section class="activity-media-section" aria-labelledby="activity-photos-heading">
                        <div class="activity-media-section__heading">
                            <h3 id="activity-photos-heading">Photos</h3>
                            <span>@Model.PhotoAttachments.Count</span>
                        </div>
                        <div class="activity-photo-grid" data-activity-photo-gallery data-activity-title="@activity.Title">
                            @for (var index = 0; index < Model.PhotoAttachments.Count; index++)
                            {
                                var photo = Model.PhotoAttachments[index];
                                <article class="activity-photo-card">
                                    <a class="activity-photo-card__image"
                                       href="@photo.PreviewUrl"
                                       data-activity-photo-item
                                       data-index="@index"
                                       data-preview-url="@photo.PreviewUrl"
                                       data-original-url="@photo.OriginalUrl"
                                       data-file-name="@photo.FileName"
                                       aria-label="View photo @(index + 1) of @Model.PhotoAttachments.Count: @photo.FileName">
                                        <img src="@photo.ThumbnailUrl"
                                             alt="@photo.FileName"
                                             loading="lazy"
                                             decoding="async" />
                                        <span class="activity-photo-card__zoom" aria-hidden="true"><i class="bi bi-arrows-fullscreen"></i></span>
                                    </a>
                                    <div class="activity-photo-card__meta">
                                        <span class="activity-photo-card__name" title="@photo.FileName">@photo.FileName</span>
                                        <div class="activity-photo-card__actions">
                                            <a href="@photo.DownloadUrl" class="activity-icon-action" title="Download @photo.FileName" aria-label="Download @photo.FileName">
                                                <i class="bi bi-download" aria-hidden="true"></i>
                                            </a>
                                            @if (Model.CanManage)
                                            {
                                                <form method="post" asp-page-handler="RemoveAttachment" asp-route-id="@activity.Id" asp-route-attachmentId="@photo.Id" data-activities-delete-form data-confirm="Remove this attachment?">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="activity-icon-action activity-icon-action--danger" title="Remove @photo.FileName" aria-label="Remove @photo.FileName">
                                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }

                @if (Model.VideoAttachments.Count > 0)
                {
                    <section class="activity-media-section" aria-labelledby="activity-videos-heading">
                        <div class="activity-media-section__heading">
                            <h3 id="activity-videos-heading">Videos</h3>
                            <span>@Model.VideoAttachments.Count</span>
                        </div>
                        <div class="activity-video-grid">
                            @foreach (var video in Model.VideoAttachments)
                            {
                                <article class="activity-file-card activity-file-card--video">
                                    <div class="ratio ratio-16x9 activity-video-frame">
                                        <video controls preload="metadata">
                                            <source src="@video.InlineUrl" type="@video.ContentType" />
                                            Your browser does not support the video tag.
                                        </video>
                                    </div>
                                    <div class="activity-file-card__body">
                                        <div class="min-w-0">
                                            <strong title="@video.FileName">@video.FileName</strong>
                                            <span>@FormatFileSize(video.FileSize) · uploaded @FormatTimestamp(video.UploadedAtUtc)</span>
                                        </div>
                                        <div class="activity-file-card__actions">
                                            <a class="btn btn-sm btn-outline-secondary" href="@video.DownloadUrl"><i class="bi bi-download" aria-hidden="true"></i>Download</a>
                                            @if (Model.CanManage)
                                            {
                                                <form method="post" asp-page-handler="RemoveAttachment" asp-route-id="@activity.Id" asp-route-attachmentId="@video.Id" data-activities-delete-form data-confirm="Remove this attachment?">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }

                @if (Model.DocumentAttachments.Count > 0)
                {
                    <section class="activity-media-section" aria-labelledby="activity-documents-heading">
                        <div class="activity-media-section__heading">
                            <h3 id="activity-documents-heading">Documents</h3>
                            <span>@Model.DocumentAttachments.Count</span>
                        </div>
                        <div class="activity-document-list">
                            @foreach (var document in Model.DocumentAttachments)
                            {
                                <article class="activity-document-row">
                                    <div class="activity-document-row__icon" aria-hidden="true"><i class="bi bi-file-earmark-text"></i></div>
                                    <div class="activity-document-row__identity">
                                        <a href="@document.InlineUrl" target="_blank" rel="noopener">@document.FileName</a>
                                        <span>@FormatFileSize(document.FileSize) · uploaded @FormatTimestamp(document.UploadedAtUtc)</span>
                                    </div>
                                    <div class="activity-document-row__actions">
                                        <a class="btn btn-sm btn-outline-secondary" href="@document.DownloadUrl"><i class="bi bi-download" aria-hidden="true"></i>Download</a>
                                        @if (Model.CanManage)
                                        {
                                            <form method="post" asp-page-handler="RemoveAttachment" asp-route-id="@activity.Id" asp-route-attachmentId="@document.Id" data-activities-delete-form data-confirm="Remove this attachment?">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                            </form>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }

                @if (Model.OtherAttachments.Count > 0)
                {
                    <section class="activity-media-section" aria-labelledby="activity-other-heading">
                        <div class="activity-media-section__heading">
                            <h3 id="activity-other-heading">Other files</h3>
                            <span>@Model.OtherAttachments.Count</span>
                        </div>
                        <div class="activity-document-list">
                            @foreach (var file in Model.OtherAttachments)
                            {
                                <article class="activity-document-row">
                                    <div class="activity-document-row__icon" aria-hidden="true"><i class="bi bi-file-earmark"></i></div>
                                    <div class="activity-document-row__identity">
                                        <strong>@file.FileName</strong>
                                        <span>@FormatFileSize(file.FileSize) · uploaded @FormatTimestamp(file.UploadedAtUtc)</span>
                                    </div>
                                    <div class="activity-document-row__actions">
                                        <a class="btn btn-sm btn-outline-secondary" href="@file.DownloadUrl"><i class="bi bi-download" aria-hidden="true"></i>Download</a>
                                        @if (Model.CanManage)
                                        {
                                            <form method="post" asp-page-handler="RemoveAttachment" asp-route-id="@activity.Id" asp-route-attachmentId="@file.Id" data-activities-delete-form data-confirm="Remove this attachment?">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                            </form>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }
            }
        </div>
    </section>

    @if (Model.CanManage)
    {
        <section class="activity-detail-card activity-admin-card" aria-labelledby="activity-admin-heading">
            <div class="activity-detail-card__header">
                <div>
                    <span class="activity-detail-card__eyebrow">Audit trail</span>
                    <h2 id="activity-admin-heading">Admin details</h2>
                </div>
            </div>
            <div class="activity-detail-card__body">
                <dl class="activity-admin-grid mb-0">
                    <div><dt>Created by</dt><dd>@FormatUser(activity.CreatedByUser?.FullName, activity.CreatedByUserId)</dd></div>
                    <div><dt>Created date</dt><dd>@FormatTimestamp(activity.CreatedAtUtc)</dd></div>
                    <div>
                        <dt>Last updated</dt>
                        <dd>
                            @if (activity.LastModifiedAtUtc is { } updated)
                            {
                                @($"{FormatTimestamp(updated)} by {FormatUser(activity.LastModifiedByUser?.FullName, activity.LastModifiedByUserId)}")
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </dd>
                    </div>
                    <div><dt>Delete request</dt><dd class="@(Model.HasPendingDelete ? "text-warning-emphasis" : null)">@ResolveDeleteRequestStatus()</dd></div>
                </dl>
            </div>
        </section>
    }
</div>

@if (Model.PhotoAttachments.Count > 0)
{
    <div class="modal fade activity-photo-viewer" id="activityPhotoViewer" tabindex="-1" aria-hidden="true" data-activity-photo-viewer>
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content activity-photo-viewer__content">
                <header class="activity-photo-viewer__header">
                    <div class="activity-photo-viewer__identity">
                        <span class="activity-photo-viewer__eyebrow">Activity photo gallery</span>
                        <strong class="activity-photo-viewer__title" data-activity-viewer-title title="@activity.Title">@activity.Title</strong>
                    </div>
                    <div class="activity-photo-viewer__header-actions">
                        <span class="activity-photo-viewer__counter" data-activity-viewer-counter></span>
                        <button type="button" class="activity-photo-viewer__close" data-bs-dismiss="modal" aria-label="Close photo viewer"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                    </div>
                </header>
                <div class="activity-photo-viewer__body">
                    <button type="button" class="activity-photo-viewer__nav activity-photo-viewer__nav--previous" data-activity-viewer-previous aria-label="Previous photo"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
                    <div class="activity-photo-viewer__stage" data-activity-viewer-stage>
                        <div class="activity-photo-viewer__loading" data-activity-viewer-loading>Loading photo…</div>
                        <div class="activity-photo-viewer__error" data-activity-viewer-error hidden>Unable to load this photo.</div>
                        <img class="activity-photo-viewer__image" data-activity-viewer-image alt="" />
                    </div>
                    <button type="button" class="activity-photo-viewer__nav activity-photo-viewer__nav--next" data-activity-viewer-next aria-label="Next photo"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
                <footer class="activity-photo-viewer__footer">
                    <span class="activity-photo-viewer__file" data-activity-viewer-file></span>
                    <span class="activity-photo-viewer__hint">Use <kbd>←</kbd> <kbd>→</kbd> to browse · <kbd>Esc</kbd> to close</span>
                </footer>
            </div>
        </div>
    </div>
}

@await Html.PartialAsync("_DeleteConfirmModal")

@section Scripts {
    <script src="~/js/pages/activities-index.js" asp-append-version="true"></script>
    <script src="~/js/pages/activity-details.js" asp-append-version="true" defer></script>
}
