@page
@model ProjectManagement.Pages.Dashboard.IndexModel
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Globalization
@using System.Linq
@using System.Text.Json
@using ProjectManagement.Configuration
@{
    ViewData["Title"] = "Dashboard";
    ViewData["UseFullWidth"] = true;
    ViewData["PageShell"] = "wide";

    var pulse = Model.ProjectPulse;
    ProjectManagement.Areas.Dashboard.Components.ProjectPulse.OngoingBucketSetVm? totalBucket = null;
    if (pulse is not null && !pulse.OngoingBucketsByKey.TryGetValue("total", out totalBucket))
    {
        totalBucket = pulse.OngoingBucketsByKey.Values.FirstOrDefault();
    }

    var stageOrder = new[] { "FS", "IPA", "SOW", "AON", "BID", "TEC", "BM", "COB", "PNC", "SO", "DEVP", "ATP", "PAYMENT", "TOT" };
    var stageItems = pulse?.OngoingStageDistributionTotal.Items
        .Where(x => x.Count > 0)
        .OrderBy(x => { var i = Array.IndexOf(stageOrder, x.StageCode); return i < 0 ? int.MaxValue : i; })
        .ToList() ?? new List<ProjectManagement.Services.Analytics.StageDistributionItem>();
    var projectTypes = pulse?.OngoingBucketFilters
        .Where(x => !string.Equals(x.Key, "total", StringComparison.OrdinalIgnoreCase))
        .ToList() ?? new List<ProjectManagement.Areas.Dashboard.Components.ProjectPulse.OngoingBucketFilterVm>();
    var analytics = Model.Analytics;
    string AnalyticsTabUrl(string? tab) => (tab is null ? Url.Page("/Analytics/Index") : Url.Page("/Analytics/Index", new { tab })) ?? "#";
    string Count(int count, string noun) => count == 1 ? $"1 {noun}" : $"{count} {noun}s";
    var outputTiles = Model.OpsSignals.Tiles.ToList();
    var topFfcCountries = Model.FfcSimulatorMap.Countries
        .Where(x => x.TotalUnits > 0)
        .OrderByDescending(x => x.Completed)
        .ThenByDescending(x => x.Planned)
        .ThenBy(x => x.Name)
        .Take(5)
        .ToList();
    var ffcPayload = JsonSerializer.Serialize(
        Model.FfcSimulatorMap.Countries.Select(country => new
        {
            country.CountryId,
            country.Iso3,
            country.Name,
            country.Installed,
            country.Delivered,
            country.Planned,
            country.TotalUnits,
            DetailsUrl = Url.Page(
                "/FFC/MapTableDetailed",
                values: new { area = "ProjectOfficeReports", countryId = country.CountryId }) ?? "#"
        }),
        new JsonSerializerOptions(JsonSerializerDefaults.Web));
    var ffcGeoUrl = Url.Content("~/ffc/maps/world_india_view.geojson");
    var ffcPartnerCountryCount = Model.FfcSimulatorMap.Countries.Count(x => x.TotalUnits > 0);
    var canOpenOcrConsole = User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.HoD);
    var ocrPending = Model.SearchHealth.Ocr.Pending;
    var ocrFailed = Model.SearchHealth.Ocr.Failed;
    var ocrWorkerActive = Model.SearchHealth.WorkerActive;
    var processingState = ocrFailed > 0
        ? "failed"
        : ocrPending > 0 && !ocrWorkerActive
            ? "attention"
            : ocrWorkerActive
                ? "processing"
                : "idle";
    var processingTitle = processingState switch
    {
        "failed" => "Document processing requires attention",
        "attention" => "Document processing is waiting",
        "processing" => "Document processing in progress",
        _ => "Document processing is idle"
    };
    var processingBadge = processingState switch
    {
        "failed" => "Failures detected",
        "attention" => "Queue waiting",
        "processing" => "Processing",
        _ => "Standby"
    };
    var processingDescription = processingState switch
    {
        "failed" => "One or more OCR jobs failed and should be reviewed.",
        "attention" => "Documents are pending while the OCR worker is not active.",
        "processing" => "The OCR worker is currently processing or has been active recently.",
        _ => "No documents are waiting. The OCR worker is at rest and searchable documents remain available."
    };
    string Json<T>(IEnumerable<T>? values) => JsonSerializer.Serialize(values ?? Array.Empty<T>());
    string OngoingStageUrl(string stageCode) => Url.Page("/Projects/Ongoing/Index", new { PresentStageCode = stageCode }) ?? (pulse?.OngoingUrl ?? "#");
    string StageDisplayLabel(string stageCode) => stageCode.ToUpperInvariant() switch
    {
        "PAYMENT" or "PAYMENT1" => "Payment",
        "DEVP" => "DEVP",
        _ => stageCode
    };
    string OngoingBucketUrl(string bucket) => Url.Page("/Projects/Ongoing/Index", new { StageBucket = bucket }) ?? (pulse?.OngoingUrl ?? "#");
    string OngoingCategoryUrl(string key)
    {
        if (key.StartsWith("cat-", StringComparison.OrdinalIgnoreCase) && int.TryParse(key[4..], out var categoryId))
        {
            return Url.Page("/Projects/Ongoing/Index", new { ProjectCategoryId = categoryId }) ?? (pulse?.OngoingUrl ?? "#");
        }
        return pulse?.OngoingUrl ?? "#";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/leaflet/1.9.4/leaflet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/widgets/ffc-simulator-map.css" asp-append-version="true" />
}

@if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
{
    <div class="alert alert-warning py-2 mb-3"><i class="bi bi-exclamation-triangle-fill me-2"></i>@err</div>
}

<div class="db-page" data-dashboard>
    <header class="db-header db-reveal">
        <div class="db-header__title" title="Loaded @Model.DashboardLoadedAtIst.ToString("dd MMM yyyy, HH:mm") IST">
            <h1>Dashboard</h1>
            <span class="db-header__date">@Model.DashboardLoadedAtIst.ToString("dddd, d MMMM yyyy", CultureInfo.InvariantCulture)</span>
        </div>
    </header>

    <main class="db-sections">
        <div class="db-top-grid">
            @* Left column: the ongoing portfolio, then the completed one. Right column: the Analytics card. *@
            <div class="db-top-stack">
            <section class="db-panel db-hue-5 db-reveal" aria-labelledby="portfolio-pulse-title">
                <div class="db-section-head">
                    <div>
                        <span class="db-section-icon"><i class="bi bi-activity"></i></span>
                        <div><h2 id="portfolio-pulse-title">Portfolio pulse (all ongoing IR&amp;D projects)</h2></div>
                    </div>
                    @* Classification pills: every ongoing project, then one pill per parent category. Each opens its ongoing list. *@
                    @if (pulse is not null)
                    {
                        <div class="db-head-pills" role="list" aria-label="Ongoing projects by classification">
                            <a class="db-stage db-stage--pill" href="@pulse.OngoingUrl" role="listitem" title="View all ongoing projects"><span>All</span><strong>@pulse.OngoingCount</strong></a>
                            @foreach (var item in projectTypes)
                            {
                                <a class="db-stage db-stage--pill" href="@OngoingCategoryUrl(item.Key)" role="listitem" title="View ongoing @item.Label"><span>@item.Label</span><strong>@item.Count</strong></a>
                            }
                        </div>
                    }
                </div>

                @if (pulse is not null)
                {
                    <div class="db-pulse-layout">
                        <article class="db-pulse-block db-pulse-block--lifecycle">
                            <div class="db-block-heading"><h3>Lifecycle distribution</h3><span>@pulse.OngoingCount total</span></div>
                            @{
                                var bucketTotal = Math.Max(1, totalBucket?.Total ?? 0);
                                // One hue, four steps: each later bucket is a lighter tint of the card's colour.
                                var lifecycleItems = new[]
                                {
                                    (Label: "Approval", Count: totalBucket?.Apvl ?? 0, Bucket: "approval", Opacity: "1"),
                                    (Label: "AoN", Count: totalBucket?.Aon ?? 0, Bucket: "aon", Opacity: ".72"),
                                    (Label: "Tendering", Count: totalBucket?.Tender ?? 0, Bucket: "procurement", Opacity: ".48"),
                                    (Label: "Development", Count: totalBucket?.Devp ?? 0, Bucket: "development", Opacity: ".28")
                                };
                            }
                            <div class="db-lifecycle">
                                <div class="db-lifecycle__bar" aria-hidden="true">
                                    @foreach (var item in lifecycleItems)
                                    {
                                        <i style="--seg-share:@item.Count;--seg-opacity:@item.Opacity"></i>
                                    }
                                </div>
                                <div class="db-lifecycle__stats" role="list" aria-label="Ongoing projects by lifecycle bucket">
                                    @foreach (var item in lifecycleItems)
                                    {
                                        var pct = (int)Math.Round(item.Count * 100d / bucketTotal);
                                        <a class="db-lifecycle__segment" style="--seg-opacity:@item.Opacity" href="@OngoingBucketUrl(item.Bucket)" role="listitem" aria-label="@item.Label: @item.Count projects, @pct percent">
                                            <span>@item.Label</span><strong>@item.Count<small>@pct%</small></strong>
                                        </a>
                                    }
                                </div>
                            </div>
                        </article>

                        <article class="db-pulse-block db-pulse-block--stages">
                            <div class="db-block-heading"><h3>Stage distribution</h3><span>Active portfolio</span></div>
                            <div class="db-stage-grid" role="list">
                                @foreach (var stage in stageItems)
                                {
                                    <a href="@OngoingStageUrl(stage.StageCode)" class="db-stage" role="listitem" title="View projects at @stage.StageName"><span>@StageDisplayLabel(stage.StageCode)</span><strong>@stage.Count</strong></a>
                                }
                            </div>
                        </article>
                    </div>
                }
                else
                {
                    <div class="db-empty">Portfolio data is temporarily unavailable.</div>
                }
            </section>

            @* Completed projects: the figures and the last ten years, from the Completed analytics; the proliferation count from the pulse. *@
            @{
                var done = analytics?.Completed;
                var doneTotal = done?.Total ?? pulse?.CompletedCount;
            }
            @if (doneTotal is not null)
            {
                var yearMax = Math.Max(1, done is null || done.LastYears.Count == 0 ? 1 : done.LastYears.Max(point => point.Count));
                <section class="db-panel db-hue-6 db-reveal db-completed" aria-labelledby="completed-title">
                    <a class="db-completed__figures" href="@AnalyticsTabUrl("Completed")">
                        <h2 id="completed-title">Completed projects</h2>
                        <p>
                            <span><strong>@doneTotal</strong> all time</span>
                            @if (done is not null)
                            {
                                <span><strong>@done.ThisYear</strong> in @done.Year</span>
                                @if (done.RecentAverage is { } average)
                                {
                                    <span><strong>@average.PerYear.ToString("0.0", CultureInfo.InvariantCulture)</strong> a year, @(average.Years == 1 ? average.ToYear.ToString() : $"{average.FromYear} to {average.ToYear}")</span>
                                }
                            }
                        </p>
                        @* How the all-time total splits: first builds, and rebuilds of an earlier project. *@
                        @if (pulse is not null)
                        {
                            <p class="db-completed__split">
                                <span><strong>@pulse.CompletedUniqueCount</strong> original</span>
                                <span><strong>@pulse.CompletedRebuildCount</strong> rebuild</span>
                            </p>
                        }
                    </a>
                    @if (pulse is not null && pulse.ProliferationEligible > 0)
                    {
                        <a href="@pulse.ProliferationEligibleUrl" class="db-text-link db-completed__more">@Count(pulse.ProliferationEligible, "project") ready for proliferation <i class="bi bi-arrow-right"></i></a>
                    }
                    @if (done is not null && done.LastYears.Count > 0)
                    {
                        <a class="db-completed__chart" href="@AnalyticsTabUrl("Completed")" aria-label="Projects completed per year, @done.LastYears[0].Year to @done.Year: open the Completed analytics">
                            <span class="db-completed__bars" aria-hidden="true">
                                @foreach (var point in done.LastYears)
                                {
                                    var barHeight = point.Count * 100d / yearMax;
                                    <span class="db-completed__year @(point.Year == done.Year ? "is-current" : "")" title="@point.Year: @point.Count completed">
                                        <em>@point.Count</em>
                                        <i style="--bar-h:@barHeight.ToString("0.##", CultureInfo.InvariantCulture)"></i>
                                    </span>
                                }
                            </span>
                            <span class="db-completed__axis" aria-hidden="true"><span>@done.LastYears[0].Year</span><span>Completed per year</span><span>@done.Year</span></span>
                        </a>
                    }
                </section>
            }
            </div>

            @* Analytics card: a few figures from each Analytics mode (DashboardAnalyticsService); every block opens its mode. *@
            <section class="db-panel db-hue-6 db-reveal db-analytics-card" aria-labelledby="analytics-title">
                <div class="db-section-head db-section-head--compact">
                    <div>
                        <span class="db-section-icon"><i class="bi bi-graph-up-arrow"></i></span>
                        <div><h2 id="analytics-title">Analytics</h2></div>
                    </div>
                    <a href="@AnalyticsTabUrl(null)" class="db-text-link">Open analytics <i class="bi bi-arrow-right"></i></a>
                </div>
                @if (analytics is null || !analytics.HasAnything)
                {
                    <div class="db-empty">Analytics figures are temporarily unavailable.</div>
                }
                else
                {
                    <div class="db-analytics">
                        @if (analytics.Arpp is { } arpp)
                        {
                            var arppSegments = new[]
                            {
                                (Label: "Completed", Count: arpp.CompletedCount, Opacity: "1"),
                                (Label: "SO placed", Count: arpp.SupplyOrderCount, Opacity: ".72"),
                                (Label: "AoN to SO", Count: arpp.AonToSupplyOrderCount, Opacity: ".48"),
                                (Label: "Pre-AoN", Count: arpp.PreAonCount, Opacity: ".28")
                            };
                            var arppNotes = new List<string> { $"New {arpp.NewCount}", $"CL {arpp.CommittedLiabilityCount}", $"CF {arpp.CarryForwardCount}" };
                            if (arpp.NotKnownCount > 0) { arppNotes.Add($"{arpp.NotKnownCount} not known"); }
                            <a class="db-analytics__block" href="@AnalyticsTabUrl("Arpp")" aria-label="ARPP FY @arpp.FinancialYearDisplay: open the ARPP analytics">
                                <div class="db-block-heading">
                                    <h3>ARPP FY @arpp.FinancialYearDisplay</h3>
                                    <span>@arpp.ListedCount listed · IPA @arpp.ListedIpaDisplay@(arpp.AsOfDate is { } asOf ? $" · on {asOf:d MMM yyyy}" : "")</span>
                                </div>
                                <div class="db-lifecycle">
                                    <div class="db-lifecycle__bar" aria-hidden="true">
                                        @foreach (var item in arppSegments)
                                        {
                                            <i style="--seg-share:@item.Count;--seg-opacity:@item.Opacity"></i>
                                        }
                                    </div>
                                    <div class="db-lifecycle__stats">
                                        @foreach (var item in arppSegments)
                                        {
                                            <div class="db-lifecycle__segment" style="--seg-opacity:@item.Opacity"><span>@item.Label</span><strong>@item.Count</strong></div>
                                        }
                                    </div>
                                </div>
                                <p class="db-analytics__note">@string.Join(" · ", arppNotes)</p>
                            </a>
                        }

                        @if (analytics.Coe is { } coe)
                        {
                            var coeMax = Math.Max(1, coe.Subcategories.Count == 0 ? 1 : coe.Subcategories.Max(row => row.Total));
                            <a class="db-analytics__block" href="@AnalyticsTabUrl("Coe")" aria-label="CoE (AR/VR): open the CoE analytics">
                                <div class="db-block-heading">
                                    <h3>CoE (AR/VR)</h3>
                                    <span>@Count(coe.Total, "project") · @coe.Ongoing ongoing · @coe.Completed completed</span>
                                </div>
                                @if (coe.Subcategories.Count > 0)
                                {
                                    <div class="db-coe-rows">
                                        @foreach (var row in coe.Subcategories)
                                        {
                                            <div class="db-coe-row" title="@row.Name: @row.Ongoing ongoing, @row.Completed completed, @row.Cancelled cancelled">
                                                <span>@row.Name</span>
                                                <div class="db-coe-row__bar" aria-hidden="true">
                                                    @if (row.Ongoing > 0) { <i class="is-ongoing" style="--seg-share:@row.Ongoing"></i> }
                                                    @if (row.Completed > 0) { <i class="is-completed" style="--seg-share:@row.Completed"></i> }
                                                    @if (row.Cancelled > 0) { <i class="is-cancelled" style="--seg-share:@row.Cancelled"></i> }
                                                    @if (coeMax > row.Total) { <i class="is-rest" style="--seg-share:@(coeMax - row.Total)"></i> }
                                                </div>
                                                <strong>@row.Total</strong>
                                            </div>
                                        }
                                    </div>
                                    <p class="db-analytics__note db-coe-key">
                                        <span class="is-ongoing">Ongoing</span>
                                        <span class="is-completed">Completed</span>
                                        @if (coe.Cancelled > 0) { <span class="is-cancelled">Cancelled</span> }
                                        @if (coe.HasMoreSubcategories) { <em>+ more in Analytics</em> }
                                    </p>
                                }
                            </a>
                        }

                        @if (analytics.SlowestStages.Count > 0)
                        {
                            <a class="db-analytics__block db-analytics__block--slow" href="@AnalyticsTabUrl("Insights")" aria-label="Slowest stages: open the Insights analytics">
                                <div class="db-block-heading"><h3>Slowest stages</h3><span title="Each figure is the stage's median days, then its ratio to the portfolio median">Median days</span></div>
                                <ol class="db-slow-stages">
                                    @foreach (var stage in analytics.SlowestStages)
                                    {
                                        var ratio = stage.RatioToPortfolioMedian >= 10 ? stage.RatioToPortfolioMedian.ToString("0", CultureInfo.InvariantCulture) : stage.RatioToPortfolioMedian.ToString("0.0", CultureInfo.InvariantCulture);
                                        <li><span>@stage.StageName</span><strong>@stage.MedianDays<small>@(ratio)×</small></strong></li>
                                    }
                                </ol>
                            </a>
                        }
                    </div>
                }
            </section>
        </div>

        <section class="db-panel db-hue-4 db-reveal" aria-labelledby="outputs-title">
            <div class="db-section-head">
                <div>
                    <span class="db-section-icon"><i class="bi bi-bar-chart-line"></i></span>
                    <div><h2 id="outputs-title">Institutional outputs</h2><p>Key institutional results with a 12-month activity view</p></div>
                </div>
            </div>
            <div class="db-output-grid">
                @foreach (var tile in outputTiles)
                {
                    var values = tile.Sparkline ?? Array.Empty<int>();
                    var labels = tile.SparklineLabels ?? Array.Empty<string>();
                    var hasRecentActivity = values.Any(v => v > 0);
                    <a class="db-output-card" href="@tile.LinkUrl">
                        <div class="db-output-card__head"><span class="db-output-card__icon"><i class="bi @tile.Icon"></i></span><span class="db-output-card__label">@tile.Label</span></div>
                        <div class="db-output-card__metrics @(tile.SecondaryValue.HasValue ? "has-secondary" : "")">
                            <div class="db-output-card__metric" title="@tile.Caption">
                                <strong>@tile.Value.ToString("N0")</strong>
                                @if (!string.IsNullOrWhiteSpace(tile.Unit))
                                {
                                    <span>@tile.Unit</span>
                                }
                            </div>
                            @if (tile.SecondaryValue.HasValue)
                            {
                                <div class="db-output-card__secondary">
                                    <strong>@tile.SecondaryValue.Value.ToString("N0")</strong>
                                    <span>@tile.SecondaryLabel</span>
                                </div>
                            }
                        </div>
                        @* The headline is a total since records began (tile.Caption, in its tooltip); the chart is 12 months. *@
                        <div class="db-output-card__chart @(hasRecentActivity ? "" : "is-empty")" data-db-spark data-values='@Html.Raw(Json(values))' data-labels='@Html.Raw(Json(labels))'>
                            <canvas role="img" aria-label="@tile.Label monthly activity over the last 12 months"></canvas>
                            @if (!hasRecentActivity)
                            {
                                <span class="db-chart-empty">No activity in the last 12 months</span>
                            }
                        </div>
                        <div class="db-output-card__foot">
                            <span>@(string.IsNullOrWhiteSpace(tile.TrendLabel) ? "Monthly activity · 12 months" : tile.TrendLabel)</span>
                            @* The change compares the last three months with the three before; the basis and the months are in the tooltip. *@
                            <span class="db-output-card__delta" title="@(string.Join(" \u00b7 ", new[] { tile.DeltaBasis, tile.DeltaPeriods }.Where(x => !string.IsNullOrWhiteSpace(x))))">
                                @if (tile.DeltaPct is not null)
                                {
                                    var deltaUp = tile.DeltaPct >= 0;
                                    <em class="@(deltaUp ? "is-up" : "is-down")"><i class="bi @(deltaUp ? "bi-arrow-up" : "bi-arrow-down")"></i>@string.Format("{0:+0;-0;0}%", Math.Round((tile.DeltaPct ?? 0) * 100))</em>
                                }
                                else if (!string.IsNullOrWhiteSpace(tile.DeltaLabel))
                                {
                                    <em class="is-neutral">@tile.DeltaLabel</em>
                                }
                                else
                                {
                                    <em class="is-neutral">No change</em>
                                }
                            </span>
                        </div>
                    </a>
                }
            </div>
        </section>

        @* Three slim cards: a few figures each. Like the output tiles above, the whole card is the link to its module. *@
        <section class="db-trio-grid db-reveal" aria-label="Activities, ideas and IT, MOLTI and SRE projects">
            <a asp-page="/Activities/Index" class="db-panel db-hue-4 db-slim" title="View activities">
                <div class="db-section-head">
                    <div><span class="db-section-icon"><i class="bi bi-people"></i></span><div><h2>Institutional activities</h2><p>Last 12 months</p></div></div>
                </div>
                @if (Model.ActivitySummary.TopTypes.Count > 0)
                {
                    <div class="db-figures">
                        @foreach (var type in Model.ActivitySummary.TopTypes)
                        {
                            <div class="db-figure"><strong>@type.Count</strong><span>@type.Name</span></div>
                        }
                    </div>
                }
                else
                {
                    <div class="db-empty db-empty--slim">No activities in the last 12 months.</div>
                }
            </a>

            <a asp-page="/ProjectIdeas/Index" class="db-panel db-hue-6 db-slim" title="Open the ideation board">
                <div class="db-section-head">
                    <div><span class="db-section-icon"><i class="bi bi-lightbulb"></i></span><div><h2>Innovation pipeline</h2></div></div>
                </div>
                <div class="db-figures">
                    <div class="db-figure"><strong>@Model.IdeaSummary.ActiveCount</strong><span>Active ideas</span></div>
                    <div class="db-figure"><strong>@Model.IdeaSummary.OnHoldCount</strong><span>On hold</span></div>
                </div>
            </a>

            @foreach (var module in Model.ModuleProjects)
            {
                var moduleIcon = module.Module switch
                {
                    ProjectManagement.Models.ItProjects.ItProjectModules.Molti => "bi-clipboard-check",
                    ProjectManagement.Models.ItProjects.ItProjectModules.Sre => "bi-clipboard-pulse",
                    _ => "bi-pc-display"
                };
                <a asp-page="@module.Page" class="db-panel db-hue-5 db-slim db-slim--module" title="Open @module.Name">
                    <div class="db-section-head">
                        <div><span class="db-section-icon"><i class="bi @moduleIcon"></i></span><div><h2>@module.Name</h2><p>FY @module.FinancialYearDisplay</p></div></div>
                    </div>
                    <div class="db-figures">
                        <div class="db-figure"><strong>@module.Listed</strong><span>Listed</span></div>
                        <div class="db-figure"><strong>@module.Completed</strong><span>Completed</span></div>
                        <div class="db-figure"><strong>@module.Ongoing</strong><span>Ongoing</span></div>
                    </div>
                </a>
            }
        </section>

        <section class="db-panel db-hue-5 db-ffc-panel db-reveal" aria-labelledby="ffc-title" data-ffc-map-scope>
            <div class="db-section-head">
                <div><span class="db-section-icon"><i class="bi bi-globe-asia-australia"></i></span><div><h2 id="ffc-title">Simulator footprint across FFCs</h2><p>Completed and planned units by partner country</p></div></div>
                <nav class="db-ffc-module-actions" aria-label="FFC module navigation">
                    <a asp-area="ProjectOfficeReports"
                       asp-page="/FFC/Index"
                       class="db-text-link db-ffc-module-actions__primary">
                        Open FFC portfolio <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </a>
                    <div class="dropdown">
                        <button type="button"
                                class="db-ffc-module-actions__more"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="true"
                                aria-label="More FFC navigation options"
                                aria-expanded="false">
                            <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end db-ffc-nav-menu">
                            <li>
                                <a asp-area="ProjectOfficeReports"
                                   asp-page="/FFC/Map"
                                   class="dropdown-item">
                                    <i class="bi bi-globe2" aria-hidden="true"></i>
                                    <span>Full map</span>
                                </a>
                            </li>
                            <li>
                                <a asp-area="ProjectOfficeReports"
                                   asp-page="/FFC/MapTableDetailed"
                                   class="dropdown-item">
                                    <i class="bi bi-table" aria-hidden="true"></i>
                                    <span>Detailed table</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
            @if (Model.FfcSimulatorMap.HasData)
            {
                <div class="db-ffc-layout">
                    <div class="db-ffc-map-wrap">
                        <div class="ffc-simulator-map db-ffc-map"
                             data-widget="ffc-simulator-map"
                             data-countries="@ffcPayload"
                             data-geo-url="@ffcGeoUrl"
                             data-focus-bounds="30,-20|-36,125"
                             data-auto-fit="true"
                             data-auto-fit-max-zoom="4"
                             data-zoom-snap="0.25"
                             data-deconflict-markers="true"
                             data-highlight-color="var(--db-primary)">
                            <div class="ffc-simulator-map__canvas"
                                 role="region"
                                 aria-label="Interactive map showing completed and planned simulator units across Friendly Foreign Countries"
                                 aria-describedby="ffc-map-legend"></div>
                            <div class="ffc-simulator-map__status" data-map-status>Loading footprint…</div>
                        </div>
                        <div id="ffc-map-legend" class="db-ffc-legend" aria-label="Map legend">
                            <span><i class="is-completed"></i>Blue number: completed units</span>
                            <span><i class="is-mixed"></i>Amber badge: additional planned units</span>
                            <span><i class="is-planned"></i>Amber marker: planned-only units</span>
                        </div>
                    </div>
                    <aside class="db-ffc-insights" aria-label="FFC simulator footprint summary">
                        <div class="db-ffc-primary-stats">
                            <div>
                                <span>Partner countries</span>
                                <strong>@ffcPartnerCountryCount</strong>
                            </div>
                            <div>
                                <span>Completed units <i class="bi bi-info-circle" title="Installed units plus units delivered and awaiting installation"></i></span>
                                <strong>@Model.FfcSimulatorMap.TotalCompleted</strong>
                            </div>
                            <div class="is-planned">
                                <span>Planned units <i class="bi bi-info-circle" title="Approved or recorded future units not yet completed"></i></span>
                                <strong>@Model.FfcSimulatorMap.TotalPlanned</strong>
                            </div>
                        </div>
                        <div class="db-ffc-breakdown" aria-label="Completed unit breakdown">
                            <span>Completed breakdown</span>
                            <p>
                                <strong>@Model.FfcSimulatorMap.TotalInstalled</strong> installed
                                <i aria-hidden="true">·</i>
                                <strong>@Model.FfcSimulatorMap.TotalDelivered</strong> awaiting installation
                            </p>
                        </div>
                        <div class="db-ffc-countries">
                            <h3>Top countries by completed units</h3>
                            @foreach (var country in topFfcCountries)
                            {
                                <a asp-area="ProjectOfficeReports"
                                   asp-page="/FFC/MapTableDetailed"
                                   asp-route-countryId="@country.CountryId"
                                   data-country-chip="@country.Iso3"
                                   class="db-country-row"
                                   aria-label="Open FFC projects for @country.Name: @country.Completed completed and @country.Planned planned units">
                                    <span class="db-country-row__name">@country.Name</span>
                                    <span class="db-country-row__metrics">
                                        <span><strong>@country.Completed</strong> completed</span>
                                        @if (country.Planned > 0)
                                        {
                                            <em>+@country.Planned planned</em>
                                        }
                                    </span>
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            }
                        </div>
                    </aside>
                </div>
            }
            else { <div class="db-empty">FFC project unit data is not available right now.</div> }
        </section>

        <section class="db-processing-alert db-panel db-reveal is-@processingState" aria-labelledby="document-processing-title">
            <div class="db-processing-alert__identity">
                <span class="db-utility-card__icon" aria-hidden="true">
                    <i class="bi @(processingState == "failed" ? "bi-x-octagon" : processingState == "attention" ? "bi-hourglass-split" : processingState == "processing" ? "bi-arrow-repeat" : "bi-pause-circle")"></i>
                </span>
                <div>
                    <div class="db-processing-title-row">
                        <h2 id="document-processing-title">@processingTitle</h2>
                        <span class="db-status-badge">@processingBadge</span>
                    </div>
                    <p>@processingDescription</p>
                </div>
            </div>
            <div class="db-processing-metrics" aria-label="Document processing metrics">
                <div><span>OCR worker</span><strong class="is-@processingState">@(ocrWorkerActive ? "Active" : processingState == "idle" ? "At rest" : "Inactive")</strong></div>
                <div><span>Pending</span><strong>@ocrPending <small>documents</small></strong></div>
                <div><span>Failed</span><strong class="@(ocrFailed > 0 ? "is-failed" : "")">@ocrFailed <small>documents</small></strong></div>
                <div><span>Searchable</span><strong>@Model.SearchHealth.TotalSearchable.ToString("N0") <small>documents</small></strong></div>
            </div>
            @if (canOpenOcrConsole)
            {
                <a asp-area="DocumentRepository" asp-page="/Admin/OCRFailures/OcrFailures" class="db-processing-action">View processing status <i class="bi bi-arrow-right"></i></a>
            }
            else if (processingState is "failed" or "attention")
            {
                <span class="db-processing-note">Administrator review may be required.</span>
            }
        </section>
    </main>

    <footer class="db-footer db-footer--timezone"><span>All times shown in IST</span></footer>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.js" asp-append-version="true"></script>
    <script src="~/js/pages/dashboard.js" asp-append-version="true"></script>
    <script src="~/lib/leaflet/1.9.4/leaflet.js" asp-append-version="true"></script>
    <script src="~/js/widgets/ffc-simulator-map.js" asp-append-version="true"></script>
}
