@model ProjectManagement.Pages.IndustryPartners.IndexModel
@using ProjectManagement.Pages.IndustryPartners
@{
    var hasSearch = !string.IsNullOrWhiteSpace(Model.Q);
    var emptyTitle = "No organisations in the directory";
    var emptyMessage = "Add an organisation when its contact details or JDP association need to be retained.";
    var emptyIcon = "bi-building";
    var showAddAction = Model.Filter == "all";
    var showViewAllAction = false;

    if (hasSearch)
    {
        emptyTitle = "No matching organisations";
        emptyMessage = "Try another organisation, contact, phone number, email address or project reference.";
        emptyIcon = "bi-search";
        showAddAction = false;
    }
    else
    {
        switch (Model.Filter)
        {
            case "contact":
                emptyTitle = "No contact-only organisations";
                emptyMessage = "Every organisation in the directory currently has a JDP association.";
                emptyIcon = "bi-person-check";
                showAddAction = false;
                showViewAllAction = true;
                break;

            case "associated":
                emptyTitle = "No JDPs recorded";
                emptyMessage = "No organisation is currently linked to a project as Joint Development Partner.";
                emptyIcon = "bi-link-45deg";
                showAddAction = false;
                showViewAllAction = true;
                break;

            case "current":
                emptyTitle = "No current JDPs";
                emptyMessage = "No organisation is presently associated with an ongoing project.";
                emptyIcon = "bi-play-circle";
                showAddAction = false;
                showViewAllAction = true;
                break;

            case "past":
                emptyTitle = "No past JDPs";
                emptyMessage = "No organisation is associated with a completed, cancelled or archived project.";
                emptyIcon = "bi-clock-history";
                showAddAction = false;
                showViewAllAction = true;
                break;
        }
    }
}

@if (Model.SearchResult.Items.Count == 0)
{
    <div class="ip-directory-empty">
        <div class="ip-empty-icon"><i class="bi @emptyIcon" aria-hidden="true"></i></div>
        <h2>@emptyTitle</h2>
        <p>@emptyMessage</p>

        @if (hasSearch)
        {
            <a asp-page="./Index"
               asp-route-filter="@Model.Filter"
               asp-route-projectId="@Model.ContextProjectId"
               class="btn btn-outline-secondary btn-sm">Clear search</a>
        }
        else if (showViewAllAction)
        {
            <a asp-page="./Index"
               asp-route-filter="all"
               asp-route-projectId="@Model.ContextProjectId"
               class="btn btn-outline-secondary btn-sm">View all organisations</a>
        }
        else if (showAddAction && Model.CanCreateOrganisation)
        {
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addOrganisationModal">Add organisation</button>
        }
    </div>
}
else
{
    <div class="ip-directory-table-wrap">
        <table class="table ip-directory-table align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Organisation</th>
                    <th scope="col">Primary contact</th>
                    <th scope="col">Phone</th>
                    <th scope="col">Email</th>
                    <th scope="col">JDP</th>
                    <th scope="col"><span class="visually-hidden">Open</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.SearchResult.Items)
                {
                    var detailUrl = Model.BuildDirectoryUrl(item.Id, Model.ProjectContext is null ? "overview" : "projects");
                    var hasPhone = !string.IsNullOrWhiteSpace(item.ContactPhone);
                    var hasEmail = !string.IsNullOrWhiteSpace(item.ContactEmail);
                    <tr class="ip-directory-row">
                        <td class="ip-cell-org">
                            <div class="ip-organisation-cell">
                                <div class="ip-org-avatar @IndustryPartnerAvatar.ToneClass(item.Name)" aria-hidden="true">@IndustryPartnerAvatar.Initials(item.Name)</div>
                                <div class="min-w-0">
                                    <a href="@detailUrl" class="ip-organisation-link">@item.Name</a>
                                    <div class="ip-row-meta">
                                        <i class="bi bi-geo-alt" aria-hidden="true"></i>
                                        <span>@(string.IsNullOrWhiteSpace(item.Location) ? "Location not added" : item.Location)</span>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="ip-cell-person">
                            @if (item.ContactCount == 0)
                            {
                                <span class="ip-empty-value">No contact yet</span>
                            }
                            else
                            {
                                <span class="ip-contact-name"><i class="bi bi-person ip-mobile-only" aria-hidden="true"></i>@(string.IsNullOrWhiteSpace(item.PrimaryContactName) ? "General contact" : item.PrimaryContactName)</span>
                            }
                        </td>
                        <td class="ip-cell-phone">
                            @if (hasPhone)
                            {
                                <span class="ip-copy-line">
                                    <a href="tel:@item.ContactPhone" class="ip-contact-value">@item.ContactPhone</a>
                                    <button type="button" class="ip-copy" data-copy-value="@item.ContactPhone" aria-label="Copy phone number for @item.Name" title="Copy phone number">
                                        <i class="bi bi-copy" aria-hidden="true"></i>
                                    </button>
                                </span>
                            }
                            else
                            {
                                <span class="ip-empty-value" aria-label="No phone">—</span>
                            }
                        </td>
                        <td class="ip-cell-email">
                            @if (hasEmail)
                            {
                                <span class="ip-copy-line">
                                    <a href="mailto:@item.ContactEmail" class="ip-contact-value ip-truncate" title="@item.ContactEmail">@item.ContactEmail</a>
                                    <button type="button" class="ip-copy" data-copy-value="@item.ContactEmail" aria-label="Copy email address for @item.Name" title="Copy email address">
                                        <i class="bi bi-copy" aria-hidden="true"></i>
                                    </button>
                                </span>
                            }
                            else
                            {
                                <span class="ip-empty-value" aria-label="No email">—</span>
                            }
                        </td>
                        <td class="ip-cell-jdp">
                            @if (item.ProjectCount == 0)
                            {
                                <span class="ip-empty-value" aria-label="No JDP projects">—</span>
                            }
                            else
                            {
                                <span class="ip-jdp-marker" title="@item.StatusLabel">
                                    <span class="ip-jdp-dot @(item.ActiveProjectCount > 0 ? "is-current" : null)" aria-hidden="true"></span>
                                    @item.ProjectCount @(item.ProjectCount == 1 ? "project" : "projects")@(item.ActiveProjectCount > 0 ? " · current" : null)
                                </span>
                            }
                        </td>
                        <td class="ip-cell-open">
                            <a href="@detailUrl" class="ip-row-open" aria-label="Open @item.Name">
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="ip-copy-status visually-hidden" aria-live="polite" data-copy-status></div>

    <nav class="ip-pagination" aria-label="Directory pages">
        @{
            var firstShown = (Model.SearchResult.Page - 1) * Model.SearchResult.PageSize + 1;
            var lastShown = firstShown + Model.SearchResult.Items.Count - 1;
        }
        <span>Showing @firstShown–@lastShown of @Model.SearchResult.Total</span>
        @if (Model.SearchResult.TotalPages > 1)
        {
            <div class="ip-pager">
                @if (Model.SearchResult.HasPrevious)
                {
                    <a href="@Model.BuildPageUrl(Model.SearchResult.Page - 1)" aria-label="Previous page"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
                }
                else
                {
                    <span class="is-disabled" aria-hidden="true"><i class="bi bi-chevron-left"></i></span>
                }
                @foreach (var number in Model.PageWindow())
                {
                    if (number == Model.SearchResult.Page)
                    {
                        <span class="is-current" aria-current="page">@number</span>
                    }
                    else
                    {
                        <a href="@Model.BuildPageUrl(number)" aria-label="Page @number">@number</a>
                    }
                }
                @if (Model.SearchResult.HasNext)
                {
                    <a href="@Model.BuildPageUrl(Model.SearchResult.Page + 1)" aria-label="Next page"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                }
                else
                {
                    <span class="is-disabled" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
                }
            </div>
        }
    </nav>
}
