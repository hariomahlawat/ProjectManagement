@using ProjectManagement.ViewModels.Workspace
@model ProjectManagement.Pages.Workspace.IndexModel
@{
    var vm = Model.Workspace;
    var activeView = Model.View;
}
<div class="command-workspace project-officer-workspace is-nav-expanded" data-project-officer-workspace>
    @await Html.PartialAsync("_CommandWorkspaceRail", Model.NavigationRail)
    <main class="cw-workspace-content po-workspace-content @(activeView == "conference" ? "cw-workspace-content--conference po-workspace-content--conference" : string.Empty)">
        @switch (activeView)
        {
            case "projects":
                @await Html.PartialAsync("_ProjectOfficerProjects", Model)
                break;
            case "conference":
                @await Html.PartialAsync("_ProjectOfficerConference", Model)
                break;
            case "documents":
                @await Html.PartialAsync("_ProjectOfficerDocuments", Model)
                break;
            case "activity":
                @await Html.PartialAsync("_ProjectOfficerActivity", Model)
                break;
            default:
                @await Html.PartialAsync("_ProjectOfficerBriefingDesk", Model)
                break;
        }
    </main>
</div>
@if (activeView is "projects")
{
    @await Html.PartialAsync("_ProjectOfficerRecordModals", vm)
}
