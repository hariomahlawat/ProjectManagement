@using ProjectManagement.ViewModels.Workspace
@model CommandWorkspaceRailVm
@{
    var activeItem = string.IsNullOrWhiteSpace(Model.ActiveItem)
        ? "command-officers"
        : Model.ActiveItem.Trim().ToLowerInvariant();
    var activeLens = string.Equals(Model.ActiveLens, "personal", StringComparison.OrdinalIgnoreCase)
        ? "personal"
        : "command";

    string Active(string item) => string.Equals(activeItem, item, StringComparison.OrdinalIgnoreCase)
        ? "is-active"
        : string.Empty;
    string? Current(string item) => string.Equals(activeItem, item, StringComparison.OrdinalIgnoreCase)
        ? "page"
        : null;

    var accessLabel = Model.HasCommandAccess && Model.HasProjectOfficerAccess
        ? "Project Officer · Command"
        : Model.HasCommandAccess
            ? "Command"
            : "Project Officer";
}

<aside class="cw-local-rail is-expanded" data-workspace-rail aria-label="Workspace navigation">
    @* Light behind the glass (an aurora of the prism hues) and the frost that blurs it. *@
    <span class="cw-local-rail__aurora" aria-hidden="true"></span>
    <span class="cw-local-rail__frost" aria-hidden="true"></span>
    <div class="cw-local-rail__identity">
        <span class="cw-local-rail__mark" aria-hidden="true">
            @* The PRISM mark as a glyph: one beam in, the spectrum out. Rays are coloured in CSS. *@
            <svg class="cw-prism" viewBox="0 0 32 32" fill="none" focusable="false">
                <path class="cw-prism__beam" d="M3 17h9" stroke-width="1.6" stroke-linecap="round" />
                <path class="cw-prism__glass" d="M16 5 26 25H6z" stroke-width="1" />
                <path class="cw-prism__ray cw-prism__ray--1" d="M20 14 30 9" stroke-width="1.5" stroke-linecap="round" />
                <path class="cw-prism__ray cw-prism__ray--2" d="M20.5 15.5 30 13" stroke-width="1.5" stroke-linecap="round" />
                <path class="cw-prism__ray cw-prism__ray--3" d="M21 17h9" stroke-width="1.5" stroke-linecap="round" />
                <path class="cw-prism__ray cw-prism__ray--4" d="M20.5 18.5 30 21" stroke-width="1.5" stroke-linecap="round" />
                <path class="cw-prism__ray cw-prism__ray--5" d="M20 20 30 25" stroke-width="1.5" stroke-linecap="round" />
            </svg>
        </span>
        <div class="cw-local-rail__identity-copy">
            <small>PRISM ERP</small>
            <strong>My Workspace</strong>
            <span class="cw-local-rail__access" title="@accessLabel">
                @if (Model.HasProjectOfficerAccess)
                {
                    <span class="cw-local-rail__role cw-local-rail__role--po">PO</span>
                }
                @if (Model.HasCommandAccess)
                {
                    <span class="cw-local-rail__role cw-local-rail__role--command">Command</span>
                }
            </span>
        </div>
        <button type="button"
                class="cw-local-rail__toggle"
                data-workspace-rail-toggle
                aria-expanded="true"
                aria-controls="workspace-local-navigation"
                aria-label="Collapse workspace navigation"
                title="Collapse workspace navigation">
            <i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i>
        </button>
    </div>

    @if (Model.CanSwitchWorkspace)
    {
        <div class="cw-workspace-lens @(activeLens == "command" ? "is-command" : "is-personal")" role="group" aria-label="Workspace lens">
            <span class="cw-workspace-lens__thumb" aria-hidden="true"></span>
            <a asp-page="/Workspace/Index"
               asp-route-mode="project-officer"
               asp-route-view="overview"
               class="@(activeLens == "personal" ? "is-active" : null)"
               aria-current="@(activeLens == "personal" ? "true" : null)"
               title="Open personal workspace landing">
                <i class="bi bi-person" aria-hidden="true"></i>
                <span>Personal</span>
            </a>
            <a asp-page="/Workspace/CommandDesk"
               class="@(activeLens == "command" ? "is-active" : null)"
               aria-current="@(activeLens == "command" ? "true" : null)"
               title="Open the Command desk">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                <span>Command</span>
            </a>
        </div>
    }

    <nav id="workspace-local-navigation">
        @if (Model.HasProjectOfficerAccess)
        {
            <div class="cw-local-rail__group cw-local-rail__group--personal">
                <span class="cw-local-rail__group-label">My work</span>
                <a asp-page="/Workspace/Index"
                   asp-route-mode="project-officer"
                   asp-route-view="overview"
                   class="@(Active("personal-overview"))"
                   aria-current="@(Current("personal-overview"))"
                   data-tooltip="Briefing desk">
                    <i class="bi bi-grid-1x2" aria-hidden="true"></i><span>Briefing desk</span>
                </a>
                <a asp-page="/Workspace/Index"
                   asp-route-mode="project-officer"
                   asp-route-view="conference"
                   class="@(Active("personal-conference"))"
                   aria-current="@(Current("personal-conference"))"
                   data-tooltip="My conference review">
                    <i class="bi bi-clipboard2-check" aria-hidden="true"></i><span>My conference review</span>
                </a>
                <a asp-page="/Workspace/Index"
                   asp-route-mode="project-officer"
                   asp-route-view="projects"
                   class="@(Active("personal-projects"))"
                   aria-current="@(Current("personal-projects"))"
                   data-tooltip="Project register">
                    <i class="bi bi-kanban" aria-hidden="true"></i><span>Project register</span>
                    @if (Model.AssignedProjectCount > 0)
                    {
                        <b>@Model.AssignedProjectCount</b>
                    }
                </a>
            </div>
        }

        @if (Model.HasCommandAccess)
        {
            <div class="cw-local-rail__group cw-local-rail__group--command">
                <span class="cw-local-rail__group-label">Command oversight</span>
                <a asp-page="/Workspace/CommandDesk"
                   class="@(Active("command-desk"))"
                   aria-current="@(Current("command-desk"))"
                   data-tooltip="Command desk">
                    <i class="bi bi-binoculars" aria-hidden="true"></i><span>Command desk</span>
                </a>
                <a asp-page="/Workspace/Index"
                   asp-route-mode="command"
                   asp-route-view="officers"
                   class="@(Active("command-officers"))"
                   aria-current="@(Current("command-officers"))"
                   data-tooltip="Officer workload">
                    <i class="bi bi-people" aria-hidden="true"></i><span>Officer workload</span>
                    @if (Model.ProjectOfficerCount > 0)
                    {
                        <b>@Model.ProjectOfficerCount</b>
                    }
                </a>
                @* Opens the Analytics page (Ongoing tab): the stage chart by parent category, with phases and drill-down. *@
                <a asp-page="/Analytics/Index"
                   data-tooltip="Project analytics">
                    <i class="bi bi-graph-up" aria-hidden="true"></i><span>Project analytics</span>
                    @if (Model.TotalOngoingProjects > 0)
                    {
                        <b>@Model.TotalOngoingProjects</b>
                    }
                </a>
                <a asp-page="/Workspace/Conference"
                   class="@(Active("command-conference"))"
                   aria-current="@(Current("command-conference"))"
                   data-tooltip="Conference review">
                    <i class="bi bi-clipboard2-check" aria-hidden="true"></i><span>Conference review</span>
                </a>
                <a asp-page="/Workspace/BriefingDecks/Index"
                   class="@(Active("command-briefing-decks"))"
                   aria-current="@(Current("command-briefing-decks"))"
                   data-tooltip="Briefing decks">
                    <i class="bi bi-file-earmark-slides" aria-hidden="true"></i><span>Briefing decks</span>
                </a>
            </div>

            <div class="cw-local-rail__group cw-local-rail__group--system">
                <span class="cw-local-rail__group-label">System adoption</span>
                <a asp-page="/Workspace/Index"
                   asp-route-mode="command"
                   asp-route-view="adoption"
                   class="@(Active("command-adoption"))"
                   aria-current="@(Current("command-adoption"))"
                   data-tooltip="ERP adoption">
                    <i class="bi bi-person-check" aria-hidden="true"></i><span>ERP adoption</span>
                </a>
                <a asp-page="/Workspace/Index"
                   asp-route-mode="command"
                   asp-route-view="usage-pattern"
                   class="@(Active("command-usage-pattern"))"
                   aria-current="@(Current("command-usage-pattern"))"
                   data-tooltip="ERP usage pattern">
                    <i class="bi bi-bounding-box-circles" aria-hidden="true"></i><span>ERP usage pattern</span>
                </a>
            </div>
        }

        <div class="cw-local-rail__group cw-local-rail__group--resources">
            <span class="cw-local-rail__group-label">My resources</span>
            @if (Model.HasProjectOfficerAccess && Model.CanViewDocuments)
            {
                <a asp-page="/Workspace/Index"
                   asp-route-mode="project-officer"
                   asp-route-view="documents"
                   class="@(Active("personal-documents"))"
                   aria-current="@(Current("personal-documents"))"
                   data-tooltip="My documents">
                    <i class="bi bi-folder2-open" aria-hidden="true"></i><span>My documents</span>
                    @if (Model.AotsUnreadCount > 0)
                    {
                        <b>@Model.AotsUnreadCount</b>
                    }
                </a>
            }
            @if (activeLens == "command" && Model.HasCommandAccess)
            {
                <a asp-page="/Workspace/Index"
                   asp-route-mode="command"
                   asp-route-view="my-activity"
                   class="@(Active("my-activity"))"
                   aria-current="@(Current("my-activity"))"
                   data-tooltip="My ERP activity">
                    <i class="bi bi-activity" aria-hidden="true"></i><span>My ERP activity</span>
                </a>
            }
            else if (Model.HasProjectOfficerAccess)
            {
                <a asp-page="/Workspace/Index"
                   asp-route-mode="project-officer"
                   asp-route-view="activity"
                   class="@(Active("my-activity"))"
                   aria-current="@(Current("my-activity"))"
                   data-tooltip="My ERP activity">
                    <i class="bi bi-activity" aria-hidden="true"></i><span>My ERP activity</span>
                </a>
            }
        </div>
    </nav>
</aside>
