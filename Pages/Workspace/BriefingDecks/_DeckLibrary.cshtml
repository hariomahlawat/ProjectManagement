@model ProjectManagement.Pages.Workspace.BriefingDecks.IndexModel
@using ProjectManagement.Infrastructure
@using ProjectManagement.Services.ProjectBriefings
@*
    The deck library: where a deck is chosen, started or resumed. Nothing here builds slides;
    a deck opens in the Studio only when the person picks it.
*@
@{
    var continueDeck = Model.ContinueDeck;
    var todayIst = IstClock.ToIst(DateTimeOffset.UtcNow).Date;
    string When(DateTimeOffset value)
    {
        var ist = IstClock.ToIst(value);
        return ist.Date == todayIst ? $"Today, {ist:HH:mm}" : ist.ToString("dd MMM yyyy");
    }
    string Projects(int count) => $"{count} {(count == 1 ? "project" : "projects")}";
    string Day(DateTimeOffset value) => IstClock.ToIst(value).ToString("dd MMM");
    // Table dates stay on one line: the year only when it is not this year; the full date on hover.
    string WhenShort(DateTimeOffset value)
    {
        var ist = IstClock.ToIst(value);
        if (ist.Date == todayIst) return $"Today, {ist:HH:mm}";
        return ist.Year == todayIst.Year ? ist.ToString("dd MMM") : ist.ToString("dd MMM yy");
    }
    string WhenFull(DateTimeOffset value) => IstClock.ToIst(value).ToString("dd MMM yyyy, HH:mm");
    // What moved for one project: "stage, status remark".
    string MovedFacts(ProjectBriefingMovedProject project) => string.Join(", ", new[]
    {
        project.Stage ? "stage" : null,
        project.Status ? "status remark" : null,
        project.Cost ? "cost" : null,
        project.KeyPoints ? "key points" : null
    }.Where(part => part is not null));
}

@if (Model.MovedDecks.Count > 0)
{
    <section class="pbd-library__section" aria-labelledby="pbd-attention-title">
        <h2 class="pbd-library__heading" id="pbd-attention-title">Needs attention</h2>
        <div class="pbd-attention">
            @foreach (var deck in Model.MovedDecks)
            {
                var movement = deck.DataMovement!;
                <article class="pbd-attention__card">
                    <span class="pbd-attention__kind">Data moved since last generated</span>
                    <a class="pbd-attention__name" asp-page="/Workspace/BriefingDecks/Index" asp-route-deckId="@deck.Id">@deck.Name</a>
                    <p class="pbd-attention__summary">Generated @Day(deck.LastGeneratedAtUtc!.Value). Since then: @string.Join(" · ", movement.Describe()).</p>
                    <ul class="pbd-attention__projects">
                        @foreach (var project in movement.Projects.Take(3))
                        {
                            <li><strong>@project.ProjectName</strong> — @MovedFacts(project)</li>
                        }
                        @if (movement.Projects.Count > 3)
                        {
                            <li class="pbd-attention__more">and @(movement.Projects.Count - 3) more</li>
                        }
                    </ul>
                    <a class="pbd-attention__open" asp-page="/Workspace/BriefingDecks/Index" asp-route-deckId="@deck.Id">Open in Studio</a>
                </article>
            }
        </div>
    </section>
}

<section class="pbd-library__section" aria-labelledby="pbd-all-decks-title" data-pbd-library>
    <div class="pbd-library__toolbar">
        <h2 class="pbd-library__heading" id="pbd-all-decks-title"><span data-pbd-library-title>All decks</span> · <span data-pbd-library-count>@Model.Decks.Count</span></h2>
        <div class="pbd-library__controls">
            @* A Project Officer sees only their own decks, so there is nothing to narrow. *@
            @if (Model.IsCommandUser)
            {
                <div class="pbd-segmented" role="group" aria-label="Show decks">
                    <button type="button" class="pbd-segmented__option" aria-pressed="false" data-pbd-library-scope="mine">Mine</button>
                    <button type="button" class="pbd-segmented__option is-active" aria-pressed="true" data-pbd-library-scope="all">All</button>
                </div>
            }
            <label class="pbd-library__search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <span class="visually-hidden">Find a deck or project</span>
                <input type="search" class="form-control" placeholder="Find a deck or project" autocomplete="off" data-pbd-library-search />
            </label>
            <label class="pbd-library__sort">
                <span>Sort</span>
                <select class="form-select" data-pbd-library-sort>
                    <option value="edited">Last edited</option>
                    <option value="generated">Last generated</option>
                    <option value="name">Name</option>
                </select>
            </label>
        </div>
    </div>

    @* One card per deck (owner, 17 Nov 2026: the table read as empty with few decks). The deck to
       continue is the first card, tagged, instead of a separate panel. The cards keep the rows'
       data-* hooks, so search, Mine/All and sort (project-briefing-library.js) work unchanged. *@
    <div class="pbd-library__cards" data-pbd-library-rows>
        @foreach (var deck in Model.Decks)
        {
            var searchText = string.Join(" ", new[] { deck.Name, deck.Description ?? string.Empty }.Concat(deck.ProjectNames)).ToLowerInvariant();
            var isContinue = continueDeck is not null && continueDeck.Id == deck.Id && deck.CanEdit;
            <article class="pbd-deck-card" aria-labelledby="pbd-deck-card-@deck.Id"
                     data-pbd-library-row
                     data-search="@searchText"
                     data-mine="@(deck.IsMine ? "true" : "false")"
                     data-name="@deck.Name"
                     data-edited="@deck.UpdatedAtUtc.ToUnixTimeSeconds()"
                     data-generated="@(deck.LastGeneratedAtUtc?.ToUnixTimeSeconds() ?? 0)"
                     data-projects="@(string.Join("\n", deck.ProjectNames))">
                <div class="pbd-deck-card__art">
                    <partial name="_DesignMini" model="deck.DesignKind" />
                    @if (isContinue)
                    {
                        @* "Continue" only for a deck this person last edited; otherwise the deck most
                           recently edited by anyone (decks are shared). *@
                        <span class="pbd-deck-card__tag">@(continueDeck!.LastEditedByMe ? "Continue" : "Recently edited")</span>
                    }
                    else if (!deck.CanEdit)
                    {
                        <span class="pbd-deck-card__tag is-officer"><i class="bi bi-person" aria-hidden="true"></i> @deck.CreatedByDisplay's deck · view only</span>
                    }
                </div>
                <div class="pbd-deck-card__body">
                    <h3 class="pbd-deck-card__name" id="pbd-deck-card-@deck.Id">
                        @if (deck.CanEdit)
                        {
                            <a class="pbd-library__name" asp-page="/Workspace/BriefingDecks/Index" asp-route-deckId="@deck.Id">@deck.Name</a>
                        }
                        else
                        {
                            <span class="pbd-library__name">@deck.Name</span>
                        }
                    </h3>
                    @if (!string.IsNullOrWhiteSpace(deck.Description))
                    {
                        <p class="pbd-library__description">@deck.Description</p>
                    }
                    <small class="pbd-library__match" data-pbd-library-match hidden></small>
                    <p class="pbd-deck-card__facts">
                        <span class="pbd-library__purpose">@deck.Design</span>
                        <span>@(deck.ProjectCount == 0 ? "No projects yet" : Projects(deck.ProjectCount))</span>
                    </p>
                    <p class="pbd-deck-card__edited" title="@WhenFull(deck.UpdatedAtUtc) · created by @deck.CreatedByDisplay">Edited @WhenShort(deck.UpdatedAtUtc) · @deck.LastModifiedByDisplay</p>
                    @* One status for the PowerPoint: whether there is one, how many slides, and whether
                       the projects' data has moved since (the reason it may need generating again). *@
                    <p class="pbd-deck-card__status">
                        @if (deck.LastGeneratedAtUtc is not { } generatedOn)
                        {
                            <span class="pbd-library__quiet">@(deck.ProjectCount == 0 ? "No PowerPoint yet" : "Not generated")</span>
                        }
                        else
                        {
                            <span title="@WhenFull(generatedOn)">@WhenShort(generatedOn)@(deck.LastGeneratedSlideCount is int slides ? $" · {slides} slides" : string.Empty)</span>
                            @if (deck.DataMovement is null)
                            {
                                <span class="pbd-library__quiet"> · changes not tracked yet</span>
                            }
                            else if (deck.DataMovement.HasMoved && deck.CanEdit)
                            {
                                <text> · </text><a class="pbd-library__moved" asp-page="/Workspace/BriefingDecks/Index" asp-route-deckId="@deck.Id"
                                   title="@string.Join(" · ", deck.DataMovement.Describe())">@deck.DataMovement.Total @(deck.DataMovement.Total == 1 ? "change" : "changes") since</a>
                            }
                            else if (deck.DataMovement.HasMoved)
                            {
                                @* A Project Officer's deck a command user can only view: the count, without a link. *@
                                <text> · </text><span class="pbd-library__moved" title="@string.Join(" · ", deck.DataMovement.Describe())">@deck.DataMovement.Total @(deck.DataMovement.Total == 1 ? "change" : "changes") since</span>
                            }
                            else
                            {
                                <span class="pbd-library__current"> · up to date</span>
                            }
                        }
                    </p>
                </div>
                <div class="pbd-deck-card__actions">
                    @if (!deck.CanEdit)
                    {
                        @* A Project Officer's own deck: a command user may download or duplicate it. *@
                        <form method="post" asp-page-handler="Download">
                            <input type="hidden" name="deckId" value="@deck.Id" />
                            <button type="submit" class="btn btn-sm btn-primary" disabled="@(deck.ProjectCount == 0)">Download</button>
                        </form>
                        <form method="post" asp-page-handler="Duplicate">
                            <input type="hidden" name="deckId" value="@deck.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Makes your own copy, which you can change">Duplicate</button>
                        </form>
                    }
                    else
                    {
                        @if (deck.ProjectCount == 0)
                        {
                            <a class="btn btn-sm btn-primary" asp-page="/Workspace/BriefingDecks/Index" asp-route-deckId="@deck.Id" asp-route-start="projects">Add projects</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Workspace/BriefingDecks/Index" asp-route-deckId="@deck.Id">Open</a>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-primary" asp-page="/Workspace/BriefingDecks/Index" asp-route-deckId="@deck.Id">Open</a>
                            @* Generate in the Studio, with its progress, saved-changes and gap checks. *@
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Workspace/BriefingDecks/Index" asp-route-deckId="@deck.Id" asp-route-generate="1"
                               title="Opens the deck and generates the PowerPoint there, after its checks">Generate</a>
                        }
                        <div class="dropdown pbd-deck-card__more">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" aria-label="More actions for @deck.Name">
                                <i class="bi bi-three-dots" aria-hidden="true"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <form method="post" asp-page-handler="Download">
                                        <input type="hidden" name="deckId" value="@deck.Id" />
                                        <button type="submit" class="dropdown-item" disabled="@(deck.ProjectCount == 0)"><i class="bi bi-download" aria-hidden="true"></i> Download PowerPoint</button>
                                    </form>
                                </li>
                                <li>
                                    <form method="post" asp-page-handler="Duplicate">
                                        <input type="hidden" name="deckId" value="@deck.Id" />
                                        <button type="submit" class="dropdown-item"><i class="bi bi-copy" aria-hidden="true"></i> Duplicate</button>
                                    </form>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" asp-page-handler="Delete" data-pbd-library-delete data-deck-name="@deck.Name" data-confirm-detail="It moves to Recently deleted and can be restored for @ProjectBriefingDeckService.DeletedRetentionDays days." data-page-handled data-confirm="Delete “@deck.Name”? It moves to Recently deleted and can be restored for @ProjectBriefingDeckService.DeletedRetentionDays days.">
                                        <input type="hidden" name="deckId" value="@deck.Id" />
                                        <input type="hidden" name="rowVersion" value="@deck.RowVersion" />
                                        <input type="hidden" name="from" value="library" />
                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </article>
        }
    </div>
    <div class="pbd-library__empty" data-pbd-library-empty hidden>
        <p data-pbd-library-empty-text>No decks match.</p>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-pbd-library-reset>Show all decks</button>
    </div>
</section>

<partial name="_DeletedDecks" model="Model.DeletedDecks" />
