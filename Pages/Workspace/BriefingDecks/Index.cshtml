                                                <label class="pbd-seg__option"><input type="radio" name="BrandingScope" value="AllSlides" checked="@(deck.BrandingScope == ProjectBriefingBrandingScope.AllSlides)" data-help="A compact insignia on every slide." /><span>All slides</span></label>
