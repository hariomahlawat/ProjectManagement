                                            <span class="pbd-step__number" data-pbd-step-number aria-hidden="true">6</span>
                                            <span class="pbd-step__text"><strong>Handling</strong><small data-pbd-step-summary></small></span>
                                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                        </summary>
