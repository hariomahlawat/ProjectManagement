        <div class="pbd-confirm-dialog__icon" aria-hidden="true"><i class="bi bi-exclamation-triangle"></i></div>
        <div class="pbd-confirm-dialog__content">
            <h2 id="pbd-confirm-title" data-pbd-confirm-title>Confirm action</h2>
            <p id="pbd-confirm-message" data-pbd-confirm-message>Continue with this action?</p>
        </div>
        <div class="pbd-confirm-dialog__actions">
            <button type="button" class="btn btn-outline-secondary" data-pbd-confirm-cancel autofocus>Cancel</button>
            <button type="button" class="btn btn-danger" data-pbd-confirm-action>Confirm</button>
        </div>
    </div>
</dialog>

