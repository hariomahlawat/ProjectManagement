                                    </form>

                        @* The institution slides' own forms, outside the settings form (forms cannot nest). *@
                        <div class="pbd-additional-slide-forms" hidden>
                            @if (additionalSlideOrder.Count > 0)
                            {
                                <form method="post" asp-page-handler="ReorderAdditionalSlides" class="pbd-additional-slide-order-form" data-pbd-additional-slide-order-form>
                                    <input type="hidden" name="deckId" value="@deck.Id" />
                                    <input type="hidden" name="rowVersion" value="@deck.RowVersion" />
                                    <input type="hidden" name="order" value="@string.Join(",", additionalSlideOrder)" data-pbd-additional-slide-order />
                                </form>
                            }
                            @foreach (var slideType in additionalSlideOrder)
                            {
                                var slideKey = slideType.ToString();
                                <form method="post" asp-page-handler="ToggleAdditionalSlide" id="pbd-additional-slide-toggle-@slideKey" data-pbd-additional-slide-toggle-form>
                                    <input type="hidden" name="deckId" value="@deck.Id" />
                                    <input type="hidden" name="slideType" value="@slideType" />
                                    <input type="hidden" name="rowVersion" value="@deck.RowVersion" />
                                    <input type="hidden" name="ensureAdded" value="false" />
                                    <input type="hidden" name="enabled" value="@AdditionalSlideIsEnabled(slideType).ToString().ToLowerInvariant()" data-pbd-additional-slide-enabled />
                                </form>
                                <form method="post" asp-page-handler="RemoveAdditionalSlide" id="pbd-additional-slide-remove-@slideKey" data-pbd-remove-additional-slide-form data-slide-name="@AdditionalSlideDisplayName(slideType)">
                                    <input type="hidden" name="deckId" value="@deck.Id" />
                                    <input type="hidden" name="slideType" value="@slideType" />
                                    <input type="hidden" name="rowVersion" value="@deck.RowVersion" />
                                </form>
                            }
                        </div>
                                </div>

                                <div id="pbd-inspector-checks" role="tabpanel" aria-labelledby="pbd-inspector-tab-checks" class="pbd-inspector__panel" data-pbd-inspector-panel="checks" hidden>
                                    <p class="pbd-inspector__empty">Checking the deck…</p>
                                </div>
                            </aside>
                        </section>
                        </div>

                        @* Present: full screen where the browser allows it (else the whole window), the slide as
                           large as it fits; the strip and the speaker notes open on request. *@
                        <dialog class="pbd-viewer" data-pbd-viewer aria-labelledby="pbd-viewer-title">
                            <div class="pbd-viewer__surface">
                                <header class="pbd-viewer__header">
                                    <div>
                                        <span class="pbd-eyebrow">@deck.Name</span>
                                        <h2 id="pbd-viewer-title" data-pbd-viewer-title>Slide</h2>
                                    </div>
                                    <span class="pbd-viewer__counter" data-pbd-viewer-counter aria-live="polite"></span>
                                    <p class="pbd-viewer__keys" id="pbd-viewer-keys">
                                        <kbd>&larr;</kbd><kbd>&rarr;</kbd> slides · <kbd>N</kbd> notes · <kbd>Esc</kbd> ends
                                    </p>
                                    <div class="pbd-viewer__tools">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-pbd-viewer-first>
                                            <i class="bi bi-skip-start" aria-hidden="true"></i> From the start
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" aria-pressed="false" aria-keyshortcuts="N" data-pbd-viewer-notes-toggle>
                                            <i class="bi bi-card-text" aria-hidden="true"></i> Notes
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" aria-pressed="false" data-pbd-viewer-strip-toggle>
                                            <i class="bi bi-grid-3x2-gap" aria-hidden="true"></i> Slides
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-pbd-viewer-close aria-label="End the presentation" aria-keyshortcuts="Escape">
                                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </header>
                                <div class="pbd-viewer__body" tabindex="-1" aria-describedby="pbd-viewer-keys" data-pbd-viewer-body>
                                    <button type="button" class="pbd-viewer__nav" data-pbd-viewer-prev aria-label="Previous slide"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
                                    <div class="pbd-viewer__stage" data-pbd-viewer-stage></div>
                                    <button type="button" class="pbd-viewer__nav" data-pbd-viewer-next aria-label="Next slide"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                                    <section class="pbd-viewer__notes" aria-label="Speaker notes" data-pbd-viewer-notes hidden>
                                        <h3>Speaker notes</h3>
                                        <p data-pbd-viewer-notes-text></p>
                                    </section>
                                    <ol class="pbd-viewer__strip" data-pbd-viewer-strip aria-label="All slides" hidden></ol>
                                </div>
                            </div>
                        </dialog>

                        @await Html.PartialAsync("_InstitutionalProfileEditor", Model)
                        @await Html.PartialAsync("_RoleCharterEditor", Model)
                        @await Html.PartialAsync("_FfcGlobalFootprintEditor", Model)

                        <div class="modal fade" id="pbd-additional-slide-library-modal" tabindex="-1" aria-labelledby="pbd-additional-slide-library-title" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content pbd-slide-library">
                                    <div class="modal-header">
                                        <div>
                                            <span class="pbd-eyebrow">Slide library</span>
                                            <h3 class="modal-title" id="pbd-additional-slide-library-title">Add an additional slide</h3>
                                            <p>Choose from approved templates. Each approved slide type can be added once.</p>
                                        </div>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        @if (missingAdditionalSlideTypes.Length == 0)
                                        {
                                            <p class="pbd-slide-library__empty">All currently available slide types are already configured.</p>
                                        }
                                        else
                                        {
                                            <div class="pbd-slide-library__grid">
                                                @foreach (var definition in missingAdditionalSlideTypes)
                                                {
                                                    var slideType = definition.Type;
                                                    <form method="post" asp-page-handler="ToggleAdditionalSlide" class="pbd-slide-library-card">
                                                        <input type="hidden" name="deckId" value="@deck.Id" />
                                                        <input type="hidden" name="slideType" value="@slideType" />
                                                        <input type="hidden" name="rowVersion" value="@deck.RowVersion" />
                                                        <input type="hidden" name="enabled" value="true" />
                                                        <input type="hidden" name="ensureAdded" value="true" />
                                                        <span class="pbd-slide-library-card__icon" aria-hidden="true"><i class="bi @AdditionalSlideIcon(slideType)"></i></span>
                                                        <span>
                                                            <strong>@AdditionalSlideDisplayName(slideType)</strong>
                                                            <small>@AdditionalSlideDescription(slideType)</small>
                                                        </span>
                                                        <button type="submit" class="btn btn-sm btn-primary">Add</button>
                                                    </form>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal fade pbd-add-projects" id="pbd-add-projects-modal" tabindex="-1" aria-labelledby="pbd-add-projects-title" aria-hidden="true">
