                                                <label class="pbd-seg__option"><input type="radio" name="ClosingSlideType" value="ThankYou" checked="@(deck.ClosingSlideType == ProjectBriefingClosingSlideType.ThankYou)" data-help="For industry, academic and external audiences." data-label="Thank You" /><span>Thank You</span></label>
