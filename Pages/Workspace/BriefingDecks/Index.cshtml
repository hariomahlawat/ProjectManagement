@page "/Workspace/BriefingDecks/{deckId:long?}"
@model ProjectManagement.Pages.Workspace.BriefingDecks.IndexModel
@using ProjectManagement.Infrastructure
@using ProjectManagement.Models.ProjectBriefings
@using ProjectManagement.Services.ProjectBriefings
@using ProjectManagement.ViewModels.Workspace
@{
    var deck = Model.SelectedDeck;
    ViewData["Title"] = deck is null
        ? "Briefing decks | Comdt / HoD Workspace"
        : $"{deck.Name} | Briefing decks";
    ViewData["UseFullWidth"] = true;
    ViewData["PageShell"] = "studio";
    var presentedProjects = deck?.Projects.Where(project => project.IsPresented).ToArray();
    var leftOutProjectCount = deck?.Projects.Count(project => project.IsDeletedOrArchived) ?? 0;
    // The progress line's starting figures; the Studio keeps them current after each rebuild.
    var presentedIds = presentedProjects?.Select(project => project.ProjectId).ToHashSet() ?? new HashSet<int>();
    var openCheckCount = deck?.ContentGaps
        .Where(pair => presentedIds.Contains(pair.Key))
        .SelectMany(pair => pair.Value)
        .Distinct()
        .Count() ?? 0;
    var isUpdateSheet = deck?.Layout == ProjectBriefingLayout.ProjectUpdateSheet;
    var selectedUpdateSheetRows = (deck?.UpdateSheetOptions.Rows ?? ProjectBriefingUpdateSheetOptions.RecommendedRows).ToHashSet();
    var orderedUpdateSheetRows = (deck?.UpdateSheetOptions.Rows ?? ProjectBriefingUpdateSheetOptions.RecommendedRows)
        .Concat(ProjectBriefingUpdateSheetOptions.AllRows)
        .Distinct()
        .ToArray();
    var updateSheetRowOrder = string.Join(",", orderedUpdateSheetRows);
    string UpdateSheetRowLabel(ProjectBriefingUpdateSheetRow row) => row switch
    {
        ProjectBriefingUpdateSheetRow.ProjectCost => "Project cost",
        ProjectBriefingUpdateSheetRow.ArppPppNumber => "ARPP/PPP number",
        ProjectBriefingUpdateSheetRow.FundingAuthority => "Fund, DFPDS schedule and CFA",
        ProjectBriefingUpdateSheetRow.AonDate => "AoN date",
        ProjectBriefingUpdateSheetRow.SupplyOrder => "Supply-order date and firm",
        ProjectBriefingUpdateSheetRow.PdcOrCompletionStatus => "PDC / completion status",
        ProjectBriefingUpdateSheetRow.PresentStatus => "Present status",
        ProjectBriefingUpdateSheetRow.ProjectOfficer => "Project Officer",
        ProjectBriefingUpdateSheetRow.LineDirectorate => "Line Directorate",
        _ => row.ToString()
    };
    string UpdateSheetRowDescription(ProjectBriefingUpdateSheetRow row) => row switch
    {
        ProjectBriefingUpdateSheetRow.ProjectCost => "Authoritative R&D cost",
        ProjectBriefingUpdateSheetRow.ArppPppNumber => "Latest published ARPP/PPP reference",
        ProjectBriefingUpdateSheetRow.FundingAuthority => "Combined in one compact row",
        ProjectBriefingUpdateSheetRow.AonDate => "Recorded approval-of-necessity date",
        ProjectBriefingUpdateSheetRow.SupplyOrder => "SO date and linked firm/JDP",
        ProjectBriefingUpdateSheetRow.PdcOrCompletionStatus => "Development-stage PDC; blank editable cell at other ongoing stages; completion status when completed",
        ProjectBriefingUpdateSheetRow.PresentStatus => "Latest external status or editable placeholder",
        ProjectBriefingUpdateSheetRow.ProjectOfficer => "Rank and full name where recorded",
        ProjectBriefingUpdateSheetRow.LineDirectorate => "Responsible line directorate",
        _ => string.Empty
    };
    var institutionalProfile = deck?.InstitutionalProfileOptions
        ?? ProjectBriefingInstitutionalProfileOptions.Default;
    var roleCharter = deck?.RoleCharterOptions
        ?? ProjectBriefingRoleCharterOptions.Default;
    var ffcGlobalFootprint = deck?.FfcGlobalFootprintOptions
        ?? ProjectBriefingFfcGlobalFootprintOptions.Default;
    var additionalSlideOrder = deck?.AdditionalSlideOrder
        ?? Array.Empty<ProjectBriefingAdditionalSlideType>();
    var configuredAdditionalSlideTypes = additionalSlideOrder.ToHashSet();
    var availableAdditionalSlideTypes = ProjectBriefingAdditionalSlideCatalog.All;
    var missingAdditionalSlideTypes = availableAdditionalSlideTypes
        .Where(definition => !configuredAdditionalSlideTypes.Contains(definition.Type))
        .ToArray();
    bool AdditionalSlideIsEnabled(ProjectBriefingAdditionalSlideType type) => type switch
    {
        ProjectBriefingAdditionalSlideType.InstitutionalProfile => institutionalProfile.IncludeSlide,
        ProjectBriefingAdditionalSlideType.RoleAndCharter => roleCharter.IncludeSlide,
        ProjectBriefingAdditionalSlideType.FfcGlobalFootprint => ffcGlobalFootprint.IncludeSlide,
        _ => false
    };
    ProjectBriefingAdditionalSlideDefinition AdditionalSlideDefinition(ProjectBriefingAdditionalSlideType type)
        => ProjectBriefingAdditionalSlideCatalog.Get(type);
    string AdditionalSlideDisplayName(ProjectBriefingAdditionalSlideType type)
        => AdditionalSlideDefinition(type).DisplayName;
    string AdditionalSlideDescription(ProjectBriefingAdditionalSlideType type)
        => AdditionalSlideDefinition(type).Description;
    string AdditionalSlideIcon(ProjectBriefingAdditionalSlideType type)
        => AdditionalSlideDefinition(type).IconCssClass;
    var standardIncludesDetailedSlides = deck?.PresentationMode
        is ProjectBriefingPresentationMode.DetailedProjects or ProjectBriefingPresentationMode.Combined;
    var standardNeedsCapabilities = deck?.NarrativeMode
        is ProjectBriefingNarrativeMode.CapabilityOverview or ProjectBriefingNarrativeMode.Both;
    var standardNeedsProjectBrief = deck?.NarrativeMode
        is ProjectBriefingNarrativeMode.ProjectBrief or ProjectBriefingNarrativeMode.Both;
    // The Template picker: the preset the deck started from, and whether it was changed since.
    var templateTitle = deck?.Preset is { } titlePreset
        ? ProjectBriefingDeckPresets.Get(titlePreset).Title
        : "Set up by hand";
    var templateCustomised = deck?.Preset is not null && deck.PresetAdjusted;
    var presetStatus = deck?.Preset is { } currentPreset
        ? deck.PresetAdjusted
            ? "Started from this template, then customised."
            : ProjectBriefingDeckPresets.Get(currentPreset).Summary
        : "Choose a template to apply its settings; you can still change any of them.";
    // Projects and their content gaps for the Studio outline and inspector, in the same shape the
    // membership endpoint returns, so in-place edits can refresh it.
    var studioDataJson = deck is null
        ? "null"
        : System.Text.Json.JsonSerializer.Serialize(
            new { projects = deck.Projects, contentGaps = deck.ContentGaps },
            // Enums as names, the same as the in-page JSON responses the Studio also reads.
            new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)
            {
                Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
            });
}

@section Styles {
    <link rel="stylesheet" href="~/css/command-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/project-briefing-decks.css" asp-append-version="true" />
}

@* The Studio starts with the workspace navigation folded, so the slide gets the room; it keeps
   its own remembered choice, apart from the other workspace pages. *@
<div class="command-workspace @(deck is null ? "is-nav-expanded" : null) command-workspace--briefing-decks" data-command-workspace
     data-workspace-nav-scope="@(deck is null ? null : "studio")">
    @await Html.PartialAsync("/Pages/Workspace/_CommandWorkspaceRail.cshtml", Model.CommandRail)

    <main class="cw-workspace-content pbd-shell" data-pbd-root
          data-search-url="@Url.Page("/Workspace/BriefingDecks/Index", "SearchProjects")"
          data-reorder-url="@Url.Page("/Workspace/BriefingDecks/Index", "Reorder")"
          data-membership-url="@Url.Page("/Workspace/BriefingDecks/Index", "UpdateMembership")"
          data-description-url="@Url.Page("/Workspace/BriefingDecks/Index", "UpdateDescription")"
          data-item-presentation-url="@Url.Page("/Workspace/BriefingDecks/Index", "UpdateItemPresentation")"
          data-item-photo-url="@Url.Page("/Workspace/BriefingDecks/Index", "UpdateItemPhoto")"
          data-speaker-notes-url="@Url.Page("/Workspace/BriefingDecks/Index", "UpdateSpeakerNotes")"
          data-photo-options-url="@Url.Page("/Workspace/BriefingDecks/Index", "PhotoOptions")"
          data-preset-url="@Url.Page("/Workspace/BriefingDecks/Index", "ApplyPreset")">
        <form method="post" class="pbd-antiforgery" aria-hidden="true">
            @Html.AntiForgeryToken()
        </form>

        @if (deck is null)
        {
            <header class="pbd-page-header">
                <div>
                    <span class="pbd-eyebrow">Command workspace</span>
                    <h1>Briefing decks</h1>
                    <p>Shared decks for the Comdt and HoDs, built from current PRISM data each time they are generated.</p>
                </div>
                <div class="pbd-page-header__actions">
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#pbd-new-deck-modal">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        New deck
                    </button>
                </div>
            </header>
        }
        else
        {
            <nav class="pbd-studio-nav" aria-label="Briefing decks">
                <a class="pbd-studio-nav__back" href="@Url.Content("~/Workspace/BriefingDecks")">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    Briefing decks
                </a>
                <div class="pbd-studio-nav__actions">
                    @if (Model.Decks.Count > 1)
                    {
                        <div class="dropdown">
                            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-collection" aria-hidden="true"></i>
                                Switch deck
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end pbd-studio-nav__decks">
                                @foreach (var saved in Model.Decks)
                                {
                                    var isCurrent = saved.Id == deck.Id;
                                    <li>
                                        <a class="dropdown-item @(isCurrent ? "active" : null)" aria-current="@(isCurrent ? "page" : null)"
                                           asp-page="/Workspace/BriefingDecks/Index" asp-route-deckId="@saved.Id">
                                            <strong>@saved.Name</strong>
                                            <small>@saved.Purpose · @saved.ProjectCount @(saved.ProjectCount == 1 ? "project" : "projects")</small>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#pbd-new-deck-modal">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        New deck
                    </button>
                </div>
            </nav>
        }

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-success pbd-alert" role="status" data-pbd-auto-dismiss>
                <i class="bi bi-check-circle" aria-hidden="true"></i>
                <span>@Model.StatusMessage</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger pbd-alert" role="alert">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                <span>@Model.ErrorMessage</span>
            </div>
        }
        @if (deck is not null && Model.PresetUndoAvailable)
        {
            <form method="post" asp-page-handler="UndoPreset" class="alert alert-info pbd-alert pbd-undo" role="status" data-pbd-preset-undo>
                <input type="hidden" name="deckId" value="@deck.Id" />
                <i class="bi bi-magic" aria-hidden="true"></i>
                <span>Template applied: @(deck.Preset is { } applied ? ProjectBriefingDeckPresets.Get(applied).Title : "settings changed").</span>
                <button type="submit" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Undo
                </button>
            </form>
        }
        @if (!string.IsNullOrWhiteSpace(Model.DeckNotFoundMessage))
        {
            <div class="alert alert-warning pbd-alert" role="alert">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                <span>@Model.DeckNotFoundMessage</span>
            </div>
        }

        @if (deck is null && Model.Decks.Count == 0)
        {
            <section class="pbd-first-use" aria-labelledby="pbd-first-use-title">
                <span class="pbd-first-use__icon" aria-hidden="true"><i class="bi bi-file-earmark-slides"></i></span>
                <div>
                    <span class="pbd-eyebrow">No saved decks</span>
                    <h2 id="pbd-first-use-title">Create your first project briefing deck</h2>
                    <p>A shared command deck retains project membership and slide order while stage, cost and external status are refreshed from current PRISM data whenever the PowerPoint is generated.</p>
                </div>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#pbd-new-deck-modal">
                    Create deck
                </button>
            </section>
            <partial name="_DeletedDecks" model="Model.DeletedDecks" />
        }
        else if (deck is null)
        {
            <div class="pbd-library">
                <partial name="_DeckLibrary" model="Model" />
            </div>
        }
        else
        {
            <div class="pbd-workspace">

                @if (deck is not null)
                {
                    <section class="pbd-editor" aria-labelledby="pbd-deck-title" data-deck-id="@deck.Id">
                        <header class="pbd-deck-header">
                            <div class="pbd-deck-header__identity">
                                <span class="pbd-deck-header__mark" aria-hidden="true"><i class="bi bi-easel2"></i></span>
                                <div>
                                    <span class="pbd-eyebrow">Briefing deck</span>
                                    <div class="pbd-deck-title" data-pbd-deck-title-view>
                                        <h2 id="pbd-deck-title" data-pbd-deck-name>@deck.Name</h2>
                                        <button type="button" class="btn btn-sm btn-link pbd-deck-title__edit" data-pbd-rename aria-label="Rename the deck or edit its description" title="Rename or edit description">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </button>
                                        @* How the deck behaves, where it matters: changes save at once, and the deck is shared. *@
                                        <span class="pbd-saved-chip" data-pbd-saved-chip title="Changes save as you go. Every Comdt and HoD workspace user can open and edit this deck.">
                                            <i class="bi bi-cloud-check" aria-hidden="true"></i>
                                            <span data-pbd-saved-chip-text>Saved · shared</span>
                                            <span class="visually-hidden">: changes save as you go, and every Comdt and HoD workspace user can open and edit this deck.</span>
                                        </span>
                                    </div>
                                    <p data-pbd-deck-description @(string.IsNullOrWhiteSpace(deck.Description) ? "hidden" : null)>@deck.Description</p>
                                    <form class="pbd-deck-rename" data-pbd-rename-form hidden>
                                        <label class="visually-hidden" for="pbd-rename-name">Deck name</label>
                                        <input id="pbd-rename-name" class="form-control" maxlength="160" required data-pbd-rename-name />
                                        <label class="visually-hidden" for="pbd-rename-description">Description</label>
                                        <input id="pbd-rename-description" class="form-control form-control-sm" maxlength="600" placeholder="Description (optional): purpose, audience or occasion" data-pbd-rename-description />
                                        <div class="pbd-deck-rename__actions">
                                            <button type="submit" class="btn btn-sm btn-primary">Save</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" data-pbd-rename-cancel>Cancel</button>
                                        </div>
                                    </form>
                                    <small class="pbd-deck-header__meta">Updated @IstClock.ToIst(deck.UpdatedAtUtc).ToString("dd MMM yyyy, HH:mm") by @deck.LastModifiedByDisplay</small>
                                </div>
                            </div>
                            <div class="pbd-deck-header__actions">
                                <div class="pbd-generate-action">
                                    <form method="post" asp-page-handler="Generate" data-pbd-generate-form>
                                        <input type="hidden" name="deckId" value="@deck.Id" />
                                        <button type="submit" class="btn btn-primary" disabled="@(presentedProjects!.Length == 0)" data-pbd-generate>
                                            <span data-pbd-generate-label><i class="bi bi-file-earmark-ppt" aria-hidden="true"></i> Generate PowerPoint</span>
                                            <span class="d-none" data-pbd-generate-progress><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Generating…</span>
                                        </button>
                                    </form>
                                    <small data-pbd-placeholder-note hidden>Missing content uses defined placeholders.</small>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Deck actions">
                                        <i class="bi bi-three-dots" aria-hidden="true"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <form method="post" asp-page-handler="Duplicate">
                                                <input type="hidden" name="deckId" value="@deck.Id" />
                                                <button type="submit" class="dropdown-item"><i class="bi bi-copy" aria-hidden="true"></i> Duplicate deck</button>
                                            </form>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#pbd-delete-deck-modal">
                                                <i class="bi bi-trash" aria-hidden="true"></i> Delete deck
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </header>
                        @* The order of work, each step opening where it is done (docs/ux/briefing-decks.md, Studio usability PR 3). *@
                        <nav class="pbd-progress" aria-label="Deck progress" data-pbd-progress>
                            <ol>
                                <li class="@(deck.Projects.Count > 0 ? "is-done" : "is-next")" data-pbd-progress-step="projects">
                                    <button type="button" data-pbd-open-selector>
                                        <span class="pbd-progress__label">Projects</span>
                                        <span class="pbd-progress__value" data-pbd-progress-projects>@(deck.Projects.Count == 0 ? "Add" : deck.Projects.Count.ToString())</span>
                                    </button>
                                </li>
                                <li class="@(presentedProjects!.Length == 0 ? null : openCheckCount == 0 ? "is-done" : "is-open")" data-pbd-progress-step="checks">
                                    <button type="button" data-pbd-progress-tab="checks">
                                        <span class="pbd-progress__label">Checks</span>
                                        <span class="pbd-progress__value" data-pbd-progress-checks>@(presentedProjects.Length == 0 ? "–" : openCheckCount == 0 ? "All recorded" : $"{openCheckCount} to review")</span>
                                    </button>
                                </li>
                                <li class="is-done" data-pbd-progress-step="template">
                                    <button type="button" data-pbd-progress-tab="deck">
                                        <span class="pbd-progress__label">Settings</span>
                                        <span class="pbd-progress__value" data-pbd-progress-template>@templateTitle@(templateCustomised ? ", customised" : null)</span>
                                    </button>
                                </li>
                                <li class="@(presentedProjects.Length > 0 ? "is-ready" : null)" data-pbd-progress-step="generate">
                                    <button type="button" data-pbd-progress-generate>
                                        <span class="pbd-progress__label">Generate</span>
                                        <span class="pbd-progress__value">PowerPoint</span>
                                    </button>
                                </li>
                            </ol>
                        </nav>
                        <div class="pbd-model-note" role="note" data-pbd-model-note hidden>
                            <i class="bi bi-info-circle" aria-hidden="true"></i>
                            <p>The slides are rebuilt from live PRISM data each time, so stages, costs and status are always current. Changes here save as you go and are shared with every Comdt and HoD workspace user.</p>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-pbd-model-note-dismiss>Got it</button>
                        </div>
                        <div class="pbd-generate-status" data-pbd-generate-status aria-live="polite"></div>

                        <div class="alert alert-warning pbd-conflict" role="alert" data-pbd-conflict hidden>
                            <i class="bi bi-people" aria-hidden="true"></i>
                            <span data-pbd-conflict-text>Someone else changed this deck. Reload to see their changes; your last change was not saved.</span>
                            <button type="button" class="btn btn-sm btn-warning" data-pbd-conflict-reload>Reload</button>
                        </div>

                        @* The frame is the size container the Studio's columns follow. *@
                        <div class="pbd-studio-frame">
                        <section class="pbd-studio" aria-label="Briefing studio" data-pbd-studio
                                 data-preview-url="@Url.Page("/Workspace/BriefingDecks/Index", "Preview", new { deckId = deck.Id })"
                                 data-estimated-slides="@deck.SlideEstimate.TotalSlides"
                                 data-layout="@deck.Layout"
                                 data-presentation-mode="@deck.PresentationMode"
                                 data-has-projects="@((presentedProjects!.Length > 0).ToString().ToLowerInvariant())"
                                 data-uses-capability="@((!isUpdateSheet && standardNeedsCapabilities && standardIncludesDetailedSlides).ToString().ToLowerInvariant())"
                                 data-uses-brief="@((isUpdateSheet || (standardNeedsProjectBrief && standardIncludesDetailedSlides)).ToString().ToLowerInvariant())"
                                 data-pbd-open-settings="@(deck.Projects.Count == 0 ? "true" : "false")"
                                 data-pbd-start="@(Model.StartWithAddProjects ? "projects" : null)">
                            <script type="application/json" data-pbd-studio-data>@Html.Raw(studioDataJson)</script>

                            <aside class="pbd-studio__outline" aria-labelledby="pbd-outline-title">
                                <header class="pbd-outline__header">
                                    <h3 id="pbd-outline-title">Slides <span data-pbd-studio-count>@(presentedProjects!.Length == 0 ? null : deck.SlideEstimate.TotalSlides)</span></h3>
                                    <div class="pbd-outline__actions">
                                        @* Phones: the outline folds into a sheet under the slide (Studio usability PR 5). *@
                                        <button type="button" class="btn btn-sm btn-outline-secondary pbd-outline__toggle" aria-expanded="false" aria-controls="pbd-outline-sheet" data-pbd-outline-toggle>
                                            <i class="bi bi-list-ul" aria-hidden="true"></i> <span data-pbd-outline-toggle-text>Show slides</span>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-pbd-open-selector>
                                            <i class="bi bi-plus-lg" aria-hidden="true"></i> Projects
                                        </button>
                                        @if (missingAdditionalSlideTypes.Length > 0)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#pbd-additional-slide-library-modal">
                                                <i class="bi bi-plus-lg" aria-hidden="true"></i> Slide
                                            </button>
                                        }
                                    </div>
                                </header>
                                <label class="pbd-outline__search">
                                    <span class="visually-hidden">Find a slide or project</span>
                                    <i class="bi bi-search" aria-hidden="true"></i>
                                    <input type="search" class="form-control form-control-sm" placeholder="Find a slide or project" autocomplete="off" data-pbd-outline-search />
                                </label>
                                <p class="pbd-outline__status" data-pbd-membership-status aria-live="polite"></p>
                                <div class="pbd-outline__filter" data-pbd-outline-filter hidden>
                                    <span data-pbd-outline-filter-text></span>
                                    <button type="button" class="btn btn-sm btn-link" data-pbd-outline-filter-clear>Show all</button>
                                </div>
                                <nav class="pbd-outline__list" id="pbd-outline-sheet" aria-label="Slides in deck order" data-pbd-outline>
                                    <p class="pbd-outline__empty">Building the slide list…</p>
                                </nav>
                            </aside>

                            <div class="pbd-studio__stage" data-pbd-stage>
                                <header class="pbd-stage__bar">
                                    <div class="pbd-stage__heading">
                                        <span class="pbd-eyebrow" data-pbd-stage-meta>Slide preview</span>
                                        <h3 data-pbd-stage-title>@deck.Name</h3>
                                    </div>
                                    <div class="pbd-stage__tools">
                                        <div class="pbd-segmented" role="group" aria-label="View">
                                            <button type="button" class="is-active" aria-pressed="true" data-pbd-stage-view="slide">Slide</button>
                                            <button type="button" aria-pressed="false" data-pbd-stage-view="grid">All slides</button>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-pbd-stage-prev aria-label="Previous slide" aria-keyshortcuts="ArrowLeft"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-pbd-stage-next aria-label="Next slide" aria-keyshortcuts="ArrowRight"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-pbd-preview-refresh aria-label="Rebuild the slides from current PRISM data" title="Rebuild from current PRISM data"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button>
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-pbd-preview-open disabled><i class="bi bi-play-fill" aria-hidden="true"></i> Present</button>
                                    </div>
                                </header>
                                <p class="pbd-stage__status" data-pbd-preview-status aria-live="polite">Building the slides from current PRISM data…</p>
                            <div class="alert alert-warning pbd-alert pbd-stage__notice" role="status" data-pbd-left-out-notice hidden="@(leftOutProjectCount == 0)">
                                <i class="bi bi-archive" aria-hidden="true"></i>
                                <span data-pbd-left-out-text>@leftOutProjectCount @(leftOutProjectCount == 1 ? "project in this deck is" : "projects in this deck are") deleted or archived and will be left out of the PowerPoint. Remove @(leftOutProjectCount == 1 ? "it" : "them") from the deck, or restore the project to include it again.</span>
                                @* These projects have no slides, so the outline cannot reach them; remove them here. *@
                                <button type="button" class="btn btn-sm btn-outline-danger" data-pbd-remove-left-out>Remove from deck</button>
                            </div>
                                <div class="pbd-stage__slide" data-pbd-stage-slide></div>
                                <ol class="pbd-stage__grid" data-pbd-stage-grid aria-label="All slides" hidden></ol>
                            </div>

                            <aside class="pbd-studio__inspector" aria-label="Inspector">
                                <div class="pbd-inspector__tabs" role="tablist" aria-label="Inspector">
                                    <button type="button" role="tab" id="pbd-inspector-tab-slide" class="is-active" aria-selected="true" aria-controls="pbd-inspector-slide" data-pbd-inspector-tab="slide">This slide</button>
                                    <button type="button" role="tab" id="pbd-inspector-tab-deck" aria-selected="false" aria-controls="pbd-inspector-deck" data-pbd-inspector-tab="deck" tabindex="-1">Deck</button>
                                    <button type="button" role="tab" id="pbd-inspector-tab-checks" aria-selected="false" aria-controls="pbd-inspector-checks" data-pbd-inspector-tab="checks" tabindex="-1">Checks <span class="pbd-inspector__badge" data-pbd-checks-badge hidden></span></button>
                                </div>

                                <div id="pbd-inspector-slide" role="tabpanel" aria-labelledby="pbd-inspector-tab-slide" class="pbd-inspector__panel" data-pbd-inspector-panel="slide">
                                    <p class="pbd-inspector__empty">Select a slide in the outline.</p>
                                </div>

                                <div id="pbd-inspector-deck" role="tabpanel" aria-labelledby="pbd-inspector-tab-deck" class="pbd-inspector__panel" data-pbd-inspector-panel="deck" hidden>
                                    @* Template: the purpose presets, as one compact picker (docs/ux/briefing-decks.md, Plan: Deck settings). *@
                                    <h4 class="pbd-inspector__heading pbd-inspector__heading--first" id="pbd-template-heading">Template</h4>
                                    <div class="pbd-template-picker" data-pbd-template-picker>
                                        <button type="button" class="pbd-template-picker__current" aria-expanded="false" aria-controls="pbd-template-list" data-pbd-template-toggle>
                                            <span class="pbd-template-picker__text">
                                                <strong data-pbd-template-current>@templateTitle</strong>
                                                <small data-pbd-preset-status>@presetStatus</small>
                                            </span>
                                            <span class="pbd-template-picker__badge" data-pbd-template-customised hidden="@(!templateCustomised)">customised</span>
                                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                        </button>
                                        <div class="pbd-presets" id="pbd-template-list" role="group" aria-labelledby="pbd-template-heading" data-pbd-template-list hidden>
                                            @foreach (var preset in ProjectBriefingDeckPresets.All)
                                            {
                                                var isCurrent = deck.Preset == preset.Preset;
                                                <button type="button" class="pbd-preset @(isCurrent ? "is-current" : null)" data-pbd-preset="@preset.Preset" aria-pressed="@(isCurrent ? "true" : "false")">
                                                    <strong>@preset.Title</strong>
                                                    <small>@preset.Summary</small>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                    <p class="pbd-settings-save-status" data-pbd-settings-status aria-live="polite">Changes save as you make them.</p>
                                    <form method="post" asp-page-handler="SaveSettings" id="pbd-settings-form" class="pbd-settings__form pbd-deck-settings" data-pbd-settings-form>
                                        <input type="hidden" name="DeckId" value="@deck.Id" />
                                        <input type="hidden" name="RowVersion" value="@deck.RowVersion" />
                                        <input type="hidden" name="Name" value="@deck.Name" data-pbd-settings-name />
                                        <input type="hidden" name="Description" value="@deck.Description" data-pbd-settings-description />

                                    @* Settings as numbered steps, one open at a time. A closed step shows a one-line summary
                                       of its choices; a step that does not apply to the earlier choices is hidden. *@
                                    <div class="pbd-steps" data-pbd-steps>
                                    <details class="pbd-step" data-pbd-step="slides" data-pbd-settings-collapsible data-pbd-settings-section="slides">
                                        <summary>
                                            <span class="pbd-step__number" data-pbd-step-number aria-hidden="true">1</span>
                                            <span class="pbd-step__text"><strong>Slides</strong><small data-pbd-step-summary></small></span>
                                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                        </summary>
                                        <div class="pbd-step__body">
                                <fieldset class="pbd-choice-group">
                                    <legend>Layout</legend>
                                            <div class="pbd-seg">
                                                <label class="pbd-seg__option"><input type="radio" name="Layout" value="StandardBriefing" checked="@(deck.Layout == ProjectBriefingLayout.StandardBriefing)" data-help="Status table, summaries and slides for each project." data-pbd-layout-choice /><span>Standard briefing</span></label>
                                                <label class="pbd-seg__option"><input type="radio" name="Layout" value="ProjectUpdateSheet" checked="@(deck.Layout == ProjectBriefingLayout.ProjectUpdateSheet)" data-help="One formal sheet per project: facts, brief and photograph." data-pbd-layout-choice /><span>Update sheets</span></label>
                                            </div>
                                            <p class="pbd-seg-help" data-pbd-seg-help="Layout"></p>
                                </fieldset>
                                <div data-pbd-standard-settings hidden="@isUpdateSheet">
                                    <fieldset class="pbd-choice-group">
                                        <legend>What the deck shows</legend>
                                            <div class="pbd-seg">
                                                <label class="pbd-seg__option"><input type="radio" name="PresentationMode" value="ExecutiveTable" checked="@(deck.PresentationMode == ProjectBriefingPresentationMode.ExecutiveTable)" data-help="One status table of projects; no slides per project." /><span>Table</span></label>
                                                <label class="pbd-seg__option"><input type="radio" name="PresentationMode" value="DetailedProjects" checked="@(deck.PresentationMode == ProjectBriefingPresentationMode.DetailedProjects)" data-help="Slides for each project; no status table." /><span>Project slides</span></label>
                                                <label class="pbd-seg__option"><input type="radio" name="PresentationMode" value="Combined" checked="@(deck.PresentationMode == ProjectBriefingPresentationMode.Combined)" data-help="The status table first, then slides for each project." /><span>Both</span></label>
                                            </div>
                                            <p class="pbd-seg-help" data-pbd-seg-help="PresentationMode"></p>
                                    </fieldset>

                                    <fieldset class="pbd-choice-group" data-pbd-project-content-settings hidden="@(!standardIncludesDetailedSlides)">
                                        <legend>Each project gets</legend>
                                            <div class="pbd-seg">
                                                <label class="pbd-seg__option"><input type="radio" name="NarrativeMode" value="CapabilityOverview" checked="@(deck.NarrativeMode == ProjectBriefingNarrativeMode.CapabilityOverview)" data-help="One slide of capability statements per project." /><span>Capability</span></label>
                                                <label class="pbd-seg__option"><input type="radio" name="NarrativeMode" value="ProjectBrief" checked="@(deck.NarrativeMode == ProjectBriefingNarrativeMode.ProjectBrief)" data-help="One narrative slide per project." /><span>Brief</span></label>
                                                <label class="pbd-seg__option"><input type="radio" name="NarrativeMode" value="Both" checked="@(deck.NarrativeMode == ProjectBriefingNarrativeMode.Both)" data-help="A capability slide, then a brief slide, per project." /><span>Both</span></label>
                                            </div>
                                            <p class="pbd-seg-help" data-pbd-seg-help="NarrativeMode"></p>
                                    </fieldset>
                                </div>
                                        </div>
                                    </details>

                                    <details class="pbd-step" data-pbd-step="project" data-pbd-settings-collapsible data-pbd-settings-section="project" data-pbd-project-slides-step hidden="@(isUpdateSheet || !standardIncludesDetailedSlides)">
                                        <summary>
                                            <span class="pbd-step__number" data-pbd-step-number aria-hidden="true">2</span>
                                            <span class="pbd-step__text"><strong>Project slides</strong><small data-pbd-step-summary></small></span>
                                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                        </summary>
                                        <div class="pbd-step__body">
                                    <div class="pbd-standard-detail-options" data-pbd-detailed-settings hidden="@(!standardIncludesDetailedSlides)">
                                        <fieldset class="pbd-choice-group">
                                            <legend>Show on each project slide</legend>
                                            <div class="pbd-chips">
                                                <label class="pbd-chip">
                                                    <input type="checkbox" name="ShowPresentStage" value="true" checked="@deck.StandardSlideOptions.ShowPresentStage" />
                                                    <span>Present stage</span>
                                                    <input type="hidden" name="ShowPresentStage" value="false" />
                                                </label>
                                                <label class="pbd-chip">
                                                    <input type="checkbox" name="ShowPresentStatus" value="true" checked="@deck.StandardSlideOptions.ShowPresentStatus" />
                                                    <span>Status remark</span>
                                                    <input type="hidden" name="ShowPresentStatus" value="false" />
                                                </label>
                                            </div>
                                        </fieldset>

                                        @{
                                            var keyPointPlacement = deck.StandardSlideOptions.KeyPoints;
                                            var keyPointsOn = keyPointPlacement != ProjectBriefingKeyPointPlacement.None;
                                            var keyPointsOnCapability = keyPointPlacement == ProjectBriefingKeyPointPlacement.CapabilitySlide
                                                && deck.NarrativeMode == ProjectBriefingNarrativeMode.Both;
                                        }
                                        <fieldset class="pbd-choice-group" data-pbd-key-point-settings>
                                            <legend class="visually-hidden">Key points</legend>
                                            <label class="pbd-switch">
                                                <input type="checkbox" role="switch" name="ShowKeyPoints" value="true" checked="@keyPointsOn" data-pbd-key-points-toggle />
                                                <span class="pbd-switch__track" aria-hidden="true"></span>
                                                <span class="pbd-switch__text"><strong>Key points</strong><small>Five short points per project, in a band at the foot of the slide, with a larger photograph.</small></span>
                                                <input type="hidden" name="ShowKeyPoints" value="false" />
                                            </label>
                                            <div class="pbd-seg pbd-key-point-slide" role="radiogroup" aria-label="Slide that shows the key points" data-pbd-key-point-slide hidden="@(!keyPointsOn || deck.NarrativeMode != ProjectBriefingNarrativeMode.Both)">
                                                <label class="pbd-seg__option"><input type="radio" name="KeyPointSlide" value="ProjectBriefSlide" checked="@(!keyPointsOnCapability)" /><span>On the brief slide</span></label>
                                                <label class="pbd-seg__option"><input type="radio" name="KeyPointSlide" value="CapabilitySlide" checked="@keyPointsOnCapability" /><span>On the capability slide</span></label>
                                            </div>
                                        </fieldset>

                                        @* The key points layout draws its own brief slide, so the brief layout only matters without key points. *@
                                        <fieldset class="pbd-choice-group" data-pbd-project-brief-layout-settings hidden="@(!standardNeedsProjectBrief || deck.StandardSlideOptions.KeyPoints != ProjectBriefingKeyPointPlacement.None)">
                                            <legend>Project Brief layout</legend>
                                            <div class="pbd-seg">
                                                <label class="pbd-seg__option"><input type="radio" name="ProjectBriefLayout" value="Automatic" checked="@(deck.StandardSlideOptions.ProjectBriefLayout == ProjectBriefingProjectBriefLayout.Automatic)" data-help="Photo emphasis when the photograph and brief suit it, otherwise standard." data-label="Automatic" /><span>Automatic</span></label>
                                                <label class="pbd-seg__option"><input type="radio" name="ProjectBriefLayout" value="Standard" checked="@(deck.StandardSlideOptions.ProjectBriefLayout == ProjectBriefingProjectBriefLayout.Standard)" data-help="A compact photograph beside a wide brief." data-label="Standard" /><span>Standard</span></label>
                                                <label class="pbd-seg__option"><input type="radio" name="ProjectBriefLayout" value="PhotoEmphasis" checked="@(deck.StandardSlideOptions.ProjectBriefLayout == ProjectBriefingProjectBriefLayout.PhotoEmphasis)" data-help="The photograph takes about half the slide." data-label="Photo emphasis" /><span>Photo</span></label>
                                            </div>
                                            <p class="pbd-seg-help" data-pbd-seg-help="ProjectBriefLayout"></p>
                                        </fieldset>
                                    </div>
                                        </div>
                                    </details>

                                    <details class="pbd-step" data-pbd-step="sheet" data-pbd-settings-collapsible data-pbd-settings-section="sheet" data-pbd-update-settings hidden="@(!isUpdateSheet)">
                                        <summary>
                                            <span class="pbd-step__number" data-pbd-step-number aria-hidden="true">2</span>
                                            <span class="pbd-step__text"><strong>Sheet rows</strong><small data-pbd-step-summary></small></span>
                                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                        </summary>
                                        <div class="pbd-step__body">
                                <div class="pbd-update-sheet-composition">
                                    <div class="pbd-update-sheet-composition__intro">
                                        <div>
                                            <strong>Rows on each sheet</strong>
                                            <small>Tick and order the rows. The project name stays the title; the photograph and brief fit around the table.</small>
                                        </div>
                                        <div class="pbd-update-sheet-composition__actions">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" data-pbd-update-rows-select-all>Select all</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" data-pbd-update-rows-reset>Recommended defaults</button>
                                        </div>
                                    </div>
                                    <input type="hidden" name="UpdateSheetRowOrder" value="@updateSheetRowOrder" data-recommended-order="@string.Join(",", ProjectBriefingUpdateSheetOptions.RecommendedRows)" data-pbd-update-row-order />
                                    <div class="pbd-update-row-list" data-pbd-update-row-list>
                                        @foreach (var row in orderedUpdateSheetRows)
                                        {
                                            <div class="pbd-update-row-option" data-pbd-update-row data-row-key="@row">
                                                <span class="pbd-update-row-option__handle" aria-hidden="true"><i class="bi bi-grip-vertical"></i></span>
                                                <label>
                                                    <input type="checkbox" name="UpdateSheetRows" value="@row" checked="@selectedUpdateSheetRows.Contains(row)" />
                                                    <span><strong>@UpdateSheetRowLabel(row)</strong><small>@UpdateSheetRowDescription(row)</small></span>
                                                </label>
                                                <span class="pbd-update-row-option__move">
                                                    <button type="button" class="btn btn-sm btn-light" data-pbd-update-row-up aria-label="Move @UpdateSheetRowLabel(row) up"><i class="bi bi-arrow-up" aria-hidden="true"></i></button>
                                                    <button type="button" class="btn btn-sm btn-light" data-pbd-update-row-down aria-label="Move @UpdateSheetRowLabel(row) down"><i class="bi bi-arrow-down" aria-hidden="true"></i></button>
                                                </span>
                                            </div>
                                        }
                                    </div>
                                    <label class="pbd-update-sheet-hide-empty">
                                        <input type="checkbox" name="HideEmptyUpdateSheetValues" value="true" checked="@deck.UpdateSheetOptions.HideEmptyValues" />
                                        <span><strong>Hide rows with nothing recorded</strong><small>The PDC or completion row stays, as a cell to fill in.</small></span>
                                    </label>
                                    <p class="pbd-update-sheet-composition__validation" data-pbd-update-rows-validation hidden>Select at least one information row.</p>
                                </div>
                                        </div>
                                    </details>

                                    <details class="pbd-step" data-pbd-step="cost" data-pbd-settings-collapsible data-pbd-settings-section="cost" data-pbd-standard-section hidden="@isUpdateSheet">
                                        <summary>
                                            <span class="pbd-step__number" data-pbd-step-number aria-hidden="true">3</span>
                                            <span class="pbd-step__text"><strong>Cost</strong><small data-pbd-step-summary></small></span>
                                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                        </summary>
                                        <div class="pbd-step__body">
                                <fieldset class="pbd-choice-group">
                                    <legend>Cost shown on slides</legend>
                                            <div class="pbd-seg pbd-seg--grid">
                                                <label class="pbd-seg__option"><input type="radio" name="CostMode" value="CostRdOnly" checked="@(deck.CostMode == ProjectBriefingCostMode.CostRdOnly)" data-help="The R&amp;D cost with its basis: PNC, L1, AoN or IPA." /><span>Cost (R&amp;D)</span></label>
                                                <label class="pbd-seg__option"><input type="radio" name="CostMode" value="ProliferationOnly" checked="@(deck.CostMode == ProjectBriefingCostMode.ProliferationOnly)" data-help="The latest indicative proliferation cost." /><span>Proliferation</span></label>
                                                <label class="pbd-seg__option"><input type="radio" name="CostMode" value="Both" checked="@(deck.CostMode == ProjectBriefingCostMode.Both)" data-help="R&amp;D and proliferation cost, shown separately." /><span>Both</span></label>
                                                <label class="pbd-seg__option"><input type="radio" name="CostMode" value="None" checked="@(deck.CostMode == ProjectBriefingCostMode.None)" data-help="No cost anywhere in the deck." /><span>None</span></label>
                                            </div>
                                            <p class="pbd-seg-help" data-pbd-seg-help="CostMode"></p>
                                </fieldset>
                                        </div>
                                    </details>

                                    <details class="pbd-step" data-pbd-step="extra" data-pbd-settings-collapsible data-pbd-settings-section="extra">
                                        <summary>
                                            <span class="pbd-step__number" data-pbd-step-number aria-hidden="true">4</span>
                                            <span class="pbd-step__text"><strong>Extra slides</strong><small data-pbd-step-summary></small></span>
                                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                        </summary>
                                        <div class="pbd-step__body">
                                <fieldset class="pbd-choice-group pbd-update-sheet-options" data-pbd-update-settings hidden="@(!isUpdateSheet)">
                                    <legend>Opening slides</legend>
                                    <div class="pbd-checks pbd-checks--inline">
                                        <label><input type="checkbox" name="IncludeCoverSlide" value="true" checked="@deck.IncludeCoverSlide" /> Cover slide</label>
                                        <label><input type="checkbox" name="IncludePortfolioSummarySlide" value="true" checked="@deck.IncludePortfolioSummarySlide" /> Portfolio summary</label>
                                    </div>
                                </fieldset>
                                    <fieldset class="pbd-checks" data-pbd-standard-settings hidden="@isUpdateSheet">
                                        <legend>Summary slides</legend>
                                        <label><input type="checkbox" name="IncludeStageSummary" value="true" checked="@deck.IncludeStageSummary" data-pbd-stage-summary-toggle /> Stage-wise summary <small>recommended chart</small></label>
                                        <label class="pbd-summary-dependent-option" data-pbd-stage-table-option><input type="checkbox" name="IncludeStageDistributionTable" value="true" checked="@deck.StandardSlideOptions.IncludeStageDistributionTable" data-pbd-stage-table-toggle /> Stage-wise distribution table <small>optional supporting slide</small></label>
                                        <label><input type="checkbox" name="IncludeProjectCategorySummary" value="true" checked="@deck.IncludeProjectCategorySummary" /> Project-category summary <small>left out when every project shares one category</small></label>
                                        <label><input type="checkbox" name="IncludeTechnicalCategorySummary" value="true" checked="@deck.IncludeTechnicalCategorySummary" /> Technical-category summary <small>left out when every project shares one category</small></label>
                                    </fieldset>
                                    <section class="pbd-additional-slides" id="pbd-additional-slides" aria-labelledby="pbd-additional-slides-title" data-pbd-additional-slides>
                                        <div class="pbd-additional-slides__head">
                                            <h5 id="pbd-additional-slides-title">Institution slides</h5>
                                            @if (missingAdditionalSlideTypes.Length > 0)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-link"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#pbd-additional-slide-library-modal"
                                                        title="Add an approved slide type">
                                                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Add slide
                                                </button>
                                            }
                                        </div>
                                        @if (additionalSlideOrder.Count == 0)
                                        {
                                            <p class="pbd-additional-slides__empty">None added. Add the SDD profile, Role &amp; Charter or FFC footprint when the briefing needs them.</p>
                                        }
                                        else
                                        {
                                            <div class="pbd-additional-slide-list" data-pbd-additional-slide-list>
                                                @for (var slideIndex = 0; slideIndex < additionalSlideOrder.Count; slideIndex++)
                                                {
                                                    var slideType = additionalSlideOrder[slideIndex];
                                                    var enabled = AdditionalSlideIsEnabled(slideType);
                                                    var definition = AdditionalSlideDefinition(slideType);
                                                    var canReorder = definition.CanReorder;
                                                    var detail = slideType switch
                                                    {
                                                        ProjectBriefingAdditionalSlideType.InstitutionalProfile => $"After the cover · {institutionalProfile.Modules.Count} modules",
                                                        ProjectBriefingAdditionalSlideType.RoleAndCharter => $"After the cover · {deck.SlideEstimate.RoleCharterSlides} slide{(deck.SlideEstimate.RoleCharterSlides == 1 ? string.Empty : "s")}",
                                                        ProjectBriefingAdditionalSlideType.FfcGlobalFootprint => enabled
                                                            ? $"Before closing · {deck.SlideEstimate.FfcGlobalFootprintSlides} slide{(deck.SlideEstimate.FfcGlobalFootprintSlides == 1 ? string.Empty : "s")}"
                                                            : "Before closing",
                                                        _ => string.Empty
                                                    };
                                                    var slideKey = slideType.ToString();
                                                    <article class="pbd-additional-slide-row @(enabled ? "is-enabled" : "is-disabled")"
                                                             data-pbd-additional-slide-card
                                                             data-can-reorder="@canReorder.ToString().ToLowerInvariant()"
                                                             data-slide-type="@slideType"
                                                             data-slide-name="@AdditionalSlideDisplayName(slideType)">
                                                        @if (canReorder)
                                                        {
                                                            <button type="button" class="pbd-additional-slide-row__handle" data-pbd-additional-slide-handle aria-label="Drag @AdditionalSlideDisplayName(slideType) to reorder">
                                                                <i class="bi bi-grip-vertical" aria-hidden="true"></i>
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <span class="pbd-additional-slide-row__handle" title="Fixed immediately before the closing slide" aria-hidden="true"><i class="bi bi-pin-angle" aria-hidden="true"></i></span>
                                                        }
                                                        <label class="pbd-switch pbd-additional-slide-row__switch">
                                                            <input type="checkbox" role="switch" form="pbd-additional-slide-toggle-@slideKey" checked="@enabled" data-pbd-additional-slide-toggle />
                                                            <span class="pbd-switch__track" aria-hidden="true"></span>
                                                            <span class="pbd-switch__text"><strong>@AdditionalSlideDisplayName(slideType)</strong><small>@detail</small></span>
                                                        </label>
                                                        @if (slideType == ProjectBriefingAdditionalSlideType.InstitutionalProfile)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-link" data-pbd-profile-open aria-controls="pbd-institutional-profile-drawer" aria-expanded="false">Edit</button>
                                                        }
                                                        else if (slideType == ProjectBriefingAdditionalSlideType.RoleAndCharter)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-link" data-pbd-role-charter-open aria-controls="pbd-role-charter-drawer" aria-expanded="false">Edit</button>
                                                        }
                                                        else if (slideType == ProjectBriefingAdditionalSlideType.FfcGlobalFootprint)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-link" data-pbd-ffc-footprint-open aria-controls="pbd-ffc-footprint-drawer" aria-expanded="false">Edit</button>
                                                        }
                                                        <button type="submit" form="pbd-additional-slide-remove-@slideKey" class="btn btn-sm btn-link text-danger pbd-additional-slide-row__remove" title="Remove from this deck" aria-label="Remove @AdditionalSlideDisplayName(slideType)">
                                                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                                                        </button>
                                                    </article>
                                                }
                                            </div>
                                        }
                                    </section>
                                        </div>
                                    </details>

                                    <details class="pbd-step" data-pbd-step="look" data-pbd-settings-collapsible data-pbd-settings-section="look">
                                        <summary>
                                            <span class="pbd-step__number" data-pbd-step-number aria-hidden="true">5</span>
                                            <span class="pbd-step__text"><strong data-pbd-settings-appearance-title>Look</strong><small data-pbd-step-summary></small></span>
                                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                        </summary>
                                        <div class="pbd-step__body">
                                <div class="pbd-presentation-design @(isUpdateSheet ? "is-update-sheet" : null)" data-pbd-presentation-design>
                                    <fieldset class="pbd-choice-group">
                                        <legend>Presentation theme</legend>
                                        <div class="pbd-theme-cards">
                                            <label class="pbd-theme-card">
                                                <input type="radio" name="PresentationTheme" value="EditorialLight" checked="@(deck.PresentationTheme == ProjectBriefingPresentationTheme.EditorialLight)" data-label="Editorial Light" />
                                                <span class="pbd-theme-card__body">
                                                    <span class="pbd-theme-preview pbd-theme-preview--light @(isUpdateSheet ? "is-update-sheet" : null)" data-pbd-theme-preview aria-hidden="true">
                                                        <span class="pbd-theme-preview__header"></span>
