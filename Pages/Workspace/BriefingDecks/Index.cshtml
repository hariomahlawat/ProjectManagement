@page "/Workspace/BriefingDecks/{deckId:long?}"
@model ProjectManagement.Pages.Workspace.BriefingDecks.IndexModel
@using ProjectManagement.Infrastructure
@using ProjectManagement.Models.ProjectBriefings
@using ProjectManagement.Services.ProjectBriefings
@using ProjectManagement.ViewModels.Workspace
@{
    ViewData["Title"] = "Project Briefing Deck Builder | Comdt / HoD Workspace";
    ViewData["UseFullWidth"] = true;
    ViewData["PageShell"] = "workspace";
    var deck = Model.SelectedDeck;
    var activeDeckName = deck?.Name ?? "No deck selected";
    var isUpdateSheet = deck?.Layout == ProjectBriefingLayout.ProjectUpdateSheet;
    var layoutLabel = isUpdateSheet ? "Project Update Sheets" : "Standard PRISM Briefing";
    var presentationModeLabel = deck?.PresentationMode switch
    {
        ProjectBriefingPresentationMode.ExecutiveTable => "Executive table deck",
        ProjectBriefingPresentationMode.DetailedProjects => "Detailed project deck",
        ProjectBriefingPresentationMode.Combined => "Combined deck",
        _ => "Deck format"
    };
    var costModeLabel = deck?.CostMode switch
    {
        ProjectBriefingCostMode.CostRdOnly => "Cost (R&D) only",
        ProjectBriefingCostMode.ProliferationOnly => "Proliferation cost only",
        ProjectBriefingCostMode.Both => "Both costs",
        ProjectBriefingCostMode.None => "No cost",
        _ => "Cost setting"
    };
    var narrativeModeLabel = deck?.NarrativeMode switch
    {
        ProjectBriefingNarrativeMode.CapabilityOverview => "Capability overview",
        ProjectBriefingNarrativeMode.ProjectBrief => "Project brief",
        ProjectBriefingNarrativeMode.Both => "Capabilities and project brief",
        _ => "Project content"
    };
    var themeLabel = deck?.PresentationTheme switch
    {
        ProjectBriefingPresentationTheme.EditorialLight => "Editorial Light",
        ProjectBriefingPresentationTheme.GraphiteDark => "Graphite Dark",
        _ => "Presentation theme"
    };
    var closingSlideLabel = deck?.ClosingSlideType switch
    {
        ProjectBriefingClosingSlideType.JaiHind => "Jai Hind closing",
        ProjectBriefingClosingSlideType.ThankYou => "Thank You closing",
        _ => "Closing slide"
    };
    var projectBriefLayoutLabel = deck?.StandardSlideOptions.ProjectBriefLayout switch
    {
        ProjectBriefingProjectBriefLayout.Automatic => "Automatic brief layout",
        ProjectBriefingProjectBriefLayout.Standard => "Standard brief layout",
        ProjectBriefingProjectBriefLayout.PhotoEmphasis => "Photo-emphasis brief layout",
        _ => "Project brief layout"
    };
    var selectedUpdateSheetRows = (deck?.UpdateSheetOptions.Rows ?? ProjectBriefingUpdateSheetOptions.RecommendedRows).ToHashSet();
    var orderedUpdateSheetRows = (deck?.UpdateSheetOptions.Rows ?? ProjectBriefingUpdateSheetOptions.RecommendedRows)
        .Concat(ProjectBriefingUpdateSheetOptions.AllRows)
        .Distinct()
        .ToArray();
    var updateSheetRowOrder = string.Join(",", orderedUpdateSheetRows);
    string UpdateSheetRowLabel(ProjectBriefingUpdateSheetRow row) => row switch
    {
        ProjectBriefingUpdateSheetRow.ProjectCost => "Project cost",
        ProjectBriefingUpdateSheetRow.ArppPppNumber => "ARPP/PPP number",
        ProjectBriefingUpdateSheetRow.FundingAuthority => "Fund, DFPDS schedule and CFA",
        ProjectBriefingUpdateSheetRow.AonDate => "AoN date",
        ProjectBriefingUpdateSheetRow.SupplyOrder => "Supply-order date and firm",
        ProjectBriefingUpdateSheetRow.PdcOrCompletionStatus => "PDC / completion status",
        ProjectBriefingUpdateSheetRow.PresentStatus => "Present status",
        ProjectBriefingUpdateSheetRow.ProjectOfficer => "Project Officer",
        ProjectBriefingUpdateSheetRow.LineDirectorate => "Line Directorate",
        _ => row.ToString()
    };
    string UpdateSheetRowDescription(ProjectBriefingUpdateSheetRow row) => row switch
    {
        ProjectBriefingUpdateSheetRow.ProjectCost => "Authoritative R&D cost",
        ProjectBriefingUpdateSheetRow.ArppPppNumber => "Latest published ARPP/PPP reference",
        ProjectBriefingUpdateSheetRow.FundingAuthority => "Combined in one compact row",
        ProjectBriefingUpdateSheetRow.AonDate => "Recorded approval-of-necessity date",
        ProjectBriefingUpdateSheetRow.SupplyOrder => "SO date and linked firm/JDP",
        ProjectBriefingUpdateSheetRow.PdcOrCompletionStatus => "Development-stage PDC; blank editable cell at other ongoing stages; completion status when completed",
        ProjectBriefingUpdateSheetRow.PresentStatus => "Latest external status or editable placeholder",
        ProjectBriefingUpdateSheetRow.ProjectOfficer => "Rank and full name where recorded",
        ProjectBriefingUpdateSheetRow.LineDirectorate => "Responsible line directorate",
        _ => string.Empty
    };
    var standardIncludesDetailedSlides = deck?.PresentationMode
        is ProjectBriefingPresentationMode.DetailedProjects or ProjectBriefingPresentationMode.Combined;
    var standardIncludesCostRd = deck?.CostMode
        is ProjectBriefingCostMode.CostRdOnly or ProjectBriefingCostMode.Both;
    var standardIncludesProliferationCost = deck?.CostMode
        is ProjectBriefingCostMode.ProliferationOnly or ProjectBriefingCostMode.Both;
    var hideEmptyUpdateSheetValues = isUpdateSheet && (deck?.UpdateSheetOptions.HideEmptyValues ?? false);
    var updateNeedsStatus = selectedUpdateSheetRows.Contains(ProjectBriefingUpdateSheetRow.PresentStatus);
    var updateNeedsCost = selectedUpdateSheetRows.Contains(ProjectBriefingUpdateSheetRow.ProjectCost);
    var updateNeedsArppNumber = selectedUpdateSheetRows.Contains(ProjectBriefingUpdateSheetRow.ArppPppNumber);
    var updateNeedsFunding = selectedUpdateSheetRows.Contains(ProjectBriefingUpdateSheetRow.FundingAuthority);
    var updateNeedsAon = selectedUpdateSheetRows.Contains(ProjectBriefingUpdateSheetRow.AonDate);
    var updateNeedsSupplyOrder = selectedUpdateSheetRows.Contains(ProjectBriefingUpdateSheetRow.SupplyOrder);
    var updateNeedsPdc = selectedUpdateSheetRows.Contains(ProjectBriefingUpdateSheetRow.PdcOrCompletionStatus);
    var updateNeedsProjectOfficer = selectedUpdateSheetRows.Contains(ProjectBriefingUpdateSheetRow.ProjectOfficer);
    var updateNeedsLineDirectorate = selectedUpdateSheetRows.Contains(ProjectBriefingUpdateSheetRow.LineDirectorate);
    var includesDetailedSlides = isUpdateSheet || standardIncludesDetailedSlides;
    var standardIncludesExecutiveTable = deck?.PresentationMode
        is ProjectBriefingPresentationMode.ExecutiveTable or ProjectBriefingPresentationMode.Combined;
    var standardDetailedUsesStatus = standardIncludesDetailedSlides
        && (deck?.StandardSlideOptions.ShowPresentStatus ?? true);
    var includesStatus = isUpdateSheet
        ? updateNeedsStatus && !hideEmptyUpdateSheetValues
        : standardIncludesExecutiveTable || standardDetailedUsesStatus;
    var includesCostRd = isUpdateSheet ? updateNeedsCost && !hideEmptyUpdateSheetValues : standardIncludesCostRd;
    var includesProliferationCost = !isUpdateSheet && standardIncludesProliferationCost;
    var missingStatusCount = deck is null ? 0 : deck.Readiness.ProjectCount - deck.Readiness.ExternalStatusAvailableCount;
    var missingCostRdCount = deck is null ? 0 : deck.Readiness.ProjectCount - deck.Readiness.CostRdAvailableCount;
    var missingProliferationCount = deck is null ? 0 : deck.Readiness.ProjectCount - deck.Readiness.ProliferationCostAvailableCount;
    var missingPhotoCount = deck is null ? 0 : deck.Readiness.ProjectCount - deck.Readiness.CoverPhotoAvailableCount;
    var missingCapabilityCount = deck is null ? 0 : deck.Readiness.ProjectCount - deck.Readiness.CapabilityOverviewAvailableCount;
    var missingProjectBriefCount = deck is null ? 0 : deck.Readiness.ProjectCount - deck.Readiness.ProjectBriefAvailableCount;
    var standardNeedsCapabilities = deck?.NarrativeMode
        is ProjectBriefingNarrativeMode.CapabilityOverview or ProjectBriefingNarrativeMode.Both;
    var standardNeedsProjectBrief = deck?.NarrativeMode
        is ProjectBriefingNarrativeMode.ProjectBrief or ProjectBriefingNarrativeMode.Both;
    var needsCapabilities = !isUpdateSheet && standardNeedsCapabilities;
    var needsProjectBrief = isUpdateSheet || standardNeedsProjectBrief;
    var settingsSummaryLabel = isUpdateSheet
        ? $"{layoutLabel} · {selectedUpdateSheetRows.Count} rows · {themeLabel} · R&D cost · {closingSlideLabel}"
        : $"{layoutLabel} · {presentationModeLabel} · {narrativeModeLabel}"
          + (standardNeedsProjectBrief ? $" · {projectBriefLayoutLabel}" : string.Empty)
          + $" · {themeLabel} · {costModeLabel} · {closingSlideLabel}";
    var missingArppNumberCount = deck?.Projects.Count(project =>
        project.ArppPppNumberApplicable && string.IsNullOrWhiteSpace(project.ArppReference)) ?? 0;
    var missingFundingCount = deck is null ? 0 : deck.Readiness.ProjectCount - deck.Readiness.ArppDetailsAvailableCount;
    var missingAonDateCount = deck is null ? 0 : deck.Readiness.ProjectCount - deck.Readiness.AonDateAvailableCount;
    var missingSupplyOrderDateCount = deck is null ? 0 : deck.Readiness.ProjectCount - deck.Readiness.SupplyOrderDateAvailableCount;
    var missingJdpCount = deck is null ? 0 : deck.Readiness.ProjectCount - deck.Readiness.JdpAvailableCount;
    var missingDevelopmentPdcCount = deck is null ? 0 : deck.Readiness.DevelopmentProjectCount - deck.Readiness.DevelopmentPdcAvailableCount;
    var missingProjectOfficerCount = deck is null ? 0 : deck.Readiness.ProjectCount - deck.Readiness.ProjectOfficerAvailableCount;
    var missingLineDirectorateCount = deck is null ? 0 : deck.Readiness.ProjectCount - deck.Readiness.LineDirectorateAvailableCount;

    // When empty optional rows are hidden, only incomplete rows that will still be rendered remain
    // reportable. The PDC/completion row is intentionally always retained.
    var reportedMissingArppNumberCount = hideEmptyUpdateSheetValues ? 0 : missingArppNumberCount;
    var reportedMissingFundingCount = hideEmptyUpdateSheetValues
        ? deck?.Projects.Count(project =>
            (!string.IsNullOrWhiteSpace(project.Fund)
                || !string.IsNullOrWhiteSpace(project.DfpdsSchedule)
                || !string.IsNullOrWhiteSpace(project.Cfa))
            && !project.HasCompleteArppDetails) ?? 0
        : missingFundingCount;
    var reportedMissingAonDateCount = hideEmptyUpdateSheetValues ? 0 : missingAonDateCount;
    var reportedMissingSupplyOrderDateCount = hideEmptyUpdateSheetValues
        ? deck?.Projects.Count(project => !project.SupplyOrderDate.HasValue && project.JdpNames.Count > 0) ?? 0
        : missingSupplyOrderDateCount;
    var reportedMissingJdpCount = hideEmptyUpdateSheetValues
        ? deck?.Projects.Count(project => project.SupplyOrderDate.HasValue && project.JdpNames.Count == 0) ?? 0
        : missingJdpCount;
    var reportedMissingProjectOfficerCount = hideEmptyUpdateSheetValues
        ? deck?.Projects.Count(project =>
            !string.IsNullOrWhiteSpace(project.ProjectOfficer) && !project.ProjectOfficerIsComplete) ?? 0
        : missingProjectOfficerCount;
    var reportedMissingLineDirectorateCount = hideEmptyUpdateSheetValues ? 0 : missingLineDirectorateCount;
    var usedContentGapCount = (includesStatus ? missingStatusCount : 0)
        + (includesCostRd ? missingCostRdCount : 0)
        + (includesProliferationCost ? missingProliferationCount : 0)
        + (includesDetailedSlides ? missingPhotoCount : 0)
        + (includesDetailedSlides && needsCapabilities ? missingCapabilityCount : 0)
        + (includesDetailedSlides && needsProjectBrief ? missingProjectBriefCount : 0);
    var additionalMetadataGapCount = isUpdateSheet
        ? (updateNeedsArppNumber ? reportedMissingArppNumberCount : 0)
            + (updateNeedsFunding ? reportedMissingFundingCount : 0)
            + (updateNeedsAon ? reportedMissingAonDateCount : 0)
            + (updateNeedsSupplyOrder ? reportedMissingSupplyOrderDateCount + reportedMissingJdpCount : 0)
            + (updateNeedsPdc ? Math.Max(0, missingDevelopmentPdcCount) : 0)
            + (updateNeedsProjectOfficer ? reportedMissingProjectOfficerCount : 0)
            + (updateNeedsLineDirectorate ? reportedMissingLineDirectorateCount : 0)
        : 0;
    var affectedProjectCount = deck?.Projects.Count(project =>
    {
        var capabilityText = project.BriefDescription?.Trim();
        var hasCapability = !string.IsNullOrWhiteSpace(capabilityText)
            && !string.Equals(capabilityText, "Brief description not recorded.", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(capabilityText, "Capability overview not recorded.", StringComparison.OrdinalIgnoreCase);
        var briefText = project.ProjectBrief?.Trim();
        var hasBrief = !string.IsNullOrWhiteSpace(briefText)
            && !string.Equals(briefText, "Project brief not recorded.", StringComparison.OrdinalIgnoreCase);

        return (includesStatus && string.IsNullOrWhiteSpace(project.ExternalStatus))
            || (includesCostRd && !project.CostRd.IsAvailable)
            || (includesProliferationCost && !project.ProliferationCost.IsAvailable)
            || (includesDetailedSlides && !project.HasCoverPhoto)
            || (includesDetailedSlides && needsCapabilities && !hasCapability)
            || (includesDetailedSlides && needsProjectBrief && !hasBrief);
    }) ?? 0;
    var usedGapSummaryParts = new System.Collections.Generic.List<string>();
    if (includesStatus && missingStatusCount > 0) usedGapSummaryParts.Add($"{missingStatusCount} missing external status");
    if (includesCostRd && missingCostRdCount > 0) usedGapSummaryParts.Add($"{missingCostRdCount} missing R&D cost");
    if (includesProliferationCost && missingProliferationCount > 0) usedGapSummaryParts.Add($"{missingProliferationCount} missing proliferation cost");
    if (includesDetailedSlides && needsCapabilities && missingCapabilityCount > 0) usedGapSummaryParts.Add($"{missingCapabilityCount} missing capability overview");
    if (includesDetailedSlides && needsProjectBrief && missingProjectBriefCount > 0) usedGapSummaryParts.Add($"{missingProjectBriefCount} missing project brief");
    if (includesDetailedSlides && missingPhotoCount > 0) usedGapSummaryParts.Add($"{missingPhotoCount} missing photograph");
    var usedGapSummaryText = string.Join(" · ", usedGapSummaryParts);
}

@section Styles {
    <link rel="stylesheet" href="~/css/command-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/project-briefing-decks.css" asp-append-version="true" />
}

<div class="command-workspace is-nav-expanded command-workspace--briefing-decks" data-command-workspace>
    @await Html.PartialAsync("/Pages/Workspace/_CommandWorkspaceRail.cshtml", Model.CommandRail)

    <main class="cw-workspace-content pbd-shell" data-pbd-root
          data-search-url="@Url.Page("/Workspace/BriefingDecks/Index", "SearchProjects")"
          data-reorder-url="@Url.Page("/Workspace/BriefingDecks/Index", "Reorder")"
          data-membership-url="@Url.Page("/Workspace/BriefingDecks/Index", "UpdateMembership")"
          data-description-url="@Url.Page("/Workspace/BriefingDecks/Index", "UpdateDescription")">
        <form method="post" class="pbd-antiforgery" aria-hidden="true">
            @Html.AntiForgeryToken()
        </form>

        <header class="pbd-page-header">
            <div>
                <span class="pbd-eyebrow">Project monitoring</span>
                <h1>Project Briefing Deck Builder</h1>
                <p>Select projects, maintain shared command decks and generate professional editable PowerPoint presentations.</p>
            </div>
            <div class="pbd-page-header__actions">
                @if (Model.Decks.Count > 0)
                {
                    <button type="button" class="btn btn-outline-secondary pbd-decks-toggle"
                            data-pbd-decks-toggle
                            data-pbd-active-deck-name="@activeDeckName"
                            aria-controls="pbd-saved-decks"
                            aria-expanded="true"
                            aria-label="Shared decks. Current deck: @activeDeckName">
                        <i class="bi bi-collection" aria-hidden="true"></i>
                        <span>Shared decks</span>
                    </button>
                }
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#pbd-new-deck-modal">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    New deck
                </button>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-success pbd-alert" role="status">
                <i class="bi bi-check-circle" aria-hidden="true"></i>
                <span>@Model.StatusMessage</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger pbd-alert" role="alert">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        @if (Model.Decks.Count == 0)
        {
            <section class="pbd-first-use" aria-labelledby="pbd-first-use-title">
                <span class="pbd-first-use__icon" aria-hidden="true"><i class="bi bi-file-earmark-slides"></i></span>
                <div>
                    <span class="pbd-eyebrow">No saved decks</span>
                    <h2 id="pbd-first-use-title">Create your first project briefing deck</h2>
                    <p>A shared command deck retains project membership and slide order while stage, cost and external status are refreshed from current PRISM data whenever the PowerPoint is generated.</p>
                </div>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#pbd-new-deck-modal">
                    Create deck
                </button>
            </section>
        }
        else
        {
            <div class="pbd-workspace">
                <aside class="pbd-saved" id="pbd-saved-decks" data-pbd-saved-decks aria-label="Shared command decks">
                    <div class="pbd-saved__header">
                        <div>
                            <span class="pbd-eyebrow">Command workspace</span>
                            <h2>Shared decks</h2>
                        </div>
                        <span class="pbd-count">@Model.Decks.Count</span>
                    </div>
                    <nav class="pbd-saved__list">
                        @foreach (var saved in Model.Decks)
                        {
                            var isActive = deck?.Id == saved.Id;
                            var savedUpdatedAtIst = IstClock.ToIst(saved.UpdatedAtUtc);
                            var savedUpdatedTitle = $"Updated {savedUpdatedAtIst:dd MMM yyyy, HH:mm} by {saved.LastModifiedByDisplay}";
                            <a asp-page="/Workspace/BriefingDecks/Index"
                               asp-route-deckId="@saved.Id"
                               class="pbd-saved-card @(isActive ? "is-active" : null)"
                               aria-current="@(isActive ? "page" : null)">
                                <span class="pbd-saved-card__icon" aria-hidden="true"><i class="bi bi-file-earmark-slides"></i></span>
                                <span class="pbd-saved-card__body">
                                    <strong>@saved.Name</strong>
                                    <small title="@savedUpdatedTitle">@saved.ProjectCount @(saved.ProjectCount == 1 ? "project" : "projects") · @savedUpdatedAtIst.ToString("dd MMM")</small>
                                </span>
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </a>
                        }
                    </nav>
                </aside>

                @if (deck is not null)
                {
                    <section class="pbd-editor" aria-labelledby="pbd-deck-title" data-deck-id="@deck.Id">
                        <header class="pbd-deck-header">
                            <div class="pbd-deck-header__identity">
                                <span class="pbd-deck-header__mark" aria-hidden="true"><i class="bi bi-easel2"></i></span>
                                <div>
                                    <span class="pbd-eyebrow">Saved briefing deck</span>
                                    <h2 id="pbd-deck-title">@deck.Name</h2>
                                    @if (!string.IsNullOrWhiteSpace(deck.Description))
                                    {
                                        <p>@deck.Description</p>
                                    }
                                    <small class="pbd-deck-header__meta">Updated @IstClock.ToIst(deck.UpdatedAtUtc).ToString("dd MMM yyyy, HH:mm") by @deck.LastModifiedByDisplay</small>
                                </div>
                            </div>
                            <div class="pbd-deck-header__actions">
                                <div class="pbd-generate-action">
                                    <form method="post" asp-page-handler="Generate" data-pbd-generate-form>
                                        <input type="hidden" name="deckId" value="@deck.Id" />
                                        <button type="submit" class="btn btn-primary" disabled="@(deck.Projects.Count == 0)" data-pbd-generate>
                                            <span data-pbd-generate-label><i class="bi bi-file-earmark-ppt" aria-hidden="true"></i> Generate PowerPoint</span>
                                            <span class="d-none" data-pbd-generate-progress><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Generating…</span>
                                        </button>
                                    </form>
                                    <small data-pbd-placeholder-note>Missing content uses defined placeholders.</small>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Deck actions">
                                        <i class="bi bi-three-dots" aria-hidden="true"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <form method="post" asp-page-handler="Duplicate">
                                                <input type="hidden" name="deckId" value="@deck.Id" />
                                                <button type="submit" class="dropdown-item"><i class="bi bi-copy" aria-hidden="true"></i> Duplicate deck</button>
                                            </form>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#pbd-delete-deck-modal">
                                                <i class="bi bi-trash" aria-hidden="true"></i> Delete deck
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </header>
                        <div class="pbd-generate-status" data-pbd-generate-status aria-live="polite"></div>

                        <section class="pbd-settings pbd-settings-summary" data-pbd-open-settings="@(deck.Projects.Count == 0 ? "true" : "false")">
                            <button type="button"
                                    class="pbd-settings-summary__button"
                                    data-pbd-settings-open
                                    aria-controls="pbd-settings-drawer"
                                    aria-expanded="false">
                                <span class="pbd-settings-summary__title"><i class="bi bi-sliders" aria-hidden="true"></i> Deck settings</span>
                                <small data-pbd-settings-summary-text>@settingsSummaryLabel</small>
                                <span class="pbd-settings-summary__dirty" data-pbd-settings-dirty hidden>Unsaved settings</span>
                                <i class="bi bi-chevron-right pbd-settings-summary__chevron" aria-hidden="true"></i>
                            </button>
                        </section>

                        <div class="pbd-settings-backdrop" data-pbd-settings-backdrop hidden></div>
                        <aside id="pbd-settings-drawer"
                               class="pbd-settings-drawer"
                               data-pbd-settings-drawer
                               aria-labelledby="pbd-settings-drawer-title"
                               aria-hidden="true">
                            <form method="post" asp-page-handler="SaveSettings" class="pbd-settings__form" data-pbd-settings-form>
                                <input type="hidden" name="DeckId" value="@deck.Id" />
                                <input type="hidden" name="RowVersion" value="@deck.RowVersion" />

                                <header class="pbd-settings-drawer__header">
                                    <div>
                                        <span class="pbd-eyebrow">Deck configuration</span>
                                        <h3 id="pbd-settings-drawer-title">Deck settings</h3>
                                        <p>Configure presentation structure, content and appearance without losing the project-list context.</p>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-pbd-settings-close aria-label="Close deck settings">
                                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                                    </button>
                                </header>

                                <div class="pbd-settings-drawer__body">
                                    <section class="pbd-settings-section" aria-labelledby="pbd-settings-general-title">
                                        <h4 id="pbd-settings-general-title">General</h4>

                                <div class="pbd-form-grid pbd-form-grid--identity">
                                    <label class="form-label">
                                        <span>Deck name</span>
                                        <input class="form-control" name="Name" value="@deck.Name" maxlength="160" required />
                                    </label>
                                    <label class="form-label">
                                        <span>Description <small>optional</small></span>
                                        <input class="form-control" name="Description" value="@deck.Description" maxlength="600" />
                                    </label>
                                </div>

                                <fieldset class="pbd-choice-group">
                                    <legend>Presentation template</legend>
                                    <div class="pbd-choice-cards pbd-choice-cards--two">
                                        <label class="pbd-choice-card pbd-choice-card--template">
                                            <input type="radio" name="Layout" value="StandardBriefing" checked="@(deck.Layout == ProjectBriefingLayout.StandardBriefing)" data-pbd-layout-choice />
                                            <span><i class="bi bi-columns-gap" aria-hidden="true"></i><strong>Standard PRISM Briefing</strong><small>Executive tables, summaries and configurable project slides.</small></span>
                                        </label>
                                        <label class="pbd-choice-card pbd-choice-card--template">
                                            <input type="radio" name="Layout" value="ProjectUpdateSheet" checked="@(deck.Layout == ProjectBriefingLayout.ProjectUpdateSheet)" data-pbd-layout-choice />
                                            <span><i class="bi bi-card-heading" aria-hidden="true"></i><strong>Project Update Sheets</strong><small>Formal 16:9 project sheets with configurable facts, project brief and photograph.</small></span>
                                        </label>
                                    </div>
                                </fieldset>
                                    </section>

                                    <details class="pbd-settings-section pbd-settings-section--collapsible"
                                             data-pbd-settings-collapsible
                                             data-pbd-settings-section="content"
                                             open>
                                        <summary id="pbd-settings-content-title">
                                            <span>Content and layout</span>
                                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                        </summary>
                                        <div class="pbd-settings-section__body">
                                <div data-pbd-standard-settings hidden="@isUpdateSheet">
                                    <fieldset class="pbd-choice-group">
                                        <legend>Deck format</legend>
                                        <div class="pbd-choice-cards pbd-choice-cards--three">
                                            <label class="pbd-choice-card">
                                                <input type="radio" name="PresentationMode" value="ExecutiveTable" checked="@(deck.PresentationMode == ProjectBriefingPresentationMode.ExecutiveTable)" />
                                                <span><i class="bi bi-table" aria-hidden="true"></i><strong>Executive table deck</strong><small>Summary and editable project tables</small></span>
                                            </label>
                                            <label class="pbd-choice-card">
                                                <input type="radio" name="PresentationMode" value="DetailedProjects" checked="@(deck.PresentationMode == ProjectBriefingPresentationMode.DetailedProjects)" />
                                                <span><i class="bi bi-file-slides" aria-hidden="true"></i><strong>Detailed project deck</strong><small>Project slides based on the selected content; continuation slides are added when required</small></span>
                                            </label>
                                            <label class="pbd-choice-card">
                                                <input type="radio" name="PresentationMode" value="Combined" checked="@(deck.PresentationMode == ProjectBriefingPresentationMode.Combined)" />
                                                <span><i class="bi bi-layers" aria-hidden="true"></i><strong>Combined deck</strong><small>Executive table followed by project slides</small></span>
                                            </label>
                                        </div>
                                    </fieldset>

                                    <fieldset class="pbd-choice-group">
                                        <legend>Project content</legend>
                                        <div class="pbd-choice-cards pbd-choice-cards--three">
                                            <label class="pbd-choice-card">
                                                <input type="radio" name="NarrativeMode" value="CapabilityOverview" checked="@(deck.NarrativeMode == ProjectBriefingNarrativeMode.CapabilityOverview)" />
                                                <span><i class="bi bi-list-check" aria-hidden="true"></i><strong>Capability overview</strong><small>5–8 concise capability statements on the main project slide</small></span>
                                            </label>
                                            <label class="pbd-choice-card">
                                                <input type="radio" name="NarrativeMode" value="ProjectBrief" checked="@(deck.NarrativeMode == ProjectBriefingNarrativeMode.ProjectBrief)" />
                                                <span><i class="bi bi-file-earmark-text" aria-hidden="true"></i><strong>Project brief</strong><small>Dedicated narrative slide for each project</small></span>
                                            </label>
                                            <label class="pbd-choice-card">
                                                <input type="radio" name="NarrativeMode" value="Both" checked="@(deck.NarrativeMode == ProjectBriefingNarrativeMode.Both)" />
                                                <span><i class="bi bi-layout-text-sidebar-reverse" aria-hidden="true"></i><strong>Both</strong><small>Capability slide followed by a project brief slide</small></span>
                                            </label>
                                        </div>
                                    </fieldset>

                                    <div class="pbd-standard-detail-options" data-pbd-detailed-settings hidden="@(!standardIncludesDetailedSlides)">
                                        <fieldset class="pbd-choice-group" data-pbd-project-brief-layout-settings hidden="@(!standardNeedsProjectBrief)">
                                            <legend>Project Brief layout</legend>
                                            <div class="pbd-choice-cards pbd-choice-cards--three">
                                                <label class="pbd-choice-card">
                                                    <input type="radio" name="ProjectBriefLayout" value="Automatic" checked="@(deck.StandardSlideOptions.ProjectBriefLayout == ProjectBriefingProjectBriefLayout.Automatic)" />
                                                    <span><i class="bi bi-magic" aria-hidden="true"></i><strong>Automatic</strong><small>Recommended. Uses photo emphasis when the photograph and content are suitable; otherwise uses the standard design.</small></span>
                                                </label>
                                                <label class="pbd-choice-card">
                                                    <input type="radio" name="ProjectBriefLayout" value="Standard" checked="@(deck.StandardSlideOptions.ProjectBriefLayout == ProjectBriefingProjectBriefLayout.Standard)" />
                                                    <span><i class="bi bi-layout-sidebar" aria-hidden="true"></i><strong>Standard</strong><small>Compact photograph and context rail with a wide narrative panel.</small></span>
                                                </label>
                                                <label class="pbd-choice-card">
                                                    <input type="radio" name="ProjectBriefLayout" value="PhotoEmphasis" checked="@(deck.StandardSlideOptions.ProjectBriefLayout == ProjectBriefingProjectBriefLayout.PhotoEmphasis)" />
                                                    <span><i class="bi bi-image" aria-hidden="true"></i><strong>Photo emphasis</strong><small>Large photograph on approximately half the slide with brief and context alongside.</small></span>
                                                </label>
                                            </div>
                                        </fieldset>

                                        <fieldset class="pbd-choice-group">
                                            <legend>Project context on detailed slides</legend>
                                            <div class="pbd-checks pbd-checks--inline">
                                                <label>
                                                    <input type="checkbox" name="ShowPresentStage" value="true" checked="@deck.StandardSlideOptions.ShowPresentStage" />
                                                    <input type="hidden" name="ShowPresentStage" value="false" />
                                                    Show present stage
                                                </label>
                                                <label>
                                                    <input type="checkbox" name="ShowPresentStatus" value="true" checked="@deck.StandardSlideOptions.ShowPresentStatus" />
                                                    <input type="hidden" name="ShowPresentStatus" value="false" />
                                                    Show present status
                                                </label>
                                            </div>
                                            <p class="pbd-form-note"><i class="bi bi-info-circle" aria-hidden="true"></i> These choices apply to Capability Overview and Project Brief slides. Cost remains controlled independently under Financial information.</p>
                                        </fieldset>
                                    </div>
                                </div>
                                <div class="pbd-update-sheet-composition" data-pbd-update-settings hidden="@(!isUpdateSheet)">
                                    <div class="pbd-update-sheet-composition__intro">
                                        <div>
                                            <strong>Information shown on each project sheet</strong>
                                            <small>Project name remains the slide title. Select and order the editable table rows; the photograph and brief areas adapt automatically.</small>
                                        </div>
                                        <div class="pbd-update-sheet-composition__actions">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" data-pbd-update-rows-select-all>Select all</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" data-pbd-update-rows-reset>Recommended defaults</button>
                                        </div>
                                    </div>
                                    <input type="hidden" name="UpdateSheetRowOrder" value="@updateSheetRowOrder" data-recommended-order="@string.Join(",", ProjectBriefingUpdateSheetOptions.RecommendedRows)" data-pbd-update-row-order />
                                    <div class="pbd-update-row-list" data-pbd-update-row-list>
                                        @foreach (var row in orderedUpdateSheetRows)
                                        {
                                            <div class="pbd-update-row-option" data-pbd-update-row data-row-key="@row">
                                                <span class="pbd-update-row-option__handle" aria-hidden="true"><i class="bi bi-grip-vertical"></i></span>
                                                <label>
                                                    <input type="checkbox" name="UpdateSheetRows" value="@row" checked="@selectedUpdateSheetRows.Contains(row)" />
                                                    <span><strong>@UpdateSheetRowLabel(row)</strong><small>@UpdateSheetRowDescription(row)</small></span>
                                                </label>
                                                <span class="pbd-update-row-option__move">
                                                    <button type="button" class="btn btn-sm btn-light" data-pbd-update-row-up aria-label="Move @UpdateSheetRowLabel(row) up"><i class="bi bi-arrow-up" aria-hidden="true"></i></button>
                                                    <button type="button" class="btn btn-sm btn-light" data-pbd-update-row-down aria-label="Move @UpdateSheetRowLabel(row) down"><i class="bi bi-arrow-down" aria-hidden="true"></i></button>
                                                </span>
                                            </div>
                                        }
                                    </div>
                                    <label class="pbd-update-sheet-hide-empty">
                                        <input type="checkbox" name="HideEmptyUpdateSheetValues" value="true" checked="@deck.UpdateSheetOptions.HideEmptyValues" />
                                        <span><strong>Hide fields with no recorded value</strong><small>The PDC/completion row remains available as an intentional editable cell.</small></span>
                                    </label>
                                    <p class="pbd-update-sheet-composition__validation" data-pbd-update-rows-validation hidden>Select at least one information row.</p>
                                </div>
                                        </div>
                                    </details>

                                    <details class="pbd-settings-section pbd-settings-section--collapsible"
                                             data-pbd-settings-collapsible
                                             data-pbd-settings-section="appearance">
                                        <summary id="pbd-settings-appearance-title">
                                            <span data-pbd-settings-appearance-title>Appearance</span>
                                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                        </summary>
                                        <div class="pbd-settings-section__body">
                                <div class="pbd-presentation-design @(isUpdateSheet ? "is-update-sheet" : null)" data-pbd-presentation-design>
                                    <fieldset class="pbd-choice-group">
                                        <legend>Presentation theme</legend>
                                        <div class="pbd-theme-cards">
                                            <label class="pbd-theme-card">
                                                <input type="radio" name="PresentationTheme" value="EditorialLight" checked="@(deck.PresentationTheme == ProjectBriefingPresentationTheme.EditorialLight)" />
                                                <span class="pbd-theme-card__body">
                                                    <span class="pbd-theme-preview pbd-theme-preview--light @(isUpdateSheet ? "is-update-sheet" : null)" data-pbd-theme-preview aria-hidden="true">
                                                        <span class="pbd-theme-preview__header"></span>
                                                        <span class="pbd-theme-preview__title"></span>
                                                        <span class="pbd-theme-preview__content">
                                                            <i class="pbd-theme-preview__primary"></i>
                                                            <i class="pbd-theme-preview__secondary"></i>
                                                            <i class="pbd-theme-preview__tertiary"></i>
                                                        </span>
                                                    </span>
                                                    <span>
                                                        <strong>Editorial Light</strong>
                                                        <small>Clean, restrained and suitable for circulation or print.</small>
                                                    </span>
                                                </span>
                                            </label>
                                            <label class="pbd-theme-card">
                                                <input type="radio" name="PresentationTheme" value="GraphiteDark" checked="@(deck.PresentationTheme == ProjectBriefingPresentationTheme.GraphiteDark)" />
                                                <span class="pbd-theme-card__body">
                                                    <span class="pbd-theme-preview pbd-theme-preview--dark @(isUpdateSheet ? "is-update-sheet" : null)" data-pbd-theme-preview aria-hidden="true">
                                                        <span class="pbd-theme-preview__header"></span>
                                                        <span class="pbd-theme-preview__title"></span>
                                                        <span class="pbd-theme-preview__content">
                                                            <i class="pbd-theme-preview__primary"></i>
                                                            <i class="pbd-theme-preview__secondary"></i>
                                                            <i class="pbd-theme-preview__tertiary"></i>
                                                        </span>
                                                    </span>
                                                    <span>
                                                        <strong>Graphite Dark</strong>
                                                        <small>Designed for command briefings, large displays and projection.</small>
                                                    </span>
                                                </span>
                                            </label>
                                        </div>
                                    </fieldset>

                                    <fieldset class="pbd-choice-group">
                                        <legend>Closing slide</legend>
                                        <div class="pbd-choice-cards pbd-choice-cards--two">
                                            <label class="pbd-choice-card pbd-choice-card--closing">
                                                <input type="radio" name="ClosingSlideType" value="JaiHind" checked="@(deck.ClosingSlideType == ProjectBriefingClosingSlideType.JaiHind)" />
                                                <span>
                                                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                                                    <strong>Jai Hind</strong>
                                                    <small>Recommended for command and internal military briefings.</small>
                                                </span>
                                            </label>
                                            <label class="pbd-choice-card pbd-choice-card--closing">
                                                <input type="radio" name="ClosingSlideType" value="ThankYou" checked="@(deck.ClosingSlideType == ProjectBriefingClosingSlideType.ThankYou)" />
                                                <span>
                                                    <i class="bi bi-stars" aria-hidden="true"></i>
                                                    <strong>Thank You</strong>
                                                    <small>Suitable for industry, academic and external audiences.</small>
                                                </span>
                                            </label>
                                        </div>
                                        <p class="pbd-form-note"><i class="bi bi-info-circle" aria-hidden="true"></i> One ceremonial closing slide is always appended as the final slide of the presentation.</p>
                                    </fieldset>

                                    <fieldset class="pbd-choice-group">
                                        <legend>Presentation branding</legend>
                                        <div class="pbd-branding-options">
                                            <label>
                                                <input type="radio" name="BrandingScope" value="None" checked="@(deck.BrandingScope == ProjectBriefingBrandingScope.None)" />
                                                <span><strong>None</strong><small>No insignia in slide headers or on the closing slide</small></span>
                                            </label>
                                            <label>
                                                <input type="radio" name="BrandingScope" value="CoverAndSummary" checked="@(deck.BrandingScope == ProjectBriefingBrandingScope.CoverAndSummary)" />
                                                <span><strong>Cover and summary</strong><small>Brand cover, summary and closing slides</small></span>
                                            </label>
                                            <label>
                                                <input type="radio" name="BrandingScope" value="AllSlides" checked="@(deck.BrandingScope == ProjectBriefingBrandingScope.AllSlides)" />
                                                <span><strong>All slides</strong><small>Compact insignia throughout the presentation</small></span>
                                            </label>
                                        </div>
                                    </fieldset>
                                </div>
                                        </div>
                                    </details>

                                    <details class="pbd-settings-section pbd-settings-section--collapsible"
                                             data-pbd-settings-collapsible
                                             data-pbd-settings-section="financial"
                                             data-pbd-standard-section
                                             hidden="@isUpdateSheet">
                                        <summary id="pbd-settings-financial-title">
                                            <span>Financial information</span>
                                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                        </summary>
                                        <div class="pbd-settings-section__body">
                                <fieldset class="pbd-choice-group">
                                    <legend>Cost information</legend>
                                    <div class="pbd-choice-cards pbd-choice-cards--four">
                                        <label class="pbd-choice-card pbd-choice-card--compact">
                                            <input type="radio" name="CostMode" value="CostRdOnly" checked="@(deck.CostMode == ProjectBriefingCostMode.CostRdOnly)" />
                                            <span><strong>Cost (R&amp;D) only</strong><small>L1 → AoN → IPA</small></span>
                                        </label>
                                        <label class="pbd-choice-card pbd-choice-card--compact">
                                            <input type="radio" name="CostMode" value="ProliferationOnly" checked="@(deck.CostMode == ProjectBriefingCostMode.ProliferationOnly)" />
                                            <span><strong>Proliferation cost only</strong><small>Latest indicative cost</small></span>
                                        </label>
                                        <label class="pbd-choice-card pbd-choice-card--compact">
                                            <input type="radio" name="CostMode" value="Both" checked="@(deck.CostMode == ProjectBriefingCostMode.Both)" />
                                            <span><strong>Both costs</strong><small>Shown separately</small></span>
                                        </label>
                                        <label class="pbd-choice-card pbd-choice-card--compact">
                                            <input type="radio" name="CostMode" value="None" checked="@(deck.CostMode == ProjectBriefingCostMode.None)" />
                                            <span><strong>Do not include cost</strong><small>Hide cost from slides</small></span>
                                        </label>
                                    </div>
                                </fieldset>
                                        </div>
                                    </details>

                                    <details class="pbd-settings-section pbd-settings-section--collapsible"
                                             data-pbd-settings-collapsible
                                             data-pbd-settings-section="summary">
                                        <summary id="pbd-settings-summary-title">
                                            <span>Summary and handling</span>
                                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                        </summary>
                                        <div class="pbd-settings-section__body">
                                <fieldset class="pbd-choice-group pbd-update-sheet-options" data-pbd-update-settings hidden="@(!isUpdateSheet)">
                                    <legend>Project Update Sheet options</legend>
                                    <div class="pbd-update-sheet-note">
                                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                                        <span>Each project is generated as one editable 16:9 sheet. Project brief and photograph remain structural; selected information rows determine the facts-table composition.</span>
                                    </div>
                                    <div class="pbd-checks pbd-checks--inline">
                                        <label><input type="checkbox" name="IncludeCoverSlide" value="true" checked="@deck.IncludeCoverSlide" /> Include cover slide</label>
                                        <label><input type="checkbox" name="IncludePortfolioSummarySlide" value="true" checked="@deck.IncludePortfolioSummarySlide" /> Include portfolio-summary slide</label>
                                    </div>
                                </fieldset>
                                <div class="pbd-settings__bottom">
                                    <fieldset class="pbd-checks" data-pbd-standard-settings hidden="@isUpdateSheet">
                                        <legend>Summary slides</legend>
                                        <label><input type="checkbox" name="IncludeStageSummary" value="true" checked="@deck.IncludeStageSummary" /> Stage-wise summary <small>chart and table</small></label>
                                        <label><input type="checkbox" name="IncludeProjectCategorySummary" value="true" checked="@deck.IncludeProjectCategorySummary" /> Project-category summary</label>
                                        <label><input type="checkbox" name="IncludeTechnicalCategorySummary" value="true" checked="@deck.IncludeTechnicalCategorySummary" /> Technical-category summary</label>
                                    </fieldset>
                                    <label class="form-label pbd-marking">
                                        <span>Classification marking <small>optional</small></span>
                                        <input class="form-control" name="HandlingMarking" value="@deck.HandlingMarking" maxlength="80" placeholder="e.g. OFFICIAL" />
                                    </label>
                                </div>
                                        </div>
                                    </details>
                                </div>

                                <footer class="pbd-settings-drawer__footer">
                                    <span class="pbd-settings-drawer__status" data-pbd-settings-status aria-live="polite">No unsaved changes</span>
                                    <div>
                                        <button type="button" class="btn btn-outline-secondary" data-pbd-settings-close>Cancel</button>
                                        <button type="submit" class="btn btn-primary" data-pbd-settings-save disabled>Save settings</button>
                                    </div>
                                </footer>
                            </form>
                        </aside>

                        <section class="pbd-export-preflight" aria-labelledby="pbd-preflight-title">
                            <header class="pbd-preflight-header">
                                <div>
                                    <span class="pbd-eyebrow">Deck preflight</span>
                                    <h3 id="pbd-preflight-title">Content used by this presentation</h3>
                                    <p>Headline checks follow the selected template. Supporting project metadata is listed separately.</p>
                                </div>
                                <div class="pbd-slide-estimate" aria-label="Estimated deck size">
                                    <strong data-pbd-slide-total>@deck.SlideEstimate.TotalSlides @(deck.SlideEstimate.TotalSlides == 1 ? "slide" : "slides")</strong>
                                    <small data-pbd-slide-breakdown>
                                        @if (isUpdateSheet)
                                        {
                                            <text>Cover @(deck.IncludeCoverSlide ? 1 : 0) · Portfolio summary @(deck.IncludePortfolioSummarySlide ? 1 : 0) · Project sheets @deck.SlideEstimate.ProjectUpdateSheetSlides · Closing @deck.SlideEstimate.ClosingSlides</text>
                                        }
                                        else
                                        {
                                            <text>Cover and portfolio @deck.SlideEstimate.CoverAndPortfolioSlides · Summary @deck.SlideEstimate.SummarySlides · Tables @deck.SlideEstimate.ExecutiveTableSlides</text>
                                            @if (deck.SlideEstimate.DetailedProjectSlides > 0)
                                            {
                                                <text> · Capability slides @deck.SlideEstimate.DetailedProjectSlides</text>
                                            }
                                            @if (deck.SlideEstimate.ProjectBriefSlides > 0)
                                            {
                                                <text> · Project brief slides @deck.SlideEstimate.ProjectBriefSlides</text>
                                            }
                                            @if (deck.SlideEstimate.CapabilityContinuationSlides > 0)
                                            {
                                                <text> · Capability continuations @deck.SlideEstimate.CapabilityContinuationSlides</text>
                                            }
                                            <text> · Closing @deck.SlideEstimate.ClosingSlides</text>
                                        }
                                    </small>
                                </div>
                            </header>

                            <div class="pbd-preflight-metrics" data-pbd-preflight-metrics>
                                <button type="button" class="pbd-preflight-metric" data-pbd-requirement="status" data-pbd-readiness-filter="missing-status" hidden="@(!includesStatus)" disabled="@(missingStatusCount == 0)">
                                    <strong data-pbd-metric="status">@deck.Readiness.ExternalStatusAvailableCount/@deck.Readiness.ProjectCount</strong>
                                    <span>External status</span>
                                    <small>Show missing</small>
                                </button>
                                <button type="button" class="pbd-preflight-metric" data-pbd-requirement="cost-rd" data-pbd-readiness-filter="missing-cost-rd" hidden="@(!includesCostRd)" disabled="@(missingCostRdCount == 0)">
                                    <strong data-pbd-metric="cost-rd">@deck.Readiness.CostRdAvailableCount/@deck.Readiness.ProjectCount</strong>
                                    <span>Cost (R&amp;D)</span>
                                    <small>Show missing</small>
                                </button>
                                <button type="button" class="pbd-preflight-metric" data-pbd-requirement="proliferation" data-pbd-readiness-filter="missing-proliferation" hidden="@(!includesProliferationCost)" disabled="@(missingProliferationCount == 0)">
                                    <strong data-pbd-metric="proliferation">@deck.Readiness.ProliferationCostAvailableCount/@deck.Readiness.ProjectCount</strong>
                                    <span>Proliferation cost</span>
                                    <small>Show missing</small>
                                </button>
                                <button type="button" class="pbd-preflight-metric" data-pbd-requirement="capability" data-pbd-readiness-filter="missing-description" hidden="@(!(includesDetailedSlides && needsCapabilities))" disabled="@(missingCapabilityCount == 0)">
                                    <strong data-pbd-metric="capability">@deck.Readiness.CapabilityOverviewAvailableCount/@deck.Readiness.ProjectCount</strong>
                                    <span>Capability overview</span>
                                    <small>Show missing</small>
                                </button>
                                <button type="button" class="pbd-preflight-metric" data-pbd-requirement="project-brief" data-pbd-readiness-filter="missing-description" hidden="@(!(includesDetailedSlides && needsProjectBrief))" disabled="@(missingProjectBriefCount == 0)">
                                    <strong data-pbd-metric="project-brief">@deck.Readiness.ProjectBriefAvailableCount/@deck.Readiness.ProjectCount</strong>
                                    <span>Project brief</span>
                                    <small>Show missing</small>
                                </button>
                                <button type="button" class="pbd-preflight-metric" data-pbd-requirement="photo" data-pbd-readiness-filter="missing-photo" hidden="@(!includesDetailedSlides)" disabled="@(missingPhotoCount == 0)">
                                    <strong data-pbd-metric="photo">@deck.Readiness.CoverPhotoAvailableCount/@deck.Readiness.ProjectCount</strong>
                                    <span>Usable photograph</span>
                                    <small>Show missing</small>
                                </button>
                            </div>

                            <details class="pbd-preflight-details" data-pbd-preflight-details>
                                <summary>
                                    <span>
                                        <i class="bi @(affectedProjectCount == 0 ? "bi-check-circle" : "bi-exclamation-circle")" data-pbd-gap-summary-icon aria-hidden="true"></i>
                                        <strong data-pbd-gap-summary>@(affectedProjectCount == 0 ? "Selected content is ready" : $"{affectedProjectCount} {(affectedProjectCount == 1 ? "project has" : "projects have")} content gaps")</strong>
                                        <small data-pbd-gap-summary-detail>@(affectedProjectCount == 0 ? "All selected-layout content is available." : usedGapSummaryText)</small>
                                    </span>
                                </summary>
                                <div class="pbd-preflight-detail-grid">
                                    <section>
                                        <h4>Used in this deck</h4>
                                        <ul class="pbd-gap-list" data-pbd-used-gap-list>
                                            @if (deck.Readiness.ProjectCount == 0)
                                            {
                                                <li class="is-neutral"><i class="bi bi-info-circle" aria-hidden="true"></i><span>Add projects to generate a deck.</span></li>
                                            }
                                            else
                                            {
                                                @if (includesStatus && missingStatusCount > 0)
                                                {
                                                    <li><button type="button" data-pbd-readiness-filter="missing-status"><i class="bi bi-chat-left-text" aria-hidden="true"></i><span>External status</span><strong>@missingStatusCount missing</strong></button></li>
                                                }
                                                @if (includesCostRd && missingCostRdCount > 0)
                                                {
                                                    <li><button type="button" data-pbd-readiness-filter="missing-cost-rd"><i class="bi bi-currency-rupee" aria-hidden="true"></i><span>Cost (R&amp;D)</span><strong>@missingCostRdCount missing</strong></button></li>
                                                }
                                                @if (includesProliferationCost && missingProliferationCount > 0)
                                                {
                                                    <li><button type="button" data-pbd-readiness-filter="missing-proliferation"><i class="bi bi-boxes" aria-hidden="true"></i><span>Proliferation cost</span><strong>@missingProliferationCount missing</strong></button></li>
                                                }
                                                @if (includesDetailedSlides && missingPhotoCount > 0)
                                                {
                                                    <li><button type="button" data-pbd-readiness-filter="missing-photo"><i class="bi bi-image" aria-hidden="true"></i><span>PowerPoint-ready photograph</span><strong>@missingPhotoCount missing</strong></button></li>
                                                }
                                                @if (includesDetailedSlides && needsCapabilities && missingCapabilityCount > 0)
                                                {
                                                    <li><button type="button" data-pbd-readiness-filter="missing-description"><i class="bi bi-list-check" aria-hidden="true"></i><span>Capability overview</span><strong>@missingCapabilityCount missing</strong></button></li>
                                                }
                                                @if (includesDetailedSlides && needsProjectBrief && missingProjectBriefCount > 0)
                                                {
                                                    <li><button type="button" data-pbd-readiness-filter="missing-description"><i class="bi bi-file-earmark-text" aria-hidden="true"></i><span>Project brief</span><strong>@missingProjectBriefCount missing</strong></button></li>
                                                }
                                                @if (usedContentGapCount == 0)
                                                {
                                                    <li class="is-ready"><i class="bi bi-check-circle" aria-hidden="true"></i><span>All selected-layout content is available.</span></li>
                                                }
                                            }
                                        </ul>
                                    </section>
                                    <section>
                                        <h4>Supporting project metadata</h4>
                                        <ul class="pbd-gap-list" data-pbd-additional-gap-list>
                                            @if (!isUpdateSheet)
                                            {
                                                <li class="is-neutral"><i class="bi bi-info-circle" aria-hidden="true"></i><span>No additional metadata is required by this template.</span></li>
                                            }
                                            else
                                            {
                                                @if (updateNeedsArppNumber && reportedMissingArppNumberCount > 0)
                                                {
                                                    <li><i class="bi bi-journal-text" aria-hidden="true"></i><span>ARPP/PPP number</span><strong>@reportedMissingArppNumberCount missing</strong></li>
                                                }
                                                @if (updateNeedsFunding && reportedMissingFundingCount > 0)
                                                {
                                                    <li><i class="bi bi-bank" aria-hidden="true"></i><span>Fund, DFPDS schedule and CFA</span><strong>@reportedMissingFundingCount incomplete</strong></li>
                                                }
                                                @if (updateNeedsAon && reportedMissingAonDateCount > 0)
                                                {
                                                    <li><i class="bi bi-calendar-check" aria-hidden="true"></i><span>AoN date</span><strong>@reportedMissingAonDateCount missing</strong></li>
                                                }
                                                @if (updateNeedsSupplyOrder && reportedMissingSupplyOrderDateCount > 0)
                                                {
                                                    <li><i class="bi bi-calendar2-event" aria-hidden="true"></i><span>Supply-order date</span><strong>@reportedMissingSupplyOrderDateCount missing</strong></li>
                                                }
                                                @if (updateNeedsSupplyOrder && reportedMissingJdpCount > 0)
                                                {
                                                    <li><i class="bi bi-building" aria-hidden="true"></i><span>Linked firm/JDP</span><strong>@reportedMissingJdpCount missing</strong></li>
                                                }
                                                @if (updateNeedsPdc && missingDevelopmentPdcCount > 0)
                                                {
                                                    <li><i class="bi bi-calendar-x" aria-hidden="true"></i><span>Development PDC</span><strong>@missingDevelopmentPdcCount missing</strong></li>
                                                }
                                                @if (updateNeedsProjectOfficer && reportedMissingProjectOfficerCount > 0)
                                                {
                                                    <li><i class="bi bi-person-badge" aria-hidden="true"></i><span>Project Officer rank and full name</span><strong>@reportedMissingProjectOfficerCount missing</strong></li>
                                                }
                                                @if (updateNeedsLineDirectorate && reportedMissingLineDirectorateCount > 0)
                                                {
                                                    <li><i class="bi bi-diagram-3" aria-hidden="true"></i><span>Line Directorate</span><strong>@reportedMissingLineDirectorateCount missing</strong></li>
                                                }
                                                @if (hideEmptyUpdateSheetValues && additionalMetadataGapCount == 0)
                                                {
                                                    <li class="is-neutral"><i class="bi bi-eye-slash" aria-hidden="true"></i><span>Empty optional rows are hidden. Only a missing Development PDC remains reportable because that row stays editable.</span></li>
                                                }
                                                @if (additionalMetadataGapCount == 0)
                                                {
                                                    <li class="is-ready"><i class="bi bi-check-circle" aria-hidden="true"></i><span>Supporting project metadata is complete.</span></li>
                                                }
                                            }
                                        </ul>
                                    </section>
                                </div>
                            </details>
                        </section>

                        <section class="pbd-selected" aria-labelledby="pbd-selected-title" data-pbd-selected-section>
                            <header class="pbd-section-header pbd-section-header--selected">
                                <div>
                                    <span class="pbd-eyebrow">Projects</span>
                                    <h3 id="pbd-selected-title">Projects in this deck <span data-pbd-selected-total>@deck.Projects.Count</span></h3>
                                    <p>Search, review and arrange the final slide sequence.</p>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-primary" data-pbd-open-selector>
                                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Add projects
                                </button>
                            </header>

                            <div class="pbd-selected-toolbar" data-pbd-selected-toolbar>
                                <label class="pbd-selected-search">
                                    <span class="visually-hidden">Search selected projects</span>
                                    <i class="bi bi-search" aria-hidden="true"></i>
                                    <input type="search" class="form-control" placeholder="Search within this deck" autocomplete="off" data-pbd-selected-search />
                                </label>
                                <select class="form-select" data-pbd-selected-stage aria-label="Filter selected projects by present stage">
                                    <option value="">All stages</option>
                                    @foreach (var stage in deck.Projects
                                        .GroupBy(project => new { project.PresentStageOrder, project.PresentStageCode })
                                        .Select(group => new
                                        {
                                            Code = group.Key.PresentStageCode,
                                            Name = group.Select(project => project.PresentStage).First(),
                                            Order = group.Key.PresentStageOrder
                                        })
                                        .OrderBy(stage => stage.Order)
                                        .ThenBy(stage => stage.Name))
                                    {
                                        <option value="@stage.Code">@stage.Name</option>
                                    }
                                </select>
                                <select class="form-select" data-pbd-selected-readiness aria-label="Filter selected projects by content readiness">
                                    <option value="">All readiness</option>
                                    @if (isUpdateSheet)
                                    {
                                        <option value="missing-facts">Missing update-sheet facts</option>
                                    }
                                    <option value="missing-status">Missing external status</option>
                                    <option value="missing-cost-rd">Missing Cost (R&amp;D)</option>
                                    @if (!isUpdateSheet)
                                    {
                                        <option value="missing-proliferation">Missing proliferation cost</option>
                                    }
                                    <option value="missing-photo">Missing photograph</option>
                                    <option value="missing-description">@(needsCapabilities && needsProjectBrief
                                        ? "Missing selected project content"
                                        : needsProjectBrief
                                            ? "Missing project brief"
                                            : "Missing capability overview")</option>
                                </select>
                                <span class="pbd-selected-filter-result">
                                    <span class="pbd-visible-count" data-pbd-visible-count>@deck.Projects.Count projects shown</span>
                                    <button type="button" class="btn btn-sm btn-link pbd-clear-filters" data-pbd-clear-selected-filters hidden>Clear filters</button>
                                </span>
                            </div>
                            <div class="pbd-selected-actions">
                                <label><input type="checkbox" data-pbd-select-visible /> Select visible</label>
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled data-pbd-bulk-top><i class="bi bi-arrow-bar-up" aria-hidden="true"></i> Top of stage</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled data-pbd-bulk-bottom><i class="bi bi-arrow-bar-down" aria-hidden="true"></i> Bottom of stage</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" disabled data-pbd-bulk-remove><i class="bi bi-trash" aria-hidden="true"></i> Remove selected</button>
                                <span class="pbd-ordering-note">Projects are grouped by present stage in maturity order. Drag to arrange projects within the same stage.</span>
                                <span class="pbd-filter-reorder-note" data-pbd-filter-reorder-note hidden>Clear filters to reorder projects within a stage.</span>
                                <span class="pbd-save-state" data-pbd-sort-status aria-live="polite"></span>
                            </div>

                            <div class="pbd-empty-projects" data-pbd-empty-projects @(deck.Projects.Count == 0 ? null : "hidden")>
                                <i class="bi bi-file-earmark-plus" aria-hidden="true"></i>
                                <strong>No projects selected</strong>
                                <span>Use a quick selection or Manage individually above.</span>
                            </div>

                            <div class="pbd-table-wrap" data-pbd-selected-table-wrap @(deck.Projects.Count == 0 ? "hidden" : null)>
                                <table class="pbd-project-table">
                                    <thead>
                                        <tr>
                                            <th class="pbd-select-column"><span class="visually-hidden">Select</span></th>
                                            <th class="pbd-drag-column"><span class="visually-hidden">Order</span></th>
                                            <th class="pbd-project-column">Project</th>
                                            <th>Present stage</th>
                                            <th>Cost (R&amp;D)</th>
                                            <th data-pbd-proliferation-column hidden="@isUpdateSheet">Proliferation cost</th>
                                            <th class="pbd-status-column">Status <small>external remark</small></th>
                                            <th>
                                                <span class="pbd-readiness-heading">
                                                    Deck readiness
                                                    <button type="button"
                                                            class="pbd-readiness-legend"
                                                            data-pbd-readiness-tip
                                                            data-bs-title="Indicators show photograph, external status, R&amp;D cost, update-sheet facts when applicable, and the selected project content."
                                                            title="Indicators show photograph, external status, R&amp;D cost, update-sheet facts when applicable, and the selected project content."
                                                            aria-label="Readiness indicator order: photograph, external status, R&amp;D cost, update-sheet facts when applicable, and selected project content.">
                                                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                                                    </button>
                                                </span>
                                            </th>
                                            <th><span class="visually-hidden">Actions</span></th>
                                        </tr>
                                    </thead>
                                    <tbody data-pbd-sortable>
                                        @foreach (var project in deck.Projects)
                                        {
                                            var photoReadinessTitle = project.HasCoverPhoto
                                                ? "PowerPoint-ready cover photograph available"
                                                : project.HasSelectedCoverPhoto
                                                    ? $"Selected photograph could not be prepared for PowerPoint: {project.CoverPhotoReadinessReason ?? "unreadable image"}"
                                                    : "No cover photograph selected";
                                            var costReadinessTitle = project.CostRd.IsAvailable
                                                ? $"Cost (R&D) available from {project.CostRd.BasisDisplay}"
                                                : "Cost (R&D) not recorded";
                                            var hasCapabilityOverview = !string.IsNullOrWhiteSpace(project.BriefDescription)
                                                && !string.Equals(project.BriefDescription.Trim(), "Brief description not recorded.", StringComparison.OrdinalIgnoreCase)
                                                && !string.Equals(project.BriefDescription.Trim(), "Capability overview not recorded.", StringComparison.OrdinalIgnoreCase);
                                            var hasProjectBrief = !string.IsNullOrWhiteSpace(project.ProjectBrief)
                                                && !string.Equals(project.ProjectBrief.Trim(), "Project brief not recorded.", StringComparison.OrdinalIgnoreCase);
                                            var hasSelectedNarrative = (!needsCapabilities || hasCapabilityOverview)
                                                && (!needsProjectBrief || hasProjectBrief);
                                            var narrativeReadinessTitle = needsCapabilities && needsProjectBrief
                                                ? hasSelectedNarrative
                                                    ? "Capability overview and project brief available"
                                                    : "Capability overview or project brief is missing"
                                                : needsProjectBrief
                                                    ? hasProjectBrief ? "Project brief available" : "Project brief not recorded"
                                                    : hasCapabilityOverview ? "Capability overview available" : "Capability overview not recorded";
                                            var searchText = string.Join(" ", new[]
                                            {
                                                project.ProjectName,
                                                project.LifecycleDisplay,
                                                project.PresentStage,
                                                project.ProjectCategory,
                                                project.TechnicalCategory,
                                                project.ExternalStatus
                                            }.Where(value => !string.IsNullOrWhiteSpace(value)));
                                            <tr data-project-id="@project.ProjectId"
                                                data-search-text="@searchText"
                                                data-stage="@project.PresentStage"
                                                data-stage-code="@project.PresentStageCode"
                                                data-stage-order="@project.PresentStageOrder"
                                                data-missing-status="@(string.IsNullOrWhiteSpace(project.ExternalStatus) ? "true" : "false")"
                                                data-missing-cost-rd="@(!project.CostRd.IsAvailable ? "true" : "false")"
                                                data-missing-proliferation="@(!project.ProliferationCost.IsAvailable ? "true" : "false")"
                                                data-missing-photo="@(!project.HasCoverPhoto ? "true" : "false")"
                                                data-missing-description="@(!hasSelectedNarrative ? "true" : "false")"
                                                data-missing-facts="@(!project.IsUpdateSheetCoreFactsReady ? "true" : "false")">
                                                <td class="pbd-select-column"><input type="checkbox" data-pbd-row-select aria-label="Select @project.ProjectName" /></td>
                                                <td class="pbd-drag-column"><button type="button" class="pbd-drag" aria-label="Reorder @project.ProjectName within @project.PresentStage. Use the up or down arrow key." aria-keyshortcuts="ArrowUp ArrowDown" title="Reorder within @project.PresentStage"><i class="bi bi-grip-vertical" aria-hidden="true"></i></button></td>
                                                <td class="pbd-project-name">
                                                    <a href="@project.OpenUrl" target="_blank" rel="noopener" title="@project.ProjectName">@project.ProjectName</a>
                                                    <small>@project.LifecycleDisplay · @(project.ProjectCategory ?? "Not categorised") · @(project.TechnicalCategory ?? "No technical category")</small>
                                                </td>
                                                <td><span class="pbd-stage">@project.PresentStage</span></td>
                                                <td class="pbd-cost">
                                                    <strong>@project.CostRd.DisplayValue</strong>
                                                    @if (!string.IsNullOrWhiteSpace(project.CostRd.BasisDisplay))
                                                    {
                                                        <small>@project.CostRd.BasisDisplay</small>
                                                    }
                                                </td>
                                                <td class="pbd-cost" data-pbd-proliferation-column hidden="@isUpdateSheet"><strong>@project.ProliferationCost.DisplayValue</strong></td>
                                                <td class="pbd-status">
                                                    @if (string.IsNullOrWhiteSpace(project.ExternalStatus))
                                                    {
                                                        <span class="pbd-missing">No external status recorded</span>
                                                    }
                                                    else
                                                    {
                                                        <span title="@project.ExternalStatus">@project.ExternalStatus</span>
                                                        @if (project.ExternalStatusDate.HasValue)
                                                        {
                                                            <small>@project.ExternalStatusDate.Value.ToString("dd MMM yyyy")</small>
                                                        }
                                                    }
                                                </td>
                                                <td>
                                                    <div class="pbd-readiness-icons" aria-label="Project deck readiness">
                                                        <span class="@(project.HasCoverPhoto ? "is-ready" : "is-missing")"
                                                              role="img"
                                                              tabindex="0"
                                                              aria-label="@photoReadinessTitle"
                                                              data-pbd-readiness-tip
                                                              data-bs-title="@photoReadinessTitle"
                                                              title="@photoReadinessTitle"><i class="bi bi-image" aria-hidden="true"></i></span>
                                                        <span class="@(!string.IsNullOrWhiteSpace(project.ExternalStatus) ? "is-ready" : "is-missing")"
                                                              role="img"
                                                              tabindex="0"
                                                              aria-label="@(!string.IsNullOrWhiteSpace(project.ExternalStatus) ? "External status available" : "External status missing")"
                                                              data-pbd-readiness-tip
                                                              data-bs-title="@(!string.IsNullOrWhiteSpace(project.ExternalStatus) ? "External status available" : "External status missing")"
                                                              title="@(!string.IsNullOrWhiteSpace(project.ExternalStatus) ? "External status available" : "External status missing")"><i class="bi bi-chat-left-text" aria-hidden="true"></i></span>
                                                        <span class="@(project.CostRd.IsAvailable ? "is-ready" : "is-missing")"
                                                              role="img"
                                                              tabindex="0"
                                                              aria-label="@costReadinessTitle"
                                                              data-pbd-readiness-tip
                                                              data-bs-title="@costReadinessTitle"
                                                              title="@costReadinessTitle"><i class="bi bi-currency-rupee" aria-hidden="true"></i></span>
                                                        @if (isUpdateSheet)
                                                        {
                                                            <span class="@(project.IsUpdateSheetCoreFactsReady ? "is-ready" : "is-missing")"
                                                                  role="img"
                                                                  tabindex="0"
                                                                  aria-label="@(project.IsUpdateSheetCoreFactsReady ? "Project update facts complete" : "Project update facts incomplete")"
                                                                  data-pbd-readiness-tip
                                                                  data-bs-title="@(project.IsUpdateSheetCoreFactsReady ? "Project update facts complete" : "Project update facts incomplete")"
                                                                  title="@(project.IsUpdateSheetCoreFactsReady ? "Project update facts complete" : "Project update facts incomplete")"><i class="bi bi-card-checklist" aria-hidden="true"></i></span>
                                                        }
                                                        <span class="@(hasSelectedNarrative ? "is-ready" : "is-missing")"
                                                              role="img"
                                                              tabindex="0"
                                                              aria-label="@narrativeReadinessTitle"
                                                              data-pbd-readiness-tip
                                                              data-bs-title="@narrativeReadinessTitle"
                                                              title="@narrativeReadinessTitle"><i class="bi @(needsCapabilities && needsProjectBrief ? "bi-layers" : needsProjectBrief ? "bi-file-earmark-text" : "bi-list-check")" aria-hidden="true"></i></span>
                                                    </div>
                                                </td>
                                                <td class="pbd-row-actions">
                                                    @if (needsCapabilities)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-link" data-pbd-edit-description data-project-id="@project.ProjectId" data-project-name="@project.ProjectName" data-description="@project.BriefDescriptionOverride" aria-label="Edit deck-specific capability overview for @project.ProjectName" title="Edit deck-specific capability overview"><i class="bi bi-pencil-square"></i></button>
                                                    }
                                                    @if (needsProjectBrief)
                                                    {
                                                        <a class="btn btn-sm btn-link"
                                                           href="@(project.OpenUrl + "?content=brief#content-brief")"
                                                           target="_blank"
                                                           rel="noopener"
                                                           aria-label="Open project brief for @project.ProjectName in a new tab"
                                                           title="Open project brief"><i class="bi bi-box-arrow-up-right"></i></a>
                                                    }
                                                    <form method="post" asp-page-handler="RemoveProject" data-pbd-remove-project-form>
                                                        <input type="hidden" name="deckId" value="@deck.Id" />
                                                        <input type="hidden" name="projectId" value="@project.ProjectId" />
                                                        <input type="hidden" name="rowVersion" value="@deck.RowVersion" />
                                                        <button type="submit" class="btn btn-sm btn-link text-danger" aria-label="Remove @project.ProjectName from deck" title="Remove from deck"><i class="bi bi-x-lg"></i></button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="pbd-no-filter-results" data-pbd-no-filter-results hidden>No selected projects match the current search and filters.</div>
                        </section>


                        <details class="pbd-selector" data-pbd-selector-details @(deck.Projects.Count == 0 ? "open" : null)>
                            <summary class="pbd-selector-summary">
                                <span>
                                    <i class="bi bi-plus-circle" aria-hidden="true"></i>
                                    <strong id="pbd-selector-title">Add projects</strong>
                                    <small>Quick selections, categories or individual project management</small>
                                </span>
                            </summary>

                            <div class="pbd-selector-tabs" role="tablist" aria-label="Project selection methods">
                                <button type="button" class="is-active" data-pbd-selector-tab="quick" role="tab" aria-selected="true"><i class="bi bi-lightning" aria-hidden="true"></i> Quick add</button>
                                <button type="button" data-pbd-selector-tab="completed" role="tab" aria-selected="false"><i class="bi bi-check2-circle" aria-hidden="true"></i> Recently completed</button>
                                <button type="button" data-pbd-selector-tab="project-category" role="tab" aria-selected="false"><i class="bi bi-folder2" aria-hidden="true"></i> Project category</button>
                                <button type="button" data-pbd-selector-tab="technical-category" role="tab" aria-selected="false"><i class="bi bi-cpu" aria-hidden="true"></i> Technical category</button>
                                <button type="button" data-pbd-selector-tab="individual" role="tab" aria-selected="false"><i class="bi bi-search" aria-hidden="true"></i> Manage individually</button>
                            </div>

                            <div class="pbd-selector-panel is-active" data-pbd-selector-panel="quick">
                                <div class="pbd-quick-grid">
                                    <form method="post" asp-page-handler="AddSelection" class="pbd-quick-card">
                                        <input type="hidden" name="DeckId" value="@deck.Id" />
                                        <input type="hidden" name="RowVersion" value="@deck.RowVersion" />
                                        <input type="hidden" name="Kind" value="Ongoing" />
                                        <span class="pbd-quick-card__icon"><i class="bi bi-kanban"></i></span>
                                        <span><strong>All ongoing projects</strong><small>@Model.SelectionOptions.OngoingCount projects currently active</small></span>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Add</button>
                                    </form>
                                    <form method="post" asp-page-handler="AddSelection" class="pbd-quick-card">
                                        <input type="hidden" name="DeckId" value="@deck.Id" />
                                        <input type="hidden" name="RowVersion" value="@deck.RowVersion" />
                                        <input type="hidden" name="Kind" value="AvailableForProliferation" />
                                        <span class="pbd-quick-card__icon"><i class="bi bi-boxes"></i></span>
                                        <span><strong>Available for proliferation</strong><small>@Model.SelectionOptions.ProliferationAvailableCount projects marked available</small></span>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Add</button>
                                    </form>
                                </div>
                            </div>

                            <div class="pbd-selector-panel" data-pbd-selector-panel="completed" hidden>
                                <form method="post" asp-page-handler="AddSelection" class="pbd-inline-form">
                                    <input type="hidden" name="DeckId" value="@deck.Id" />
                                    <input type="hidden" name="RowVersion" value="@deck.RowVersion" />
                                    <input type="hidden" name="Kind" value="RecentlyCompleted" />
                                    <label class="form-label"><span>From year</span><input class="form-control" type="number" name="CompletionYearFrom" min="@Model.SelectionOptions.MinimumCompletionYear" max="@Model.SelectionOptions.MaximumCompletionYear" value="@(Math.Max(Model.SelectionOptions.MinimumCompletionYear, Model.SelectionOptions.MaximumCompletionYear - 1))" /></label>
                                    <label class="form-label"><span>To year</span><input class="form-control" type="number" name="CompletionYearTo" min="@Model.SelectionOptions.MinimumCompletionYear" max="@Model.SelectionOptions.MaximumCompletionYear" value="@Model.SelectionOptions.MaximumCompletionYear" /></label>
                                    <div class="pbd-inline-form__context"><strong>@Model.SelectionOptions.CompletedCount completed projects</strong><span>Completion year falls back to completion date where required.</span></div>
                                    <button type="submit" class="btn btn-primary">Add matching projects</button>
                                </form>
                            </div>

                            <div class="pbd-selector-panel" data-pbd-selector-panel="project-category" hidden>
                                <form method="post" asp-page-handler="AddSelection" class="pbd-category-form">
                                    <input type="hidden" name="DeckId" value="@deck.Id" />
                                    <input type="hidden" name="RowVersion" value="@deck.RowVersion" />
                                    <input type="hidden" name="Kind" value="ProjectCategory" />
                                    <div class="pbd-category-grid">
                                        @foreach (var category in Model.SelectionOptions.ProjectCategories)
                                        {
                                            <label class="pbd-filter-option @(category.ParentId.HasValue ? "is-child" : null)">
                                                <input type="checkbox" name="ProjectCategoryIds" value="@category.Id" />
                                                <span><strong>@category.Name</strong><small>@category.MatchCount projects</small></span>
                                            </label>
                                        }
                                    </div>
                                    <div class="pbd-category-form__footer"><span>Selecting a parent category also includes its child categories.</span><button type="submit" class="btn btn-primary">Add selected categories</button></div>
                                </form>
                            </div>

                            <div class="pbd-selector-panel" data-pbd-selector-panel="technical-category" hidden>
                                <form method="post" asp-page-handler="AddSelection" class="pbd-category-form">
                                    <input type="hidden" name="DeckId" value="@deck.Id" />
                                    <input type="hidden" name="RowVersion" value="@deck.RowVersion" />
                                    <input type="hidden" name="Kind" value="TechnicalCategory" />
                                    <div class="pbd-category-grid">
                                        @foreach (var category in Model.SelectionOptions.TechnicalCategories)
                                        {
                                            <label class="pbd-filter-option @(category.ParentId.HasValue ? "is-child" : null)">
                                                <input type="checkbox" name="TechnicalCategoryIds" value="@category.Id" />
                                                <span><strong>@category.Name</strong><small>@category.MatchCount projects</small></span>
                                            </label>
                                        }
                                    </div>
                                    <div class="pbd-category-form__footer"><span>Multiple technical categories can be added in one action.</span><button type="submit" class="btn btn-primary">Add selected categories</button></div>
                                </form>
                            </div>

                            <div class="pbd-selector-panel" data-pbd-selector-panel="individual" hidden>
                                <form method="post" asp-page-handler="AddSelection" class="pbd-individual-form" data-pbd-individual-form>
                                    <input type="hidden" name="DeckId" value="@deck.Id" />
                                    <input type="hidden" name="RowVersion" value="@deck.RowVersion" />
                                    <input type="hidden" name="Kind" value="IndividualProjects" />
                                    <div class="pbd-manage-search-row">
                                        <label class="pbd-project-search">
                                            <span class="visually-hidden">Search all projects</span>
                                            <i class="bi bi-search" aria-hidden="true"></i>
                                            <input type="search" class="form-control" placeholder="Search all projects by name, case file, officer or category" autocomplete="off" data-pbd-project-search />
                                        </label>
                                        <select class="form-select" data-pbd-membership-filter aria-label="Filter search results by deck membership">
                                            <option value="all">All projects</option>
                                            <option value="selected">In this deck</option>
                                            <option value="unselected">Not in this deck</option>
                                        </select>
                                    </div>
                                    <div class="pbd-search-status" data-pbd-search-status>Enter at least two characters.</div>
                                    <div class="pbd-search-results" data-pbd-search-results></div>
                                    <div class="pbd-individual-form__footer">
                                        <span data-pbd-selected-count>No pending changes</span>
                                        <button type="submit" class="btn btn-primary" disabled data-pbd-apply-membership>Apply changes</button>
                                    </div>
                                </form>
                            </div>
                        </details>





                    </section>
                }
            </div>
        }
    </main>
</div>

<div class="modal fade" id="pbd-new-deck-modal" tabindex="-1" aria-labelledby="pbd-new-deck-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content pbd-modal">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <div><span class="pbd-eyebrow">Shared command deck</span><h2 class="modal-title" id="pbd-new-deck-title">Create briefing deck</h2></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label"><span>Deck name</span><input class="form-control" name="Name" maxlength="160" required placeholder="Project Update Review" data-pbd-new-name /></label>
                    <label class="form-label"><span>Description <small>optional</small></span><textarea class="form-control" name="Description" maxlength="600" rows="3" placeholder="Purpose, audience or review context"></textarea></label>
                    <p class="pbd-form-note"><i class="bi bi-info-circle" aria-hidden="true"></i> The deck is visible to all authorised Comdt/HoD workspace users. Project membership is saved; current stage, cost and latest external status are refreshed when PowerPoint is generated.</p>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Create deck</button></div>
            </form>
        </div>
    </div>
</div>

@if (deck is not null)
{
    <div class="modal fade" id="pbd-delete-deck-modal" tabindex="-1" aria-labelledby="pbd-delete-deck-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content pbd-modal">
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" name="deckId" value="@deck.Id" />
                    <input type="hidden" name="rowVersion" value="@deck.RowVersion" />
                    <div class="modal-header"><h2 class="modal-title" id="pbd-delete-deck-title">Delete briefing deck?</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                    <div class="modal-body"><p><strong>@deck.Name</strong> and its saved project selection will be deleted. Project records are not affected.</p></div>
                    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Delete deck</button></div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="pbd-description-modal" tabindex="-1" aria-labelledby="pbd-description-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content pbd-modal">
                <form data-pbd-description-form>
                    <div class="modal-header"><div><span class="pbd-eyebrow">Detailed project slide</span><h2 class="modal-title" id="pbd-description-title" data-pbd-description-title>Capability overview</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                    <div class="modal-body">
                        <input type="hidden" data-pbd-description-project-id />
                        <label class="form-label"><span>Briefing-specific capability overview</span><textarea class="form-control" rows="7" maxlength="1200" data-pbd-description-value></textarea></label>
                        <p class="pbd-form-note"><i class="bi bi-info-circle" aria-hidden="true"></i> This text applies only to this saved deck. Leave it blank to use the project's structured capability overview.</p>
                        <div class="pbd-modal-status" data-pbd-description-status aria-live="polite"></div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save capability overview</button></div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/lib/sortable/1.15.2/Sortable.min.js" asp-append-version="true"></script>
    <script type="module" src="~/js/pages/command-workspace.js" asp-append-version="true"></script>
    <script type="module" src="~/js/pages/project-briefing-decks.js" asp-append-version="true"></script>
}
