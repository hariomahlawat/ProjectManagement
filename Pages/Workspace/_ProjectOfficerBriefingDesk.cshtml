@using ProjectManagement.Infrastructure
@using ProjectManagement.Services.Workspace
@using ProjectManagement.ViewModels.Workspace
@model ProjectManagement.Pages.Workspace.IndexModel
@{
    var vm = Model.Workspace;
    var desk = vm.BriefingDesk;
    var todayLabel = IstClock.ToIst(vm.GeneratedAtUtc).ToString("dddd d MMM yyyy");
    var allItems = desk.Sections.SelectMany(group => group.Items).ToList();

    // One card is open on arrival: the one a post returned to, else the first that needs work.
    var openAnchor = !string.IsNullOrWhiteSpace(Model.Focus) && allItems.Any(item => item.AnchorId == Model.Focus)
        ? Model.Focus
        : allItems.FirstOrDefault(item => !item.IsBriefReady)?.AnchorId;
    // Reading TempData (not Peek) consumes the draft, so it is restored once and never again.
    var draftAnchor = TempData[ProjectManagement.Pages.Workspace.IndexModel.DeskDraftAnchorKey] as string;
    var draftText = TempData[ProjectManagement.Pages.Workspace.IndexModel.DeskDraftTextKey] as string;
    var draftField = TempData[ProjectManagement.Pages.Workspace.IndexModel.DeskDraftFieldKey] as string ?? BriefingDeskDraftFields.Body;

    // The headline leads with what needs the PO; the ready count is the line under it.
    string headline;
    if (desk.TotalCount == 0)
    {
        headline = "Nothing is assigned to you yet";
    }
    else if (desk.NotReadyCount == 0)
    {
        headline = "Everything is ready for conference";
    }
    else
    {
        headline = $"{desk.NotReadyCount} item{(desk.NotReadyCount == 1 ? " needs" : "s need")} you before the next conference";
    }

    var subline = desk.TotalCount == 0
        ? "Projects, ideas and tasks assigned to you will appear here."
        : desk.NotReadyCount == 0
            ? $"All {desk.TotalCount} item{(desk.TotalCount == 1 ? " is" : "s are")} ready. Nothing needs you before the next conference."
            : $"{desk.ReadyCount} of {desk.TotalCount} ready for conference. Most of the rest can be finished on this page.";

    async Task Card(BriefingDeskItemVm item)
    {
        await Html.RenderPartialAsync("_BriefingDeskItem", new BriefingDeskItemRenderVm
        {
            Item = item,
            IsOpen = item.AnchorId == openAnchor,
            Draft = draftAnchor == item.AnchorId ? draftText : null,
            DraftField = draftField
        });
    }
}
<div class="bd" data-briefing-desk>
    <header class="bd-header">
        <div class="bd-header__copy">
            <p class="bd-header__meta">@todayLabel · @vm.UserDisplayName</p>
            <h1 class="bd-header__title">@headline</h1>
            <p class="bd-header__sub">@subline</p>
        </div>
        <div class="bd-header__actions">
            <a class="bd-link" asp-page="/Workspace/Index" asp-route-mode="project-officer" asp-route-view="conference">
                <i class="bi bi-easel2" aria-hidden="true"></i>Open my conference view
            </a>
        </div>
    </header>

    @* With one section the headline and the section heading already give the count, so the
       meters only appear when they split it across projects, ideas and tasks. *@
    @if (desk.Sections.Count > 1)
    {
        <div class="bd-meters" aria-label="Ready for conference, by section">
            @foreach (var deskSection in desk.Sections)
            {
                var percent = deskSection.Items.Count == 0 ? 0 : (int)Math.Round(deskSection.ReadyCount * 100d / deskSection.Items.Count);
                <div class="bd-meter @(percent == 100 ? "bd-meter--complete" : string.Empty)">
                    <div class="bd-meter__top">
                        <span class="bd-meter__label">@deskSection.Title</span>
                        <span class="bd-meter__value">@deskSection.ReadyCount / @deskSection.Items.Count</span>
                    </div>
                    <progress class="bd-meter__bar" max="@deskSection.Items.Count" value="@deskSection.ReadyCount" aria-label="@deskSection.Title ready for conference: @deskSection.ReadyCount of @deskSection.Items.Count">@deskSection.ReadyCount of @deskSection.Items.Count</progress>
                    <span class="bd-meter__caption">ready</span>
                </div>
            }
        </div>
    }

    <div class="bd-layout">
        <div class="bd-main">
            @if (desk.TotalCount == 0)
            {
                <div class="bd-empty">
                    <i class="bi bi-inbox" aria-hidden="true"></i>
                    <div><strong>Your desk is empty</strong><span>When a project, idea or task is assigned to you it appears here, ready to prepare for conference.</span></div>
                </div>
            }
            @foreach (var deskSection in desk.Sections)
            {
                var kindKey = BriefingDeskLabels.KindKey(deskSection.Kind);
                var needsYou = deskSection.Items.Where(item => !item.IsBriefReady).ToList();
                var ready = deskSection.Items.Where(item => item.IsBriefReady).ToList();
                // The ready group opens by itself when a post or a link points at one of its cards.
                var readyOpen = ready.Any(item => item.AnchorId == Model.Focus);
                <section class="bd-section" aria-labelledby="bd-section-@kindKey">
                    <div class="bd-section__head">
                        <h2 id="bd-section-@kindKey">@deskSection.Title</h2>
                        <span>@(needsYou.Count == 0 ? $"All {ready.Count} ready" : $"{needsYou.Count} need{(needsYou.Count == 1 ? "s" : string.Empty)} you · {ready.Count} ready")</span>
                        @if (deskSection.Kind == ConferenceItemKind.ActionTask)
                        {
                            <a class="bd-link bd-link--small" href="@WorkspaceRouteHelper.ActionTasksMyWork()">Open task register<i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                        }
                        else if (deskSection.Kind == ConferenceItemKind.ProjectIdea)
                        {
                            <a class="bd-link bd-link--small" href="@WorkspaceRouteHelper.ProjectIdeasMine()">Open idea register<i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                        }
                    </div>
                    @if (needsYou.Any())
                    {
                        <div class="bd-section__items">
                            @foreach (var item in needsYou)
                            {
                                await Card(item);
                            }
                        </div>
                    }
                    @if (ready.Any())
                    {
                        @* Ready items ask nothing, so they fold to one line each until opened. A PO can
                           still open a card to add a remark. *@
                        <details class="bd-ready" data-bd-ready-group open="@(readyOpen ? "open" : null)">
                            <summary class="bd-ready__summary">
                                <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                <span class="bd-ready__title">@ready.Count ready for conference</span>
                                <i class="bi bi-chevron-down bd-ready__chevron" aria-hidden="true"></i>
                            </summary>
                            <div class="bd-section__items">
                                @foreach (var item in ready)
                                {
                                    await Card(item);
                                }
                            </div>
                        </details>
                    }
                </section>
            }

            @if (desk.RecentlyCompleted.Any())
            {
                var completedNeedsYou = desk.RecentlyCompleted.Count(item => !item.IsBriefReady);
                <details class="bd-completed" open="@(completedNeedsYou > 0 || desk.RecentlyCompleted.Any(item => item.AnchorId == Model.Focus) ? "open" : null)">
                    <summary>
                        <span class="bd-completed__title" id="bd-section-completed">Recently completed</span>
                        <span class="bd-completed__meta">
                            @desk.RecentlyCompleted.Count project@(desk.RecentlyCompleted.Count == 1 ? string.Empty : "s") still in your conference review
                            @if (completedNeedsYou > 0)
                            {
                                <text> · @completedNeedsYou with a direction to answer</text>
                            }
                        </span>
                    </summary>
                    <div class="bd-section__items">
                        @foreach (var item in desk.RecentlyCompleted)
                        {
                            @await Html.PartialAsync("_BriefingDeskItem", new BriefingDeskItemRenderVm
                            {
                                Item = item,
                                IsOpen = item.AnchorId == Model.Focus,
                                Draft = draftAnchor == item.AnchorId ? draftText : null,
                                DraftField = draftField
                            })
                        }
                    </div>
                </details>
            }
        </div>

        @* Empty panels fold to a single line, so the column only takes space when it has
           something to show. *@
        <aside class="bd-rail" aria-label="Sent for approval, reading and the next 14 days">
            @if (desk.WithOthers.Any())
            {
                @* Submitting is the PO's part done; this is a record of what was sent, not a to-do list. *@
                <section class="bd-panel" aria-labelledby="bd-waiting-title">
                    <div class="bd-panel__head"><h2 id="bd-waiting-title">Sent for approval</h2><span class="bd-panel__meta">No action needed</span></div>
                    <ul class="bd-list">
                        @foreach (var item in desk.WithOthers)
                        {
                            <li class="bd-list__item">
                                <i class="bi bi-check2 bd-list__icon bd-list__icon--sent" aria-hidden="true"></i>
                                <a class="bd-list__copy bd-list__copy--link" href="@item.OpenUrl"><strong>@item.Title</strong><span>@item.Detail · @(item.SentByName is null ? "sent" : $"sent by {item.SentByName}") to @item.WaitingOn on @IstClock.ToIst(item.SinceUtc).ToString("dd MMM")</span></a>
                            </li>
                        }
                    </ul>
                </section>
            }

            @if (vm.AotsDocuments.Any())
            {
                <section class="bd-panel" aria-labelledby="bd-reading-title">
                    <div class="bd-panel__head"><h2 id="bd-reading-title">Reading</h2><span class="bd-panel__meta">@vm.AotsUnreadCount unread circular@(vm.AotsUnreadCount == 1 ? string.Empty : "s")</span></div>
                    <ul class="bd-list">
                        @foreach (var document in vm.AotsDocuments.Take(4))
                        {
                            <li class="bd-list__item">
                                <a class="bd-list__copy bd-list__copy--link" href="@document.OpenUrl"><strong>@document.Subject</strong><span>@document.Office · @document.Category · @IstClock.ToIst(document.CreatedAtUtc).ToString("dd MMM")</span></a>
                            </li>
                        }
                    </ul>
                    <a class="bd-link bd-link--small" href="@vm.AotsUrl">Open AOTS inbox<i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                </section>
            }
            else
            {
                <section class="bd-panel bd-panel--quiet" aria-labelledby="bd-reading-title">
                    <h2 id="bd-reading-title">Reading</h2>
                    <span class="bd-panel__meta">No unread circulars</span>
                    <span class="bd-panel__links"><a class="bd-link bd-link--small" href="@vm.AotsUrl">AOTS inbox</a></span>
                </section>
            }

            @if (vm.PersonalReminders.Any() || vm.UpcomingEvents.Any())
            {
                <section class="bd-panel" aria-labelledby="bd-week-title">
                    <div class="bd-panel__head"><h2 id="bd-week-title">Next 14 days</h2><span class="bd-panel__meta">Reminders and events</span></div>
                    <ul class="bd-list">
                        @foreach (var reminder in vm.PersonalReminders.Take(5))
                        {
                            <li class="bd-list__item">
                                <i class="bi @(reminder.IsPinned ? "bi-pin-angle" : "bi-bell") bd-list__icon" aria-hidden="true"></i>
                                <a class="bd-list__copy bd-list__copy--link" href="@reminder.OpenUrl"><strong>@reminder.Title</strong><span>@(reminder.IsPinned ? "Pinned" : "Reminder") · @WorkspaceDisplayHelpers.FormatReminderDate(reminder.DueAtUtc)</span></a>
                            </li>
                        }
                        @foreach (var item in vm.UpcomingEvents)
                        {
                            <li class="bd-list__item">
                                <i class="bi bi-calendar-event bd-list__icon" aria-hidden="true"></i>
                                <a class="bd-list__copy bd-list__copy--link" href="@item.OpenUrl"><strong>@item.Title</strong><span>@item.LocalDate.ToString("ddd d MMM") · @item.TimeLabel</span></a>
                            </li>
                        }
                    </ul>
                    <div class="bd-panel__links">
                        <a class="bd-link bd-link--small" href="@WorkspaceRouteHelper.PersonalReminders()">Notebook</a>
                        <a class="bd-link bd-link--small" href="/Calendar">Calendar</a>
                    </div>
                </section>
            }
            else
            {
                <section class="bd-panel bd-panel--quiet" aria-labelledby="bd-week-title">
                    <h2 id="bd-week-title">Next 14 days</h2>
                    <span class="bd-panel__meta">Nothing due</span>
                    <span class="bd-panel__links">
                        <a class="bd-link bd-link--small" href="@WorkspaceRouteHelper.PersonalReminders()">Notebook</a>
                        <a class="bd-link bd-link--small" href="/Calendar">Calendar</a>
                    </span>
                </section>
            }
        </aside>
    </div>
    @* Side panels live outside the cards: a collapsed card hides its body, and a panel inside it. *@
    @foreach (var item in allItems.Where(candidate => candidate.ProcurementEdit is not null && candidate.ProcurementPanelId is not null))
    {
        <div class="offcanvas offcanvas-end bd-drawer" tabindex="-1" id="@item.ProcurementPanelId" aria-labelledby="@item.ProcurementPanelId-title">
            <div class="offcanvas-header">
                <div>
                    <h2 class="bd-drawer__title" id="@item.ProcurementPanelId-title">Procurement details</h2>
                    <p class="bd-drawer__subtitle">@item.Title</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body"><partial name="Projects/Procurement/_EditFormBody" model="item.ProcurementEdit" /></div>
        </div>
    }

    @* Current-stage PDC form, offered only when the PDC is missing: posts this one stage to the
       plan editor's own handler, which validates and submits the whole plan for HoD approval.
       A refusal opens the full editor. *@
    @foreach (var panel in allItems.Where(candidate => candidate.PlanPanel is not null).Select(candidate => candidate.PlanPanel!))
    {
        <div class="offcanvas offcanvas-end bd-drawer" tabindex="-1" id="@panel.PanelId" aria-labelledby="@panel.PanelId-title">
            <div class="offcanvas-header">
                <div>
                    <h2 class="bd-drawer__title" id="@panel.PanelId-title">@panel.StageName PDC</h2>
                    <p class="bd-drawer__subtitle">@panel.ProjectName</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <form method="post"
                      class="bd-plan-form"
                      asp-page="/Projects/Timeline/EditPlan"
                      asp-route-id="@panel.ProjectId"
                      asp-route-returnUrl="@panel.ReturnUrl">
                    <input type="hidden" name="Input.Mode" value="@ProjectManagement.ViewModels.PlanEditorModes.Exact" />
                    <input type="hidden" name="Input.ProjectId" value="@panel.ProjectId" />
                    <input type="hidden" name="Input.EditToken" value="@panel.EditToken" />
                    <input type="hidden" name="Input.Rows[0].Code" value="@panel.StageCode" />
                    <input type="hidden" name="Input.Rows[0].Name" value="@panel.StageName" />

                    @* The editor writes back exactly what is posted, so the existing planned start
                       travels unchanged; only the PDC is asked for. *@
                    <input type="hidden" name="Input.Rows[0].PlannedStart" value="@(panel.PlannedStart?.ToString("yyyy-MM-dd"))" />
                    @if (panel.PlannedStart is DateOnly plannedStart)
                    {
                        <p class="bd-plan-form__note">Planned start stays @plannedStart.ToString("dd MMM yyyy"). The PDC must be on or after it.</p>
                    }
                    <div class="bd-plan-form__field">
                        <label for="@panel.PanelId-due">Planned completion (PDC)</label>
                        <input class="form-control" type="date" id="@panel.PanelId-due" name="Input.Rows[0].PlannedDue" required
                               min="@(panel.PlannedStart?.ToString("yyyy-MM-dd"))"
                               value="@(panel.PlannedDue?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <p class="bd-plan-form__note">
                        Only @panel.StageCode changes. Other stages keep their planned dates, and the HoD approves the plan as a whole.
                        If later stages need to move too, use the full plan editor.
                    </p>

                    <div class="bd-plan-form__actions">
                        <button type="submit" class="bd-btn bd-btn--primary" name="Input.Action" value="@ProjectManagement.ViewModels.PlanEditActions.Submit">Submit for HoD approval</button>
                        <a class="bd-link bd-link--small" href="@panel.FullEditorUrl">Open full plan editor</a>
                    </div>
                </form>
            </div>
        </div>
    }
</div>
