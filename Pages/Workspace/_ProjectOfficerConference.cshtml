@using ProjectManagement.ViewModels.Workspace
@model ProjectManagement.Pages.Workspace.IndexModel
@{
    var conference = Model.Conference;
    // An ITO without the Project Officer role has only the IT projects section.
    var itProjectsOnly = conference.Sections.Count > 0
        && conference.Sections.All(section => section.Kind == ConferenceItemKind.ItProject);
}

<div class="officer-conference officer-conference--project-officer"
     data-officer-conference
     data-oc-readonly="true">
    <div class="oc-sticky-shell" data-oc-sticky-shell>
        <header class="oc-header oc-header--readonly" data-oc-sticky-header>
            <div class="oc-header__identity">
                <span class="oc-avatar">@conference.OfficerInitial</span>
                <div>
                    <span class="oc-eyebrow">My conference review</span>
                    <h1>@conference.OfficerDisplayName</h1>
                    <p>
                        @if (!itProjectsOnly)
                        {
                            <span class="oc-header__metric"><strong>@conference.ActiveProjectCount</strong> active @(conference.ActiveProjectCount == 1 ? "project" : "projects")</span>
                            @if (conference.RecentlyCompletedProjectCount > 0)
                            {
                                <span class="oc-header__metric oc-header__metric--carryover"><strong>@conference.RecentlyCompletedProjectCount</strong> recently completed</span>
                            }
                            <span class="oc-header__metric"><strong>@conference.IdeaCount</strong> @(conference.IdeaCount == 1 ? "idea" : "ideas")</span>
                            <span class="oc-header__metric oc-header__metric--tasks @(conference.OtherTaskCount == 0 ? "is-zero" : string.Empty)"><strong>@conference.OtherTaskCount</strong> @(conference.OtherTaskCount == 1 ? "other task" : "other tasks")</span>
                        }
                        @* One figure per module: IT projects for an ITO, MOLTI and SRE projects for their officer. *@
                        @foreach (var moduleCount in conference.ModuleProjectCounts)
                        {
                            <span class="oc-header__metric"><strong>@moduleCount.Count</strong> @moduleCount.Label</span>
                        }
                        @if (itProjectsOnly && conference.ItProjectCount == 0)
                        {
                            <span class="oc-header__metric"><strong>0</strong> IT projects</span>
                        }
                    </p>
                </div>
            </div>

            <div class="oc-readonly-tools" aria-label="Conference review status">
                <span class="oc-readonly-badge">
                    <i class="bi bi-eye" aria-hidden="true"></i>
                    Read only
                </span>
                @await Html.PartialAsync(
                    "_ErpActivityStrip",
                    new ErpActivityStripRenderVm
                    {
                        Activity = conference.ActivityStrip,
                        Title = "ERP activity",
                        Variant = "header",
                        ShowTitle = true,
                        ShowSummary = false,
                        ShowLegend = false
                    })
            </div>
        </header>
    </div>


    <main class="oc-sections">
        @foreach (var section in conference.Sections)
        {
            @await Html.PartialAsync(
                "_ConferenceSection",
                new OfficerConferenceSectionRenderVm
                {
                    OfficerUserId = conference.OfficerUserId,
                    CanManageConference = false,
                    OfficerDisplayName = conference.OfficerDisplayName,
                    CompletedProjectRetentionDays = conference.CompletedProjectRetentionDays,
                    Section = section
                })
        }
    </main>
</div>
