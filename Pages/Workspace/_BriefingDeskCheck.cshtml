@using ProjectManagement.ViewModels.Workspace
@model BriefingDeskCheckVm
@{
    var check = Model;
    var stateClass = check.State switch
    {
        BriefingDeskCheckState.Done when check.IsDueSoon => "bd-check--soon",
        BriefingDeskCheckState.Done => "bd-check--done",
        BriefingDeskCheckState.Submitted => "bd-check--done",
        _ => "bd-check--open"
    };
    var stateLabel = check.State switch
    {
        BriefingDeskCheckState.Done when check.IsDueSoon => "Due soon",
        BriefingDeskCheckState.Done => "Done",
        BriefingDeskCheckState.Submitted => "Done",
        _ => check.IsRequired ? "To do" : "Optional"
    };
    // What is needed before the brief stands out; optional record improvements stay quiet. The
    // small line under the button appears only when someone else decides (the HoD); work the PO
    // completes alone needs no note.
    var routeNote = check.RouteHint ?? (check.Route == BriefingDeskRoute.Approval ? "Needs HoD approval" : null);
    var buttonClass = check.IsRequired ? "bd-btn--required" : "bd-btn--optional";
    var icon = check.State switch
    {
        BriefingDeskCheckState.Done => "bi-check-lg",
        BriefingDeskCheckState.Submitted => "bi-check-lg",
        _ => string.Empty
    };
}
<li class="bd-check @stateClass" data-check="@check.Key">
    <span class="bd-check__mark" aria-hidden="true">@if (!string.IsNullOrEmpty(icon)) { <i class="bi @icon"></i> }</span>
    <div class="bd-check__copy">
        <span class="visually-hidden">@stateLabel: </span>
        <strong>@check.Label</strong>
        <span>@check.Detail</span>
        @if (!string.IsNullOrWhiteSpace(check.SecondaryUrl) && !string.IsNullOrWhiteSpace(check.SecondaryText))
        {
            <a class="bd-check__secondary" href="@check.SecondaryUrl" target="@(check.SecondaryTarget ?? "_blank")">@check.SecondaryText<i class="bi bi-box-arrow-up-right" aria-hidden="true"></i><span class="visually-hidden"> (opens in another tab)</span></a>
        }
    </div>
    <div class="bd-check__action">
        @switch (check.State)
        {
            case BriefingDeskCheckState.Submitted:
                <span class="bd-check__state bd-check__state--done">@check.StateText</span>
                break;
            case BriefingDeskCheckState.Done when check.IsDueSoon:
                <span class="bd-check__state bd-check__state--soon">Due soon</span>
                break;
            case BriefingDeskCheckState.Done:
                @* The green tick says it; the state is read out from the copy. *@
                break;
            default:
                if (!string.IsNullOrWhiteSpace(check.PanelId) && !string.IsNullOrWhiteSpace(check.ActionText))
                {
                    <button type="button"
                            class="bd-btn @buttonClass"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#@check.PanelId"
                            aria-controls="@check.PanelId">@check.ActionText<span class="visually-hidden">: @check.Label</span></button>
                    if (routeNote is not null)
                    {
                        <small class="bd-check__route">@routeNote</small>
                    }
                }
                else if (!string.IsNullOrWhiteSpace(check.ActionUrl) && !string.IsNullOrWhiteSpace(check.ActionText))
                {
                    <a class="bd-btn @buttonClass" href="@check.ActionUrl">@check.ActionText<span class="visually-hidden">: @check.Label</span></a>
                    if (routeNote is not null)
                    {
                        <small class="bd-check__route">@routeNote</small>
                    }
                }
                else if (check.Route != BriefingDeskRoute.Update && string.IsNullOrWhiteSpace(check.SecondaryUrl))
                {
                    <small class="bd-check__route">Use the buttons below</small>
                }
                break;
        }
    </div>
</li>
