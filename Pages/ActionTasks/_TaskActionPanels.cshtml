@model ProjectManagement.Pages.ActionTasks.TaskActionPanelsViewModel
@using ProjectManagement.Models
@using ProjectManagement.Services.ActionTasks
@{
    var task = Model.TaskItem;
    var availableUsers = Model.AssignableUsers
        .Where(user => !string.Equals(user.UserId, task.AssignedToUserId, StringComparison.Ordinal))
        .ToList();
}

<div class="at-task-action-tray @(Model.Compact ? "at-task-peek-action-tray" : "at-task-workspace-action-tray")" data-at-action-tray>
    @if (Model.Capabilities.CanEditTaskDetails)
    {
        <section class="at-task-action-panel" data-at-v22-panel="edit-task" hidden>
            <form method="post" action="@Model.EditTaskPostUrl">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EditTaskInput.TaskId" value="@task.Id" />
                <input type="hidden" name="EditTaskInput.RowVersion" value="@Model.RowVersion" />
                <div class="at-task-action-copy"><strong>Edit task</strong><span>Correct the title or brief without changing workflow state.</span></div>
                <div class="at-task-action-panel-fields is-edit-task">
                    <input name="EditTaskInput.Title" type="text" class="form-control form-control-sm" maxlength="200" required value="@task.Title" placeholder="Task title" />
                    <textarea name="EditTaskInput.Description" class="form-control form-control-sm" rows="@(Model.Compact ? 3 : 2)" maxlength="4000" required placeholder="Task brief">@task.Description</textarea>
                </div>
                <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-primary btn-sm">Save task</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
            </form>
        </section>
    }

    @if (Model.Capabilities.CanReassignTask)
    {
        <section class="at-task-action-panel" data-at-v22-panel="reassign" hidden>
            <form method="post" action="@Model.ReassignPostUrl" data-at-person-picker-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReassignInput.TaskId" value="@task.Id" />
                <input type="hidden" name="ReassignInput.RowVersion" value="@Model.RowVersion" />
                <div class="at-task-action-copy"><strong>Reassign</strong><span>Change responsibility without resetting status or sprint.</span></div>
                <div class="at-task-action-panel-fields is-reassign">
                    <div class="at-person-picker" data-at-person-picker>
                        <input type="hidden" name="ReassignInput.AssignedToUserId" data-at-person-picker-value />
                        <input type="search"
                               class="form-control form-control-sm at-person-picker-search"
                               placeholder="Search rank or name…"
                               autocomplete="off"
                               role="combobox"
                               aria-autocomplete="list"
                               aria-expanded="false"
                               data-at-person-picker-input
                               required />
                        <div class="at-person-picker-menu" role="listbox" data-at-person-picker-menu hidden>
                            @foreach (var user in availableUsers)
                            {
                                <button type="button"
                                        class="at-person-picker-option"
                                        role="option"
                                        data-at-person-picker-option
                                        data-value="@user.UserId"
                                        data-label="@user.DisplayName"
                                        data-role="@ActionTaskPresentation.RoleLabel(user.Role)">
                                    <span>@user.DisplayName</span>
                                    <small>@ActionTaskPresentation.RoleLabel(user.Role)</small>
                                </button>
                            }
                            <div class="at-person-picker-empty" data-at-person-picker-empty hidden>No matching responsible person.</div>
                        </div>
                    </div>
                    <textarea name="ReassignInput.Remarks" class="form-control form-control-sm" rows="2" maxlength="1000" required placeholder="Reason for reassignment"></textarea>
                </div>
                <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-primary btn-sm">Reassign</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
            </form>
        </section>
    }

    @if (Model.Capabilities.CanChangePriority)
    {
        <section class="at-task-action-panel" data-at-v22-panel="priority" hidden>
            <form method="post" action="@Model.PriorityPostUrl">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PriorityInput.TaskId" value="@task.Id" />
                <input type="hidden" name="PriorityInput.RowVersion" value="@Model.RowVersion" />
                <div class="at-task-action-copy"><strong>Change priority</strong><span>Record why the operational priority has changed.</span></div>
                <div class="at-task-action-panel-fields is-priority">
                    <select name="PriorityInput.Priority" class="form-select form-select-sm" required>
                        @foreach (var priority in Model.PriorityOptions)
                        {
                            if (string.Equals(priority, task.Priority, StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@priority" selected>@priority</option>
                            }
                            else
                            {
                                <option value="@priority">@priority</option>
                            }
                        }
                    </select>
                    <textarea name="PriorityInput.Remarks" class="form-control form-control-sm" rows="2" maxlength="1000" required placeholder="Reason for priority change"></textarea>
                </div>
                <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-primary btn-sm">Save priority</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
            </form>
        </section>
    }

    @if (Model.CanBlock)
    {
        <section class="at-task-action-panel" data-at-v22-panel="block" hidden>
            <form method="post" action="@Model.UpdateStatusPostUrl">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@task.Id" />
                <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                <input type="hidden" name="status" value="@ActionTaskStatuses.Blocked" />
                <div class="at-task-action-copy"><strong>Block task</strong><span>Record the blocker so the next action is clear.</span></div>
                <div class="at-task-action-panel-fields is-single"><textarea name="remarks" class="form-control form-control-sm" rows="2" maxlength="4000" required placeholder="What is blocking progress?"></textarea></div>
                <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-warning btn-sm">Mark blocked</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
            </form>
        </section>
    }

    @if (Model.Capabilities.CanSubmitForClosure)
    {
        <section class="at-task-action-panel" data-at-v22-panel="submit" hidden>
            <form method="post" action="@Model.SubmitPostUrl">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@task.Id" />
                <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                <div class="at-task-action-copy"><strong>Submit for closure</strong><span>Record what has been completed for command review.</span></div>
                <div class="at-task-action-panel-fields is-single"><textarea name="remarks" class="form-control form-control-sm" rows="2" maxlength="4000" required placeholder="Completion remarks"></textarea></div>
                <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-primary btn-sm">Submit for closure</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
            </form>
        </section>
    }

    @if (Model.Capabilities.CanReturnForAction)
    {
        <section class="at-task-action-panel" data-at-v22-panel="return" hidden>
            <form method="post" action="@Model.ReturnPostUrl">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@task.Id" />
                <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                <div class="at-task-action-copy"><strong>Return for action</strong><span>Record the further direction before reopening work.</span></div>
                <div class="at-task-action-panel-fields is-single"><textarea name="remarks" class="form-control form-control-sm" rows="2" maxlength="4000" required placeholder="Further direction / reason for return"></textarea></div>
                <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-primary btn-sm">Return for action</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
            </form>
        </section>
    }

    @if (Model.Capabilities.CanAcceptAndClose)
    {
        <section class="at-task-action-panel" data-at-v22-panel="accept-close" hidden>
            <form method="post" action="@Model.ClosePostUrl">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@task.Id" />
                <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                <input type="hidden" name="closeMode" value="accept" />
                <div class="at-task-action-copy"><strong>Accept &amp; close</strong><span>Confirm the submitted work and retain closure remarks.</span></div>
                <div class="at-task-action-panel-fields is-single"><textarea name="remarks" class="form-control form-control-sm" rows="2" maxlength="2000" required placeholder="Closure remarks"></textarea></div>
                <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-primary btn-sm">Accept &amp; close</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
            </form>
        </section>
    }

    @if (Model.Capabilities.CanCloseDirectly)
    {
        <section class="at-task-action-panel" data-at-v22-panel="close-direct" hidden>
            <form method="post" action="@Model.ClosePostUrl">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@task.Id" />
                <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                <input type="hidden" name="closeMode" value="direct" />
                <div class="at-task-action-copy"><strong>Close directly</strong><span>Command override. Closure remarks are retained in task history.</span></div>
                <div class="at-task-action-panel-fields is-single"><textarea name="remarks" class="form-control form-control-sm" rows="2" maxlength="2000" required placeholder="Closure remarks"></textarea></div>
                <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-danger btn-sm">Close directly</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
            </form>
        </section>
    }

    @if (Model.Capabilities.CanChangeDate)
    {
        <section class="at-task-action-panel" data-at-v22-panel="change-date" hidden>
            <form method="post" action="@Model.ChangeDatePostUrl">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ChangeDateInput.TaskId" value="@task.Id" />
                <input type="hidden" name="ChangeDateInput.RowVersion" value="@Model.RowVersion" />
                <div class="at-task-action-copy"><strong>Change @(Model.IsBacklog ? "target" : "due") date</strong><span>Record the reason with the revised date.</span></div>
                <div class="at-task-action-panel-fields">
                    <input name="ChangeDateInput.NewDate" type="date" class="form-control form-control-sm" min="@Model.IstToday.ToString("yyyy-MM-dd")" value="@(task.DueDate.Date >= Model.IstToday ? task.DueDate.ToString("yyyy-MM-dd") : Model.IstToday.ToString("yyyy-MM-dd"))" required />
                    <textarea name="ChangeDateInput.Remarks" class="form-control form-control-sm" rows="2" maxlength="1000" required placeholder="Reason for date change"></textarea>
                </div>
                <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-primary btn-sm">Save date</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
            </form>
        </section>
    }

    @if (Model.HasBacklogAssign)
    {
        <section class="at-task-action-panel" data-at-v22-panel="assign-sprint" hidden>
            <form method="post" action="@Model.AssignBacklogPostUrl">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@task.Id" />
                <div class="at-task-action-copy"><strong>Assign to sprint</strong><span>Select the sprint and responsible person.</span></div>
                <div class="at-task-action-panel-fields is-two-selects">
                    <select name="sprintId" class="form-select form-select-sm" required><option value="">Select sprint</option>@foreach (var sprint in Model.AssignableSprints) { <option value="@sprint.Id">@sprint.Name</option> }</select>
                    <select name="responsibleUserId" class="form-select form-select-sm" required><option value="">Responsible person</option>@foreach (var user in Model.AssignableUsers) { <option value="@user.UserId">@user.DisplayName</option> }</select>
                </div>
                <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-primary btn-sm">Assign</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
            </form>
        </section>
    }

    @if (Model.HasSprintAdd)
    {
        <section class="at-task-action-panel" data-at-v22-panel="add-sprint" hidden>
            <form method="post" action="@Model.AddSprintPostUrl">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@task.Id" />
                <div class="at-task-action-copy"><strong>Add to sprint</strong><span>Keep the current assignee and select a sprint.</span></div>
                <div class="at-task-action-panel-fields is-single"><select name="sprintId" class="form-select form-select-sm" required><option value="">Select sprint</option>@foreach (var sprint in Model.AssignableSprints) { <option value="@sprint.Id">@sprint.Name</option> }</select></div>
                <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-primary btn-sm">Add</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
            </form>
        </section>
    }

    @if (Model.CanRemoveFromSprint)
    {
        <section class="at-task-action-panel" data-at-v22-panel="remove-sprint" hidden>
            <form method="post" action="@Model.RemoveSprintPostUrl">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@task.Id" />
                <div class="at-task-action-copy"><strong>Remove from sprint</strong><span>The task remains assigned.</span></div>
                <div class="at-task-action-panel-fields is-single"><textarea name="remarks" class="form-control form-control-sm" rows="2" maxlength="1000" required placeholder="Reason for removing from sprint"></textarea></div>
                <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-outline-secondary btn-sm">Remove</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
            </form>
        </section>
    }

    @if (Model.CanMoveToBacklog)
    {
        <section class="at-task-action-panel" data-at-v22-panel="backlog" hidden>
            <form method="post" action="@Model.MoveBacklogPostUrl">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@task.Id" />
                <div class="at-task-action-copy"><strong>Return to backlog</strong><span>Remove sprint and assignee so the task can be replanned.</span></div>
                <div class="at-task-action-panel-fields is-single"><textarea name="remarks" class="form-control form-control-sm" rows="2" maxlength="1000" required placeholder="Reason for replanning"></textarea></div>
                <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-outline-warning btn-sm">Move to backlog</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
            </form>
        </section>
    }
</div>
