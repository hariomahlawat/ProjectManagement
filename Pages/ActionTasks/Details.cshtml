@page "{id:int}"
@model ProjectManagement.Pages.ActionTasks.DetailsModel
@using ProjectManagement.Models
@using ProjectManagement.Pages.ActionTasks
@using ProjectManagement.Services.ActionTasks
@{
    ViewData["Title"] = $"AT-{Model.TaskItem.Id} · {Model.TaskItem.Title}";
    ViewData["UseFullWidth"] = true;
    ViewData["PageShell"] = "wide";

    var rowVersion = Convert.ToBase64String(Model.TaskItem.RowVersion);
    var isOverdue = !Model.IsClosed && Model.TaskItem.DueDate.Date < Model.IstToday;
    var overdueDays = isOverdue ? Math.Max(1, (Model.IstToday - Model.TaskItem.DueDate.Date).Days) : 0;
    var statusLabel = Model.IsSubmitted ? "Awaiting Closure" : Model.TaskItem.Status;
    var defaultRemarkType = Model.DefaultRemarkType;
    var updateCount = Model.Updates.Count;
    var attachmentCount = Model.Attachments.Sum(entry => entry.Value.Count);
    var capabilities = Model.Capabilities;
    var hasSprintAdd = Model.CanManagePlanning && !Model.IsBacklog && !Model.TaskItem.SprintId.HasValue && Model.AssignableSprints.Any();
    var hasBacklogAssign = Model.CanManagePlanning && Model.IsBacklog && Model.AssignableSprints.Any() && Model.AssignableUsers.Any();
    var canRemoveFromSprint = Model.CanRemoveFromSprint;
    var canMoveToBacklog = Model.CanMoveToBacklog;
    var updateStatusPostUrl = Url.Page("/ActionTasks/Details", "UpdateStatus", new { id = Model.TaskItem.Id, returnUrl = Model.ReturnUrl }) ?? string.Empty;
}

@section Styles {
    <link rel="stylesheet" href="~/css/action-tracker.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/action-task-actions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/action-task-workspace.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/pages/action-tasks/task-interaction.js" asp-append-version="true"></script>
}

<div class="at-task-workspace" data-at-v2-task-root data-at-task-intent="@(Model.Intent ?? string.Empty)">
    <header class="at-task-workspace-header">
        <div class="at-task-workspace-identity-line">
            <a href="@Model.BackUrl" class="at-task-back-link" aria-label="Back to tasks"><i class="bi bi-arrow-left" aria-hidden="true"></i><span>Tasks</span></a>
            <span class="at-task-workspace-kicker">AT-@Model.TaskItem.Id</span>
            <h1>@Model.TaskItem.Title</h1>
        </div>

        <div class="at-task-workspace-meta">
            @if (!Model.IsBacklog)
            {
                <span class="at-meta-assignee"><i class="bi bi-person" aria-hidden="true"></i>@Model.ResolveAssigneeName()</span>
            }
            <span class="@Model.GetStatusBadgeClass()">@statusLabel</span>
            @if (string.Equals(Model.TaskItem.Priority, "Critical", StringComparison.OrdinalIgnoreCase))
            {
                <span class="@Model.GetPriorityBadgeClass()">@Model.TaskItem.Priority</span>
            }
            @if (isOverdue)
            {
                <span class="at-date-warning">Overdue @overdueDays @(overdueDays == 1 ? "day" : "days")</span>
            }
            <span class="at-meta-date"><i class="bi bi-calendar3" aria-hidden="true"></i>@(Model.IsBacklog ? "Target" : "Due") @Model.TaskItem.DueDate.ToString("dd MMM yyyy")</span>
        </div>

        <partial name="_TaskActionBar" model="@(new TaskActionBarViewModel
        {
            Capabilities = capabilities,
            IsClosed = Model.IsClosed,
            IsBacklog = Model.IsBacklog,
            HasBacklogAssign = hasBacklogAssign,
            HasSprintAdd = hasSprintAdd,
            CanRemoveFromSprint = canRemoveFromSprint,
            CanMoveToBacklog = canMoveToBacklog,
            Compact = false,
            RowVersion = rowVersion,
            UpdateStatusPostUrl = updateStatusPostUrl
        })" />

        @if (!Model.IsClosed)
        {
            <div class="at-task-action-tray at-task-workspace-action-tray">
                @if (capabilities.CanBlockAsOwner || capabilities.CanBlockAsCommandControl)
                {
                    <section class="at-task-action-panel" data-at-v22-panel="block" hidden>
                        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" asp-page-handler="UpdateStatus">
                            <input type="hidden" name="id" value="@Model.TaskItem.Id" />
                            <input type="hidden" name="rowVersion" value="@rowVersion" />
                            <input type="hidden" name="status" value="@ActionTaskStatuses.Blocked" />
                            <div class="at-task-action-copy"><strong>Block task</strong><span>Record the blocker so the next action is clear.</span></div>
                            <div class="at-task-action-panel-fields is-single"><textarea name="remarks" class="form-control" rows="2" maxlength="4000" required placeholder="What is blocking progress?"></textarea></div>
                            <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-warning btn-sm">Mark blocked</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
                        </form>
                    </section>
                }
                @if (capabilities.CanSubmitForClosure)
                {
                    <section class="at-task-action-panel" data-at-v22-panel="submit" hidden>
                        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" asp-page-handler="Submit">
                            <input type="hidden" name="id" value="@Model.TaskItem.Id" />
                            <input type="hidden" name="rowVersion" value="@rowVersion" />
                            <div class="at-task-action-copy"><strong>Submit for closure</strong><span>Give the reviewer a concise completion note.</span></div>
                            <div class="at-task-action-panel-fields is-single"><textarea name="remarks" class="form-control" rows="2" maxlength="4000" required placeholder="Completion remarks"></textarea></div>
                            <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-primary btn-sm">Submit for closure</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
                        </form>
                    </section>
                }
                @if (capabilities.CanReturnForAction)
                {
                    <section class="at-task-action-panel" data-at-v22-panel="return" hidden>
                        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" asp-page-handler="ReturnForAction">
                            <input type="hidden" name="id" value="@Model.TaskItem.Id" />
                            <input type="hidden" name="rowVersion" value="@rowVersion" />
                            <div class="at-task-action-copy"><strong>Return for action</strong><span>State exactly what remains to be done.</span></div>
                            <div class="at-task-action-panel-fields is-single"><textarea name="remarks" class="form-control" rows="2" maxlength="4000" required placeholder="Further direction / reason for return"></textarea></div>
                            <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-primary btn-sm">Return for action</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
                        </form>
                    </section>
                }
                @if (capabilities.CanAcceptAndClose)
                {
                    <section class="at-task-action-panel" data-at-v22-panel="accept-close" hidden>
                        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" asp-page-handler="Close">
                            <input type="hidden" name="id" value="@Model.TaskItem.Id" />
                            <input type="hidden" name="rowVersion" value="@rowVersion" />
                            <input type="hidden" name="closeMode" value="accept" />
                            <div class="at-task-action-copy"><strong>Accept &amp; close</strong><span>Record the closure decision.</span></div>
                            <div class="at-task-action-panel-fields is-single"><textarea name="remarks" class="form-control" rows="2" maxlength="2000" required placeholder="Closure remarks"></textarea></div>
                            <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-primary btn-sm">Accept &amp; close</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
                        </form>
                    </section>
                }
                @if (capabilities.CanCloseDirectly && !capabilities.CanAcceptAndClose)
                {
                    <section class="at-task-action-panel" data-at-v22-panel="close-direct" hidden>
                        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" asp-page-handler="Close">
                            <input type="hidden" name="id" value="@Model.TaskItem.Id" />
                            <input type="hidden" name="rowVersion" value="@rowVersion" />
                            <input type="hidden" name="closeMode" value="direct" />
                            <div class="at-task-action-copy"><strong>Close directly</strong><span>Command override. Closure remarks are retained in task history.</span></div>
                            <div class="at-task-action-panel-fields is-single"><textarea name="remarks" class="form-control" rows="2" maxlength="2000" required placeholder="Closure remarks"></textarea></div>
                            <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-danger btn-sm">Close directly</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
                        </form>
                    </section>
                }
                @if (capabilities.CanChangeDate)
                {
                    <section class="at-task-action-panel" data-at-v22-panel="change-date" hidden>
                        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" asp-page-handler="ChangeDate">
                            <input type="hidden" asp-for="ChangeDateInput.TaskId" value="@Model.TaskItem.Id" />
                            <input type="hidden" asp-for="ChangeDateInput.RowVersion" value="@rowVersion" />
                            <div class="at-task-action-copy"><strong>Change @(Model.IsBacklog ? "target" : "due") date</strong><span>Record the reason with the revised date.</span></div>
                            <div class="at-task-action-panel-fields"><input asp-for="ChangeDateInput.NewDate" type="date" class="form-control form-control-sm" min="@Model.IstToday.ToString("yyyy-MM-dd")" value="@(Model.TaskItem.DueDate.Date >= Model.IstToday ? Model.TaskItem.DueDate.ToString("yyyy-MM-dd") : Model.IstToday.ToString("yyyy-MM-dd"))" /><textarea asp-for="ChangeDateInput.Remarks" class="form-control form-control-sm" rows="2" maxlength="1000" required placeholder="Reason for date change"></textarea></div>
                            <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-primary btn-sm">Save date</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
                        </form>
                    </section>
                }
                @if (hasBacklogAssign)
                {
                    <section class="at-task-action-panel" data-at-v22-panel="assign-sprint" hidden>
                        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" asp-page-handler="AssignBacklogToSprint">
                            <input type="hidden" name="id" value="@Model.TaskItem.Id" />
                            <div class="at-task-action-copy"><strong>Assign to sprint</strong><span>Select the sprint and responsible person.</span></div>
                            <div class="at-task-action-panel-fields is-two-selects"><select name="sprintId" class="form-select form-select-sm" required><option value="">Select sprint</option>@foreach (var sprint in Model.AssignableSprints) { <option value="@sprint.Id">@sprint.Name</option> }</select><select name="responsibleUserId" class="form-select form-select-sm" required><option value="">Responsible person</option>@foreach (var user in Model.AssignableUsers) { <option value="@user.UserId">@user.DisplayName</option> }</select></div>
                            <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-primary btn-sm">Assign</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
                        </form>
                    </section>
                }
                @if (hasSprintAdd)
                {
                    <section class="at-task-action-panel" data-at-v22-panel="add-sprint" hidden>
                        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" asp-page-handler="AssignOutsideToSprint">
                            <input type="hidden" name="id" value="@Model.TaskItem.Id" />
                            <div class="at-task-action-copy"><strong>Add to sprint</strong><span>Keep the current assignee and select a sprint.</span></div>
                            <div class="at-task-action-panel-fields is-single"><select name="sprintId" class="form-select form-select-sm" required><option value="">Select sprint</option>@foreach (var sprint in Model.AssignableSprints) { <option value="@sprint.Id">@sprint.Name</option> }</select></div>
                            <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-primary btn-sm">Add</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
                        </form>
                    </section>
                }
                @if (canRemoveFromSprint)
                {
                    <section class="at-task-action-panel" data-at-v22-panel="remove-sprint" hidden>
                        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" asp-page-handler="RemoveFromSprint">
                            <input type="hidden" name="id" value="@Model.TaskItem.Id" />
                            <div class="at-task-action-copy"><strong>Remove from sprint</strong><span>The task remains assigned.</span></div>
                            <div class="at-task-action-panel-fields is-single"><textarea name="remarks" class="form-control form-control-sm" rows="2" maxlength="1000" required placeholder="Reason for removing from sprint"></textarea></div>
                            <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-outline-secondary btn-sm">Remove</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
                        </form>
                    </section>
                }
                @if (canMoveToBacklog)
                {
                    <section class="at-task-action-panel" data-at-v22-panel="backlog" hidden>
                        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" asp-page-handler="MoveToBacklog">
                            <input type="hidden" name="id" value="@Model.TaskItem.Id" />
                            <div class="at-task-action-copy"><strong>Return to backlog</strong><span>Remove sprint and assignee so the task can be replanned.</span></div>
                            <div class="at-task-action-panel-fields is-single"><textarea name="remarks" class="form-control form-control-sm" rows="2" maxlength="1000" required placeholder="Reason for replanning"></textarea></div>
                            <div class="at-task-action-panel-controls"><button type="submit" class="btn btn-outline-warning btn-sm">Move to backlog</button><button type="button" class="btn btn-link btn-sm" data-at-v22-cancel>Cancel</button></div>
                        </form>
                    </section>
                }
            </div>
        }
    </header>

    <div class="at-task-workspace-grid">
        <main class="at-task-workspace-main">
            <section class="at-task-section at-task-brief-card">
                <div class="at-task-section-label">Task brief</div>
                <div class="at-task-brief-copy @(string.IsNullOrWhiteSpace(Model.TaskItem.Description) ? "is-muted" : string.Empty)">
                    @(string.IsNullOrWhiteSpace(Model.TaskItem.Description) ? "No task brief recorded." : Model.TaskItem.Description)
                </div>
            </section>

            <section class="at-task-section at-task-updates-section" id="updates">
                <div class="at-task-section-header">
                    <div>
                        <div class="at-task-section-label">Updates</div>
                        <h2>Discussion &amp; progress</h2>
                    </div>
                    <span class="at-count-chip">@updateCount</span>
                </div>

                @if (capabilities.CanAddRemark)
                {
                    <form method="post" asp-route-returnUrl="@Model.ReturnUrl" asp-page-handler="AddRemark" enctype="multipart/form-data" class="at-v2-remark-composer at-workspace-remark-composer" data-at-v2-remark-composer>
                        <input type="hidden" asp-for="RemarkInput.TaskId" value="@Model.TaskItem.Id" />
                        <input type="hidden" asp-for="RemarkInput.UpdateType" value="@defaultRemarkType" data-at-v2-remark-type />
                        @if (capabilities.CanAddConferenceRemark)
                        {
                            <div class="at-v2-remark-types" role="group" aria-label="Remark type">
                                <button type="button" data-at-v2-remark-option="@ActionTaskUpdateTypes.Comment">General</button>
                                <button type="button" data-at-v2-remark-option="@ActionTaskUpdateTypes.Conference">Conference</button>
                            </div>
                        }
                        <textarea asp-for="RemarkInput.Body" rows="3" maxlength="4000" class="form-control" placeholder="Add a remark…" data-at-v2-remark-body></textarea>
                        <div class="at-v2-composer-footer">
                            <label class="at-v2-attach-button">
                                <i class="bi bi-paperclip" aria-hidden="true"></i><span>Attach</span>
                                <input asp-for="RemarkInput.Files" type="file" multiple hidden data-at-v2-file-input />
                            </label>
                            <span class="at-v2-file-summary" data-at-v2-file-summary></span>
                            <button type="submit" class="btn btn-primary btn-sm">Post</button>
                        </div>
                    </form>
                }

                <partial name="_TaskUpdateTimeline" model="@(new TaskUpdateTimelineViewModel
                {
                    Updates = Model.Updates,
                    Attachments = Model.Attachments,
                    ResolveActorName = Model.ResolveActorName,
                    Compact = false
                })" />
            </section>
        </main>

        <aside class="at-task-workspace-rail">
            <section class="at-task-side-card at-task-details-card">
                <div class="at-task-section-label">Task details</div>
                <div class="at-task-property-list">
                    <div class="at-task-property-row"><span class="at-task-property-key">Status</span><span class="at-task-property-value"><span class="@Model.GetStatusBadgeClass()">@statusLabel</span></span></div>
                    @if (!Model.IsBacklog)
                    {
                        <div class="at-task-property-row"><span class="at-task-property-key">Assigned to</span><span class="at-task-property-value">@Model.ResolveAssigneeName()</span></div>
                    }
                    <div class="at-task-property-row"><span class="at-task-property-key">@(Model.IsBacklog ? "Target date" : "Due date")</span><span class="at-task-property-value">@Model.TaskItem.DueDate.ToString("dd MMM yyyy")</span></div>
                    <div class="at-task-property-row"><span class="at-task-property-key">Sprint</span><span class="at-task-property-value">@Model.GetSprintText()</span></div>
                    <div class="at-task-property-row"><span class="at-task-property-key">Priority</span><span class="at-task-property-value">@Model.TaskItem.Priority</span></div>
                    <div class="at-task-property-row"><span class="at-task-property-key">Updated</span><span class="at-task-property-value">@(Model.LastActivityAtUtc.HasValue ? TimeFmt.ToIst(Model.LastActivityAtUtc.Value) : "Not recorded")</span></div>
                    <div class="at-task-property-row"><span class="at-task-property-key">Files</span><span class="at-task-property-value">@attachmentCount</span></div>
                </div>
            </section>

            @if (Model.IsClosed)
            {
                <section class="at-task-side-card">
                    <div class="at-task-section-label">Closure</div>
                    <div class="at-task-property-list">
                        <div class="at-task-property-row"><span class="at-task-property-key">Closed on</span><span class="at-task-property-value">@(Model.TaskItem.ClosedOn.HasValue ? TimeFmt.ToIst(Model.TaskItem.ClosedOn.Value) : "Not recorded")</span></div>
                        <div class="at-task-property-row"><span class="at-task-property-key">Closed by</span><span class="at-task-property-value">@Model.ResolveClosedByName()</span></div>
                    </div>
                    <div class="at-task-side-remarks">@(string.IsNullOrWhiteSpace(Model.TaskItem.ClosureRemarks) ? "No closure remarks recorded." : Model.TaskItem.ClosureRemarks)</div>
                </section>
            }

            @if (capabilities.CanViewSystemHistory)
            {
                <details class="at-task-side-card at-task-history-card">
                    <summary>Activity history <span class="at-count-chip">@Model.Logs.Count</span></summary>
                    <div class="at-task-history-list">
                        @foreach (var log in Model.Logs.OrderByDescending(log => log.PerformedAt))
                        {
                            var auditSummary = ActionTaskPresentation.AuditSummary(log);
                            <article>
                                <div><strong>@ActionTaskPresentation.AuditActionLabel(log.ActionType)</strong></div>
                                @if (!string.IsNullOrWhiteSpace(auditSummary))
                                {
                                    <div class="at-task-history-summary">@auditSummary</div>
                                }
                                <div class="text-muted small">@Model.ResolveActorName(log.PerformedByUserId) · @TimeFmt.ToIst(log.PerformedAt)</div>
                                @if (!string.IsNullOrWhiteSpace(log.Remarks) && !string.Equals(log.Remarks.Trim(), auditSummary, StringComparison.Ordinal))
                                {
                                    <div class="at-task-history-remarks">@log.Remarks</div>
                                }
                            </article>
                        }
                    </div>
                </details>
            }
        </aside>
    </div>
</div>
