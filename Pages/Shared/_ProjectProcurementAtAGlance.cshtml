@model ProjectManagement.Services.Projects.ProcurementAtAGlanceVm
@using System.Globalization
@using ProjectManagement.Models.Arpp
@using ProjectManagement.Utilities
@using ProjectManagement.Areas.ProjectOfficeReports.Application
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    string ShortInr(decimal value)
    {
        var culture = CultureInfo.GetCultureInfo("en-IN");
        var abs = System.Math.Abs(value);

        if (abs >= 1_00_00_000m)
        {
            return $"₹ {(value / 1_00_00_000m).ToString("0.##", culture)} Cr";
        }

        if (abs >= 1_00_000m)
        {
            return $"₹ {(value / 1_00_000m).ToString("0.##", culture)} Lakh";
        }

        return value.ToString("C2", culture);
    }

    string Money(decimal? value) => value.HasValue ? ShortInr(value.Value) : "—";
    string FullInr(decimal? value) => value.HasValue ? value.Value.ToString("C2", CultureInfo.GetCultureInfo("en-IN")) : "—";
    string DateDmy(DateOnly? d) => d.HasValue ? d.Value.ToString("dd MMM yyyy", CultureInfo.CurrentCulture) : "—";

    var canEdit = User.IsInRole("Admin") || User.IsInRole("HoD") || User.IsInRole("Project Officer");
    var hasAnyData = Model.IpaCost.HasValue ||
                     Model.AonCost.HasValue ||
                     Model.BenchmarkCost.HasValue ||
                     Model.L1Cost.HasValue ||
                     Model.PncCost.HasValue ||
                     Model.SupplyOrderDate.HasValue;

    var ipaPosition = Model.IpaPosition;
    var ipaCategory = ipaPosition?.Category is { } category
        ? ArppDisplayNames.For(category)
        : null;
    var ipaSourceParts = new List<string>();
    if (ipaPosition?.IsManagedByArpp == true)
    {
        var documentLabel = ipaPosition.IssueSequence.GetValueOrDefault() == 0
            ? "Original ARPP"
            : $"Addendum No. {ipaPosition.IssueSequence}";
        ipaSourceParts.Add(documentLabel);

        if (ipaPosition.IssueDate.HasValue)
        {
            ipaSourceParts.Add(ipaPosition.IssueDate.Value.ToString("dd MMM yyyy", CultureInfo.CurrentCulture));
        }

        if (!string.IsNullOrWhiteSpace(ipaPosition.SerialNumber))
        {
            ipaSourceParts.Add($"Ser No. {ipaPosition.SerialNumber}");
        }

        if (!string.IsNullOrWhiteSpace(ipaPosition.PppNumber))
        {
            ipaSourceParts.Add($"PPP No. {ipaPosition.PppNumber}");
        }
    }

    var ipaSourceText = string.Join(" · ", ipaSourceParts);
    var canViewArpp = (await AuthorizationService.AuthorizeAsync(
        User,
        resource: null,
        policyName: ProjectOfficeReportsPolicies.ViewArpp)).Succeeded;
}

<div class="card pm-card procurement-summary-card">
  <div class="card-header pm-card-header">
    <div class="pm-card-heading">
      <span class="pm-card-icon" aria-hidden="true">
        <i class="bi bi-receipt"></i>
      </span>
      <div>
        <h2 class="pm-card-title h5 mb-0">Procurement at a glance</h2>
        <p class="pm-card-subtitle mb-0">Key budget markers for this project.</p>
      </div>
    </div>
    @if (canEdit && hasAnyData)
    {
      <div class="pm-card-menu dropdown">
        <button type="button"
                class="btn pm-card-menu-toggle"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                aria-label="Procurement actions">
          <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <li>
            <button type="button"
                    class="dropdown-item d-flex align-items-center gap-2"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#offcanvasProcurement"
                    aria-controls="offcanvasProcurement">
              <i class="bi bi-pencil-square" aria-hidden="true"></i>
              <span>Edit details</span>
            </button>
          </li>
        </ul>
      </div>
    }
  </div>

  <div class="card-body pm-card-body">
    @if (!hasAnyData)
    {
      <div class="procurement-empty-state">
        <span class="procurement-empty-state__icon" aria-hidden="true"><i class="bi bi-receipt-cutoff"></i></span>
        <div class="procurement-empty-state__content">
          <strong>No procurement milestones recorded</strong>
          <span>Add IPA, AoN, benchmark, commercial or supply-order details when available.</span>
        </div>
        @if (canEdit)
        {
          <button type="button"
                  class="btn btn-sm btn-primary"
                  data-bs-toggle="offcanvas"
                  data-bs-target="#offcanvasProcurement"
                  aria-controls="offcanvasProcurement">
            Add procurement details
          </button>
        }
      </div>
    }
    else
    {
      <div class="procurement-metrics">
        <div>
          <span class="procurement-label text-muted">IPA Cost</span>
          <span class="procurement-value fw-semibold" title="@FullInr(Model.IpaCost)">@Money(Model.IpaCost)</span>
          @if (ipaPosition?.IsManagedByArpp == true && ipaCategory is not null)
          {
            <span class="badge rounded-pill text-bg-light border mt-1">@ipaCategory</span>
          }
        </div>
        <div>
          <span class="procurement-label text-muted">AON Cost</span>
          <span class="procurement-value fw-semibold" title="@FullInr(Model.AonCost)">@Money(Model.AonCost)</span>
        </div>
        <div>
          <span class="procurement-label text-muted">Benchmark Cost</span>
          <span class="procurement-value fw-semibold" title="@FullInr(Model.BenchmarkCost)">@Money(Model.BenchmarkCost)</span>
        </div>
        <div>
          <span class="procurement-label text-muted">L1 Cost</span>
          <span class="procurement-value fw-semibold" title="@FullInr(Model.L1Cost)">@Money(Model.L1Cost)</span>
        </div>
        <div>
          <span class="procurement-label text-muted">PNC Cost</span>
          <span class="procurement-value fw-semibold" title="@FullInr(Model.PncCost)">@Money(Model.PncCost)</span>
        </div>
        <div>
          <span class="procurement-label text-muted">Supply Order Date</span>
          <span class="procurement-value fw-semibold">@DateDmy(Model.SupplyOrderDate)</span>
        </div>
      </div>

      @if (ipaPosition?.IsManagedByArpp == true)
      {
        <div class="mt-2 small text-muted d-flex flex-wrap align-items-center gap-2">
          <span><strong>Current IPA source:</strong> @ipaSourceText</span>
          @if (canViewArpp && ipaPosition.IssueId.HasValue)
          {
            <a asp-area="ProjectOfficeReports"
               asp-page="/ARPP/Details"
               asp-route-id="@ipaPosition.IssueId.Value"
               class="fw-semibold">View ARPP issue</a>
          }
          <a asp-area=""
             asp-page="/Projects/Arpp/History"
             asp-route-projectId="@ipaPosition.ProjectId"
             asp-route-financialYearStart="@ipaPosition.FinancialYearStart"
             class="fw-semibold">ARPP history</a>
        </div>
      }
      else if (ipaPosition?.IsLegacyFallback == true)
      {
        <div class="mt-2 small text-muted">
          IPA source: legacy project record. ARPP will become authoritative after this project is linked to an ARPP entry.
        </div>
      }
      else
      {
        <div class="mt-2 small text-muted">
          Values reflect the latest recorded procurement facts.
        </div>
      }
    }
  </div>
</div>
