@model ProjectManagement.ViewComponents.NavigationDrawerViewModel
@using System.Linq
@using ProjectManagement.Models.Navigation
@using ProjectManagement.ViewComponents
@{
    const string drawerId = "pmNavigationDrawer";
    const string drawerLabelId = "pmNavigationDrawerLabel";
    const string linkPartial = "~/Pages/Shared/Components/NavigationDrawer/_NavigationDrawerLink.cshtml";
}

@* Layout and rules: docs/ux/navigation-drawer.md. The data-drawer-* hooks are the contract with
   wwwroot/js/navigation/drawer.js; keep them stable, because that module is imported without a
   version stamp and a cached copy may meet newer markup. *@
@if (Model.Items?.Any() ?? false)
{
    <div class="pm-drawer-toggle">
        <button class="navbar-toggler pm-drawer-toggle__button" type="button"
                data-drawer-toggle
                data-drawer-target="@drawerId"
                aria-controls="@drawerId"
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-label="Toggle navigation menu">
            <span class="pm-drawer-toggle__icon" aria-hidden="true"><i class="bi bi-list"></i></span>
            <span class="pm-drawer-toggle__label">Menu</span>
        </button>

        <div class="pm-drawer" data-drawer="@drawerId" id="@drawerId">
            <div class="pm-drawer__overlay" data-drawer-overlay></div>
            <div class="pm-drawer__panel" data-drawer-panel role="dialog" aria-modal="true" aria-labelledby="@drawerLabelId">
                <div class="pm-drawer__header">
                    <div class="pm-drawer__brand">
                        <span class="pm-drawer__brand-mark" aria-hidden="true"><i class="bi bi-bezier"></i></span>
                        <h2 class="pm-drawer__title" id="@drawerLabelId">@Model.Brand</h2>
                    </div>
                    <button type="button" class="pm-drawer__close" data-drawer-close aria-label="Close navigation menu">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="pm-drawer__body">
                    <nav class="pm-drawer__nav" aria-label="All PRISM areas">
                        @foreach (var drawerSection in Model.Items)
                        {
                            var sectionKey = drawerSection.Key ?? "section";
                            var titleId = $"pmDrawerSection_{sectionKey}";

                            if (sectionKey == NavigationSectionKeys.Main)
                            {
                                @* Main is always open: it is the only primary navigation on phones. *@
                                <section class="pm-drawer__section pm-drawer__section--main" data-drawer-section="@sectionKey" aria-labelledby="@titleId">
                                    <h3 class="pm-drawer__section-title" id="@titleId">@drawerSection.Text</h3>
                                    <ul class="pm-drawer__list">
                                        @foreach (var link in drawerSection.Children)
                                        {
                                            <partial name="@linkPartial" model="link" />
                                        }
                                    </ul>
                                </section>
                            }
                            else
                            {
                                @* Only the section holding the current page starts open; drawer.js keeps one open at a time. *@
                                var panelId = $"pmDrawerSectionPanel_{sectionKey}";
                                var isOpen = drawerSection.HasActiveDescendant;

                                <details class="pm-drawer__section pm-drawer__group" data-drawer-group data-drawer-section="@sectionKey" open="@(isOpen ? "open" : null)">
                                    <summary class="pm-drawer__section-summary" data-drawer-group-summary
                                             aria-controls="@panelId"
                                             aria-expanded="@(isOpen ? "true" : "false")">
                                        <span class="pm-drawer__section-title" id="@titleId">@drawerSection.Text</span>
                                        @if (drawerSection.HasActiveDescendant)
                                        {
                                            <span class="visually-hidden">(current section)</span>
                                        }
                                        <span class="pm-drawer__caret" aria-hidden="true"><i class="bi bi-chevron-down"></i></span>
                                    </summary>
                                    <div class="pm-drawer__group-panel" id="@panelId" data-drawer-group-panel aria-hidden="@(isOpen ? "false" : "true")">
                                        <ul class="pm-drawer__list" aria-labelledby="@titleId">
                                            @foreach (var link in drawerSection.Children)
                                            {
                                                <partial name="@linkPartial" model="link" />
                                            }
                                        </ul>
                                    </div>
                                </details>
                            }
                        }
                    </nav>
                </div>

                @if (!string.IsNullOrEmpty(Model.UserName))
                {
                    <div class="pm-drawer__footer">
                        <i class="bi bi-person-circle" aria-hidden="true"></i>
                        <span>Signed in as <strong class="pm-drawer__footer-name">@Model.UserName</strong></span>
                    </div>
                }
            </div>
        </div>
    </div>
}
