@page
@model ProjectManagement.Pages.Admin.MediaIntelligence.IndexModel
@inject ProjectManagement.Services.Admin.IAdminTimeService Time
@{
    ViewData["Title"] = "Media intelligence";
}
<link rel="stylesheet" href="~/css/pages/media-intelligence.css" asp-append-version="true" />
<div class="container-fluid py-4 media-intelligence-page">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div>
            <div class="text-primary small text-uppercase fw-semibold mb-1">System</div>
            <h1 class="h3 mb-1">Media intelligence</h1>
            <p class="text-muted mb-0">Sorts photos from other images, and finds faces so people can be named. Everything runs on this server, and a person always confirms who is who.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-page="/Admin/MediaSources/Index">Media sources</a>
    </div>

    <nav class="intel-tabs mb-4" aria-label="Media intelligence sections">
        <a class="active" asp-page="/Admin/MediaIntelligence/Index">Overview</a>
        <a asp-page="/Admin/MediaIntelligence/Classifications">Classification</a>
        @if (Model.PeopleEnabled)
        {
            <a asp-page="/Photos/People/Review" asp-route-Mode="matches">Identify people</a>
            <a asp-page="/Photos/People/Index">People</a>
        }
    </nav>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="alert alert-success">@Model.StatusMessage</div> }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }

    @if (!Model.SchemaReady)
    {
        <div class="alert alert-danger d-flex align-items-start gap-3" role="alert">
            <i class="bi bi-database-exclamation fs-4" aria-hidden="true"></i>
            <div>
                <strong>The media database is not fully upgraded</strong>
                <div class="mt-1">@(Model.SchemaStatus.Error ?? "The deployed MediaLibraryDbContext schema could not be validated.")</div>
                @if (Model.SchemaStatus.PendingMigrations.Count > 0)
                {
                    <div class="small mt-2">Upgrades still to run: @string.Join(", ", Model.SchemaStatus.PendingMigrations)</div>
                }
                <div class="small mt-2">Reference: <code>@Model.SchemaStatus.DiagnosticReference</code>. Photo processing stays off until PRISM finishes upgrading its database when it starts.</div>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.TelemetryWarning))
    {
        <div class="alert alert-warning" role="alert">
            <strong>Some figures could not be loaded.</strong> @Model.TelemetryWarning
        </div>
    }

    <section class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start mb-3">
                <div>
                    <h2 class="h5 mb-1">Is it ready?</h2>
                    <p class="text-muted mb-0">Every check must pass before photos can be sent for face finding.</p>
                </div>
                <form method="post" asp-page-handler="RefreshReadiness">
                    <button class="btn btn-outline-primary btn-sm" type="submit" disabled="@(!Model.SchemaReady)">Check again</button>
                </form>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-lg-6">
                    <div class="alert @(Model.DetectorStatus.IsReady ? "alert-success" : "alert-warning") h-100 mb-0">
                        <strong>Sorting photos:</strong> @Model.DetectorStatus.Message
                        <span class="d-block small mt-1">Sorting only looks for faces; it never works out who anyone is.</span>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="alert @(Model.ModelStatus.IsReady ? "alert-success" : "alert-warning") h-100 mb-0">
                        <strong>Finding people:</strong> @Model.ModelStatus.Message
                        <span class="d-block small mt-1">Checked @Time.FormatIst(Model.ModelStatus.CheckedAtUtc)</span>
                    </div>
                </div>
            </div>
            @* Each check is technical detail; it opens by itself when something is not ready (docs/ux/admin-review-fixes.md, PR 10). *@
            <details class="admin-technical-details" @(Model.DetectorStatus.IsReady && Model.ModelStatus.IsReady ? null : "open")>
            <summary>Technical details: each check</summary>
            <div class="p-3">
            <h3 class="h6 mb-2">Sorting photos</h3>
            <div class="readiness-grid mb-4">
                @foreach (var check in Model.DetectorStatus.Checks)
                {
                    <div class="readiness-item @(check.IsSatisfied ? "is-ready" : "is-blocked")">
                        <div class="d-flex justify-content-between gap-2">
                            <strong>@check.Label</strong>
                            <span class="badge @(check.IsSatisfied ? "text-bg-success" : "text-bg-secondary")" title="@check.Status">@check.Status</span>
                        </div>
                        @if (!check.IsSatisfied && !string.IsNullOrWhiteSpace(check.Action))
                        {
                            <div class="small text-muted mt-2">@check.Action</div>
                        }
                    </div>
                }
            </div>

            <h3 class="h6 mb-2">Finding people</h3>
            <div class="readiness-grid">
                @foreach (var check in Model.ModelStatus.Checks)
                {
                    <div class="readiness-item @(check.IsSatisfied ? "is-ready" : "is-blocked")">
                        <div class="d-flex justify-content-between gap-2">
                            <strong>@check.Label</strong>
                            <span class="badge @(check.IsSatisfied ? "text-bg-success" : "text-bg-secondary")" title="@check.Status">@check.Status</span>
                        </div>
                        @if (!check.IsSatisfied && !string.IsNullOrWhiteSpace(check.Action))
                        {
                            <div class="small text-muted mt-2">@check.Action</div>
                        }
                    </div>
                }
            </div>
            </div>
            </details>
        </div>
    </section>

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl"><div class="metric-card"><span>Images</span><strong>@Model.AvailableImages</strong><small>Videos are not sorted</small></div></div>
        <div class="col-6 col-xl"><div class="metric-card"><span>Photos ready for face finding</span><strong>@Model.Eligible</strong></div></div>
        <div class="col-6 col-xl"><div class="metric-card"><span>Not sure: need a look</span><strong>@Model.NeedsReview</strong>@if (Model.NeedsReview > 0)
            {<small>@Model.LowConfidence scored too low to decide · @Model.NeedsReviewOtherReasons for another reason</small>}</div></div>
        <div class="col-6 col-xl"><div class="metric-card"><span>Not photos</span><strong>@Model.ConfirmedNonPhotographs</strong></div></div>
        <div class="col-6 col-xl"><div class="metric-card"><span>Waiting for face finding</span><strong>@Model.FaceAdmissionPending</strong></div></div>
        <div class="col-6 col-xl"><div class="metric-card"><span>Waiting to be sorted</span><strong>@Model.PendingClassification</strong></div></div>
        <div class="col-6 col-xl"><div class="metric-card"><span>Could not be sorted</span><strong>@Model.FailedClassification</strong></div></div>
        @if (Model.PeopleEnabled)
        {
            <div class="col-6 col-xl"><div class="metric-card"><span>Faces found</span><strong>@Model.Faces</strong></div></div>
            <div class="col-6 col-xl"><div class="metric-card"><span>Faces ready to match</span><strong>@Model.Embedded</strong></div></div>
        }
    </div>

    <details class="admin-more-panel card shadow-sm border-0 mb-4 p-4">
        <summary><h2>Technical details: how photos were sorted</h2></summary>
        <div>
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                <p class="text-muted mb-0">How the current sorting decided, and where it was unsure.</p>
                <a class="btn btn-outline-primary btn-sm" asp-page="/Admin/MediaIntelligence/Classifications" asp-route-mode="risk">Check unsure photos</a>
            </div>
            <div class="row g-3">
                <div class="col-6 col-lg"><div class="metric-card"><span>Sorted by the current version</span><strong>@Model.CurrentClassifierAssets</strong></div></div>
                <div class="col-6 col-lg"><div class="metric-card"><span>Sent to a person to check</span><strong>@Model.SafetyGateReferrals</strong></div></div>
                <div class="col-6 col-lg"><div class="metric-card"><span>Faces helped decide</span><strong>@Model.FaceEvidenceUsed</strong></div></div>
                <div class="col-6 col-lg"><div class="metric-card"><span>Face-like shapes ignored</span><strong>@Model.FaceEvidenceBlocked</strong></div></div>
                <div class="col-6 col-lg"><div class="metric-card"><span>Corrected by a person</span><strong>@Model.ManualCorrections</strong></div></div>
            </div>
        </div>
    </details>

    @if (Model.PeopleEnabled)
    {
            <section class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <h2 class="h5 mb-1">Identify people</h2>
                            <p class="text-muted mb-0">New faces are compared with people already named, in the background. A person always confirms who is who.</p>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <form method="post" asp-page-handler="RefreshIdentityCandidates">
                                <button class="btn btn-outline-primary btn-sm" type="submit" disabled="@(!Model.SchemaReady || !Model.ModelStatus.IsReady)">Look for matches again</button>
                            </form>
                            <a class="btn btn-primary btn-sm" asp-page="/Photos/People/Review" asp-route-Mode="matches">Review people</a>
                            <a class="btn btn-outline-secondary btn-sm" asp-page="/Photos/People/Index">Open people</a>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-6 col-lg"><div class="metric-card"><span>Confirmed people</span><strong>@Model.Persons</strong></div></div>
                        <div class="col-6 col-lg"><div class="metric-card"><span>Confirmed appearances</span><strong>@Model.ConfirmedAppearances</strong></div></div>
                        <div class="col-6 col-lg"><div class="metric-card"><span>Suggested matches</span><strong>@Model.KnownPersonSuggestions</strong></div></div>
                        <div class="col-6 col-lg"><div class="metric-card"><span>Faces not yet named</span><strong>@Model.UnidentifiedFaces</strong></div></div>
                        <div class="col-6 col-lg"><div class="metric-card"><span>Waiting to be matched</span><strong>@Model.CandidateSearchQueued</strong></div></div>
                        <div class="col-6 col-lg"><div class="metric-card"><span>Being matched</span><strong>@Model.CandidateSearchProcessing</strong></div></div>
                        <div class="col-6 col-lg"><div class="metric-card"><span>Could not be matched</span><strong>@Model.CandidateSearchFailures</strong></div></div>
                    </div>
                    <div class="alert @(Model.CandidateWorkerDelayed ? "alert-warning" : "alert-light border") mt-3 mb-0 py-2" role="status">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <span>
                                <strong>Matching:</strong> @Model.CandidateRuntime.State
                                @if (Model.CandidateRuntime.LastHeartbeatUtc.HasValue)
                                {
                                    <span class="text-muted"> · last seen working @Time.FormatIst(Model.CandidateRuntime.LastHeartbeatUtc)</span>
                                }
                                <span class="text-muted"> · oldest waiting @Model.CandidateSearchOldestAge</span>
                            </span>
                            <span class="text-muted small">
                                Matched @Model.CandidateRuntime.ProcessedSinceStart since PRISM started · @Model.CandidateRuntime.RecoveredStaleSinceStart restarted after getting stuck
                            </span>
                        </div>
                        @if (Model.CandidateWorkerDelayed)
                        {
                            <div class="small mt-1">Matching has not reported in for longer than expected. Stuck matches restart by themselves, and ones that take too long are marked as failed so they can be tried again.</div>
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.CandidateRuntime.LastFailureMessage))
                        {
                            <div class="small mt-1 text-muted">Last problem: @Model.CandidateRuntime.LastFailureMessage</div>
                        }
                    </div>
                </div>
            </section>
    }
    else
    {
        <section class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4 d-flex align-items-start gap-3">
                <i class="bi bi-people fs-4 text-muted" aria-hidden="true"></i>
                <div>
                    <h2 class="h5 mb-1">Finding people is switched off</h2>
                    <p class="text-muted mb-0">Sorting photos still works. Switch finding people on only once the approved model files are installed and its use has been approved.</p>
                </div>
            </div>
        </section>
    }

    <div class="row g-4">
        <div class="col-xl-7">
            <section class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h2 class="h5 mb-1">Find faces in photos</h2>
                    <p class="text-muted">Sends photos that are ready to have their faces found. A person always decides who is in a photo.</p>
                    @if (Model.PeopleEnabled)
                    {
                        <form method="post" asp-page-handler="Queue" class="row g-3 align-items-end">
                            <div class="col-sm-4">
                                <label class="form-label fw-semibold" for="faceBatchSize">How many photos</label>
                                <div class="input-group"><input id="faceBatchSize" class="form-control" type="number" name="limit" min="1" max="250" value="25" /><span class="input-group-text">photos</span></div>
                            </div>
                            <div class="col-sm-auto">
                                <button class="btn btn-primary" type="submit" disabled="@(!Model.SchemaReady || !Model.ModelStatus.IsReady)">Find faces</button>
                            </div>
                            <div class="col-12">
                                @if (!Model.ModelStatus.IsReady)
                                {
                                    <div class="small text-warning-emphasis">Locked until every check under "Is it ready?" passes.</div>
                                }
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-light border mb-0">Finding people is switched off.</div>
                    }
                </div>
            </section>
        </div>
        <div class="col-xl-5">
            <section class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3"><div><h2 class="h5 mb-1">Background work</h2><p class="text-muted mb-0">Thumbnails and other preparation of photos and videos.</p></div><span class="badge text-bg-success">@Model.ProcessingRuntime.State</span></div>
                    <dl class="row mb-0 small">
                        <dt class="col-6">Background work</dt><dd class="col-6">@(Model.ProcessingRuntime.WorkerStarted ? "Running" : Model.ProcessingRuntime.WorkerConfigured ? "Set up, not running" : "Switched off")</dd>
                        <dt class="col-6">Face finding in progress</dt><dd class="col-6">@Model.PendingFaceJobs</dd>
                        <dt class="col-6">Face finding failed</dt><dd class="col-6">@Model.FailedFaceJobs</dd>
                        <dt class="col-6">Working on item</dt><dd class="col-6">@(Model.ProcessingRuntime.CurrentAssetId?.ToString() ?? "None")</dd>
                        <dt class="col-6">Done since PRISM started</dt><dd class="col-6">@Model.ProcessingRuntime.CompletedSinceStart</dd>
                        <dt class="col-6">Failed since PRISM started</dt><dd class="col-6">@Model.ProcessingRuntime.FailedSinceStart</dd>
                        <dt class="col-6">Last seen working</dt><dd class="col-6">@(Model.ProcessingRuntime.LastHeartbeatUtc.HasValue ? Time.FormatIst(Model.ProcessingRuntime.LastHeartbeatUtc) : "Not started")</dd>
                    </dl>
                </div>
            </section>
        </div>
    </div>
</div>
